      }
    },
    {
      "id": "closing",
      "start": 21,
      "duration": 7,
      "type": "closing",
      "title": "Let's Connect",
      "subtitle": "linkedin.com/in/yourprofile",
      "animation": {
        "titleEnter":    { "type": "slideUp", "start": 0.3, "duration": 0.5, "easing": "easeOut" },
        "subtitleEnter": { "type": "fadeIn",  "start": 0.7, "duration": 0.4, "easing": "easeOut" }
      }
    }
