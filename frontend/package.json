{
  "name": "hired.video-frontend",
  "private": true,
  "type": "module",
  "pkg": {
    "assets": [
      "dist/spa/*"
    ],
    "scripts": [
      "dist/server/**/*.js"
    ]
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node ./scripts/inject-build-env.mjs",
    "build": "vite build && node ./scripts/update-config.mjs && node ./scripts/prerender.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name hired --commit-dirty=true",
    "deploy:frontend": "wrangler pages deploy dist --project-name hired --commit-dirty=true",
    "start": "vite preview",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 1000",
    "lint:strict": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:ci": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 0 --quiet",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format.fix": "prettier --write .",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "quality-check": "node ./scripts/quality-check.mjs",
    "quality-check:required": "node ./scripts/quality-check.mjs --required-only"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@marsidev/react-turnstile": "^1.5.2",
    "@sentry/react": "^10.12.0",
    "@tiptap/react": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "@tiptap/extension-link": "^2.6.6",
    "@tiptap/extension-placeholder": "^2.6.6",
    "ag-psd": "^30.1.1",
    "dotenv": "^17.2.0",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.6",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "mp4-muxer": "^5.2.2",
    "pdfjs-dist": "^5.5.207",
    "react-force-graph-2d": "^1.29.1",
    "react-i18next": "^17.0.4",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^2.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "scorm-again": "^3.0.4",
    "web-vitals": "^5.1.0",
    "webm-muxer": "^5.1.4",
    "zod": "^4.3.6"
  },
