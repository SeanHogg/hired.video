# Committed production build defaults.
# Values managed by the inject-build-env.mjs pre-build hook (see
# frontend/scripts/inject-build-env.mjs) are written to
# .env.production.local at build time and TAKE PRECEDENCE over this
# file. Add new committed defaults here; add new managed/secret vars to
# REQUIRED_VARS in inject-build-env.mjs instead so the build process
# can resolve them from the shell or scripts/.build-env.local.json.

# API endpoint (frontend calls)
VITE_API_URL=https://api.hired.video

# Error reporting
VITE_ERROR_REPORTING_ENABLED=true
VITE_ERROR_REPORTING_ENVIRONMENT=production

# ─── Managed by inject-build-env.mjs ────────────────────────────────────
# These vars do NOT belong here — the pre-build script resolves them
# at build time and writes .env.production.local (which Vite reads
# with higher precedence). Listed here as documentation only:
#   - VITE_TURNSTILE_SITE_KEY (Cloudflare Turnstile public site key)
