# App
NODE_ENV=development
PORT=3000
BASE_URL=https://api.hired.video
FRONTEND_URL=https://hired.video

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars-change-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SIGNING_KEY=whsec_...

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODELS=microsoft/mai-ds-r1:free,deepseek/deepseek-chat-v3-1:free

# Google / YouTube
GOOGLE_GEMINI_KEY=...
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REDIRECT_URI=https://api.hired.video/api/videos/youtube/callback

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=info@hired.video

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Split.io
SPLITIO_API_KEY=...

# Sentry
SENTRY_DSN=https://...@sentry.io/...

# Storage (S3-compatible: AWS S3 or Cloudflare R2)
STORAGE_ENDPOINT=https://...
STORAGE_ACCESS_KEY=...
STORAGE_SECRET_KEY=...
STORAGE_BUCKET=hired.video
STORAGE_REGION=auto

# Security
PASSWORD_EXPIRY_DAYS=90
PASSWORD_HISTORY_COUNT=5
MFA_ENABLED=true
