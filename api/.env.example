# App
BASE_URL=https://api.hired.video
FRONTEND_URL=https://hired.video

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars-change-this

# Stripe (default payment provider)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SIGNING_KEY=whsec_...

# Helcim (set PAYMENT_PROVIDER=helcim to activate)
# PAYMENT_PROVIDER=helcim
# HELCIM_ACCOUNT_ID=your-helcim-account-id
# HELCIM_API_KEY=your-helcim-api-key
# HELCIM_JS_TOKEN=your-helcim-js-config-token
# HELCIM_JS_SECRET=your-helcim-js-config-secret
# HELCIM_WEBHOOK_TOKEN=your-helcim-webhook-token

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODELS=microsoft/mai-ds-r1:free,deepseek/deepseek-chat-v3-1:free

# Google / YouTube
GOOGLE_GEMINI_KEY=...
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REDIRECT_URI=https://api.hired.video/api/videos/youtube/callback

# Email
EMAIL_CLIENTID=re_...
EMAIL_SECRET=re_...
EMAIL_FROM=info@hired.video