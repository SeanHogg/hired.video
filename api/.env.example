# App
BASE_URL=https://api.hired.video
FRONTEND_URL=https://hired.video

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars-change-this

# Stripe (default payment provider)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SIGNING_KEY=whsec_...

# Helcim (set PAYMENT_PROVIDER=helcim to activate)
# PAYMENT_PROVIDER=helcim
# HELCIM_API_TOKEN=your-helcim-api-access-token
# HELCIM_COLLECTION_FLOW=modal           # modal | inline — picks HelcimPay iFrame vs Helcim.js inline form
# HELCIM_JS_TOKEN=your-helcim-js-config-token    # required when HELCIM_COLLECTION_FLOW=inline
# HELCIM_JS_SECRET=your-helcim-js-config-secret  # reserved for amount-hash signing (not yet consumed)
# HELCIM_WEBHOOK_TOKEN=your-helcim-webhook-token

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODELS=microsoft/mai-ds-r1:free,deepseek/deepseek-chat-v3-1:free

# Google / YouTube
GOOGLE_GEMINI_KEY=...
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REDIRECT_URI=https://api.hired.video/api/videos/youtube/callback

# Email
EMAIL_CLIENTID=re_...
EMAIL_SECRET=re_...
EMAIL_FROM=info@hired.video

# ─── Paid Media (external ad platforms) ──────────────────────────────────
# Meta / Facebook / Instagram — Marketing API + Conversions API
META_APP_ID=
META_APP_SECRET=

# Google Ads — uses Google OAuth client credentials (can be the same client
# as YouTube above; scope = adwords requested separately). Developer token
# is granted by Google after Standard Access review.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# LinkedIn — Marketing Developer Platform credentials. Same client may be
# used by the resume publishing flow; ensure scopes include r_ads, rw_ads.
# (LINKEDIN_CLIENT_ID/SECRET already declared in Env interface.)

# TikTok For Business — Marketing API.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Microsoft Advertising (Bing) — REST Advertising APIs + developer token.
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_DEVELOPER_TOKEN=

# Envelope encryption key for paid_media_connections.access_token_enc and
# paid_media_pixels.*_token_enc. 32+ char random string; rotate by
# re-encrypting on next write. NEVER commit the production value.
PAID_MEDIA_KMS_KEY=

# Reserved house user id (#986). A real hired.video user (users.is_system =
# true) that owns the platform's OWN paid-media ad connections for internal
# growth marketing. /superadmin/ads binds this subject via a delegated
# workspace_grants row so SuperAdmins act on behalf of the house account,
# not their personal ad connections. Seed + mint the id with:
#   node api/scripts/seedHouseWorkspace.mjs
HOUSE_USER_ID=

# ─── Cloudflare Turnstile (bot protection) ──────────────────────────────
# Paired with the frontend's VITE_TURNSTILE_SITE_KEY. Used by the shared
# captchaSoftCheck (api/src/services/auth/signupGuard.ts) on every
# unauthenticated entry endpoint: register, login, forgot-password,
# magic-link. When unset, the captcha port reports enforced=false and
# all four endpoints skip the check (local dev / tests stay frictionless).
# When set but the frontend bundle lacks VITE_TURNSTILE_SITE_KEY (config
# mismatch) the soft-signal path (gap #1122) records a bot_block_event
# for the SuperAdmin globe but still allows the request — email
# verification is the secondary check that catches bots without inbox
# access. Get the secret from Cloudflare dashboard → Turnstile → your
# site → 'Secret key'.
TURNSTILE_SECRET_KEY=