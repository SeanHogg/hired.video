{
  "name": "hired-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "predeploy": "npm run db:push",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/services/__tests__/*.test.ts src/utils/__tests__/*.test.ts",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "node --require tsx/cjs ./node_modules/drizzle-kit/bin.cjs push --config drizzle.config.ts --force",
    "db:migrate": "node -e \"const{neon}=require('@neondatabase/serverless');const fs=require('fs');const f=process.argv[1]||'./drizzle/latest.sql';const sql=neon(process.env.DATABASE_URL);(async()=>{const stmts=fs.readFileSync(f,'utf8').split(';').filter(s=>s.trim().length>10);let ok=0;for(const s of stmts){try{await sql(s);ok++}catch(e){console.error('ERR:',e.message?.slice(0,120))}}console.log(ok+'/'+stmts.length+' statements OK')})();\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@hono/node-server": "^1.19.11",
    "@neondatabase/serverless": "^0.10.4",
    "@sentry/node": "^10.43.0",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.12.4",
    "jose": "^5.9.6",
    "sendpulse-api": "^1.1.7",
    "stripe": "^20.4.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "^22.5.5",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "wrangler": "4.73.0"
  }
}
