ing] = useState(true);\n  const [metrics, setMetrics] = useState<BillingMetrics | null>(null);\n  const [revenueData, setRevenueData] = useState<RevenueData[]>([]);\n  const [planDistribution, setPlanDistribution] = useState<PlanDistribution[]>(\n    [],\n  );\n  const [churnAnalysis, setChurnAnalysis] = useState<ChurnAnalysis[]>([]);\n\n  useEffect(() => {\n    loadAnalyticsData();\n  }, [dateRange]);\n\n  const loadAnalyticsData = async () => {\n    setIsLoading(true);\n    try {\n      // TODO: Replace with actual API calls\n\n      // Mock metrics\n      setMetrics({\n        totalRevenue: 125430.5,\n        monthlyRevenue: 12543.0,\n        activeSubscriptions: 342,\n        churnRate: 3.2,\n        averageRevenuePerUser: 36.67,\n        lifetimeValue: 1250.0,\n        conversionRate: 12.5,\n        trialToSubscription: 68.3,\n      });\n\n      // Mock revenue data\n      setRevenueData([\n        { month: \"Jan\", revenue: 8500, subscriptions: 245, churn: 2.1 },\n        { month: \"Feb\", revenue: 9200, subscriptions: 267, churn: 2.8 },\n        { month: \"Mar\", revenue: 10100, subscriptions: 289, churn: 1.9 },\n        { month: \"Apr\", revenue: 10800, subscriptions: 312, churn: 3.2 },\n        { month: \"May\", revenue: 11200, subscriptions: 328, churn: 2.5 },\n        { month: \"Jun\", revenue: 11900, subscriptions: 341, churn: 2.9 },\n        { month: \"Jul\", revenue: 12100, subscriptions: 338, churn: 4.1 },\n        { month: \"Aug\", revenue: 12300, subscriptions: 345, churn: 3.8 },\n        { month: \"Sep\", revenue: 12000, subscriptions: 339, churn: 4.2 },\n        { month: \"Oct\", revenue: 12200, subscriptions: 342, churn: 3.5 },\n        { month: \"Nov\", revenue: 12400, subscriptions: 348, churn: 2.8 },\n        { month: \"Dec\", revenue: 12543, subscriptions: 342, churn: 3.2 },\n      ]);\n\n      // Mock plan distribution\n      setPlanDistribution([\n        {\n          plan: \"Free\",\n          subscribers: 1250,\n          revenue: 0,\n          percentage: 65.2,\n          color: COLORS[0],\n        },\n        {\n          plan: \"Professional\",\n          subscribers: 342,\n          revenue: 9918,\n          percentage: 17.8,\n          color: COLORS[1],\n        },\n        {\n          plan: \"Employer\",\n          subscribers: 89,\n          revenue: 8811,\n          percentage: 4.6,\n          color: COLORS[2],\n        },\n        {\n          plan: \"Enterprise\",\n          subscribers: 23,\n          revenue: 6877,\n          percentage: 1.2,\n          color: COLORS[3],\n        },\n      ]);\n\n      // Mock churn analysis\n      setChurnAnalysis([\n        { period: \"Q1 2024\", churnRate: 2.3, churned: 18, retained: 267 },\n        { period: \"Q2 2024\", churnRate: 2.9, churned: 24, retained: 318 },\n        { period: \"Q3 2024\", churnRate: 4.0, churned: 34, retained: 311 },\n        { period: \"Q4 2024\", churnRate: 3.2, churned: 27, retained: 315 },\n      ]);\n    } catch (error) {\n      console.error(\"Failed to load analytics data:\", error);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const formatCurrency = (amount: number) => {\n    return new Intl.NumberFormat(\"en-US\", {\n      style: \"currency\",\n      currency: \"USD\",\n    }).format(amount);\n  };\n\n  const formatPercentage = (value: number) => {\n    return `${value.toFixed(1)}%`;\n  };\n\n  if (isLoading) {\n    return <div className=\"text-center py-8\">Loading analytics...</div>;\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h1 className=\"text-3xl font-bold flex items-center gap-2\">\n            <BarChart3 className=\"h-8 w-8\" />\n            Billing Analytics\n          </h1>\n          <p className=\"text-muted-foreground mt-1\">\n            Track revenue, subscriptions, and business metrics\n          </p>\n        </div>\n\n        <div className=\"flex gap-2\">\n          <select\n            value={dateRange}\n            onChange={(e) => setDateRange(e.target.value)}\n            className=\"px-3 py-2 border rounded-md\"\n          >\n            <option value=\"last_30_days\">Last 30 Days</option>\n            <option value=\"last_3_months\">Last 3 Months</option>\n            <option value=\"last_6_months\">Last 6 Months</option>\n            <option value=\"last_12_months\">Last 12 Months</option>\n            <option value=\"year_to_date\">Year to Date</option>\n          </select>\n\n          <Button variant=\"outline\" onClick={loadAnalyticsData}>\n            <RefreshCw className=\"h-4 w-4 mr-2\" />\n            Refresh\n          </Button>\n\n          <Button variant=\"outline\">\n            <Download className=\"h-4 w-4 mr-2\" />\n            Export\n          </Button>\n        </div>\n      </div>\n\n      <Tabs value={activeTab} onValueChange={setActiveTab}>\n        <TabsList>\n          <TabsTrigger value=\"overview\">Overview</TabsTrigger>\n          <TabsTrigger value=\"revenue\">Revenue</TabsTrigger>\n          <TabsTrigger value=\"subscriptions\">Subscriptions</TabsTrigger>\n          <TabsTrigger value=\"churn\">Churn Analysis</TabsTrigger>\n        </TabsList>\n\n        <TabsContent value=\"overview\" className=\"space-y-4\">\n          {/* Key Metrics */}\n          {metrics && (\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n              <Card>\n                <CardContent className=\"pt-6\">\n                  <div className=\"flex items-center justify-between\">\n                    <div>\n                      <p className=\"text-sm font-medium text-muted-foreground\">\n                        Total Revenue\n                      </p>\n                      <p className=\"text-2xl font-bold\">\n                        {formatCurrency(metrics.totalRevenue)}\n                      </p>\n                    </div>\n                    <div className=\"p-2 bg-green-100 rounded-lg\">\n                      <DollarSign className=\"h-6 w-6 text-green-600\" />\n                    </div>\n                  </div>\n                  <div className=\"flex items-center mt-2\">\n                    <TrendingUp className=\"h-4 w-4 text-green-500 mr-1\" />\n                    <span className=\"text-sm text-green-600\">\n                      +12.5% from last month\n                    </span>\n                  </div>\n                </CardContent>\n              </Card>\n\n              <Card>\n                <CardContent className=\"pt-6\">\n                  <div className=\"flex items-center justify-between\">\n                    <div>\n                      <p className=\"text-sm font-medium text-muted-foreground\">\n                        Active Subscriptions\n                      </p>\n                      <p className=\"text-2xl font-bold\">\n                        {metrics.activeSubscriptions}\n                      </p>\n                    </div>\n                    <div className=\"p-2 bg-blue-100 rounded-lg\">\n                      <Users className=\"h-6 w-6 text-blue-600\" />\n                    </div>\n                  </div>\n                  <div className=\"flex items-center mt-2\">\n                    <TrendingUp className=\"h-4 w-4 text-green-500 mr-1\" />\n                    <span className=\"text-sm text-green-600\">\n                      +8.2% from last month\n                    </span>\n                  </div>\n                </CardContent>\n              </Card>\n\n              <Card>\n                <CardContent className=\"pt-6\">\n                  <div className=\"flex items-center justify-between\">\n                    <div>\n                      <p className=\"text-sm font-medium text-muted-foreground\">\n                        Churn Rate\n                      </p>\n                      <p className=\"text-2xl font-bold\">\n                        {formatPercentage(metrics.churnRate)}\n                      </p>\n                    </div>\n                    <div className=\"p-2 bg-red-100 rounded-lg\">\n                      <TrendingDown className=\"h-6 w-6 text-red-600\" />\n                    </div>\n                  </div>\n                  <div className=\"flex items-center mt-2\">\n                    <TrendingDown className=\"h-4 w-4 text-red-500 mr-1\" />\n                    <span className=\"text-sm text-red-600\">\n                      +0.3% from last month\n                    </span>\n                  </div>\n                </CardContent>\n              </Card>\n\n              <Card>\n                <CardContent className=\"pt-6\">\n                  <div className=\"flex items-center justify-between\">\n                    <div>\n                      <p className=\"text-sm font-medium text-muted-foreground\">\n                        ARPU\n                      </p>\n                      <p className=\"text-2xl font-bold\">\n                        {formatCurrency(metrics.averageRevenuePerUser)}\n                      </p>\n                    </div>\n                    <div className=\"p-2 bg-purple-100 rounded-lg\">\n                      <CreditCard className=\"h-6 w-6 text-purple-600\" />\n                    </div>\n                  </div>\n                  <div className=\"flex items-center mt-2\">\n                    <TrendingUp className=\"h-4 w-4 text-green-500 mr-1\" />\n                    <span className=\"text-sm text-green-600\">\n                      +4.1% from last month\n                    </span>\n                  </div>\n                </CardContent>\n              </Card>\n            </div>\n          )}\n\n          {/* Revenue Chart */}\n          <Card>\n            <CardHeader>\n              <CardTitle>Revenue Trend</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <ResponsiveContainer width=\"100%\" height={300}>\n                <AreaChart data={revenueData}>\n                  <CartesianGrid strokeDasharray=\"3 3\" />\n                  <XAxis dataKey=\"month\" />\n                  <YAxis />\n                  <Tooltip\n                    formatter={(value) => formatCurrency(Number(value))}\n                  />\n                  <Area\n                    type=\"monotone\"\n                    dataKey=\"revenue\"\n                    stroke=\"#8884d8\"\n                    fill=\"#8884d8\"\n                    fillOpacity={0.3}\n                  />\n                </AreaChart>\n              </ResponsiveContainer>\n            </CardContent>\n          </Card>\n\n          {/* Plan Distribution */}\n          <Card>\n            <CardHeader>\n              <CardTitle>Subscription Plan Distribution</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n                <ResponsiveContainer width=\"100%\" height={250}>\n                  <RechartsPieChart>\n                    <Pie\n                      data={planDistribution}\n                      cx=\"50%\"\n                      cy=\"50%\"\n                      outerRadius={80}\n                      dataKey=\"subscribers\"\n                      label={({ plan, percentage }) =>\n                        `${plan} (${percentage}%)`\n                      }\n                    >\n                      {planDistribution.map((entry, index) => (\n                        <Cell key={`cell-${index}`} fill={entry.color} />\n                      ))}\n                    </Pie>\n                    <Tooltip />\n                  </RechartsPieChart>\n                </ResponsiveContainer>\n\n                <div className=\"space-y-4\">\n                  {planDistribution.map((plan, index) => (\n                    <div\n                      key={index}\n                      className=\"flex items-center justify-between\"\n                    >\n                      <div className=\"flex items-center gap-3\">\n                        <div\n                          className=\"w-4 h-4 rounded-full\"\n                          style={{ backgroundColor: plan.color }}\n                        />\n                        <span className=\"font-medium\">{plan.plan}</span>\n                      </div>\n                      <div className=\"text-right\">\n                        <div className=\"font-semibold\">\n                          {plan.subscribers} users\n                        </div>\n                        <div className=\"text-sm text-muted-foreground\">\n                          {formatCurrency(plan.revenue)}\n                        </div>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </CardContent>\n          </Card>\n        </TabsContent>\n\n        <TabsContent value=\"revenue\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Monthly Revenue Breakdown</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <ResponsiveContainer width=\"100%\" height={400}>\n                <BarChart data={revenueData}>\n                  <CartesianGrid strokeDasharray=\"3 3\" />\n                  <XAxis dataKey=\"month\" />\n                  <YAxis />\n                  <Tooltip\n                    formatter={(value) => formatCurrency(Number(value))}\n                  />\n                  <Legend />\n                  <Bar dataKey=\"revenue\" fill=\"#8884d8\" name=\"Revenue\" />\n                </BarChart>\n              </ResponsiveContainer>\n            </CardContent>\n          </Card>\n        </TabsContent>\n\n        <TabsContent value=\"subscriptions\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Subscription Growth</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <ResponsiveContainer width=\"100%\" height={400}>\n                <LineChart data={revenueData}>\n                  <CartesianGrid strokeDasharray=\"3 3\" />\n                  <XAxis dataKey=\"month\" />\n                  <YAxis />\n                  <Tooltip />\n                  <Legend />\n                  <Line\n                    type=\"monotone\"\n                    dataKey=\"subscriptions\"\n                    stroke=\"#8884d8\"\n                    strokeWidth={2}\n                    name=\"Active Subscriptions\"\n                  />\n                </LineChart>\n              </ResponsiveContainer>\n            </CardContent>\n          </Card>\n        </TabsContent>\n\n        <TabsContent value=\"churn\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Churn Analysis</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <ResponsiveContainer width=\"100%\" height={400}>\n                <BarChart data={churnAnalysis}>\n                  <CartesianGrid strokeDasharray=\"3 3\" />\n                  <XAxis dataKey=\"period\" />\n                  <YAxis />\n                  <Tooltip />\n                  <Legend />\n                  <Bar dataKey=\"churned\" fill=\"#ff8042\" name=\"Churned\" />\n                  <Bar dataKey=\"retained\" fill=\"#00c49f\" name=\"Retained\" />\n                </BarChart>\n              </ResponsiveContainer>\n            </CardContent>\n          </Card>\n        </TabsContent>\n      </Tabs>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\billing\\BillingManagement.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'useRef' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":21,"nodeType":null,"messageId":"unusedVar","endLine":1,"endColumn":27},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":70,"column":9,"nodeType":"MemberExpression","messageId":"unexpected","endLine":70,"endColumn":22,"suggestions":[{"fix":{"range":[2615,2668],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":90,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":90,"endColumn":20,"suggestions":[{"fix":{"range":[3358,3375],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":109,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":109,"endColumn":20,"suggestions":[{"fix":{"range":[3839,3856],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-alert","severity":1,"message":"Unexpected alert.","line":110,"column":7,"nodeType":"CallExpression","messageId":"unexpected","endLine":110,"endColumn":34}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect, useRef, useState } from \"react\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { Progress } from \"@/components/ui/progress\";\nimport { CreditCard, FileText, AlertCircle, Trash2, Plus } from \"lucide-react\";\nimport { Dialog, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogTitle } from \"@/components/ui/dialog\";\n\nimport { billingService, type PaymentMethod, type Invoice, type AIUsageMonth, type SubscriptionSummary } from \"@/lib/services/billing-service\";\nimport { FREE_AI_MONTHLY_LIMIT } from \"@shared/pricing\";\n\n\n\n\n\n\nexport function BillingManagement() {\n  const [activeTab, setActiveTab] = useState(\"overview\");\n\n  const [subscription, setSubscription] = useState<SubscriptionSummary | null>(null);\n  const [aiUsage, setAiUsage] = useState<AIUsageMonth | null>(null);\n  const [paymentMethods, setPaymentMethods] = useState<PaymentMethod[]>([]);\n  const [invoices, setInvoices] = useState<Invoice[]>([]);\n  const [isLoading, setIsLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  // Payment method state\n  const [pmSubmitting, setPmSubmitting] = useState(false);\n\n  // Delete dialog state\n  const [deleteDialogOpen, setDeleteDialogOpen] = useState(false);\n  const [pendingDeletePmId, setPendingDeletePmId] = useState<string | null>(null);\n\n\n\n  useEffect(() => {\n    let isMounted = true;\n    setIsLoading(true);\n    setError(null);\n    (async () => {\n      try {\n        if (activeTab === \"overview\") {\n          const [usage, sub] = await Promise.all([\n            billingService.getMonthlyAIUsage(),\n            billingService.getSubscription(),\n          ]);\n          if (isMounted) {\n            setAiUsage(usage);\n            setSubscription(sub);\n          }\n\n  // (Stripe helpers and PM handlers declared below, outside useEffect)\n\n        } else if (activeTab === \"payment-methods\") {\n          const [pms, sub] = await Promise.all([\n            billingService.getPaymentMethods(),\n            billingService.getSubscription(),\n          ]);\n          if (isMounted) {\n            setPaymentMethods(pms);\n            setSubscription(sub);\n          }\n        } else if (activeTab === \"invoices\") {\n          const invs = await billingService.getInvoices();\n          if (isMounted) setInvoices(invs);\n        }\n      } catch (error) {\n        console.error(\"Failed to load billing data:\", error);\n        if (isMounted) setError(\"Failed to load billing data. Please try again.\");\n      } finally {\n        if (isMounted) setIsLoading(false);\n      }\n    })();\n    return () => {\n      isMounted = false;\n    };\n  }, [activeTab]);\n\n  // Payment method management using Stripe hosted pages\n  async function handleAddPaymentMethod() {\n    try {\n      setPmSubmitting(true);\n      const successUrl = `${window.location.origin}/settings?tab=billing&pm_success=true`;\n      const cancelUrl = `${window.location.origin}/settings?tab=billing`;\n      const setupUrl = await billingService.createSetupSession(successUrl, cancelUrl);\n      window.location.href = setupUrl;\n    } catch (e) {\n      console.error(e);\n      setError((e as Error).message);\n    } finally {\n      setPmSubmitting(false);\n    }\n  }\n\n  function openDelete(pmId: string) {\n    setPendingDeletePmId(pmId);\n    setDeleteDialogOpen(true);\n  }\n\n  async function confirmDelete() {\n    if (!pendingDeletePmId) return;\n    try {\n      await billingService.deletePaymentMethod(pendingDeletePmId);\n      const pms = await billingService.getPaymentMethods();\n      setPaymentMethods(pms);\n    } catch (e) {\n      console.error(e);\n      alert((e as Error).message);\n    } finally {\n      setDeleteDialogOpen(false);\n      setPendingDeletePmId(null);\n    }\n  }\n\n\n\n  if (isLoading) {\n    return (\n      <div className=\"text-center py-8\">Loading billing information...</div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h1 className=\"text-3xl font-bold flex items-center gap-2\">\n            <CreditCard className=\"h-8 w-8\" />\n            Billing\n          </h1>\n          <p className=\"text-muted-foreground mt-1\">\n            Manage your subscription, payment methods, and billing history\n          </p>\n        </div>\n      </div>\n\n      {error && (\n        <Alert>\n          <AlertCircle className=\"h-4 w-4\" />\n          <AlertDescription>{error}</AlertDescription>\n        </Alert>\n      )}\n\n      <Tabs value={activeTab} onValueChange={setActiveTab}>\n        <TabsList>\n          <TabsTrigger value=\"overview\">Overview</TabsTrigger>\n\n          <TabsTrigger value=\"payment-methods\">Payment Methods</TabsTrigger>\n          <TabsTrigger value=\"invoices\">Invoices</TabsTrigger>\n        </TabsList>\n\n        <TabsContent value=\"overview\" className=\"space-y-4\">\n          {subscription && (\n            <Card>\n              <CardHeader>\n                <CardTitle className=\"flex items-center justify-between\">\n                  Current Plan\n                  <Badge variant={subscription.isPremium ? \"default\" : \"secondary\"}>\n                    {subscription.isPremium ? \"Premium\" : \"Free\"}\n                  </Badge>\n                </CardTitle>\n              </CardHeader>\n              <CardContent className=\"space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <h3 className=\"text-lg font-semibold\">{subscription.planName}</h3>\n                    {subscription.currentPeriodEnd && (\n                      <p className=\"text-muted-foreground\">\n                        {subscription.isPremium ? \"Next billing:\" : \"Plan valid until:\"} {new Date(subscription.currentPeriodEnd).toLocaleDateString()}\n                      </p>\n                    )}\n                  </div>\n                  <div className=\"text-right\">\n                    <div className=\"text-2xl font-bold\">\n                      {subscription.isPremium ? `${subscription.currency} ${subscription.price.toFixed(2)}` : \"$0.00\"}\n                    </div>\n                    <div className=\"text-sm text-muted-foreground\">\n                      {subscription.isPremium ? `per ${subscription.interval}` : \"Free\"}\n                    </div>\n                  </div>\n                </div>\n\n                {subscription.cancelAtPeriodEnd && (\n                  <Alert>\n                    <AlertCircle className=\"h-4 w-4\" />\n                    <AlertDescription>\n                      Your subscription will be canceled at the end of the current billing period.\n                    </AlertDescription>\n                  </Alert>\n                )}\n\n                <div className=\"flex gap-2\">\n                  {!subscription.isPremium ? (\n                    <Button asChild>\n                      <a href=\"/pricing\">Upgrade</a>\n                    </Button>\n                  ) : (\n                    <Button variant=\"outline\" asChild>\n                      <a href=\"/pricing\">Manage subscription</a>\n                    </Button>\n                  )}\n                </div>\n              </CardContent>\n            </Card>\n          )}\n\n          {aiUsage && (\n            <Card>\n              <CardHeader>\n                <CardTitle>AI Usage This Month</CardTitle>\n\n              </CardHeader>\n              <CardContent className=\"space-y-2\">\n                {aiUsage.isUnlimited ? (\n                  <div className=\"text-sm text-muted-foreground\">Unlimited AI usage</div>\n                ) : (\n                  <>\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"text-sm font-medium\">AI Credits</span>\n                      <span className=\"text-sm text-muted-foreground\">\n                        {aiUsage.used} used ΓÇó {aiUsage.remaining} of {aiUsage.limit ?? FREE_AI_MONTHLY_LIMIT} remaining\n                      </span>\n                    </div>\n                    <Progress\n                      value={Math.min(\n                        100,\n                        (aiUsage.used / (aiUsage.limit ?? FREE_AI_MONTHLY_LIMIT)) * 100,\n                      )}\n                    />\n                  </>\n                )}\n              </CardContent>\n            </Card>\n          )}\n        </TabsContent>\n\n\n        <TabsContent value=\"payment-methods\" className=\"space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"text-lg font-semibold\">Payment methods</h3>\n            <Button size=\"sm\" onClick={handleAddPaymentMethod} disabled={pmSubmitting}>\n              <Plus className=\"h-4 w-4 mr-1\" /> {pmSubmitting ? \"Redirecting...\" : \"Add payment method\"}\n            </Button>\n          </div>\n          {paymentMethods.length === 0 ? (\n            <Alert>\n              <CreditCard className=\"h-4 w-4\" />\n              <AlertDescription>\n                No payment methods on file. Add one to avoid service interruption.\n              </AlertDescription>\n            </Alert>\n          ) : (\n            <div className=\"space-y-3\">\n              {paymentMethods.map((pm) => (\n                <Card key={pm.id}>\n                  <CardContent className=\"flex items-center justify-between p-4\">\n                    <div className=\"flex items-center gap-3\">\n                      <CreditCard className=\"h-5 w-5 text-primary\" />\n                      <div>\n                        <div className=\"font-medium uppercase\">\n                          {pm.brand} ΓÇóΓÇóΓÇóΓÇó {pm.last4}\n                        </div>\n                        <div className=\"text-sm text-muted-foreground\">\n                          Expires {pm.expiryMonth}/{pm.expiryYear}\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      {pm.isDefault && <Badge variant=\"secondary\">Default</Badge>}\n                      <Button variant=\"destructive\" size=\"sm\" onClick={() => openDelete(pm.id)}>\n                        <Trash2 className=\"h-4 w-4 mr-1\" /> Delete\n                      </Button>\n                    </div>\n                  </CardContent>\n                </Card>\n              ))}\n            </div>\n          )}\n\n\n\n          {/* Delete confirmation modal */}\n          <Dialog open={deleteDialogOpen} onOpenChange={setDeleteDialogOpen}>\n            <DialogContent>\n              <DialogHeader>\n                <DialogTitle>Delete payment method?</DialogTitle>\n                <DialogDescription>\n                  {paymentMethods.length <= 1 && subscription?.isPremium\n                    ? \"This is your only payment method and you have an active subscription. Please add another payment method first or cancel your subscription.\"\n                    : \"This action cannot be undone. You can add another payment method at any time.\"}\n                </DialogDescription>\n              </DialogHeader>\n              <DialogFooter>\n                {paymentMethods.length <= 1 && subscription?.isPremium ? (\n                  <div className=\"flex w-full justify-between\">\n                    <Button variant=\"secondary\" onClick={() => { setDeleteDialogOpen(false); handleAddPaymentMethod(); }}>Add another method</Button>\n                    <Button variant=\"outline\" asChild>\n                      <a href=\"/pricing\">Manage subscription</a>\n                    </Button>\n                  </div>\n                ) : (\n                  <>\n                    <Button variant=\"secondary\" onClick={() => setDeleteDialogOpen(false)}>Cancel</Button>\n                    <Button variant=\"destructive\" onClick={confirmDelete}>Delete</Button>\n                  </>\n                )}\n              </DialogFooter>\n            </DialogContent>\n          </Dialog>\n        </TabsContent>\n\n        <TabsContent value=\"invoices\" className=\"space-y-4\">\n          {invoices.length === 0 ? (\n            <Alert>\n              <FileText className=\"h-4 w-4\" />\n              <AlertDescription>No invoices found.</AlertDescription>\n            </Alert>\n          ) : (\n            <div className=\"space-y-3\">\n              {invoices.map((inv) => (\n                <Card key={inv.id}>\n                  <CardContent className=\"flex items-center justify-between p-4\">\n                    <div>\n                      <div className=\"font-medium\">{inv.number}</div>\n                      <div className=\"text-sm text-muted-foreground\">\n                        {new Date(inv.invoiceDate).toLocaleDateString()} ΓÇó {inv.currency}{\" \"}\n                        {inv.amount.toFixed(2)}\n                      </div>\n                    </div>\n                    <Button asChild variant=\"outline\" size=\"sm\">\n                      <a href={inv.downloadUrl}>Download</a>\n                    </Button>\n                  </CardContent>\n                </Card>\n              ))}\n            </div>\n          )}\n        </TabsContent>\n      </Tabs>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\careers\\CompanyCareersControl.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'user' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":111,"column":11,"nodeType":null,"messageId":"unusedVar","endLine":111,"endColumn":15},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'isAuthenticated' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":111,"column":17,"nodeType":null,"messageId":"unusedVar","endLine":111,"endColumn":32},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'e' is defined but never used.","line":145,"column":16,"nodeType":null,"messageId":"unusedVar","endLine":145,"endColumn":17}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\nimport { useQuery } from \"@tanstack/react-query\";\n\nimport {\n  MapPin,\n  DollarSign,\n  Users,\n  Briefcase,\n  ExternalLink,\n  Search,\n  Building2,\n  Calendar,\n} from \"lucide-react\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Badge } from \"@/components/ui/badge\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\";\nimport { useAuth } from \"@/lib/auth\";\nimport { jobService } from \"@/lib/services/job-service\";\nimport { companyService } from \"@/lib/services/company-service\";\n\n// Job interface matching backend structure\ninterface CompanyJob {\n  id: string;\n  title: string;\n  description: string;\n  summary?: string;\n  responsibilities?: string[];\n  requirements?: string[];\n  employmentType?: string;\n  experienceLevel?: string;\n  location?: string;\n  salaryMin?: number;\n  salaryMax?: number;\n  currency?: string;\n  workSetting?: \"Onsite\" | \"Remote\" | \"Hybrid\";\n  status: \"Draft\" | \"Open\" | \"Closed\" | \"Hired\";\n  createdAt: string;\n  expiresAt?: string;\n  applications: number;\n  views: number;\n  slug?: string;\n  atsApplyUrl?: string;\n}\n\ninterface CompanyInfo {\n  id: string;\n  name: string;\n  logo?: string;\n  tagline?: string;\n  description?: string;\n  website?: string;\n  industry?: string;\n  size?: string;\n  location?: string;\n}\n\ninterface CompanyCareersControlProps {\n  companyId?: string;\n  companySlug?: string;\n  showCompanyHeader?: boolean;\n  showFilters?: boolean;\n  showSearch?: boolean;\n  maxJobs?: number;\n  viewMode?: \"table\" | \"cards\";\n  onJobClick?: (job: CompanyJob) => void;\n  onApplyClick?: (job: CompanyJob) => void;\n  className?: string;\n}\n\nexport function CompanyCareersControl({\n  companyId,\n  companySlug,\n  showCompanyHeader = true,\n  showFilters = true,\n  showSearch = true,\n  maxJobs,\n  viewMode = \"table\",\n  onJobClick,\n  onApplyClick,\n  className = \"\",\n}: CompanyCareersControlProps) {\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [employmentTypeFilter, setEmploymentTypeFilter] =\n    useState<string>(\"all\");\n  const [experienceLevelFilter, setExperienceLevelFilter] =\n    useState<string>(\"all\");\n  const [locationFilter, setLocationFilter] = useState<string>(\"all\");\n\n  const { user, isAuthenticated } = useAuth();\n\n  // Fetch company (by id or slug) using React Query with caching\n  const companyQuery = useQuery({\n    queryKey: [\"company\", companyId ?? companySlug ?? \"myvideoresume-company\"],\n    queryFn: async (): Promise<CompanyInfo> => {\n      try {\n        if (companyId) {\n          const c = await companyService.getCompanyById(companyId);\n          return {\n            id: c.id || companyId,\n            name: c.name || \"Company\",\n            logo: c.logo || \"/logo.png\",\n            tagline: c.tagline || \"\",\n            description: c.description ?? \"\",\n            website: c.website ?? \"\",\n            industry: c.industry || \"\",\n            size: c.size || \"\",\n            location: c.location || \"\",\n          };\n        } else if (companySlug) {\n          const c = await companyService.getCompanyBySlug(companySlug);\n          return {\n            id: c.id || companySlug,\n            name: c.name || \"Company\",\n            logo: c.logo || \"/logo.png\",\n            tagline: c.tagline || \"\",\n            description: c.description ?? \"\",\n            website: c.website ?? \"\",\n            industry: c.industry || \"\",\n            size: c.size || \"\",\n            location: c.location || \"\",\n          };\n        }\n      } catch (e) {\n        // swallow to use fallback\n      }\n      // Fallback to MyVideoResu.me if no company data loaded\n      return {\n        id: companyId || companySlug || \"myvideoresume-company\",\n        name: \"MyVideoResu.me\",\n        logo: \"/logo.png\",\n        tagline:\n          \"Revolutionizing the way people find and showcase their talents\",\n        description:\n          \"MyVideoResu.me is a cutting-edge platform that combines traditional resumes with video presentations, helping job seekers stand out and employers find the perfect candidates.\",\n        website: \"https://myvideoresu.me\",\n        industry: \"Technology\",\n        size: \"11-50\",\n        location: \"San Francisco, CA\",\n      };\n    },\n    staleTime: 5 * 60 * 1000,\n  });\n\n  // Fetch jobs using React Query, keyed by company id (from query data)\n  const jobsQuery = useQuery({\n    enabled: !!companyQuery.data?.id,\n    queryKey: [\n      \"company-jobs\",\n      (companyQuery.data?.id) ?? (companyId || companySlug || \"myvideoresume-company\"),\n      maxJobs ?? null,\n    ],\n    queryFn: async (): Promise<CompanyJob[]> => {\n      const cId = companyQuery.data?.id || companyId || companySlug || \"myvideoresume-company\";\n      const jobsResponse = await jobService.getPublicJobs({\n        companyId: cId,\n        limit: maxJobs || 50,\n      });\n\n      const items = jobsResponse.items ?? [];\n      return items.map((job) => ({\n        id: job.id,\n        title: job.title,\n        description: job.title,\n        summary: job.title,\n        responsibilities: [],\n        requirements: [],\n        employmentType: job.employmentType,\n        experienceLevel: \"mid\",\n        location: job.location,\n        salaryMin: job.salaryMin,\n        salaryMax: job.salaryMax,\n        currency: \"USD\",\n        workSetting: job.isRemote ? \"Remote\" : \"Onsite\",\n        status: \"Open\",\n        createdAt: job.postedDate ?? new Date().toISOString(),\n        applications: 0,\n        views: 0,\n        slug: job.id,\n        atsApplyUrl: undefined,\n      }));\n    },\n    staleTime: 5 * 60 * 1000,\n  });\n\n  const loading = companyQuery.isLoading || jobsQuery.isLoading;\n  const error = (companyQuery.error || jobsQuery.error) ? \"Failed to load jobs. Please try again later.\" : null;\n  const company = companyQuery.data ?? null;\n  const jobs = (jobsQuery.data ?? []);\n\n\n\n  // Filter jobs based on search and filters\n  const filteredJobs = jobs.filter((job) => {\n    const matchesSearch =\n      !searchTerm ||\n      job.title.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      job.description.toLowerCase().includes(searchTerm.toLowerCase());\n\n    const matchesEmploymentType =\n      employmentTypeFilter === \"all\" ||\n      job.employmentType === employmentTypeFilter;\n\n    const matchesExperienceLevel =\n      experienceLevelFilter === \"all\" ||\n      job.experienceLevel === experienceLevelFilter;\n\n    const matchesLocation =\n      locationFilter === \"all\" ||\n      job.location?.toLowerCase().includes(locationFilter.toLowerCase()) ||\n      job.workSetting?.toLowerCase() === locationFilter.toLowerCase();\n\n    return (\n      matchesSearch &&\n      matchesEmploymentType &&\n      matchesExperienceLevel &&\n      matchesLocation\n    );\n  });\n\n  const handleJobClick = (job: CompanyJob) => {\n    if (onJobClick) {\n      onJobClick(job);\n    } else {\n      // Default behavior - navigate to job detail page\n      window.open(`/jobs/${job.slug || job.id}`, \"_blank\");\n    }\n  };\n\n  const handleApplyClick = (job: CompanyJob, e: React.MouseEvent) => {\n    e.stopPropagation();\n\n    if (onApplyClick) {\n      onApplyClick(job);\n    } else if (job.atsApplyUrl) {\n      window.open(job.atsApplyUrl, \"_blank\");\n    } else {\n      // Default behavior - navigate to application page\n      window.open(`/jobs/${job.slug || job.id}/apply`, \"_blank\");\n    }\n  };\n\n  const formatSalary = (min?: number, max?: number, currency = \"USD\") => {\n    if (!min && !max) return null;\n\n    const formatter = new Intl.NumberFormat(\"en-US\", {\n      style: \"currency\",\n      currency,\n      minimumFractionDigits: 0,\n      maximumFractionDigits: 0,\n    });\n\n    if (min && max) {\n      return `${formatter.format(min)} - ${formatter.format(max)}`;\n    }\n    return formatter.format(min || max || 0);\n  };\n\n  const getEmploymentTypeColor = (type?: string) => {\n    switch (type) {\n      case \"full-time\":\n        return \"bg-green-100 text-green-800\";\n      case \"part-time\":\n        return \"bg-blue-100 text-blue-800\";\n      case \"contract\":\n        return \"bg-purple-100 text-purple-800\";\n      case \"internship\":\n        return \"bg-orange-100 text-orange-800\";\n      default:\n        return \"bg-gray-100 text-gray-800\";\n    }\n  };\n\n  const getExperienceLevelColor = (level?: string) => {\n    switch (level) {\n      case \"entry\":\n        return \"bg-green-100 text-green-800\";\n      case \"mid\":\n        return \"bg-blue-100 text-blue-800\";\n      case \"senior\":\n        return \"bg-purple-100 text-purple-800\";\n      case \"executive\":\n        return \"bg-red-100 text-red-800\";\n      default:\n        return \"bg-gray-100 text-gray-800\";\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className={`space-y-6 ${className}`}>\n        <div className=\"animate-pulse\">\n          {showCompanyHeader && (\n            <div className=\"h-32 bg-gray-200 rounded-lg mb-6\" />\n          )}\n          <div className=\"space-y-4\">\n            {[1, 2, 3].map((i) => (\n              <div key={i} className=\"h-24 bg-gray-200 rounded-lg\" />\n            ))}\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  const handleRetry = () => {\n    void companyQuery.refetch();\n    void jobsQuery.refetch();\n  };\n\n  if (error) {\n    return (\n      <div className={`text-center py-12 ${className}`}>\n        <div className=\"text-red-600 mb-4\">{error}</div>\n        <Button onClick={handleRetry} variant=\"outline\">\n          Try Again\n        </Button>\n      </div>\n    );\n  }\n\n  return (\n    <div className={`space-y-6 ${className}`}>\n      {/* Company Header */}\n      {showCompanyHeader && company && (\n        <Card>\n          <CardContent className=\"pt-6\">\n            <div className=\"flex items-start gap-6\">\n              {company.logo && (\n                <img\n                  src={company.logo}\n                  alt={`${company.name} logo`}\n                  className=\"w-16 h-16 rounded-lg object-cover\"\n                />\n              )}\n              <div className=\"flex-1\">\n                <div className=\"flex items-center gap-3 mb-2\">\n                  <h1 className=\"text-2xl font-bold\">{company.name}</h1>\n                  {company.website && (\n                    <Button variant=\"ghost\" size=\"sm\" asChild>\n                      <a\n                        href={company.website}\n                        target=\"_blank\"\n                        rel=\"noopener noreferrer\"\n                      >\n                        <ExternalLink className=\"h-4 w-4\" />\n                      </a>\n                    </Button>\n                  )}\n                </div>\n                {company.tagline && (\n                  <p className=\"text-lg text-muted-foreground mb-3\">\n                    {company.tagline}\n                  </p>\n                )}\n                <div className=\"flex flex-wrap gap-4 text-sm text-muted-foreground\">\n                  {company.industry && (\n                    <div className=\"flex items-center gap-1\">\n                      <Building2 className=\"h-4 w-4\" />\n                      {company.industry}\n                    </div>\n                  )}\n                  {company.size && (\n                    <div className=\"flex items-center gap-1\">\n                      <Users className=\"h-4 w-4\" />\n                      {company.size} employees\n                    </div>\n                  )}\n                  {company.location && (\n                    <div className=\"flex items-center gap-1\">\n                      <MapPin className=\"h-4 w-4\" />\n                      {company.location}\n                    </div>\n                  )}\n                </div>\n              </div>\n            </div>\n          </CardContent>\n        </Card>\n      )}\n\n      {/* Search and Filters */}\n      {(showSearch || showFilters) && (\n        <Card>\n          <CardContent className=\"pt-6\">\n            <div className=\"flex flex-col sm:flex-row gap-4\">\n              {showSearch && (\n                <div className=\"flex-1\">\n                  <div className=\"relative\">\n                    <Search className=\"absolute left-3 top-1/2 transform -translate-y-1/2 h-4 w-4 text-muted-foreground\" />\n                    <Input\n                      placeholder=\"Search jobs...\"\n                      value={searchTerm}\n                      onChange={(e) => setSearchTerm(e.target.value)}\n                      className=\"pl-10\"\n                    />\n                  </div>\n                </div>\n              )}\n\n              {showFilters && (\n                <div className=\"flex gap-2\">\n                  <Select\n                    value={employmentTypeFilter}\n                    onValueChange={setEmploymentTypeFilter}\n                  >\n                    <SelectTrigger className=\"w-[140px]\">\n                      <SelectValue placeholder=\"Job Type\" />\n                    </SelectTrigger>\n                    <SelectContent>\n                      <SelectItem value=\"all\">All Types</SelectItem>\n                      <SelectItem value=\"full-time\">Full-time</SelectItem>\n                      <SelectItem value=\"part-time\">Part-time</SelectItem>\n                      <SelectItem value=\"contract\">Contract</SelectItem>\n                      <SelectItem value=\"internship\">Internship</SelectItem>\n                    </SelectContent>\n                  </Select>\n\n                  <Select\n                    value={experienceLevelFilter}\n                    onValueChange={setExperienceLevelFilter}\n                  >\n                    <SelectTrigger className=\"w-[140px]\">\n                      <SelectValue placeholder=\"Experience\" />\n                    </SelectTrigger>\n                    <SelectContent>\n                      <SelectItem value=\"all\">All Levels</SelectItem>\n                      <SelectItem value=\"entry\">Entry Level</SelectItem>\n                      <SelectItem value=\"mid\">Mid Level</SelectItem>\n                      <SelectItem value=\"senior\">Senior Level</SelectItem>\n                      <SelectItem value=\"executive\">Executive</SelectItem>\n                    </SelectContent>\n                  </Select>\n\n                  <Select\n                    value={locationFilter}\n                    onValueChange={setLocationFilter}\n                  >\n                    <SelectTrigger className=\"w-[140px]\">\n                      <SelectValue placeholder=\"Location\" />\n                    </SelectTrigger>\n                    <SelectContent>\n                      <SelectItem value=\"all\">All Locations</SelectItem>\n                      <SelectItem value=\"remote\">Remote</SelectItem>\n                      <SelectItem value=\"hybrid\">Hybrid</SelectItem>\n                      <SelectItem value=\"onsite\">Onsite</SelectItem>\n                    </SelectContent>\n                  </Select>\n                </div>\n              )}\n            </div>\n          </CardContent>\n        </Card>\n      )}\n\n      {/* Jobs Display */}\n      {filteredJobs.length === 0 ? (\n        <Card>\n          <CardContent className=\"pt-6\">\n            <div className=\"text-center py-12\">\n              <Briefcase className=\"h-12 w-12 text-muted-foreground mx-auto mb-4\" />\n              <h3 className=\"text-lg font-semibold mb-2\">No jobs found</h3>\n              <p className=\"text-muted-foreground\">\n                {searchTerm ||\n                employmentTypeFilter !== \"all\" ||\n                experienceLevelFilter !== \"all\" ||\n                locationFilter !== \"all\"\n                  ? \"Try adjusting your search criteria\"\n                  : \"No open positions at this time. Check back later!\"}\n              </p>\n            </div>\n          </CardContent>\n        </Card>\n      ) : viewMode === \"table\" ? (\n        <Card>\n          <CardHeader>\n            <CardTitle className=\"flex items-center gap-2\">\n              <Briefcase className=\"h-5 w-5\" />\n              Open Positions ({filteredJobs.length})\n            </CardTitle>\n          </CardHeader>\n          <CardContent>\n            <Table>\n              <TableHeader>\n                <TableRow>\n                  <TableHead>Position</TableHead>\n                  <TableHead>Type</TableHead>\n                  <TableHead>Experience</TableHead>\n                  <TableHead>Location</TableHead>\n                  <TableHead>Salary</TableHead>\n                  <TableHead>Posted</TableHead>\n                  <TableHead className=\"text-right\">Actions</TableHead>\n                </TableRow>\n              </TableHeader>\n              <TableBody>\n                {filteredJobs.map((job) => (\n                  <TableRow\n                    key={job.id}\n                    className=\"cursor-pointer hover:bg-muted/50\"\n                    onClick={() => handleJobClick(job)}\n                  >\n                    <TableCell>\n                      <div>\n                        <div className=\"font-medium\">{job.title}</div>\n                        <div className=\"text-sm text-muted-foreground line-clamp-1\">\n                          {job.summary || job.description}\n                        </div>\n                      </div>\n                    </TableCell>\n                    <TableCell>\n                      <Badge\n                        className={getEmploymentTypeColor(job.employmentType)}\n                      >\n                        {job.employmentType?.replace(\"-\", \" \") || \"Full-time\"}\n                      </Badge>\n                    </TableCell>\n                    <TableCell>\n                      <Badge\n                        className={getExperienceLevelColor(job.experienceLevel)}\n                      >\n                        {job.experienceLevel || \"Mid\"}\n                      </Badge>\n                    </TableCell>\n                    <TableCell>\n                      <div className=\"flex items-center gap-1\">\n                        <MapPin className=\"h-3 w-3\" />\n                        {job.workSetting === \"Remote\"\n                          ? \"Remote\"\n                          : job.location || \"Not specified\"}\n                      </div>\n                    </TableCell>\n                    <TableCell>\n                      {formatSalary(\n                        job.salaryMin,\n                        job.salaryMax,\n                        job.currency,\n                      ) || \"Competitive\"}\n                    </TableCell>\n                    <TableCell>\n                      <div className=\"flex items-center gap-1 text-sm text-muted-foreground\">\n                        <Calendar className=\"h-3 w-3\" />\n                        {new Date(job.createdAt).toLocaleDateString()}\n                      </div>\n                    </TableCell>\n                    <TableCell className=\"text-right\">\n                      <Button\n                        size=\"sm\"\n                        onClick={(e) => handleApplyClick(job, e)}\n                      >\n                        Apply\n                      </Button>\n                    </TableCell>\n                  </TableRow>\n                ))}\n              </TableBody>\n            </Table>\n          </CardContent>\n        </Card>\n      ) : (\n        <div className=\"grid gap-6 md:grid-cols-2 lg:grid-cols-3\">\n          {filteredJobs.map((job) => (\n            <Card\n              key={job.id}\n              className=\"cursor-pointer hover:shadow-md transition-shadow\"\n              onClick={() => handleJobClick(job)}\n            >\n              <CardHeader>\n                <div className=\"flex justify-between items-start\">\n                  <CardTitle className=\"text-lg\">{job.title}</CardTitle>\n                  <div className=\"flex gap-1\">\n                    <Badge\n                      className={getEmploymentTypeColor(job.employmentType)}\n                    >\n                      {job.employmentType?.replace(\"-\", \" \") || \"Full-time\"}\n                    </Badge>\n                  </div>\n                </div>\n                <CardDescription className=\"line-clamp-2\">\n                  {job.summary || job.description}\n                </CardDescription>\n              </CardHeader>\n              <CardContent>\n                <div className=\"space-y-3\">\n                  <div className=\"flex items-center gap-4 text-sm text-muted-foreground\">\n                    <div className=\"flex items-center gap-1\">\n                      <MapPin className=\"h-3 w-3\" />\n                      {job.workSetting === \"Remote\"\n                        ? \"Remote\"\n                        : job.location || \"Not specified\"}\n                    </div>\n                    <Badge\n                      className={getExperienceLevelColor(job.experienceLevel)}\n                    >\n                      {job.experienceLevel || \"Mid\"}\n                    </Badge>\n                  </div>\n\n                  {(job.salaryMin || job.salaryMax) && (\n                    <div className=\"flex items-center gap-1 text-sm\">\n                      <DollarSign className=\"h-3 w-3\" />\n                      {formatSalary(job.salaryMin, job.salaryMax, job.currency)}\n                    </div>\n                  )}\n\n                  <div className=\"flex items-center justify-between pt-2\">\n                    <div className=\"text-xs text-muted-foreground\">\n                      Posted {new Date(job.createdAt).toLocaleDateString()}\n                    </div>\n                    <Button size=\"sm\" onClick={(e) => handleApplyClick(job, e)}>\n                      Apply\n                    </Button>\n                  </div>\n                </div>\n              </CardContent>\n            </Card>\n          ))}\n        </div>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\charts\\MetricsPieChart.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\charts\\TrendLineChart.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\dashboard\\AdminDashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\dashboard\\EmployerDashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components