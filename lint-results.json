teBillingCycle,\n    clearCart,\n    openCart,\n    closeCart,\n    getTotalPrice,\n    getItemCount,\n  } = useCart();\n\n  const handleCheckout = () => {\n    closeCart();\n    navigate(\"/checkout\");\n  };\n\n  const formatPrice = (price: number, billingCycle: \"monthly\" | \"annual\") => {\n    if (billingCycle === \"annual\") {\n      return `$${price.toFixed(2)}/year`;\n    }\n    return `$${price.toFixed(2)}/month`;\n  };\n\n  const itemCount = getItemCount();\n  const totalPrice = getTotalPrice();\n\n  return (\n    <Sheet\n      open={isOpen}\n      onOpenChange={(open) => (open ? openCart() : closeCart())}\n    >\n      <SheetTrigger asChild>\n        <Button variant=\"outline\" size=\"icon\" className=\"relative\">\n          <ShoppingCartIcon className=\"h-4 w-4\" />\n          {itemCount > 0 && (\n            <Badge\n              variant=\"destructive\"\n              className=\"absolute -top-2 -right-2 h-5 w-5 flex items-center justify-center p-0 text-xs\"\n            >\n              {itemCount}\n            </Badge>\n          )}\n        </Button>\n      </SheetTrigger>\n      <SheetContent className=\"w-[400px] sm:w-[540px]\">\n        <SheetHeader>\n          <SheetTitle>Shopping Cart</SheetTitle>\n          <SheetDescription>\n            Review your plan upgrades and proceed to checkout\n          </SheetDescription>\n        </SheetHeader>\n\n        <div className=\"mt-6 space-y-4\">\n          {items.length === 0 ? (\n            <div className=\"text-center py-8\">\n              <ShoppingCartIcon className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n              <h3 className=\"text-lg font-medium mb-2\">Your cart is empty</h3>\n              <p className=\"text-muted-foreground mb-6\">\n                Add a premium plan to get started\n              </p>\n              <Button\n                onClick={() => {\n                  closeCart();\n                  navigate(\"/pricing\");\n                }}\n                className=\"w-full\"\n              >\n                View Pricing Plans\n              </Button>\n            </div>\n          ) : (\n            <>\n              {/* Cart Items */}\n              <div className=\"space-y-4\">\n                {items.map((item) => (\n                  <Card key={item.id}>\n                    <CardContent className=\"p-4\">\n                      <div className=\"flex items-start justify-between\">\n                        <div className=\"flex-1\">\n                          <h4 className=\"font-medium\">{item.name}</h4>\n                          <p className=\"text-sm text-muted-foreground mb-3\">\n                            {formatPrice(item.price, item.billingCycle)}\n                            {item.billingCycle === \"annual\" && (\n                              <Badge\n                                variant=\"secondary\"\n                                className=\"ml-2 text-xs\"\n                              >\n                                20% OFF\n                              </Badge>\n                            )}\n                          </p>\n\n                          {/* Users Selection */}\n                          <div className=\"space-y-3\">\n                            <div className=\"flex items-center gap-2\">\n                              <Users className=\"h-4 w-4\" />\n                              <span className=\"text-sm font-medium\">\n                                Number of users:\n                              </span>\n                              <Select\n                                value={item.users.toString()}\n                                onValueChange={(value) =>\n                                  updateUsers(item.id, parseInt(value))\n                                }\n                              >\n                                <SelectTrigger className=\"w-20\">\n                                  <SelectValue />\n                                </SelectTrigger>\n                                <SelectContent>\n                                  {Array.from(\n                                    { length: 20 },\n                                    (_, i) => i + 1,\n                                  ).map((num) => (\n                                    <SelectItem\n                                      key={num}\n                                      value={num.toString()}\n                                    >\n                                      {num}\n                                    </SelectItem>\n                                  ))}\n                                </SelectContent>\n                              </Select>\n                            </div>\n\n                            {/* Billing Cycle */}\n                            <div className=\"flex items-center gap-2\">\n                              <span className=\"text-sm font-medium\">\n                                Billing:\n                              </span>\n                              <Select\n                                value={item.billingCycle}\n                                onValueChange={(value: \"monthly\" | \"annual\") =>\n                                  updateBillingCycle(item.id, value)\n                                }\n                              >\n                                <SelectTrigger className=\"w-32\">\n                                  <SelectValue />\n                                </SelectTrigger>\n                                <SelectContent>\n                                  <SelectItem value=\"monthly\">\n                                    Monthly\n                                  </SelectItem>\n                                  <SelectItem value=\"annual\">\n                                    Annual\n                                    <Badge\n                                      variant=\"secondary\"\n                                      className=\"ml-2 text-xs\"\n                                    >\n                                      Save 20%\n                                    </Badge>\n                                  </SelectItem>\n                                </SelectContent>\n                              </Select>\n                            </div>\n\n                            {/* Quantity Controls */}\n                            <div className=\"flex items-center gap-2\">\n                              <span className=\"text-sm font-medium\">\n                                Quantity:\n                              </span>\n                              <div className=\"flex items-center gap-1\">\n                                <Button\n                                  variant=\"outline\"\n                                  size=\"icon\"\n                                  className=\"h-8 w-8\"\n                                  onClick={() =>\n                                    updateQuantity(item.id, item.quantity - 1)\n                                  }\n                                  disabled={item.quantity <= 1}\n                                >\n                                  <Minus className=\"h-3 w-3\" />\n                                </Button>\n                                <span className=\"w-8 text-center text-sm\">\n                                  {item.quantity}\n                                </span>\n                                <Button\n                                  variant=\"outline\"\n                                  size=\"icon\"\n                                  className=\"h-8 w-8\"\n                                  onClick={() =>\n                                    updateQuantity(item.id, item.quantity + 1)\n                                  }\n                                >\n                                  <Plus className=\"h-3 w-3\" />\n                                </Button>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n\n                        <Button\n                          variant=\"ghost\"\n                          size=\"icon\"\n                          onClick={() => removeItem(item.id)}\n                          className=\"h-8 w-8 text-muted-foreground hover:text-destructive\"\n                        >\n                          <X className=\"h-4 w-4\" />\n                        </Button>\n                      </div>\n                    </CardContent>\n                  </Card>\n                ))}\n              </div>\n\n              <Separator />\n\n              {/* Total */}\n              <div className=\"space-y-2\">\n                <div className=\"flex justify-between text-lg font-semibold\">\n                  <span>Total:</span>\n                  <span>${totalPrice.toFixed(2)}</span>\n                </div>\n                {items.some((item) => item.billingCycle === \"annual\") && (\n                  <p className=\"text-sm text-green-600\">\n                    Γ£ô You're saving 20% with annual billing!\n                  </p>\n                )}\n              </div>\n\n              {/* Checkout Button */}\n              <Button className=\"w-full\" onClick={handleCheckout}>\n                <CreditCard className=\"h-4 w-4 mr-2\" />\n                Proceed to Checkout - ${totalPrice.toFixed(2)}\n              </Button>\n\n              {/* Clear Cart */}\n              <Button variant=\"outline\" className=\"w-full\" onClick={clearCart}>\n                Clear Cart\n              </Button>\n            </>\n          )}\n        </div>\n      </SheetContent>\n    </Sheet>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\Sidebar.tsx","messages":[{"ruleId":"jsx-a11y/click-events-have-key-events","severity":1,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":103,"column":9,"nodeType":"JSXOpeningElement","endLine":106,"endColumn":11}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  Home,\n  Video,\n  Briefcase,\n  TrendingUp,\n  Settings,\n  HelpCircle,\n  FileText,\n  Building2,\n  Users,\n  Wrench,\n  CheckSquare,\n  Send,\n  LogOut,\n  UserCog,\n  X,\n  BarChart3,\n} from \"lucide-react\";\nimport { Link, useLocation } from \"react-router-dom\";\nimport { Avatar, AvatarImage, AvatarFallback } from \"@/components/ui/avatar\";\nimport { Button } from \"@/components/ui/button\";\nimport { useAuth } from \"@/lib/auth\";\nimport { USER_ROLES } from \"@shared/user-roles\";\nimport { cn } from \"@/lib/utils\";\nimport { AccountSwitcher } from \"@/components/account/AccountSwitcher\";\n\ninterface SidebarProps {\n  isOpen: boolean;\n  onClose: () => void;\n  collapsed?: boolean;\n}\n\nexport default function Sidebar({\n  isOpen,\n  onClose,\n  collapsed = false,\n}: SidebarProps) {\n  const { isAuthenticated, user, logout } = useAuth();\n  const location = useLocation();\n\n\n\n  const navigation = [\n    { name: \"Home\", href: \"/\", icon: Home, exactMatch: true },\n    {\n      name: \"Dashboard\",\n      href: \"/dashboard\",\n      icon: TrendingUp,\n      exactMatch: false,\n    },\n    { name: \"Resumes\", href: \"/resumes\", icon: FileText, exactMatch: false },\n    { name: \"Jobs\", href: \"/jobs\", icon: Briefcase, exactMatch: false },\n    {\n      name: \"Companies\",\n      href: \"/companies\",\n      icon: Building2,\n      exactMatch: false,\n    },\n    { name: \"People\", href: \"/people\", icon: Users, exactMatch: false },\n    { name: \"Tools\", href: \"/tools\", icon: Wrench, exactMatch: false },\n    { name: \"Tasks\", href: \"/tasks\", icon: CheckSquare, exactMatch: false },\n    { name: \"Outreach\", href: \"/outreach\", icon: Send, exactMatch: false },\n    { name: \"Account\", href: \"/account\", icon: UserCog, exactMatch: false },\n    // SuperAdmin only navigation\n    ...(user?.role === USER_ROLES.SUPER_ADMIN\n      ? [\n          {\n            name: \"Product Dashboard\",\n            href: \"/admin/product-dashboard\",\n            icon: BarChart3,\n            exactMatch: false,\n          },\n        ]\n      : []),\n  ];\n\n  // Helper function to determine if a menu item is active\n  const isMenuItemActive = (item: { href: string; exactMatch: boolean }) => {\n    if (item.exactMatch) {\n      return location.pathname === item.href;\n    }\n    // For non-exact matches, check if current path starts with the menu item path\n    // But make sure we don't match \"/\" for everything\n    if (item.href === \"/\") {\n      return location.pathname === \"/\";\n    }\n\n    // Special handling for tools - match both /tools and /Tools paths\n    if (item.href === \"/tools\") {\n      return (\n        location.pathname.startsWith(\"/tools\") ||\n        location.pathname.startsWith(\"/Tools\")\n      );\n    }\n\n    return location.pathname.startsWith(item.href);\n  };\n\n  return (\n    <>\n      {/* Overlay for mobile */}\n      {isOpen && (\n        <div\n          className=\"fixed inset-0 z-40 bg-black/50 lg:hidden\"\n          onClick={onClose}\n        />\n      )}\n\n      {/* Sidebar */}\n      <div\n        className={cn(\n          \"fixed top-0 left-0 h-full bg-background border-r border-border z-50 transform transition-all duration-300 ease-in-out\",\n          collapsed ? \"w-16 overflow-hidden\" : \"w-80 overflow-y-auto\",\n          // Mobile: hidden by default, show when isOpen\n          isOpen ? \"translate-x-0\" : \"-translate-x-full\",\n          // Desktop: always visible, ignore isOpen state\n          \"lg:translate-x-0 lg:fixed lg:z-auto\",\n        )}\n      >\n        <div className=\"flex flex-col h-full\">\n          {/* Header */}\n          <div className=\"flex items-center justify-between p-4 border-b border-border\">\n            <Link to=\"/\" className=\"flex items-center space-x-2\">\n              <Video className=\"h-6 w-6 text-primary\" />\n              {!collapsed && (\n                <span className=\"font-bold text-lg bg-gradient-to-r from-brand-purple to-brand-blue bg-clip-text text-transparent\">\n                  MyVideoResu.ME\n                </span>\n              )}\n            </Link>\n            <Button\n              variant=\"ghost\"\n              size=\"icon\"\n              onClick={onClose}\n              className=\"lg:hidden\"\n            >\n              <X className=\"h-5 w-5\" />\n            </Button>\n          </div>\n\n          <div\n            className={cn(\n              \"flex-1 p-4 space-y-6\",\n              collapsed ? \"overflow-hidden\" : \"overflow-y-auto\",\n            )}\n          >\n            {/* Navigation */}\n            <div>\n              {!collapsed && (\n                <h3 className=\"text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-3\">\n                  Navigate\n                </h3>\n              )}\n              <nav className=\"space-y-1\">\n                {navigation.map((item) => (\n                  <Link\n                    key={item.name}\n                    to={item.href}\n                    className={cn(\n                      \"flex items-center text-sm font-medium rounded-md transition-colors\",\n                      collapsed ? \"px-2 py-2 justify-center\" : \"px-3 py-2\",\n                      isMenuItemActive(item)\n                        ? \"bg-primary text-primary-foreground\"\n                        : \"text-muted-foreground hover:text-foreground hover:bg-muted\",\n                    )}\n                    onClick={onClose}\n                    title={collapsed ? item.name : undefined}\n                  >\n                    <item.icon\n                      className={cn(\"h-4 w-4\", !collapsed && \"mr-3\")}\n                    />\n                    {!collapsed && item.name}\n                  </Link>\n                ))}\n              </nav>\n            </div>\n          </div>\n\n          {/* Footer */}\n          <div className=\"border-t border-border p-4 space-y-2\">\n            {isAuthenticated && user ? (\n              <>\n                {/* Account Switcher */}\n                {!collapsed && (\n                  <div className=\"mb-3\">\n                    <AccountSwitcher className=\"w-full\" />\n                  </div>\n                )}\n\n                {/* User Profile Section */}\n                <Link\n                  to=\"/profile\"\n                  className={cn(\n                    \"flex items-center text-sm hover:bg-accent rounded-md transition-colors p-2\",\n                    collapsed ? \"justify-center\" : \"gap-3\",\n                  )}\n                  onClick={onClose}\n                  title={collapsed ? `Profile: ${user.name}` : undefined}\n                >\n                  <Avatar className=\"h-8 w-8\">\n                    <AvatarImage src={user.avatar} />\n                    <AvatarFallback className=\"text-xs\">\n                      {user.name\n                        ?.split(\" \")\n                        .map((n) => n[0])\n                        .join(\"\")\n                        .toUpperCase()}\n                    </AvatarFallback>\n                  </Avatar>\n                  {!collapsed && (\n                    <div className=\"flex-1 min-w-0\">\n                      <p className=\"text-sm font-medium truncate\">\n                        {user.name}\n                      </p>\n                      <p className=\"text-xs text-muted-foreground truncate capitalize\">\n                        {user.role?.replace(\"_\", \" \")}\n                      </p>\n                    </div>\n                  )}\n                </Link>\n\n                {/* Settings */}\n                <Link\n                  to=\"/settings\"\n                  className={cn(\n                    \"flex items-center text-sm rounded-md transition-colors\",\n                    collapsed ? \"justify-center px-2 py-2\" : \"gap-3 px-3 py-2\",\n                    isMenuItemActive({ href: \"/settings\", exactMatch: false })\n                      ? \"bg-primary text-primary-foreground\"\n                      : \"text-muted-foreground hover:text-foreground hover:bg-muted\",\n                  )}\n                  onClick={onClose}\n                  title={collapsed ? \"Settings\" : undefined}\n                >\n                  <Settings className=\"h-4 w-4\" />\n                  {!collapsed && \"Settings\"}\n                </Link>\n\n                {/* Sign Out */}\n                <button\n                  onClick={() => {\n                    logout();\n                    onClose();\n                  }}\n                  className={cn(\n                    \"w-full flex items-center text-sm text-muted-foreground hover:text-foreground rounded-md transition-colors\",\n                    collapsed ? \"justify-center px-2 py-2\" : \"gap-3 px-3 py-2\",\n                  )}\n                  title={collapsed ? \"Sign Out\" : undefined}\n                >\n                  <LogOut className=\"h-4 w-4\" />\n                  {!collapsed && \"Sign Out\"}\n                </button>\n              </>\n            ) : (\n              <>\n                {/* Non-authenticated users see Settings and Help */}\n                <Link\n                  to=\"/settings\"\n                  className={cn(\n                    \"flex items-center text-sm rounded-md transition-colors\",\n                    collapsed ? \"justify-center px-2 py-2\" : \"gap-3 px-3 py-2\",\n                    isMenuItemActive({ href: \"/settings\", exactMatch: false })\n                      ? \"bg-primary text-primary-foreground\"\n                      : \"text-muted-foreground hover:text-foreground hover:bg-muted\",\n                  )}\n                  onClick={onClose}\n                  title={collapsed ? \"Settings\" : undefined}\n                >\n                  <Settings className=\"h-4 w-4\" />\n                  {!collapsed && \"Settings\"}\n                </Link>\n                <Link\n                  to=\"/help\"\n                  className={cn(\n                    \"flex items-center text-sm rounded-md transition-colors\",\n                    collapsed ? \"justify-center px-2 py-2\" : \"gap-3 px-3 py-2\",\n                    isMenuItemActive({ href: \"/help\", exactMatch: false })\n                      ? \"bg-primary text-primary-foreground\"\n                      : \"text-muted-foreground hover:text-foreground hover:bg-muted\",\n                  )}\n                  onClick={onClose}\n                  title={collapsed ? \"Help & Support\" : undefined}\n                >\n                  <HelpCircle className=\"h-4 w-4\" />\n                  {!collapsed && \"Help & Support\"}\n                </Link>\n              </>\n            )}\n          </div>\n        </div>\n      </div>\n    </>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\VideoCard.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":77,"column":17,"nodeType":"MemberExpression","messageId":"unexpected","endLine":77,"endColumn":28,"suggestions":[{"fix":{"range":[2239,2273],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":90,"column":17,"nodeType":"MemberExpression","messageId":"unexpected","endLine":90,"endColumn":28,"suggestions":[{"fix":{"range":[2580,2629],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Play, Eye, Clock, User, Briefcase, Brain } from \"lucide-react\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent } from \"@/components/ui/card\";\nimport { CardActions } from \"@/components/ui/CardActions\";\nimport type { DynamicCardAction } from \"@/lib/dynamic-actions\";\nimport type { UserContext, ItemOwnership } from \"@/types/normalized-cards\";\n\ninterface VideoCardProps {\n  id: string;\n  title: string;\n  description: string;\n  thumbnail: string;\n  duration: string;\n  views: number;\n  type: \"resume\" | \"job_description\";\n  profession?: string;\n  company?: string;\n  createdAt: string;\n  actions?: DynamicCardAction[];\n  userContext?: UserContext;\n  itemOwnership?: ItemOwnership;\n  onView?: () => void;\n  onActions?: () => void;\n}\n\nexport default function VideoCard({\n  title,\n  description,\n  thumbnail,\n  duration,\n  views,\n  type,\n  profession,\n  company,\n  createdAt,\n  actions,\n  userContext: _userContext,  \n  itemOwnership: _itemOwnership,  \n  onView,\n  onActions,\n}: VideoCardProps) {\n  const formatViews = (count: number) => {\n    if (count >= 1000000) return `${(count / 1000000).toFixed(1)}M`;\n    if (count >= 1000) return `${(count / 1000).toFixed(1)}K`;\n    return count.toString();\n  };\n\n  const formatDate = (date: string) => {\n    if (!date) return \"Unknown date\";\n    const now = new Date();\n    const videoDate = new Date(date);\n    if (isNaN(videoDate.getTime())) return \"Invalid date\";\n    const diffTime = Math.abs(now.getTime() - videoDate.getTime());\n    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));\n\n    if (diffDays === 1) return \"1 day ago\";\n    if (diffDays < 7) return `${diffDays} days ago`;\n    if (diffDays < 30) return `${Math.floor(diffDays / 7)} weeks ago`;\n    return `${Math.floor(diffDays / 30)} months ago`;\n  };\n\n  // Use passed actions or fallback to default actions\n  const cardActions =\n    actions && actions.length > 0\n      ? actions\n      : [\n          {\n            id: \"view\",\n            label: \"View\",\n            variant: \"outline\" as const,\n            icon: Eye,\n            onClick: () => {\n              if (onView) {\n                onView();\n              } else {\n                console.log(\"View video:\", title);\n              }\n            },\n          },\n          {\n            id: \"actions\",\n            label: \"Actions\",\n            variant: \"default\" as const,\n            icon: Play,\n            onClick: () => {\n              if (onActions) {\n                onActions();\n              } else {\n                console.log(\"Actions clicked for video:\", title);\n              }\n            },\n          },\n        ];\n\n  return (\n    <Card className=\"group cursor-pointer hover:shadow-lg transition-shadow duration-300 border-0 bg-card overflow-hidden\">\n      <CardContent className=\"p-0\">\n        {/* Video Thumbnail Section */}\n        <div className=\"relative aspect-video bg-gradient-to-br from-muted to-muted/50 overflow-hidden\">\n          {/* Thumbnail image */}\n          {thumbnail ? (\n            <img\n              src={thumbnail}\n              alt={title}\n              className=\"absolute inset-0 w-full h-full object-cover\"\n            />\n          ) : (\n            /* Thumbnail placeholder with gradient */\n            <div className=\"absolute inset-0 bg-gradient-to-br from-brand-purple/20 to-brand-blue/20\" />\n          )}\n\n          {/* Play button overlay */}\n          <div className=\"absolute inset-0 flex items-center justify-center bg-black/0 group-hover:bg-black/20 transition-colors duration-300\">\n            <Button\n              size=\"icon\"\n              className=\"opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-black/50 hover:bg-black/70 text-white rounded-full h-12 w-12\"\n            >\n              <Play className=\"h-6 w-6 fill-current ml-1\" />\n            </Button>\n          </div>\n\n          {/* Duration badge */}\n          <div className=\"absolute bottom-2 right-2 bg-black/80 text-white text-xs px-2 py-1 rounded\">\n            {duration}\n          </div>\n\n          {/* Type badge */}\n          <div className=\"absolute top-2 left-2\">\n            <Badge\n              variant={type === \"resume\" ? \"default\" : \"secondary\"}\n              className=\"text-xs\"\n            >\n              {type === \"resume\" ? (\n                <>\n                  <User className=\"w-3 h-3 mr-1\" />\n                  Resume\n                </>\n              ) : (\n                <>\n                  <Briefcase className=\"w-3 h-3 mr-1\" />\n                  Job\n                </>\n              )}\n            </Badge>\n          </div>\n        </div>\n\n        {/* Content Section */}\n        <div className=\"p-4\">\n          <div className=\"space-y-2\">\n            <h3 className=\"font-semibold text-sm line-clamp-2 leading-tight group-hover:text-primary transition-colors\">\n              {title}\n            </h3>\n\n            <div className=\"flex items-center gap-2 text-xs text-muted-foreground\">\n              <Brain className=\"w-3 h-3\" />\n              <span>AI Generated</span>\n            </div>\n\n            {(profession || company) && (\n              <div className=\"text-xs text-muted-foreground\">\n                {profession && <span>{profession}</span>}\n                {profession && company && <span> ΓÇó </span>}\n                {company && <span>{company}</span>}\n              </div>\n            )}\n\n            <p className=\"text-xs text-muted-foreground line-clamp-2\">\n              {description}\n            </p>\n\n            <div className=\"flex items-center gap-3 text-xs text-muted-foreground pt-1\">\n              <div className=\"flex items-center gap-1\">\n                <Eye className=\"w-3 h-3\" />\n                <span>{formatViews(views)} views</span>\n              </div>\n              <div className=\"flex items-center gap-1\">\n                <Clock className=\"w-3 h-3\" />\n                <span>{formatDate(createdAt)}</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </CardContent>\n\n      <CardActions actions={cardActions} />\n    </Card>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\VideoResumeBuilder.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":134,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":134,"endColumn":20,"suggestions":[{"fix":{"range":[3688,3741],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-alert","severity":1,"message":"Unexpected alert.","line":142,"column":7,"nodeType":"CallExpression","messageId":"unexpected","endLine":142,"endColumn":55}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Video, Wand2, Save, Eye, Plus, X, Info } from \"lucide-react\";\nimport { VideoUpload } from \"./VideoUpload\";\nimport { ResumeData } from \"@/types/resume\";\n\ninterface VideoResumeBuilderProps {\n  resumeData?: ResumeData;\n  onSave: (videoResume: VideoResumeData) => void;\n  onCancel: () => void;\n}\n\ninterface VideoResumeData {\n  id?: string;\n  title: string;\n  description: string;\n  videoFile?: File;\n  videoUrl?: string;\n  thumbnail?: string;\n  duration?: number;\n  tags: string[];\n  visibility: \"public\" | \"private\" | \"unlisted\";\n  resumeData?: ResumeData;\n  metadata: {\n    createdAt: Date;\n    updatedAt: Date;\n    version: string;\n  };\n}\n\ninterface VideoUploadResult {\n  file: File;\n  url: string;\n  duration: number;\n  thumbnail?: string;\n  metadata: {\n    size: number;\n    format: string;\n    resolution?: string;\n    bitrate?: number;\n  };\n}\n\nexport function VideoResumeBuilder({\n  resumeData,\n  onSave,\n  onCancel,\n}: VideoResumeBuilderProps) {\n  const [activeTab, setActiveTab] = useState(\"upload\");\n  const [videoResume, setVideoResume] = useState<VideoResumeData>({\n    title: resumeData?.Basics?.Name\n      ? `${resumeData.Basics.Name} - Video Resume`\n      : \"My Video Resume\",\n    description: \"\",\n    tags: [],\n    visibility: \"private\",\n    resumeData,\n    metadata: {\n      createdAt: new Date(),\n      updatedAt: new Date(),\n      version: \"1.0\",\n    },\n  });\n\n  const [newTag, setNewTag] = useState(\"\");\n  const [isGeneratingAI, setIsGeneratingAI] = useState(false);\n  const [uploadedVideo, setUploadedVideo] = useState<VideoUploadResult | null>(\n    null,\n  );\n\n  const handleVideoUploaded = (videoData: VideoUploadResult) => {\n    setUploadedVideo(videoData);\n    setVideoResume((prev) => ({\n      ...prev,\n      videoFile: videoData.file,\n      videoUrl: videoData.url,\n      thumbnail: videoData.thumbnail,\n      duration: videoData.duration,\n      metadata: {\n        ...prev.metadata,\n        updatedAt: new Date(),\n      },\n    }));\n    setActiveTab(\"details\");\n  };\n\n  const handleAddTag = () => {\n    if (newTag.trim() && !videoResume.tags.includes(newTag.trim())) {\n      setVideoResume((prev) => ({\n        ...prev,\n        tags: [...prev.tags, newTag.trim()],\n      }));\n      setNewTag(\"\");\n    }\n  };\n\n  const handleRemoveTag = (tagToRemove: string) => {\n    setVideoResume((prev) => ({\n      ...prev,\n      tags: prev.tags.filter((tag) => tag !== tagToRemove),\n    }));\n  };\n\n  const handleGenerateAIVideo = async () => {\n    setIsGeneratingAI(true);\n    try {\n      // TODO: Implement AI video generation\n      // This would call an API to generate a video from resume data\n      await new Promise((resolve) => setTimeout(resolve, 3000)); // Simulate API call\n\n      // Mock generated video\n      const mockVideo = {\n        file: new File([\"\"], \"ai-generated-video.mp4\", { type: \"video/mp4\" }),\n        url: \"/mock-ai-video.mp4\",\n        duration: 120,\n        thumbnail: \"/mock-thumbnail.jpg\",\n        metadata: {\n          size: 15 * 1024 * 1024, // 15MB\n          format: \"video/mp4\",\n          resolution: \"1920x1080\",\n          bitrate: 1000,\n        },\n      };\n\n      handleVideoUploaded(mockVideo);\n    } catch (error) {\n      console.error(\"Failed to generate AI video:\", error);\n    } finally {\n      setIsGeneratingAI(false);\n    }\n  };\n\n  const handleSave = () => {\n    if (!uploadedVideo) {\n      alert(\"Please upload or generate a video first\");\n      return;\n    }\n\n    onSave(videoResume);\n  };\n\n  const canSave = uploadedVideo && videoResume.title.trim();\n\n  return (\n    <div className=\"max-w-4xl mx-auto space-y-6\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h1 className=\"text-3xl font-bold flex items-center gap-2\">\n            <Video className=\"h-8 w-8\" />\n            Create Video Resume\n          </h1>\n          <p className=\"text-muted-foreground mt-1\">\n            Upload your own video or let AI generate one from your resume\n          </p>\n        </div>\n        <div className=\"flex gap-2\">\n          <Button variant=\"outline\" onClick={onCancel}>\n            Cancel\n          </Button>\n          <Button onClick={handleSave} disabled={!canSave}>\n            <Save className=\"h-4 w-4 mr-2\" />\n            Save Video Resume\n          </Button>\n        </div>\n      </div>\n\n      <Tabs value={activeTab} onValueChange={setActiveTab}>\n        <TabsList className=\"grid w-full grid-cols-4\">\n          <TabsTrigger value=\"upload\">Upload Video</TabsTrigger>\n          <TabsTrigger value=\"ai-generate\">AI Generate</TabsTrigger>\n          <TabsTrigger value=\"details\">Details</TabsTrigger>\n          <TabsTrigger value=\"preview\">Preview</TabsTrigger>\n        </TabsList>\n\n        <TabsContent value=\"upload\" className=\"space-y-4\">\n          <VideoUpload\n            onVideoUploaded={handleVideoUploaded}\n            onCancel={onCancel}\n          />\n        </TabsContent>\n\n        <TabsContent value=\"ai-generate\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"flex items-center gap-2\">\n                <Wand2 className=\"h-5 w-5\" />\n                AI Video Generation\n              </CardTitle>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <Alert>\n                <Info className=\"h-4 w-4\" />\n                <AlertDescription>\n                  Our AI will create a professional video resume using your\n                  resume data, including voice narration and visual elements.\n                </AlertDescription>\n              </Alert>\n\n              {resumeData ? (\n                <div className=\"space-y-4\">\n                  <div className=\"p-4 bg-muted rounded-lg\">\n                    <h3 className=\"font-semibold mb-2\">Resume Data Preview</h3>\n                    <div className=\"text-sm space-y-1\">\n                      <p>\n                        <strong>Name:</strong>{\" \"}\n                        {resumeData.Basics?.Name || \"Not provided\"}\n                      </p>\n                      <p>\n                        <strong>Title:</strong>{\" \"}\n                        {resumeData.Basics?.Label || \"Not provided\"}\n                      </p>\n                      <p>\n                        <strong>Summary:</strong>{\" \"}\n                        {resumeData.Basics?.Summary?.substring(0, 100) ||\n                          \"Not provided\"}\n                        ...\n                      </p>\n                      <p>\n                        <strong>Experience:</strong>{\" \"}\n                        {resumeData.Work?.length || 0} positions\n                      </p>\n                      <p>\n                        <strong>Education:</strong>{\" \"}\n                        {resumeData.Education?.length || 0} entries\n                      </p>\n                    </div>\n                  </div>\n\n                  <Button\n                    onClick={handleGenerateAIVideo}\n                    disabled={isGeneratingAI}\n                    className=\"w-full\"\n                    size=\"lg\"\n                  >\n                    <Wand2 className=\"h-4 w-4 mr-2\" />\n                    {isGeneratingAI\n                      ? \"Generating Video...\"\n                      : \"Generate AI Video Resume\"}\n                  </Button>\n                </div>\n              ) : (\n                <div className=\"text-center py-8\">\n                  <p className=\"text-muted-foreground mb-4\">\n                    No resume data available. Please create or upload a resume\n                    first.\n                  </p>\n                  <Button variant=\"outline\">Go to Resume Builder</Button>\n                </div>\n              )}\n            </CardContent>\n          </Card>\n        </TabsContent>\n\n        <TabsContent value=\"details\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Video Details</CardTitle>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <div className=\"space-y-2\">\n                <Label htmlFor=\"title\">Title</Label>\n                <Input\n                  id=\"title\"\n                  value={videoResume.title}\n                  onChange={(e) =>\n                    setVideoResume((prev) => ({\n                      ...prev,\n                      title: e.target.value,\n                    }))\n                  }\n                  placeholder=\"Enter video resume title\"\n                />\n              </div>\n\n              <div className=\"space-y-2\">\n                <Label htmlFor=\"description\">Description</Label>\n                <Textarea\n                  id=\"description\"\n                  value={videoResume.description}\n                  onChange={(e) =>\n                    setVideoResume((prev) => ({\n                      ...prev,\n                      description: e.target.value,\n                    }))\n                  }\n                  placeholder=\"Describe your video resume...\"\n                  rows={4}\n                />\n              </div>\n\n              <div className=\"space-y-2\">\n                <Label>Tags</Label>\n                <div className=\"flex gap-2 mb-2\">\n                  <Input\n                    value={newTag}\n                    onChange={(e) => setNewTag(e.target.value)}\n                    placeholder=\"Add a tag\"\n                    onKeyPress={(e) => e.key === \"Enter\" && handleAddTag()}\n                  />\n                  <Button onClick={handleAddTag} size=\"sm\">\n                    <Plus className=\"h-4 w-4\" />\n                  </Button>\n                </div>\n                <div className=\"flex flex-wrap gap-2\">\n                  {videoResume.tags.map((tag, index) => (\n                    <Badge\n                      key={index}\n                      variant=\"secondary\"\n                      className=\"flex items-center gap-1\"\n                    >\n                      {tag}\n                      <X\n                        className=\"h-3 w-3 cursor-pointer\"\n                        onClick={() => handleRemoveTag(tag)}\n                      />\n                    </Badge>\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"space-y-2\">\n                <Label htmlFor=\"visibility\">Visibility</Label>\n                <select\n                  id=\"visibility\"\n                  value={videoResume.visibility}\n                  onChange={(e) =>\n                    setVideoResume((prev) => ({\n                      ...prev,\n                      visibility: e.target.value as\n                        | \"public\"\n                        | \"private\"\n                        | \"unlisted\",\n                    }))\n                  }\n                  className=\"w-full p-2 border rounded-md\"\n                >\n                  <option value=\"private\">Private - Only you can see</option>\n                  <option value=\"unlisted\">\n                    Unlisted - Anyone with link can see\n                  </option>\n                  <option value=\"public\">Public - Visible to everyone</option>\n                </select>\n              </div>\n            </CardContent>\n          </Card>\n        </TabsContent>\n\n        <TabsContent value=\"preview\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"flex items-center gap-2\">\n                <Eye className=\"h-5 w-5\" />\n                Preview\n              </CardTitle>\n            </CardHeader>\n            <CardContent>\n              {uploadedVideo ? (\n                <div className=\"space-y-4\">\n                  <div className=\"aspect-video bg-black rounded-lg overflow-hidden\">\n                    <video\n                      src={uploadedVideo.url}\n                      controls\n                      className=\"w-full h-full object-contain\"\n                      poster={uploadedVideo.thumbnail}\n                    />\n                  </div>\n\n                  <div className=\"space-y-2\">\n                    <h3 className=\"text-lg font-semibold\">\n                      {videoResume.title}\n                    </h3>\n                    {videoResume.description && (\n                      <p className=\"text-muted-foreground\">\n                        {videoResume.description}\n                      </p>\n                    )}\n\n                    <div className=\"flex items-center gap-4 text-sm text-muted-foreground\">\n                      <span>\n                        Duration: {Math.round(uploadedVideo.duration)}s\n                      </span>\n                      <span>\n                        Size:{\" \"}\n                        {Math.round(\n                          uploadedVideo.metadata.size / (1024 * 1024),\n                        )}\n                        MB\n                      </span>\n                      <span>\n                        Resolution: {uploadedVideo.metadata.resolution}\n                      </span>\n                    </div>\n\n                    {videoResume.tags.length > 0 && (\n                      <div className=\"flex flex-wrap gap-2\">\n                        {videoResume.tags.map((tag, index) => (\n                          <Badge key={index} variant=\"outline\">\n                            {tag}\n                          </Badge>\n                        ))}\n                      </div>\n                    )}\n                  </div>\n                </div>\n              ) : (\n                <div className=\"text-center py-8 text-muted-foreground\">\n                  <Video className=\"h-12 w-12 mx-auto mb-4 opacity-50\" />\n                  <p>No video uploaded yet</p>\n                </div>\n              )}\n            </CardContent>\n          </Card>\n        </TabsContent>\n      </Tabs>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\VideoUpload.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useCallback has a missing dependency: 'handleFileSelect'. Either include it or remove the dependency array.","line":198,"column":6,"nodeType":"ArrayExpression","endLine":198,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [handleFileSelect]","fix":{"range":[5185,5187],"text":"[handleFileSelect]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useRef, useCallback } from \"react\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { Progress } from \"@/components/ui/progress\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport {\n  Upload,\n  Play,\n  Pause,\n  RotateCcw,\n  X,\n  Video,\n  FileVideo,\n} from \"lucide-react\";\nimport { cn } from \"@/lib/utils\";\n\ninterface VideoUploadProps {\n  onVideoUploaded: (videoData: VideoUploadResult) => void;\n  onCancel?: () => void;\n  maxSizeBytes?: number;\n  acceptedFormats?: string[];\n  className?: string;\n}\n\ninterface VideoUploadResult {\n  file: File;\n  url: string;\n  duration: number;\n  thumbnail?: string;\n  metadata: {\n    size: number;\n    format: string;\n    resolution?: string;\n    bitrate?: number;\n  };\n}\n\nconst DEFAULT_ACCEPTED_FORMATS = [\n  \"video/mp4\",\n  \"video/webm\",\n  \"video/quicktime\",\n  \"video/x-msvideo\",\n];\n\nconst MAX_FILE_SIZE = 100 * 1024 * 1024; // 100MB\nconst MAX_DURATION = 300; // 5 minutes\n\nexport function VideoUpload({\n  onVideoUploaded,\n  onCancel,\n  maxSizeBytes = MAX_FILE_SIZE,\n  acceptedFormats = DEFAULT_ACCEPTED_FORMATS,\n  className,\n}: VideoUploadProps) {\n  const [isDragging, setIsDragging] = useState(false);\n  const [uploadProgress, setUploadProgress] = useState(0);\n  const [isProcessing, setIsProcessing] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [previewUrl, setPreviewUrl] = useState<string | null>(null);\n  const [videoMetadata, setVideoMetadata] = useState<{\n    duration?: number;\n    width?: number;\n    height?: number;\n    size?: number;\n    format?: string;\n    resolution?: string;\n  } | null>(null);\n  const [isPlaying, setIsPlaying] = useState(false);\n\n  const fileInputRef = useRef<HTMLInputElement>(null);\n  const videoRef = useRef<HTMLVideoElement>(null);\n  const canvasRef = useRef<HTMLCanvasElement>(null);\n\n  const validateFile = (file: File): string | null => {\n    if (!acceptedFormats.includes(file.type)) {\n      return `Unsupported format. Please use: ${acceptedFormats.map((f) => f.split(\"/\")[1]).join(\", \")}`;\n    }\n\n    if (file.size > maxSizeBytes) {\n      return `File too large. Maximum size: ${Math.round(maxSizeBytes / (1024 * 1024))}MB`;\n    }\n\n    return null;\n  };\n\n  const generateThumbnail = (video: HTMLVideoElement): Promise<string> => {\n    return new Promise((resolve) => {\n      const canvas = canvasRef.current;\n      const ctx = canvas.getContext(\"2d\");\n\n      canvas.width = video.videoWidth;\n      canvas.height = video.videoHeight;\n\n      ctx.drawImage(video, 0, 0);\n      resolve(canvas.toDataURL(\"image/jpeg\", 0.8));\n    });\n  };\n\n  const extractVideoMetadata = (\n    video: HTMLVideoElement,\n    file: File,\n  ): {\n    duration: number;\n    width: number;\n    height: number;\n    size: number;\n    format: string;\n    resolution: string;\n  } => {\n    return {\n      duration: video.duration,\n      width: video.videoWidth,\n      height: video.videoHeight,\n      size: file.size,\n      format: file.type,\n      resolution: `${video.videoWidth}x${video.videoHeight}`,\n    };\n  };\n\n  const processVideo = async (file: File) => {\n    setIsProcessing(true);\n    setError(null);\n\n    try {\n      const url = URL.createObjectURL(file);\n      setPreviewUrl(url);\n\n      // Create video element for metadata extraction\n      const video = document.createElement(\"video\");\n      video.src = url;\n\n      await new Promise((resolve, reject) => {\n        video.onloadedmetadata = resolve;\n        video.onerror = reject;\n      });\n\n      // Validate duration\n      if (video.duration > MAX_DURATION) {\n        throw new Error(\n          `Video too long. Maximum duration: ${MAX_DURATION / 60} minutes`,\n        );\n      }\n\n      const metadata = extractVideoMetadata(video, file);\n      setVideoMetadata(metadata);\n\n      // Generate thumbnail\n      video.currentTime = Math.min(2, video.duration / 2); // 2 seconds or middle\n      await new Promise((resolve) => {\n        video.onseeked = resolve;\n      });\n\n      if (videoRef.current) {\n        videoRef.current.src = url;\n      }\n\n      const thumbnail = await generateThumbnail(video);\n\n      const result: VideoUploadResult = {\n        file,\n        url,\n        duration: video.duration,\n        thumbnail,\n        metadata: {\n          size: file.size,\n          format: file.type,\n          resolution: metadata.resolution,\n          bitrate: Math.round((file.size * 8) / video.duration / 1000), // Rough estimate\n        },\n      };\n\n      onVideoUploaded(result);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to process video\");\n    } finally {\n      setIsProcessing(false);\n    }\n  };\n\n  const handleFileSelect = async (file: File) => {\n    const validationError = validateFile(file);\n    if (validationError) {\n      setError(validationError);\n      return;\n    }\n\n    await processVideo(file);\n  };\n\n  const handleDrop = useCallback((e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragging(false);\n\n    const files = Array.from(e.dataTransfer.files);\n    if (files.length > 0) {\n      handleFileSelect(files[0]);\n    }\n  }, []);\n\n  const handleDragOver = useCallback((e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragging(true);\n  }, []);\n\n  const handleDragLeave = useCallback((e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragging(false);\n  }, []);\n\n  const togglePlayback = () => {\n    if (videoRef.current) {\n      if (isPlaying) {\n        videoRef.current.pause();\n      } else {\n        videoRef.current.play();\n      }\n      setIsPlaying(!isPlaying);\n    }\n  };\n\n  const resetUpload = () => {\n    setPreviewUrl(null);\n    setVideoMetadata(null);\n    setError(null);\n    setUploadProgress(0);\n    setIsProcessing(false);\n    setIsPlaying(false);\n    if (fileInputRef.current) {\n      fileInputRef.current.value = \"\";\n    }\n  };\n\n  return (\n    <Card className={cn(\"w-full max-w-2xl mx-auto\", className)}>\n      <CardHeader>\n        <CardTitle className=\"flex items-center gap-2\">\n          <Video className=\"h-5 w-5\" />\n          Upload Video Resume\n        </CardTitle>\n      </CardHeader>\n      <CardContent className=\"space-y-4\">\n        {error && (\n          <Alert variant=\"destructive\">\n            <X className=\"h-4 w-4\" />\n            <AlertDescription>{error}</AlertDescription>\n          </Alert>\n        )}\n\n        {!previewUrl ? (\n          <div\n            className={cn(\n              \"border-2 border-dashed rounded-lg p-8 text-center transition-colors\",\n              isDragging\n                ? \"border-primary bg-primary/5\"\n                : \"border-muted-foreground/25\",\n              \"hover:border-primary/50 hover:bg-primary/5\",\n            )}\n            onDrop={handleDrop}\n            onDragOver={handleDragOver}\n            onDragLeave={handleDragLeave}\n          >\n            <FileVideo className=\"h-12 w-12 mx-auto mb-4 text-muted-foreground\" />\n            <h3 className=\"text-lg font-semibold mb-2\">\n              Upload Your Video Resume\n            </h3>\n            <p className=\"text-muted-foreground mb-4\">\n              Drag and drop your video file here, or click to browse\n            </p>\n            <p className=\"text-sm text-muted-foreground mb-4\">\n              Supported formats: MP4, WebM, MOV, AVI ΓÇó Max size:{\" \"}\n              {Math.round(maxSizeBytes / (1024 * 1024))}MB ΓÇó Max duration:{\" \"}\n              {MAX_DURATION / 60} minutes\n            </p>\n\n            <Button\n              onClick={() => fileInputRef.current?.click()}\n              disabled={isProcessing}\n              className=\"mb-2\"\n            >\n              <Upload className=\"h-4 w-4 mr-2\" />\n              Choose Video File\n            </Button>\n\n            <input\n              ref={fileInputRef}\n              type=\"file\"\n              accept={acceptedFormats.join(\",\")}\n              onChange={(e) => {\n                const file = e.target.files?.[0];\n                if (file) handleFileSelect(file);\n              }}\n              className=\"hidden\"\n            />\n          </div>\n        ) : (\n          <div className=\"space-y-4\">\n            {/* Video Preview */}\n            <div className=\"relative aspect-video bg-black rounded-lg overflow-hidden\">\n              <video\n                ref={videoRef}\n                className=\"w-full h-full object-contain\"\n                onPlay={() => setIsPlaying(true)}\n                onPause={() => setIsPlaying(false)}\n                controls={false}\n              />\n\n              {/* Custom Controls */}\n              <div className=\"absolute bottom-4 left-4 right-4 flex items-center gap-2\">\n                <Button\n                  size=\"sm\"\n                  variant=\"secondary\"\n                  onClick={togglePlayback}\n                  className=\"bg-black/50 hover:bg-black/70\"\n                >\n                  {isPlaying ? (\n                    <Pause className=\"h-4 w-4\" />\n                  ) : (\n                    <Play className=\"h-4 w-4\" />\n                  )}\n                </Button>\n\n                <div className=\"flex-1 text-white text-sm\">\n                  {videoMetadata && (\n                    <span>\n                      {Math.round(videoMetadata.duration)}s ΓÇó{\" \"}\n                      {videoMetadata.resolution}\n                    </span>\n                  )}\n                </div>\n              </div>\n            </div>\n\n            {/* Video Info */}\n            {videoMetadata && (\n              <div className=\"grid grid-cols-2 gap-4 text-sm\">\n                <div>\n                  <span className=\"font-medium\">Duration:</span>{\" \"}\n                  {Math.round(videoMetadata.duration)}s\n                </div>\n                <div>\n                  <span className=\"font-medium\">Size:</span>{\" \"}\n                  {Math.round(videoMetadata.size / (1024 * 1024))}MB\n                </div>\n                <div>\n                  <span className=\"font-medium\">Resolution:</span>{\" \"}\n                  {videoMetadata.resolution}\n                </div>\n                <div>\n                  <span className=\"font-medium\">Format:</span>{\" \"}\n                  {videoMetadata.format.split(\"/\")[1].toUpperCase()}\n                </div>\n              </div>\n            )}\n\n            {/* Processing Progress */}\n            {isProcessing && (\n              <div className=\"space-y-2\">\n                <div className=\"flex items-center justify-between text-sm\">\n                  <span>Processing video...</span>\n                  <span>{uploadProgress}%</span>\n                </div>\n                <Progress value={uploadProgress} />\n              </div>\n            )}\n\n            {/* Actions */}\n            <div className=\"flex gap-2\">\n              <Button onClick={resetUpload} variant=\"outline\">\n                <RotateCcw className=\"h-4 w-4 mr-2\" />\n                Choose Different Video\n              </Button>\n              {onCancel && (\n                <Button onClick={onCancel} variant=\"outline\">\n                  Cancel\n                </Button>\n              )}\n            </div>\n          </div>\n        )}\n\n        {/* Hidden canvas for thumbnail generation */}\n        <canvas ref={canvasRef} className=\"hidden\" />\n      </CardContent>\n    </Card>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\__tests__\\ActionsModal.promote.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\account\\AccountAnalytics.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":90,"column":11,"nodeType":"MemberExpression","messageId":"unexpected","endLine":90,"endColumn":24,"suggestions":[{"fix":{"range":[2092,2142],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport {\n  BarChart3,\n  Users,\n  Briefcase,\n  FileText,\n  TrendingUp,\n  TrendingDown,\n  Calendar,\n  Download,\n  Eye,\n  MessageSquare,\n} from \"lucide-react\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Progress } from \"@/components/ui/progress\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\n\ninterface AnalyticsData {\n  totalUsers: number;\n  activeUsers: number;\n  totalJobs: number;\n  totalResumes: number;\n  totalApplications: number;\n  userGrowth: number;\n  jobGrowth: number;\n  applicationGrowth: number;\n  topPerformingJobs: Array<{\n    id: string;\n    title: string;\n    applications: number;\n    views: number;\n  }>;\n  userActivity: Array<{\n    date: string;\n    activeUsers: number;\n    newUsers: number;\n  }>;\n  departmentStats: Array<{\n    department: string;\n    users: number;\n    jobs: number;\n    applications: number;\n  }>;\n}\n\ninterface AccountAnalyticsProps {\n  data?: AnalyticsData;\n  loading?: boolean;\n  onExport?: (format: \"csv\" | \"pdf\") => void;\n  onLoadAnalytics?: () => Promise<AnalyticsData>;\n}\n\nexport function AccountAnalytics({\n  data,\n  loading = false,\n  onExport,\n  onLoadAnalytics,\n}: AccountAnalyticsProps) {\n  const [timeRange, setTimeRange] = useState(\"30d\");\n  const [selectedTab, setSelectedTab] = useState(\"overview\");\n  const [analyticsData, setAnalyticsData] = useState<AnalyticsData | null>(\n    null,\n  );\n  const [loadingAnalytics, setLoadingAnalytics] = useState(false);\n\n  // Load analytics data on mount\n  useEffect(() => {\n    const loadAnalytics = async () => {\n      if (onLoadAnalytics && !data) {\n        setLoadingAnalytics(true);\n        try {\n          const apiData = await onLoadAnalytics();\n          setAnalyticsData(apiData);\n        } catch (error) {\n          console.error(\"Failed to load analytics:\", error);\n          // Fall back to mock data on error\n        } finally {\n          setLoadingAnalytics(false);\n        }\n      }\n    };\n\n    loadAnalytics();\n  }, [onLoadAnalytics, data]);\n\n  // Use real data if available, otherwise fall back to mock data\n  const mockData: AnalyticsData = analyticsData ||\n    data || {\n      totalUsers: 156,\n      activeUsers: 89,\n      totalJobs: 45,\n      totalResumes: 234,\n      totalApplications: 1247,\n      userGrowth: 12.5,\n      jobGrowth: 8.3,\n      applicationGrowth: 15.7,\n      topPerformingJobs: [\n        {\n          id: \"1\",\n          title: \"Senior Software Engineer\",\n          applications: 89,\n          views: 456,\n        },\n        { id: \"2\", title: \"Product Manager\", applications: 67, views: 234 },\n        { id: \"3\", title: \"UX Designer\", applications: 45, views: 189 },\n        { id: \"4\", title: \"Data Scientist\", applications: 34, views: 167 },\n      ],\n      userActivity: [\n        { date: \"2024-01-01\", activeUsers: 45, newUsers: 5 },\n        { date: \"2024-01-02\", activeUsers: 52, newUsers: 8 },\n        { date: \"2024-01-03\", activeUsers: 48, newUsers: 3 },\n        { date: \"2024-01-04\", activeUsers: 61, newUsers: 12 },\n        { date: \"2024-01-05\", activeUsers: 58, newUsers: 7 },\n      ],\n      departmentStats: [\n        { department: \"Engineering\", users: 45, jobs: 12, applications: 234 },\n        { department: \"Product\", users: 23, jobs: 8, applications: 156 },\n        { department: \"Design\", users: 18, jobs: 6, applications: 89 },\n        { department: \"Marketing\", users: 15, jobs: 4, applications: 67 },\n      ],\n    };\n\n  const formatNumber = (num: number) => {\n    if (num >= 1000) return `${(num / 1000).toFixed(1)}k`;\n    return num.toString();\n  };\n\n  const formatGrowth = (growth: number) => {\n    const isPositive = growth > 0;\n    return (\n      <div\n        className={`flex items-center gap-1 ${isPositive ? \"text-green-600\" : \"text-red-600\"}`}\n      >\n        {isPositive ? (\n          <TrendingUp className=\"h-4 w-4\" />\n        ) : (\n          <TrendingDown className=\"h-4 w-4\" />\n        )}\n        <span className=\"text-sm font-medium\">{Math.abs(growth)}%</span>\n      </div>\n    );\n  };\n\n  if (loading || loadingAnalytics) {\n    return (\n      <div className=\"space-y-6\">\n        <div className=\"animate-pulse\">\n          <div className=\"h-8 bg-gray-200 rounded w-1/4 mb-4\" />\n          <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4 mb-6\">\n            {[...Array(4)].map((_, i) => (\n              <div key={i} className=\"h-32 bg-gray-200 rounded\" />\n            ))}\n          </div>\n          <div className=\"h-64 bg-gray-200 rounded\" />\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex items-center justify-between\">\n        <div className=\"flex items-center gap-2\">\n          <BarChart3 className=\"h-6 w-6\" />\n          <h2 className=\"text-2xl font-bold\">Account Analytics</h2>\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <Select value={timeRange} onValueChange={setTimeRange}>\n            <SelectTrigger className=\"w-32\">\n              <SelectValue />\n            </SelectTrigger>\n            <SelectContent>\n              <SelectItem value=\"7d\">Last 7 days</SelectItem>\n              <SelectItem value=\"30d\">Last 30 days</SelectItem>\n              <SelectItem value=\"90d\">Last 90 days</SelectItem>\n              <SelectItem value=\"1y\">Last year</SelectItem>\n            </SelectContent>\n          </Select>\n          {onExport && (\n            <Button variant=\"outline\" onClick={() => onExport(\"csv\")}>\n              <Download className=\"h-4 w-4 mr-2\" />\n              Export\n            </Button>\n          )}\n        </div>\n      </div>\n\n      {/* Key Metrics */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n        <Card>\n          <CardContent className=\"p-6\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <p className=\"text-sm font-medium text-muted-foreground\">\n                  Total Users\n                </p>\n                <p className=\"text-2xl font-bold\">\n                  {formatNumber(mockData.totalUsers)}\n                </p>\n              </div>\n              <div className=\"flex flex-col items-end\">\n                <Users className=\"h-8 w-8 text-blue-600\" />\n                {formatGrowth(mockData.userGrowth)}\n              </div>\n            </div>\n            <div className=\"mt-4\">\n              <Progress\n                value={(mockData.activeUsers / mockData.totalUsers) * 100}\n                className=\"h-2\"\n              />\n              <p className=\"text-xs text-muted-foreground mt-2\">\n                {mockData.activeUsers} active users\n              </p>\n            </div>\n          </CardContent>\n        </Card>\n\n        <Card>\n          <CardContent className=\"p-6\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <p className=\"text-sm font-medium text-muted-foreground\">\n                  Total Jobs\n                </p>\n                <p className=\"text-2xl font-bold\">\n                  {formatNumber(mockData.totalJobs)}\n                </p>\n              </div>\n              <div className=\"flex flex-col items-end\">\n                <Briefcase className=\"h-8 w-8 text-green-600\" />\n                {formatGrowth(mockData.jobGrowth)}\n              </div>\n            </div>\n          </CardContent>\n        </Card>\n\n        <Card>\n          <CardContent className=\"p-6\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <p className=\"text-sm font-medium text-muted-foreground\">\n                  Total Resumes\n                </p>\n                <p className=\"text-2xl font-bold\">\n                  {formatNumber(mockData.totalResumes)}\n                </p>\n              </div>\n              <div className=\"flex flex-col items-end\">\n                <FileText className=\"h-8 w-8 text-purple-600\" />\n                {formatGrowth(12.3)}\n              </div>\n            </div>\n          </CardContent>\n        </Card>\n\n        <Card>\n          <CardContent className=\"p-6\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <p className=\"text-sm font-medium text-muted-foreground\">\n                  Applications\n                </p>\n                <p className=\"text-2xl font-bold\">\n                  {formatNumber(mockData.totalApplications)}\n                </p>\n              </div>\n              <div className=\"flex flex-col items-end\">\n                <MessageSquare className=\"h-8 w-8 text-orange-600\" />\n                {formatGrowth(mockData.applicationGrowth)}\n              </div>\n            </div>\n          </CardContent>\n        </Card>\n      </div>\n\n      {/* Detailed Analytics */}\n      <Tabs value={selectedTab} onValueChange={setSelectedTab}>\n        <TabsList>\n          <TabsTrigger value=\"overview\">Overview</TabsTrigger>\n          <TabsTrigger value=\"jobs\">Job Performance</TabsTrigger>\n          <TabsTrigger value=\"users\">User Activity</TabsTrigger>\n          <TabsTrigger value=\"departments\">Departments</TabsTrigger>\n        </TabsList>\n\n        <TabsContent value=\"overview\" className=\"space-y-4\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n            <Card>\n              <CardHeader>\n                <CardTitle>User Growth Trend</CardTitle>\n                <CardDescription>Daily active and new users</CardDescription>\n              </CardHeader>\n              <CardContent>\n                <div className=\"h-64 flex items-center justify-center text-muted-foreground\">\n                  <div className=\"text-center\">\n                    <BarChart3 className=\"h-12 w-12 mx-auto mb-2 opacity-50\" />\n                    <p>Chart visualization would go here</p>\n                    <p className=\"text-sm\">\n                      Integration with charting library needed\n                    </p>\n                  </div>\n                </div>\n              </CardContent>\n            </Card>\n\n            <Card>\n              <CardHeader>\n                <CardTitle>Application Trends</CardTitle>\n                <CardDescription>Job applications over time</CardDescription>\n              </CardHeader>\n              <CardContent>\n                <div className=\"h-64 flex items-center justify-center text-muted-foreground\">\n                  <div className=\"text-center\">\n                    <TrendingUp className=\"h-12 w-12 mx-auto mb-2 opacity-50\" />\n                    <p>Chart visualization would go here</p>\n                    <p className=\"text-sm\">\n                      Integration with charting library needed\n                    </p>\n                  </div>\n                </div>\n              </CardContent>\n            </Card>\n          </div>\n        </TabsContent>\n\n        <TabsContent value=\"jobs\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Top Performing Jobs</CardTitle>\n              <CardDescription>\n                Jobs with the most applications and views\n              </CardDescription>\n            </CardHeader>\n            <CardContent>\n              <div className=\"space-y-4\">\n                {mockData.topPerformingJobs.map((job, index) => (\n                  <div\n                    key={job.id}\n                    className=\"flex items-center justify-between p-4 border rounded-lg\"\n                  >\n                    <div className=\"flex items-center gap-3\">\n                      <Badge variant=\"secondary\">#{index + 1}</Badge>\n                      <div>\n                        <p className=\"font-medium\">{job.title}</p>\n                        <div className=\"flex items-center gap-4 text-sm text-muted-foreground\">\n                          <span className=\"flex items-center gap-1\">\n                            <MessageSquare className=\"h-4 w-4\" />\n                            {job.applications} applications\n                          </span>\n                          <span className=\"flex items-center gap-1\">\n                            <Eye className=\"h-4 w-4\" />\n                            {job.views} views\n                          </span>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"text-right\">\n                      <p className=\"text-sm font-medium\">\n                        {((job.applications / job.views) * 100).toFixed(1)}%\n                        conversion\n                      </p>\n                      <Progress\n                        value={(job.applications / job.views) * 100}\n                        className=\"w-20 h-2 mt-1\"\n                      />\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </CardContent>\n          </Card>\n        </TabsContent>\n\n        <TabsContent value=\"users\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <CardTitle>User Activity</CardTitle>\n              <CardDescription>Daily user engagement metrics</CardDescription>\n            </CardHeader>\n            <CardContent>\n              <div className=\"space-y-4\">\n                {mockData.userActivity.map((day, index) => (\n                  <div\n                    key={index}\n                    className=\"flex items-center justify-between p-4 border rounded-lg\"\n                  >\n                    <div className=\"flex items-center gap-3\">\n                      <Calendar className=\"h-5 w-5 text-muted-foreground\" />\n                      <div>\n                        <p className=\"font-medium\">\n                          {new Date(day.date).toLocaleDateString()}\n                        </p>\n                        <p className=\"text-sm text-muted-foreground\">\n                          {day.activeUsers} active ΓÇó {day.newUsers} new\n                        </p>\n                      </div>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <Badge variant=\"outline\">{day.activeUsers} active</Badge>\n                      <Badge variant=\"secondary\">{day.newUsers} new</Badge>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </CardContent>\n          </Card>\n        </TabsContent>\n\n        <TabsContent value=\"departments\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Department Statistics</CardTitle>\n              <CardDescription>\n                Performance metrics by department\n              </CardDescription>\n            </CardHeader>\n            <CardContent>\n              <div className=\"space-y-4\">\n                {mockData.departmentStats.map((dept, index) => (\n                  <div\n                    key={index}\n                    className=\"flex items-center justify-between p-4 border rounded-lg\"\n                  >\n                    <div>\n                      <p className=\"font-medium\">{dept.department}</p>\n                      <div className=\"flex items-center gap-4 text-sm text-muted-foreground mt-1\">\n                        <span className=\"flex items-center gap-1\">\n                          <Users className=\"h-4 w-4\" />\n                          {dept.users} users\n                        </span>\n                        <span className=\"flex items-center gap-1\">\n                          <Briefcase className=\"h-4 w-4\" />\n                          {dept.jobs} jobs\n                        </span>\n                        <span className=\"flex items-center gap-1\">\n                          <MessageSquare className=\"h-4 w-4\" />\n                          {dept.applications} applications\n                        </span>\n                      </div>\n                    </div>\n                    <div className=\"text-right\">\n                      <p className=\"text-sm font-medium\">\n                        {(dept.applications / dept.jobs).toFixed(1)} avg\n                        applications/job\n                      </p>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </CardContent>\n          </Card>\n        </TabsContent>\n      </Tabs>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\account\\AccountManagementSkeleton.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\account\\AccountSettings.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\account\\AccountSwitcher.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":41,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":41,"endColumn":20,"suggestions":[{"fix":{"range":[1468,1527],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { Building2, ChevronDown, Check, Crown, Shield } from \"lucide-react\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\";\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { accountService } from \"@/lib/services/account-service\";\nimport { AccountOption } from \"@/types/account\";\nimport { getRoleDisplayLabel } from \"@/lib/role-utils\";\n\ninterface AccountSwitcherProps {\n  className?: string;\n}\n\nexport function AccountSwitcher({ className }: AccountSwitcherProps) {\n  const [accounts, setAccounts] = useState<AccountOption[]>([]);\n  const [currentAccountId, setCurrentAccountId] = useState<string | null>(null);\n  const [loading, setLoading] = useState(false);\n  const { toast } = useToast();\n\n  useEffect(() => {\n    loadAvailableAccounts();\n    // Get current account from localStorage\n    const savedAccountId = localStorage.getItem(\"currentAccountId\");\n    setCurrentAccountId(savedAccountId);\n  }, []);\n\n  const loadAvailableAccounts = async () => {\n    try {\n      const availableAccounts = await accountService.getAvailableAccounts();\n      setAccounts(availableAccounts);\n    } catch (error) {\n      console.error(\"Failed to load available accounts:\", error);\n      // Don't show error toast for this as it's not critical\n    }\n  };\n\n  const handleAccountSwitch = async (accountId: string) => {\n    if (accountId === currentAccountId) return;\n\n    setLoading(true);\n    try {\n      await accountService.switchAccount(accountId);\n      setCurrentAccountId(accountId);\n\n      toast({\n        title: \"Account Switched\",\n        description: \"Successfully switched to the selected account.\",\n      });\n\n      // Refresh the page to update all data with new account context\n      window.location.reload();\n    } catch (error) {\n      const errorMessage =\n        error instanceof Error ? error.message : \"Failed to switch account\";\n      toast({\n        title: \"Error\",\n        description: errorMessage,\n        variant: \"destructive\",\n      });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const getCurrentAccount = (): AccountOption | null => {\n    return accounts.find((account) => account.id === currentAccountId) || null;\n  };\n\n  const getRoleIcon = (role: string) => {\n    switch (role) {\n      case \"Admin\":\n        return <Crown className=\"h-3 w-3\" />;\n      case \"Employer\":\n        return <Shield className=\"h-3 w-3\" />;\n      default:\n        return null;\n    }\n  };\n\n  const getRoleBadgeColor = (role: string): string => {\n    switch (role) {\n      case \"Admin\":\n        return \"bg-purple-100 text-purple-800\";\n      case \"Employer\":\n        return \"bg-blue-100 text-blue-800\";\n      case \"Recruiter\":\n        return \"bg-green-100 text-green-800\";\n      default:\n        return \"bg-gray-100 text-gray-800\";\n    }\n  };\n\n  // Don't render if no accounts available or only one account\n  if (accounts.length <= 1) {\n    return null;\n  }\n\n  const currentAccount = getCurrentAccount();\n\n  return (\n    <DropdownMenu>\n      <DropdownMenuTrigger asChild>\n        <Button\n          variant=\"outline\"\n          className={`flex items-center gap-2 ${className}`}\n          disabled={loading}\n        >\n          <div className=\"flex items-center gap-2\">\n            <Avatar className=\"h-6 w-6\">\n              <AvatarImage src={currentAccount?.logoUrl} />\n              <AvatarFallback>\n                <Building2 className=\"h-3 w-3\" />\n              </AvatarFallback>\n            </Avatar>\n            <div className=\"flex flex-col items-start\">\n              <span className=\"text-sm font-medium\">\n                {currentAccount?.name || \"Select Account\"}\n              </span>\n              {currentAccount && (\n                <Badge\n                  variant=\"secondary\"\n                  className={`text-xs ${getRoleBadgeColor(currentAccount.role)}`}\n                >\n                  {getRoleIcon(currentAccount.role)}\n                  <span className=\"ml-1\">\n                    {getRoleDisplayLabel(currentAccount.role)}\n                  </span>\n                </Badge>\n              )}\n            </div>\n          </div>\n          <ChevronDown className=\"h-4 w-4 opacity-50\" />\n        </Button>\n      </DropdownMenuTrigger>\n\n      <DropdownMenuContent align=\"end\" className=\"w-80\">\n        <DropdownMenuLabel>Switch Account</DropdownMenuLabel>\n        <DropdownMenuSeparator />\n\n        {accounts.map((account) => (\n          <DropdownMenuItem\n            key={account.id}\n            onClick={() => handleAccountSwitch(account.id)}\n            className=\"flex items-center gap-3 p-3 cursor-pointer\"\n          >\n            <Avatar className=\"h-8 w-8\">\n              <AvatarImage src={account.logoUrl} />\n              <AvatarFallback>\n                <Building2 className=\"h-4 w-4\" />\n              </AvatarFallback>\n            </Avatar>\n\n            <div className=\"flex-1\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-medium\">{account.name}</span>\n                {account.id === currentAccountId && (\n                  <Check className=\"h-4 w-4 text-green-600\" />\n                )}\n              </div>\n              <div className=\"flex items-center gap-2 mt-1\">\n                <Badge\n                  variant=\"secondary\"\n                  className={`text-xs ${getRoleBadgeColor(account.role)}`}\n                >\n                  {getRoleIcon(account.role)}\n                  <span className=\"ml-1\">\n                    {getRoleDisplayLabel(account.role)}\n                  </span>\n                </Badge>\n                {account.isOwner && (\n                  <Badge variant=\"outline\" className=\"text-xs\">\n                    Owner\n                  </Badge>\n                )}\n              </div>\n            </div>\n          </DropdownMenuItem>\n        ))}\n\n        <DropdownMenuSeparator />\n\n        <DropdownMenuItem className=\"text-sm text-gray-600 p-3\">\n          <div>\n            <p className=\"font-medium\">Need to create a new account?</p>\n            <p className=\"text-xs mt-1\">\n              Contact support or upgrade your plan to create additional\n              accounts.\n            </p>\n          </div>\n        </DropdownMenuItem>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\account\\BulkInviteModal.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":389,"column":45,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[12267,12392],"text":"\n                  No users added yet. Click &quot;Add User\" or import from CSV to get\n                  started.\n                "},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[12267,12392],"text":"\n                  No users added yet. Click &ldquo;Add User\" or import from CSV to get\n                  started.\n                "},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[12267,12392],"text":"\n                  No users added yet. Click &#34;Add User\" or import from CSV to get\n                  started.\n                "},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[12267,12392],"text":"\n                  No users added yet. Click &rdquo;Add User\" or import from CSV to get\n                  started.\n                "},"desc":"Replace with `&rdquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":389,"column":54,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[12267,12392],"text":"\n                  No users added yet. Click \"Add User&quot; or import from CSV to get\n                  started.\n                "},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[12267,12392],"text":"\n                  No users added yet. Click \"Add User&ldquo; or import from CSV to get\n                  started.\n                "},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[12267,12392],"text":"\n                  No users added yet. Click \"Add User&#34; or import from CSV to get\n                  started.\n                "},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[12267,12392],"text":"\n                  No users added yet. Click \"Add User&rdquo; or import from CSV to get\n                  started.\n                "},"desc":"Replace with `&rdquo;`."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\nimport { Upload, Users, X, Plus, Download, AlertCircle } from \"lucide-react\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport {\n  Dialog,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n} from \"@/components/ui/dialog\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport {\n  BulkInviteUsersRequest,\n  BulkInviteUserItem,\n  BulkInviteUsersResponse,\n  getAvailableRolesForInvite,\n} from \"@/types/account\";\nimport { getRoleDisplayLabel } from \"@/lib/role-utils\";\n\ninterface BulkInviteModalProps {\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n  onBulkInvite: (\n    data: BulkInviteUsersRequest,\n  ) => Promise<BulkInviteUsersResponse>;\n  currentUserRoles: string[];\n}\n\nexport function BulkInviteModal({\n  open,\n  onOpenChange,\n  onBulkInvite,\n  currentUserRoles,\n}: BulkInviteModalProps) {\n  const [users, setUsers] = useState<BulkInviteUserItem[]>([]);\n  const [defaultRoles, setDefaultRoles] = useState<string[]>([]);\n  const [defaultMessage, setDefaultMessage] = useState(\"\");\n  const [csvInput, setCsvInput] = useState(\"\");\n  const [loading, setLoading] = useState(false);\n  const [result, setResult] = useState<BulkInviteUsersResponse | null>(null);\n  const [errors, setErrors] = useState<string[]>([]);\n\n  const availableRoles = getAvailableRolesForInvite(currentUserRoles);\n\n  const handleAddUser = () => {\n    setUsers([...users, { email: \"\", firstName: \"\", lastName: \"\" }]);\n  };\n\n  const handleRemoveUser = (index: number) => {\n    setUsers(users.filter((_, i) => i !== index));\n  };\n\n  const handleUserChange = (\n    index: number,\n    field: keyof BulkInviteUserItem,\n    value: string,\n  ) => {\n    const updatedUsers = [...users];\n    updatedUsers[index] = { ...updatedUsers[index], [field]: value };\n    setUsers(updatedUsers);\n  };\n\n  const handleRoleToggle = (role: string) => {\n    setDefaultRoles((prev) =>\n      prev.includes(role) ? prev.filter((r) => r !== role) : [...prev, role],\n    );\n  };\n\n  const parseCsvInput = () => {\n    if (!csvInput.trim()) return;\n\n    const lines = csvInput.trim().split(\"\\n\");\n    const newUsers: BulkInviteUserItem[] = [];\n    const parseErrors: string[] = [];\n\n    lines.forEach((line, index) => {\n      const [email, firstName, lastName] = line.split(\",\").map((s) => s.trim());\n\n      if (!email) {\n        parseErrors.push(`Line ${index + 1}: Email is required`);\n        return;\n      }\n\n      if (!email.includes(\"@\")) {\n        parseErrors.push(`Line ${index + 1}: Invalid email format`);\n        return;\n      }\n\n      newUsers.push({\n        email,\n        firstName: firstName || \"\",\n        lastName: lastName || \"\",\n      });\n    });\n\n    if (parseErrors.length > 0) {\n      setErrors(parseErrors);\n      return;\n    }\n\n    setUsers([...users, ...newUsers]);\n    setCsvInput(\"\");\n    setErrors([]);\n  };\n\n  const validateForm = () => {\n    const validationErrors: string[] = [];\n\n    if (users.length === 0) {\n      validationErrors.push(\"At least one user must be added\");\n    }\n\n    if (defaultRoles.length === 0) {\n      validationErrors.push(\"At least one default role must be selected\");\n    }\n\n    users.forEach((user, index) => {\n      if (!user.email) {\n        validationErrors.push(`User ${index + 1}: Email is required`);\n      } else if (!user.email.includes(\"@\")) {\n        validationErrors.push(`User ${index + 1}: Invalid email format`);\n      }\n    });\n\n    setErrors(validationErrors);\n    return validationErrors.length === 0;\n  };\n\n  const handleSubmit = async () => {\n    if (!validateForm()) return;\n\n    setLoading(true);\n    try {\n      const request: BulkInviteUsersRequest = {\n        users,\n        defaultRoles,\n        defaultMessage: defaultMessage.trim() || undefined,\n      };\n\n      const response = await onBulkInvite(request);\n      setResult(response);\n\n      if (response.failureCount === 0) {\n        // All successful, close modal after a delay\n        setTimeout(() => {\n          handleClose();\n        }, 2000);\n      }\n    } catch {\n      setErrors([\"Failed to send bulk invitations. Please try again.\"]);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleClose = () => {\n    setUsers([]);\n    setDefaultRoles([]);\n    setDefaultMessage(\"\");\n    setCsvInput(\"\");\n    setResult(null);\n    setErrors([]);\n    onOpenChange(false);\n  };\n\n  const downloadTemplate = () => {\n    const csvContent =\n      \"email,firstName,lastName\\nexample@company.com,John,Doe\\nuser@domain.com,Jane,Smith\";\n    const blob = new Blob([csvContent], { type: \"text/csv\" });\n    const url = window.URL.createObjectURL(blob);\n    const a = document.createElement(\"a\");\n    a.href = url;\n    a.download = \"bulk-invite-template.csv\";\n    a.click();\n    window.URL.revokeObjectURL(url);\n  };\n\n  if (result) {\n    return (\n      <Dialog open={open} onOpenChange={onOpenChange}>\n        <DialogContent className=\"max-w-2xl\">\n          <DialogHeader>\n            <DialogTitle className=\"flex items-center gap-2\">\n              <Users className=\"h-5 w-5\" />\n              Bulk Invitation Results\n            </DialogTitle>\n          </DialogHeader>\n\n          <div className=\"space-y-4\">\n            <div className=\"grid grid-cols-3 gap-4\">\n              <Card>\n                <CardContent className=\"p-4 text-center\">\n                  <p className=\"text-2xl font-bold text-blue-600\">\n                    {result.totalProcessed}\n                  </p>\n                  <p className=\"text-sm text-gray-600\">Total Processed</p>\n                </CardContent>\n              </Card>\n              <Card>\n                <CardContent className=\"p-4 text-center\">\n                  <p className=\"text-2xl font-bold text-green-600\">\n                    {result.successCount}\n                  </p>\n                  <p className=\"text-sm text-gray-600\">Successful</p>\n                </CardContent>\n              </Card>\n              <Card>\n                <CardContent className=\"p-4 text-center\">\n                  <p className=\"text-2xl font-bold text-red-600\">\n                    {result.failureCount}\n                  </p>\n                  <p className=\"text-sm text-gray-600\">Failed</p>\n                </CardContent>\n              </Card>\n            </div>\n\n            {result.failedInvitations.length > 0 && (\n              <Card>\n                <CardHeader>\n                  <CardTitle className=\"text-red-600\">\n                    Failed Invitations\n                  </CardTitle>\n                </CardHeader>\n                <CardContent>\n                  <div className=\"space-y-2\">\n                    {result.failedInvitations.map((failure, index) => (\n                      <div\n                        key={index}\n                        className=\"flex justify-between items-center p-2 bg-red-50 rounded\"\n                      >\n                        <span className=\"font-medium\">{failure.email}</span>\n                        <span className=\"text-sm text-red-600\">\n                          {failure.message}\n                        </span>\n                      </div>\n                    ))}\n                  </div>\n                </CardContent>\n              </Card>\n            )}\n          </div>\n\n          <DialogFooter>\n            <Button onClick={handleClose}>Close</Button>\n          </DialogFooter>\n        </DialogContent>\n      </Dialog>\n    );\n  }\n\n  return (\n    <Dialog open={open} onOpenChange={onOpenChange}>\n      <DialogContent className=\"max-w-4xl max-h-[90vh] overflow-y-auto\">\n        <DialogHeader>\n          <DialogTitle className=\"flex items-center gap-2\">\n            <Users className=\"h-5 w-5\" />\n            Bulk Invite Users\n          </DialogTitle>\n          <DialogDescription>\n            Invite multiple users to your account at once. You can add users\n            manually or import from CSV.\n          </DialogDescription>\n        </DialogHeader>\n\n        <div className=\"space-y-6\">\n          {/* Errors */}\n          {errors.length > 0 && (\n            <Alert>\n              <AlertCircle className=\"h-4 w-4\" />\n              <AlertDescription>\n                <ul className=\"list-disc list-inside space-y-1\">\n                  {errors.map((error, index) => (\n                    <li key={index}>{error}</li>\n                  ))}\n                </ul>\n              </AlertDescription>\n            </Alert>\n          )}\n\n          {/* Default Settings */}\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"text-lg\">Default Settings</CardTitle>\n              <CardDescription>\n                These settings will apply to all users unless overridden\n                individually.\n              </CardDescription>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              {/* Default Roles */}\n              <div>\n                <Label className=\"text-base font-medium\">Default Roles</Label>\n                <div className=\"flex flex-wrap gap-2 mt-2\">\n                  {availableRoles.map((role) => (\n                    <Badge\n                      key={role}\n                      variant={\n                        defaultRoles.includes(role) ? \"default\" : \"outline\"\n                      }\n                      className=\"cursor-pointer\"\n                      onClick={() => handleRoleToggle(role)}\n                    >\n                      {getRoleDisplayLabel(role)}\n                    </Badge>\n                  ))}\n                </div>\n              </div>\n\n              {/* Default Message */}\n              <div>\n                <Label htmlFor=\"defaultMessage\">\n                  Default Message (Optional)\n                </Label>\n                <Textarea\n                  id=\"defaultMessage\"\n                  value={defaultMessage}\n                  onChange={(e) => setDefaultMessage(e.target.value)}\n                  placeholder=\"Add a personal message to all invitations...\"\n                  rows={3}\n                />\n              </div>\n            </CardContent>\n          </Card>\n\n          {/* CSV Import */}\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"text-lg flex items-center gap-2\">\n                <Upload className=\"h-4 w-4\" />\n                Import from CSV\n              </CardTitle>\n              <CardDescription>\n                Paste CSV data or download our template to get started.\n              </CardDescription>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <div className=\"flex gap-2\">\n                <Button onClick={downloadTemplate} variant=\"outline\" size=\"sm\">\n                  <Download className=\"h-4 w-4 mr-2\" />\n                  Download Template\n                </Button>\n              </div>\n\n              <div>\n                <Label htmlFor=\"csvInput\">\n                  CSV Data (email, firstName, lastName)\n                </Label>\n                <Textarea\n                  id=\"csvInput\"\n                  value={csvInput}\n                  onChange={(e) => setCsvInput(e.target.value)}\n                  placeholder=\"email@example.com,John,Doe&#10;user@company.com,Jane,Smith\"\n                  rows={4}\n                />\n              </div>\n\n              <Button onClick={parseCsvInput} disabled={!csvInput.trim()}>\n                Parse CSV Data\n              </Button>\n            </CardContent>\n          </Card>\n\n          {/* Manual User Entry */}\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"text-lg flex items-center justify-between\">\n                <span>Users to Invite ({users.length})</span>\n                <Button onClick={handleAddUser} size=\"sm\">\n                  <Plus className=\"h-4 w-4 mr-2\" />\n                  Add User\n                </Button>\n              </CardTitle>\n            </CardHeader>\n            <CardContent>\n              {users.length === 0 ? (\n                <p className=\"text-center text-gray-500 py-8\">\n                  No users added yet. Click \"Add User\" or import from CSV to get\n                  started.\n                </p>\n              ) : (\n                <div className=\"space-y-4\">\n                  {users.map((user, index) => (\n                    <div\n                      key={index}\n                      className=\"flex gap-4 items-end p-4 border rounded-lg\"\n                    >\n                      <div className=\"flex-1\">\n                        <Label htmlFor={`email-${index}`}>Email *</Label>\n                        <Input\n                          id={`email-${index}`}\n                          type=\"email\"\n                          value={user.email}\n                          onChange={(e) =>\n                            handleUserChange(index, \"email\", e.target.value)\n                          }\n                          placeholder=\"user@example.com\"\n                        />\n                      </div>\n                      <div className=\"flex-1\">\n                        <Label htmlFor={`firstName-${index}`}>First Name</Label>\n                        <Input\n                          id={`firstName-${index}`}\n                          value={user.firstName || \"\"}\n                          onChange={(e) =>\n                            handleUserChange(index, \"firstName\", e.target.value)\n                          }\n                          placeholder=\"John\"\n                        />\n                      </div>\n                      <div className=\"flex-1\">\n                        <Label htmlFor={`lastName-${index}`}>Last Name</Label>\n                        <Input\n                          id={`lastName-${index}`}\n                          value={user.lastName || \"\"}\n                          onChange={(e) =>\n                            handleUserChange(index, \"lastName\", e.target.value)\n                          }\n                          placeholder=\"Doe\"\n                        />\n                      </div>\n                      <Button\n                        onClick={() => handleRemoveUser(index)}\n                        variant=\"outline\"\n                        size=\"sm\"\n                        className=\"text-red-600 hover:text-red-700\"\n                      >\n                        <X className=\"h-4 w-4\" />\n                      </Button>\n                    </div>\n                  ))}\n                </div>\n              )}\n            </CardContent>\n          </Card>\n        </div>\n\n        <DialogFooter>\n          <Button onClick={handleClose} variant=\"outline\">\n            Cancel\n          </Button>\n          <Button\n            onClick={handleSubmit}\n            disabled={\n              loading || users.length === 0 || defaultRoles.length === 0\n            }\n          >\n            {loading\n              ? \"Sending...\"\n              : `Send ${users.length} Invitation${users.length !== 1 ? \"s\" : \"\"}`}\n          </Button>\n        </DialogFooter>\n      </DialogContent>\n    </Dialog>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\account\\DeleteAccountDialog.tsx","messages":[],"suppressedMessages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":71,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":71,"endColumn":20,"suggestions":[{"fix":{"range":[2139,2187],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\account\\EditRolesModal.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":220,"column":31,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[7314,7441],"text":"\n                      The user&apos;s roles will be updated when you save these\n                      changes.\n                    "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[7314,7441],"text":"\n                      The user&lsquo;s roles will be updated when you save these\n                      changes.\n                    "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[7314,7441],"text":"\n                      The user&#39;s roles will be updated when you save these\n                      changes.\n                    "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[7314,7441],"text":"\n                      The user&rsquo;s roles will be updated when you save these\n                      changes.\n                    "},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { Shield, User, Save } from \"lucide-react\";\nimport { Button } from \"@/components/ui/button\";\nimport { Label } from \"@/components/ui/label\";\nimport {\n  Dialog,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n} from \"@/components/ui/dialog\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\";\nimport {\n  AccountUser,\n  getAvailableRolesForInvite,\n} from \"@/types/account\";\nimport { getRoleDisplayLabel } from \"@/lib/role-utils\";\n\ninterface EditRolesModalProps {\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n  user: AccountUser;\n  onUpdateRoles: (userId: string, roles: string[]) => Promise<void>;\n  currentUserRoles: string[];\n}\n\nexport function EditRolesModal({\n  open,\n  onOpenChange,\n  user,\n  onUpdateRoles,\n  currentUserRoles,\n}: EditRolesModalProps) {\n  const [selectedRoles, setSelectedRoles] = useState<string[]>([]);\n  const [loading, setLoading] = useState(false);\n\n  const availableRoles = getAvailableRolesForInvite(currentUserRoles);\n\n  useEffect(() => {\n    if (user?.rolesAssigned) {\n      setSelectedRoles([...user.rolesAssigned]);\n    }\n  }, [user]);\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (selectedRoles.length === 0) {\n      return;\n    }\n\n    setLoading(true);\n    try {\n      await onUpdateRoles(user.userId, selectedRoles);\n    } catch {\n      // Error handling is done in parent component\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleRoleToggle = (role: string) => {\n    setSelectedRoles((prev) =>\n      prev.includes(role) ? prev.filter((r) => r !== role) : [...prev, role],\n    );\n  };\n\n  const getRoleDescription = (role: string): string => {\n    switch (role) {\n      case \"Admin\":\n        return \"Can manage users, settings, and account configuration\";\n      case \"Recruiter\":\n        return \"Can post jobs, manage candidates, and access recruitment tools\";\n      case \"Employer\":\n        return \"Can post jobs and manage hiring processes\";\n      case \"JobSeeker\":\n        return \"Can create resumes and apply to jobs\";\n      default:\n        return \"Standard user access\";\n    }\n  };\n\n  const hasChanges = () => {\n    const currentRoles = user.rolesAssigned || [];\n    if (currentRoles.length !== selectedRoles.length) return true;\n    return !currentRoles.every((role) => selectedRoles.includes(role));\n  };\n\n  return (\n    <Dialog open={open} onOpenChange={onOpenChange}>\n      <DialogContent className=\"max-w-2xl\">\n        <DialogHeader>\n          <DialogTitle className=\"flex items-center gap-2\">\n            <Shield className=\"h-5 w-5\" />\n            Edit User Roles\n          </DialogTitle>\n          <DialogDescription>\n            Update the roles and permissions for this team member.\n          </DialogDescription>\n        </DialogHeader>\n\n        <form onSubmit={handleSubmit} className=\"space-y-6\">\n          {/* User Information */}\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"text-lg flex items-center gap-2\">\n                <User className=\"h-4 w-4\" />\n                User Information\n              </CardTitle>\n            </CardHeader>\n            <CardContent>\n              <div className=\"flex items-center gap-4\">\n                <Avatar className=\"h-12 w-12\">\n                  <AvatarImage src={user.avatarUrl} />\n                  <AvatarFallback>\n                    {user.firstName?.[0]}\n                    {user.lastName?.[0]}\n                  </AvatarFallback>\n                </Avatar>\n                <div>\n                  <h3 className=\"font-medium text-lg\">\n                    {user.firstName} {user.lastName}\n                  </h3>\n                  <p className=\"text-gray-600\">{user.email}</p>\n                  <div className=\"flex gap-1 mt-2\">\n                    <span className=\"text-sm text-gray-500\">\n                      Current roles:\n                    </span>\n                    {user.rolesAssigned?.map((role) => (\n                      <Badge key={role} variant=\"outline\" className=\"text-xs\">\n                        {getRoleDisplayLabel(role)}\n                      </Badge>\n                    ))}\n                  </div>\n                </div>\n              </div>\n            </CardContent>\n          </Card>\n\n          {/* Role Selection */}\n          <Card>\n            <CardHeader>\n              <CardTitle className=\"text-lg\">Role Assignment</CardTitle>\n              <CardDescription>\n                Select the roles this user will have in your account. You can\n                assign multiple roles.\n              </CardDescription>\n            </CardHeader>\n            <CardContent>\n              <div className=\"space-y-3\">\n                {availableRoles.map((role) => (\n                  <div key={role} className=\"flex items-start space-x-3\">\n                    <input\n                      type=\"checkbox\"\n                      id={`edit-role-${role}`}\n                      checked={selectedRoles.includes(role)}\n                      onChange={() => handleRoleToggle(role)}\n                      className=\"mt-1\"\n                    />\n                    <div className=\"flex-1\">\n                      <Label\n                        htmlFor={`edit-role-${role}`}\n                        className=\"text-sm font-medium cursor-pointer\"\n                      >\n                        {getRoleDisplayLabel(role)}\n                      </Label>\n                      <p className=\"text-xs text-gray-600 mt-1\">\n                        {getRoleDescription(role)}\n                      </p>\n                    </div>\n                  </div>\n                ))}\n              </div>\n\n              {selectedRoles.length > 0 && (\n                <div className=\"mt-4 p-3 bg-blue-50 rounded-lg\">\n                  <p className=\"text-sm font-medium text-blue-900 mb-2\">\n                    New Roles:\n                  </p>\n                  <div className=\"flex flex-wrap gap-1\">\n                    {selectedRoles.map((role) => (\n                      <Badge key={role} variant=\"secondary\">\n                        {getRoleDisplayLabel(role)}\n                      </Badge>\n                    ))}\n                  </div>\n                </div>\n              )}\n\n              {selectedRoles.length === 0 && (\n                <div className=\"mt-4 p-3 bg-red-50 rounded-lg\">\n                  <p className=\"text-sm text-red-600\">\n                    Please select at least one role for this user.\n                  </p>\n                </div>\n              )}\n            </CardContent>\n          </Card>\n\n          {/* Changes Summary */}\n          {hasChanges() && (\n            <Card className=\"border-blue-200 bg-blue-50\">\n              <CardContent className=\"pt-6\">\n                <div className=\"flex items-start gap-2\">\n                  <Shield className=\"h-5 w-5 text-blue-600 mt-0.5\" />\n                  <div>\n                    <p className=\"font-medium text-blue-900\">\n                      Role Changes Detected\n                    </p>\n                    <p className=\"text-sm text-blue-700 mt-1\">\n                      The user's roles will be updated when you save these\n                      changes.\n                    </p>\n                  </div>\n                </div>\n              </CardContent>\n            </Card>\n          )}\n        </form>\n\n        <DialogFooter>\n          <Button\n            type=\"button\"\n            variant=\"outline\"\n            onClick={() => onOpenChange(false)}\n            disabled={loading}\n          >\n            Cancel\n          </Button>\n          <Button\n            type=\"submit\"\n            onClick={handleSubmit}\n            disabled={loading || selectedRoles.length === 0 || !hasChanges()}\n            className=\"flex items-center gap-2\"\n          >\n            {loading ? (\n              <div className=\"animate-spin rounded-full h-4 w-4 border-b-2 border-white\" />\n            ) : (\n              <Save className=\"h-4 w-4\" />\n            )}\n            {loading ? \"Saving...\" : \"Save Changes\"}\n          </Button>\n        </DialogFooter>\n      </DialogContent>\n    </Dialog>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\account\\InvitationAnalytics.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":77,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":77,"endColumn":20,"suggestions":[{"fix":{"range":[1721,1779],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport {\n  BarChart,\n  Bar,\n  XAxis,\n  YAxis,\n  CartesianGrid,\n  Tooltip,\n  ResponsiveContainer,\n  LineChart,\n  Line,\n  PieChart,\n  Pie,\n  Cell,\n} from \"recharts\";\nimport {\n  TrendingUp,\n  Users,\n  AlertTriangle,\n  Download,\n  RefreshCw,\n  Target,\n  Clock,\n  Calendar,\n} from \"lucide-react\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { accountService } from \"@/lib/services/account-service\";\nimport { toast } from \"@/hooks/use-toast\";\n\ninterface InvitationAnalyticsData {\n  companyName: string;\n  totalInvitations: number;\n  acceptedInvitations: number;\n  pendingInvitations: number;\n  expiredInvitations: number;\n  rejectedInvitations: number;\n  acceptanceRate: number;\n  recentInvitations30Days: number;\n  recentAccepted30Days: number;\n  weeklyInvitations: number;\n  roleDistribution: Record<string, number>;\n  monthlyTrends: Array<{\n    month: string;\n    invitationsSent: number;\n    invitationsAccepted: number;\n    acceptanceRate: number;\n  }>;\n}\n\ninterface InvitationAnalyticsProps {\n  onExport?: () => void;\n}\n\nexport function InvitationAnalytics({ onExport }: InvitationAnalyticsProps) {\n  const [data, setData] = useState<InvitationAnalyticsData | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  useEffect(() => {\n    loadAnalytics();\n  }, []);\n\n  const loadAnalytics = async () => {\n    try {\n      setLoading(true);\n      setError(null);\n      const response = await accountService.getInvitationAnalytics();\n      setData(response);\n    } catch (err) {\n      console.error(\"Error loading invitation analytics:\", err);\n      setError(\"Failed to load invitation analytics\");\n      toast({\n        title: \"Error\",\n        description: \"Failed to load invitation analytics\",\n        variant: \"destructive\",\n      });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleExport = () => {\n    if (!data) return;\n\n    // Create CSV content\n    const csvContent = [\n      [\"Metric\", \"Value\"],\n      [\"Total Invitations\", data.totalInvitations],\n      [\"Accepted Invitations\", data.acceptedInvitations],\n      [\"Pending Invitations\", data.pendingInvitations],\n      [\"Expired Invitations\", data.expiredInvitations],\n      [\"Rejected Invitations\", data.rejectedInvitations],\n      [\"Acceptance Rate (%)\", data.acceptanceRate],\n      [\"Recent Invitations (30 days)\", data.recentInvitations30Days],\n      [\"Recent Accepted (30 days)\", data.recentAccepted30Days],\n      [\"Weekly Invitations\", data.weeklyInvitations],\n      ...Object.entries(data.roleDistribution).map(([role, count]) => [\n        `Role: ${role}`,\n        count,\n      ]),\n    ]\n      .map((row) => row.join(\",\"))\n      .join(\"\\n\");\n\n    const blob = new Blob([csvContent], { type: \"text/csv\" });\n    const url = window.URL.createObjectURL(blob);\n    const a = document.createElement(\"a\");\n    a.href = url;\n    a.download = `invitation-analytics-${new Date().toISOString().split(\"T\")[0]}.csv`;\n    a.click();\n    window.URL.revokeObjectURL(url);\n\n    if (onExport) onExport();\n  };\n\n  if (loading) {\n    return (\n      <div className=\"space-y-6\">\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n          {[...Array(4)].map((_, i) => (\n            <Card key={i}>\n              <CardContent className=\"p-6\">\n                <div className=\"animate-pulse\">\n                  <div className=\"h-4 bg-gray-200 rounded w-3/4 mb-2\" />\n                  <div className=\"h-8 bg-gray-200 rounded w-1/2\" />\n                </div>\n              </CardContent>\n            </Card>\n          ))}\n        </div>\n        <Card>\n          <CardContent className=\"p-6\">\n            <div className=\"animate-pulse\">\n              <div className=\"h-64 bg-gray-200 rounded\" />\n            </div>\n          </CardContent>\n        </Card>\n      </div>\n    );\n  }\n\n  if (error || !data) {\n    return (\n      <Card>\n        <CardContent className=\"p-6 text-center\">\n          <AlertTriangle className=\"h-12 w-12 text-red-500 mx-auto mb-4\" />\n          <h3 className=\"text-lg font-semibold mb-2\">\n            Unable to Load Analytics\n          </h3>\n          <p className=\"text-gray-600 mb-4\">{error || \"No data available\"}</p>\n          <Button onClick={loadAnalytics}>\n            <RefreshCw className=\"h-4 w-4 mr-2\" />\n            Try Again\n          </Button>\n        </CardContent>\n      </Card>\n    );\n  }\n\n  const statusData = [\n    { name: \"Accepted\", value: data.acceptedInvitations, color: \"#00C49F\" },\n    { name: \"Pending\", value: data.pendingInvitations, color: \"#FFBB28\" },\n    { name: \"Expired\", value: data.expiredInvitations, color: \"#FF8042\" },\n    { name: \"Rejected\", value: data.rejectedInvitations, color: \"#8884D8\" },\n  ].filter((item) => item.value > 0);\n\n  const roleData = Object.entries(data.roleDistribution).map(\n    ([role, count]) => ({\n      name: role,\n      value: count,\n    }),\n  );\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n        <div>\n          <h2 className=\"text-2xl font-bold\">Invitation Analytics</h2>\n          <p className=\"text-gray-600\">\n            Track your team invitation performance for {data.companyName}\n          </p>\n        </div>\n        <div className=\"flex gap-2\">\n          <Button\n            onClick={loadAnalytics}\n            variant=\"outline\"\n            size=\"sm\"\n            disabled={loading}\n          >\n            <RefreshCw\n              className={`h-4 w-4 mr-2 ${loading ? \"animate-spin\" : \"\"}`}\n            />\n            Refresh\n          </Button>\n          <Button onClick={handleExport} variant=\"outline\" size=\"sm\">\n            <Download className=\"h-4 w-4 mr-2\" />\n            Export\n          </Button>\n        </div>\n      </div>\n\n      {/* Key Metrics */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n        <Card>\n          <CardContent className=\"p-6\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <p className=\"text-sm font-medium text-gray-600\">\n                  Total Invitations\n                </p>\n                <p className=\"text-3xl font-bold\">{data.totalInvitations}</p>\n                <p className=\"text-xs text-gray-500 mt-1\">\n                  {data.recentInvitations30Days} in last 30 days\n                </p>\n              </div>\n              <Users className=\"h-8 w-8 text-blue-600\" />\n            </div>\n          </CardContent>\n        </Card>\n\n        <Card>\n          <CardContent className=\"p-6\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <p className=\"text-sm font-medium text-gray-600\">\n                  Acceptance Rate\n                </p>\n                <p className=\"text-3xl font-bold text-green-600\">\n                  {data.acceptanceRate}%\n                </p>\n                <p className=\"text-xs text-gray-500 mt-1\">\n                  {data.acceptedInvitations} accepted\n                </p>\n              </div>\n              <Target className=\"h-8 w-8 text-green-600\" />\n            </div>\n          </CardContent>\n        </Card>\n\n        <Card>\n          <CardContent className=\"p-6\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <p className=\"text-sm font-medium text-gray-600\">\n                  Pending Invitations\n                </p>\n                <p className=\"text-3xl font-bold text-yellow-600\">\n                  {data.pendingInvitations}\n                </p>\n                <p className=\"text-xs text-gray-500 mt-1\">Awaiting response</p>\n              </div>\n              <Clock className=\"h-8 w-8 text-yellow-600\" />\n            </div>\n          </CardContent>\n        </Card>\n\n        <Card>\n          <CardContent className=\"p-6\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <p className=\"text-sm font-medium text-gray-600\">\n                  Weekly Activity\n                </p>\n                <p className=\"text-3xl font-bold text-purple-600\">\n                  {data.weeklyInvitations}\n                </p>\n                <p className=\"text-xs text-gray-500 mt-1\">\n                  Invitations this week\n                </p>\n              </div>\n              <Calendar className=\"h-8 w-8 text-purple-600\" />\n            </div>\n          </CardContent>\n        </Card>\n      </div>\n\n      {/* Charts Row */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Monthly Trends */}\n        <Card>\n          <CardHeader>\n            <CardTitle className=\"flex items-center gap-2\">\n              <TrendingUp className=\"h-5 w-5\" />\n              Monthly Trends\n            </CardTitle>\n            <CardDescription>\n              Invitation activity over the last 12 months\n            </CardDescription>\n          </CardHeader>\n          <CardContent>\n            <ResponsiveContainer width=\"100%\" height={300}>\n              <LineChart data={data.monthlyTrends}>\n                <CartesianGrid strokeDasharray=\"3 3\" />\n                <XAxis dataKey=\"month\" />\n                <YAxis />\n                <Tooltip />\n                <Line\n                  type=\"monotone\"\n                  dataKey=\"invitationsSent\"\n                  stroke=\"#8884d8\"\n                  name=\"Sent\"\n                  strokeWidth={2}\n                />\n                <Line\n                  type=\"monotone\"\n                  dataKey=\"invitationsAccepted\"\n                  stroke=\"#82ca9d\"\n                  name=\"Accepted\"\n                  strokeWidth={2}\n                />\n              </LineChart>\n            </ResponsiveContainer>\n          </CardContent>\n        </Card>\n\n        {/* Status Distribution */}\n        <Card>\n          <CardHeader>\n            <CardTitle>Invitation Status Distribution</CardTitle>\n            <CardDescription>Current status of all invitations</CardDescription>\n          </CardHeader>\n          <CardContent>\n            <ResponsiveContainer width=\"100%\" height={300}>\n              <PieChart>\n                <Pie\n                  data={statusData}\n                  cx=\"50%\"\n                  cy=\"50%\"\n                  labelLine={false}\n                  label={({ name, percent }) =>\n                    `${name} ${(percent * 100).toFixed(0)}%`\n                  }\n                  outerRadius={80}\n                  fill=\"#8884d8\"\n                  dataKey=\"value\"\n                >\n                  {statusData.map((entry, index) => (\n                    <Cell key={`cell-${index}`} fill={entry.color} />\n                  ))}\n                </Pie>\n                <Tooltip />\n              </PieChart>\n            </ResponsiveContainer>\n          </CardContent>\n        </Card>\n      </div>\n\n      {/* Role Distribution */}\n      {roleData.length > 0 && (\n        <Card>\n          <CardHeader>\n            <CardTitle>Role Distribution</CardTitle>\n            <CardDescription>\n              Distribution of roles among accepted team members\n            </CardDescription>\n          </CardHeader>\n          <CardContent>\n            <ResponsiveContainer width=\"100%\" height={300}>\n              <BarChart data={roleData}>\n                <CartesianGrid strokeDasharray=\"3 3\" />\n                <XAxis dataKey=\"name\" />\n                <YAxis />\n                <Tooltip />\n                <Bar dataKey=\"value\" fill=\"#8884d8\" />\n              </BarChart>\n            </ResponsiveContainer>\n          </CardContent>\n        </Card>\n      )}\n\n      {/* Recent Activity Summary */}\n      <Card>\n        <CardHeader>\n          <CardTitle>Recent Activity Summary</CardTitle>\n          <CardDescription>Key metrics from the last 30 days</CardDescription>\n        </CardHeader>\n        <CardContent>\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n            <div className=\"text-center p-4 bg-blue-50 rounded-lg\">\n              <p className=\"text-2xl font-bold text-blue-600\">\n                {data.recentInvitations30Days}\n              </p>\n              <p className=\"text-sm text-gray-600\">Invitations Sent</p>\n            </div>\n            <div className=\"text-center p-4 bg-green-50 rounded-lg\">\n              <p className=\"text-2xl font-bold text-green-600\">\n                {data.recentAccepted30Days}\n              </p>\n              <p className=\"text-sm text-gray-600\">Invitations Accepted</p>\n            </div>\n            <div className=\"text-center p-4 bg-purple-50 rounded-lg\">\n              <p className=\"text-2xl font-bold text-purple-600\">\n                {data.recentInvitations30Days > 0\n                  ? Math.round(\n                      (data.recentAccepted30Days /\n                        data.recentInvitations30Days) *\n                        100,\n                    )\n                  : 0}\n                %\n              </p>\n              <p className=\"text-sm text-gray-600\">Recent Acceptance Rate</p>\n            </div>\n          </div>\n        </CardContent>\n      </Card>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\account\\InvitationManagement.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\account\\InviteUserModal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\auth\\ForcePasswordChangeModal.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'checkPasswordStrength'. Either include it or remove the dependency array.","line":70,"column":6,"nodeType":"ArrayExpression","endLine":70,"endColumn":28,"suggestions":[{"desc":"Update the dependencies array to be: [checkPasswordStrength, formData.newPassword]","fix":{"range":[2089,2111],"text":"[checkPasswordStrength, formData.newPassword]"}}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":87,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":87,"endColumn":20,"suggestions":[{"fix":{"range":[2546,2604],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport {\n  Dialog,\n  DialogContent,\n  DialogHeader,\n  DialogTitle,\n  DialogDescription,\n} from \"@/components/ui/dialog\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Progress } from \"@/components/ui/progress\";\nimport { Eye, EyeOff, CheckCircle, XCircle, AlertTriangle } from \"lucide-react\";\nimport { useAuth } from \"@/lib/auth\";\n\ninterface PasswordRequirements {\n  requiresPasswordChange: boolean;\n  isTemporaryPassword: boolean;\n  passwordSetDate?: string;\n  passwordExpiryDate?: string;\n  daysUntilExpiry: number;\n  reason?: string;\n  canSkip: boolean;\n}\n\ninterface PasswordStrength {\n  isValid: boolean;\n  score: number;\n  requirements: string[];\n  suggestions: string[];\n  hasMinLength: boolean;\n  hasUppercase: boolean;\n  hasLowercase: boolean;\n  hasNumbers: boolean;\n  hasSpecialChars: boolean;\n  isNotCommon: boolean;\n}\n\ninterface ForcePasswordChangeModalProps {\n  isOpen: boolean;\n  requirements: PasswordRequirements;\n  onPasswordChanged: () => void;\n  onClose?: () => void;\n}\n\nexport const ForcePasswordChangeModal: React.FC<\n  ForcePasswordChangeModalProps\n> = ({ isOpen, requirements, onPasswordChanged, onClose }) => {\n  const { apiCall } = useAuth();\n  const [formData, setFormData] = useState({\n    newPassword: \"\",\n    confirmPassword: \"\",\n  });\n  const [showPassword, setShowPassword] = useState(false);\n  const [showConfirmPassword, setShowConfirmPassword] = useState(false);\n  const [passwordStrength, setPasswordStrength] =\n    useState<PasswordStrength | null>(null);\n  const [isLoading, setIsLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [success, setSuccess] = useState(false);\n\n  // Check password strength as user types\n  useEffect(() => {\n    if (formData.newPassword.length > 0) {\n      checkPasswordStrength(formData.newPassword);\n    } else {\n      setPasswordStrength(null);\n    }\n  }, [formData.newPassword]);\n\n  const checkPasswordStrength = async (password: string) => {\n    try {\n      const response = await apiCall(\n        \"/api/PasswordManagement/validate-strength\",\n        {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify(password),\n        },\n      );\n\n      if (response.success) {\n        setPasswordStrength(response.data);\n      }\n    } catch (error) {\n      console.error(\"Error checking password strength:\", error);\n    }\n  };\n\n  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const { name, value } = e.target;\n    setFormData((prev) => ({\n      ...prev,\n      [name]: value,\n    }));\n    setError(null);\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (formData.newPassword !== formData.confirmPassword) {\n      setError(\"Passwords do not match\");\n      return;\n    }\n\n    if (!passwordStrength?.isValid) {\n      setError(\"Password does not meet security requirements\");\n      return;\n    }\n\n    setIsLoading(true);\n    setError(null);\n\n    try {\n      const response = await apiCall(\"/api/PasswordManagement/force-change\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          newPassword: formData.newPassword,\n          confirmPassword: formData.confirmPassword,\n        }),\n      });\n\n      if (response.success) {\n        setSuccess(true);\n        setTimeout(() => {\n          onPasswordChanged();\n        }, 2000);\n      } else {\n        setError(response.error?.message || \"Failed to change password\");\n      }\n    } catch (error: unknown) {\n      const errorMessage =\n        error instanceof Error\n          ? error.message\n          : \"An error occurred while changing password\";\n      setError(errorMessage);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const getStrengthText = (score: number) => {\n    if (score >= 85) return \"Strong\";\n    if (score >= 60) return \"Good\";\n    if (score >= 40) return \"Fair\";\n    return \"Weak\";\n  };\n\n  if (success) {\n    return (\n      <Dialog open={isOpen} onOpenChange={() => {}}>\n        <DialogContent className=\"sm:max-w-md\">\n          <DialogHeader>\n            <DialogTitle className=\"flex items-center gap-2 text-green-600\">\n              <CheckCircle className=\"h-5 w-5\" />\n              Password Changed Successfully\n            </DialogTitle>\n          </DialogHeader>\n          <div className=\"text-center py-4\">\n            <p className=\"text-sm text-muted-foreground\">\n              Your password has been updated successfully. You will be\n              redirected shortly.\n            </p>\n          </div>\n        </DialogContent>\n      </Dialog>\n    );\n  }\n\n  return (\n    <Dialog\n      open={isOpen}\n      onOpenChange={requirements.canSkip ? onClose : undefined}\n    >\n      <DialogContent className=\"sm:max-w-lg\">\n        <DialogHeader>\n          <DialogTitle className=\"flex items-center gap-2\">\n            <AlertTriangle className=\"h-5 w-5 text-amber-500\" />\n            Password Change Required\n          </DialogTitle>\n          <DialogDescription>\n            {requirements.reason ||\n              \"You must change your password to continue.\"}\n          </DialogDescription>\n        </DialogHeader>\n\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          {error && (\n            <Alert variant=\"destructive\">\n              <XCircle className=\"h-4 w-4\" />\n              <AlertDescription>{error}</AlertDescription>\n            </Alert>\n          )}\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"newPassword\">New Password</Label>\n            <div className=\"relative\">\n              <Input\n                id=\"newPassword\"\n                name=\"newPassword\"\n                type={showPassword ? \"text\" : \"password\"}\n                value={formData.newPassword}\n                onChange={handleInputChange}\n                placeholder=\"Enter your new password\"\n                required\n                disabled={isLoading}\n              />\n              <Button\n                type=\"button\"\n                variant=\"ghost\"\n                size=\"sm\"\n                className=\"absolute right-0 top-0 h-full px-3 py-2 hover:bg-transparent\"\n                onClick={() => setShowPassword(!showPassword)}\n                disabled={isLoading}\n              >\n                {showPassword ? (\n                  <EyeOff className=\"h-4 w-4\" />\n                ) : (\n                  <Eye className=\"h-4 w-4\" />\n                )}\n              </Button>\n            </div>\n          </div>\n\n          {passwordStrength && (\n            <div className=\"space-y-2\">\n              <div className=\"flex items-center justify-between text-sm\">\n                <span>Password Strength:</span>\n                <span\n                  className={`font-medium ${\n                    passwordStrength.score >= 85\n                      ? \"text-green-600\"\n                      : passwordStrength.score >= 60\n                        ? \"text-yellow-600\"\n                        : passwordStrength.score >= 40\n                          ? \"text-orange-600\"\n                          : \"text-red-600\"\n                  }`}\n                >\n                  {getStrengthText(passwordStrength.score)}\n                </span>\n              </div>\n              <Progress value={passwordStrength.score} className=\"h-2\" />\n\n              {passwordStrength.requirements.length > 0 && (\n                <div className=\"text-xs text-red-600 space-y-1\">\n                  {passwordStrength.requirements.map((req, index) => (\n                    <div key={index} className=\"flex items-center gap-1\">\n                      <XCircle className=\"h-3 w-3\" />\n                      {req}\n                    </div>\n                  ))}\n                </div>\n              )}\n\n              {passwordStrength.suggestions.length > 0 && (\n                <div className=\"text-xs text-muted-foreground space-y-1\">\n                  <div className=\"font-medium\">Suggestions:</div>\n                  {passwordStrength.suggestions.map((suggestion, index) => (\n                    <div key={index} className=\"flex items-center gap-1\">\n                      <span>ΓÇó</span>\n                      {suggestion}\n                    </div>\n                  ))}\n                </div>\n              )}\n            </div>\n          )}\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"confirmPassword\">Confirm New Password</Label>\n            <div className=\"relative\">\n              <Input\n                id=\"confirmPassword\"\n                name=\"confirmPassword\"\n                type={showConfirmPassword ? \"text\" : \"password\"}\n                value={formData.confirmPassword}\n                onChange={handleInputChange}\n                placeholder=\"Confirm your new password\"\n                required\n                disabled={isLoading}\n              />\n              <Button\n                type=\"button\"\n                variant=\"ghost\"\n                size=\"sm\"\n                className=\"absolute right-0 top-0 h-full px-3 py-2 hover:bg-transparent\"\n                onClick={() => setShowConfirmPassword(!showConfirmPassword)}\n                disabled={isLoading}\n              >\n                {showConfirmPassword ? (\n                  <EyeOff className=\"h-4 w-4\" />\n                ) : (\n                  <Eye className=\"h-4 w-4\" />\n                )}\n              </Button>\n            </div>\n          </div>\n\n          {formData.confirmPassword &&\n            formData.newPassword !== formData.confirmPassword && (\n              <div className=\"text-xs text-red-600 flex items-center gap-1\">\n                <XCircle className=\"h-3 w-3\" />\n                Passwords do not match\n              </div>\n            )}\n\n          <div className=\"flex gap-2 pt-4\">\n            <Button\n              type=\"submit\"\n              className=\"flex-1\"\n              disabled={\n                isLoading ||\n                !passwordStrength?.isValid ||\n                formData.newPassword !== formData.confirmPassword ||\n                !formData.newPassword ||\n                !formData.confirmPassword\n              }\n            >\n              {isLoading ? \"Changing Password...\" : \"Change Password\"}\n            </Button>\n\n            {requirements.canSkip && onClose && (\n              <Button\n                type=\"button\"\n                variant=\"outline\"\n                onClick={onClose}\n                disabled={isLoading}\n              >\n                Skip for Now\n              </Button>\n            )}\n          </div>\n        </form>\n\n        {requirements.isTemporaryPassword && (\n          <div className=\"mt-4 p-3 bg-amber-50 border border-amber-200 rounded-md\">\n            <div className=\"text-sm text-amber-800\">\n              <strong>Temporary Password:</strong> You are currently using a\n              temporary password. Please set a secure password to continue using\n              your account.\n            </div>\n          </div>\n        )}\n\n        {requirements.daysUntilExpiry > 0 &&\n          requirements.daysUntilExpiry <= 7 && (\n            <div className=\"mt-4 p-3 bg-orange-50 border border-orange-200 rounded-md\">\n              <div className=\"text-sm text-orange-800\">\n                <strong>Password Expiring:</strong> Your password will expire in{\" \"}\n                {requirements.daysUntilExpiry} day(s).\n              </div>\n            </div>\n          )}\n      </DialogContent>\n    </Dialog>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\auth\\PasswordRequirementsProvider.tsx","messages":[{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":73,"column":14,"nodeType":"Identifier","messageId":"namedExport","endLine":73,"endColumn":44}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { createContext, useContext, ReactNode } from \"react\";\nimport { usePasswordRequirements } from \"@/hooks/usePasswordRequirements\";\nimport { ForcePasswordChangeModal } from \"./ForcePasswordChangeModal\";\n\ninterface PasswordRequirements {\n  requiresPasswordChange: boolean;\n  isTemporaryPassword: boolean;\n  passwordSetDate?: string;\n  passwordExpiryDate?: string;\n  daysUntilExpiry: number;\n  reason?: string;\n  canSkip: boolean;\n}\n\ninterface PasswordRequirementsContextType {\n  requirements: PasswordRequirements | null;\n  isLoading: boolean;\n  error: string | null;\n  checkRequirements: () => Promise<void>;\n  showModal: boolean;\n  setShowModal: (show: boolean) => void;\n  handlePasswordChanged: () => void;\n}\n\nconst PasswordRequirementsContext = createContext<\n  PasswordRequirementsContextType | undefined\n>(undefined);\n\ninterface PasswordRequirementsProviderProps {\n  children: ReactNode;\n}\n\nexport const PasswordRequirementsProvider: React.FC<\n  PasswordRequirementsProviderProps\n> = ({ children }) => {\n  const {\n    requirements,\n    isLoading,\n    error,\n    checkRequirements,\n    showModal,\n    setShowModal,\n    handlePasswordChanged,\n  } = usePasswordRequirements();\n\n  const contextValue = {\n    requirements,\n    isLoading,\n    error,\n    checkRequirements,\n    showModal,\n    setShowModal,\n    handlePasswordChanged,\n  };\n\n  return (\n    <PasswordRequirementsContext.Provider value={contextValue}>\n      {children}\n\n      {/* Global password change modal */}\n      {requirements && (\n        <ForcePasswordChangeModal\n          isOpen={showModal}\n          requirements={requirements}\n          onPasswordChanged={handlePasswordChanged}\n          onClose={requirements.canSkip ? () => setShowModal(false) : undefined}\n        />\n      )}\n    </PasswordRequirementsContext.Provider>\n  );\n};\n\nexport const usePasswordRequirementsContext = () => {\n  const context = useContext(PasswordRequirementsContext);\n  if (context === undefined) {\n    throw new Error(\n      \"usePasswordRequirementsContext must be used within a PasswordRequirementsProvider\",\n    );\n  }\n  return context;\n};\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\billing\\BillingAnalytics.tsx","messages":[{"ruleId":"no-console","severity":