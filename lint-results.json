de)}`,\n          {\n            method: \"GET\",\n            headers: {\n              \"Content-Type\": \"application/json\",\n            },\n          },\n        );\n\n        if (response.ok) {\n          const responseText = await response.text();\n          if (\n            response.url.includes(\n              \"info=Your registration has been confirmed\",\n            ) ||\n            responseText.includes(\"confirmed\")\n          ) {\n            setStatus(\"success\");\n            setMessage(\n              \"Your email has been successfully confirmed! You can now sign in to your account.\",\n            );\n          } else {\n            setStatus(\"error\");\n            setMessage(\n              \"Email confirmation failed. The link may have expired or been used already.\",\n            );\n          }\n        } else {\n          setStatus(\"error\");\n          setMessage(\n            \"Email confirmation failed. The link may have expired or been used already.\",\n          );\n        }\n      } catch (err) {\n        setStatus(\"error\");\n        setMessage(\n          \"Network error. Please check your connection and try again.\",\n        );\n      }\n    };\n\n    confirmEmail();\n  }, [userId, code]);\n\n  const handleResendConfirmation = async () => {\n    window.location.href =\n      \"/signup?message=Please sign up again to receive a new confirmation email\";\n  };\n\n  const renderContent = () => {\n    switch (status) {\n      case \"loading\":\n        return (\n          <Card className=\"w-full max-w-md\">\n            <CardHeader className=\"text-center\">\n              <div className=\"mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-blue-100\">\n                <RefreshCw className=\"h-6 w-6 text-blue-600 animate-spin\" />\n              </div>\n              <CardTitle className=\"text-2xl\">Confirming Your Email</CardTitle>\n              <CardDescription>\n                Please wait while we confirm your email address...\n              </CardDescription>\n            </CardHeader>\n          </Card>\n        );\n\n      case \"success\":\n        return (\n          <Card className=\"w-full max-w-md\">\n            <CardHeader className=\"text-center\">\n              <div className=\"mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-green-100\">\n                <CheckCircle className=\"h-6 w-6 text-green-600\" />\n              </div>\n              <CardTitle className=\"text-2xl\">Email Confirmed!</CardTitle>\n              <CardDescription>\n                Your email address has been successfully verified\n              </CardDescription>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <Alert>\n                <CheckCircle className=\"h-4 w-4\" />\n                <AlertDescription>{message}</AlertDescription>\n              </Alert>\n\n              <div className=\"space-y-3\">\n                <Button asChild className=\"w-full\">\n                  <Link to=\"/login\">Sign In to Your Account</Link>\n                </Button>\n\n                <div className=\"text-center\">\n                  <Link\n                    to=\"/\"\n                    className=\"text-sm text-gray-600 hover:text-gray-500\"\n                  >\n                    Return to Home\n                  </Link>\n                </div>\n              </div>\n            </CardContent>\n          </Card>\n        );\n\n      case \"error\":\n        return (\n          <Card className=\"w-full max-w-md\">\n            <CardHeader className=\"text-center\">\n              <div className=\"mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-red-100\">\n                <XCircle className=\"h-6 w-6 text-red-600\" />\n              </div>\n              <CardTitle className=\"text-2xl\">Confirmation Failed</CardTitle>\n              <CardDescription>\n                We couldn't confirm your email address\n              </CardDescription>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <Alert variant=\"destructive\">\n                <XCircle className=\"h-4 w-4\" />\n                <AlertDescription>{message}</AlertDescription>\n              </Alert>\n\n              <div className=\"space-y-3\">\n                <Button\n                  variant=\"outline\"\n                  className=\"w-full\"\n                  onClick={handleResendConfirmation}\n                >\n                  <Mail className=\"h-4 w-4 mr-2\" />\n                  Get New Confirmation Email\n                </Button>\n\n                <div className=\"text-center space-y-2\">\n                  <Link\n                    to=\"/login\"\n                    className=\"text-sm text-blue-600 hover:text-blue-500 inline-flex items-center\"\n                  >\n                    <ArrowLeft className=\"h-4 w-4 mr-1\" />\n                    Back to Sign In\n                  </Link>\n\n                  <p className=\"text-xs text-gray-500\">\n                    Need help? Contact our support team\n                  </p>\n                </div>\n              </div>\n            </CardContent>\n          </Card>\n        );\n\n      case \"invalid\":\n        return (\n          <Card className=\"w-full max-w-md\">\n            <CardHeader className=\"text-center\">\n              <div className=\"mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-yellow-100\">\n                <Mail className=\"h-6 w-6 text-yellow-600\" />\n              </div>\n              <CardTitle className=\"text-2xl\">Invalid Link</CardTitle>\n              <CardDescription>\n                This confirmation link is not valid\n              </CardDescription>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <Alert>\n                <Mail className=\"h-4 w-4\" />\n                <AlertDescription>{message}</AlertDescription>\n              </Alert>\n\n              <div className=\"space-y-3\">\n                <Button\n                  variant=\"outline\"\n                  className=\"w-full\"\n                  onClick={handleResendConfirmation}\n                >\n                  <Mail className=\"h-4 w-4 mr-2\" />\n                  Get New Confirmation Email\n                </Button>\n\n                <div className=\"text-center\">\n                  <Link\n                    to=\"/signup\"\n                    className=\"text-sm text-blue-600 hover:text-blue-500\"\n                  >\n                    Create New Account\n                  </Link>\n                </div>\n              </div>\n            </CardContent>\n          </Card>\n        );\n\n      default:\n        return null;\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16\">\n          <div className=\"flex items-center justify-center min-h-[calc(100vh-200px)] px-4\">\n            {renderContent()}\n          </div>\n        </div>\n\n        <Footer />\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\Contact.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Phone' is defined but never used. Allowed unused vars must match /^_/u.","line":3,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":3,"endColumn":8},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'MapPin' is defined but never used. A