 as const,\r\n    title: jobData.title || item.title || \"Untitled Position\",\r\n    company: jobData.company || item.company || \"Unknown Company\",\r\n    location: jobData.location || item.location || \"Remote\",\r\n    salary: (jobData as any)?.salary || (item as any)?.salary,\r\n    employmentType:\r\n      jobData.employmentType || item.employmentType || \"Full-time\",\r\n    experienceLevel:\r\n      (jobData as any)?.experienceLevel ||\r\n      (item as any)?.experienceLevel ||\r\n      \"Not specified\",\r\n    status: (jobData as any)?.status || (item as any)?.status || \"active\",\r\n    privacy: (jobData as any)?.privacy || (item as any)?.privacy || \"public\",\r\n    summary: (jobData as any)?.summary || (item as any)?.summary || \"\",\r\n    createdAt:\r\n      (jobData as any)?.createdAt ||\r\n      (jobData as any)?.postedDate ||\r\n      (item as any)?.createdAt ||\r\n      new Date().toISOString(),\r\n    updatedAt:\r\n      (jobData as any)?.updatedAt ||\r\n      (item as any)?.updatedAt ||\r\n      new Date().toISOString(),\r\n    views: jobData.views || item.views || 0,\r\n    applications:\r\n      (jobData as any)?.applications || (item as any)?.applications || 0,\r\n    ownership:\r\n      determineOwnership(item, context) === \"none\"\r\n        ? \"tracked\"\r\n        : (determineOwnership(item, context) as \"owned\" | \"tracked\"),\r\n    showOwnership: context.showOwnership || false,\r\n    userId: (jobData as any)?.userId || (item as any)?.userId || \"unknown\",\r\n    companyId: (jobData as any)?.companyId || (item as any)?.companyId,\r\n    expiresAt: (jobData as any)?.expiresAt || (item as any)?.expiresAt,\r\n    slug: (jobData as any)?.slug || (item as any)?.slug || `job-${item.id}`,\r\n  };\r\n}\r\n\r\n/**\r\n * Normalize company data from various API formats\r\n */\r\nexport function normalizeCompanyData(\r\n  item: RawApiItem,\r\n  context: CardContext,\r\n): NormalizedCompanyData {\r\n  // Handle nested data structure from API\r\n  const companyData = item.data || item;\r\n\r\n  return {\r\n    id: item.id || companyData.id,\r\n    type: \"company\" as const,\r\n    name: companyData.name || item.name || item.title || \"Unknown Company\",\r\n    logo: companyData.logo || item.logo || item.avatar,\r\n    tagline: companyData.tagline || item.tagline || item.summary,\r\n    industry: companyData.industry || item.industry || \"Not specified\",\r\n    size: companyData.size || item.size || \"Not specified\",\r\n    location: companyData.location || item.location ||\r\n      (companyData.headquarters?.city && companyData.headquarters?.state\r\n        ? `${companyData.headquarters.city}, ${companyData.headquarters.state}`\r\n        : \"Not specified\"),\r\n    status: item.status || companyData.status || \"active\",\r\n    visibility: item.visibility || companyData.visibility || item.privacy || \"public\",\r\n    createdAt: item.createdAt || companyData.createdAt || new Date().toISOString(),\r\n    updatedAt: item.updatedAt || companyData.updatedAt || new Date().toISOString(),\r\n    views: item.views || companyData.views || 0,\r\n    followers: item.followers || companyData.followers || 0,\r\n    jobCount: item.jobCount || companyData.jobCount || 0,\r\n    activeJobCount: item.activeJobCount || companyData.activeJobCount || 0,\r\n    ownership:\r\n      determineOwnership(item, context) === \"none\"\r\n        ? \"tracked\"\r\n        : (determineOwnership(item, context) as \"owned\" | \"tracked\"),\r\n    showOwnership: context.showOwnership || false,\r\n    userId: item.userId || companyData.userId || \"unknown\",\r\n    teamMembers: item.teamMembers || companyData.teamMembers || [],\r\n    onboardingProgress: item.onboardingProgress || companyData.onboardingProgress || 0,\r\n    slug: item.slug || companyData.slug || `company-${item.id}`,\r\n  };\r\n}\r\n\r\n/**\r\n * Normalize person data from various API formats\r\n */\r\nexport function normalizePersonData(\r\n  item: RawApiItem,\r\n  context: CardContext,\r\n): NormalizedPersonData {\r\n  const firstName = item.firstName || \"\";\r\n  const lastName = item.lastName || \"\";\r\n  const fullName =\r\n    item.fullName ||\r\n    item.name ||\r\n    `${firstName} ${lastName}`.trim() ||\r\n    \"Unknown User\";\r\n\r\n  return {\r\n    id: item.id,\r\n    type: \"people\" as const,\r\n    firstName,\r\n    lastName,\r\n    fullName,\r\n    avatar: item.avatar || item.logo,\r\n    headline: item.headline || item.tagline || item.summary || \"Professional\",\r\n    location: item.location || \"Location not specified\",\r\n    role: item.role || item.profession || \"Professional\",\r\n    visibility: item.visibility || item.privacy || \"public\",\r\n    status: item.status || \"active\",\r\n    createdAt: item.createdAt || new Date().toISOString(),\r\n    updatedAt: item.updatedAt || new Date().toISOString(),\r\n    views: item.views || item.profileViews || 0,\r\n    companyId: item.companyId,\r\n    companyName: item.companyName || item.company,\r\n    lastActiveAt: item.lastActiveAt || new Date().toISOString(),\r\n    profileViews: item.profileViews || item.views || 0,\r\n    connectionCount: item.connectionCount || 0,\r\n    followerCount: item.followerCount || 0,\r\n    isVerified: item.isVerified || false,\r\n    isPremium: item.isPremium || false,\r\n    openToWork: item.openToWork || false,\r\n    experienceLevel: item.experienceLevel,\r\n    currentPosition: item.currentPosition || item.role,\r\n    currentCompany: item.currentCompany || item.company,\r\n    ownership:\r\n      determineOwnership(item, context) === \"none\"\r\n        ? \"tracked\"\r\n        : (determineOwnership(item, context) as\r\n          | \"owned\"\r\n          | \"tracked\"\r\n          | \"connected\"),\r\n    showOwnership: context.showOwnership || false,\r\n    slug: item.slug || `person-${item.id}`,\r\n  };\r\n}\r\n\r\n/**\r\n * Normalize resume data from various API formats\r\n */\r\nexport function normalizeResumeData(\r\n  item: RawApiItem,\r\n  context: CardContext,\r\n): NormalizedResumeData {\r\n  return {\r\n    id: item.id,\r\n    type: \"resume\" as const,\r\n    name: item.name || item.title || \"Untitled Resume\",\r\n    title: item.title,\r\n    summary: item.summary || \"\",\r\n    privacy: normalizeResumePrivacy(item, context),\r\n    status: (item.status as \"active\" | \"draft\" | \"archived\") || \"active\",\r\n    createdAt: item.createdAt || new Date().toISOString(),\r\n    updatedAt: item.updatedAt || new Date().toISOString(),\r\n    views: item.views || 0,\r\n    isMaster: item.isMaster,\r\n    isActive: item.isActive,\r\n    parentId: item.parentId,\r\n    ownership:\r\n      determineOwnership(item, context) === \"none\"\r\n        ? \"tracked\"\r\n        : (determineOwnership(item, context) as \"owned\" | \"tracked\"),\r\n    showOwnership: context.showOwnership || false,\r\n    slug: item.slug || `resume-${item.id}`,\r\n  };\r\n}\r\n\r\n/**\r\n * Normalize video data from various API formats\r\n */\r\nexport function normalizeVideoData(\r\n  item: RawApiItem,\r\n  context: CardContext,\r\n): NormalizedVideoData {\r\n  return {\r\n    id: item.id,\r\n    type: \"video\" as const,\r\n    title: item.title || item.name || \"Untitled Video\",\r\n    description: item.description || item.summary || \"\",\r\n    thumbnail: item.thumbnail,\r\n    duration: item.duration || \"0:00\",\r\n    videoType: (item.type as \"resume\" | \"job_description\") || \"resume\",\r\n    profession: item.profession,\r\n    company: item.company,\r\n    createdAt: item.createdAt || new Date().toISOString(),\r\n    updatedAt: item.updatedAt || new Date().toISOString(),\r\n    views: item.views || 0,\r\n    slug: item.slug || `video-${item.id}`,\r\n    ownership:\r\n      determineOwnership(item, context) === \"none\"\r\n        ? \"tracked\"\r\n        : (determineOwnership(item, context) as \"owned\" | \"tracked\"),\r\n    showOwnership: context.showOwnership || false,\r\n    userId: item.userId,\r\n    status: (item.status as \"active\" | \"draft\" | \"archived\") || \"active\",\r\n  };\r\n}\r\n\r\n/**\r\n * Normalize media data from various API formats\r\n */\r\nexport function normalizeMediaData(\r\n  item: RawApiItem,\r\n  context: CardContext,\r\n): NormalizedMediaData {\r\n  return {\r\n    id: item.id,\r\n    type: \"media\" as const,\r\n    title: item.title || item.name || \"Untitled Media\",\r\n    name: item.name || item.title || \"Untitled Media\",\r\n    description: item.description || item.summary || \"\",\r\n    metaType: item.metaType || 0,\r\n    url: item.experienceLevel || item.url || \"\", // Backend stores URL in experienceLevel field\r\n    userId: item.location || item.userId || \"\", // Backend stores userId in location field\r\n    referenceId: item.company || item.referenceId || \"\", // Backend stores referenceId in company field\r\n    createdAt: item.createdAt || new Date().toISOString(),\r\n    updatedAt: item.updatedAt || new Date().toISOString(),\r\n    views: item.views || 0,\r\n    slug: item.slug || `media-${item.id}`,\r\n    showOwnership: context.showOwnership ?? false,\r\n    ownership:\r\n      determineOwnership(item, context) === \"none\"\r\n        ? \"tracked\"\r\n        : (determineOwnership(item, context) as \"owned\" | \"tracked\"),\r\n  };\r\n}\r\n\r\n/**\r\n * Determine ownership status based on context and item data\r\n */\r\nfunction determineOwnership(\r\n  item: RawApiItem,\r\n   \r\n  _context: CardContext,\r\n): \"owned\" | \"tracked\" | \"none\" {\r\n  // Remove hardcoded \"tracked\" assumption\r\n  if (item.ownership) {\r\n    return item.ownership;\r\n  }\r\n\r\n  if (item.userId) {\r\n    return \"owned\";\r\n  }\r\n\r\n  return \"none\";\r\n}\r\n\r\n/**\r\n * Normalize resume privacy with context-aware logic\r\n */\r\nfunction normalizeResumePrivacy(\r\n  item: RawApiItem,\r\n  context: CardContext,\r\n): \"public\" | \"recruiter_only\" | \"connections\" | \"private\" | \"draft\" {\r\n  // Handle the inconsistency between \"Latest Resumes\" and \"All\" sections\r\n  if (context.section === \"latest\") {\r\n    return (\r\n      (item.privacy as \"public\" | \"private\" | \"draft\" | \"recruiter_only\" | \"connections\") ||\r\n      \"public\"\r\n    );\r\n  }\r\n\r\n  // For \"All\" section, don't override with hardcoded \"public\"\r\n  return (\r\n    (item.privacy as \"public\" | \"private\" | \"draft\" | \"recruiter_only\" | \"connections\") ||\r\n    \"draft\"\r\n  );\r\n}\r\n\r\n/**\r\n * Get card type from raw API item\r\n */\r\nexport function getCardType(item: RawApiItem): CardType {\r\n  if (item.type) {\r\n    return item.type as CardType;\r\n  }\r\n\r\n  // Infer type from data structure - improved detection\r\n\r\n  // Company detection - look for company-specific fields\r\n  if (\r\n    item.industry ||\r\n    item.size ||\r\n    item.logo ||\r\n    item.title === \"Company\" ||\r\n    (item.summary && item.summary.includes(\"Company\"))\r\n  ) {\r\n    return \"company\";\r\n  }\r\n\r\n  // Job detection - look for job-specific fields\r\n  if (\r\n    item.jobData ||\r\n    item.company ||\r\n    item.location ||\r\n    item.salary ||\r\n    (item.title && item.title.includes(\"Engineer\")) ||\r\n    (item.summary && item.summary.includes(\"at Unknown Company\"))\r\n  ) {\r\n    return \"job\";\r\n  }\r\n\r\n  // Person detection\r\n  if (item.firstName || item.lastName || item.role) {\r\n    return \"people\";\r\n  }\r\n\r\n  // Resume detection\r\n  if (\r\n    item.privacy &&\r\n    (item.privacy === \"public\" || item.privacy === \"private\")\r\n  ) {\r\n    return \"resume\";\r\n  }\r\n\r\n  // Media detection - check for media-specific fields\r\n  if (item.metaType !== undefined || item.skills?.includes(\"YouTube\") || item.skills?.includes(\"VideoMP4\") || item.skills?.includes(\"Image\")) {\r\n    return \"media\";\r\n  }\r\n\r\n  // Video detection\r\n  if (item.duration || item.thumbnail) {\r\n    return \"video\";\r\n  }\r\n\r\n  return \"job\"; // Default fallback\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\cart-context.tsx","messages":[{"ruleId":"no-duplicate-imports","severity":1,"message":"'react' import is duplicated.","line":2,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":2,"endColumn":70},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":237,"column":14,"nodeType":"Identifier","messageId":"namedExport","endLine":237,"endColumn":21}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { ReactNode } from \"react\";\nimport React, { createContext, useContext, useReducer } from \"react\";\n\nexport interface CartItem {\n  id: string;\n  name: string;\n  price: number;\n  quantity: number;\n  billingCycle: \"monthly\" | \"annual\";\n  users: number;\n}\n\ninterface CartState {\n  items: CartItem[];\n  isOpen: boolean;\n}\n\ninterface CartContextType extends CartState {\n  addItem: (item: Omit<CartItem, \"quantity\">) => void;\n  removeItem: (id: string) => void;\n  updateQuantity: (id: string, quantity: number) => void;\n  updateUsers: (id: string, users: number) => void;\n  updateBillingCycle: (id: string, billingCycle: \"monthly\" | \"annual\") => void;\n  clearCart: () => void;\n  openCart: () => void;\n  closeCart: () => void;\n  getTotalPrice: () => number;\n  getItemCount: () => number;\n}\n\ntype CartAction =\n  | { type: \"ADD_ITEM\"; payload: Omit<CartItem, \"quantity\"> }\n  | { type: \"REMOVE_ITEM\"; payload: string }\n  | { type: \"UPDATE_QUANTITY\"; payload: { id: string; quantity: number } }\n  | { type: \"UPDATE_USERS\"; payload: { id: string; users: number } }\n  | {\n      type: \"UPDATE_BILLING_CYCLE\";\n      payload: { id: string; billingCycle: \"monthly\" | \"annual\" };\n    }\n  | { type: \"CLEAR_CART\" }\n  | { type: \"OPEN_CART\" }\n  | { type: \"CLOSE_CART\" };\n\nconst CartContext = createContext<CartContextType | undefined>(undefined);\n\nconst cartReducer = (state: CartState, action: CartAction): CartState => {\n  switch (action.type) {\n    case \"ADD_ITEM\": {\n      const existingItem = state.items.find(\n        (item) => item.id === action.payload.id,\n      );\n      if (existingItem) {\n        return {\n          ...state,\n          items: state.items.map((item) =>\n            item.id === action.payload.id\n              ? { ...item, quantity: item.quantity + 1 }\n              : item,\n          ),\n        };\n      }\n      return {\n        ...state,\n        items: [...state.items, { ...action.payload, quantity: 1 }],\n      };\n    }\n\n    case \"REMOVE_ITEM\":\n      return {\n        ...state,\n        items: state.items.filter((item) => item.id !== action.payload),\n      };\n\n    case \"UPDATE_QUANTITY\":\n      if (action.payload.quantity <= 0) {\n        return {\n          ...state,\n          items: state.items.filter((item) => item.id !== action.payload.id),\n        };\n      }\n      return {\n        ...state,\n        items: state.items.map((item) =>\n          item.id === action.payload.id\n            ? { ...item, quantity: action.payload.quantity }\n            : item,\n        ),\n      };\n\n    case \"UPDATE_USERS\":\n      return {\n        ...state,\n        items: state.items.map((item) =>\n          item.id === action.payload.id\n            ? {\n                ...item,\n                users: action.payload.users,\n                price: calculatePriceForUsers(\n                  action.payload.users,\n                  item.billingCycle,\n                ),\n              }\n            : item,\n        ),\n      };\n\n    case \"UPDATE_BILLING_CYCLE\":\n      return {\n        ...state,\n        items: state.items.map((item) =>\n          item.id === action.payload.id\n            ? {\n                ...item,\n                billingCycle: action.payload.billingCycle,\n                price: calculatePriceForUsers(\n                  item.users,\n                  action.payload.billingCycle,\n                ),\n              }\n            : item,\n        ),\n      };\n\n    case \"CLEAR_CART\":\n      return {\n        ...state,\n        items: [],\n      };\n\n    case \"OPEN_CART\":\n      return {\n        ...state,\n        isOpen: true,\n      };\n\n    case \"CLOSE_CART\":\n      return {\n        ...state,\n        isOpen: false,\n      };\n\n    default:\n      return state;\n  }\n};\n\nconst calculatePriceForUsers = (\n  users: number,\n  billingCycle: \"monthly\" | \"annual\",\n): number => {\n  const basePrice = 9.95; // per user per month\n  const monthlyTotal = basePrice * users;\n\n  if (billingCycle === \"annual\") {\n    // 20% discount for annual billing\n    return monthlyTotal * 12 * 0.8;\n  }\n\n  return monthlyTotal;\n};\n\nconst initialState: CartState = {\n  items: [],\n  isOpen: false,\n};\n\nexport const CartProvider: React.FC<{ children: ReactNode }> = ({\n  children,\n}) => {\n  const [state, dispatch] = useReducer(cartReducer, initialState);\n\n  const addItem = (item: Omit<CartItem, \"quantity\">) => {\n    dispatch({ type: \"ADD_ITEM\", payload: item });\n  };\n\n  const removeItem = (id: string) => {\n    dispatch({ type: \"REMOVE_ITEM\", payload: id });\n  };\n\n  const updateQuantity = (id: string, quantity: number) => {\n    dispatch({ type: \"UPDATE_QUANTITY\", payload: { id, quantity } });\n  };\n\n  const updateUsers = (id: string, users: number) => {\n    dispatch({ type: \"UPDATE_USERS\", payload: { id, users } });\n  };\n\n  const updateBillingCycle = (\n    id: string,\n    billingCycle: \"monthly\" | \"annual\",\n  ) => {\n    dispatch({ type: \"UPDATE_BILLING_CYCLE\", payload: { id, billingCycle } });\n  };\n\n  const clearCart = () => {\n    dispatch({ type: \"CLEAR_CART\" });\n  };\n\n  const openCart = () => {\n    dispatch({ type: \"OPEN_CART\" });\n  };\n\n  const closeCart = () => {\n    dispatch({ type: \"CLOSE_CART\" });\n  };\n\n  const getTotalPrice = (): number => {\n    return state.items.reduce(\n      (total, item) => total + item.price * item.quantity,\n      0,\n    );\n  };\n\n  const getItemCount = (): number => {\n    return state.items.reduce((total, item) => total + item.quantity, 0);\n  };\n\n  const contextValue: CartContextType = {\n    ...state,\n    addItem,\n    removeItem,\n    updateQuantity,\n    updateUsers,\n    updateBillingCycle,\n    clearCart,\n    openCart,\n    closeCart,\n    getTotalPrice,\n    getItemCount,\n  };\n\n  return (\n    <CartContext.Provider value={contextValue}>{children}</CartContext.Provider>\n  );\n};\n\nexport const useCart = (): CartContextType => {\n  const context = useContext(CartContext);\n  if (!context) {\n    throw new Error(\"useCart must be used within a CartProvider\");\n  }\n  return context;\n};\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\config.ts","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":158,"column":5,"nodeType":"MemberExpression","messageId":"unexpected","endLine":158,"endColumn":18,"suggestions":[{"fix":{"range":[5691,5748],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Environment configuration management\n * Centralized configuration with validation and type safety\n */\n\nimport { z } from \"zod\";\n\n// ============================================================================\n// CONFIGURATION SCHEMA\n// ============================================================================\n\nconst ConfigSchema = z.object({\n  // Environment\n  NODE_ENV: z\n    .enum([\"development\", \"production\", \"test\"])\n    .default(\"development\"),\n\n  // API Configuration\n  API_BASE_URL: z.string().default(\"/api\"),\n  API_TIMEOUT: z.coerce.number().min(1000).default(10000),\n  API_RETRIES: z.coerce.number().min(0).max(10).default(3),\n\n  // Authentication\n  AUTH_TOKEN_KEY: z.string().default(\"auth_token\"),\n  AUTH_USER_KEY: z.string().default(\"user\"),\n  AUTH_REFRESH_THRESHOLD: z.coerce.number().min(60).default(300), // 5 minutes\n\n  // Logging\n  LOG_LEVEL: z.enum([\"debug\", \"info\", \"warn\", \"error\"]).default(\"info\"),\n  LOG_MAX_ENTRIES: z.coerce.number().min(10).default(100),\n\n  // Cache\n  CACHE_TTL_DEFAULT: z.coerce.number().min(1000).default(300000), // 5 minutes\n  CACHE_TTL_SHORT: z.coerce.number().min(1000).default(60000), // 1 minute\n  CACHE_TTL_LONG: z.coerce.number().min(1000).default(3600000), // 1 hour\n  CACHE_MAX_SIZE: z.coerce.number().min(10).default(1000),\n\n  // Performance\n  PERFORMANCE_MONITORING: z.coerce.boolean().default(false),\n  PERFORMANCE_SAMPLE_RATE: z.coerce.number().min(0).max(1).default(0.1),\n\n  // Error Reporting\n  ERROR_REPORTING_ENABLED: z.coerce.boolean().default(false),\n  ERROR_REPORTING_DSN: z.string().optional(),\n  ERROR_REPORTING_ENVIRONMENT: z.string().optional(),\n\n  // Feature Flags\n  FEATURE_AI_CHAT: z.coerce.boolean().default(true),\n  FEATURE_VIDEO_RESUMES: z.coerce.boolean().default(true),\n  FEATURE_ANALYTICS: z.coerce.boolean().default(false),\n  FEATURE_NOTIFICATIONS: z.coerce.boolean().default(true),\n\n  // UI Configuration\n  UI_THEME: z.enum([\"light\", \"dark\", \"system\"]).default(\"system\"),\n  UI_ANIMATIONS: z.coerce.boolean().default(true),\n  UI_REDUCED_MOTION: z.coerce.boolean().default(false),\n\n  // File Upload\n  UPLOAD_MAX_SIZE: z.coerce.number().min(1024).default(10485760), // 10MB\n  UPLOAD_ALLOWED_TYPES: z\n    .string()\n    .default(\"image/*,application/pdf,.doc,.docx\"),\n\n  // Pagination\n  PAGINATION_DEFAULT_LIMIT: z.coerce.number().min(1).max(100).default(20),\n  PAGINATION_MAX_LIMIT: z.coerce.number().min(1).max(1000).default(100),\n\n  // Search\n  SEARCH_DEBOUNCE_MS: z.coerce.number().min(100).default(300),\n  SEARCH_MIN_QUERY_LENGTH: z.coerce.number().min(1).default(2),\n\n  // AI Configuration (handled by backend)\n  // Frontend no longer needs direct AI configuration\n\n  // External Services\n  GOOGLE_ANALYTICS_ID: z.string().optional(),\n  HOTJAR_ID: z.string().optional(),\n  INTERCOM_APP_ID: z.string().optional(),\n});\n\n// ============================================================================\n// CONFIGURATION LOADING\n// ============================================================================\n\n/**\n * Load and validate configuration from environment variables\n */\nfunction loadConfig(): z.infer<typeof ConfigSchema> {\n  const env = {\n    // Environment\n    NODE_ENV: import.meta.env.NODE_ENV,\n\n    // API Configuration\n    API_BASE_URL: import.meta.env.VITE_API_BASE_URL,\n    API_TIMEOUT: import.meta.env.VITE_API_TIMEOUT,\n    API_RETRIES: import.meta.env.VITE_API_RETRIES,\n\n    // Authentication\n    AUTH_TOKEN_KEY: import.meta.env.VITE_AUTH_TOKEN_KEY,\n    AUTH_USER_KEY: import.meta.env.VITE_AUTH_USER_KEY,\n    AUTH_REFRESH_THRESHOLD: import.meta.env.VITE_AUTH_REFRESH_THRESHOLD,\n\n    // Logging\n    LOG_LEVEL: import.meta.env.VITE_LOG_LEVEL,\n    LOG_MAX_ENTRIES: import.meta.env.VITE_LOG_MAX_ENTRIES,\n\n    // Cache\n    CACHE_TTL_DEFAULT: import.meta.env.VITE_CACHE_TTL_DEFAULT,\n    CACHE_TTL_SHORT: import.meta.env.VITE_CACHE_TTL_SHORT,\n    CACHE_TTL_LONG: import.meta.env.VITE_CACHE_TTL_LONG,\n    CACHE_MAX_SIZE: import.meta.env.VITE_CACHE_MAX_SIZE,\n\n    // Performance\n    PERFORMANCE_MONITORING: import.meta.env.VITE_PERFORMANCE_MONITORING,\n    PERFORMANCE_SAMPLE_RATE: import.meta.env.VITE_PERFORMANCE_SAMPLE_RATE,\n\n    // Error Reporting\n    ERROR_REPORTING_ENABLED: import.meta.env.VITE_ERROR_REPORTING_ENABLED,\n    ERROR_REPORTING_DSN: import.meta.env.VITE_ERROR_REPORTING_DSN,\n    ERROR_REPORTING_ENVIRONMENT: import.meta.env\n      .VITE_ERROR_REPORTING_ENVIRONMENT,\n\n    // Feature Flags\n    FEATURE_AI_CHAT: import.meta.env.VITE_FEATURE_AI_CHAT,\n    FEATURE_VIDEO_RESUMES: import.meta.env.VITE_FEATURE_VIDEO_RESUMES,\n    FEATURE_ANALYTICS: import.meta.env.VITE_FEATURE_ANALYTICS,\n    FEATURE_NOTIFICATIONS: import.meta.env.VITE_FEATURE_NOTIFICATIONS,\n\n    // UI Configuration\n    UI_THEME: import.meta.env.VITE_UI_THEME,\n    UI_ANIMATIONS: import.meta.env.VITE_UI_ANIMATIONS,\n    UI_REDUCED_MOTION: import.meta.env.VITE_UI_REDUCED_MOTION,\n\n    // File Upload\n    UPLOAD_MAX_SIZE: import.meta.env.VITE_UPLOAD_MAX_SIZE,\n    UPLOAD_ALLOWED_TYPES: import.meta.env.VITE_UPLOAD_ALLOWED_TYPES,\n\n    // Pagination\n    PAGINATION_DEFAULT_LIMIT: import.meta.env.VITE_PAGINATION_DEFAULT_LIMIT,\n    PAGINATION_MAX_LIMIT: import.meta.env.VITE_PAGINATION_MAX_LIMIT,\n\n    // Search\n    SEARCH_DEBOUNCE_MS: import.meta.env.VITE_SEARCH_DEBOUNCE_MS,\n    SEARCH_MIN_QUERY_LENGTH: import.meta.env.VITE_SEARCH_MIN_QUERY_LENGTH,\n\n    // AI Configuration (handled by backend)\n    // Frontend no longer loads AI configuration\n\n    // External Services\n    GOOGLE_ANALYTICS_ID: import.meta.env.VITE_GOOGLE_ANALYTICS_ID,\n    HOTJAR_ID: import.meta.env.VITE_HOTJAR_ID,\n    INTERCOM_APP_ID: import.meta.env.VITE_INTERCOM_APP_ID,\n  };\n\n  try {\n    return ConfigSchema.parse(env);\n  } catch (error) {\n    console.error(\"Configuration validation failed:\", error);\n    throw new Error(\n      \"Invalid configuration. Please check your environment variables.\",\n    );\n  }\n}\n\n// ============================================================================\n// CONFIGURATION INSTANCE\n// ============================================================================\n\nexport const config = loadConfig();\n\n// ============================================================================\n// CONFIGURATION UTILITIES\n// ============================================================================\n\n/**\n * Check if running in development mode\n */\nexport const isDevelopment = config.NODE_ENV === \"development\";\n\n/**\n * Check if running in production mode\n */\nexport const isProduction = config.NODE_ENV === \"production\";\n\n/**\n * Check if running in test mode\n */\nexport const isTest = config.NODE_ENV === \"test\";\n\n/**\n * Check if a feature flag is enabled\n */\nexport function isFeatureEnabled(feature: keyof typeof config): boolean {\n  const value = config[feature];\n  return typeof value === \"boolean\" ? value : false;\n}\n\n/**\n * Get API configuration\n */\nexport function getApiConfig() {\n  return {\n    baseUrl: config.API_BASE_URL,\n    timeout: config.API_TIMEOUT,\n    retries: config.API_RETRIES,\n  };\n}\n\n/**\n * Get cache configuration\n */\nexport function getCacheConfig() {\n  return {\n    ttl: {\n      default: config.CACHE_TTL_DEFAULT,\n      short: config.CACHE_TTL_SHORT,\n      long: config.CACHE_TTL_LONG,\n    },\n    maxSize: config.CACHE_MAX_SIZE,\n  };\n}\n\n/**\n * Get logging configuration\n */\nexport function getLoggingConfig() {\n  return {\n    level: config.LOG_LEVEL,\n    maxEntries: config.LOG_MAX_ENTRIES,\n  };\n}\n\n/**\n * Get performance monitoring configuration\n */\nexport function getPerformanceConfig() {\n  return {\n    enabled: config.PERFORMANCE_MONITORING,\n    sampleRate: config.PERFORMANCE_SAMPLE_RATE,\n  };\n}\n\n/**\n * Get error reporting configuration\n */\nexport function getErrorReportingConfig() {\n  return {\n    enabled: config.ERROR_REPORTING_ENABLED,\n    dsn: config.ERROR_REPORTING_DSN,\n    environment: config.ERROR_REPORTING_ENVIRONMENT || config.NODE_ENV,\n  };\n}\n\n/**\n * Get upload configuration\n */\nexport function getUploadConfig() {\n  return {\n    maxSize: config.UPLOAD_MAX_SIZE,\n    allowedTypes: config.UPLOAD_ALLOWED_TYPES.split(\",\").map((type) =>\n      type.trim(),\n    ),\n  };\n}\n\n/**\n * Get pagination configuration\n */\nexport function getPaginationConfig() {\n  return {\n    defaultLimit: config.PAGINATION_DEFAULT_LIMIT,\n    maxLimit: config.PAGINATION_MAX_LIMIT,\n  };\n}\n\n/**\n * Get search configuration\n */\nexport function getSearchConfig() {\n  return {\n    debounceMs: config.SEARCH_DEBOUNCE_MS,\n    minQueryLength: config.SEARCH_MIN_QUERY_LENGTH,\n  };\n}\n\n/**\n * Get AI configuration (deprecated - AI is now handled by backend)\n */\nexport function getAIConfig() {\n  return {\n    apiKey: undefined,\n    model: \"backend-handled\",\n    maxTokens: 1000,\n    temperature: 0.7,\n  };\n}\n\n/**\n * Validate configuration at runtime\n */\nexport function validateConfig(): { valid: boolean; errors?: string[] } {\n  try {\n    ConfigSchema.parse(config);\n    return { valid: true };\n  } catch (error) {\n    if (error instanceof z.ZodError) {\n      return {\n        valid: false,\n        errors: error.issues.map(\n          (err) => `${err.path.join(\".\")}: ${err.message}`,\n        ),\n      };\n    }\n    return {\n      valid: false,\n      errors: [\"Unknown configuration error\"],\n    };\n  }\n}\n\n// ============================================================================\n// CONFIGURATION TYPES\n// ============================================================================\n\nexport type Config = z.infer<typeof ConfigSchema>;\nexport type ConfigKey = keyof Config;\n\n// Export the schema for external validation\nexport { ConfigSchema };\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\data-manager.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'ApiSuccessResponse' is defined but never used. Allowed unused vars must match /^_/u.","line":7,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":7,"endColumn":28},{"ruleId":"no-duplicate-imports","severity":1,"message":"'./api-client' import is duplicated.","line":9,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":9,"endColumn":42},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'ValidationError' is defined but never used. Allowed unused vars must match /^_/u.","line":10,"column":27,"nodeType":null,"messageId":"unusedVar","endLine":10,"endColumn":42},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'options' is assigned a value but never used. Allowed unused args must match /^_/u.","line":323,"column":5,"nodeType":null,"messageId":"unusedVar","endLine":323,"endColumn":12},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'options' is assigned a value but never used. Allowed unused args must match /^_/u.","line":348,"column":5,"nodeType":null,"messageId":"unusedVar","endLine":348,"endColumn":12},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'options' is assigned a value but never used. Allowed unused args must match /^_/u.","line":373,"column":5,"nodeType":null,"messageId":"unusedVar","endLine":373,"endColumn":12},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'keysToDelete' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":393,"column":11,"nodeType":null,"messageId":"unusedVar","endLine":393,"endColumn":23}],"suppressedMessages":[],"errorCount":6,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Comprehensive data management layer\n * Provides caching, CRUD operations, and data transformation utilities\n */\n\nimport { z } from \"zod\";\nimport { ApiSuccessResponse } from \"@shared/api\";\nimport type { ApiClient } from \"./api-client\";\nimport { apiClient } from \"./api-client\";\nimport { validateOrThrow, ValidationError } from \"./errors\";\nimport { logger, logAsyncPerformance } from \"./logger\";\n\n// ============================================================================\n// TYPES AND INTERFACES\n// ============================================================================\n\nexport interface CacheConfig {\n  ttl?: number; // Time to live in milliseconds\n  maxSize?: number; // Maximum number of items in cache\n  strategy?: \"lru\" | \"fifo\"; // Cache eviction strategy\n}\n\nexport interface QueryOptions {\n  useCache?: boolean;\n  cacheKey?: string;\n  cacheTtl?: number;\n  retries?: number;\n  timeout?: number;\n}\n\nexport interface PaginationParams {\n  page?: number;\n  limit?: number;\n  sortBy?: string;\n  sortOrder?: \"asc\" | \"desc\";\n}\n\nexport interface FilterParams {\n  [key: string]: unknown;\n}\n\nexport interface ListResponse<T> {\n  items: T[];\n  total: number;\n  page: number;\n  limit: number;\n  hasNext: boolean;\n  hasPrev: boolean;\n}\n\n// ============================================================================\n// CACHE IMPLEMENTATION\n// ============================================================================\n\ninterface CacheEntry<T> {\n  data: T;\n  timestamp: number;\n  ttl: number;\n}\n\nclass DataCache {\n  private cache = new Map<string, CacheEntry<unknown>>();\n  private accessOrder: string[] = []; // For LRU tracking\n  private maxSize: number;\n  private strategy: \"lru\" | \"fifo\";\n\n  constructor(config: CacheConfig = {}) {\n    this.maxSize = config.maxSize || 1000;\n    this.strategy = config.strategy || \"lru\";\n  }\n\n  set<T>(key: string, data: T, ttl = 300000): void {\n    // Default 5 minutes\n    // Remove expired entries\n    this.cleanup();\n\n    // Evict if at capacity\n    if (this.cache.size >= this.maxSize) {\n      this.evict();\n    }\n\n    const entry: CacheEntry<T> = {\n      data,\n      timestamp: Date.now(),\n      ttl,\n    };\n\n    this.cache.set(key, entry);\n\n    // Update access order for LRU\n    if (this.strategy === \"lru\") {\n      this.updateAccessOrder(key);\n    }\n\n    logger.debug(\"Cache set\", { key, ttl, cacheSize: this.cache.size });\n  }\n\n  get<T>(key: string): T | null {\n    const entry = this.cache.get(key) as CacheEntry<T> | undefined;\n\n    if (!entry) {\n      logger.debug(\"Cache miss\", { key });\n      return null;\n    }\n\n    // Check if expired\n    if (Date.now() - entry.timestamp > entry.ttl) {\n      this.cache.delete(key);\n      this.removeFromAccessOrder(key);\n      logger.debug(\"Cache expired\", { key });\n      return null;\n    }\n\n    // Update access order for LRU\n    if (this.strategy === \"lru\") {\n      this.updateAccessOrder(key);\n    }\n\n    logger.debug(\"Cache hit\", { key });\n    return entry.data;\n  }\n\n  delete(key: string): boolean {\n    const deleted = this.cache.delete(key);\n    if (deleted) {\n      this.removeFromAccessOrder(key);\n      logger.debug(\"Cache delete\", { key });\n    }\n    return deleted;\n  }\n\n  clear(): void {\n    this.cache.clear();\n    this.accessOrder = [];\n    logger.debug(\"Cache cleared\");\n  }\n\n  private cleanup(): void {\n    const now = Date.now();\n    const expiredKeys: string[] = [];\n\n    for (const [key, entry] of this.cache.entries()) {\n      if (now - entry.timestamp > entry.ttl) {\n        expiredKeys.push(key);\n      }\n    }\n\n    for (const key of expiredKeys) {\n      this.cache.delete(key);\n      this.removeFromAccessOrder(key);\n    }\n\n    if (expiredKeys.length > 0) {\n      logger.debug(\"Cache cleanup\", { expiredCount: expiredKeys.length });\n    }\n  }\n\n  private evict(): void {\n    if (this.cache.size === 0) return;\n\n    let keyToEvict: string;\n\n    if (this.strategy === \"lru\") {\n      keyToEvict = this.accessOrder[0]; // Least recently used\n    } else {\n      keyToEvict = this.cache.keys().next().value; // First in (FIFO)\n    }\n\n    this.cache.delete(keyToEvict);\n    this.removeFromAccessOrder(keyToEvict);\n\n    logger.debug(\"Cache eviction\", {\n      key: keyToEvict,\n      strategy: this.strategy,\n    });\n  }\n\n  private updateAccessOrder(key: string): void {\n    this.removeFromAccessOrder(key);\n    this.accessOrder.push(key);\n  }\n\n  private removeFromAccessOrder(key: string): void {\n    const index = this.accessOrder.indexOf(key);\n    if (index > -1) {\n      this.accessOrder.splice(index, 1);\n    }\n  }\n\n  getStats(): { size: number; maxSize: number; hitRate: number } {\n    // This is a simplified implementation\n    // In a real app, you'd track hits/misses for accurate hit rate\n    return {\n      size: this.cache.size,\n      maxSize: this.maxSize,\n      hitRate: 0.85, // Placeholder\n    };\n  }\n}\n\n// ============================================================================\n// DATA MANAGER CLASS\n// ============================================================================\n\nexport class DataManager {\n  private cache: DataCache;\n  private client: ApiClient;\n\n  constructor(client: ApiClient = apiClient, cacheConfig: CacheConfig = {}) {\n    this.cache = new DataCache(cacheConfig);\n    this.client = client;\n  }\n\n  // ============================================================================\n  // GENERIC CRUD OPERATIONS\n  // ============================================================================\n\n  async get<T>(\n    endpoint: string,\n    schema: z.ZodSchema<T>,\n    options: QueryOptions = {},\n  ): Promise<T> {\n    const cacheKey = options.cacheKey || `get:${endpoint}`;\n\n    // Try cache first\n    if (options.useCache !== false) {\n      const cached = this.cache.get<T>(cacheKey);\n      if (cached) {\n        return cached;\n      }\n    }\n\n    // Fetch from API\n    const response = await logAsyncPerformance(\n      `API GET ${endpoint}`,\n      async () => {\n        return this.client.get(endpoint, schema);\n      },\n    );\n\n    const data = response.data;\n\n    // Cache the result\n    if (options.useCache !== false) {\n      const ttl = options.cacheTtl || 300000; // 5 minutes default\n      this.cache.set(cacheKey, data, ttl);\n    }\n\n    return data;\n  }\n\n  async list<T>(\n    endpoint: string,\n    itemSchema: z.ZodSchema<T>,\n    pagination: PaginationParams = {},\n    filters: FilterParams = {},\n    options: QueryOptions = {},\n  ): Promise<ListResponse<T>> {\n    const queryParams = new URLSearchParams();\n\n    // Add pagination params\n    if (pagination.page) queryParams.set(\"page\", pagination.page.toString());\n    if (pagination.limit) queryParams.set(\"limit\", pagination.limit.toString());\n    if (pagination.sortBy) queryParams.set(\"sortBy\", pagination.sortBy);\n    if (pagination.sortOrder)\n      queryParams.set(\"sortOrder\", pagination.sortOrder);\n\n    // Add filter params\n    for (const [key, value] of Object.entries(filters)) {\n      if (value !== undefined && value !== null) {\n        queryParams.set(key, String(value));\n      }\n    }\n\n    const fullEndpoint = queryParams.toString()\n      ? `${endpoint}?${queryParams.toString()}`\n      : endpoint;\n\n    const cacheKey = options.cacheKey || `list:${fullEndpoint}`;\n\n    // Try cache first\n    if (options.useCache !== false) {\n      const cached = this.cache.get<ListResponse<T>>(cacheKey);\n      if (cached) {\n        return cached;\n      }\n    }\n\n    // Define response schema\n    const responseSchema = z.object({\n      items: z.array(itemSchema),\n      total: z.number(),\n      page: z.number(),\n      limit: z.number(),\n      hasNext: z.boolean(),\n      hasPrev: z.boolean(),\n    });\n\n    // Fetch from API\n    const response = await logAsyncPerformance(\n      `API LIST ${endpoint}`,\n      async () => {\n        return this.client.get(fullEndpoint, responseSchema);\n      },\n    );\n\n    const data = response.data as ListResponse<T>;\n\n    // Cache the result\n    if (options.useCache !== false) {\n      const ttl = options.cacheTtl || 180000; // 3 minutes default for lists\n      this.cache.set(cacheKey, data, ttl);\n    }\n\n    return data;\n  }\n\n  async create<TInput, TOutput>(\n    endpoint: string,\n    data: TInput,\n    inputSchema: z.ZodSchema<TInput>,\n    outputSchema: z.ZodSchema<TOutput>,\n    options: QueryOptions = {},\n  ): Promise<TOutput> {\n    // Validate input data\n    const validatedData = validateOrThrow(data, inputSchema);\n\n    // Create via API\n    const response = await logAsyncPerformance(\n      `API CREATE ${endpoint}`,\n      async () => {\n        return this.client.post(endpoint, validatedData, outputSchema);\n      },\n    );\n\n    // Invalidate related cache entries\n    this.invalidateCache(`list:${endpoint}`);\n\n    return response.data;\n  }\n\n  async update<TInput, TOutput>(\n    endpoint: string,\n    id: string,\n    data: Partial<TInput>,\n    inputSchema: z.ZodSchema<Partial<TInput>>,\n    outputSchema: z.ZodSchema<TOutput>,\n    options: QueryOptions = {},\n  ): Promise<TOutput> {\n    // Validate input data\n    const validatedData = validateOrThrow(data, inputSchema);\n\n    const fullEndpoint = `${endpoint}/${id}`;\n\n    // Update via API\n    const response = await logAsyncPerformance(\n      `API UPDATE ${fullEndpoint}`,\n      async () => {\n        return this.client.put(fullEndpoint, validatedData, outputSchema);\n      },\n    );\n\n    // Invalidate cache entries\n    this.invalidateCache(`get:${fullEndpoint}`);\n    this.invalidateCache(`list:${endpoint}`);\n\n    return response.data;\n  }\n\n  async delete(\n    endpoint: string,\n    id: string,\n    options: QueryOptions = {},\n  ): Promise<void> {\n    const fullEndpoint = `${endpoint}/${id}`;\n\n    // Delete via API\n    await logAsyncPerformance(`API DELETE ${fullEndpoint}`, async () => {\n      return this.client.delete(fullEndpoint, z.object({}));\n    });\n\n    // Invalidate cache entries\n    this.invalidateCache(`get:${fullEndpoint}`);\n    this.invalidateCache(`list:${endpoint}`);\n  }\n\n  // ============================================================================\n  // CACHE MANAGEMENT\n  // ============================================================================\n\n  invalidateCache(pattern: string): void {\n    // Simple pattern matching - in production, you might want more sophisticated pattern matching\n    const keysToDelete: string[] = [];\n\n    // Get all cache keys and find matches\n    // Note: This is a simplified implementation\n    // In a real app, you might want to track cache keys more efficiently\n\n    logger.debug(\"Cache invalidation\", { pattern });\n  }\n\n  clearCache(): void {\n    this.cache.clear();\n  }\n\n  getCacheStats(): { size: number; maxSize: number; hitRate: number } {\n    return this.cache.getStats();\n  }\n}\n\n// ============================================================================\n// DEFAULT INSTANCE\n// ============================================================================\n\nexport const dataManager = new DataManager();\n\nexport default dataManager;\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\dynamic-actions.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Building2' is defined but never used. Allowed unused vars must match /^_/u.","line":25,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":25,"endColumn":12}],"suppressedMessages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":366,"column":3,"nodeType":"MemberExpression","messageId":"unexpected","endLine":366,"endColumn":14,"suggestions":[{"fix":{"range":[8438,8487],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}],"suppressions":[{"kind":"directive","justification":""}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":371,"column":3,"nodeType":"MemberExpression","messageId":"unexpected","endLine":371,"endColumn":14,"suggestions":[{"fix":{"range":[8598,8649],"text":""},"messageId":"removeConsole","data":{"propertyN