lect\";\nimport { Separator } from \"@/components/ui/separator\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\nimport { useCart } from \"@/lib/cart-context\";\n\nexport default function Checkout() {\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { user, isAuthenticated } = useAuth();\n  const { items, getTotalPrice, clearCart } = useCart();\n  const navigate = useNavigate();\n\n  const [isProcessing, setIsProcessing] = useState(false);\n  const [paymentMethod, setPaymentMethod] = useState(\"card\");\n  const [billingInfo, setBillingInfo] = useState({\n    firstName: \"\",\n    lastName: \"\",\n    email: \"\",\n    company: \"\",\n    address: \"\",\n    city: \"\",\n    state: \"\",\n    zipCode: \"\",\n    country: \"US\",\n  });\n\n  // Redirect if not authenticated\n  useEffect(() => {\n    if (!isAuthenticated) {\n      navigate(\"/login?redirect=/checkout\");\n    }\n  }, [isAuthenticated, navigate]);\n\n  // Redirect if cart is empty\n  useEffect(() => {\n    if (isAuthenticated && items.length === 0) {\n      navigate(\"/pricing\");\n    }\n  }, [items.length, isAuthenticated, navigate]);\n\n  const handleInputChange = (field: string, value: string) => {\n    setBillingInfo((prev) => ({ ...prev, [field]: value }));\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsProcessing(true);\n\n    // Simulate payment processing\n    try {\n      await new Promise((resolve) => setTimeout(resolve, 3000));\n\n      // Clear cart and show success\n      clearCart();\n      alert(\"Payment successful! Welcome to Premium! ≡ƒÄë\");\n      navigate(\"/dashboard\");\n    } catch (error) {\n      alert(\"Payment failed. Please try again.\");\n    } finally {\n      setIsProcessing(false);\n    }\n  };\n\n  const totalPrice = getTotalPrice();\n  const tax = totalPrice * 0.08; // 8% tax\n  const finalTotal = totalPrice + tax;\n\n  if (!isAuthenticated) {\n    return null; // Will redirect\n  }\n\n  if (items.length === 0) {\n    return null; // Will redirect\n  }\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16 min-h-screen bg-gradient-to-br from-background via-brand-purple/5 to-brand-blue/5\">\n          <div className=\"max-w-6xl mx-auto p-6\">\n            {/* Header */}\n            <div className=\"mb-8\">\n              <Link\n                to=\"/pricing\"\n                className=\"inline-flex items-center gap-2 text-muted-foreground hover:text-foreground mb-4\"\n              >\n                <ArrowLeft className=\"h-4 w-4\" />\n                Back to Pricing\n              </Link>\n              <h1 className=\"text-3xl font-bold\">Checkout</h1>\n              <p className=\"text-muted-foreground\">\n                Complete your premium upgrade\n              </p>\n            </div>\n\n            <div className=\"grid lg:grid-cols-2 gap-8\">\n              {/* Order Summary */}\n              <div className=\"lg:order-2\">\n                <Card className=\"sticky top-24\">\n                  <CardHeader>\n                    <CardTitle className=\"flex items-center gap-2\">\n                      <Shield className=\"h-5 w-5\" />\n                      Order Summary\n                    </CardTitle>\n                  </CardHeader>\n                  <CardContent className=\"space-y-4\">\n                    {items.map((item) => (\n                      <div key={item.id} className=\"space-y-3\">\n                        <div className=\"flex justify-between items-start\">\n                          <div className=\"flex-1\">\n                            <h4 className=\"font-medium\">{item.name}</h4>\n                            <div className=\"flex items-center gap-2 text-sm text-muted-foreground\">\n                              <Users className=\"h-4 w-4\" />\n                              {item.users} user{item.users > 1 ? \"s\" : \"\"}\n                            </div>\n                            <div className=\"flex items-center gap-2 text-sm text-muted-foreground\">\n                              <Calendar className=\"h-4 w-4\" />\n                              {item.billingCycle === \"annual\"\n                                ? \"Annual billing\"\n                                : \"Monthly billing\"}\n                              {item.billingCycle === \"annual\" && (\n                                <Badge variant=\"secondary\" className=\"text-xs\">\n                                  Save 20%\n                                </Badge>\n                              )}\n                            </div>\n                          </div>\n                          <div className=\"text-right\">\n                            <div className=\"font-medium\">\n                              ${item.price.toFixed(2)}\n                              {item.billingCycle === \"annual\"\n                                ? \"/year\"\n                                : \"/month\"}\n                            </div>\n                            {item.quantity > 1 && (\n                              <div className=\"text-sm text-muted-foreground\">\n                                Qty: {item.quantity}\n                              </div>\n                            )}\n                          </div>\n                        </div>\n                      </div>\n                    ))}\n\n                    <Separator />\n\n                    <div className=\"space-y-2\">\n                      <div className=\"flex justify-between\">\n                        <span>Subtotal:</span>\n                        <span>${totalPrice.toFixed(2)}</span>\n                      </div>\n                      <div className=\"flex justify-between\">\n                        <span>Tax (8%):</span>\n                        <span>${tax.toFixed(2)}</span>\n                      </div>\n                      <Separator />\n                      <div className=\"flex justify-between text-lg font-semibold\">\n                        <span>Total:</span>\n                        <span>${finalTotal.toFixed(2)}</span>\n                      </div>\n                    </div>\n\n                    <div className=\"bg-green-50 p-3 rounded-lg\">\n                      <div className=\"flex items-center gap-2 text-green-700 text-sm\">\n                        <CheckCircle2 className=\"h-4 w-4\" />\n                        <span className=\"font-medium\">\n                          30-day money-back guarantee\n                        </span>\n                      </div>\n                      <p className=\"text-green-600 text-xs mt-1\">\n                        Not satisfied? Get a full refund within 30 days.\n                      </p>\n                    </div>\n                  </CardContent>\n                </Card>\n              </div>\n\n              {/* Payment Form */}\n              <div className=\"lg:order-1\">\n                <form onSubmit={handleSubmit} className=\"space-y-6\">\n                  {/* Billing Information */}\n                  <Card>\n                    <CardHeader>\n                      <CardTitle>Billing Information</CardTitle>\n                      <CardDescription>\n                        This information will be used for your invoice\n                      </CardDescription>\n                    </CardHeader>\n                    <CardContent className=\"space-y-4\">\n                      <div className=\"grid grid-cols-2 gap-4\">\n                        <div>\n                          <Label htmlFor=\"firstName\">First Name *</Label>\n                          <Input\n                            id=\"firstName\"\n                            value={billingInfo.firstName}\n                            onChange={(e) =>\n                              handleInputChange(\"firstName\", e.target.value)\n                            }\n                            required\n                          />\n                        </div>\n                        <div>\n                          <Label htmlFor=\"lastName\">Last Name *</Label>\n                          <Input\n                            id=\"lastName\"\n                            value={billingInfo.lastName}\n                            onChange={(e) =>\n                              handleInputChange(\"lastName\", e.target.value)\n                            }\n                            required\n                          />\n                        </div>\n                      </div>\n\n                      <div>\n                        <Label htmlFor=\"email\">Email *</Label>\n                        <Input\n                          id=\"email\"\n                          type=\"email\"\n                          value={billingInfo.email}\n                          onChange={(e) =>\n                            handleInputChange(\"email\", e.target.value)\n                          }\n                          required\n                        />\n                      </div>\n\n                      <div>\n                        <Label htmlFor=\"company\">Company</Label>\n                        <Input\n                          id=\"company\"\n                          value={billingInfo.company}\n                          onChange={(e) =>\n                            handleInputChange(\"company\", e.target.value)\n                          }\n                        />\n                      </div>\n\n                      <div>\n                        <Label htmlFor=\"address\">Address *</Label>\n                        <Input\n                          id=\"address\"\n                          value={billingInfo.address}\n                          onChange={(e) =>\n                            handleInputChange(\"address\", e.target.value)\n                          }\n                          required\n                        />\n                      </div>\n\n                      <div className=\"grid grid-cols-2 gap-4\">\n                        <div>\n                          <Label htmlFor=\"city\">City *</Label>\n                          <Input\n                            id=\"city\"\n                            value={billingInfo.city}\n                            onChange={(e) =>\n                              handleInputChange(\"city\", e.target.value)\n                            }\n                            required\n                          />\n                        </div>\n                        <div>\n                          <Label htmlFor=\"state\">State *</Label>\n                          <Input\n                            id=\"state\"\n                            value={billingInfo.state}\n                            onChange={(e) =>\n                              handleInputChange(\"state\", e.target.value)\n                            }\n                            required\n                          />\n                        </div>\n                      </div>\n\n                      <div className=\"grid grid-cols-2 gap-4\">\n                        <div>\n                          <Label htmlFor=\"zipCode\">ZIP Code *</Label>\n                          <Input\n                            id=\"zipCode\"\n                            value={billingInfo.zipCode}\n                            onChange={(e) =>\n                              handleInputChange(\"zipCode\", e.target.value)\n                            }\n                            required\n                          />\n                        </div>\n                        <div>\n                          <Label htmlFor=\"country\">Country *</Label>\n                          <Select\n                            value={billingInfo.country}\n                            onValueChange={(value) =>\n                              handleInputChange(\"country\", value)\n                            }\n                          >\n                            <SelectTrigger>\n                              <SelectValue />\n                            </SelectTrigger>\n                            <SelectContent>\n                              <SelectItem value=\"US\">United States</SelectItem>\n                              <SelectItem value=\"CA\">Canada</SelectItem>\n                              <SelectItem value=\"GB\">United Kingdom</SelectItem>\n                              <SelectItem value=\"AU\">Australia</SelectItem>\n                            </SelectContent>\n                          </Select>\n                        </div>\n                      </div>\n                    </CardContent>\n                  </Card>\n\n                  {/* Payment Method */}\n                  <Card>\n                    <CardHeader>\n                      <CardTitle>Payment Method</CardTitle>\n                      <CardDescription>\n                        Your payment information is encrypted and secure\n                      </CardDescription>\n                    </CardHeader>\n                    <CardContent className=\"space-y-4\">\n                      <RadioGroup\n                        value={paymentMethod}\n                        onValueChange={setPaymentMethod}\n                      >\n                        <div className=\"flex items-center space-x-2\">\n                          <RadioGroupItem value=\"card\" id=\"card\" />\n                          <Label\n                            htmlFor=\"card\"\n                            className=\"flex items-center gap-2\"\n                          >\n                            <CreditCard className=\"h-4 w-4\" />\n                            Credit/Debit Card\n                          </Label>\n                        </div>\n                      </RadioGroup>\n\n                      {paymentMethod === \"card\" && (\n                        <div className=\"space-y-4 pt-4 border-t\">\n                          <div>\n                            <Label htmlFor=\"cardNumber\">Card Number *</Label>\n                            <Input\n                              id=\"cardNumber\"\n                              placeholder=\"1234 5678 9012 3456\"\n                              required\n                            />\n                          </div>\n                          <div className=\"grid grid-cols-2 gap-4\">\n                            <div>\n                              <Label htmlFor=\"expiryDate\">Expiry Date *</Label>\n                              <Input\n                                id=\"expiryDate\"\n                                placeholder=\"MM/YY\"\n                                required\n                              />\n                            </div>\n                            <div>\n                              <Label htmlFor=\"cvv\">CVV *</Label>\n                              <Input id=\"cvv\" placeholder=\"123\" required />\n                            </div>\n                          </div>\n                        </div>\n                      )}\n\n                      <div className=\"flex items-center gap-2 text-sm text-muted-foreground\">\n                        <Lock className=\"h-4 w-4\" />\n                        <span>\n                          Your payment information is secure and encrypted\n                        </span>\n                      </div>\n                    </CardContent>\n                  </Card>\n\n                  {/* Submit Button */}\n                  <Button\n                    type=\"submit\"\n                    className=\"w-full bg-gradient-to-r from-brand-purple to-brand-blue hover:opacity-90\"\n                    size=\"lg\"\n                    disabled={isProcessing}\n                  >\n                    {isProcessing ? (\n                      <>\n                        <div className=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin mr-2\" />\n                        Processing Payment...\n                      </>\n                    ) : (\n                      <>\n                        <DollarSign className=\"mr-2 h-4 w-4\" />\n                        Complete Purchase - ${finalTotal.toFixed(2)}\n                      </>\n                    )}\n                  </Button>\n\n                  <p className=\"text-xs text-muted-foreground text-center\">\n                    By completing this purchase, you agree to our{\" \"}\n                    <Link to=\"/terms\" className=\"underline\">\n                      Terms of Service\n                    </Link>{\" \"}\n                    and{\" \"}\n                    <Link to=\"/privacy\" className=\"underline\">\n                      Privacy Policy\n                    </Link>\n                  </p>\n                </form>\n              </div>\n            </div>\n          </div>\n        </div>\n        <Footer />\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\Companies.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":90,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":90,"endColumn":20,"suggestions":[{"fix":{"range":[2702,2751],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useCallback has a missing dependenc