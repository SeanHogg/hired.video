 assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20399,20402],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":504,"column":58,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":504,"endColumn":61,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20474,20477],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20474,20477],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":507,"column":42,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":507,"endColumn":45,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20649,20652],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20649,20652],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":508,"column":46,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":508,"endColumn":49,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20711,20714],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20711,20714],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":509,"column":45,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":509,"endColumn":48,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20776,20779],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20776,20779],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":510,"column":51,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":510,"endColumn":54,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20846,20849],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20846,20849],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":511,"column":43,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":511,"endColumn":46,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20914,20917],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20914,20917],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":512,"column":48,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":512,"endColumn":51,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20980,20983],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20980,20983],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":28,"fatalErrorCount":0,"warningCount":8,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  Building2,\n  Video,\n  ArrowRight,\n  Users,\n  TrendingUp,\n  Play,\n  Plus,\n  Search,\n  Eye,\n} from \"lucide-react\";\nimport { useState, useEffect, useCallback } from \"react\";\nimport { Link, useLocation } from \"react-router-dom\";\nimport { useSEO } from \"@/lib/seo\";\nimport CompanyCard from \"@/components/CompanyCard\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Pagination, { usePagination } from \"@/components/Pagination\";\nimport SearchBar, { type SearchFilters } from \"@/components/SearchBar\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport {\n  companyService,\n  type CompanyFilters,\n  type CompanyMetadata as Company,\n} from \"@/lib/services/company-service\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\nimport { createRolePermissions } from \"@/lib/role-utils\";\nimport type { CompanyWithOwnership } from \"@/types/company\";\nimport { isValidCompanyName } from \"@/lib/utils/company-validation\";\n\nexport default function Companies() {\n  const location = useLocation();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n\n  // SEO for companies page\n  useSEO(location.pathname);\n  const { isAuthenticated, user } = useAuth();\n  const [searchFilters, setSearchFilters] = useState<SearchFilters>({});\n  const [companies, setCompanies] = useState<Company[]>([]);\n  const [isLoading, setIsLoading] = useState<boolean>(true);\n  const [error, setError] = useState<string | null>(null);\n  const [totalCompanies, setTotalCompanies] = useState<number>(0);\n\n  // Pagination logic\n  const {\n    currentPage,\n    itemsPerPage,\n    totalPages: _totalPages,\n    startIndex: _startIndex,\n    endIndex: _endIndex,\n    setCurrentPage,\n    handleItemsPerPageChange,\n    handleTotalItemsChange,\n  } = usePagination(totalCompanies, 9);\n\n  // Fetch companies data\n  const fetchCompanies = useCallback(async () => {\n    try {\n      setIsLoading(true);\n      setError(null);\n\n      const filters: CompanyFilters = {\n        search: searchFilters.search || undefined,\n        industry: searchFilters.industry || undefined,\n        size: searchFilters.size || undefined,\n        location: searchFilters.location || undefined,\n        page: currentPage,\n        limit: itemsPerPage,\n      };\n\n      const result = await companyService.getPublicCompanies(filters);\n      setCompanies(result.items);\n      setTotalCompanies(result.total);\n      handleTotalItemsChange(result.total);\n    } catch (err) {\n      console.error(\"Failed to fetch companies:\", err);\n      setError(\"Failed to load companies. Please try again.\");\n    } finally {\n      setIsLoading(false);\n    }\n  }, [searchFilters, currentPage, itemsPerPage]);\n\n  // Fetch companies when filters or page changes\n  useEffect(() => {\n    fetchCompanies();\n  }, [fetchCompanies]);\n\n  // Note: User-specific company management (owned/tracked) will be implemented\n  // when the backend API supports user company associations\n\n  const handleFollowCompany = async (companyId: string) => {\n    if (user) {\n      try {\n        await companyService.followCompany(companyId);\n        // Refresh companies to show updated follow status\n        await fetchCompanies();\n      } catch (error) {\n        console.error(\"Failed to follow company:\", error);\n      }\n    }\n  };\n\n  const handleUnfollowCompany = async (companyId: string) => {\n    if (user) {\n      try {\n        await companyService.unfollowCompany(companyId);\n        // Refresh companies to show updated follow status\n        await fetchCompanies();\n      } catch (error) {\n        console.error(\"Failed to unfollow company:\", error);\n      }\n    }\n  };\n\n  const handleTrackCompany = async (companyId: string) => {\n    if (user) {\n      try {\n        await companyService.followCompany(companyId);\n        await fetchCompanies();\n      } catch (error) {\n        console.error(\"Failed to track company:\", error);\n      }\n    }\n  };\n\n  const handleUntrackCompany = async (companyId: string) => {\n    if (user) {\n      try {\n        await companyService.unfollowCompany(companyId);\n        await fetchCompanies();\n      } catch (error) {\n        console.error(\"Failed to untrack company:\", error);\n      }\n    }\n  };\n\n  const handleSearch = (query: string) => {\n    setSearchFilters((prev) => ({ ...prev, search: query }));\n  };\n\n  const handleFilterChange = (filters: SearchFilters) => {\n    setSearchFilters(filters);\n  };\n\n  const handleClearFilters = () => {\n    setSearchFilters({});\n  };\n\n  // Get user-specific company data (owned and tracked companies)\n  const getCompaniesForUser = () => {\n    // TODO: Replace with actual API calls when backend supports user company associations\n    // For now, return empty arrays as placeholder\n    return {\n      owned: [] as CompanyWithOwnership[],\n      tracked: [] as CompanyWithOwnership[],\n    };\n  };\n\n  // If user is authenticated, show the actual companies page\n  if (isAuthenticated && user) {\n    const companiesData = getCompaniesForUser();\n    const rolePermissions = createRolePermissions(user.role);\n    const isJobSeeker = rolePermissions.isJobSeeker;\n    const isRecruiterOrEmployer = rolePermissions.isRecruiter || rolePermissions.isEmployer;\n\n    return (\n      <div className=\"min-h-screen bg-background\">\n        <Sidebar\n          isOpen={sidebarOpen}\n          onClose={closeSidebar}\n          collapsed={sidebarCollapsed}\n        />\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n          <Navigation\n            onMenuClick={openSidebar}\n            onSidebarToggle={toggleSidebar}\n            sidebarCollapsed={sidebarCollapsed}\n          />\n\n          <div className=\"pt-16 p-6\">\n            <div className=\"max-w-7xl mx-auto\">\n              {/* Header */}\n              <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6\">\n                <div>\n                  <h1 className=\"text-3xl font-bold mb-2\">Companies</h1>\n                  <p className=\"text-muted-foreground\">\n                    {isJobSeeker\n                      ? \"Discover and follow companies you're interested in\"\n                      : \"Manage your company profile and discover other organizations\"}\n                  </p>\n                </div>\n                <div className=\"flex items-center gap-2\">\n                  {isRecruiterOrEmployer && (\n                    <Button asChild>\n                      <Link to=\"/companies/create\">\n                        <Plus className=\"h-4 w-4 mr-2\" />\n                        Add Company\n                      </Link>\n                    </Button>\n                  )}\n                </div>\n              </div>\n\n              {/* Search and Filters */}\n              <div className=\"mb-6\">\n                <SearchBar\n                  context=\"companies\"\n                  value={searchFilters.search}\n                  filters={searchFilters}\n                  onSearch={handleSearch}\n                  onFilterChange={handleFilterChange}\n                  onClearFilters={handleClearFilters}\n                />\n              </div>\n\n              {/* Company Listings */}\n              <div className=\"space-y-6\">\n                {/* Owned Companies (for recruiters/employers) */}\n                {isRecruiterOrEmployer &&\n                  \"owned\" in companiesData &&\n                  companiesData.owned.length > 0 && (\n                    <div>\n                      <h2 className=\"text-xl font-semibold mb-4 flex items-center gap-2\">\n                        <Building2 className=\"h-5 w-5\" />\n                        Your Companies ({companiesData.owned.length})\n                      </h2>\n                      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                        {companiesData.owned.map((company) => (\n                          <CompanyCard\n                            key={company.id}\n                            company={company}\n                            showOwnership\n                            onTrack={handleTrackCompany}\n                            onUntrack={handleUntrackCompany}\n                          />\n                        ))}\n                      </div>\n                    </div>\n                  )}\n\n                {/* Tracked Companies (for all users) */}\n                {(\"tracked\" in companiesData\n                  ? companiesData.tracked.length > 0\n                  : false) && (\n                    <div>\n                      <h2 className=\"text-xl font-semibold mb-4 flex items-center gap-2\">\n                        <Eye className=\"h-5 w-5\" />\n                        Following ({(companiesData as any).tracked.length})\n                      </h2>\n                      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                        {(companiesData as any).tracked.map(\n                          (company: CompanyWithOwnership) => (\n                            <CompanyCard\n                              key={company.id}\n                              company={company}\n                              showOwnership\n                              onTrack={handleTrackCompany}\n                              onUntrack={handleUntrackCompany}\n                            />\n                          ),\n                        )}\n                      </div>\n                    </div>\n                  )}\n\n                {/* All Available Companies (for job seekers) or Discover Companies (for others) */}\n                {(isJobSeeker ||\n                  (!isJobSeeker &&\n                    (\"owned\" in companiesData\n                      ? companiesData.owned.length === 0\n                      : true))) && (\n                    <div>\n                      <h2 className=\"text-xl font-semibold mb-4 flex items-center gap-2\">\n                        <Search className=\"h-5 w-5\" />\n                        {isJobSeeker ? \"Discover Companies\" : \"Explore Companies\"}\n                      </h2>\n                      {isLoading ? (\n                        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                          {Array.from({ length: 6 }).map((_, index) => (\n                            <div key={index} className=\"animate-pulse\">\n                              <div className=\"bg-gray-200 rounded-lg h-48\" />\n                            </div>\n                          ))}\n                        </div>\n                      ) : error ? (\n                        <div className=\"text-center py-12\">\n                          <p className=\"text-red-600 mb-4\">{error}</p>\n                          <Button onClick={fetchCompanies}>Try Again</Button>\n                        </div>\n                      ) : companies.length === 0 ? (\n                        <div className=\"text-center py-12\">\n                          <p className=\"text-gray-600 mb-4\">\n                            No companies found matching your criteria.\n                          </p>\n                          <Button onClick={() => setSearchFilters({})}>\n                            Clear Filters\n                          </Button>\n                        </div>\n                      ) : (\n                        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                          {companies\n                            .filter((company) => isValidCompanyName(company.name))\n                            .map((company) => {\n                              const companyMetadata = {\n                                id: company.id || \"\",\n                                slug: (company as any).slug || \"\",\n                                name: company.name || \"\",\n                                logo: company.logo || \"\",\n                                description: (company as any).description || \"\",\n                                tagline: company.tagline || \"\",\n                                industry: company.industry || \"\",\n                                size: company.size || \"\",\n                                location: company.location || \"\",\n                                website: (company as any).website || \"\",\n                                founded: (company as any).founded || \"\",\n                                followersCount:\n                                  (company as any).followersCount || 0,\n                                jobsCount: (company as any).jobCount || 0,\n                                isPublic: (company as any).isPublic || true,\n                                status: (company.status as any) || \"active\",\n                                visibility: (company.visibility as any) || \"public\",\n                                createdAt: company.createdAt || \"\",\n                                updatedAt: company.updatedAt || \"\",\n                                teamMembers: (company as any).teamMembers || [],\n                                onboardingProgress: company.onboardingProgress || 0,\n                                views: (company as any).views || 0,\n                                followers: (company as any).followers || 0,\n                                jobCount: (company as any).jobCount || 0,\n                                activeJobCount:\n                                  (company as any).activeJobCount || 0,\n                                userId: (company as any).userId || \"\",\n                                ownership: \"tracked\" as const,\n                              };\n\n                              return (\n                                <CompanyCard\n                                  key={company.id}\n                                  company={companyMetadata}\n                                  onTrack={handleFollowCompany}\n                                  onUntrack={handleUnfollowCompany}\n                                />\n                              );\n                            })}\n                        </div>\n                      )}\n\n                      {/* Pagination */}\n                      {!isLoading && !error && companies.length > 0 && (\n                        <Pagination\n                          currentPage={currentPage}\n                          totalItems={totalCompanies}\n                          itemsPerPage={itemsPerPage}\n                          onPageChange={setCurrentPage}\n                          onItemsPerPageChange={handleItemsPerPageChange}\n                        />\n                      )}\n                    </div>\n                  )}\n\n                {/* Empty State for Job Seekers with no tracked companies */}\n                {isJobSeeker &&\n                  \"tracked\" in companiesData &&\n                  companiesData.tracked.length === 0 && (\n                    <div className=\"text-center py-12\">\n                      <Building2 className=\"h-16 w-16 mx-auto text-muted-foreground mb-4\" />\n                      <h3 className=\"text-xl font-semibold mb-2\">\n                        Start Following Companies\n                      </h3>\n                      <p className=\"text-muted-foreground mb-6 max-w-md mx-auto\">\n                        Discover companies you're interested in and track their\n                        job openings. Following companies helps you stay updated\n                        on new opportunities.\n                      </p>\n                      <div className=\"space-y-4\">\n                        <p className=\"text-sm text-muted-foreground\">\n                          ≡ƒÆí <strong>Tip:</strong> When you track a job, we\n                          automatically follow the company for you!\n                        </p>\n                      </div>\n                    </div>\n                  )}\n              </div>\n            </div>\n          </div>\n          <Footer />\n        </div>\n      </div>\n    );\n  }\n\n  // If user is not authenticated, show marketing page\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-background via-brand-purple/5 to-brand-blue/5\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16\">\n          <div className=\"max-w-6xl mx-auto px-4 py-16\">\n            {/* Hero Section */}\n            <div className=\"text-center mb-16\">\n              <div className=\"inline-flex items-center space-x-2 mb-6\">\n                <div className=\"relative\">\n                  <Building2 className=\"h-12 w-12 text-primary\" />\n                  <Video className=\"h-6 w-6 text-brand-blue absolute -top-1 -right-1\" />\n                </div>\n                <span className=\"text-4xl font-bold bg-gradient-to-r from-brand-purple to-brand-blue bg-clip-text text-transparent\">\n                  Smart Companies\n                </span>\n              </div>\n              <h1 className=\"text-5xl font-bold mb-6\">\n                Discover Your Next Opportunity\n              </h1>\n              <p className=\"text-xl text-muted-foreground mb-8 max-w-3xl mx-auto\">\n                Explore company cultures, values, and job opportunities. Follow\n                companies you're interested in and get notified about new\n                openings.\n              </p>\n              <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n                <Link to=\"/signup\">\n                  <Button\n                    size=\"lg\"\n                    className=\"bg-gradient-to-r from-brand-purple to-brand-blue hover:opacity-90 text-lg px-8\"\n                  >\n                    Explore Companies\n                    <ArrowRight className=\"ml-2 h-5 w-5\" />\n                  </Button>\n                </Link>\n                <Button size=\"lg\" variant=\"outline\" className=\"text-lg px-8\">\n                  <Play className=\"mr-2 h-5 w-5\" />\n                  See How It Works\n                </Button>\n              </div>\n            </div>\n\n            {/* Stats Section */}\n            <div className=\"grid md:grid-cols-4 gap-6 mb-16\">\n              <div className=\"text-center\">\n                <div className=\"text-3xl font-bold text-primary mb-2\">1K+</div>\n                <p className=\"text-sm text-muted-foreground\">\n                  Active companies\n                </p>\n              </div>\n              <div className=\"text-center\">\n                <div className=\"text-3xl font-bold text-primary mb-2\">15K+</div>\n                <p className=\"text-sm text-muted-foreground\">Open positions</p>\n              </div>\n              <div className=\"text-center\">\n                <div className=\"text-3xl font-bold text-primary mb-2\">98%</div>\n                <p className=\"text-sm text-muted-foreground\">\n                  Profile accuracy\n                </p>\n              </div>\n              <div className=\"text-center\">\n                <div className=\"text-3xl font-bold text-primary mb-2\">24h</div>\n                <p className=\"text-sm text-muted-foreground\">\n                  Average response time\n                </p>\n              </div>\n            </div>\n\n            {/* Featured Companies using CompanyCard */}\n            <div className=\"mb-16\">\n              <h2 className=\"text-3xl font-bold text-center mb-12\">\n                Featured Companies\n              </h2>\n              <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                {companies\n                  .filter((company) => isValidCompanyName((company as any).name))\n                  .slice(0, 3)\n                  .map((company) => {\n                    const companyMetadata = {\n                      id: company.id || \"\",\n                      slug: company.slug || \"\",\n                      name: (company as any).name || \"\",\n                      logo: (company as any).logo || \"\",\n                      tagline: company.tagline || \"\",\n                      industry: company.industry || \"\",\n                      size: company.size || \"\",\n                      location: company.location || \"\",\n                      status: (company.status as any) || \"active\",\n                      visibility: (company.visibility as any) || \"public\",\n                      createdAt: company.createdAt || \"\",\n                      updatedAt: company.updatedAt || \"\",\n                      views: (company as any).views || 0,\n                      followers: (company as any).followers || 0,\n                      jobCount: (company as any).jobCount || 0,\n                      activeJobCount: (company as any).activeJobCount || 0,\n                      userId: (company as any).userId || \"\",\n                      teamMembers: (company as any).teamMembers || [],\n                      onboardingProgress: company.onboardingProgress || 100,\n                      ownership: \"tracked\" as const,\n                    };\n\n                    return (\n                      <CompanyCard key={company.id} company={companyMetadata} />\n                    );\n                  })}\n              </div>\n              <div className=\"text-center mt-8\">\n                <Link to=\"/signup\">\n                  <Button variant=\"outline\" size=\"lg\">\n                    View All Companies\n                    <ArrowRight className=\"ml-2 h-4 w-4\" />\n                  </Button>\n                </Link>\n              </div>\n            </div>\n\n            {/* Features */}\n            <div className=\"mb-16\">\n              <h2 className=\"text-3xl font-bold text-center mb-12\">\n                Why Companies Choose Us\n              </h2>\n              <div className=\"grid md:grid-cols-3 gap-8\">\n                <Card className=\"border-brand-purple/20 hover:border-brand-purple/40 transition-colors\">\n                  <CardHeader>\n                    <Building2 className=\"h-10 w-10 text-brand-purple mb-4\" />\n                    <CardTitle>Company Profiles</CardTitle>\n                    <CardDescription>\n                      Showcase your company culture, values, and opportunities\n                      with rich profiles and video content.\n                    </CardDescription>\n                  </CardHeader>\n                </Card>\n\n                <Card className=\"border-brand-blue/20 hover:border-brand-blue/40 transition-colors\">\n                  <CardHeader>\n                    <Users className=\"h-10 w-10 text-brand-blue mb-4\" />\n                    <CardTitle>Talent Pipeline</CardTitle>\n                    <CardDescription>\n                      Build a following of interested candidates who want to\n                      hear about your opportunities.\n                    </CardDescription>\n                  </CardHeader>\n                </Card>\n\n                <Card className=\"border-primary/20 hover:border-primary/40 transition-colors\">\n                  <CardHeader>\n                    <TrendingUp className=\"h-10 w-10 text-primary mb-4\" />\n                    <CardTitle>Growth Analytics</CardTitle>\n                    <CardDescription>\n                      Track follower growth, job performance, and hiring success\n                      with detailed analytics.\n                    </CardDescription>\n                  </CardHeader>\n                </Card>\n              </div>\n            </div>\n\n            {/* Final CTA */}\n            <div className=\"text-center bg-gradient-to-r from-brand-purple/10 to-brand-blue/10 p-8 rounded-2xl\">\n              <h3 className=\"text-2xl font-bold mb-4\">\n                Ready to Discover Great Companies?\n              </h3>\n              <p className=\"text-muted-foreground mb-6\">\n                Join thousands of professionals exploring company cultures and\n                career opportunities.\n              </p>\n              <Link to=\"/signup\">\n                <Button\n                  size=\"lg\"\n                  className=\"bg-gradient-to-r from-brand-purple to-brand-blue hover:opacity-90\"\n                >\n                  Start Exploring Today\n                  <ArrowRight className=\"ml-2 h-5 w-5\" />\n                </Button>\n             