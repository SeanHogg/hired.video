":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1669,1672],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":66,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":66,"endColumn":20,"suggestions":[{"fix":{"range":[1888,1934],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":136,"column":28,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[4380,4595],"text":"\n                    You don&apos;t have permission to edit this job. Only the job\n                    creator, account owners, and recruiters within the same\n                    company can edit jobs.\n                  "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[4380,4595],"text":"\n                    You don&lsquo;t have permission to edit this job. Only the job\n                    creator, account owners, and recruiters within the same\n                    company can edit jobs.\n                  "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[4380,4595],"text":"\n                    You don&#39;t have permission to edit this job. Only the job\n                    creator, account owners, and recruiters within the same\n                    company can edit jobs.\n                  "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[4380,4595],"text":"\n                    You don&rsquo;t have permission to edit this job. Only the job\n                    creator, account owners, and recruiters within the same\n                    company can edit jobs.\n                  "},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":156,"column":32,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[5344,5493],"text":"\n                    The job you&apos;re trying to edit could not be found or you\n                    don't have permission to edit it.\n                  "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[5344,5493],"text":"\n                    The job you&lsquo;re trying to edit could not be found or you\n                    don't have permission to edit it.\n                  "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[5344,5493],"text":"\n                    The job you&#39;re trying to edit could not be found or you\n                    don't have permission to edit it.\n                  "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[5344,5493],"text":"\n                    The job you&rsquo;re trying to edit could not be found or you\n                    don't have permission to edit it.\n                  "},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":157,"column":24,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[5344,5493],"text":"\n                    The job you're trying to edit could not be found or you\n                    don&apos;t have permission to edit it.\n                  "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[5344,5493],"text":"\n                    The job you're trying to edit could not be found or you\n                    don&lsquo;t have permission to edit it.\n                  "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[5344,5493],"text":"\n                    The job you're trying to edit could not be found or you\n                    don&#39;t have permission to edit it.\n                  "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[5344,5493],"text":"\n                    The job you're trying to edit could not be found or you\n                    don&rsquo;t have permission to edit it.\n                  "},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":7,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Edit, ArrowLeft, Briefcase } from \"lucide-react\";\nimport { useParams, Link, useNavigate } from \"react-router-dom\";\nimport { useState, useEffect } from \"react\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport JobEditForm from \"@/components/JobEditForm\";\nimport { jobService } from \"@/lib/services/job-service\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\nimport { useJobPermissions } from \"@/hooks/use-job-permissions\";\nimport { toast } from \"sonner\";\n\nexport default function JobEditPage() {\n  const { id } = useParams<{ id: string }>();\n  const navigate = useNavigate();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { user } = useAuth();\n  const [job, setJob] = useState<any>(null);\n  const [loading, setLoading] = useState(false);\n  const [saving, setSaving] = useState(false);\n  const permissions = useJobPermissions(job);\n\n  useEffect(() => {\n    const loadJob = async () => {\n      if (!id) return;\n\n      setLoading(true);\n      try {\n        const jobData = await jobService.getJobById(id);\n        setJob(jobData);\n      } catch (error) {\n        console.error(\"Failed to load job:\", error);\n        toast.error(\"Failed to load job details\");\n      } finally {\n        setLoading(false);\n      }\n    };\n\n    loadJob();\n  }, [id]);\n\n  const handleSave = async (jobData: any) => {\n    if (!id) return;\n\n    setSaving(true);\n    try {\n      await jobService.updateJob(id, jobData);\n      toast.success(\"Job updated successfully!\");\n      navigate(`/jobs/${id}`);\n    } catch (error) {\n      console.error(\"Failed to update job:\", error);\n      toast.error(\"Failed to update job. Please try again.\");\n      throw error; // Re-throw to let the form handle it\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const handleCancel = () => {\n    navigate(job ? `/jobs/${job.id}` : \"/jobs\");\n  };\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16 p-6\">\n          <div className=\"max-w-4xl mx-auto\">\n            {/* Back Button */}\n            <div className=\"mb-6\">\n              <Button asChild variant=\"outline\">\n                <Link to={job ? `/jobs/${job.id}` : \"/jobs\"}>\n                  <ArrowLeft className=\"h-4 w-4 mr-2\" />\n                  {job ? \"Back to Job\" : \"Back to Jobs\"}\n                </Link>\n              </Button>\n            </div>\n\n            {/* Header */}\n            <div className=\"mb-8\">\n              <h1 className=\"text-3xl font-bold mb-2\">\n                {job ? `Edit: ${job.title}` : \"Edit Job Posting\"}\n              </h1>\n              <p className=\"text-muted-foreground\">\n                Update your job posting details, requirements, and benefits\n              </p>\n            </div>\n\n            {loading ? (\n              <Card>\n                <CardContent className=\"p-8 text-center\">\n                  <div className=\"animate-spin rounded-full h-8 w-8 border-b-2 border-primary mx-auto mb-4\" />\n                  <p className=\"text-muted-foreground\">\n                    Loading job details...\n                  </p>\n                </CardContent>\n              </Card>\n            ) : job && permissions.canEdit ? (\n              <JobEditForm\n                job={job}\n                onSave={handleSave}\n                onCancel={handleCancel}\n                loading={saving}\n              />\n            ) : job && !permissions.canEdit ? (\n              <Card>\n                <CardContent className=\"p-8 text-center\">\n                  <Briefcase className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                  <h3 className=\"text-lg font-semibold mb-2\">Access Denied</h3>\n                  <p className=\"text-muted-foreground mb-6\">\n                    You don't have permission to edit this job. Only the job\n                    creator, account owners, and recruiters within the same\n                    company can edit jobs.\n                  </p>\n                  <div className=\"flex gap-4 justify-center\">\n                    <Button asChild variant=\"outline\">\n                      <Link to={`/jobs/${job.id}`}>View Job</Link>\n                    </Button>\n                    <Button asChild>\n                      <Link to=\"/jobs\">Back to Jobs</Link>\n                    </Button>\n                  </div>\n                </CardContent>\n              </Card>\n            ) : (\n              <Card>\n                <CardContent className=\"p-8 text-center\">\n                  <Briefcase className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                  <h3 className=\"text-lg font-semibold mb-2\">Job Not Found</h3>\n                  <p className=\"text-muted-foreground mb-6\">\n                    The job you're trying to edit could not be found or you\n                    don't have permission to edit it.\n                  </p>\n                  <Button asChild>\n                    <Link to=\"/jobs\">Back to Jobs</Link>\n                  </Button>\n                </CardContent>\n              </Card>\n            )}\n          </div>\n        </div>\n        <Footer />\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\Jobs.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Sparkles' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":4,"endColumn":11},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Star' is defined but never used. Allowed unused vars must match /^_/u.","line":6,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":6,"endColumn":7},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'MapPin' is defined but never used. Allowed unused vars must match /^_/u.","line":8,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":8,"endColumn":9},{"ruleId":"@typescript