will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[13826,13829],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":527,"column":35,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":527,"endColumn":38,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[19145,19148],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[19145,19148],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":530,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":530,"endColumn":43,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[19281,19284],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[19281,19284],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":532,"column":42,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":532,"endColumn":45,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[19388,19391],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[19388,19391],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":538,"column":46,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":538,"endColumn":49,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[19739,19742],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[19739,19742],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":543,"column":36,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":543,"endColumn":39,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20009,20012],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20009,20012],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":544,"column":43,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":544,"endColumn":46,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20068,20071],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20068,20071],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":545,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":545,"endColumn":43,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20131,20134],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20131,20134],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":546,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":546,"endColumn":43,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20192,20195],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20192,20195],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":547,"column":38,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":547,"endColumn":41,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20251,20254],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20251,20254],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":548,"column":37,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":548,"endColumn":40,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20307,20310],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20307,20310],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":58,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  Briefcase,\n  Video,\n  Sparkles,\n  ArrowRight,\n  Star,\n  Search,\n  MapPin,\n  Clock,\n  DollarSign,\n  CheckCircle2,\n  Play,\n  TrendingUp,\n  Users,\n  Building2,\n  Target,\n  Zap,\n  BarChart3,\n  Plus,\n  Filter,\n  X,\n} from \"lucide-react\";\nimport { useState, useEffect } from \"react\";\nimport { Link, useLocation } from \"react-router-dom\";\nimport { useSEO } from \"@/lib/seo\";\nimport Footer from \"@/components/Footer\";\nimport JobCard from \"@/components/JobCard\";\nimport Navigation from \"@/components/Navigation\";\nimport Pagination, { usePagination } from \"@/components/Pagination\";\nimport type { SearchFilters } from \"@/components/SearchBar\";\nimport SearchBar from \"@/components/SearchBar\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport {\n  jobService,\n  type JobFilters,\n  type JobSummary,\n} from \"@/lib/services/job-service\";\nimport { companyService } from \"@/lib/services/company-service\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth, USER_ROLES } from \"@/lib/auth\";\nimport type { JobWithOwnership } from \"@/types/job\";\n\nexport default function Jobs() {\n  const location = useLocation();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n\n  // SEO for jobs page\n  useSEO(location.pathname);\n  const { isAuthenticated, user } = useAuth();\n  const [searchFilters, setSearchFilters] = useState<SearchFilters>({});\n  const [jobs, setJobs] = useState<JobSummary[]>([]);\n  const [isLoading, setIsLoading] = useState<boolean>(true);\n  const [jobsData, setJobsData] = useState<{\n    owned: JobWithOwnership[];\n    tracked: JobWithOwnership[];\n  }>({\n    owned: [],\n    tracked: [],\n  });\n  const [error, setError] = useState<string | null>(null);\n  const [totalJobs, setTotalJobs] = useState<number>(0);\n\n  // Pagination logic\n  const {\n    currentPage,\n    itemsPerPage,\n    totalPages,\n    startIndex,\n    endIndex,\n    setCurrentPage,\n    handleItemsPerPageChange,\n    handleTotalItemsChange,\n  } = usePagination(totalJobs, 9);\n\n  // Fetch jobs data\n  const fetchJobs = async () => {\n    try {\n      setIsLoading(true);\n      setError(null);\n\n      const filters: JobFilters = {\n        search: searchFilters.search || undefined,\n        location: searchFilters.location || undefined,\n        employmentType: searchFilters.employmentType || undefined,\n        experienceLevel: searchFilters.experienceLevel || undefined,\n        isRemote: searchFilters.remote || undefined,\n        page: currentPage,\n        limit: itemsPerPage,\n      };\n\n      const result = await jobService.getPublicJobs(filters);\n      setJobs(result.items);\n      setTotalJobs(result.total);\n      handleTotalItemsChange(result.total);\n    } catch (err) {\n      console.error(\"Failed to fetch jobs:\", err);\n      setError(\"Failed to load jobs. Please try again.\");\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  // Fetch jobs when filters or page changes\n  useEffect(() => {\n    fetchJobs();\n  }, [searchFilters, currentPage, itemsPerPage]);\n\n  // Handle job tracking\n  const handleTrackJob = async (jobId: string) => {\n    if (user) {\n      try {\n        await jobService.saveJob(jobId);\n        // Refresh jobs to show updated state\n        await fetchJobs();\n      } catch (error) {\n        console.error(\"Failed to save job:\", error);\n      }\n    }\n  };\n\n  const handleUntrackJob = async (jobId: string) => {\n    if (user) {\n      try {\n        await jobService.unsaveJob(jobId);\n        // Refresh jobs to show updated state\n        await fetchJobs();\n      } catch (error) {\n        console.error(\"Failed to unsave job:\", error);\n      }\n    }\n  };\n\n  const handleSearch = (query: string) => {\n    setSearchFilters((prev) => ({ ...prev, search: query }));\n  };\n\n  const handleFilterChange = (filters: SearchFilters) => {\n    setSearchFilters(filters);\n  };\n\n  const handleClearFilters = () => {\n    setSearchFilters({});\n  };\n\n  // Temporary stub until owned/tracked jobs are wired\n  const getJobsForUser = (): {\n    owned: JobWithOwnership[];\n    tracked: JobWithOwnership[];\n  } => {\n    return { owned: [], tracked: [] };\n  };\n\n  // Load user's jobs when authenticated - only when needed\n  const loadUserJobsOnDemand = async () => {\n    if (!isAuthenticated || !user) return;\n\n    try {\n      setIsLoading(true);\n      // Get user's owned and tracked jobs\n      const ownedJobs = await jobService.getUserJobs();\n      const trackedJobs = await jobService.getSavedJobs();\n\n      setJobsData({\n        owned: ownedJobs.map((j) => ({\n          ...j,\n          company: j.company ?? \"\",\n          location: j.location ?? \"\",\n          employmentType: j.employmentType ?? \"\",\n          ownership: \"owned\" as const,\n          slug: (j as any).slug || \"\",\n          experienceLevel: (j as any).experienceLevel || \"entry\",\n          status: \"active\" as const,\n          privacy: \"public\" as const,\n          description: (j as any).description || \"\",\n          views: (j as any).views || 0,\n          applications: (j as any).applications || 0,\n          summary: (j as any).summary || \"\",\n          userId: (j as any).userId || \"\",\n          createdAt: (j as any).createdAt || \"\",\n          updatedAt: (j as any).updatedAt || \"\",\n        })),\n        tracked: trackedJobs.map((j) => ({\n          ...j,\n          company: j.company ?? \"\",\n          location: j.location ?? \"\",\n          employmentType: j.employmentType ?? \"\",\n          ownership: \"tracked\" as const,\n          slug: (j as any).slug || \"\",\n          experienceLevel: (j as any).experienceLevel || \"entry\",\n          status: \"active\" as const,\n          privacy: \"public\" as const,\n          description: (j as any).description || \"\",\n          views: (j as any).views || 0,\n          applications: (j as any).applications || 0,\n          summary: (j as any).summary || \"\",\n          userId: (j as any).userId || \"\",\n          createdAt: (j as any).createdAt || \"\",\n          updatedAt: (j as any).updatedAt || \"\",\n        })),\n      });\n    } catch (error) {\n      console.error(\"Failed to load user jobs:\", error);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  // Only load user jobs when specifically needed (not on every page load)\n  // This prevents the unnecessary /api/Job/saved API call\n  // useEffect(() => {\n  //   if (isAuthenticated && user) {\n  //     loadUserJobsOnDemand();\n  //   }\n  // }, [isAuthenticated, user]);\n\n  // If user is authenticated, show the actual jobs page\n  if (isAuthenticated && user) {\n    const isJobSeeker = user.role === USER_ROLES.JOB_SEEKER;\n    const isRecruiterOrEmployer =\n      user.role === USER_ROLES.RECRUITER || user.role === USER_ROLES.EMPLOYER;\n\n    return (\n      <div className=\"min-h-screen bg-background\">\n        <Sidebar\n          isOpen={sidebarOpen}\n          onClose={closeSidebar}\n          collapsed={sidebarCollapsed}\n        />\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n          <Navigation\n            onMenuClick={openSidebar}\n            onSidebarToggle={toggleSidebar}\n            sidebarCollapsed={sidebarCollapsed}\n          />\n\n          <div className=\"pt-16 p-6\">\n            <div className=\"max-w-7xl mx-auto\">\n              {/* Header */}\n              <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6\">\n                <div>\n                  <h1 className=\"text-3xl font-bold mb-2\">Jobs</h1>\n                  <p className=\"text-muted-foreground\">\n                    {isJobSeeker\n                      ? \"Discover and track job opportunities that match your skills\"\n                      : \"Manage your job postings and discover talent\"}\n                  </p>\n                </div>\n                <div className=\"flex items-center gap-2\">\n                  {isRecruiterOrEmployer && (\n                    <Button asChild>\n                      <Link to=\"/jobs/create\">\n                        <Plus className=\"h-4 w-4 mr-2\" />\n                        Post Job\n                      </Link>\n                    </Button>\n                  )}\n                </div>\n              </div>\n\n              {/* Search and Filters */}\n              <div className=\"mb-6\">\n                <SearchBar\n                  context=\"jobs\"\n                  value={searchFilters.search}\n                  filters={searchFilters}\n                  onSearch={handleSearch}\n                  onFilterChange={handleFilterChange}\n                  onClearFilters={handleClearFilters}\n                />\n              </div>\n\n              {/* Job Listings */}\n              <div className=\"space-y-6\">\n                {/* Owned Jobs (for recruiters/employers) */}\n                {isRecruiterOrEmployer &&\n                  \"owned\" in jobsData &&\n                  jobsData.owned.length > 0 && (\n                    <div>\n                      <h2 className=\"text-xl font-semibold mb-4 flex items-center gap-2\">\n                        <Briefcase className=\"h-5 w-5\" />\n                        Your Job Postings ({jobsData.owned.length})\n                      </h2>\n                      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                        {jobsData.owned.map((job) => (\n                          <JobCard\n                            key={job.id}\n                            job={job}\n                            showOwnership\n                            onTrack={handleTrackJob}\n                            onUntrack={handleUntrackJob}\n                          />\n                        ))}\n                      </div>\n                    </div>\n                  )}\n\n                {/* Tracked Jobs */}\n                {(\"tracked\" in jobsData\n                  ? jobsData.tracked.length > 0\n                  : false) && (\n                  <div>\n                    <h2 className=\"text-xl font-semibold mb-4 flex items-center gap-2\">\n                      <Users className=\"h-5 w-5\" />\n                      Tracked Jobs ({(jobsData as any).tracked.length})\n                    </h2>\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                      {(jobsData as any).tracked.map(\n                        (job: JobWithOwnership) => (\n                          <JobCard\n                            key={job.id}\n                            job={job}\n                            showOwnership\n                            onTrack={handleTrackJob}\n                            onUntrack={handleUntrackJob}\n                          />\n                        ),\n                      )}\n                    </div>\n                  </div>\n                )}\n\n                {/* All Available Jobs */}\n                <div>\n                  <h2 className=\"text-xl font-semibold mb-4 flex items-center gap-2\">\n                    <Search className=\"h-5 w-5\" />\n                    {isJobSeeker ? \"Available Jobs\" : \"All Jobs\"}\n                  </h2>\n                  {isLoading ? (\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                      {Array.from({ length: 6 }).map((_, index) => (\n                        <div key={index} className=\"animate-pulse\">\n                          <div className=\"bg-gray-200 rounded-lg h-48\" />\n                        </div>\n                      ))}\n                    </div>\n                  ) : error ? (\n                    <div className=\"text-center py-12\">\n                      <p className=\"text-red-600 mb-4\">{error}</p>\n                      <Button onClick={fetchJobs}>Try Again</Button>\n                    </div>\n                  ) : jobs.length === 0 ? (\n                    <div className=\"text-center py-12\">\n                      <p className=\"text-gray-600 mb-4\">\n                        No jobs found matching your criteria.\n                      </p>\n                      <Button onClick={() => setSearchFilters({})}>\n                        Clear Filters\n                      </Button>\n                    </div>\n                  ) : (\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                      {jobs.map((job) => {\n                        const jobMetadata = {\n                          id: job.id,\n                          slug: (job as any).slug || \"\",\n                          title: job.title,\n                          company: job.company,\n                          companyId: (job as any).companyId || \"\",\n                          location: job.location,\n                          description: (job as any).description || \"\",\n                          salary:\n                            job.salaryMin && job.salaryMax\n                              ? `$${(job.salaryMin / 1000).toFixed(0)}k - $${(job.salaryMax / 1000).toFixed(0)}k`\n                              : undefined,\n                          employmentType: job.employmentType,\n                          experienceLevel:\n                            (job as any).experienceLevel || \"entry\",\n                          postedDate: job.postedDate || \"\",\n                          isRemote: job.isRemote || false,\n                          status: \"active\" as const,\n                          privacy: \"public\" as const,\n                          views: (job as any).views || 0,\n                          applications: (job as any).applications || 0,\n                          createdAt: (job as any).createdAt || \"\",\n                          updatedAt: (job as any).updatedAt || \"\",\n                          summary: (job as any).summary || \"\",\n                          userId: (job as any).userId || \"\",\n                        };\n\n                        return (\n                          <JobCard\n                            key={job.id}\n                            job={jobMetadata}\n                            onTrack={handleTrackJob}\n                            onUntrack={handleUntrackJob}\n                          />\n                        );\n                      })}\n                    </div>\n                  )}\n\n                  {/* Pagination */}\n                  {!isLoading && !error && jobs.length > 0 && (\n                    <Pagination\n                      currentPage={currentPage}\n                      totalItems={totalJobs}\n                      itemsPerPage={itemsPerPage}\n                      onPageChange={setCurrentPage}\n                      onItemsPerPageChange={handleItemsPerPageChange}\n                    />\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n          <Footer />\n        </div>\n      </div>\n    );\n  }\n\n  // If user is not authenticated, show marketing page\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-background via-brand-purple/5 to-brand-blue/5\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16\">\n          <div className=\"max-w-6xl mx-auto px-4 py-16\">\n            {/* Hero Section */}\n            <div className=\"text-center mb-16\">\n              <div className=\"inline-flex items-center space-x-2 mb-6\">\n                <div className=\"relative\">\n                  <Briefcase className=\"h-12 w-12 text-primary\" />\n                  <Video className=\"h-6 w-6 text-brand-blue absolute -top-1 -right-1\" />\n                </div>\n                <span className=\"text-4xl font-bold bg-gradient-to-r from-brand-purple to-brand-blue bg-clip-text text-transparent\">\n                  Smart Jobs\n                </span>\n              </div>\n              <h1 className=\"text-5xl font-bold mb-6\">\n                Discover Your Perfect Career Match\n              </h1>\n              <p className=\"text-xl text-muted-foreground mb-8 max-w-3xl mx-auto\">\n                Find jobs that truly fit your skills and aspirations with\n                AI-powered matching, video job descriptions, and direct\n                connections to hiring managers.\n              </p>\n              <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n                <Link to=\"/signup\">\n                  <Button\n                    size=\"lg\"\n                    className=\"bg-gradient-to-r from-brand-purple to-brand-blue hover:opacity-90 text-lg px-8\"\n                  >\n                    Find Your Dream Job\n                    <ArrowRight className=\"ml-2 h-5 w-5\" />\n                  </Button>\n                </Link>\n                <Link to=\"/signup?role=recruiter\">\n                  <Button size=\"lg\" variant=\"outline\" className=\"text-lg px-8\">\n                    <Plus className=\"mr-2 h-5 w-5\" />\n                    Post a Job\n                  </Button>\n                </Link>\n              </div>\n              <div className=\"mt-4 text-center\">\n                <Button\n                  size=\"sm\"\n                  variant=\"ghost\"\n                  className=\"text-muted-foreground\"\n                >\n                  <Play className=\"mr-2 h-4 w-4\" />\n                  See How It Works\n                </Button>\n              </div>\n            </div>\n\n            {/* Stats Section */}\n            <div className=\"grid md:grid-cols-4 gap-6 mb-16\">\n              <div className=\"text-center\">\n                <div className=\"text-3xl font-bold text-primary mb-2\">50K+</div>\n                <p className=\"text-sm text-muted-foreground\">\n                  Active job postings\n                </p>\n              </div>\n              <div className=\"text-center\">\n                <div className=\"text-3xl font-bold text-primary mb-2\">95%</div>\n                <p className=\"text-sm text-muted-foreground\">Match accuracy</p>\n              </div>\n              <div className=\"text-center\">\n                <div className=\"text-3xl font-bold text-primary mb-2\">72h</div>\n                <p className=\"text-sm text-muted-foreground\">\n                  Average response time\n                </p>\n              </div>\n              <div className=\"text-center\">\n                <div className=\"text-3xl font-bold text-primary mb-2\">89%</div>\n                <p className=\"text-sm text-muted-foreground\">\n                  Interview success rate\n                </p>\n              </div>\n            </div>\n\n            {/* Featured Jobs Preview using shared JobCard */}\n            <div className=\"mb-16\">\n              <h2 className=\"text-3xl font-bold text-center mb-12\">\n                Featured Opportunities\n              </h2>\n              <div className=\"grid md:grid-cols-2 gap-6\">\n                {jobs.slice(0, 2).map((job) => {\n                  const jobMetadata = {\n                    id: job.id,\n                    slug: (job as any).slug || \"\",\n                    title: job.title,\n                    company: job.company,\n                    companyId: (job as any).companyId || \"\",\n                    location: job.location,\n                    description: (job as any).description || \"\",\n                    salary:\n                      job.salaryMin && job.salaryMax\n                        ? `$${(job.salaryMin / 1000).toFixed(0)}k - $${(job.salaryMax / 1000).toFixed(0)}k`\n                        : undefined,\n                    employmentType: job.employmentType,\n                    experienceLevel: (job as any).experienceLevel || \"entry\",\n                    postedDate: job.postedDate || \"\",\n                    isRemote: job.isRemote || false,\n                    status: \"active\" as const,\n                    privacy: \"public\" as const,\n                    views: (job as any).views || 0,\n                    applications: (job as any).applications || 0,\n                    createdAt: (job as any).createdAt || \"\",\n                    updatedAt: (job as any).updatedAt || \"\",\n                    summary: (job as any).summary || \"\",\n                    userId: (job as any).userId || \"\",\n                  };\n\n                  return <JobCard key={job.id} job={jobMetadata} />;\n                })}\n              </div>\n              <div className=\"text-center mt-8\">\n                <Link to=\"/signup\">\n                  <Button variant=\"outline\" size=\"lg\">\n                    View All 50,000+ Jobs\n                    <ArrowRight className=\"ml-2 h-4 w-4\" />\n                  </Button>\n                </Link>\n              </div>\n            </div>\n\n            {/* Features and other marketing content */}\n            <div className=\"mb-16\">\n              <h2 className=\"text-3xl font-bold text-center mb-12\">\n                Why Choose Our Job Platform\n              </h2>\n              <div className=\"grid md:grid-cols-3 gap-8\">\n                <Card className=\"border-brand-purple/20 hover:border-brand-purple/40 transition-colors\">\n                  <CardHeader>\n                    <Target className=\"h-10 w-10 text-brand-purple mb-4\" />\n                    <CardTitle>AI-Powered Matching</CardTitle>\n                    <CardDescription>\n                      Our advanced AI analyzes your skills, experience, and\n                      preferences to find jobs that truly match your career\n                      goals.\n                    </CardDescription>\n                  </CardHeader>\n                </Card>\n\n                <Card className=\"border-brand-blue/20 hover:border-brand-blue/40 transition-colors\">\n                  <CardHeader>\n                    <Video className=\"h-10 w-10 text-brand-blue mb-4\" />\n                    <CardTitle>Video Job Descriptions</CardTitle>\n                    <CardDescription>\n                      Get a real feel for the role with video job descriptions\n                      from actual hiring managers and team members.\n                    </CardDescription>\n                  </CardHeader>\n                </Card>\n\n                <Card className=\"border-primary/20 hover:border-primary/40 transition-colors\">\n                  <CardHeader>\n                    <Zap className=\"h-10 w-10 text-primary mb-4\" />\n                    <CardTitle>Direct Connections</CardTitle>\n                    <CardDescription>\n                      Skip the black hole of traditional applications. Connect\n                      directly with hiring managers and decision makers.\n                    </CardDescription>\n                  </CardHeader>\n                </Card>\n              </div>\n            </div>\n\n            {/* Employer CTA */}\n            <div className=\"mb-16\">\n              <div className=\"text-center bg-gradient-to-r from-green-50 to-blue-50 p-8 rounded-2xl border border-green-200/50\">\n                <Building2 className=\"h-12 w-12 text-green-600 mx-auto mb-4\" />\n                <h3 className=\"text-2xl font-bold mb-4\">\n                  Hiring? Find Top Talent Fast\n                </h3>\n                <p className=\"text-muted-foreground mb-6 max-w-2xl mx-auto\">\n                  Post your job openings and connect with qualified candidates\n                  who match your requirements. Our AI-powered platform helps you\n                  find the right talent quickly.\n                </p>\n                <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n                  <Link to=\"/signup?role=recruiter\">\n                    <Button\n                      size=\"lg\"\n                      className=\"bg-green-600 hover:bg-green-700 text-white\"\n                    >\n                      <Plus className=\"mr-2 h-5 w-5\" />\n                      Post Your First Job Free\n                    </Button>\n                  </Link>\n                  <Link to=\"/for-recruiters\">\n                    <Button size=\"lg\" variant=\"outline\">\n                      Learn More About Hiring\n                      <ArrowRight className=\"ml-2 h-5 w-5\" />\n                    </Button>\n                  </Link>\n                </div>\n              </div>\n            </div>\n\n            {/* Final CTA */}\n            <div className=\"text-center bg-gradient-to-r from-brand-purple/10 to-brand-blue/10 p-8 rounded-2xl\">\n              <h3 className=\"text-2xl font-bold mb-4\">\n                Ready to Find Your Perfect Job?\n              </h3>\n              <p className=\"text-muted-foreground mb-6\">\n                Join thousands of professionals who have found their dream\n                careers through our platform.\n              </p>\n              <Link to=\"/signup\">\n                <Button\n                  size=\"lg\"\n                  className=\"bg-gradient-to-r from-brand-purple to-brand-blue hover:opacity-90\"\n                >\n                  Start Your Job Search Today\n                  <ArrowRight className=\"ml-2 h-5 w-5\" />\n                </Button>\n              </Link>\n            </div>\n          </div>\n          <Footer />\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\Login.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Video' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":1,"endColumn":15},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Sparkles' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":17,"nodeType":null,"messageId":"unusedVar","endLine":1,"endColumn":25},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":54,"column":5,"nodeType":"MemberExpression","messageId":"unexpected","endLine":54,"endColumn":16,"suggestions":[{"fix":{"range":[1782,1832],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":59,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":59,