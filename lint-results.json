Shield,\n  Settings,\n  BarChart3,\n  Target,\n  Users,\n  Globe,\n  Eye,\n  CheckCircle2,\n  X,\n  AlertTriangle,\n  Info,\n} from \"lucide-react\";\nimport { useState } from \"react\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Separator } from \"@/components/ui/separator\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\n\nexport default function CookiePolicy() {\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { isAuthenticated } = useAuth();\n\n  // Mock cookie preferences - in a real app, these would be managed by a cookie consent system\n  const [cookiePreferences, setCookiePreferences] = useState({\n    essential: true, // Always required\n    analytics: true,\n    marketing: false,\n    personalization: true,\n  });\n\n  const cookieTypes = [\n    {\n      type: \"Essential Cookies\",\n      icon: Shield,\n      required: true,\n      description: \"Necessary for the website to function properly\",\n      examples: [\n        \"Authentication\",\n        \"Security\",\n        \"Load balancing\",\n        \"Form submissions\",\n      ],\n      color: \"green\",\n    },\n    {\n      type: \"Analytics Cookies\",\n      icon: BarChart3,\n      required: false,\n      description: \"Help us understand how visitors interact with our website\",\n      examples: [\n        \"Page views\",\n        \"Click tracking\",\n        \"Performance monitoring\",\n        \"Error reporting\",\n      ],\n      color: \"blue\",\n    },\n    {\n      type: \"Marketing Cookies\",\n      icon: Target,\n      required: false,\n      description: \"Used to deliver personalized advertisements\",\n      examples: [\n        \"Ad targeting\",\n        \"Conversion tracking\",\n        \"Social media integration\",\n        \"Retargeting\",\n      ],\n      color: \"purple\",\n    },\n    {\n      type: \"Personalization Cookies\",\n      icon: Users,\n      required: false,\n      description: \"Remember your preferences and provide customized content\",\n      examples: [\n        \"Language settings\",\n        \"Theme preferences\",\n        \"Recently viewed\",\n        \"Saved searches\",\n      ],\n      color: \"orange\",\n    },\n  ];\n\n  const handleCookiePreferenceChange = (type: string, enabled: boolean) => {\n    if (type === \"essential\") return; // Essential cookies cannot be disabled\n\n    setCookiePreferences((prev) => ({\n      ...prev,\n      [type]: enabled,\n    }));\n  };\n\n  const acceptAllCookies = () => {\n    setCookiePreferences({\n      essential: true,\n      analytics: true,\n      marketing: true,\n      personalization: true,\n    });\n  };\n\n  const rejectOptionalCookies = () => {\n    setCookiePreferences({\n      essential: true,\n      analytics: false,\n      marketing: false,\n      personalization: false,\n    });\n  };\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16 p-6\">\n          <div className=\"max-w-4xl mx-auto space-y-8\">\n            {/* Header */}\n            <div className=\"text-center\">\n              <div className=\"inline-flex items-center space-x-2 mb-4\">\n                <Cookie className=\"h-8 w-8 text-primary\" />\n                <span className=\"text-2xl font-bold bg-gradient-to-r from-brand-purple to-brand-blue bg-clip-text text-transparent\">\n                  Cookie Policy\n                </span>\n              </div>\n              <h1 className=\"text-4xl font-bold mb-4\">How We Use Cookies</h1>\n              <p className=\"text-xl text-muted-foreground max-w-2xl mx-auto\">\n                We use cookies and similar technologies to enhance your\n                experience, analyze our traffic, and provide personalized\n                content.\n              </p>\n              <p className=\"text-sm text-muted-foreground mt-4\">\n                Last updated: January 15, 2025\n              </p>\n            </div>\n\n            {/* Cookie Preferences Panel */}\n            <Card className=\"border-primary/20 bg-primary/5\">\n              <CardHeader>\n                <CardTitle className=\"flex items-center gap-2\">\n                  <Settings className=\"h-5 w-5\" />\n                  Cookie Preferences\n                </CardTitle>\n                <CardDescription>\n                  Manage your cookie preferences. Essential cookies are required\n                  for the site to function.\n                </CardDescription>\n              </CardHeader>\n              <CardContent className=\"space-y-6\">\n                {cookieTypes.map((cookie, index) => {\n                  const preferenceKey = cookie.type\n                    .toLowerCase()\n                    .replace(\" cookies\", \"\") as keyof typeof cookiePreferences;\n                  const isEnabled = cookiePreferences[preferenceKey];\n\n                  return (\n                    <div\n                      key={index}\n                      className=\"flex items-start justify-between p-4 border rounded-lg\"\n                    >\n                      <div className=\"flex items-start gap-3 flex-1\">\n                        <div\n                          className={`w-10 h-10 rounded-lg flex items-center justify-center ${\n                            cookie.color === \"green\"\n                              ? \"bg-green-100 dark:bg-green-900\"\n                              : cookie.color === \"blue\"\n                                ? \"bg-blue-100 dark:bg-blue-900\"\n                                : cookie.color === \"purple\"\n                                  ? \"bg-purple-100 dark:bg-purple-900\"\n                                  : \"bg-orange-100 dark:bg-orange-900\"\n                          }`}\n                        >\n                          <cookie.icon\n                            className={`h-5 w-5 ${\n                              cookie.color === \"green\"\n                                ? \"text-green-600 dark:text-green-400\"\n                                : cookie.color === \"blue\"\n                                  ? \"text-blue-600 dark:text-blue-400\"\n                                  : cookie.color === \"purple\"\n                                    ? \"text-purple-600 dark:text-purple-400\"\n                                    : \"text-orange-600 dark:text-orange-400\"\n                            }`}\n                          />\n                        </div>\n                        <div className=\"flex-1\">\n                          <div className=\"flex items-center gap-2 mb-1\">\n                            <h4 className=\"font-medium\">{cookie.type}</h4>\n                            {cookie.required && (\n                              <Badge variant=\"secondary\" className=\"text-xs\">\n                                Required\n                              </Badge>\n                            )}\n                          </div>\n                          <p className=\"text-sm text-muted-foreground mb-2\">\n                            {cookie.description}\n                          </p>\n                          <p className=\"text-xs text-muted-foreground\">\n                            Examples: {cookie.examples.join(\", \")}\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"ml-4\">\n                        <Switch\n                          checked={isEnabled}\n                          onCheckedChange={(checked) =>\n                            handleCookiePreferenceChange(preferenceKey, checked)\n                          }\n                          disabled={cookie.required}\n                        />\n                      </div>\n                    </div>\n                  );\n                })}\n\n                <div className=\"flex gap-3 pt-4\">\n                  <Button onClick={acceptAllCookies} className=\"flex-1\">\n                    Accept All Cookies\n                  </Button>\n                  <Button\n                    onClick={rejectOptionalCookies}\n                    variant=\"outline\"\n                    className=\"flex-1\"\n                  >\n                    Reject Optional Cookies\n                  </Button>\n                </div>\n              </CardContent>\n            </Card>\n\n            {/* What Are Cookies */}\n            <Card>\n              <CardHeader>\n                <CardTitle>What Are Cookies?</CardTitle>\n              </CardHeader>\n              <CardContent className=\"space-y-4\">\n                <p className=\"text-muted-foreground\">\n                  Cookies are small text files that are placed on your device\n                  when you visit a website. They help websites remember\n                  information about your visit, making your next visit easier\n                  and the site more useful to you.\n                </p>\n\n                <div className=\"grid md:grid-cols-2 gap-4 mt-6\">\n                  <div className=\"border rounded-lg p-4\">\n                    <h4 className=\"font-medium mb-2 flex items-center gap-2\">\n                      <CheckCircle2 className=\"h-4 w-4 text-green-600\" />\n                      First-Party Cookies\n                    </h4>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Set directly by MyVideoResume to provide essential\n                      functionality and improve your experience.\n                    </p>\n                  </div>\n\n                  <div className=\"border rounded-lg p-4\">\n                    <h4 className=\"font-medium mb-2 flex items-center gap-2\">\n                      <Globe className=\"h-4 w-4 text-blue-600\" />\n                      Third-Party Cookies\n                    </h4>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Set by external services we use, such as analytics\n                      providers and advertising networks.\n                    </p>\n                  </div>\n                </div>\n              </CardContent>\n            </Card>\n\n            {/* How We Use Cookies */}\n            <Card>\n              <CardHeader>\n                <CardTitle>How We Use Cookies</CardTitle>\n              </CardHeader>\n              <CardContent className=\"space-y-6\">\n                <div>\n                  <h4 className=\"font-medium mb-3\">Essential Functions</h4>\n                  <ul className=\"list-disc list-inside text-muted-foreground space-y-1 ml-4\">\n                    <li>Keep you logged in during your session</li>\n                    <li>Remember your language and region preferences</li>\n                    <li>Ensure security and prevent fraud</li>\n                    <li>Enable core platform functionality</li>\n                  </ul>\n                </div>\n\n                <Separator />\n\n                <div>\n                  <h4 className=\"font-medium mb-3\">Performance & Analytics</h4>\n                  <ul className=\"list-disc list-inside text-muted-foreground space-y-1 ml-4\">\n                    <li>Understand how you use our platform</li>\n                    <li>Identify popular features and content</li>\n                    <li>Monitor website performance and errors</li>\n                    <li>Improve our services based on usage patterns</li>\n                  </ul>\n                </div>\n\n                <Separator />\n\n                <div>\n                  <h4 className=\"font-medium mb-3\">Personalization</h4>\n                  <ul className=\"list-disc list-inside text-muted-foreground space-y-1 ml-4\">\n                    <li>Remember your dashboard preferences</li>\n                    <li>Suggest relevant job opportunities</li>\n                    <li>Customize content based on your interests</li>\n                    <li>Save your search filters and criteria</li>\n                  </ul>\n                </div>\n\n                <Separator />\n\n                <div>\n                  <h4 className=\"font-medium mb-3\">Marketing & Advertising</h4>\n                  <ul className=\"list-disc list-inside text-muted-foreground space-y-1 ml-4\">\n                    <li>Show relevant job advertisements</li>\n                    <li>Measure advertising campaign effectiveness</li>\n                    <li>Provide social media integration</li>\n                    <li>Enable retargeting for our services</li>\n                  </ul>\n                </div>\n              </CardContent>\n            </Card>\n\n            {/* Cookie Retention */}\n            <Card>\n              <CardHeader>\n                <CardTitle>Cookie Retention</CardTitle>\n              </CardHeader>\n              <CardContent>\n                <div className=\"space-y-4\">\n                  <div className=\"border rounded-lg p-4\">\n                    <h4 className=\"font-medium mb-2\">Session Cookies</h4>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Temporary cookies that are deleted when you close your\n                      browser. Used for essential functionality like maintaining\n                      your login session.\n                    </p>\n                  </div>\n\n                  <div className=\"border rounded-lg p-4\">\n                    <h4 className=\"font-medium mb-2\">Persistent Cookies</h4>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Remain on your device for a set period (typically 30 days\n                      to 2 years) or until you delete them. Used for preferences\n                      and analytics.\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"mt-6 p-4 bg-blue-50 dark:bg-blue-950 rounded-lg\">\n                  <h4 className=\"font-medium text-blue-800 dark:text-blue-200 mb-2\">\n                    Automatic Cleanup\n                  </h4>\n                  <p className=\"text-blue-700 dark:text-blue-300 text-sm\">\n                    We automatically delete old cookies and regularly review our\n                    cookie usage to minimize data collection while maintaining\n                    functionality.\n                  </p>\n                </div>\n              </CardContent>\n            </Card>\n\n            {/* Managing Cookies */}\n            <Card>\n              <CardHeader>\n                <CardTitle>Managing Your Cookies</CardTitle>\n              </CardHeader>\n              <CardContent className=\"space-y-4\">\n                <div>\n                  <h4 className=\"font-medium mb-3\">Browser Settings</h4>\n                  <p className=\"text-muted-foreground mb-3\">\n                    You can control cookies through your browser settings:\n                  </p>\n                  <ul className=\"list-disc list-inside text-muted-foreground space-y-1 ml-4\">\n                    <li>\n                      <strong>Chrome:</strong> Settings ΓåÆ Privacy and security ΓåÆ\n                      Cookies and other site data\n                    </li>\n                    <li>\n                      <strong>Firefox:</strong> Settings ΓåÆ Privacy & Security ΓåÆ\n                      Cookies and Site Data\n                    </li>\n                    <li>\n                      <strong>Safari:</strong> Preferences ΓåÆ Privacy ΓåÆ Manage\n                      Website Data\n                    </li>\n                    <li>\n                      <strong>Edge:</strong> Settings ΓåÆ Cookies and site\n                      permissions ΓåÆ Cookies and site data\n                    </li>\n                  </ul>\n                </div>\n\n                <div className=\"bg-amber-50 dark:bg-amber-950 p-4 rounded-lg\">\n                  <div className=\"flex items-start gap-2\">\n                    <AlertTriangle className=\"h-5 w-5 text-amber-600 dark:text-amber-400 mt-0.5\" />\n                    <div>\n                      <h4 className=\"font-medium text-amber-800 dark:text-amber-200 mb-1\">\n                        Impact of Disabling Cookies\n                      </h4>\n                      <p className=\"text-amber-700 dark:text-amber-300 text-sm\">\n                        Disabling certain cookies may limit website\n                        functionality. Essential cookies are required for the\n                        site to work properly and cannot be disabled.\n                      </p>\n                    </div>\n                  </div>\n                </div>\n              </CardContent>\n            </Card>\n\n            {/* Third-Party Services */}\n            <Card>\n              <CardHeader>\n                <CardTitle>Third-Party Services</CardTitle>\n              </CardHeader>\n              <CardContent>\n                <p className=\"text-muted-foreground mb-4\">\n                  We use the following third-party services that may set\n                  cookies:\n                </p>\n\n                <div className=\"grid gap-4\">\n                  <div className=\"border rounded-lg p-4\">\n                    <h4 className=\"font-medium mb-1\">Google Analytics</h4>\n                    <p className=\"text-sm text-muted-foreground mb-2\">\n                      Website analytics and performance monitoring\n                    </p>\n                    <a\n                      href=\"https://policies.google.com/privacy\"\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"text-primary text-sm hover:underline\"\n                    >\n                      View Google's Privacy Policy ΓåÆ\n                    </a>\n                  </div>\n\n                  <div className=\"border rounded-lg p-4\">\n                    <h4 className=\"font-medium mb-1\">LinkedIn Ads</h4>\n                    <p className=\"text-sm text-muted-foreground mb-2\">\n                      Professional networking and job advertising\n                    </p>\n                    <a\n                      href=\"https://www.linkedin.com/legal/privacy-policy\"\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"text-primary text-sm hover:underline\"\n                    >\n                      View LinkedIn's Privacy Policy ΓåÆ\n                    </a>\n                  </div>\n\n                  <div className=\"border rounded-lg p-4\">\n                    <h4 className=\"font-medium mb-1\">Intercom</h4>\n                    <p className=\"text-sm text-muted-foreground mb-2\">\n                      Customer support and messaging\n                    </p>\n                    <a\n                      href=\"https://www.intercom.com/legal/privacy\"\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"text-primary text-sm hover:underline\"\n                    >\n                      View Intercom's Privacy Policy ΓåÆ\n                    </a>\n                  </div>\n                </div>\n              </CardContent>\n            </Card>\n\n            {/* Contact */}\n            <Card>\n              <CardHeader>\n                <CardTitle>Questions About Cookies?</CardTitle>\n              </CardHeader>\n              <CardContent>\n                <p className=\"text-muted-foreground mb-4\">\n                  If you have questions about our use of cookies or this policy,\n                  please contact us:\n                </p>\n\n                <div className=\"space-y-2\">\n                  <p className=\"text-sm\">\n                    Email:{\" \"}\n                    <a\n                      href=\"mailto:privacy@myvideoresume.me\"\n                      className=\"text-primary hover:underline\"\n                    >\n                      privacy@myvideoresume.me\n                    </a>\n                  </p>\n                  <p className=\"text-sm\">Subject: Cookie Policy Inquiry</p>\n                </div>\n\n                <div className=\"mt-6 p-4 bg-muted/20 rounded-lg\">\n                  <p className=\"text-sm text-muted-foreground\">\n                    We review and update this Cookie Policy periodically. Check\n                    back regularly for any changes.\n                  </p>\n                </div>\n              </CardContent>\n            </Card>\n          </div>\n        </div>\n        <Footer />\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\Dashboard.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'CardContent' is defined but never used. Allowed unused vars must match /^_/u.","line":20,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":20,"endColumn":14}],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":81,"column":39,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":81,"endColumn":42,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2408,2411],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2408,2411],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\nimport {\n  AlertCircle,\n  RefreshCw,\n  TrendingUp,\n  Video as VideoIcon,\n  Users,\n  Briefcase,\n  Sparkles,\n  ArrowRight,\n} from \"lucide-react\";\nimport { Link } from \"react-router-dom\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Button } from \"@/components/ui/button\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\n\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\nimport { createRolePermissions } from \"@/lib/role-utils\";\nimport useDashboard from \"@/hooks/dashboard/useDashboard\";\n\n// Role-specific dashboard components\nimport JobSeekerDashboard from \"@/components/dashboard/JobSeekerDashboard\";\nimport RecruiterDashboard from \"@/components/dashboard/RecruiterDashboard\";\nimport EmployerDashboard from \"@/components/dashboard/EmployerDashboard\";\nimport AdminDashboard from \"@/components/dashboard/AdminDashboard\";\n\nexport default function Dashboard() {\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { user, isAuthenticated, isLoading } = useAuth();\n\n  // Use custom dashboard hook for data management\n  const {\n    dashboardData,\n    loading: dashboardLoading,\n    error: dashboardError,\n    lastRefresh,\n    refreshDashboard,\n  } = useDashboard();\n\n  // Get role permissions for routing\n  const rolePermissions = createRolePermissions(user?.role);\n\n  // Dashboard wrapper component\n  const DashboardWrapper: React.FC<{ children: React.ReactNode }> = ({\n    children,\n  }) => (\n    <div className=\"max-w-7xl mx-auto px-4 py-8\">\n      <div className=\"mb-8\">\n        <h1 className=\"text-3xl font-bold\">{dashboardData?.title}</h1>\n        <p className=\"text-muted-foreground\">{dashboardData?.description}</p>\n        {lastRefresh && (\n          <p className=\"text-xs text-muted-foreground mt-2\">\n            Last updated: {lastRefresh.toLocaleString()}\n          </p>\n        )}\n      </div>\n      {children}\n    </div>\n  );\n\n  // Role-to-component mapping\n  const getDashboardComponent = () => {\n    const commonProps = {\n      // eslint-disable-next-line @typescript-eslint/no-explicit-any\n      dashboardData: dashboardData as any, // Type assertion needed for role-specific dashboard data\n      loading: dashboardLoading,\n      onRefresh: refreshDashboard,\n    };\n\n    if (rolePermissions.isJobSeeker)\n      return <JobSeekerDashboard {...commonProps} />;\n    if (rolePermissions.isRecruiter)\n      return <RecruiterDashboard {...commonProps} />;\n    if (rolePermissions.isEmployer)\n      return <EmployerDashboard {...commonProps} />;\n    if (rolePermissions.isAdmin) return <AdminDashboard {...commonProps} />;\n\n    // Fallback for unknown roles\n    return (\n      <div className=\"text-center\">\n        <h1 className=\"text-3xl font-bold mb-4\">Welcome to MyVideoResume</h1>\n        <p className=\"text-muted-foreground\">\n          Your role ({user?.role}) doesn&apos;t have a specific dashboard yet.\n        </p>\n      </div>\n    );\n  };\n\n  // Render dashboard content with unified error/loading handling\n  const renderDashboardContent = () => {\n    if (dashboardLoading) {\n      return (\n        <div className=\"max-w-7xl mx-auto px-4 py-8\">\n          <div className=\"text-center\">\n            <div className=\"animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto mb-4\" />\n            <p className=\"text-muted-foreground\">Loading dashboard...</p>\n          </div>\n        </div>\n      );\n    }\n\n    if (dashboardError) {\n      return (\n        <div className=\"max-w-7xl mx-auto px-4 py-8\">\n          <Alert variant=\"destructive\">\n            <AlertCircle className=\"h-4 w-4\" />\n            <AlertDescription>\n              {dashboardError}\n              <Button\n                variant=\"outline\"\n                size=\"sm\"\n                className=\"ml-4\"\n                onClick={refreshDashboard}\n              >\n                <RefreshCw className=\"h-4 w-4 mr-2\" />\n                Retry\n              </Button>\n            </AlertDescription>\n          </Alert>\n        </div>\n      );\n    }\n\n    if (!dashboardData) {\n      return (\n        <div className=\"max-w-7xl mx-auto px-4 py-8\">\n          <div className=\"text-center\">\n            <p className=\"text-muted-foreground\">No dashboard data available</p>\n          </div>\n        </div>\n      );\n    }\n\n    return <DashboardWrapper>{getDashboardComponent()}</DashboardWrapper>;\n  };\n\n  // Shared layout component\n  const PageLayout: React.FC<{ children: React.ReactNode }> = ({\n    children,\n  }) => (\n    <div className=\"min-h-screen bg-gradient-to-br from-background via-brand-purple/5 to-brand-blue/5\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n        <div className=\"pt-16\">{children}</div>\n        <Footer />\n      </div>\n    </div>\n  );\n\n  // Show loading state while authentication is being determined\n  if (isLoading) {\n    return (\n      <PageLayout>\n        <div className=\"max-w-7xl mx-auto px-4 py-16\">\n          <div className=\"text-center\">\n            <div className=\"animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto mb-4\" />\n            <p className=\"text-muted-foreground\">Loading dashboard...</p>\n          </div>\n        </div>\n      </PageLayout>\n    );\n  }\n\n  // If user is not authenticated, show marketing content (SEO-friendly)\n  if (!isAuthenticated || !user) {\n    return (\n      <div className=\"min-h-screen bg-gradient-to-br from-background via-brand-purple/5 to-brand-blue/5\">\n        <Sidebar isOpen={sidebarOpen} onClose={closeSidebar} collapsed={sidebarCollapsed} />\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n          <Navigation\n            onMenuClick={openSidebar}\n            onSidebarToggle={toggleSidebar}\n            sidebarCollapsed={sidebarCollapsed}\n          />\n\n          <div className=\"pt-16\">\n            <div className=\"max-w-6xl mx-auto px-4 py-16\">\n              {/* Hero Section */}\n              <div className=\"text-center mb-16\">\n                <div className=\"inline-flex items-center space-x-2 mb-6\">\n                  <div className=\"relative\">\n                    <TrendingUp className=\"h-12 w-12 text-primary\" />\n                    <Sparkles className=\"h-6 w-6 text-brand-blue absolute -top-1 -right-1\" />\n                  </div>\n                  <span className=\"text-4xl font-bold bg-gradient-to-r from-brand-purple to-brand-blue bg-clip-text text-transparent\">\n                    Smart Dashboard\n                  </span>\n                </div>\n                <h1 className=\"text-5xl font-bold mb-6\">Your Career Command Center</h1>\n                <p className=\"text-xl text-muted-foreground mb-8 max-w-3xl mx-auto\">\n                  Track your resumes, jobs, outreach, and network in one place. Personalized insights and actions to accelerate your career.\n                </p>\n                <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n                  <Link to=\"/signup\">\n                    <Button size=\"lg\" className=\"bg-gradient-to-r from-brand-purple to-brand-blue hover:opacity-90 text-lg px-8\">\n                      Get Started Free\n                      <ArrowRight className=\"ml-2 h-5 w-5\" />\n                    </Button>\n                  </Link>\n                  <Link to=\"/login\">\n                    <Button size=\"lg\" variant=\"outline\" className=\"text-lg px-8\">\n                      Sign In\n                    </Button>\n                  </Link>\n                </div>\n              </div>\n\n              {/* Benefits Section */}\n              <div className=\"grid md:grid-cols-3 gap-8 mb-16\">\n                <Card className=\"border-brand-purple/20 hover:border-brand-purple/40 transition-colors\">\n                  <CardHeader>\n                    <VideoIcon className=\"h-10 w-10 text-brand-purple mb-4\" />\n                    <CardTitle>Unified View</CardTitle>\n                    <CardDescription>\n                      See your latest resumes, job applications, and outreach stats at a glance.\n                    </CardDescription>\n                  </CardHeader>\n                </Card>\n\n                <Card className=\"border-brand-blue/20 hover:border-brand-blue/40 transition-colors\">\n                  <CardHeader>\n                    <Briefcase className=\"h-10 w-10 text-brand-blue mb-4\" />\n                    <CardTitle>Actionable Insights</CardTitle>\n                    <CardDescription>\n                      AI-powered recommendations to help you take the next best step.\n                    </CardDescription>\n                  </CardHeader>\n                </Card>\n\n                <Card className=\"border-primary/20 hover:border-primary/40 transition-colors\">\n                  <CardHeader>\n                    <Users className=\"h-10 w-10 text-primary mb-4\" />\n                    <CardTitle>Network Growth</CardTitle>\n                    <CardDescription>\n                      Track connections and outreach performance over time.\n                    </CardDescription>\n                  </CardHeader>\n                </Card>\n              </div>\n            </div>\n          </div>\n\n          <Footer />\n        </div>\n      </div>\n    );\n  }\n\n  // Main dashboard render\n  return <PageLayout>{renderDashboardContent()}</PageLayout>;\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\EmbeddedResume.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Share2' is defined but never used. Allowed unused vars must match /^_/u.","line":3,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":3,"endColumn":16},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Badge' is defined but never used. Allowed unused vars must match /^_/u.","line":6,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":6,"endColumn":15},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Separator' is defined but never used. Allowed unused vars must match /^_/u.","line":7,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":7,"endColumn":19},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'ShareModal' is defined but never used. Allowed unused vars must match /^_/u.","line":8,"column":8,"nodeType":null,"messag