\n  Target,\n  User,\n  Mail,\n  Building2,\n  FileText,\n  Video,\n  Settings,\n  Users,\n  Briefcase,\n  Sparkles,\n} from \"lucide-react\";\nimport React, { useState } from \"react\";\nimport { Link, useNavigate } from \"react-router-dom\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Progress } from \"@/components/ui/progress\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { Textarea } from \"@/components/ui/textarea\";\n\nexport default function Onboarding() {\n  const navigate = useNavigate();\n\n  // Mock user data\n  const [user] = useState({\n    id: \"user123\",\n    name: \"Sarah Johnson\",\n    email: \"sarah@example.com\",\n    persona: \"recruiter\" as \"job_seeker\" | \"recruiter\" | \"employer\",\n  });\n\n  const [currentStep, setCurrentStep] = useState(0);\n  const [completedTasks, setCompletedTasks] = useState<string[]>([\n    \"profile\",\n    \"preferences\",\n    \"verification\",\n  ]);\n\n  // Persona-specific onboarding tasks\n  const getOnboardingSteps = () => {\n    const baseSteps = [\n      {\n        id: \"profile\",\n        title: \"Complete Your Profile\",\n        description: \"Add your basic information\",\n        icon: User,\n        completed: completedTasks.includes(\"profile\"),\n        component: ProfileStep,\n      },\n      {\n        id: \"preferences\",\n        title: \"Set Your Preferences\",\n        description: \"Customize your experience\",\n        icon: Settings,\n        completed: completedTasks.includes(\"preferences\"),\n        component: PreferencesStep,\n      },\n      {\n        id: \"verification\",\n        title: \"Verify Your Email\",\n        description: \"Confirm your email address\",\n        icon: Mail,\n        completed: completedTasks.includes(\"verification\"),\n        component: VerificationStep,\n      },\n    ];\n\n    switch (user.persona) {\n      case \"job_seeker\":\n        return [\n          ...baseSteps,\n          {\n            id: \"resume\",\n            title: \"Upload Your Resume\",\n            description: \"Share your professional background\",\n            icon: FileText,\n            completed: completedTasks.includes(\"resume\"),\n            component: ResumeUploadStep,\n          },\n          {\n            id: \"video\",\n            title: \"Create Video Resume\",\n            description: \"Make yourself stand out\",\n            icon: Video,\n            completed: completedTasks.includes(\"video\"),\n            component: VideoResumeStep,\n          },\n          {\n            id: \"skills\",\n            title: \"Add Skills & Experience\",\n            description: \"Highlight your expertise\",\n            icon: Target,\n            completed: completedTasks.includes(\"skills\"),\n            component: SkillsStep,\n          },\n        ];\n      case \"recruiter\":\n        return [\n          ...baseSteps,\n          {\n            id: \"company\",\n            title: \"Company Profile\",\n            description: \"Set up your company information\",\n            icon: Building2,\n            completed: completedTasks.includes(\"company\"),\n            component: CompanyStep,\n          },\n          {\n            id: \"team\",\n            title: \"Invite Team Members\",\n            description: \"Collaborate with your team\",\n            icon: Users,\n            completed: completedTasks.includes(\"team\"),\n            component: TeamStep,\n          },\n          {\n            id: \"jobs\",\n            title: \"Post Your First Job\",\n            description: \"Start finding candidates\",\n            icon: Briefcase,\n            completed: completedTasks.includes(\"jobs\"),\n            component: JobPostStep,\n          },\n        ];\n      case \"employer\":\n        return [\n          ...baseSteps,\n          {\n            id: \"company\",\n            title: \"Company Information\",\n            description: \"Complete your company details\",\n            icon: Building2,\n            completed: completedTasks.includes(\"company\"),\n            component: CompanyStep,\n          },\n          {\n            id: \"team\",\n            title: \"Add Team Members\",\n            description: \"Invite your hiring team\",\n            icon: Users,\n            completed: completedTasks.includes(\"team\"),\n            component: TeamStep,\n          },\n          {\n            id: \"integration\",\n            title: \"Configure Integrations\",\n            description: \"Connect your tools\",\n            icon: Settings,\n            completed: completedTasks.includes(\"integration\"),\n            component: IntegrationsStep,\n          },\n        ];\n      default:\n        return baseSteps;\n    }\n  };\n\n  const steps = getOnboardingSteps();\n  const progressPercentage = Math.round(\n    (completedTasks.length / steps.length) * 100,\n  );\n  const CurrentStepComponent = steps[currentStep]?.component || ProfileStep;\n\n  const handleCompleteTask = (taskId: string) => {\n    if (!completedTasks.includes(taskId)) {\n      setCompletedTasks([...completedTasks, taskId]);\n    }\n  };\n\n  const handleNext = () => {\n    if (currentStep < steps.length - 1) {\n      setCurrentStep(currentStep + 1);\n    } else {\n      // Onboarding complete, redirect to dashboard\n      navigate(\"/dashboard\");\n    }\n  };\n\n  const handlePrevious = () => {\n    if (currentStep > 0) {\n      setCurrentStep(currentStep - 1);\n    }\n  };\n\n  const handleSkipToEnd = () => {\n    navigate(\"/dashboard\");\n  };\n\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-background to-muted/20 flex flex-col\">\n      {/* Header - Fixed */}\n      <div className=\"flex-shrink-0 container mx-auto px-4 py-6\">\n        <div className=\"max-w-4xl mx-auto text-center\">\n          <div className=\"flex items-center justify-center gap-2 mb-4\">\n            <Sparkles className=\"h-8 w-8 text-primary\" />\n            <h1 className=\"text-3xl font-bold\">Welcome to MyVideoResume!</h1>\n          </div>\n          <p className=\"text-muted-foreground text-lg\">\n            Let's get your {user.persona.replace(\"_\", \" \")} profile set up in\n            just a few steps\n          </p>\n          <Badge variant=\"secondary\" className=\"capitalize mt-2\">\n            {user.persona.replace(\"_\", \" \")} Setup\n          </Badge>\n        </div>\n      </div>\n\n      {/* Main Content - Flexible */}\n      <div className=\"flex-1 container mx-auto px-4 pb-6 flex flex-col min-h-0\">\n        <div className=\"max-w-4xl mx-auto flex flex-col h-full gap-6\">\n          {/* Progress Overview - Fixed */}\n          <Card className=\"flex-shrink-0\">\n            <CardHeader>\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <CardTitle className=\"flex items-center gap-2\">\n                    <Target className=\"h-5 w-5\" />\n                    Setup Progress\n                  </CardTitle>\n                  <CardDescription>\n                    {completedTasks.length} of {steps.length} steps completed\n                  </CardDescription>\n                </div>\n                <div className=\"text-right\">\n                  <div className=\"text-3xl font-bold text-primary\">\n                    {progressPercentage}%\n                  </div>\n                  <div className=\"text-sm text-muted-foreground\">Complete</div>\n                </div>\n              </div>\n            </CardHeader>\n            <CardContent>\n              <Progress value={progressPercentage} className=\"h-3\" />\n            </CardContent>\n          </Card>\n\n          {/* Steps and Form Layout - Flexible */}\n          <div className=\"flex-1 flex flex-col gap-6 min-h-0\">\n            {/* Steps List - Scrollable */}\n            <Card className=\"flex-shrink-0\">\n              <CardHeader>\n                <CardTitle>Setup Steps</CardTitle>\n                <CardDescription>Click on any step to navigate</CardDescription>\n              </CardHeader>\n              <CardContent>\n                <div className=\"flex gap-4 overflow-x-auto pb-4 max-h-32 overflow-y-auto\">\n                  {steps.map((step, index) => (\n                    <div\n                      key={step.id}\n                      className={`flex-shrink-0 p-4 rounded-lg border cursor-pointer transition-all min-w-[200px] ${\n                        index === currentStep\n                          ? \"border-primary bg-primary/5 shadow-sm\"\n                          : step.completed\n                            ? \"border-green-200 bg-green-50\"\n                            : \"border-muted bg-muted/20\"\n                      }`}\n                      onClick={() => setCurrentStep(index)}\n                    >\n                      <div className=\"flex items-center gap-3\">\n                        <div\n                          className={`p-2 rounded-full ${\n                            step.completed\n                              ? \"bg-green-500 text-white\"\n                              : index === currentStep\n                                ? \"bg-primary text-primary-foreground\"\n                                : \"bg-muted text-muted-foreground\"\n                          }`}\n                        >\n                          {step.completed ? (\n                            <CheckCircle2 className=\"h-4 w-4\" />\n                          ) : (\n                            <step.icon className=\"h-4 w-4\" />\n                          )}\n                        </div>\n                        <div className=\"flex-1\">\n                          <h4 className=\"font-medium text-sm\">{step.title}</h4>\n                          <p className=\"text-xs text-muted-foreground\">\n                            {step.description}\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </CardContent>\n            </Card>\n\n            {/* Current Step Form - Fixed, Non-scrollable */}\n            <Card className=\"flex-1 flex flex-col\">\n              <CardHeader className=\"flex-shrink-0\">\n                <CardTitle className=\"flex items-center gap-2\">\n                  {React.createElement(steps[currentStep].icon, {\n                    className: \"h-5 w-5\",\n                  })}\n                  {steps[currentStep].title}\n                </CardTitle>\n                <CardDescription>\n                  {steps[currentStep].description}\n                </CardDescription>\n              </CardHeader>\n              <CardContent className=\"flex-1 flex flex-col\">\n                <CurrentStepComponent\n                  onComplete={() => handleCompleteTask(steps[currentStep].id)}\n                  isCompleted={steps[currentStep].completed}\n                  user={user}\n                />\n              </CardContent>\n            </Card>\n          </div>\n        </div>\n      </div>\n\n      {/* Navigation - Fixed at bottom */}\n      <div className=\"flex-shrink-0 container mx-auto px-4 py-4 border-t bg-background/80 backdrop-blur-sm\">\n        <div className=\"max-w-4xl mx-auto flex items-center justify-between\">\n          <Button\n            variant=\"outline\"\n            onClick={handlePrevious}\n            disabled={currentStep === 0}\n            className=\"gap-2\"\n          >\n            <ArrowLeft className=\"h-4 w-4\" />\n            Previous\n          </Button>\n\n          <div className=\"flex gap-2\">\n            <Button variant=\"ghost\" onClick={handleSkipToEnd}>\n              Skip Setup\n            </Button>\n            <Button\n              onClick={handleNext}\n              className=\"gap-2\"\n              disabled={!steps[currentStep].completed}\n            >\n              {currentStep === steps.length - 1 ? \"Complete Setup\" : \"Continue\"}\n              <ArrowRight className=\"h-4 w-4\" />\n            </Button>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n// Step Components\nfunction ProfileStep({ onComplete, isCompleted, user }: any) {\n  const [formData, setFormData] = useState({\n    name: user.name || \"\",\n    title: \"\",\n    location: \"\",\n    bio: \"\",\n  });\n\n  const handleSubmit = () => {\n    onComplete();\n  };\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        <div>\n          <Label htmlFor=\"name\">Full Name</Label>\n          <Input\n            id=\"name\"\n            value={formData.name}\n            onChange={(e) => setFormData({ ...formData, name: e.target.value })}\n          />\n        </div>\n        <div>\n          <Label htmlFor=\"title\">Professional Title</Label>\n          <Input\n            id=\"title\"\n            placeholder=\"e.g. Senior Software Engineer\"\n            value={formData.title}\n            onChange={(e) =>\n              setFormData({ ...formData, title: e.target.value })\n            }\n          />\n        </div>\n      </div>\n      <div>\n        <Label htmlFor=\"location\">Location</Label>\n        <Input\n          id=\"location\"\n          placeholder=\"e.g. San Francisco, CA\"\n          value={formData.location}\n          onChange={(e) =>\n            setFormData({ ...formData, location: e.target.value })\n          }\n        />\n      </div>\n      <div>\n        <Label htmlFor=\"bio\">Professional Bio</Label>\n        <Textarea\n          id=\"bio\"\n          placeholder=\"Tell us about yourself...\"\n          value={formData.bio}\n          onChange={(e) => setFormData({ ...formData, bio: e.target.value })}\n        />\n      </div>\n      {!isCompleted && (\n        <Button onClick={handleSubmit} className=\"w-full\">\n          Save Profile Information\n        </Button>\n      )}\n    </div>\n  );\n}\n\nfunction PreferencesStep({ onComplete, isCompleted }: any) {\n  return (\n    <div className=\"space-y-4\">\n      <p className=\"text-muted-foreground\">\n        Set your notification and privacy preferences.\n      </p>\n      {!isCompleted && (\n        <Button onClick={onComplete} className=\"w-full\">\n          Save Preferences\n        </Button>\n      )}\n    </div>\n  );\n}\n\nfunction VerificationStep({ onComplete, isCompleted }: any) {\n  return (\n    <div className=\"space-y-4\">\n      <p className=\"text-muted-foreground\">\n        We've sent a verification email. Please check your inbox.\n      </p>\n      {!isCompleted && (\n        <Button onClick={onComplete} className=\"w-full\">\n          Mark as Verified\n        </Button>\n      )}\n    </div>\n  );\n}\n\nfunction ResumeUploadStep({ onComplete, isCompleted }: any) {\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"border-2 border-dashed border-muted-foreground/30 rounded-lg p-8 text-center\">\n        <FileText className=\"h-12 w-12 text-muted-foreground mx-auto mb-4\" />\n        <p className=\"text-lg font-medium mb-2\">Upload Your Resume</p>\n        <p className=\"text-muted-foreground mb-4\">PDF, DOC, or DOCX files</p>\n        <Button variant=\"outline\">Choose File</Button>\n      </div>\n      {!isCompleted && (\n        <Button onClick={onComplete} className=\"w-full\">\n          Resume Uploaded\n        </Button>\n      )}\n    </div>\n  );\n}\n\nfunction VideoResumeStep({ onComplete, isCompleted }: any) {\n  return (\n    <div className=\"space-y-4\">\n      <p className=\"text-muted-foreground\">\n        Create a video resume to stand out from other candidates.\n      </p>\n      {!isCompleted && (\n        <Button onClick={onComplete} className=\"w-full\">\n          Create Video Resume\n        </Button>\n      )}\n    </div>\n  );\n}\n\nfunction SkillsStep({ onComplete, isCompleted }: any) {\n  return (\n    <div className=\"space-y-4\">\n      <p className=\"text-muted-foreground\">\n        Add your skills and experience level.\n      </p>\n      {!isCompleted && (\n        <Button onClick={onComplete} className=\"w-full\">\n          Add Skills\n        </Button>\n      )}\n    </div>\n  );\n}\n\nfunction CompanyStep({ onComplete, isCompleted }: any) {\n  return (\n    <div className=\"space-y-4\">\n      <p className=\"text-muted-foreground\">\n        Set up your company profile and information.\n      </p>\n      {!isCompleted && (\n        <Button onClick={onComplete} className=\"w-full\">\n          Complete Company Setup\n        </Button>\n      )}\n    </div>\n  );\n}\n\nfunction TeamStep({ onComplete, isCompleted }: any) {\n  return (\n    <div className=\"space-y-4\">\n      <p className=\"text-muted-foreground\">\n        Invite team members to collaborate on hiring.\n      </p>\n      {!isCompleted && (\n        <Button onClick={onComplete} className=\"w-full\">\n          Invite Team Members\n        </Button>\n      )}\n    </div>\n  );\n}\n\nfunction JobPostStep({ onComplete, isCompleted }: any) {\n  return (\n    <div className=\"space-y-4\">\n      <p className=\"text-muted-foreground\">\n        Create your first job posting to start finding candidates.\n      </p>\n      {!isCompleted && (\n        <Button onClick={onComplete} className=\"w-full\">\n          Post First Job\n        </Button>\n      )}\n    </div>\n  );\n}\n\nfunction IntegrationsStep({ onComplete, isCompleted }: any) {\n  return (\n    <div className=\"space-y-4\">\n      <p className=\"text-muted-foreground\">\n        Connect your existing tools and platforms.\n      </p>\n      {!isCompleted && (\n        <Button onClick={onComplete} className=\"w-full\">\n          Configure Integrations\n        </Button>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\Outreach.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":187,"column":9,"nodeType":"MemberExpression","messageId":"unexpected","endLine":187,"endColumn":22,"suggestions":[{"fix":{"range":[4875,4927],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  Send,\n  Video,\n  Sparkles,\n  ArrowRight,\n  Star,\n  MessageSquare,\n  Mail,\n  Phone,\n  Users,\n  Target,\n  Zap,\n  BarChart3,\n  Clock,\n  Network,\n  UserPlus,\n  MessageCircle,\n  Loader2,\n  Plus,\n  Edit,\n  Trash2,\n  FileText,\n  ExternalLink,\n} from \"lucide-react\";\nimport { useState, useEffect } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport {\n  Dialog,\n  DialogContent,\n  DialogDescription,\n  DialogHeader,\n  DialogTitle,\n  DialogFooter,\n} from \"@/components/ui/dialog\";\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\nimport { communicationService } from \"@/lib/services/communication-service\";\nimport {\n  EmailTemplateDTO,\n  EmailCampaignDTO,\n  CommunicationTrackingDTO,\n  ExternalContactDTO,\n  CommunicationStats,\n  EmailTemplateCategory,\n  EmailTemplateTargetRole,\n  EmailCampaignStatus,\n  CreateEmailTemplateRequest,\n  CreateExternalContactRequest,\n  CommunicationChannel,\n  CommunicationTrackingStatus,\n} from \"@/types/communication\";\n\nexport default function Outreach() {\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { isAuthenticated, user } = useAuth();\n\n  // State management\n  const [activeTab, setActiveTab] = useState<\n    \"dashboard\" | \"templates\" | \"campaigns\" | \"tracking\" | \"contacts\"\n  >(\"dashboard\");\n  const [isLoading, setIsLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  // Data state\n  const [emailTemplates, setEmailTemplates] = useState<EmailTemplateDTO[]>([]);\n  const [emailCampaigns, setEmailCampaigns] = useState<EmailCampaignDTO[]>([]);\n  const [communicationTracking, setCommunicationTracking] = useState<\n    CommunicationTrackingDTO[]\n  >([]);\n  const [externalContacts, setExternalContacts] = useState<\n    ExternalContactDTO[]\n  >([]);\n  const [communicationStats, setCommunicationStats] =\n    useState<CommunicationStats | null>(null);\n   \n  const [_teamMembers, setTeamMembers] = useState<\n    {\n      id: string;\n      userProfile?: {\n        id: string;\n        firstName: string;\n        lastName: string;\n        role?: string;\n      };\n    }[]\n  >([]);\n\n  // Dialog states\n  const [showTemplateDialog, setShowTemplateDialog] = useState(false);\n  const [showContactDialog, setShowContactDialog] = useState(false);\n  const [editingTemplate, setEditingTemplate] =\n    useState<EmailTemplateDTO | null>(null);\n  const [editingContact, setEditingContact] =\n    useState<ExternalContactDTO | null>(null);\n\n  // Form states\n  const [templateForm, setTemplateForm] = useState<CreateEmailTemplateRequest>({\n    name: \"\",\n    description: \"\",\n    subject: \"\",\n    body: \"\",\n    category: EmailTemplateCategory.General,\n    targetRole: EmailTemplateTargetRole.All,\n  });\n\n  const [contactForm, setContactForm] = useState<CreateExternalContactRequest>({\n    email: \"\",\n    firstName: \"\",\n    lastName: \"\",\n    jobTitle: \"\",\n    companyName: \"\",\n    phone: \"\",\n    linkedInUrl: \"\",\n    location: \"\",\n    notes: \"\",\n  });\n\n  // Load data on component mount\n  useEffect(() => {\n    if (!isAuthenticated || !user) return;\n\n    const loadData = async () => {\n      try {\n        setIsLoading(true);\n        setError(null);\n\n        const [\n          templatesData,\n          campaignsData,\n          trackingData,\n          contactsData,\n          statsData,\n          teamData,\n        ] = await Promise.all([\n          communicationService.getEmailTemplates(),\n          communicationService.getEmailCampaigns(),\n          communicationService.getCommunicationTracking(),\n          communicationService.getExternalContacts(),\n          communicationService.getCommunicationStats().catch(() => null),\n          communicationService.getTeamMembers().catch(() => []),\n        ]);\n\n        setEmailTemplates(templatesData);\n        setEmailCampaigns(campaignsData);\n        setCommunicationTracking(trackingData);\n        setExternalContacts(contactsData);\n        setCommunicationStats(statsData);\n        setTeamMembers(teamData);\n      } catch (err) {\n        console.error(\"Failed to load outreach data:\", err);\n        setError(\n          err instanceof Error ? err.message : \"Failed to load outreach data\",\n        );\n      } finally {\n        setIsLoading(false);\n      }\n    };\n\n    loadData();\n  }, [isAuthenticated, user]);\n\n  // Template management functions\n  const handleCreateTemplate = async () => {\n    try {\n      const newTemplate =\n        await communicationService.createEmailTemplate(templateForm);\n      setEmailTemplates((prev) => [...prev, newTemplate]);\n      setShowTemplateDialog(false);\n      resetTemplateForm();\n    } catch (err) {\n      setError(\n        err instanceof Error ? err.message : \"Failed to create template\",\n      );\n    }\n  };\n\n  const handleUpdateTemplate = async () => {\n    if (!editingTemplate) return;\n\n    try {\n      const updatedTemplate = await communicationService.updateEmailTemplate({\n        ...templateForm,\n        id: editingTemplate.id,\n      });\n      setEmailTemplates((prev) =>\n        prev.map((t) => (t.id === updatedTemplate.id ? updatedTemplate : t)),\n      );\n      setShowTemplateDialog(false);\n      resetTemplateForm();\n      setEditingTemplate(null);\n    } catch (err) {\n      setError(\n        err instanceof Error ? err.message : \"Failed to update template\",\n      );\n    }\n  };\n\n  const handleDeleteTemplate = async (templateId: string) => {\n    try {\n      await communicationService.deleteEmailTemplate(templateId);\n      setEmailTemplates((prev) => prev.filter((t) => t.id !== templateId));\n    } catch (err) {\n      setError(\n        err instanceof Error ? err.message : \"Failed to delete template\",\n      );\n    }\n  };\n\n  const resetTemplateForm = () => {\n    setTemplateForm({\n      name: \"\",\n      description: \"\",\n      subject: \"\",\n      body: \"\",\n      category: EmailTemplateCategory.General,\n      targetRole: EmailTemplateTargetRole.All,\n    });\n  };\n\n  // Contact management functions\n  const handleCreateContact = async () => {\n    try {\n      const newContact =\n        await communicationService.createExternalContact(contactForm);\n      setExternalContacts((prev) => [...prev, newContact]);\n      setShowContactDialog(false);\n      resetContactForm();\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to create contact\");\n    }\n  };\n\n  const handleUpdateContact = async () => {\n    if (!editingContact) return;\n\n    try {\n      const updatedContact = await communicationService.updateExternalContact({\n        ...contactForm,\n        id: editingContact.id,\n      });\n      setExternalContacts((prev) =>\n        prev.map((c) => (c.id === updatedContact.id ? updatedContact : c)),\n      );\n      setShowContactDialog(false);\n      resetContactForm();\n      setEditingContact(null);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to update contact\");\n    }\n  };\n\n  const handleDeleteContact = async (contactId: string) => {\n    try {\n      await communicationService.deleteExternalContact(contactId);\n      setExternalContacts((prev) => prev.filter((c) => c.id !== contactId));\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"Failed to delete contact\");\n    }\n  };\n\n  const resetContactForm = () => {\n    setContactForm({\n      email: \"\",\n      firstName: \"\",\n      lastName: \"\",\n      jobTitle: \"\",\n      companyName: \"\",\n      phone: \"\",\n      linkedInUrl: \"\",\n      location: \"\",\n      notes: \"\",\n    });\n  };\n\n  // If user is not authenticated, show marketing page\n  if (!isAuthenticated || !user) {\n    return (\n      <div className=\"min-h-screen bg-gradient-to-br from-background via-brand-purple/5 to-brand-blue/5\">\n        <Sidebar\n          isOpen={sidebarOpen}\n          onClose={closeSidebar}\n          collapsed={sidebarCollapsed}\n        />\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n          <Navigation\n            onMenuClick={openSidebar}\n            onSidebarToggle={toggleSidebar}\n            sidebarCollapsed={sidebarCollapsed}\n          />\n\n          <div className=\"pt-16\">\n            <div className=\"max-w-6xl mx-auto px-4 py-16\">\n              {/* Hero Section */}\n              <div className=\"text-center mb-16\">\n                <div className=\"inline-flex items-center space-x-2 mb-6\">\n                  <div className=\"relative\">\n                    <Send className=\"h-12 w-12 text-primary\" />\n                    <Sparkles className=\"h-6 w-6 text-brand-blue absolute -top-1 -right-1\" />\n                  </div>\n                  <span className=\"text-4xl font-bold bg-gradient-to-r from-brand-purple to-brand-blue bg-clip-text text-transparent\">\n                    Smart Outreach\n                  </span>\n                </div>\n                <h1 className=\"text-5xl font-bold mb-6\">\n                  Connect, Engage, and Follow Up\n                </h1>\n                <p className=\"text-xl text-muted-foreground mb-8 max-w-3xl mx-auto\">\n                  Streamline your networking and communication with AI-powered\n                  outreach tools. Send personalized messages, track engagement,\n                  and automate follow-ups to accelerate your career.\n                </p>\n                <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n                  <Link to=\"/signup\">\n                    <Button\n                      size=\"lg\"\n                      className=\"bg-gradient-to-r from-brand-purple to-brand-blue hover:opacity-90 text-lg px-8\"\n                    >\n                      Start Networking Today\n                      <ArrowRight className=\"ml-2 h-5 w-5\" />\n                    </Button>\n                  </Link>\n                  <Link to=\"/login\">\n                    <Button\n                      size=\"lg\"\n                      variant=\"outline\"\n                      className=\"text-lg px-8\"\n                    >\n                      Sign In\n                    </Button>\n                  </Link>\n                </div>\n              </div>\n\n              {/* Features Grid */}\n              <div className=\"grid md:grid-cols-3 gap-8 mb-16\">\n                <Card className=\"border-brand-purple/20 hover:border-brand-purple/40 transition-colors\">\n                  <CardHeader>\n                    <MessageSquare className=\"h-10 w-10 text-brand-purple mb-4\" />\n                    <CardTitle>Smart Messaging</CardTitle>\n                    <CardDescription>\n                      AI-powered message templates and personalization to help\n                      you craft compelling outreach that gets responses.\n                    </CardDescription>\n                  </CardHeader>\n                </Card>\n\n                <Card className=\"border-brand-blue/20 hover:border-brand-blue/40 transition-colors\">\n                  <CardHeader>\n                    <BarChart3 className=\"h-10 w-10 text-brand-blue mb-4\" />\n                    <CardTitle>Engagement Tracking</CardTitle>\n                    <CardDescription>\n                      Monitor response rates, track conversations, and analyze\n                      which outreach strategies work best for your career goals.\n                    </CardDescription>\n                  </CardHeader>\n                </Card>\n\n                <Card className=\"border-primary/20 hover:border-primary/40 transition-colors\">\n                  <CardHeader>\n                    <Clock className=\"h-10 w-10 text-primary mb-4\" />\n                    <CardTitle>Follow-up Automation</CardTitle>\n                    <CardDescription>\n                      Never miss a follow-up opportunity with automated\n                      reminders and sequence scheduling tailored to your\n                      networking strategy.\n                    </CardDescription>\n                  </CardHeader>\n                </Card>\n              </div>\n\n              {/* Persona-specific Benefits */}\n              <div className=\"mb-16\">\n                <h2 className=\"text-3xl font-bold text-center mb-12\">\n                  Outreach for Every Professional\n                </h2>\n                <div className=\"grid md:grid-cols-3 gap-8\">\n                  <Card className=\"text-center\">\n                    <CardHeader>\n                      <Users className=\"h-12 w-12 mx-auto text-green-600 mb-4\" />\n                      <CardTitle>Job Seekers</CardTitle>\n                      <CardDescription>\n                        Reach out to hiring managers, request informational\n                        interviews, and build relationships that lead to\n                        opportunities.\n                      </CardDescription>\n                    </CardHeader>\n                    <CardContent>\n                      <div className=\"space-y-2 text-sm text-left\">\n                        <div className=\"flex items-center gap-2\">\n                          <Star className=\"h-4 w-4 text-yellow-500\" />\n                          LinkedIn connection requests\n                        </div>\n                        <div className=\"flex items-center gap-2\">\n                          <Star className=\"h-4 w-4 text-yellow-500\" />\n                          Informational interview requests\n                        </div>\n                        <div className=\"flex items-center gap-2\">\n                          <Star className=\"h-4 w-4 text-yellow-500\" />\n                          Thank you and follow-up messages\n                        </div>\n                      </div>\n                    </CardContent>\n                  </Card>\n\n                  <Card className=\"text-center\">\n                    <CardHeader>\n                      <Target className=\"h-12 w-12 mx-auto text-blue-600 mb-4\" />\n                      <CardTitle>Recruiters</CardTitle>\n                      <CardDescription>\n                        Engage top talent, nurture candidate relationships, and\n                        maintain a pipeline of qualified professionals.\n                      </CardDescription>\n                    </CardHeader>\n                    <CardContent>\n                      <div className=\"space-y-2 text-sm text-left\">\n                        <div className=\"flex items-center gap-2\">\n                          <Star className=\"h-4 w-4 text-yellow-500\" />\n                          Candidate sourcing messages\n                        </div>\n                        <div className=\"flex items-center gap-2\">\n                          <Star className=\"h-4 w-4 text-yellow-500\" />\n                          Interview invitation templates\n                        </div>\n                        <div className=\"flex items-center gap-2\">\n                          <Star className=\"h-4 w-4 text-yellow-500\" />\n                          Talent pipeline management\n                        </div>\n                      </div>\n                    </CardContent>\n                  </Card>\n\n                  <Card className=\"text-center\">\n                    <CardHeader>\n                      <Network className=\"h-12 w-12 mx-auto text-purple-600 mb-4\" />\n                      <CardTitle>Employers</CardTitle>\n                      <CardDescription>\n                        Build partnerships, connect with vendors, and maintain\n                        professional relationships that drive growth.\n                      </CardDescription>\n                    </CardHeader>\n                    <CardContent>\n                      <div className=\"space-y-2 text-sm text-left\">\n                        <div className=\"flex items-center gap-2\">\n                          <Star className=\"h-4 w-4 text-yellow-500\" />\n                          Partnership proposals\n                        </div>\n                        <div className=\"flex items-center gap-2\">\n                          <Star className=\"h-4 w-4 text-yellow-500\" />\n                          Vendor outreach campaigns\n                        </div>\n                        <div className=\"flex items-center gap-2\">\n                          <Star className=\"h-4 w-4 text-yellow-500\" />\n                          Client relationship management\n                        </div>\n                      </div>\n                    </CardContent>\n                  </Card>\n                </div>\n              </div>\n\n              {/* Communication Channels */}\n              <div className=\"mb-16\">\n                <h2 className=\"text-3xl font-bold text-center mb-12\">\n                  Multi-Channel Communication\n                </h2>\n                <div className=\"grid md:grid-cols-4 gap-6\">\n                  <Card className=\"text-center\">\n                    <CardHeader>\n                      <Mail className=\"h-8 w-8 mx-auto text-blue-600 mb-2\" />\n                      <CardTitle className=\"text-lg\">Email</CardTitle>\n                      <CardDescription className=\"text-sm\">\n                        Professional email templates and automation\n                      </CardDescription>\n                    </CardHeader>\n                  </Card>\n\n                  <Card className=\"text-center\">\n                    <CardHeader>\n                      <MessageCircle className=\"h-8 w-8 mx-auto text-green-600 mb-2\" />\n                      <CardTitle className=\"text-lg\">LinkedIn</CardTitle>\n                      <CardDescription className=\"text-sm\">\n                        Social networking and connection requests\n                      </CardDescription>\n                    </CardHeader>\n                  </Card>\n\n                  <Card className=\"text-center\">\n                    <CardHeader>\n                      <Phone className=\"h-8 w-8 mx-auto text-purple-600 mb-2\" />\n                      <CardTitle className=\"text-lg\">Phone</CardTitle>\n                      <CardDescription className=\"text-sm\">\n                        Call scheduling and follow-up reminders\n                      </CardDescription>\n                    </CardHeader>\n                  </Card>\n\n                  <Card className=\"text-center\">\n                    <CardHeader>\n                      <Video className=\"h-8 w-8 mx-auto text-red-600 mb-2\" />\n                      <CardTitle className=\"text-lg\">Video</CardTitle>\n                      <CardDescription className=\"text-sm\">\n                        Personalized video messages and calls\n                      </CardDescription>\n                    </CardHeader>\n                  </Card>\n                </div>\n              </div>\n\n              {/* Final CTA */}\n              <div className=\"text-center bg-gradient-to-r from-brand-purple/10 to-brand-blue/10 p-8 rounded-2xl\">\n                <h3 className=\"text-2xl font-bold mb-4\">\n                  Ready to Supercharge Your Networking?\n                </h3>\n                <p className=\"text-muted-foreground mb-6\">\n                  Join thousands of professionals who are building meaningful\n                  connections and accelerating their careers with smart\n                  outreach.\n                </p>\n                <Link to=\"/signup\">\n                  <Button\n                    size=\"lg\"\n                    className=\"bg-gradient-to-r from-brand-purple to-brand-blue hover:opacity-90\"\n                  >\n                    Start Your Outreach Campaign\n                    <ArrowRight className=\"ml-2 h-5 w-5\" />\n                  </Button>\n                </Link>\n              </div>\n            </div>\n            <Footer />\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  // Authenticated user view - Outreach dashboard\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16 p-6\">\n          <div className=\"max-w-7xl mx-auto space-y-6\">\n            {/* Header */}\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <h1 className=\"text-3xl font-bold text-foreground\">\n                  Outreach & Communication\n                </h1>\n                <p className=\"text-muted-foreground mt-1\">\n                  Manage your networking campaigns and follow-ups\n                </p>\n              </div>\n              <div className=\"flex items-center gap-4\">\n                <Badge variant=\"secondary\" className=\"capitalize\">\n                  {user.role?.replace(\"_\", \" \")}\n                </Badge>\n                <Button onClick={() => setShowTemplateDialog(true)}>\n                  <Plus className=\"h-4 w-4 mr-2\" />\n                  New Template\n                </Button>\n              </div>\n            </div>\n\n            {/* Loading State */}\n            {isLoading && (\n              <div className=\"flex items-center justify-center py-12\">\n                <Loader2 className=\"h-8 w-8 animate-spin mr-2\" />\n                <span>Loading outreach data...</span>\n              </div>\n            )}\n\n            {/* Error State */}\n            {error && (\n              <div className=\"bg-red-50 border border-red-200 rounded-lg p-4\">\n                <div className=\"flex items-center\">\n                  <MessageCircle className=\"h-5 w-5 text-red-500 mr-2\" />\n                  <span className=\"text-red-700\">{error}</span>\n                </div>\n              </div>\n            )}\n\n            {/* Main Content */}\n            {!isLoading && !error && (\n              <>\n                {/* Tabs Navigation */}\n                <Tabs\n                  value={activeTab}\n                  onValueChange={(value) =>\n                    setActiveTab(\n                      value as\n                        | \"dashboard\"\n                        | \"templates\"\n                        | \"campaigns\"\n                        | \"tracking\"\n                        | \"contacts\",\n                    )\n                  }\n                >\n                  <TabsList className=\"grid w-full grid-cols-5\">\n                    <TabsTrigger value=\"dashboard\">Dashboard</TabsTrigger>\n                    <TabsTrigger value=\"templates\">Templates</TabsTrigger>\n                    <TabsTrigger value=\"campaigns\">Campaigns</TabsTrigger>\n                    <TabsTrigger value=\"tracking\">Tracking</TabsTrigger>\n                    <TabsTrigger value=\"contacts\">Contacts</TabsTrigger>\n                  </TabsList>\n\n                  {/* Dashboard Tab */}\n                  <TabsContent value=\"dashboard\" className=\"space-y-6\">\n                    {/* Quick Stats */}\n                    <div className=\"grid grid-cols-1 md:grid-cols-4 gap-6\">\n                      <Card>\n                        <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n                          <CardTitle className=\"text-sm font-medium text-muted-foreground\">\n                            Messages Sent\n                          </CardTitle>\n                          <Send className=\"h-4 w-4 text-muted-foreground\" />\n                        </CardHeader>\n                        <CardContent>\n                          <div className=\"text-2xl font-bold\">\n                            {communicationStats?.totalMessages || 0}\n                          </div>\n                          <div className=\"text-xs text-muted-foreground\">\n                            Total messages sent\n                          </div>\n                        </CardContent>\n                      </Card>\n\n                      <Card>\n                        <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n                          <CardTitle className=\"text-sm font-medium text-muted-foreground\">\n                            Response Rate\n                          </CardTitle>\n                          <BarChart3 className=\"h-4 w-4 text-muted-foreground\" />\n                        </CardHeader>\n                        <CardContent>\n                          <div className=\"text-2xl font-bold\">\n                            {communicationStats?.responseRate\n                              ? `${Math.round(communicationStats.responseRate * 100)}%`\n                              : \"0%\"}\n                          </div>\n                          <div className=\"text-xs text-muted-foreground\">\n                            Average response rate\n                          </div>\n                        </CardContent>\n                      </Card>\n\n                      <Card>\n                        <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n                          <CardTitle className=\"text-sm font-medium text-muted-foreground\">\n                            Active Conversations\n                          </CardTitle>\n                          <MessageSquare className=\"h-4 w-4 text-muted-foreground\" />\n                        </CardHeader>\n                        <CardContent>\n                          <div className=\"text-2xl font-bold\">\n                            {communicationStats?.activeConversations || 0}\n                          </div>\n                          <div className=\"text-xs text-muted-foreground\">\n                            Ongoing conversations\n                          </div>\n                        </CardContent>\n                      </Card>\n\n                      <Card>\n                        <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n                          <CardTitle className=\"text-sm font-medium text-muted-foreground\">\n                            Pending Follow-ups\n                          </CardTitle>\n                          <Clock className=\"h-4 w-4 text-muted-foreground\" />\n                        </CardHeader>\n                        <CardContent>\n                          <div className=\"text-2xl font-bold\">\n                            {communicationStats?.pendingFollowUps || 0}\n                          </div>\n                          <div className=\"text-xs text-muted-foreground\">\n                            Require attention\n                          </div>\n                        </CardContent>\n                      </Card>\n                    </div>\n\n                    {/* Quick Actions */}\n                    <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n                      <Card>\n                        <CardHeader>\n                          <CardTitle className=\"flex items-center gap-2\">\n                            <Zap className=\"h-5 w-5\" />\n                            Quick Actions\n                          </CardTitle>\n                        </CardHeader>\n                        <CardContent className=\"space-y-3\">\n                          <Button\n                            className=\"w-full justify-start gap-3\"\n                            variant=\"outline\"\n                            onClick={() => setShowTemplateDialog(true)}\n                          >\n                            <FileText className=\"h-4 w-4\" />\n                            Create Email Template\n                          </Button>\n                          <Button\n                            className=\"w-full justify-start gap-3\"\n                            variant=\"outline\"\n                            disabled\n                          >\n                            <Mail className=\"h-4 w-4\" />\n                            Start Email Campaign (Coming Soon)\n                          </Button>\n                          <Button\n                            className=\"w-full justify-start gap-3\"\n                            variant=\"outline\"\n                            onClick={() => setShowContactDialog(true)}\n                          >\n                            <UserPlus className=\"h-4 w-4\" />\n                            Add External Contact\n                          </Button>\n                        </CardContent>\n                      </Card>\n\n                      <Card>\n                        <CardHeader>\n                          <CardTitle className=\"flex items-center gap-2\">\n                            <Clock className=\"h-5 w-5\" />\n                            Recent Activity\n                          </CardTitle>\n                        </CardHeader>\n                        <CardContent className=\"space-y-4\">\n                          {communicationTracking.slice(0, 3).map((tracking) => (\n                            <div\n                              key={tracking.id}\n                              className=\"flex items-start gap-3 p-3 bg-muted/30 rounded-lg\"\n                            >\n                              <div className=\"w-2 h-2 bg-primary rounded-full mt-2 flex-shrink-0\" />\n                              <div className=\"flex-1\">\n                                <p className=\"text-sm font-medium\">\n                                  {tracking.subject || \"Communication\"}\n                                </p>\n                                <p className=\"text-xs text-muted-foreground\">\n                                  {tracking.externalName ||\n                                    tracking.targetUser?.firstName +\n                                      \" \" +\n                                      tracking.targetUser?.lastName}\n                                </p>\n                              </div>\n                            </div>\n                          ))}\n                          {communicationTracking.length === 0 && (\n                            <p className=\"text-sm text-muted-foreground text-center py-4\">\n                              No recent activity\n                            </p>\n                          )}\n                        </CardContent>\n                      </Card>\n                    </div>\n                  </TabsContent>\n\n                  {/* Templates Tab */}\n                  <TabsContent value=\"templates\" className=\"space-y-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <h2 className=\"text-2xl font-bold\">Email Templates</h2>\n                      <Button onClick={() => setShowTemplateDialog(true)}>\n                        <Plus className=\"h-4 w-4 mr-2\" />\n                        New Template\n                      </Button>\n                    </div>\n\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                      {emailTemplates.map((template) => (\n                        <Card key={template.id}>\n                          <CardHeader>\n                            <div className=\"flex items-start justify-between\">\n                              <div>\n                                <CardTitle className=\"text-lg\">\n                                  {template.name}\n                                </CardTitle>\n                                <CardDescription>\n                                  {template.description}\n                                </CardDescription>\n                              </div>\n                              <div className=\"flex gap-2\">\n                                <Button\n                                  size=\"sm\"\n                                  variant=\"outline\"\n                                  onClick={() => {\n                                    setEditingTemplate(template);\n                                    setTemplateForm({\n                                      name: template.name,\n                                      description: template.description || \"\",\n                                      subject: template.subject,\n                                      body: template.body,\n                                      category: template.category,\n                                      targetRole: template.targetRole,\n                                    });\n                                    setShowTemplateDialog(true);\n                                  }}\n                                >\n                                  <Edit className=\"h-4 w-4\" />\n                                </Button>\n                                {!template.isSystemTemplate && (\n                                  <Button\n                                    size=\"sm\"\n                                    variant=\"outline\"\n                                    onClick={() =>\n                                      handleDeleteTemplate(template.id)\n                                    }\n                                  >\n                                    <Trash2 className=\"h-4 w-4\" />\n                                  </Button>\n                                )}\n                              </div>\n                            </div>\n                          </CardHeader>\n                          <CardContent>\n                            <div className=\"space-y-2\">\n                              <Badge variant=\"secondary\">\n                                {EmailTemplateCategory[template.category]}\n                              </Badge>\n                              <Badge variant=\"outline\">\n                                {EmailTemplateTargetRole[template.targetRole]}\n                              </Badge>\n                              <p className=\"text-sm text-muted-foreground\">\n                                Used {template.usageCount} times\n                              </p>\n                            </div>\n                          </CardContent>\n                        </Card>\n                      ))}\n                    </div>\n\n                    {emailTemplates.length === 0 && (\n                      <div className=\"text-center py-12\">\n                        <FileText className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                        <h3 className=\"text-lg font-medium mb-2\">\n                          No templates yet\n                        </h3>\n                        <p className=\"text-muted-foreground mb-4\">\n                          Create your first email template to get started\n                        </p>\n                        <Button onClick={() => setShowTemplateDialog(true)}>\n                          <Plus className=\"h-4 w-4 mr-2\" />\n                          Create Template\n                        </Button>\n                      </div>\n                    )}\n                  </TabsContent>\n\n                  {/* Campaigns Tab */}\n                  <TabsContent value=\"campaigns\" className=\"space-y-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <h2 className=\"text-2xl font-bold\">Email Campaigns</h2>\n                      <Button disabled>\n                        <Plus className=\"h-4 w-4 mr-2\" />\n                        New Campaign (Coming Soon)\n                      </Button>\n                    </div>\n\n                    <div className=\"space-y-4\">\n                      {emailCampaigns.map((campaign) => (\n                        <Card key={campaign.id}>\n                          <CardHeader>\n                            <div className=\"flex items-start justify-between\">\n                              <div>\n                                <CardTitle>{campaign.name}</CardTitle>\n                                <CardDescription>\n                                  {campaign.description}\n                                </CardDescription>\n                              </div>\n                              <Badge\n                                variant={\n                                  campaign.status === EmailCampaignStatus.Sent\n                                    ? \"default\"\n                                    : \"secondary\"\n                                }\n                              >\n                                {EmailCampaignStatus[campaign.status]}\n                              </Badge>\n                            </div>\n                          </CardHeader>\n                          <CardContent>\n                            <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 text-sm\">\n                              <div>\n                                <p className=\"text-muted-foreground\">\n                                  Recipients\n                                </p>\n                                <p className=\"font-medium\">\n                                  {campaign.totalRecipients}\n                                </p>\n                              </div>\n                              <div>\n                                <p className=\"text-muted-foreground\">Sent</p>\n                                <p className=\"font-medium\">\n                                  {campaign.emailsSent}\n                                </p>\n                              </div>\n                              <div>\n                                <p className=\"text-muted-foreground\">Opened</p>\n                                <p className=\"font-medium\">\n                                  {campaign.emailsOpened}\n                                </p>\n                              </div>\n                              <div>\n                                <p className=\"text-muted-foreground\">Replies</p>\n                                <p className=\"font-medium\">\n                                  {campaign.repliesReceived}\n                                </p>\n                              </div>\n                            </div>\n                          </CardContent>\n                        </Card>\n                      ))}\n                    </div>\n\n                    {emailCampaigns.length === 0 && (\n                      <div className=\"text-center py-12\">\n                        <Mail className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                        <h3 className=\"text-lg font-medium mb-2\">\n                          No campaigns yet\n                        </h3>\n                        <p className=\"text-muted-foreground mb-4\">\n                          Create your first email campaign to start outreach\n                        </p>\n                        <Button disabled>\n                          <Plus className=\"h-4 w-4 mr-2\" />\n                          Create Campaign (Coming Soon)\n                        </Button>\n                      </div>\n                    )}\n                  </TabsContent>\n\n                  {/* Tracking Tab */}\n                  <TabsContent value=\"tracking\" className=\"space-y-6\">\n                    <h2 className=\"text-2xl font-bold\">\n                      Communication Tracking\n                    </h2>\n\n                    <Table>\n                      <TableHeader>\n                        <TableRow>\n                          <TableHead>Contact</TableHead>\n                          <TableHead>Subject</TableHead>\n                          <TableHead>Channel</TableHead>\n                          <TableHead>Status</TableHead>\n                          <TableHead>Date</TableHead>\n                        </TableRow>\n                      </TableHeader>\n                      <TableBody>\n                        {communicationTracking.map((tracking) => (\n                          <TableRow key={tracking.id}>\n                            <TableCell>\n                              {tracking.externalName ||\n                                (tracking.targetUser\n                                  ? `${tracking.targetUser.firstName} ${tracking.targetUser.lastName}`\n                                  : \"Unknown\")}\n                            </TableCell>\n                            <TableCell>\n                              {tracking.subject || \"No subject\"}\n                            </TableCell>\n                            <TableCell>\n                              <Badge variant=\"outline\">\n                                {CommunicationChannel[tracking.channel]}\n                              </Badge>\n                            </TableCell>\n                            <TableCell>\n                              <Badge\n                                variant={\n                                  tracking.status ===\n                                  CommunicationTrackingStatus.Replied\n                                    ? \"default\"\n                                    : \"secondary\"\n                                }\n                              >\n                                {CommunicationTrackingStatus[tracking.status]}\n                              </Badge>\n                            </TableCell>\n                            <TableCell>\n                              {tracking.creationDateTime\n                                ? new Date(\n                                    tracking.creationDateTime,\n                                  ).toLocaleDateString()\n                                : \"Unknown\"}\n                            </TableCell>\n                          </TableRow>\n                        ))}\n                      </TableBody>\n                    </Table>\n\n                    {communicationTracking.length === 0 && (\n                      <div className=\"text-center py-12\">\n                        <BarChart3 className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                        <h3 className=\"text-lg font-medium mb-2\">\n                          No communications tracked\n                        </h3>\n                        <p className=\"text-muted-foreground\">\n                          Start sending messages to see tracking data here\n                        </p>\n                      </div>\n                    )}\n                  </TabsContent>\n\n                  {/* Contacts Tab */}\n                  <TabsContent value=\"contacts\" className=\"space-y-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <h2 className=\"text-2xl font-bold\">External Contacts</h2>\n                      <Button onClick={() => setShowContactDialog(true)}>\n                        <Plus className=\"h-4 w-4 mr-2\" />\n                        Add Contact\n                      </Button>\n                    </div>\n\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                      {externalContacts.map((contact) => (\n                        <Card key={contact.id}>\n                          <CardHeader>\n                            <div className=\"flex items-start justify-between\">\n                              <div>\n                                <CardTitle className=\"text-lg\">\n                                  {contact.firstName} {contact.lastName}\n                                </CardTitle>\n                                <CardDescription>\n                                  {contact.jobTitle}\n                                </CardDescription>\n                                <CardDescription>\n                                  {contact.companyName}\n                                </CardDescription>\n                              </div>\n                              <div className=\"flex gap-2\">\n                                <Button\n                                  size=\"sm\"\n                                  variant=\"outline\"\n                                  onClick={() => {\n                                    setEditingContact(contact);\n                                    setContactForm({\n                                      email: contact.email,\n                                      firstName: contact.firstName || \"\",\n                                      lastName: contact.lastName || \"\",\n                                      jobTitle: contact.jobTitle || \"\",\n                                      companyName: contact.companyName || \"\",\n                                      phone: contact.phone || \"\",\n                                      linkedInUrl: contact.linkedInUrl || \"\",\n                                      location: contact.location || \"\",\n                                      notes: contact.notes || \"\",\n                                    });\n                                    setShowContactDialog(true);\n                                  }}\n                                >\n                                  <Edit className=\"h-4 w-4\" />\n                                </Button>\n                                <Button\n                                  size=\"sm\"\n                                  variant=\"outline\"\n                                  onClick={() =>\n                                    handleDeleteContact(contact.id)\n                                  }\n                                >\n                                  <Trash2 className=\"h-4 w-4\" />\n                                </Button>\n                              </div>\n                            </div>\n                          </CardHeader>\n                          <CardContent>\n                            <div className=\"space-y-2 text-sm\">\n                              <p className=\"text-muted-foreground\">\n                                {contact.email}\n                              </p>\n                              {contact.phone && (\n                                <p className=\"text-muted-foreground\">\n                                  {contact.phone}\n                                </p>\n                              )}\n                              {contact.location && (\n                                <p className=\"text-muted-foreground\">\n                                  {contact.location}\n                                </p>\n                              )}\n                              {contact.linkedInUrl && (\n                                <a\n                                  href={contact.linkedInUrl}\n                                  target=\"_blank\"\n                                  rel=\"noopener noreferrer\"\n                                  className=\"text-blue-600 hover:underline flex items-center gap-1\"\n                                >\n                                  LinkedIn <ExternalLink className=\"h-3 w-3\" />\n                                </a>\n                              )}\n                            </div>\n                          </CardContent>\n                        </Card>\n                      ))}\n                    </div>\n\n                    {externalContacts.length === 0 && (\n                      <div className=\"text-center py-12\">\n                        <Users className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                        <h3 className=\"text-lg font-medium mb-2\">\n                          No contacts yet\n                        </h3>\n                        <p className=\"text-muted-foreground mb-4\">\n                          Add external contacts to manage your outreach\n                        </p>\n                        <Button onClick={() => setShowContactDialog(true)}>\n                          <Plus className=\"h-4 w-4 mr-2\" />\n                          Add Contact\n                        </Button>\n                      </div>\n                    )}\n                  </TabsContent>\n                </Tabs>\n              </>\n            )}\n          </div>\n        </div>\n        <Footer />\n      </div>\n\n      {/* Email Template Dialog */}\n      <Dialog open={showTemplateDialog} onOpenChange={setShowTemplateDialog}>\n        <DialogContent className=\"max-w-2xl\">\n          <DialogHeader>\n            <DialogTitle>\n              {editingTemplate\n                ? \"Edit Email Template\"\n                : \"Create Email Template\"}\n            </DialogTitle>\n            <DialogDescription>\n              Create reusable email templates for your outreach campaigns\n            </DialogDescription>\n          </DialogHeader>\n\n          <div className=\"space-y-4\">\n            <div>\n              <Label htmlFor=\"template-name\">Template Name</Label>\n              <Input\n                id=\"template-name\"\n                value={templateForm.name}\n                onChange={(e) =>\n                  setTemplateForm({ ...templateForm, name: e.target.value })\n                }\n                placeholder=\"e.g., Job Application Follow-up\"\n              />\n            </div>\n\n            <div>\n              <Label htmlFor=\"template-description\">Description</Label>\n              <Input\n                id=\"template-description\"\n                value={templateForm.description}\n                onChange={(e) =>\n                  setTemplateForm({\n                    ...templateForm,\n                    description: e.target.value,\n                  })\n                }\n                placeholder=\"Brief description of when to use this template\"\n              />\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-4\">\n              <div>\n                <Label htmlFor=\"template-category\">Category</Label>\n                <Select\n                  value={templateForm.category.toString()}\n                  onValueChange={(value) =>\n                    setTemplateForm({\n                      ...templateForm,\n                      category: parseInt(value) as EmailTemplateCategory,\n                    })\n                  }\n                >\n                  <SelectTrigger>\n                    <SelectValue />\n                  </SelectTrigger>\n                  <SelectContent>\n                    {Object.entries(EmailTemplateCategory)\n                      .filter(([key]) => isNaN(Number(key)))\n                      .map(([key, value]) => (\n                        <SelectItem key={value} value={value.toString()}>\n                          {key}\n                        </SelectItem>\n                      ))}\n                  </SelectContent>\n                </Select>\n              </div>\n\n              <div>\n                <Label htmlFor=\"template-target-role\">Target Role</Label>\n                <Select\n                  value={templateForm.targetRole.toString()}\n                  onValueChange={(value) =>\n                    setTemplateForm({\n                      ...templateForm,\n                      targetRole: parseInt(value) as EmailTemplateTargetRole,\n                    })\n                  }\n                >\n                  <SelectTrigger>\n                    <SelectValue />\n                  </SelectTrigger>\n                  <SelectContent>\n                    {Object.entries(EmailTemplateTargetRole)\n                      .filter(([key]) => isNaN(Number(key)))\n                      .map(([key, value]) => (\n                 