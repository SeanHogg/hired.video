ons((prev) => [notification, ...prev].slice(0, 50)); // Keep only last 50 notifications\n    },\n    [],\n  );\n\n  // Handle user status updates\n  const handleUserStatusUpdate: UserStatusHandler = useCallback(\n    (statusUpdate: UserStatusUpdate) => {\n      setUserStatuses((prev) => {\n        const newMap = new Map(prev);\n        newMap.set(statusUpdate.userId, statusUpdate);\n        return newMap;\n      });\n    },\n    [],\n  );\n\n  // Handle connection state changes\n  const handleConnectionStateChange: ConnectionStateHandler = useCallback(\n    (state: HubConnectionState) => {\n      setConnectionState(state);\n      setIsConnected(state === HubConnectionState.Connected);\n    },\n    [],\n  );\n\n  // Connect to SignalR\n  const connect = useCallback(async () => {\n    if (!isAuthenticated || !user) {\n      console.log(\"Cannot connect to SignalR: user not authenticated\");\n      return;\n    }\n\n    try {\n      await signalRService.start();\n      console.log(\"SignalR connected successfully\");\n    } catch (error) {\n      console.error(\"Failed to connect to SignalR:\", error);\n    }\n  }, [isAuthenticated, user]);\n\n  // Disconnect from SignalR\n  const disconnect = useCallback(async () => {\n    try {\n      await signalRService.stop();\n      console.log(\"SignalR disconnected successfully\");\n    } catch (error) {\n      console.error(\"Failed to disconnect from SignalR:\", error);\n    }\n  }, []);\n\n  // Join a group\n  const joinGroup = useCallback(async (groupName: string) => {\n    await signalRService.joinGroup(groupName);\n  }, []);\n\n  // Leave a group\n  const leaveGroup = useCallback(async (groupName: string) => {\n    await signalRService.leaveGroup(groupName);\n  }, []);\n\n  // Update user status\n  const updateStatus = useCallback(\n    async (status: \"online\" | \"away\" | \"busy\" | \"offline\") => {\n      await signalRService.updateStatus(status);\n    },\n    [],\n  );\n\n  // Mark notification as read\n  const markNotificationAsRead = useCallback((notificationId: string) => {\n    setNotifications((prev) =>\n      prev.map((notification) =>\n        notification.id === notificationId\n          ? { ...notification, isRead: true }\n          : notification,\n      ),\n    );\n  }, []);\n\n  // Clear all notifications\n  const clearNotifications = useCallback(() => {\n    setNotifications([]);\n  }, []);\n\n  // Set up event handlers and auto-connect when authenticated\n  useEffect(() => {\n    if (!isAuthenticated || !user) {\n      disconnect();\n      return;\n    }\n\n    // Register event handlers\n    const unsubscribeNotification =\n      signalRService.onNotification(handleNotification);\n    const unsubscribeUserStatus = signalRService.onUserStatusChange(\n      handleUserStatusUpdate,\n    );\n    const unsubscribeConnectionState = signalRService.onConnectionStateChange(\n      handleConnectionStateChange,\n    );\n\n    // Auto-connect when authenticated\n    connect();\n\n    // Set initial connection state\n    setConnectionState(signalRService.connectionState);\n    setIsConnected(signalRService.isConnected);\n\n    // Cleanup function\n    return () => {\n      unsubscribeNotification();\n      unsubscribeUserStatus();\n      unsubscribeConnectionState();\n    };\n  }, [\n    isAuthenticated,\n    user,\n    connect,\n    disconnect,\n    handleNotification,\n    handleUserStatusUpdate,\n    handleConnectionStateChange,\n  ]);\n\n  // Auto-disconnect when user logs out\n  useEffect(() => {\n    if (!isAuthenticated) {\n      disconnect();\n      setNotifications([]);\n      setUserStatuses(new Map());\n    }\n  }, [isAuthenticated, disconnect]);\n\n  // Update status to online when connected\n  useEffect(() => {\n    if (isConnected && isAuthenticated) {\n      updateStatus(\"online\");\n    }\n  }, [isConnected, isAuthenticated, updateStatus]);\n\n  // Handle page visibility changes\n  useEffect(() => {\n    const handleVisibilityChange = () => {\n      if (isConnected && isAuthenticated) {\n        const status = document.hidden ? \"away\" : \"online\";\n        updateStatus(status);\n      }\n    };\n\n    document.addEventListener(\"visibilitychange\", handleVisibilityChange);\n\n    return () => {\n      document.removeEventListener(\"visibilitychange\", handleVisibilityChange);\n    };\n  }, [isConnected, isAuthenticated, updateStatus]);\n\n  // Handle pagehide instead of beforeunload to preserve BFCache\n  useEffect(() => {\n    const handlePageHide = () => {\n      if (isConnected && isAuthenticated) {\n        updateStatus(\"offline\");\n      }\n    };\n\n    window.addEventListener(\"pagehide\", handlePageHide);\n\n    return () => {\n      window.removeEventListener(\"pagehide\", handlePageHide);\n    };\n  }, [isConnected, isAuthenticated, updateStatus]);\n\n  return {\n    isConnected,\n    connectionState,\n    notifications,\n    userStatuses,\n    connect,\n    disconnect,\n    joinGroup,\n    leaveGroup,\n    updateStatus,\n    markNotificationAsRead,\n    clearNotifications,\n  };\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\hooks\\use-toast.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\hooks\\useOptimisticResumes.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":121,"column":80,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":121,"endColumn":83,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4356,4359],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4356,4359],"text":"never"},"desc":"Use `never` instead, this is useful w