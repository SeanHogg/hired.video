v className=\"space-y-6\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h2 className=\"text-xl font-semibold flex items-center gap-2\">\n            <Building2 className=\"h-5 w-5\" />\n            Company Information\n          </h2>\n          <p className=\"text-sm text-muted-foreground mt-1\">\n            Optional: Add company details to create a more personalized value\n            proposition\n          </p>\n        </div>\n        <Button variant=\"outline\" onClick={onBack} disabled={isLoading}>\n          <ArrowLeft className=\"h-4 w-4 mr-2\" />\n          Back\n        </Button>\n      </div>\n\n      <Alert>\n        <Building2 className=\"h-4 w-4\" />\n        <AlertDescription>\n          Adding company information helps create a more targeted and compelling\n          value proposition. You can skip this step if you don't have this\n          information available.\n        </AlertDescription>\n      </Alert>\n\n      <Card>\n        <CardHeader>\n          <CardTitle className=\"text-lg\">Company Details</CardTitle>\n        </CardHeader>\n        <CardContent className=\"space-y-4\">\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"companyName\">Company Name</Label>\n            <Input\n              id=\"companyName\"\n              placeholder=\"e.g., Acme Corporation\"\n              value={companyName}\n              onChange={(e) => setCompanyName(e.target.value)}\n              disabled={isLoading}\n            />\n            <p className=\"text-xs text-muted-foreground\">\n              The name of the company you're applying to\n            </p>\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"companyMission\">Company Mission (Optional)</Label>\n            <Textarea\n              id=\"companyMission\"\n              placeholder=\"e.g., To revolutionize the way people work by providing innovative solutions that enhance productivity and collaboration...\"\n              value={companyMission}\n              onChange={(e) => setCompanyMission(e.target.value)}\n              disabled={isLoading}\n              rows={3}\n            />\n            <p className=\"text-xs text-muted-foreground\">\n              The company's mission statement or purpose\n            </p>\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"companyValues\">Company Values (Optional)</Label>\n            <Textarea\n              id=\"companyValues\"\n              placeholder=\"e.g., Innovation, Integrity, Customer Focus, Teamwork, Excellence...\"\n              value={companyValues}\n              onChange={(e) => setCompanyValues(e.target.value)}\n              disabled={isLoading}\n              rows={3}\n            />\n            <p className=\"text-xs text-muted-foreground\">\n              The company's core values or principles\n            </p>\n          </div>\n        </CardContent>\n      </Card>\n\n      <div className=\"flex gap-3 justify-end\">\n        <Button variant=\"outline\" onClick={handleSkip} disabled={isLoading}>\n          Skip This Step\n        </Button>\n        <Button\n          onClick={handleSubmit}\n          disabled={isLoading}\n          className=\"min-w-[140px]\"\n        >\n          {isLoading ? (\n            <>\n              <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" />\n              Generating...\n            </>\n          ) : (\n            \"Generate Value Proposition\"\n          )}\n        </Button>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\tools\\JobInputStep.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'JobSummary' is defined but never used. Allowed unused vars must match /^_/u.","line":24,"column":27,"nodeType":null,"messageId":"unusedVar","endLine":24,"endColumn":37},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":87,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":87,"endColumn":20,"suggestions":[{"fix":{"range":[2524,2578],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":149,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":149,"endColumn":20,"suggestions":[{"fix":{"range":[4155,4205],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":282,"column":47,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[8828,9076],"text":"\n                      If the job posting doesn&apos;t load properly in the preview,\n                      click \"Extract Job Details\" to automatically extract the\n                      content, or use the copy/paste method instead.\n                    "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[8828,9076],"text":"\n                      If the job posting doesn&lsquo;t load properly in the preview,\n                      click \"Extract Job Details\" to automatically extract the\n                      content, or use the copy/paste method instead.\n                    "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[8828,9076],"text":"\n                      If the job posting doesn&#39;t load properly in the preview,\n                      click \"Extract Job Details\" to automatically extract the\n                      content, or use the copy/paste method instead.\n                    "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[8828,9076],"text":"\n                      If the job posting doesn&rsquo;t load properly in the preview,\n                      click \"Extract Job Details\" to automatically extract the\n                      content, or use the copy/paste method instead.\n                    "},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":283,"column":29,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[8828,9076],"text":"\n                      If the job posting doesn't load properly in the preview,\n                      click &quot;Extract Job Details\" to automatically extract the\n                      content, or use the copy/paste method instead.\n                    "},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[8828,9076],"text":"\n                      If the job posting doesn't load properly in the preview,\n                      click &ldquo;Extract Job Details\" to automatically extract the\n                      content, or use the copy/paste method instead.\n                    "},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[8828,9076],"text":"\n                      If the job posting doesn't load properly in the preview,\n                      click &#34;Extract Job Details\" to automatically extract the\n                      content, or use the copy/paste method instead.\n                    "},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[8828,9076],"text":"\n                      If the job posting doesn't load properly in the preview,\n                      click &rdquo;Extract Job Details\" to automatically extract the\n                      content, or use the copy/paste method instead.\n                    "},"desc":"Replace with `&rdquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":283,"column":49,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[8828,9076],"text":"\n                      If the job posting doesn't load properly in the preview,\n                      click \"Extract Job Details&quot; to automatically extract the\n                      content, or use the copy/paste method instead.\n                    "},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[8828,9076],"text":"\n                      If the job posting doesn't load properly in the preview,\n                      click \"Extract Job Details&ldquo; to automatically extract the\n                      content, or use the copy/paste method instead.\n                    "},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[8828,9076],"text":"\n                      If the job posting doesn't load properly in the preview,\n                      click \"Extract Job Details&#34; to automatically extract the\n                      content, or use the copy/paste method instead.\n                    "},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[8828,9076],"text":"\n                      If the job posting doesn't load properly in the preview,\n                      click \"Extract Job Details&rdquo; to automatically extract the\n                      content, or use the copy/paste method instead.\n                    "},"desc":"Replace with `&rdquo;`."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useCallback, useMemo } from \"react\";\nimport {\n  Upload,\n  Link as LinkIcon,\n  FileText,\n  X,\n  AlertTriangle,\n  Loader2,\n} from \"lucide-react\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { jobService, type JobSummary } from \"@/lib/services/job-service\";\nimport { useAuth } from \"@/lib/auth\";\nimport { useQuery } from \"@tanstack/react-query\";\n\ninterface JobInputStepProps {\n  onJobSelected: (jobData: {\n    jobId?: string;\n    jobContent?: string;\n    source: \"url\" | \"paste\" | \"file\" | \"existing\";\n  }) => void;\n  isLoading?: boolean;\n  error?: string | null;\n}\n\nexport default function JobInputStep({\n  onJobSelected,\n  isLoading = false,\n  error,\n}: JobInputStepProps) {\n  const { isAuthenticated } = useAuth();\n\n  // State for different input methods\n  const [jobUrl, setJobUrl] = useState(\"\");\n  const [jobContent, setJobContent] = useState(\"\");\n  const [selectedJobId, setSelectedJobId] = useState(\"\");\n  const [file, setFile] = useState<File | null>(null);\n  const [isDragging, setIsDragging] = useState(false);\n  const [isLoadingUrl, setIsLoadingUrl] = useState(false);\n  const [urlError, setUrlError] = useState<string | null>(null);\n  const [showIframe, setShowIframe] = useState(false);\n\n  // Fetch user's jobs if authenticated\n  const { data: userJobs = [] } = useQuery({\n    queryKey: [\"user-jobs\"],\n    queryFn: () => jobService.getUserJobs(),\n    enabled: isAuthenticated,\n  });\n\n  const allowedTypes = useMemo(\n    () => [\n      \"application/pdf\",\n      \"application/msword\",\n      \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\",\n      \"text/plain\",\n    ],\n    [],\n  );\n\n  // URL handling\n  const handleUrlLoad = async () => {\n    if (!jobUrl.trim()) return;\n\n    setIsLoadingUrl(true);\n    setUrlError(null);\n\n    try {\n      // Try to extract job from URL\n      const job = await jobService.extractJobFromUrl(jobUrl);\n      onJobSelected({\n        jobContent: job.description || JSON.stringify(job),\n        source: \"url\",\n      });\n    } catch (err) {\n      console.error(\"Failed to extract job from URL:\", err);\n      setUrlError(\n        \"Could not extract job content from URL. Please try copy/paste method instead.\",\n      );\n    } finally {\n      setIsLoadingUrl(false);\n    }\n  };\n\n  const handlePreviewUrl = () => {\n    if (!jobUrl.trim()) return;\n    setShowIframe(true);\n    setUrlError(null);\n  };\n\n  const handleUseIframeContent = () => {\n    // For iframe content, we'll still use the URL extraction API\n    // since we can't directly access iframe content due to CORS\n    handleUrlLoad();\n  };\n\n  // File handling\n  const handleDragOver = useCallback((e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragging(true);\n  }, []);\n\n  const handleDragLeave = useCallback((e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragging(false);\n  }, []);\n\n  const handleDrop = useCallback(\n    (e: React.DragEvent) => {\n      e.preventDefault();\n      setIsDragging(false);\n\n      const droppedFile = e.dataTransfer.files[0];\n      if (droppedFile && allowedTypes.includes(droppedFile.type)) {\n        setFile(droppedFile);\n      }\n    },\n    [allowedTypes],\n  );\n\n  const handleFileSelect = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const selectedFile = e.target.files?.[0];\n    if (selectedFile && allowedTypes.includes(selectedFile.type)) {\n      setFile(selectedFile);\n    }\n  };\n\n  const handleFileUpload = async () => {\n    if (!file) return;\n\n    try {\n      const job = await jobService.createJobFromFile(file);\n      onJobSelected({\n        jobContent: job.description || JSON.stringify(job),\n        source: \"file\",\n      });\n    } catch (err) {\n      console.error(\"Failed to process job file:\", err);\n    }\n  };\n\n  // Content handling\n  const handleContentSubmit = () => {\n    if (!jobContent.trim()) return;\n\n    onJobSelected({\n      jobContent: jobContent.trim(),\n      source: \"paste\",\n    });\n  };\n\n  // Existing job handling\n  const handleExistingJobSelect = () => {\n    if (!selectedJobId) return;\n\n    onJobSelected({\n      jobId: selectedJobId,\n      source: \"existing\",\n    });\n  };\n\n  const removeFile = () => {\n    setFile(null);\n  };\n\n  const getFileIcon = (file: File) => {\n    if (file.type.includes(\"pdf\")) return \"≡ƒôä\";\n    if (file.type.includes(\"word\")) return \"≡ƒô¥\";\n    if (file.type.includes(\"text\")) return \"≡ƒôä\";\n    return \"≡ƒôä\";\n  };\n\n  return (\n    <Card>\n      <CardHeader>\n        <CardTitle className=\"flex items-center gap-2\">\n          <FileText className=\"h-5 w-5\" />\n          Step 1: Select Job\n        </CardTitle>\n      </CardHeader>\n      <CardContent>\n        <Tabs defaultValue=\"url\" className=\"w-full\">\n          <TabsList className=\"grid w-full grid-cols-4\">\n            <TabsTrigger value=\"url\">Job URL</TabsTrigger>\n            <TabsTrigger value=\"paste\">Copy & Paste</TabsTrigger>\n            <TabsTrigger value=\"upload\">Upload File</TabsTrigger>\n            <TabsTrigger value=\"existing\" disabled={!isAuthenticated}>\n              My Jobs {!isAuthenticated && \"(Login Required)\"}\n            </TabsTrigger>\n          </TabsList>\n\n          {/* URL Tab */}\n          <TabsContent value=\"url\" className=\"space-y-4\">\n            <div className=\"space-y-4\">\n              <div>\n                <Label htmlFor=\"job-url\">Job Posting URL</Label>\n                <div className=\"flex gap-2\">\n                  <Input\n                    id=\"job-url\"\n                    type=\"url\"\n                    placeholder=\"https://example.com/job-posting\"\n                    value={jobUrl}\n                    onChange={(e) => {\n                      setJobUrl(e.target.value);\n                      setShowIframe(false);\n                    }}\n                    disabled={isLoading || isLoadingUrl}\n                  />\n                  <Button\n                    onClick={handlePreviewUrl}\n                    disabled={!jobUrl.trim() || isLoading || isLoadingUrl}\n                    variant=\"outline\"\n                  >\n                    Preview\n                  </Button>\n                  <Button\n                    onClick={handleUrlLoad}\n                    disabled={!jobUrl.trim() || isLoading || isLoadingUrl}\n                  >\n                    {isLoadingUrl ? (\n                      <Loader2 className=\"h-4 w-4 animate-spin\" />\n                    ) : (\n                      <LinkIcon className=\"h-4 w-4\" />\n                    )}\n                  </Button>\n                </div>\n                <p className=\"text-sm text-muted-foreground mt-1\">\n                  Enter a job posting URL. Use Preview to see the page, then\n                  Extract to analyze.\n                </p>\n              </div>\n\n              {/* Iframe Preview */}\n              {showIframe && jobUrl && (\n                <div className=\"space-y-4\">\n                  <div className=\"border rounded-lg overflow-hidden\">\n                    <div className=\"bg-muted p-3 flex items-center justify-between\">\n                      <span className=\"text-sm font-medium\">\n                        Job Posting Preview\n                      </span>\n                      <div className=\"flex gap-2\">\n                        <Button\n                          size=\"sm\"\n                          onClick={handleUseIframeContent}\n                          disabled={isLoading || isLoadingUrl}\n                        >\n                          {isLoadingUrl ? (\n                            <Loader2 className=\"h-3 w-3 animate-spin mr-1\" />\n                          ) : null}\n                          Extract Job Details\n                        </Button>\n                        <Button\n                          size=\"sm\"\n                          variant=\"outline\"\n                          onClick={() => setShowIframe(false)}\n                        >\n                          <X className=\"h-3 w-3\" />\n                        </Button>\n                      </div>\n                    </div>\n                    <iframe\n                      src={jobUrl}\n                      className=\"w-full h-96 border-0\"\n                      title=\"Job Posting Preview\"\n                      sandbox=\"allow-same-origin allow-scripts\"\n                    />\n                  </div>\n                  <Alert>\n                    <AlertTriangle className=\"h-4 w-4\" />\n                    <AlertDescription>\n                      If the job posting doesn't load properly in the preview,\n                      click \"Extract Job Details\" to automatically extract the\n                      content, or use the copy/paste method instead.\n                    </AlertDescription>\n                  </Alert>\n                </div>\n              )}\n\n              {urlError && (\n                <Alert variant=\"destructive\">\n                  <AlertTriangle className=\"h-4 w-4\" />\n                  <AlertDescription>{urlError}</AlertDescription>\n                </Alert>\n              )}\n            </div>\n          </TabsContent>\n\n          {/* Copy & Paste Tab */}\n          <TabsContent value=\"paste\" className=\"space-y-4\">\n            <div className=\"space-y-4\">\n              <div>\n                <Label htmlFor=\"job-content\">Job Description</Label>\n                <Textarea\n                  id=\"job-content\"\n                  placeholder=\"Paste the job description here...\"\n                  value={jobContent}\n                  onChange={(e) => setJobContent(e.target.value)}\n                  rows={8}\n                  disabled={isLoading}\n                />\n                <p className=\"text-sm text-muted-foreground mt-1\">\n                  Copy and paste the complete job description from the job\n                  posting\n                </p>\n              </div>\n              <Button\n                onClick={handleContentSubmit}\n                disabled={!jobContent.trim() || isLoading}\n                className=\"w-full\"\n              >\n                Use This Job Description\n              </Button>\n            </div>\n          </TabsContent>\n\n          {/* File Upload Tab */}\n          <TabsContent value=\"upload\" className=\"space-y-4\">\n            {!file ? (\n              <div\n                className={`border-2 border-dashed rounded-lg p-8 text-center transition-colors ${\n                  isDragging\n                    ? \"border-primary bg-primary/5\"\n                    : \"border-border hover:border-primary/50\"\n                }`}\n                onDragOver={handleDragOver}\n                onDragLeave={handleDragLeave}\n                onDrop={handleDrop}\n              >\n                <Upload className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                <p className=\"text-lg font-medium mb-2\">\n                  Drop job description file here, or click to browse\n                </p>\n                <p className=\"text-sm text-muted-foreground mb-4\">\n                  Supports PDF, Word (.doc, .docx), and text files\n                </p>\n                <Input\n                  type=\"file\"\n                  accept=\".pdf,.doc,.docx,.txt\"\n                  onChange={handleFileSelect}\n                  className=\"hidden\"\n                  id=\"job-file-upload\"\n                  disabled={isLoading}\n                />\n                <Button variant=\"outline\" asChild>\n                  <label htmlFor=\"job-file-upload\" className=\"cursor-pointer\">\n                    Choose File\n                  </label>\n                </Button>\n              </div>\n            ) : (\n              <div className=\"space-y-4\">\n                <div className=\"border rounded-lg p-4 bg-muted/30\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-3\">\n                      <span className=\"text-2xl\">{getFileIcon(file)}</span>\n                      <div>\n                        <p className=\"font-medium\">{file.name}</p>\n                        <p className=\"text-sm text-muted-foreground\">\n                          {(file.size / 1024 / 1024).toFixed(2)} MB\n                        </p>\n                      </div>\n                    </div>\n                    <Button\n                      variant=\"ghost\"\n                      size=\"sm\"\n                      onClick={removeFile}\n                      disabled={isLoading}\n                    >\n                      <X className=\"h-4 w-4\" />\n                    </Button>\n                  </div>\n                </div>\n                <Button\n                  onClick={handleFileUpload}\n                  disabled={isLoading}\n                  className=\"w-full\"\n                >\n                  {isLoading ? (\n                    <>\n                      <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n                      Processing...\n                    </>\n                  ) : (\n                    <>\n                      <Upload className=\"mr-2 h-4 w-4\" />\n                      Use This Job File\n                    </>\n                  )}\n                </Button>\n              </div>\n            )}\n          </TabsContent>\n\n          {/* Existing Jobs Tab */}\n          <TabsContent value=\"existing\" className=\"space-y-4\">\n            {isAuthenticated ? (\n              <div className=\"space-y-4\">\n                <div>\n                  <Label htmlFor=\"job-select\">Select Job</Label>\n                  <Select\n                    value={selectedJobId}\n                    onValueChange={setSelectedJobId}\n                  >\n                    <SelectTrigger>\n                      <SelectValue placeholder=\"Choose a job from your saved jobs\" />\n                    </SelectTrigger>\n                    <SelectContent>\n                      {userJobs.map((job) => (\n                        <SelectItem key={job.id} value={job.id || \"\"}>\n                          <div className=\"flex items-center gap-2\">\n                            <FileText className=\"h-4 w-4\" />\n                            {job.title || \"Untitled Job\"} - {job.company}\n                          </div>\n                        </SelectItem>\n                      ))}\n                    </SelectContent>\n                  </Select>\n                </div>\n                <Button\n                  onClick={handleExistingJobSelect}\n                  disabled={!selectedJobId || isLoading}\n                  className=\"w-full\"\n                >\n                  {isLoading ? (\n                    <>\n                      <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n                      Loading...\n                    </>\n                  ) : (\n                    <>\n                      <FileText className=\"mr-2 h-4 w-4\" />\n                      Use Selected Job\n                    </>\n                  )}\n                </Button>\n              </div>\n            ) : (\n              <div className=\"text-center py-8\">\n                <p className=\"text-muted-foreground mb-4\">\n                  Please log in to select from your saved jobs\n                </p>\n              </div>\n            )}\n          </TabsContent>\n        </Tabs>\n\n        {/* Error Display */}\n        {error && (\n          <Alert variant=\"destructive\" className=\"mt-4\">\n            <AlertTriangle className=\"h-4 w-4\" />\n            <AlertDescription>{error}</AlertDescription>\n          </Alert>\n        )}\n      </CardContent>\n    </Card>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\tools\\MarkdownDisplay.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\tools\\MatchResultsStep.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\tools\\ResumeSelectionStep.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Resume' is defined but never used. Allowed unused vars must match /^_/u.","line":24,"column":30,"nodeType":null,"messageId":"unusedVar","endLine":24,"endColumn":36},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":115,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":115,"endColumn":20,"suggestions":[{"fix":{"range":[3244,3297],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useCallback, useMemo } from \"react\";\nimport {\n  Upload,\n  FileText,\n  X,\n  AlertTriangle,\n  Loader2,\n  User,\n} from \"lucide-react\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { resumeService, type Resume } from \"@/lib/services/resume-service\";\nimport { useAuth } from \"@/lib/auth\";\nimport { useQuery } from \"@tanstack/react-query\";\n\ninterface ResumeSelectionStepProps {\n  onResumeSelected: (resumeData: {\n    resumeId?: string;\n    resumeContent?: string;\n    source: \"existing\" | \"paste\" | \"file\";\n  }) => void;\n  isLoading?: boolean;\n  error?: string | null;\n}\n\nexport default function ResumeSelectionStep({\n  onResumeSelected,\n  isLoading = false,\n  error,\n}: ResumeSelectionStepProps) {\n  const { isAuthenticated } = useAuth();\n\n  // State for different input methods\n  const [resumeContent, setResumeContent] = useState(\"\");\n  const [selectedResumeId, setSelectedResumeId] = useState(\"\");\n  const [file, setFile] = useState<File | null>(null);\n  const [isDragging, setIsDragging] = useState(false);\n\n  // Fetch user's resumes if authenticated\n  const { data: resumes = [] } = useQuery({\n    queryKey: [\"resumes\"],\n    queryFn: () => resumeService.getUserResumes(),\n    enabled: isAuthenticated,\n  });\n\n  const allowedTypes = useMemo(\n    () => [\n      \"application/pdf\",\n      \"application/msword\",\n      \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\",\n      \"text/plain\",\n    ],\n    [],\n  );\n\n  // File handling\n  const handleDragOver = useCallback((e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragging(true);\n  }, []);\n\n  const handleDragLeave = useCallback((e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragging(false);\n  }, []);\n\n  const handleDrop = useCallback(\n    (e: React.DragEvent) => {\n      e.preventDefault();\n      setIsDragging(false);\n\n      const droppedFile = e.dataTransfer.files[0];\n      if (droppedFile && allowedTypes.includes(droppedFile.type)) {\n        setFile(droppedFile);\n      }\n    },\n    [allowedTypes],\n  );\n\n  const handleFileSelect = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const selectedFile = e.target.files?.[0];\n    if (selectedFile && allowedTypes.includes(selectedFile.type)) {\n      setFile(selectedFile);\n    }\n  };\n\n  const handleFileUpload = async () => {\n    if (!file) return;\n\n    try {\n      // For now, we'll need to extract text content from the file\n      // This would typically involve a file processing service\n      const reader = new FileReader();\n      reader.onload = (e) => {\n        const content = e.target?.result as string;\n        onResumeSelected({\n          resumeContent: content,\n          source: \"file\",\n        });\n      };\n      reader.readAsText(file);\n    } catch (err) {\n      console.error(\"Failed to process resume file:\", err);\n    }\n  };\n\n  // Content handling\n  const handleContentSubmit = () => {\n    if (!resumeContent.trim()) return;\n\n    onResumeSelected({\n      resumeContent: resumeContent.trim(),\n      source: \"paste\",\n    });\n  };\n\n  // Existing resume handling\n  const handleExistingResumeSelect = () => {\n    if (!selectedResumeId) return;\n\n    onResumeSelected({\n      resumeId: selectedResumeId,\n      source: \"existing\",\n    });\n  };\n\n  const removeFile = () => {\n    setFile(null);\n  };\n\n  const getFileIcon = (file: File) => {\n    if (file.type.includes(\"pdf\")) return \"≡ƒôä\";\n    if (file.type.includes(\"word\")) return \"≡ƒô¥\";\n    if (file.type.includes(\"text\")) return \"≡ƒôä\";\n    return \"≡ƒôä\";\n  };\n\n  return (\n    <Card>\n      <CardHeader>\n        <CardTitle className=\"flex items-center gap-2\">\n          <User className=\"h-5 w-5\" />\n          Step 2: Select Resume\n        </CardTitle>\n      </CardHeader>\n      <CardContent>\n        <Tabs\n          defaultValue={isAuthenticated ? \"existing\" : \"paste\"}\n          className=\"w-full\"\n        >\n          <TabsList className=\"grid w-full grid-cols-3\">\n            <TabsTrigger value=\"existing\" disabled={!isAuthenticated}>\n              My Resumes {!isAuthenticated && \"(Login Required)\"}\n            </TabsTrigger>\n            <TabsTrigger value=\"paste\">Copy & Paste</TabsTrigger>\n            <TabsTrigger value=\"upload\">Upload File</TabsTrigger>\n          </TabsList>\n\n          {/* Existing Resumes Tab */}\n          <TabsContent value=\"existing\" className=\"space-y-4\">\n            {isAuthenticated ? (\n              <div className=\"space-y-4\">\n                <div>\n                  <Label htmlFor=\"resume-select\">Select Resume</Label>\n                  <Select\n                    value={selectedResumeId}\n                    onValueChange={setSelectedResumeId}\n                  >\n                    <SelectTrigger>\n                      <SelectValue placeholder=\"Choose a resume to analyze\" />\n                    </SelectTrigger>\n                    <SelectContent>\n                      {resumes.map((resume) => (\n                        <SelectItem key={resume.id} value={resume.id || \"\"}>\n                          <div className=\"flex items-center gap-2\">\n                            <FileText className=\"h-4 w-4\" />\n                            <div className=\"flex flex-col\">\n                              <span>{resume.name || \"Untitled Resume\"}</span>\n                              {resume.description && (\n                                <span className=\"text-xs text-muted-foreground\">\n                                  {resume.description}\n                                </span>\n                              )}\n                            </div>\n                          </div>\n                        </SelectItem>\n                      ))}\n                    </SelectContent>\n                  </Select>\n                  {resumes.length === 0 && (\n                    <p className=\"text-sm text-muted-foreground mt-1\">\n                      No resumes found. Create a resume first or use the other\n                      options.\n                    </p>\n                  )}\n                </div>\n                <Button\n                  onClick={handleExistingResumeSelect}\n                  disabled={!selectedResumeId || isLoading}\n                  className=\"w-full\"\n                >\n                  {isLoading ? (\n                    <>\n                      <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n                      Loading...\n                    </>\n                  ) : (\n                    <>\n                      <FileText className=\"mr-2 h-4 w-4\" />\n                      Use Selected Resume\n                    </>\n                  )}\n                </Button>\n              </div>\n            ) : (\n              <div className=\"text-center py-8\">\n                <p className=\"text-muted-foreground mb-4\">\n                  Please log in to select from your saved resumes\n                </p>\n              </div>\n            )}\n          </TabsContent>\n\n          {/* Copy & Paste Tab */}\n          <TabsContent value=\"paste\" className=\"space-y-4\">\n            <div className=\"space-y-4\">\n              <div>\n                <Label htmlFor=\"resume-content\">Resume Content</Label>\n                <Textarea\n                  id=\"resume-content\"\n                  placeholder=\"Paste your resume content here...\"\n                  value={resumeContent}\n                  onChange={(e) => setResumeContent(e.target.value)}\n                  rows={10}\n                  disabled={isLoading}\n                />\n                <p className=\"text-sm text-muted-foreground mt-1\">\n                  Copy and paste your complete resume content (text format works\n                  best)\n                </p>\n              </div>\n              <Button\n                onClick={handleContentSubmit}\n                disabled={!resumeContent.trim() || isLoading}\n                className=\"w-full\"\n              >\n                Use This Resume Content\n              </Button>\n            </div>\n          </TabsContent>\n\n          {/* File Upload Tab */}\n          <TabsContent value=\"upload\" className=\"space-y-4\">\n            {!file ? (\n              <div\n                className={`border-2 border-dashed rounded-lg p-8 text-center transition-colors ${\n                  isDragging\n                    ? \"border-primary bg-primary/5\"\n                    : \"border-border hover:border-primary/50\"\n                }`}\n                onDragOver={handleDragOver}\n                onDragLeave={handleDragLeave}\n                onDrop={handleDrop}\n              >\n                <Upload className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                <p className=\"text-lg font-medium mb-2\">\n                  Drop your resume here, or click to browse\n                </p>\n                <p className=\"text-sm text-muted-foreground mb-4\">\n                  Supports PDF, Word (.doc, .docx), and text files\n                </p>\n                <Input\n                  type=\"file\"\n                  accept=\".pdf,.doc,.docx,.txt\"\n                  onChange={handleFileSelect}\n                  className=\"hidden\"\n                  id=\"resume-file-upload\"\n                  disabled={isLoading}\n                />\n                <Button variant=\"outline\" asChild>\n                  <label\n                    htmlFor=\"resume-file-upload\"\n                    className=\"cursor-pointer\"\n                  >\n                    Choose File\n                  </label>\n                </Button>\n              </div>\n            ) : (\n              <div className=\"space-y-4\">\n                <div className=\"border rounded-lg p-4 bg-muted/30\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-3\">\n                      <span className=\"text-2xl\">{getFileIcon(file)}</span>\n                      <div>\n                        <p className=\"font-medium\">{file.name}</p>\n                        <p className=\"text-sm text-muted-foreground\">\n                          {(file.size / 1024 / 1024).toFixed(2)} MB\n                        </p>\n                      </div>\n                    </div>\n                    <Button\n                      variant=\"ghost\"\n                      size=\"sm\"\n                      onClick={removeFile}\n                      disabled={isLoading}\n                    >\n                      <X className=\"h-4 w-4\" />\n                    </Button>\n                  </div>\n                </div>\n                <Button\n                  onClick={handleFileUpload}\n                  disabled={isLoading}\n                  className=\"w-full\"\n                >\n                  {isLoading ? (\n                    <>\n                      <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n                      Processing...\n                    </>\n                  ) : (\n                    <>\n                      <Upload className=\"mr-2 h-4 w-4\" />\n                      Use This Resume File\n                    </>\n                  )}\n                </Button>\n              </div>\n            )}\n          </TabsContent>\n        </Tabs>\n\n        {/* Error Display */}\n        {error && (\n          <Alert variant=\"destructive\" className=\"mt-4\">\n            <AlertTriangle className=\"h-4 w-4\" />\n            <AlertDescription>{error}</AlertDescription>\n          </Alert>\n        )}\n      </CardContent>\n    </Card>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\tools\\SentimentRecommendations.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\tools\\SentimentScoreDisplay.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'SentimentInterpretation' is defined but never used. Allowed unused vars must match /^_/u.","line":7,"column":8,"nodeType":null,"messageId":"unusedVar","endLine":7,"endColumn":31}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { CheckCircle2, AlertTriangle, XCircle, TrendingUp } from \"lucide-react\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Progress } from \"@/components/ui/progress\";\nimport { Badge } from \"@/components/ui/badge\";\nimport {\n  sentimentService,\n  type SentimentInterpretation,\n} from \"@/lib/services/sentiment-service\";\n\ninterface SentimentScoreDisplayProps {\n  score: number;\n  className?: string;\n}\n\nexport default function SentimentScoreDisplay({\n  score,\n  className = \"\",\n}: SentimentScoreDisplayProps) {\n  const interpretation = sentimentService.interpretSentiment(score);\n\n  const getIcon = () => {\n    switch (interpretation.color) {\n      case \"red\":\n        return <XCircle className=\"h-6 w-6 text-red-600\" />;\n      case \"yellow\":\n        return <AlertTriangle className=\"h-6 w-6 text-yellow-600\" />;\n      case \"green\":\n        return <CheckCircle2 className=\"h-6 w-6 text-green-600\" />;\n      default:\n        return <TrendingUp className=\"h-6 w-6 text-gray-600\" />;\n    }\n  };\n\n  const getBadgeVariant = () => {\n    switch (interpretation.color) {\n      case \"red\":\n        return \"destructive\";\n      case \"yellow\":\n        return \"secondary\";\n      case \"green\":\n        return \"default\";\n      default:\n        return \"outline\";\n    }\n  };\n\n  return (\n    <Card className={`${className}`}>\n      <CardHeader className=\"pb-3\">\n        <CardTitle className=\"flex items-center gap-2 text-lg\">\n          {getIcon()}\n          Sentiment Analysis Results\n        </CardTitle>\n      </CardHeader>\n      <CardContent className=\"space-y-4\">\n        {/* Score Display */}\n        <div className=\"text-center space-y-2\">\n          <div className=\"text-4xl font-bold text-primary\">\n            {score.toFixed(1)}\n            <span className=\"text-lg text-muted-foreground\">/100</span>\n          </div>\n          <Badge variant={getBadgeVariant()} className=\"text-sm\">\n            {interpretation.label} Sentiment\n          </Badge>\n        </div>\n\n        {/* Progress Bar */}\n        <div className=\"space-y-2\">\n          <div className=\"flex justify-between text-sm text-muted-foreground\">\n            <span>Negative</span>\n            <span>Neutral</span>\n            <span>Positive</span>\n          </div>\n          <div className=\"relative\">\n            <Progress value={score} className=\"h-3\" />\n            <div\n              className={`absolute top-0 left-0 h-3 rounded-full transition-all duration-500 ${sentimentService.getProgressBarColor(score)}`}\n              style={{ width: `${score}%` }}\n            />\n          </div>\n          <div className=\"flex justify-between text-xs text-muted-foreground\">\n            <span>0</span>\n            <span>30</span>\n            <span>60</span>\n            <span>100</span>\n          </div>\n        </div>\n\n        {/* Interpretation */}\n        <div\n          className={`p-4 rounded-lg border ${sentimentService.getScoreColorClass(score)}`}\n        >\n          <p className=\"text-sm font-medium mb-2\">Analysis</p>\n          <p className=\"text-sm\">{interpretation.description}</p>\n        </div>\n      </CardContent>\n    </Card>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\tools\\ValuePropositionResultsStep.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'_err' is defined but never used.","line":43,"column":14,"nodeType":null,"messageId":"unusedVar","endLine":43,"endColumn":18}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  ArrowLeft,\n  RefreshCw,\n  Copy,\n  Download,\n  CheckCircle2,\n  Star,\n  Target,\n  TrendingUp,\n} from \"lucide-react\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Progress } from \"@/components/ui/progress\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport MarkdownDisplay from \"./MarkdownDisplay\";\nimport type { ValuePropositionResponse } from \"@/lib/services/value-proposition-service\";\n\ninterface ValuePropositionResultsStepProps {\n  valuePropositionResult: ValuePropositionResponse;\n  onStartOver: () => void;\n  onBack: () => void;\n  isLoading?: boolean;\n}\n\nexport default function ValuePropositionResultsStep({\n  valuePropositionResult,\n  onStartOver,\n  onBack,\n  isLoading = false,\n}: ValuePropositionResultsStepProps) {\n  const { toast } = useToast();\n\n  const handleCopyToClipboard = async () => {\n    try {\n      await navigator.clipboard.writeText(\n        valuePropositionResult.valueProposition,\n      );\n      toast({\n        title: \"Copied to clipboard\",\n        description: \"Value proposition has been copied to your clipboard.\",\n      });\n    } catch (_err) {\n      toast({\n        title: \"Failed to copy\",\n        description: \"Please select and copy the text manually.\",\n        variant: \"destructive\",\n      });\n    }\n  };\n\n  const handleDownload = () => {\n    const element = document.createElement(\"a\");\n    const file = new Blob([valuePropositionResult.valueProposition], {\n      type: \"text/plain\",\n    });\n    element.href = URL.createObjectURL(file);\n    element.download = \"value-proposition.txt\";\n    document.body.appendChild(element);\n    element.click();\n    document.body.removeChild(element);\n  };\n\n  const getScoreColor = (score: number) => {\n    if (score >= 80) return \"text-green-600\";\n    if (score >= 60) return \"text-yellow-600\";\n    return \"text-red-600\";\n  };\n\n  const getScoreBadgeVariant = (score: number) => {\n    if (score >= 80) return \"default\";\n    if (score >= 60) return \"secondary\";\n    return \"destructive\";\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h2 className=\"text-xl font-semibold flex items-center gap-2\">\n            <CheckCircle2 className=\"h-5 w-5 text-green-600\" />\n            Your Value Proposition\n          </h2>\n          <p className=\"text-sm text-muted-foreground mt-1\">\n            AI-generated value proposition tailored to your background and the\n            role\n          </p>\n        </div>\n        <div className=\"flex gap-2\">\n          <Button variant=\"outline\" onClick={onBack} disabled={isLoading}>\n            <ArrowLeft className=\"h-4 w-4 mr-2\" />\n            Back\n          </Button>\n          <Button variant=\"outline\" onClick={onStartOver} disabled={isLoading}>\n            <RefreshCw className=\"h-4 w-4 mr-2\" />\n            Start Over\n          </Button>\n        </div>\n      </div>\n\n      {/* Confidence Score */}\n      <Card>\n        <CardHeader>\n          <CardTitle className=\"flex items-center justify-between\">\n            <span className=\"flex items-center gap-2\">\n              <Target className=\"h-5 w-5\" />\n              Confidence Score\n            </span>\n            <Badge\n              variant={getScoreBadgeVariant(\n                valuePropositionResult.confidenceScore,\n              )}\n            >\n              {valuePropositionResult.confidenceScore}/100\n            </Badge>\n          </CardTitle>\n        </CardHeader>\n        <CardContent>\n          <div className=\"space-y-3\">\n            <Progress\n              value={valuePropositionResult.confidenceScore}\n              className=\"h-2\"\n            />\n            <p\n              className={`text-sm font-medium ${getScoreColor(valuePropositionResult.confidenceScore)}`}\n            >\n              {valuePropositionResult.confidenceScore >= 80 &&\n                \"Excellent alignment with the role requirements\"}\n              {valuePropositionResult.confidenceScore >= 60 &&\n                valuePropositionResult.confidenceScore < 80 &&\n                \"Good alignment with some areas for improvement\"}\n              {valuePropositionResult.confidenceScore < 60 &&\n                \"Moderate alignment - consider highlighting additional relevant experience\"}\n            </p>\n          </div>\n        </CardContent>\n      </Card>\n\n      {/* Executive Summary */}\n      <Card>\n        <CardHeader>\n          <CardTitle className=\"flex items-center gap-2\">\n            <Star className=\"h-5 w-5\" />\n            Executive Summary\n          </CardTitle>\n        </CardHeader>\n        <CardContent>\n          <p className=\"text-sm leading-relaxed\">\n            {valuePropositionResult.executiveSummary}\n          </p>\n        </CardContent>\n      </Card>\n\n      {/* Key Insights */}\n      <div className=\"grid md:grid-cols-2 gap-6\">\n        {/* Key Strengths */}\n        <Card>\n          <CardHeader>\n            <CardTitle className=\"flex items-center gap-2 text-lg\">\n              <TrendingUp className=\"h-5 w-5\" />\n              Key Strengths\n            </CardTitle>\n          </CardHeader>\n          <CardContent>\n            <ul className=\"space-y-2\">\n              {valuePropositionResult.keyStrengths.map((strength, index) => (\n                <li key={index} className=\"flex items-start gap-2 text-sm\">\n                  <CheckCircle2 className=\"h-4 w-4 text-green-600 mt-0.5 flex-shrink-0\" />\n                  <span>{strength}</span>\n                </li>\n              ))}\n            </ul>\n          </CardContent>\n        </Card>\n\n        {/* Alignment Points */}\n        <Card>\n          <CardHeader>\n            <CardTitle className=\"flex items-center gap-2 text-lg\">\n              <Target className=\"h-5 w-5\" />\n              Alignment Points\n            </CardTitle>\n          </CardHeader>\n          <CardContent>\n            <ul className=\"space-y-2\">\n              {valuePropositionResult.alignmentPoints.map((point, index) => (\n                <li key={index} className=\"flex items-start gap-2 text-sm\">\n                  <CheckCircle2 className=\"h-4 w-4 text-blue-600 mt-0.5 flex-shrink-0\" />\n                  <span>{point}</span>\n                </li>\n              ))}\n            </ul>\n          </CardContent>\n        </Card>\n      </div>\n\n      {/* Full Value Proposition */}\n      <Card>\n        <CardHeader>\n          <div className=\"flex items-center justify-between\">\n            <CardTitle>Complete Value Proposition Letter</CardTitle>\n            <div className=\"flex gap-2\">\n              <Button\n                variant=\"outline\"\n                size=\"sm\"\n                onClick={handleCopyToClipboard}\n              >\n                <Copy className=\"h-4 w-4 mr-2\" />\n                Copy\n              </Button>\n              <Button variant=\"outline\" size=\"sm\" onClick={handleDownload}>\n                <Download className=\"h-4 w-4 mr-2\" />\n                Download\n              </Button>\n            </div>\n          </div>\n        </CardHeader>\n        <CardContent>\n          <div className=\"bg-muted/50 p-4 rounded-lg\">\n            <MarkdownDisplay\n              content={valuePropositionResult.valueProposition}\n            />\n          </div>\n        </CardContent>\n      </Card>\n\n      {/* Call to Action */}\n      {valuePropositionResult.callToAction && (\n        <Card>\n          <CardHeader>\n            <CardTitle className=\"flex items-center gap-2\">\n              <CheckCircle2 className=\"h-5 w-5\" />\n              Recommended Next Steps\n            </CardTitle>\n          </CardHeader>\n          <CardContent>\n            <p className=\"text-sm leading-relaxed\">\n              {valuePropositionResult.callToAction}\n            </p>\n          </CardContent>\n        </Card>\n      )}\n\n      {/* Action Buttons */}\n      <div className=\"flex gap-3 justify-center pt-4\">\n        <Button onClick={onStartOver} variant=\"outline\">\n          <RefreshCw className=\"h-4 w-4 mr-2\" />\n          Generate Another\n        </Button>\n        <Button onClick={handleCopyToClipboard}>\n          <Copy className=\"h-4 w-4 mr-2\" />\n          Copy Value Proposition\n        </Button>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\ui\\BaseCard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\ui\\CardActions.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":50,"column":22,"nodeType":"MemberExpression","messageId":"unexpected","endLine":50,"endColumn":33},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":55,"column":22,"nodeType":"MemberExpression","messageId":"unexpected","endLine":55,"endColumn":33}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import * as React from \"react\";\nimport { Button } from \"@/components/ui/button\";\nimport { cn } from \"@/lib/utils\";\n\ninterface CardAction {\n  label: string;\n  variant?:\n    | \"default\"\n    | \"destructive\"\n    | \"outline\"\n    | \"secondary\"\n    | \"ghost\"\n    | \"link\";\n  size?: \"default\" | \"sm\" | \"lg\" | \"icon\";\n  icon?: React.ComponentType<{ className?: string }>;\n   \n  onClick: (event: React.MouseEvent) => void;\n  disabled?: boolean;\n  loading?: boolean;\n}\n\ninterface CardActionsProps {\n  actions: CardAction[];\n  className?: string;\n  layout?: \"horizontal\" | \"vertical\" | \"space-between\" | \"center\";\n  gap?: \"sm\" | \"md\" | \"lg\";\n}\n\n/**\n * CardActions - Standardized card footer component for action buttons\n *\n * Provides:\n * - Consistent button layouts and spacing\n * - Multiple layout options (horizontal, vertical, space-between, center)\n * - Icon support for buttons\n * - Loading and disabled states\n * - Event propagation handling (stops card click events)\n */\nexport function CardActions({\n  actions,\n  className = \"\",\n  layout = \"space-between\",\n  gap = \"md\",\n}: CardActionsProps) {\n  // Always show action buttons - if no actions provided, show default actions\n  const defaultActions = [\n    {\n      label: \