":[5882,6003],"text":"\n              No media added yet. Click \"Add Media&quot; to associate links, images, or videos with your resume.\n            "},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[5882,6003],"text":"\n              No media added yet. Click \"Add Media&ldquo; to associate links, images, or videos with your resume.\n            "},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[5882,6003],"text":"\n              No media added yet. Click \"Add Media&#34; to associate links, images, or videos with your resume.\n            "},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[5882,6003],"text":"\n              No media added yet. Click \"Add Media&rdquo; to associate links, images, or videos with your resume.\n            "},"desc":"Replace with `&rdquo;`."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport {\n  Dialog,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n} from \"@/components/ui/dialog\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { ResumeSectionMeta, MetaType, Resume } from \"@/types/resume\";\nimport { resumeService } from \"@/lib/services/resume-service\";\n\ninterface MetadataModalProps {\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n  resumeId: string;\n  initialMetadata?: ResumeSectionMeta[];\n  onSave: (metadata: ResumeSectionMeta[]) => Promise<void>;\n}\n\nexport default function MetadataModal({\n  open,\n  onOpenChange,\n  resumeId,\n  initialMetadata = [],\n  onSave,\n}: MetadataModalProps) {\n  const [metaData, setMetaData] = useState<ResumeSectionMeta[]>(initialMetadata);\n  const [saving, setSaving] = useState(false);\n  const [resume, setResume] = useState<Resume | null>(null);\n  const [loadingResume, setLoadingResume] = useState(false);\n\n  const tryUuid = () => (typeof crypto !== \"undefined\" && 'randomUUID' in crypto ? (crypto).randomUUID() : `${Math.random().toString(16).slice(2)}-${Date.now()}`);\n\n  // Reset metadata when modal opens with new data\n  useEffect(() => {\n    if (open) {\n      setMetaData(initialMetadata);\n    }\n  }, [open, initialMetadata]);\n\n  // Fetch resume data when modal opens\n  useEffect(() => {\n    const fetchResume = async () => {\n      if (open && resumeId && !resume) {\n        setLoadingResume(true);\n        try {\n          const resumeData = await resumeService.getResumeById(resumeId);\n          setResume(resumeData);\n        } catch (error) {\n          console.error(\"Failed to fetch resume data:\", error);\n        } finally {\n          setLoadingResume(false);\n        }\n      }\n    };\n\n    fetchResume();\n  }, [open, resumeId, resume]);\n\n  const addMeta = () => {\n    const newMeta: ResumeSectionMeta = {\n      id: tryUuid(),\n      userId: \"\", // Will be set by the backend\n      referenceId: \"\", // User will select this\n      name: \"\",\n      metaType: MetaType.Hyperlink,\n      url: \"\",\n      description: \"\",\n    };\n    setMetaData(prev => [...prev, newMeta]);\n  };\n\n  const updateMeta = (index: number, field: keyof ResumeSectionMeta, value: string | number) => {\n    setMetaData(prev => prev.map((m, i) => i === index ? { ...m, [field]: value } as ResumeSectionMeta : m));\n  };\n\n  const removeMeta = (index: number) => {\n    setMetaData(prev => prev.filter((_, i) => i !== index));\n  };\n\n  // Generate section options from actual resume data\n  const getSectionOptions = () => {\n    const options: { value: string; label: string; group: string }[] = [];\n\n    if (!resume?.data) {\n      return options;\n    }\n\n    // Basics section\n    if (resume.data.Basics?.Id) {\n      options.push({\n        value: resume.data.Basics.Id,\n        label: `${resume.data.Basics.Name || 'Profile'} (Basics)`,\n        group: 'Profile'\n      });\n    }\n\n    // Work Experience\n    resume.data?.Work?.forEach((work, index) => {\n      if (work.Id) {\n        options.push({\n          value: work.Id,\n          label: `${work.Position || `Work ${index + 1}`} at ${work.Name || 'Company'}`,\n          group: 'Work Experience'\n        });\n      }\n    });\n\n    // Education\n    resume.data?.Education?.forEach((edu, index) => {\n      if (edu.Id) {\n        options.push({\n          value: edu.Id,\n          label: `${edu.StudyType || 'Degree'} at ${edu.Institution || `Education ${index + 1}`}`,\n          group: 'Education'\n        });\n      }\n    });\n\n    // Projects\n    resume.data?.Projects?.forEach((project, index) => {\n      if (project.Id) {\n        options.push({\n          value: project.Id,\n          label: project.Name || `Project ${index + 1}`,\n          group: 'Projects'\n        });\n      }\n    });\n\n    // Skills\n    resume.data?.Skills?.forEach((skill, index) => {\n      if (skill.Id) {\n        options.push({\n          value: skill.Id,\n          label: skill.Name || `Skill ${index + 1}`,\n          group: 'Skills'\n        });\n      }\n    });\n\n    // Volunteer\n    resume.data?.Volunteer?.forEach((volunteer, index) => {\n      if (volunteer.Id) {\n        options.push({\n          value: volunteer.Id,\n          label: `${volunteer.Position || 'Volunteer'} at ${volunteer.Organization || `Organization ${index + 1}`}`,\n          group: 'Volunteer'\n        });\n      }\n    });\n\n    return options;\n  };\n\n  const sectionOptions = getSectionOptions();\n\n  const handleSave = async () => {\n    setSaving(true);\n    try {\n      await onSave(metaData);\n      onOpenChange(false);\n    } catch (error) {\n      console.error(\"Failed to save metadata:\", error);\n      // TODO: Show error toast\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const handleCancel = () => {\n    setMetaData(initialMetadata); // Reset to initial state\n    onOpenChange(false);\n  };\n\n  return (\n    <Dialog open={open} onOpenChange={onOpenChange}>\n      <DialogContent className=\"max-w-4xl max-h-[80vh] overflow-y-auto\">\n        <DialogHeader>\n          <DialogTitle>Manage Resume Media</DialogTitle>\n          <DialogDescription>\n            Add videos, images, and links to enhance your resume sections.\n          </DialogDescription>\n        </DialogHeader>\n\n        <div className=\"space-y-4\">\n          <div className=\"flex justify-between items-center\">\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              size=\"sm\"\n              onClick={addMeta}\n            >\n              Add Media\n            </Button>\n          </div>\n\n          {metaData.length === 0 ? (\n            <p className=\"text-sm text-muted-foreground text-center py-8\">\n              No media added yet. Click \"Add Media\" to associate links, images, or videos with your resume.\n            </p>\n          ) : (\n            <div className=\"space-y-4\">\n              {metaData.map((m, i) => (\n                <div key={m.id} className=\"grid grid-cols-1 md:grid-cols-6 gap-3 border rounded-lg p-4\">\n                  <div className=\"md:col-span-2\">\n                    <Label>Label</Label>\n                    <Input \n                      value={m.name} \n                      onChange={(e) => updateMeta(i, \"name\", e.target.value)} \n                      placeholder=\"e.g., Demo Reel\" \n                    />\n                  </div>\n                  <div className=\"md:col-span-2\">\n                    <Label>URL</Label>\n                    <Input \n                      value={m.url} \n                      onChange={(e) => updateMeta(i, \"url\", e.target.value)} \n                      placeholder=\"https://...\" \n                    />\n                  </div>\n                  <div>\n                    <Label>Type</Label>\n                    <Select value={String(m.metaType)} onValueChange={(val) => updateMeta(i, \"metaType\", Number(val))}>\n                      <SelectTrigger>\n                        <SelectValue />\n                      </SelectTrigger>\n                      <SelectContent>\n                        <SelectItem value={String(MetaType.Hyperlink)}>Link</SelectItem>\n                        <SelectItem value={String(MetaType.Image)}>Image</SelectItem>\n                        <SelectItem value={String(MetaType.YouTube)}>YouTube</SelectItem>\n                        <SelectItem value={String(MetaType.VideoMP4)}>Video (MP4)</SelectItem>\n                        <SelectItem value={String(MetaType.VideoWebM)}>Video (WebM)</SelectItem>\n                      </SelectContent>\n                    </Select>\n                  </div>\n                  <div>\n                    <Label>Section</Label>\n                    <Select value={m.referenceId || \"\"} onValueChange={(val) => updateMeta(i, \"referenceId\", val)}>\n                      <SelectTrigger>\n                        <SelectValue placeholder=\"Choose section\" />\n                      </SelectTrigger>\n                      <SelectContent>\n                        {sectionOptions.length === 0 ? (\n                          <SelectItem value=\"\" disabled>\n                            {loadingResume ? \"Loading sections...\" : \"No sections available\"}\n                          </SelectItem>\n                        ) : (\n                          // Group options by section type\n                          Object.entries(\n                            sectionOptions.reduce((groups, option) => {\n                              if (!groups[option.group]) groups[option.group] = [];\n                              groups[option.group].push(option);\n                              return groups;\n                            }, {} as Record<string, typeof sectionOptions>)\n                          ).map(([group, options]) => (\n                            <div key={group}>\n                              <div className=\"px-2 py-1 text-xs font-semibold text-muted-foreground\">\n                                {group}\n                              </div>\n                              {options.map((option) => (\n                                <SelectItem key={option.value} value={option.value}>\n                                  {option.label}\n                                </SelectItem>\n                              ))}\n                            </div>\n                          ))\n                        )}\n                      </SelectContent>\n                    </Select>\n                  </div>\n                  <div className=\"md:col-span-6\">\n                    <Label>Description</Label>\n                    <Textarea \n                      rows={2} \n                      value={m.description || \"\"} \n                      onChange={(e) => updateMeta(i, \"description\", e.target.value)} \n                      placeholder=\"Optional description for this media item\" \n                    />\n                  </div>\n                  <div className=\"md:col-span-6 flex justify-end\">\n                    <Button \n                      type=\"button\" \n                      variant=\"ghost\" \n                      size=\"sm\" \n                      onClick={() => removeMeta(i)}\n                    >\n                      Remove\n                    </Button>\n                  </div>\n                </div>\n              ))}\n            </div>\n          )}\n        </div>\n\n        <DialogFooter>\n          <Button variant=\"outline\" onClick={handleCancel} disabled={saving}>\n            Cancel\n          </Button>\n          <Button onClick={handleSave} disabled={saving}>\n            {saving ? \"Saving...\" : \"Save Media\"}\n          </Button>\n        </DialogFooter>\n      </DialogContent>\n    </Dialog>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\Navigation.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\NotificationCenter.tsx","messages":[{"ruleId":"jsx-a11y/click-events-have-key-events","severity":1,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":80,"column":5,"nodeType":"JSXOpeningElement","endLine":86,"endColumn":6}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\nimport {\n  Bell,\n  X,\n  CheckCircle,\n  AlertCircle,\n  Info,\n  AlertTriangle,\n  Briefcase,\n} from \"lucide-react\";\nimport { Button } from \"@/components/ui/button\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { ScrollArea } from \"@/components/ui/scroll-area\";\nimport {\n  Popover,\n  PopoverContent,\n  PopoverTrigger,\n} from \"@/components/ui/popover\";\nimport { useSignalR } from \"@/hooks/use-signalr\";\nimport { Notification } from \"@/lib/services/signalr-service\";\nimport { formatDistanceToNow } from \"date-fns\";\n\nconst getNotificationIcon = (type: string) => {\n  switch (type) {\n    case \"success\":\n      return <CheckCircle className=\"h-4 w-4 text-green-500\" />;\n    case \"error\":\n      return <AlertCircle className=\"h-4 w-4 text-red-500\" />;\n    case \"warning\":\n      return <AlertTriangle className=\"h-4 w-4 text-yellow-500\" />;\n    case \"job_application\":\n      return <Briefcase className=\"h-4 w-4 text-blue-500\" />;\n    default:\n      return <Info className=\"h-4 w-4 text-blue-500\" />;\n  }\n};\n\nconst getNotificationBgColor = (type: string, isRead: boolean) => {\n  const opacity = isRead ? \"bg-opacity-50\" : \"bg-opacity-100\";\n\n  switch (type) {\n    case \"success\":\n      return `bg-green-50 ${opacity}`;\n    case \"error\":\n      return `bg-red-50 ${opacity}`;\n    case \"warning\":\n      return `bg-yellow-50 ${opacity}`;\n    case \"job_application\":\n      return `bg-blue-50 ${opacity}`;\n    default:\n      return `bg-gray-50 ${opacity}`;\n  }\n};\n\ninterface NotificationItemProps {\n  notification: Notification;\n  onMarkAsRead: (id: string) => void;\n  onDismiss?: (id: string) => void;\n}\n\nconst NotificationItem: React.FC<NotificationItemProps> = ({\n  notification,\n  onMarkAsRead,\n  onDismiss,\n}) => {\n  const handleClick = () => {\n    if (!notification.isRead) {\n      onMarkAsRead(notification.id);\n    }\n  };\n\n  const handleDismiss = (e: React.MouseEvent) => {\n    e.stopPropagation();\n    if (onDismiss) {\n      onDismiss(notification.id);\n    }\n  };\n\n  return (\n    <div\n      className={`p-3 border-b border-gray-200 cursor-pointer hover:bg-gray-50 transition-colors ${getNotificationBgColor(\n        notification.type,\n        notification.isRead,\n      )}`}\n      onClick={handleClick}\n    >\n      <div className=\"flex items-start space-x-3\">\n        <div className=\"flex-shrink-0 mt-0.5\">\n          {getNotificationIcon(notification.type)}\n        </div>\n        <div className=\"flex-1 min-w-0\">\n          <div className=\"flex items-center justify-between\">\n            <p\n              className={`text-sm font-medium ${notification.isRead ? \"text-gray-600\" : \"text-gray-900\"}`}\n            >\n              {notification.title}\n            </p>\n            <div className=\"flex items-center space-x-2\">\n              {!notification.isRead && (\n                <div className=\"w-2 h-2 bg-blue-500 rounded-full flex-shrink-0\" />\n              )}\n              {onDismiss && (\n                <button\n                  onClick={handleDismiss}\n                  className=\"text-gray-400 hover:text-gray-600 transition-colors\"\n                  aria-label=\"Dismiss notification\"\n                >\n                  <X className=\"w-4 h-4\" />\n                </button>\n              )}\n            </div>\n          </div>\n          <p\n            className={`text-sm ${notification.isRead ? \"text-gray-500\" : \"text-gray-700\"} mt-1`}\n          >\n            {notification.message}\n          </p>\n          <p className=\"text-xs text-gray-400 mt-1\">\n            {formatDistanceToNow(new Date(notification.timestamp), {\n              addSuffix: true,\n            })}\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n};\n\ninterface ConnectionStatusProps {\n  isConnected: boolean;\n}\n\nconst ConnectionStatus: React.FC<ConnectionStatusProps> = ({ isConnected }) => {\n  return (\n    <div className=\"px-3 py-2 border-b border-gray-200 bg-gray-50\">\n      <div className=\"flex items-center space-x-2\">\n        <div\n          className={`w-2 h-2 rounded-full ${isConnected ? \"bg-green-500\" : \"bg-red-500\"}`}\n        />\n        <span className=\"text-xs text-gray-600\">\n          {isConnected ? \"Connected\" : \"Disconnected\"}\n        </span>\n      </div>\n    </div>\n  );\n};\n\nconst NotificationCenter: React.FC = () => {\n  const {\n    notifications,\n    isConnected,\n    markNotificationAsRead,\n    clearNotifications,\n  } = useSignalR();\n\n  const unreadCount = notifications.filter((n) => !n.isRead).length;\n\n  return (\n    <Popover>\n      <PopoverTrigger asChild>\n        <Button variant=\"ghost\" size=\"sm\" className=\"relative\">\n          <Bell className=\"h-5 w-5\" />\n          {unreadCount > 0 && (\n            <Badge\n              variant=\"destructive\"\n              className=\"absolute -top-1 -right-1 h-5 w-5 flex items-center justify-center p-0 text-xs\"\n            >\n              {unreadCount > 99 ? \"99+\" : unreadCount}\n            </Badge>\n          )}\n        </Button>\n      </PopoverTrigger>\n      <PopoverContent className=\"w-80 p-0\" align=\"end\">\n        <div className=\"flex items-center justify-between p-3 border-b border-gray-200\">\n          <h3 className=\"font-semibold text-sm\">Notifications</h3>\n          {notifications.length > 0 && (\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              onClick={clearNotifications}\n              className=\"text-xs\"\n            >\n              Clear all\n            </Button>\n          )}\n        </div>\n\n        <ConnectionStatus isConnected={isConnected} />\n\n        <ScrollArea className=\"h-96\">\n          {notifications.length === 0 ? (\n            <div className=\"p-6 text-center text-gray-500\">\n              <Bell className=\"h-8 w-8 mx-auto mb-2 text-gray-300\" />\n              <p className=\"text-sm\">No notifications yet</p>\n            </div>\n          ) : (\n            <div>\n              {notifications.map((notification) => (\n                <NotificationItem\n                  key={notification.id}\n                  notification={notification}\n                  onMarkAsRead={markNotificationAsRead}\n                />\n              ))}\n            </div>\n          )}\n        </ScrollArea>\n\n        {notifications.length > 0 && (\n          <div className=\"p-3 border-t border-gray-200 bg-gray-50\">\n            <p className=\"text-xs text-gray-500 text-center\">\n              {unreadCount} unread of {notifications.length} total\n            </p>\n          </div>\n        )}\n      </PopoverContent>\n    </Popover>\n  );\n};\n\nexport default NotificationCenter;\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\Pagination.tsx","messages":[{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":168,"column":14,"nodeType":"Identifier","messageId":"namedExport","endLine":168,"endColumn":27}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { ChevronLeft, ChevronRight, MoreHorizontal } from \"lucide-react\";\nimport { useState } from \"react\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\n\n// Import useState at the top of the file\n\nexport interface PaginationProps {\n  currentPage: number;\n  totalItems: number;\n  itemsPerPage: number;\n  onPageChange: (page: number) => void;\n  onItemsPerPageChange?: (itemsPerPage: number) => void;\n  showItemsPerPage?: boolean;\n  itemsPerPageOptions?: number[];\n  showTotalText?: boolean;\n}\n\nexport default function Pagination({\n  currentPage,\n  totalItems,\n  itemsPerPage,\n  onPageChange,\n  onItemsPerPageChange,\n  showItemsPerPage = true,\n  itemsPerPageOptions = [12, 24, 48],\n  showTotalText = true,\n}: PaginationProps) {\n  const totalPages = Math.ceil(totalItems / itemsPerPage);\n  const startItem = (currentPage - 1) * itemsPerPage + 1;\n  const endItem = Math.min(currentPage * itemsPerPage, totalItems);\n\n  // Don't render pagination if there's only one page or no items\n  if (totalPages <= 1) {\n    return null;\n  }\n\n  // Generate page numbers to display\n  const getPageNumbers = () => {\n    const pages: Array<number | string> = [];\n    const maxVisiblePages = 7;\n\n    if (totalPages <= maxVisiblePages) {\n      // Show all pages if total is small\n      for (let i = 1; i <= totalPages; i++) {\n        pages.push(i);\n      }\n    } else {\n      // Show first page\n      pages.push(1);\n\n      if (currentPage > 4) {\n        pages.push(\"...\");\n      }\n\n      // Show pages around current page\n      const start = Math.max(2, currentPage - 1);\n      const end = Math.min(totalPages - 1, currentPage + 1);\n\n      for (let i = start; i <= end; i++) {\n        if (i !== 1 && i !== totalPages) {\n          pages.push(i);\n        }\n      }\n\n      if (currentPage < totalPages - 3) {\n        pages.push(\"...\");\n      }\n\n      // Show last page\n      if (totalPages > 1) {\n        pages.push(totalPages);\n      }\n    }\n\n    return pages;\n  };\n\n  const pageNumbers = getPageNumbers();\n\n  return (\n    <div className=\"flex flex-col sm:flex-row items-center justify-between gap-4 py-4\">\n      {/* Left side - Items per page and total text */}\n      <div className=\"flex items-center gap-4\">\n        {showItemsPerPage && onItemsPerPageChange && (\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-sm text-muted-foreground\">Show</span>\n            <Select\n              value={itemsPerPage.toString()}\n              onValueChange={(value) => onItemsPerPageChange(parseInt(value))}\n            >\n              <SelectTrigger className=\"w-20\">\n                <SelectValue />\n              </SelectTrigger>\n              <SelectContent>\n                {itemsPerPageOptions.map((option) => (\n                  <SelectItem key={option} value={option.toString()}>\n                    {option}\n                  </SelectItem>\n                ))}\n              </SelectContent>\n            </Select>\n            <span className=\"text-sm text-muted-foreground\">per page</span>\n          </div>\n        )}\n\n        {showTotalText && (\n          <p className=\"text-sm text-muted-foreground\">\n            Showing {startItem} to {endItem} of {totalItems} results\n          </p>\n        )}\n      </div>\n\n      {/* Right side - Page navigation */}\n      <div className=\"flex items-center gap-1\">\n        {/* Previous button */}\n        <Button\n          variant=\"outline\"\n          size=\"sm\"\n          onClick={() => onPageChange(currentPage - 1)}\n          disabled={currentPage === 1}\n          className=\"h-8 w-8 p-0\"\n        >\n          <ChevronLeft className=\"h-4 w-4\" />\n        </Button>\n\n        {/* Page numbers */}\n        {pageNumbers.map((page, index) => (\n          <div key={index}>\n            {page === \"...\" ? (\n              <div className=\"flex h-8 w-8 items-center justify-center\">\n                <MoreHorizontal className=\"h-4 w-4 text-muted-foreground\" />\n              </div>\n            ) : (\n              <Button\n                variant={currentPage === page ? \"default\" : \"outline\"}\n                size=\"sm\"\n                onClick={() => onPageChange(page as number)}\n                className=\"h-8 w-8 p-0\"\n              >\n                {page}\n              </Button>\n            )}\n          </div>\n        ))}\n\n        {/* Next button */}\n        <Button\n          variant=\"outline\"\n          size=\"sm\"\n          onClick={() => onPageChange(currentPage + 1)}\n          disabled={currentPage === totalPages}\n          className=\"h-8 w-8 p-0\"\n        >\n          <ChevronRight className=\"h-4 w-4\" />\n        </Button>\n      </div>\n    </div>\n  );\n}\n\nexport const usePagination = (totalItems: number, initialItemsPerPage = 12) => {\n  const [currentPage, setCurrentPage] = useState(1);\n  const [itemsPerPage, setItemsPerPage] = useState(initialItemsPerPage);\n\n  const totalPages = Math.ceil(totalItems / itemsPerPage);\n  const startIndex = (currentPage - 1) * itemsPerPage;\n  const endIndex = startIndex + itemsPerPage;\n\n  // Reset to first page when items per page changes\n  const handleItemsPerPageChange = (newItemsPerPage: number) => {\n    setItemsPerPage(newItemsPerPage);\n    setCurrentPage(1);\n  };\n\n  // Reset to first page when total items changes significantly\n  const handleTotalItemsChange = (newTotalItems: number) => {\n    const newTotalPages = Math.ceil(newTotalItems / itemsPerPage);\n    if (currentPage > newTotalPages && newTotalPages > 0) {\n      setCurrentPage(1);\n    }\n  };\n\n  return {\n    currentPage,\n    itemsPerPage,\n    totalPages,\n    startIndex,\n    endIndex,\n    setCurrentPage,\n    handleItemsPerPageChange,\n    handleTotalItemsChange,\n  };\n};\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\PeopleCard.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":169,"column":17,"nodeType":"MemberExpression","messageId":"unexpected","endLine":169,"endColumn":28,"suggestions":[{"fix":{"range":[4673,4727],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  MapPin,\n  Users,\n  Briefcase,\n  UserCheck,\n  ExternalLink,\n  Bookmark,\n  BookmarkCheck,\n  Calendar,\n  Building2,\n  MessageCircle,\n  UserPlus,\n  Clock,\n  CheckCircle,\n  X,\n  Star,\n} from \"lucide-react\";\nimport { Link } from \"react-router-dom\";\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { CardActions } from \"@/components/ui/CardActions\";\nimport { useAuth } from \"@/lib/auth\";\nimport { formatRoleForDisplay, normalizeRole } from \"@/lib/role-utils\";\nimport { USER_ROLES } from \"@shared/user-roles\";\nimport type {\n  UserMetadata,\n  UserWithOwnership,\n  ConnectionStatus,\n} from \"@/types/people\";\nimport type { DynamicCardAction } from \"@/lib/dynamic-actions\";\nimport type { UserContext, ItemOwnership } from \"@/types/normalized-cards\";\n\ninterface PeopleCardProps {\n  person: UserMetadata | UserWithOwnership;\n  connectionStatus?: ConnectionStatus;\n  showOwnership?: boolean;\n  actions?: DynamicCardAction[];\n  userContext?: UserContext;\n  itemOwnership?: ItemOwnership;\n  onTrack?: (personId: string) => void;\n  onUntrack?: (personId: string) => void;\n  onConnect?: (personId: string) => void;\n  onMessage?: (personId: string) => void;\n  onAcceptConnection?: (personId: string) => void;\n  onRejectConnection?: (personId: string) => void;\n  onView?: () => void;\n  onActions?: () => void;\n}\n\nexport default function PeopleCard({\n  person,\n  connectionStatus = \"none\",\n  showOwnership = false,\n  actions,\n  userContext: _userContext,  \n  itemOwnership: _itemOwnership,  \n  onTrack,\n  onUntrack,\n  onConnect,\n  onMessage,\n  onAcceptConnection,\n  onRejectConnection,\n  onView,\n  onActions,\n}: PeopleCardProps) {\n  const { user } = useAuth();\n\n  // Early return if person is undefined\n  if (!person) {\n    return null;\n  }\n\n  const ownership = \"ownership\" in person ? person.ownership : undefined;\n  const isTracked = ownership === \"tracked\";\n  const isConnected =\n    ownership === \"connected\" || connectionStatus === \"connected\";\n  const isPendingSent = connectionStatus === \"pending_sent\";\n  const isPendingReceived = connectionStatus === \"pending_received\";\n\n  const getStatusColor = (status: string) => {\n    switch (status) {\n      case \"active\":\n        return \"bg-green-100 text-green-800\";\n      case \"looking\":\n        return \"bg-blue-100 text-blue-800\";\n      case \"busy\":\n        return \"bg-yellow-100 text-yellow-800\";\n      case \"inactive\":\n        return \"bg-gray-100 text-gray-800\";\n      default:\n        return \"bg-gray-100 text-gray-800\";\n    }\n  };\n\n  const getRoleIcon = (role: string | number | undefined | null) => {\n    const normalizedRole = normalizeRole(role);\n    switch (normalizedRole) {\n      case USER_ROLES.JOB_SEEKER:\n        return <Users className=\"h-3 w-3\" />;\n      case USER_ROLES.RECRUITER:\n        return <UserCheck className=\"h-3 w-3\" />;\n      case USER_ROLES.EMPLOYER:\n        return <Building2 className=\"h-3 w-3\" />;\n      case USER_ROLES.ADMIN:\n      case USER_ROLES.SUPER_ADMIN:\n        return <Building2 className=\"h-3 w-3\" />;\n      default:\n        return <Users className=\"h-3 w-3\" />;\n    }\n  };\n\n  // Derive safe display name and initials\n  const displayFullName =\n    person.fullName && person.fullName.trim().length > 0\n      ? person.fullName\n      : (person as { name?: string })?.name?.toString()?.trim?.() ||\n        `${person.firstName ?? \"\"} ${person.lastName ?? \"\"}`.trim() ||\n        \"User\";\n  const firstInitial = (\n    person.firstName?.[0] ??\n    displayFullName?.trim()?.[0] ??\n    \"?\"\n  )\n    .toString()\n    .toUpperCase();\n  const lastInitial = (\n    person.lastName?.[0] ??\n    displayFullName?.trim()?.split(\" \").slice(-1)[0]?.[0] ??\n    \"\"\n  )\n    .toString()\n    .toUpperCase();\n\n  // Use passed actions or fallback to default actions\n  const cardActions =\n    actions && actions.length > 0\n      ? actions\n      : [\n          {\n            id: \"view\",\n            label: \"View\",\n            variant: \"outline\" as const,\n            icon: UserCheck,\n            onClick: () => {\n              if (onView) {\n                onView();\n              } else {\n                window.location.href = `/people/${person.slug || person.id}`;\n              }\n            },\n          },\n          {\n            id: \"actions\",\n            label: \"Actions\",\n            variant: \"default\" as const,\n            icon: MessageCircle,\n            onClick: () => {\n              if (onActions) {\n                onActions();\n              } else {\n                console.log(\"Actions clicked for person:\", person.id);\n              }\n            },\n          },\n        ];\n\n  return (\n    <Card className=\"hover:shadow-lg transition-shadow relative\">\n      <CardHeader className=\"pb-3\">\n        <div className=\"flex items-start justify-between\">\n          <div className=\"flex items-start gap-3 flex-1\">\n            {/* Profile Avatar */}\n            <Avatar className=\"w-12 h-12 flex-shrink-0\">\n              <AvatarImage src={person.avatar} alt={displayFullName} />\n              <AvatarFallback className=\"text-sm\">\n                {firstInitial}\n                {lastInitial}\n              </AvatarFallback>\n            </Avatar>\n\n            {/* Person Info */}\n            <div className=\"flex-1 min-w-0\">\n              <div className=\"flex items-center gap-2 mb-1\">\n                <CardTitle className=\"text-lg hover:text-primary truncate\">\n                  <Link to={`/people/${person.slug || person.id}`}>{person.fullName}</Link>\n                </CardTitle>\n                {person.isVerified && (\n                  <CheckCircle className=\"h-4 w-4 text-blue-600 flex-shrink-0\" />\n                )}\n                {person.isPremium && (\n                  <Star className=\"h-4 w-4 text-yellow-500 flex-shrink-0\" />\n                )}\n                {showOwnership && isTracked && (\n                  <Badge\n                    variant=\"outline\"\n                    className=\"text-xs bg-blue-50 text-blue-700 flex-shrink-0\"\n                  >\n                    <UserCheck className=\"h-3 w-3 mr-1\" />\n                    Following\n                  </Badge>\n                )}\n                {isConnected && (\n                  <Badge\n                    variant=\"outline\"\n                    className=\"text-xs bg-green-50 text-green-700 flex-shrink-0\"\n                  >\n                    <Users className=\"h-3 w-3 mr-1\" />\n                    Connected\n                  </Badge>\n                )}\n              </div>\n\n              <CardDescription className=\"text-sm mb-2 line-clamp-2\">\n                {person.headline}\n              </CardDescription>\n\n              <div className=\"flex items-center gap-4 text-xs text-muted-foreground\">\n                <div className=\"flex items-center gap-1\">\n                  {getRoleIcon(person.role)}\n                  <span>{formatRoleForDisplay(person.role)}</span>\n                </div>\n                <div className=\"flex items-center gap-1\">\n                  <MapPin className=\"h-3 w-3\" />\n                  <span>{person.location}</span>\n                </div>\n                {person.currentCompany && (\n                  <div className=\"flex items-center gap-1\">\n                    <Building2 className=\"h-3 w-3\" />\n                    <span className=\"truncate\">{person.currentCompany}</span>\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n\n          {/* Status Badge */}\n          <div className=\"flex flex-col items-end gap-1 flex-shrink-0\">\n            <Badge\n              variant=\"secondary\"\n              className={getStatusColor(person.status)}\n            >\n              {person.status}\n            </Badge>\n            {person.openToWork && (\n              <Badge\n                variant=\"outline\"\n                className=\"text-xs bg-green-50 text-green-700\"\n              >\n                Open to Work\n              </Badge>\n            )}\n          </div>\n        </div>\n      </CardHeader>\n\n      <CardContent>\n        <div className=\"space-y-3\">\n          {/* Current Position */}\n          {person.currentPosition && (\n            <div className=\"flex items-center gap-2 text-sm\">\n              <Briefcase className=\"h-4 w-4 text-muted-foreground flex-shrink-0\" />\n              <span className=\"truncate\">{person.currentPosition}</span>\n            </div>\n          )}\n\n          {/* Company Info (for recruiters/employers) */}\n          {person.companyName && (\n            <div className=\"flex items-center gap-2 text-sm\">\n              <Building2 className=\"h-4 w-4 text-muted-foreground flex-shrink-0\" />\n              <span className=\"truncate\">at {person.companyName}</span>\n            </div>\n          )}\n\n          {/* Stats */}\n          <div className=\"grid grid-cols-3 gap-2 text-xs text-center\">\n            <div>\n              <div className=\"font-medium\">{person.connectionCount}</div>\n              <div className=\"text-muted-foreground\">Connections</div>\n            </div>\n            <div>\n              <div className=\"font-medium\">{person.followerCount}</div>\n              <div className=\"text-muted-foreground\">Followers</div>\n            </div>\n            <div>\n              <div className=\"font-medium\">{person.profileViews}</div>\n              <div className=\"text-muted-foreground\">Views</div>\n            </div>\n          </div>\n\n          {/* Last Active */}\n          <div className=\"flex items-center justify-between text-xs text-muted-foreground pt-2 border-t\">\n            <div className=\"flex items-center gap-1\">\n              <Clock className=\"h-3 w-3\" />\n              Active{\" \"}\n              {person.lastActiveAt &&\n              !isNaN(new Date(person.lastActiveAt).getTime())\n                ? new Date(person.lastActiveAt).toLocaleDateString()\n                : \"Unknown\"}\n            </div>\n            <div className=\"flex items-center gap-1\">\n              <Calendar className=\"h-3 w-3\" />\n              Joined{\" \"}\n              {person.createdAt && !isNaN(new Date(person.createdAt).getTime())\n                ? new Date(person.createdAt).toLocaleDateString()\n                : \"Unknown\"}\n            </div>\n          </div>\n\n          {/* Connection Actions (Secondary Row) */}\n          {user && person.id !== user.id && (\n            <div className=\"flex items-center gap-2 pt-2\">\n              {isPendingReceived ? (\n                <div className=\"flex gap-1 flex-1\">\n                  <Button\n                    size=\"sm\"\n                    className=\"flex-1\"\n                    onClick={() => onAcceptConnection?.(person.id)}\n                  >\n                    <CheckCircle className=\"h-3 w-3 mr-1\" />\n                    Accept\n                  </Button>\n                  <Button\n                    variant=\"outline\"\n                    size=\"sm\"\n                    onClick={() => onRejectConnection?.(person.id)}\n                  >\n                    <X className=\"h-3 w-3\" />\n                  </Button>\n                </div>\n              ) : isPendingSent ? (\n                <Button variant=\"outline\" size=\"sm\" className=\"flex-1\" disabled>\n                  <Clock className=\"h-3 w-3 mr-1\" />\n                  Pending\n                </Button>\n              ) : isConnected ? (\n                <Button\n                  variant=\"outline\"\n                  size=\"sm\"\n                  className=\"flex-1\"\n                  onClick={() => onMessage?.(person.id)}\n                >\n                  <MessageCircle className=\"h-3 w-3 mr-1\" />\n                  Message\n                </Button>\n              ) : (\n                <Button\n                  size=\"sm\"\n                  className=\"flex-1\"\n                  onClick={() => onConnect?.(person.id)}\n                >\n                  <UserPlus className=\"h-3 w-3 mr-1\" />\n                  Connect\n                </Button>\n              )}\n\n              {/* Track/Untrack */}\n              {!isConnected && (\n                <div>\n                  {isTracked ? (\n                    <Button\n                      variant=\"outline\"\n                      size=\"sm\"\n                      onClick={() => onUntrack?.(person.id)}\n                    >\n                      <BookmarkCheck className=\"h-3 w-3\" />\n                    </Button>\n                  ) : (\n                    <Button\n                      variant=\"outline\"\n                      size=\"sm\"\n                      onClick={() => onTrack?.(person.id)}\n                    >\n                      <Bookmark className=\"h-3 w-3\" />\n                    </Button>\n                  )}\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* Own Profile */}\n          {user && person.id === user.id && (\n            <div className=\"flex items-center gap-2 pt-2\">\n              <Button asChild className=\"flex-1\">\n                <Link to=\"/profile\">\n                  Edit Profile\n                  <ExternalLink className=\"h-3 w-3 ml-1\" />\n                </Link>\n              </Button>\n            </div>\n          )}\n        </div>\n      </CardContent>\n\n      <CardActions actions={cardActions} />\n    </Card>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\ResumeBuilder.tsx","messages":[],"suppressedMessages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'ensureIdsForSections'. Either include it or remove the dependency array.","line":93,"column":6,"nodeType":"ArrayExpression","endLine":93,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [ensureIdsForSections]","fix":{"range":[2370,2372],"text":"[ensureIdsForSections]"}}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\ResumeCard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\ResumeTimelines.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\ResumeUpload.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'mapMetaResumeToResumeData' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":122,"column":9,"nodeType":null,"messageId":"unusedVar","endLine":122,"endColumn":34},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":221,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":221,"endColumn":20,"suggestions":[{"fix":{"range":[6657,6701],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Upload, Loader2, X, AlertTriangle } from \"lucide-react\";\nimport { useState, useCallback, useMemo } from \"react\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Checkbox } from \"@/components/ui/checkbox\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Progress } from \"@/components/ui/progress\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { resumeService, type Resume } from \"@/lib/services/resume-service\";\nimport type {\n  ResumePrivacy,\n  UploadResumeRequest,\n  ResumeUploadResponse,\n  ResumeData,\n} from \"@/types/resume\";\n\ninterface ResumeUploadProps {\n  onUploadSuccess: (response: ResumeUploadResponse) => void;\n  onCancel: () => void;\n}\n\n// Helper function to create empty resume data\nconst getEmptyResumeData = (): ResumeData => ({\n  Basics: {\n    Name: \"\",\n    Label: \"\",\n    Image: \"\",\n    Email: \"\",\n    Phone: \"\",\n    Url: \"\",\n    Summary: \"\",\n    Location: null,\n  },\n  Work: [],\n  Volunteer: [],\n  Education: [],\n  Awards: [],\n  Certificates: [],\n  Publications: [],\n  Skills: [],\n  Languages: [],\n  Interests: [],\n  References: [],\n  Projects: [],\n});\n\nexport default function ResumeUpload({\n  onUploadSuccess,\n  onCancel,\n}: ResumeUploadProps) {\n  const [isDragging, setIsDragging] = useState(false);\n  const [file, setFile] = useState<File | null>(null);\n  const [name, setName] = useState(\"\");\n  const [privacy, setPrivacy] = useState<ResumePrivacy>(\"private\");\n  const [isMaster, setIsMaster] = useState(false);\n  const [isUploading, setIsUploading] = useState(false);\n  const [uploadProgress, setUploadProgress] = useState(0);\n  const [error, setError] = useState<string | null>(null);\n\n  const allowedTypes = useMemo(\n    () => [\n      \"application/pdf\",\n      \"application/msword\",\n      \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\",\n      \"text/plain\",\n    ],\n    [],\n  );\n\n  const handleDragOver = useCallback((e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragging(true);\n  }, []);\n\n  const handleDragLeave = useCallback((e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragging(false);\n  }, []);\n\n  const handleDrop = useCallback(\n    (e: React.DragEvent) => {\n      e.preventDefault();\n      setIsDragging(false);\n      setError(null);\n\n      const droppedFile = e.dataTransfer.files[0];\n      if (droppedFile && allowedTypes.includes(droppedFile.type)) {\n        setFile(droppedFile);\n        if (!name) {\n          setName(droppedFile.name.replace(/\\.[^/.]+$/, \"\"));\n        }\n      } else {\n        setError(\"Please upload a PDF, Word document, or text file.\");\n      }\n    },\n    [name, allowedTypes],\n  );\n\n  const handleFileSelect = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const selectedFile = e.target.files?.[0];\n    setError(null);\n\n    if (selectedFile && allowedTypes.includes(selectedFile.type)) {\n      setFile(selectedFile);\n      if (!name) {\n        setName(selectedFile.name.replace(/\\.[^/.]+$/, \"\"));\n      }\n    } else {\n      setError(\"Please upload a PDF, Word document, or text file.\");\n    }\n  };\n\n  // Convert API MetaResume (camelCase) to UI ResumeData (PascalCase keys)\n  const mapMetaResumeToResumeData = (\n    meta: NonNullable<Resume[\"metaResume\"]>,\n  ): ResumeData => {\n    const basics = meta?.basics || {};\n    const location = basics?.location || null;\n    return {\n      Basics: {\n        Name: basics.name || \"\",\n        Label: basics.label || \"\",\n        Image: basics.image || \"\",\n        Email: basics.email || \"\",\n        Phone: basics.phone || \"\",\n        Url: basics.url || \"\",\n        Summary: basics.summary || \"\",\n        Location: location\n          ? {\n              Address: location.address || \"\",\n              PostalCode: location.postalCode || \"\",\n              City: location.city || \"\",\n              CountryCode: location.countryCode || \"\",\n              Region: location.region || \"\",\n            }\n          : null,\n      },\n      Work: (meta?.work || []).map((w) => ({\n        Name: w.name || \"\",\n        Position: w.position || \"\",\n        Summary: w.summary || \"\",\n        StartDate: w.startDate || \"\",\n        EndDate: w.endDate || \"\",\n        Highlights: Array.isArray(w.highlights) ? w.highlights : [],\n        Url: w.url || \"\",\n      })),\n      Volunteer: (meta?.volunteer || []).map((v) => ({\n        Organization: v.organization || \"\",\n        Position: v.position || \"\",\n        Summary: v.summary || \"\",\n        StartDate: v.startDate || \"\",\n        EndDate: v.endDate || \"\",\n        Highlights: Array.isArray(v.highlights) ? v.highlights : null,\n        Url: v.url || \"\",\n      })),\n      Education: (meta?.education || []).map((e) => ({\n        Institution: e.institution || \"\",\n        Area: e.area || \"\",\n        StudyType: e.studyType || \"\",\n        StartDate: e.startDate || \"\",\n        EndDate: e.endDate || \"\",\n        Score: e.score || \"\",\n        Courses: Array.isArray(e.courses) ? e.courses : null,\n        Url: e.url || \"\",\n      })),\n      Awards: [], // Not available in current schema\n      Certificates: [], // Not available in current schema\n      Publications: [], // Not available in current schema\n      Skills: (meta?.skills || []).map((s) => ({\n        Name: s.name || \"\",\n        Level: s.level || \"\",\n        Keywords: Array.isArray(s.keywords) ? s.keywords : [],\n      })),\n      Languages: [], // Not available in current schema\n      Interests: [], // Not available in current schema\n      References: [], // Not available in current schema\n      Projects: [], // Not available in current schema\n\n      Meta: undefined,\n    };\n  };\n\n  const handleUpload = async () => {\n    if (!file || !name.trim()) return;\n\n    setIsUploading(true);\n    setError(null);\n    setUploadProgress(0);\n\n    try {\n      const uploadRequest: UploadResumeRequest = {\n        name: name.trim(),\n        file,\n        privacy,\n        isMaster,\n      };\n\n      // Parse resume file without saving to database\n      const parsed = await resumeService.parseResumeFromFile(uploadRequest.file);\n\n      // Map parsed data to ResumeData for the builder\n      const uploadedData = parsed.data || getEmptyResumeData();\n\n      const response: ResumeUploadResponse = {\n        id: `resume_${Date.now()}`, // Temporary ID for form\n        data: uploadedData,\n        message: uploadRequest.name,\n        confidence: parsed.confidence || 0.8,\n      };\n\n      onUploadSuccess(response);\n    } catch (err) {\n      console.error(\"Resume upload failed:\", err);\n      const errorMessage =\n        err instanceof Error\n          ? err.message\n          : \"Failed to upload resume. Please try again.\";\n      setError(errorMessage);\n    } finally {\n      setIsUploading(false);\n      setUploadProgress(0);\n    }\n  };\n\n  const removeFile = () => {\n    setFile(null);\n    setError(null);\n  };\n\n  const getFileIcon = (file: File) => {\n    if (file.type.includes(\"pdf\")) return \"≡ƒôä\";\n    if (file.type.includes(\"word\")) return \"≡ƒô¥\";\n    return \"≡ƒôä\";\n  };\n\n  return (\n    <Card className=\"w-full max-w-2xl mx-auto\">\n      <CardHeader>\n        <CardTitle className=\"flex items-center gap-2\">\n          <Upload className=\"h-5 w-5\" />\n          Upload Resume\n        </CardTitle>\n      </CardHeader>\n      <CardContent className=\"space-y-6\">\n        {/* File Upload Area */}\n        <div className=\"space-y-4\">\n          <Label>Resume File</Label>\n          {!file ? (\n            <div\n              className={`border-2 border-dashed rounded-lg p-8 text-center transition-colors ${\n                isDragging\n                  ? \"border-primary bg-primary/5\"\n                  : \"border-border hover:border-primary/50\"\n              }`}\n              onDragOver={handleDragOver}\n              onDragLeave={handleDragLeave}\n              onDrop={handleDrop}\n            >\n              <Upload className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n              <p className=\"text-lg font-medium mb-2\">\n                Drop your resume here, or click to browse\n              </p>\n              <p className=\"text-sm text-muted-foreground mb-4\">\n                Supports PDF, Word (.doc, .docx), and text files\n              </p>\n              <Input\n                type=\"file\"\n                accept=\".pdf,.doc,.docx,.txt\"\n                onChange={handleFileSelect}\n                className=\"hidden\"\n                id=\"file-upload\"\n              />\n              <Button variant=\"outline\" asChild>\n                <label htmlFor=\"file-upload\" className=\"cursor-pointer\">\n                  Choose File\n                </label>\n              </Button>\n            </div>\n          ) : (\n            <div className=\"border rounded-lg p-4 bg-muted/30\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-3\">\n                  <span className=\"text-2xl\">{getFileIcon(file)}</span>\n                  <div>\n                    <p className=\"font-medium\">{file.name}</p>\n                    <p className=\"text-sm text-muted-foreground\">\n                      {(file.size / 1024 / 1024).toFixed(2)} MB\n                    </p>\n                  </div>\n                </div>\n                <Button\n                  variant=\"ghost\"\n                  size=\"sm\"\n                  onClick={removeFile}\n                  disabled={isUploading}\n                >\n                  <X className=\"h-4 w-4\" />\n                </Button>\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Resume Settings */}\n        <div className=\"space-y-4\">\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"resume-name\">Resume Name</Label>\n            <Input\n              id=\"resume-name\"\n              value={name}\n              onChange={(e) => setName(e.target.value)}\n              placeholder=\"e.g., Software Engineer Resume\"\n              disabled={isUploading}\n            />\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label>Privacy Setting</Label>\n            <Select\n              value={privacy}\n              onValueChange={(value: ResumePrivacy) => setPrivacy(value)}\n              disabled={isUploading}\n            >\n              <SelectTrigger>\n                <SelectValue />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"private\">\n                  Private - Only visible to you\n                </SelectItem>\n                <SelectItem value=\"recruiter_only\">\n                  Recruiter Only - Visible to verified recruiters\n                </SelectItem>\n                <SelectItem value=\"public\">\n                  Public - Searchable by anyone\n                </SelectItem>\n              </SelectContent>\n            </Select>\n          </div>\n\n          <div className=\"flex items-center space-x-2\">\n            <Checkbox\n              id=\"master-resume\"\n              checked={isMaster}\n              onCheckedChange={(checked) => setIsMaster(checked === true)}\n              disabled={isUploading}\n            />\n            <Label htmlFor=\"master-resume\" className=\"text-sm\">\n              Mark as Master Resume\n            </Label>\n          </div>\n          {isMaster && (\n            <p className=\"text-xs text-muted-foreground ml-6\">\n              Master resumes can be used as templates to create targeted\n              variations.\n            </p>\n          )}\n        </div>\n\n        {/* Upload Progress */}\n        {isUploading && (\n          <div className=\"space-y-2\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-sm font-medium\">Processing resume...</span>\n              <span className=\"text-sm text-muted-foreground\">\n                {uploadProgress}%\n              </span>\n            </div>\n            <Progress value={uploadProgress} className=\"w-full\" />\n          </div>\n        )}\n\n        {/* Error Display */}\n        {error && (\n          <Alert variant=\"destructive\">\n            <AlertTriangle className=\"h-4 w-4\" />\n            <AlertDescription>{error}</AlertDescription>\n          </Alert>\n        )}\n\n        {/* Action Buttons */}\n        <div className=\"flex gap-3\">\n          <Button\n            onClick={handleUpload}\n            disabled={!file || !name.trim() || isUploading}\n            className=\"flex-1\"\n          >\n            {isUploading ? (\n              <>\n                <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n                Processing...\n              </>\n            ) : (\n              <>\n                <Upload className=\"mr-2 h-4 w-4\" />\n                Upload Resume\n              </>\n            )}\n          </Button>\n          <Button variant=\"outline\" onClick={onCancel} disabled={isUploading}>\n            Cancel\n          </Button>\n        </div>\n      </CardContent>\n    </Card>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\ResumeViewer.tsx","messages":[{"ruleId":"no-duplicate-imports","severity":1,"message":"'@/types/resume' import is duplicated.","line":36,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":36,"endColumn":43},{"ruleId":"react-hooks/rules-of-hooks","severity":2,"message":"React Hook \"useMemo\" is called conditionally. React Hooks must be called in the exact same order in every component render. Did you accidentally call a React Hook after an early return?","line":181,"column":26,"nodeType":"Identifier","endLine":181,"endColumn":33},{"ruleId":"react-hooks/rules-of-hooks","severity":2,"message":"React Hook \"useState\" is called conditionally. React Hooks must be called in the exact same order in every component render. Did you accidentally call a React Hook after an early return?","line":186,"column":39,"nodeType":"Identifier","endLine":186,"endColumn":47},{"ruleId":"react-hooks/rules-of-hooks","severity":2,"message":"React Hook \"useEffect\" is called conditionally. React Hooks must be called in the exact same order in every component render. Did you accidentally call a React Hook after an early return?","line":187,"column":3,"nodeType":"Identifier","endLine":187,"endColumn":12},{"ruleId":"react-hooks/rules-of-hooks","severity":2,"message":"React Hook \"useEffect\" is called conditionally. React Hooks must be called in the exact same order in every component render. Did you accidentally call a React Hook after an early return?","line":192,"column":3,"nodeType":"Identifier","endLine":192,"endColumn":12},{"ruleId":"no-empty","severity":2,"message":"Empty block statement.","line":230,"column":13,"nodeType":"BlockStatement","messageId":"unexpected","endLine":230,"endColumn":15,"suggestions":[{"messageId":"suggestComment","data":{"type":"block"},"fix":{"range":[7097,7097],"text":" /* empty */ "},"desc":"Add comment inside empty block statement."}]}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  Eye,\n  Share2,\n  Copy,\n  Star,\n  Users,\n  Lock,\n  Globe,\n  Calendar,\n  Mail,\n  Phone,\n  ExternalLink,\n  CheckCircle2,\n  ChevronLeft,\n  ChevronRight,\n} from \"lucide-react\";\nimport { useEffect, useMemo, useState } from \"react\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent } from \"@/components/ui/card\";\nimport { MetaBadge } from \"./MetaBadge\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport type {\n  Resume,\n  ResumePrivacy,\n  UpdateResumeRequest,\n  ResumeSectionMeta,\n} from \"@/types/resume\";\nimport { MetaType } from \"@/types/resume\";\n\n\n\ninterface ResumeViewerProps {\n  resume: Resume;\n  onUpdate: (_request: UpdateResumeRequest) => void;\n  onCreateVariation?: (_parentId: string) => void;\n  canEdit?: boolean;\n  showToolbar?: boolean; // show internal action toolbar (name, privacy, share, edit)\n  selectedMediaId?: string | null; // ID of media to highlight/scroll to\n}\n\nexport default function ResumeViewer({\n  resume,\n  onUpdate,\n  onCreateVariation,\n  canEdit = true,\n  showToolbar = true,\n  selectedMediaId,\n}: ResumeViewerProps) {\n  const [privacy, setPrivacy] = useState<ResumePrivacy>(resume?.privacy || \"private\");\n  const [showShareAlert, setShowShareAlert] = useState(false);\n\n  // Safety check for resume data\n  if (!resume) {\n    return (\n      <div className=\"max-w-4xl mx-auto p-6 text-center\">\n        <h2 className=\"text-xl font-semibold mb-2\">Resume data not available</h2>\n        <p className=\"text-muted-foreground\">Unable to load resume information.</p>\n      </div>\n    );\n  }\n\n  // Additional safety checks\n  if (!resume.data) {\n    return (\n      <div className=\"max-w-4xl mx-auto p-6 text-center\">\n        <h2 className=\"text-xl font-semibold mb-2\">Resume content not available</h2>\n        <p className=\"text-muted-foreground\">Resume data structure is incomplete.</p>\n      </div>\n    );\n  }\n\n  // Ensure resume.data exists and has required structure\n  const resumeData = resume.data || {\n    Basics: {\n      Name: \"\",\n      Label: \"\",\n      Image: \"\",\n      Email: \"\",\n      Phone: \"\",\n      Url: \"\",\n      Summary: \"\",\n      Location: null\n    },\n    Work: [],\n    Education: [],\n    Skills: [],\n    Volunteer: [],\n    Awards: [],\n    Certificates: [],\n    Publications: [],\n    Languages: [],\n    Interests: [],\n    References: [],\n    Projects: [],\n  };\n\n  const handlePrivacyChange = (newPrivacy: ResumePrivacy) => {\n    setPrivacy(newPrivacy);\n    onUpdate({ privacy: newPrivacy });\n  };\n\n\n\n  const handleShare = () => {\n    const shareUrl = `${window.location.origin}/resumes/${resume.id}`;\n    navigator.clipboard.writeText(shareUrl);\n    setShowShareAlert(true);\n    setTimeout(() => setShowShareAlert(false), 3000);\n  };\n\n  // Date formatting to match ResumeDetail: MMM YYYY, hide when both missing, show end-only if start missing\n  const formatMMMYYYY = (dateString: string): string => {\n    if (!dateString) return \"\";\n    if (dateString === \"Present\") return \"Present\";\n    const d = new Date(dateString);\n    if (isNaN(d.getTime())) return \"\";\n    return d.toLocaleDateString(\"en-US\", { year: \"numeric\", month: \"short\" });\n  };\n\n  const getDateText = (startDate?: string, endDate?: string, treatMissingEndAsPresent = false): string | null => {\n    const start = formatMMMYYYY(startDate || \"\");\n    let end = formatMMMYYYY(endDate || \"\");\n    if (!end && treatMissingEndAsPresent) end = \"Present\";\n\n    if (!start && !end) return null;\n    if (!start && end) return end;\n    if (start && !end) return start;\n    return `${start} - ${end}`;\n  };\n\n  const getPrivacyIcon = (privacy: ResumePrivacy) => {\n    switch (privacy) {\n      case \"public\":\n        return <Globe className=\"h-4 w-4\" />;\n      case \"recruiter_only\":\n        return <Users className=\"h-4 w-4\" />;\n      case \"connections\":\n        return <Users className=\"h-4 w-4\" />;\n      case \"private\":\n        return <Lock className=\"h-4 w-4\" />;\n    }\n  };\n\n  const getPrivacyText = (privacy: ResumePrivacy) => {\n    switch (privacy) {\n      case \"public\":\n        return \"Public\";\n      case \"recruiter_only\":\n        return \"Recruiter Only\";\n      case \"connections\":\n        return \"Connections\";\n      case \"private\":\n        return \"Private\";\n    }\n  };\n\n  const getPrivacyColor = (privacy: ResumePrivacy) => {\n    switch (privacy) {\n      case \"public\":\n        return \"bg-green-100 text-green-800\";\n      case \"recruiter_only\":\n        return \"bg-blue-100 text-blue-800\";\n      case \"connections\":\n        return \"bg-indigo-100 text-indigo-800\";\n      case \"private\":\n        return \"bg-gray-100 text-gray-800\";\n    }\n  };\n\n\n\n  // Featured Video from metadata (match ResumeDetail behavior)\n  const videoMetaItems = useMemo<ResumeSectionMeta[]>(() => {\n    const all = resume?.metaData || [];\n    const videoTypes = new Set([MetaType.YouTube, MetaType.VideoMP4, MetaType.VideoWebM]);\n    return all.filter((m) => videoTypes.has(m.metaType));\n  }, [resume?.metaData]);\n  const [videoIndex, setVideoIndex] = useState<number>(0);\n  useEffect(() => {\n    if (videoIndex >= videoMetaItems.length) setVideoIndex(0);\n  }, [videoMetaItems.length, videoIndex]);\n\n  // Handle selectedMediaId to automatically select the appropriate video and scroll to section\n  useEffect(() => {\n    if (selectedMediaId && resume?.metaData) {\n      // Find the media item\n      const mediaItem = resume.metaData.find(m => m.id === selectedMediaId || m.referenceId === selectedMediaId);\n      if (mediaItem) {\n        // If it's a video, select it in the video carousel\n        if (videoMetaItems.length > 0) {\n          const mediaIndex = videoMetaItems.findIndex(m => m.id === selectedMediaId || m.referenceId === selectedMediaId);\n          if (mediaIndex >= 0) {\n            setVideoIndex(mediaIndex);\n          }\n        }\n\n        // Scroll to the section that contains this media\n        setTimeout(() => {\n          const sectionElement = document.querySelector(`[data-section-id=\"${mediaItem.referenceId}\"]`);\n          if (sectionElement) {\n            sectionElement.scrollIntoView({ behavior: 'smooth', block: 'center' });\n          }\n        }, 100);\n      }\n    }\n  }, [selectedMediaId, resume?.metaData, videoMetaItems]);\n  const currentVideoMeta = videoMetaItems.length > 0 ? videoMetaItems[videoIndex] : null;\n  const youTubeEmbed = (url: string): string => {\n    try {\n      const u = new URL(url);\n      if (u.hostname.includes(\"youtu.be\")) {\n        const id = u.pathname.split(\"/\").filter(Boolean)[0];\n        if (id) return `https://www.youtube.com/embed/${id}`;\n      }\n      if (u.hostname.includes(\"youtube.com\")) {\n        const v = u.searchParams.get(\"v\");\n        if (v) return `https://www.youtube.com/embed/${v}`;\n        const parts = u.pathname.split(\"/\").filter(Boolean);\n        const embedIdx = parts.indexOf(\"embed\");\n        if (embedIdx >= 0 && parts[embedIdx + 1]) return `https://www.youtube.com/embed/${parts[embedIdx + 1]}`;\n      }\n    } catch {}\n    return url;\n  };\n\n  return (\n    <div className=\"max-w-4xl mx-auto space-y-6\">\n      {/* Toolbar (optional) */}\n      {showToolbar && (\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <h1 className=\"text-2xl font-bold\">{resume.name}</h1>\n            {resume.isMaster && (\n              <Badge variant=\"secondary\" className=\"bg-yellow-100 text-yellow-800\">\n                <Star className=\"h-3 w-3 mr-1\" />\n                Master\n              </Badge>\n            )}\n            <Badge className={getPrivacyColor(privacy)}>\n              {getPrivacyIcon(privacy)}\n              <span className=\"ml-1\">{getPrivacyText(privacy)}</span>\n            </Badge>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            {canEdit && (\n              <Select value={privacy} onValueChange={handlePrivacyChange}>\n                <SelectTrigger className=\"w-36\">\n                  <SelectValue />\n                </SelectTrigger>\n                <SelectContent>\n                  <SelectItem value=\"private\">\n                    <div className=\"flex items-center gap-2\">\n                      <Lock className=\"h-4 w-4\" />\n                      Private\n                    </div>\n                  </SelectItem>\n                  <SelectItem value=\"recruiter_only\">\n                    <div className=\"flex items-center gap-2\">\n                      <Users className=\"h-4 w-4\" />\n                      Recruiter Only\n                    </div>\n                  </SelectItem>\n                  <SelectItem value=\"connections\">\n                    <div className=\"flex items-center gap-2\">\n                      <Users className=\"h-4 w-4\" />\n                      Connections\n                    </div>\n                  </SelectItem>\n                  <SelectItem value=\"public\">\n                    <div className=\"flex items-center gap-2\">\n                      <Globe className=\"h-4 w-4\" />\n                      Public\n                    </div>\n                  </SelectItem>\n                </SelectContent>\n              </Select>\n            )}\n\n            <Button variant=\"outline\" onClick={handleShare}>\n              <Share2 className=\"h-4 w-4 mr-2\" />\n              Share\n            </Button>\n\n            {resume.isMaster && onCreateVariation && (\n              <Button onClick={() => onCreateVariation(resume.id)}>\n                <Copy className=\"h-4 w-4 mr-2\" />\n                Create Variation\n              </Button>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* Share Success Alert */}\n      {showShareAlert && (\n        <Alert>\n          <CheckCircle2 className=\"h-4 w-4\" />\n          <AlertDescription>Resume link copied to clipboard!</AlertDescription>\n        </Alert>\n      )}\n\n      {/* Resume Preview */}\n      <Card className=\"overflow-hidden\">\n        <CardContent className=\"p-0\">\n          {/* Header Section */}\n          <div className=\"bg-primary text-primary-foreground p-8\">\n            <div className=\"text-center space-y-4\">\n              <h1 className=\"text-4xl font-bold\">{resumeData.Basics.Name}</h1>\n              <p className=\"text-xl opacity-90\">{resumeData.Basics.Label}</p>\n\n              <div className=\"flex flex-wrap justify-center gap-4 text-sm opacity-80\">\n                {resumeData.Basics.Email && (\n                  <div className=\"flex items-center gap-1\">\n                    <Mail className=\"h-4 w-4\" />\n                    {resumeData.Basics.Email}\n                  </div>\n                )}\n                {resumeData.Basics.Phone && (\n                  <div className=\"flex items-center gap-1\">\n                    <Phone className=\"h-4 w-4\" />\n                    {resumeData.Basics.Phone}\n                  </div>\n                )}\n                {resumeData.Basics.Url && (\n                  <div className=\"flex items-center gap-1\">\n                    <ExternalLink className=\"h-4 w-4\" />\n                    <a\n                      href={resumeData.Basics.Url}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                    >\n                      Portfolio\n                    </a>\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n\n          <div className=\"p-8 space-y-8\">\n            {/* Featured Video */}\n            {currentVideoMeta && (\n              <section>\n                <div className=\"relative\">\n                  <div className=\"aspect-video bg-black rounded-lg relative overflow-hidden\">\n                    {/* Prev */}\n                    {videoMetaItems.length > 1 && (\n                      <button\n                        type=\"button\"\n                        aria-label=\"Previous video\"\n                        className=\"absolute left-2 top-1/2 -translate-y-1/2 z-10 bg-black/40 hover:bg-black/60 text-white rounded-full p-2\"\n                        onClick={() => setVideoIndex((prev) => (prev - 1 + videoMetaItems.length) % videoMetaItems.length)}\n                      >\n                        <ChevronLeft className=\"w-5 h-5\" />\n                      </button>\n                    )}\n\n                    {/* Next */}\n                    {videoMetaItems.length > 1 && (\n                      <button\n                        type=\"button\"\n                        aria-label=\"Next video\"\n                        className=\"absolute right-2 top-1/2 -translate-y-1/2 z-10 bg-black/40 hover:bg-black/60 text-white rounded-full p-2\"\n                        onClick={() => setVideoIndex((prev) => (prev + 1) % videoMetaItems.length)}\n                      >\n                        <ChevronRight className=\"w-5 h-5\" />\n                      </button>\n                    )}\n\n                    {currentVideoMeta.metaType === MetaType.YouTube ? (\n                      <iframe\n                        className=\"absolute inset-0 w-full h-full\"\n                        src={youTubeEmbed(currentVideoMeta.url)}\n                        title={currentVideoMeta.name || \"Video Resume\"}\n                        allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n                        allowFullScreen\n                      />\n                    ) : (\n                      <video className=\"absolute inset-0 w-full h-full\" controls>\n                        <source\n                          src={currentVideoMeta.url}\n                          type={currentVideoMeta.metaType === MetaType.VideoWebM ? \"video/webm\" : \"video/mp4\"}\n                        />\n                        Your browser does not support the video tag.\n                      </video>\n                    )}\n                  </div>\n\n                  {/* Footer pills */}\n                  <div className=\"mt-4 flex flex-col items-center gap-2\">\n                    <div className=\"text-xs opacity-80\">\n                      Video {videoIndex + 1} / {videoMetaItems.length}\n                    </div>\n                    {videoMetaItems.length > 1 && (\n                      <div className=\"flex flex-wrap gap-2 justify-center\">\n                        {videoMetaItems.map((m, idx) => (\n                          <button\n                            key={m.id || `${m.referenceId}-${idx}`}\n                            type=\"button\"\n                            className={`px-2 py-1 rounded text-xs border ${idx === videoIndex ? \"bg-primary text-primary-foreground border-primary\" : \"bg-secondary/30 text-foreground border-border\"}`}\n                            onClick={() => setVideoIndex(idx)}\n                          >\n                            {m.name || `Video ${idx + 1}`}\n                          </button>\n                        ))}\n                      </div>\n                    )}\n                  </div>\n                </div>\n              </section>\n            )}\n\n            {/* Summary */}\n            {resumeData.Basics.Summary && (\n              <section>\n                <h2 className=\"text-2xl font-bold mb-4\">Professional Summary</h2>\n                <p className=\"text-muted-foreground leading-relaxed\">\n                  {resumeData.Basics.Summary}\n                </p>\n              </section>\n            )}\n\n            {/* Basics Metadata */}\n            {resume.metaData && resumeData.Basics.Id && (\n              <section data-section-id={resumeData.Basics.Id}>\n                <div className=\"flex flex-wrap gap-2\">\n                  {resume.metaData\n                    .filter((m) => m.referenceId === resumeData.Basics.Id)\n                    .map((m) => (\n                      <MetaBadge key={m.id} meta={m} />\n                    ))}\n                </div>\n              </section>\n            )}\n\n            {/* Work Experience */}\n            {resumeData.Work.length > 0 && (\n              <section>\n                <h2 className=\"text-2xl font-bold mb-6\">Work Experience</h2>\n                <div className=\"space-y-6\">\n                  {resumeData.Work\n                    .slice()\n                    .sort((a, b) => {\n                      const norm = (s?: string) => (s || '').trim().toLowerCase();\n                      // Current positions (no end date or 'present') come first\n                      const aEnd = norm(a.EndDate);\n                      const bEnd = norm(b.EndDate);\n                      const aIsCurrent = aEnd === '' || aEnd === 'present';\n                      const bIsCurrent = bEnd === '' || bEnd === 'present';\n\n                      if (aIsCurrent && !bIsCurrent) return -1;\n                      if (!aIsCurrent && bIsCurrent) return 1;\n\n                      // For positions with end dates, sort by end date descending (most recent first)\n                      if (!aIsCurrent && !bIsCurrent) {\n                        const aEndDate = new Date(a.EndDate || a.StartDate);\n                        const bEndDate = new Date(b.EndDate || b.StartDate);\n                        if (isNaN(aEndDate.getTime()) || isNaN(bEndDate.getTime())) return 0;\n                        return bEndDate.getTime() - aEndDate.getTime();\n                      }\n\n                      // For current positions, sort by start date descending (most recent first)\n                      const aStartDate = new Date(a.StartDate);\n                      const bStartDate = new Date(b.StartDate);\n                      if (isNaN(aStartDate.getTime()) || isNaN(bStartDate.getTime())) return 0;\n                      return bStartDate.getTime() - aStartDate.getTime();\n                    })\n                    .map((work, index) => (\n                    <div\n                      key={index}\n                      className=\"border-l-2 border-primary/20 pl-6 relative\"\n                      data-section-id={work.Id}\n                    >\n                      <div className=\"absolute w-3 h-3 bg-primary rounded-full -left-2 top-2\" />\n                      <div className=\"space-y-2\">\n                        <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2\">\n                          <h3 className=\"text-lg font-semibold\">\n                            {work.Position}\n                          </h3>\n                          {getDateText(work.StartDate, work.EndDate, true) && (\n                            <div className=\"flex items-center gap-2 text-sm text-muted-foreground\">\n                              <Calendar className=\"h-4 w-4\" />\n                              <span>{getDateText(work.StartDate, work.EndDate, true)}</span>\n                            </div>\n                          )}\n                        </div>\n                        <p className=\"text-primary font-medium\">{work.Name}</p>\n\n\t                    {/* Metadata for Work item */}\n\t                    {resume.metaData && work.Id && (\n\t                      <div className=\"mt-2 flex flex-wrap gap-2\">\n\t                        {resume.metaData\n\t                          .filter(m => m.referenceId === work.Id)\n\t                          .map((m) => (\n\t                            <MetaBadge key={m.id} meta={m} />\n\t                          ))}\n\t                      </div>\n\t                    )}\n\n                        {work.Summary && (\n                          <p className=\"text-muted-foreground\">\n                            {work.Summary}\n                          </p>\n                        )}\n                        {work.Highlights.length > 0 && (\n                          <ul className=\"list-disc list-inside space-y-1 text-sm text-muted-foreground ml-4\">\n                            {work.Highlights.map(\n                              (highlight, highlightIndex) => (\n                                <li key={highlightIndex}>{highlight}</li>\n                              ),\n                            )}\n                          </ul>\n                        )}\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </section>\n            )}\n\n            {/* Education */}\n            {resumeData.Education.length > 0 && (\n              <section>\n                <h2 className=\"text-2xl font-bold mb-6\">Education</h2>\n                <div className=\"space-y-4\">\n                  {resumeData.Education.map((edu, index) => (\n\n\n                    <div key={index} className=\"border rounded-lg p-4\" data-section-id={edu.Id}>\n                      <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2\">\n                        <div>\n                          <h3 className=\"font-semibold\">\n                            {edu.StudyType} in {edu.Area}\n                          </h3>\n                          <p className=\"text-primary\">{edu.Institution}</p>\n                          {edu.Score && (\n                            <p className=\"text-sm text-muted-foreground\">\n                              GPA: {edu.Score}\n                            </p>\n                          )}\n                        </div>\n                        {getDateText(edu.StartDate, edu.EndDate) && (\n                          <div className=\"text-sm text-muted-foreground\">\n                            {getDateText(edu.StartDate, edu.EndDate)}\n                          </div>\n                        )}\n                        {/* Metadata for Education item */}\n                        {resume.metaData && edu.Id && (\n                          <div className=\"mt-2 flex flex-wrap gap-2\">\n                            {resume.metaData\n                              .filter((m) => m.referenceId === edu.Id)\n                              .map((m) => (\n                                <MetaBadge key={m.id} meta={m} />\n                              ))}\n                          </div>\n                        )}\n\n                      </div>\n                    </div>\n\n\n                  ))}\n                </div>\n              </section>\n            )}\n\n              {/* Volunteer Experience */}\n              {resumeData.Volunteer.length > 0 && (\n                <section>\n                  <h2 className=\"text-2xl font-bold mb-6\">Volunteer Experience</h2>\n                  <div className=\"space-y-4\">\n                    {resumeData.Volunteer\n                      .slice()\n                      .sort((a, b) => new Date(b.StartDate).getTime() - new Date(a.StartDate).getTime())\n                      .map((volunteer, index) => (\n                        <div key={index} className=\"border rounded-lg p-4\" data-section-id={volunteer.Id}>\n                          <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2\">\n                            <div>\n                              <h3 className=\"font-semibold\">{volunteer.Position}</h3>\n                              <p className=\"text-primary\">{volunteer.Organization}</p>\n                              {volunteer.Summary && (\n                                <p className=\"text-sm text-muted-foreground\">{volunteer.Summary}</p>\n                              )}\n                            </div>\n                            {getDateText(volunteer.StartDate, volunteer.EndDate, true) && (\n                              <div className=\"text-sm text-muted-foreground\">\n                                {getDateText(volunteer.StartDate, volunteer.EndDate, true)}\n                              </div>\n                            )}\n                          </div>\n\n                          {/* Metadata for Volunteer item */}\n                          {resume.metaData && volunteer.Id && (\n                            <div className=\"mt-2 flex flex-wrap gap-2\">\n                              {resume.metaData\n                                .filter((m) => m.referenceId === volunteer.Id)\n                                .map((m) => (\n                                  <MetaBadge key={m.id} meta={m} />\n                                ))}\n                            </div>\n                          )}\n                        </div>\n                      ))}\n                  </div>\n                </section>\n              )}\n\n\n            {/* Skills */}\n            {resumeData.Skills.length > 0 && (\n              <section>\n                <h2 className=\"text-2xl font-bold mb-6\">Skills</h2>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                  {resumeData.Skills.map((skill, index) => (\n                    <div key={index} className=\"flex flex-col gap-2 p-3 border rounded-lg\" data-section-id={skill.Id}>\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"font-medium\">{skill.Name}</span>\n                        <Badge variant=\"secondary\">{skill.Level}</Badge>\n                      </div>\n                      {skill.Keywords && skill.Keywords.length > 0 && (\n                        <div className=\"flex flex-wrap gap-1 mt-2\">\n                          {skill.Keywords.map((keyword, keywordIndex) => (\n                            <span\n                              key={keywordIndex}\n                              className=\"px-2 py-1 bg-secondary text-secondary-foreground text-xs rounded\"\n                            >\n                              {keyword}\n                            </span>\n                          ))}\n                        </div>\n                      )}\n                      {resume.metaData && skill.Id && (\n                        <div className=\"flex flex-wrap gap-2\">\n                          {resume.metaData\n                            .filter((m) => m.referenceId === skill.Id)\n                            .map((m) => (\n                              <MetaBadge key={m.id} meta={m} />\n                            ))}\n                        </div>\n                      )}\n                    </div>\n                  ))}\n                </div>\n              </section>\n            )}\n          </div>\n        </CardContent>\n      </Card>\n\n\n              {/* Projects */}\n              {resumeData.Projects.length > 0 && (\n                <section>\n                  <h2 className=\"text-2xl font-bold mb-6\">Projects</h2>\n                  <div className=\"space-y-6\">\n                    {resumeData.Projects.map((project, index) => (\n                      <div key={index} className=\"border-b pb-6 last:border-b-0 last:pb-0\" data-section-id={project.Id}>\n                        <div className=\"flex justify-between items-start mb-2\">\n                          <h3 className=\"font-semibold text-lg\">{project.Name}</h3>\n                          {project.Url && (\n                            <a href={project.Url} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-primary hover:underline flex items-center gap-1\">\n                              <ExternalLink className=\"w-4 h-4\" />\n                            </a>\n                          )}\n                        </div>\n                        {(project.StartDate || project.EndDate) && (\n                          <p className=\"text-sm text-muted-foreground mb-2\">\n                            {getDateText(project.StartDate, project.EndDate, true)}\n                          </p>\n                        )}\n                        {project.Entity && (\n                          <p className=\"text-sm text-muted-foreground mb-2\">{project.Entity}</p>\n                        )}\n                        {project.Description && <p className=\"text-sm mb-3\">{project.Description}</p>}\n                        {project.Highlights && project.Highlights.length > 0 && (\n                          <ul className=\"list-disc list-inside text-sm mb-3 space-y-1\">\n                            {project.Highlights.map((highlight, hIndex) => (\n                              <li key={hIndex}>{highlight}</li>\n                            ))}\n                          </ul>\n                        )}\n                        {resume.metaData && project.Id && (\n                          <div className=\"mt-2 flex flex-wrap gap-2\">\n                            {resume.metaData\n                              .filter((m) => m.referenceId === project.Id)\n                              .map((m) => (\n                                <MetaBadge key={m.id} meta={m} />\n                              ))}\n                          </div>\n                        )}\n                      </div>\n                    ))}\n                  </div>\n                </section>\n              )}\n\n              {/* Awards */}\n              {resumeData.Awards.length > 0 && (\n                <section>\n                  <h2 className=\"text-2xl font-bold mb-6\">Awards</h2>\n                  <div className=\"space-y-4\">\n                    {resumeData.Awards.map((award, index) => (\n                      <div key={index} className=\"border rounded-lg p-4\">\n                        <div className=\"flex items-center justify-between\">\n                          <div>\n                            <h3 className=\"font-semibold\">{award.Title}</h3>\n                            <p className=\"text-sm text-muted-foreground\">{award.Awarder}</p>\n                          </div>\n                          {getDateText(award.Date, undefined) && (\n                            <div className=\"text-sm text-muted-foreground\">{getDateText(award.Date, undefined)}</div>\n                          )}\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                </section>\n              )}\n\n              {/* Certificates */}\n              {resumeData.Certificates.length > 0 && (\n                <section>\n                  <h2 className=\"text-2xl font-bold mb-6\">Certificates</h2>\n                  <div className=\"space-y-4\">\n                    {resumeData.Certificates.map((cert, index) => (\n                      <div key={index} className=\"border rounded-lg p-4\">\n                        <div className=\"flex items-center justify-between\">\n                          <div>\n                            <h3 className=\"font-semibold\">{cert.Name}</h3>\n                            <p className=\"text-sm text-muted-foreground\">{cert.Issuer}</p>\n                            {cert.Url && (\n                              <a href={cert.Url} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-primary hover:underline\">\n                                View Certificate\n                              </a>\n                            )}\n                          </div>\n                          {getDateText(cert.Date, undefined) && (\n                            <div className=\"text-sm text-muted-foreground\">{getDateText(cert.Date, undefined)}</div>\n                          )}\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                </section>\n              )}\n\n              {/* Publications */}\n              {resumeData.Publications.length > 0 && (\n                <section>\n                  <h2 className=\"text-2xl font-bold mb-6\">Publications</h2>\n                  <div className=\"space-y-4\">\n                    {resumeData.Publications.map((pub, index) => (\n                      <div key={index} className=\"border rounded-lg p-4\">\n                        <div className=\"flex items-center justify-between\">\n                          <div>\n                            <h3 className=\"font-semibold\">{pub.Name}</h3>\n                            <p className=\"text-sm text-muted-foreground\">{pub.Publisher}</p>\n                            {pub.Url && (\n                              <a href={pub.Url} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-primary hover:underline\">\n                                View Publication\n                              </a>\n                            )}\n                          </div>\n                          {getDateText(pub.ReleaseDate, undefined) && (\n                            <div className=\"text-sm text-muted-foreground\">{getDateText(pub.ReleaseDate, undefined)}</div>\n                          )}\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                </section>\n              )}\n\n              {/* Languages */}\n              {resumeData.Languages.length > 0 && (\n                <section>\n                  <h2 className=\"text-2xl font-bold mb-6\">Languages</h2>\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n                    {resumeData.Languages.map((language, index) => (\n                      <div key={index} className=\"p-4 border rounded-lg\">\n                        <h3 className=\"font-semibold text-lg\">{language.Language}</h3>\n                        {language.Fluency && (\n                          <p className=\"text-sm text-muted-foreground\">{language.Fluency}</p>\n                        )}\n                      </div>\n                    ))}\n                  </div>\n                </section>\n              )}\n\n              {/* Interests */}\n              {resumeData.Interests.length > 0 && (\n                <section>\n                  <h2 className=\"text-2xl font-bold mb-6\">Interests</h2>\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n                    {resumeData.Interests.map((interest, index) => (\n                      <div key={index} className=\"p-4 border rounded-lg\">\n                        <h3 className=\"font-semibold text-lg\">{interest.Name}</h3>\n                        {interest.Keywords && interest.Keywords.length > 0 && (\n                          <div className=\"flex flex-wrap gap-1 mt-2\">\n                            {interest.Keywords.map((keyword, kIdx) => (\n                              <span key={kIdx} className=\"px-2 py-1 bg-secondary text-secondary-foreground text-xs rounded\">\n                                {keyword}\n                              </span>\n                            ))}\n                          </div>\n                        )}\n                      </div>\n                    ))}\n                  </div>\n                </section>\n              )}\n\n              {/* References */}\n              {resumeData.References.length > 0 && (\n                <section>\n                  <h2 className=\"text-2xl font-bold mb-6\">References</h2>\n                  <div className=\"space-y-4\">\n                    {resumeData.References.map((reference, index) => (\n                      <div key={index} className=\"border rounded-lg p-4\">\n                        <h3 className=\"font-semibold\">{reference.Name}</h3>\n                        <p className=\"text-sm text-muted-foreground\">{reference.Reference}</p>\n                      </div>\n                    ))}\n                  </div>\n                </section>\n              )}\n\n      {/* Resume Metadata */}\n      <Card>\n        <CardContent className=\"space-y-4\">\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n            <div>\n              <p className=\"text-sm font-medium text-muted-foreground\">Created</p>\n              <p>{new Date(resume.createdAt).toLocaleString()}</p>\n            </div>\n            <div>\n              <p className=\"text-sm font-medium text-muted-foreground\">Last Updated</p>\n              <p>{new Date(resume.updatedAt).toLocaleString()}</p>\n            </div>\n            <div>\n              <p className=\"text-sm font-medium text-muted-foreground\">Views</p>\n              <p className=\"flex items-center gap-1\">\n                <Eye className=\"h-4 w-4\" />\n                {resume.views}\n              </p>\n            </div>\n          </div>\n\n          {resume.parentId && (\n            <div>\n              <p className=\"text-sm font-medium text-muted-foreground mb-2\">Variation of</p>\n              <Badge variant=\"outline\">Master Resume</Badge>\n            </div>\n          )}\n        </CardContent>\n      </Card>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\SearchBar.tsx","messages":[{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":161,"column":13,"nodeType":"JSXOpeningElement","endLine":161,"endColumn":63},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":184,"column":13,"nodeType":"JSXOpeningElement","endLine":184,"endColumn":63},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":216,"column":13,"nodeType":"JSXOpeningElement","endLine":216,"endColumn":63},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":243,"column":13,"nodeType":"JSXOpeningElement","endLine":243,"endColumn":63},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":255,"column":13,"nodeType":"JSXOpeningElement","endLine":255,"endColumn":63},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":267,"column":13,"nodeType":"JSXOpeningElement","endLine":267,"endColumn":63},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":294,"column":13,