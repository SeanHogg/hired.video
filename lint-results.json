          sentiment\n                    "},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":651,"column":50,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[26983,27165],"text":"\n                        Understanding your resume&apos;s sentiment helps you approach\n                        job applications with greater confidence and clarity.\n                      "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[26983,27165],"text":"\n                        Understanding your resume&lsquo;s sentiment helps you approach\n                        job applications with greater confidence and clarity.\n                      "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[26983,27165],"text":"\n                        Understanding your resume&#39;s sentiment helps you approach\n                        job applications with greater confidence and clarity.\n                      "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[26983,27165],"text":"\n                        Understanding your resume&rsquo;s sentiment helps you approach\n                        job applications with greater confidence and clarity.\n                      "},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":664,"column":55,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[27510,27685],"text":"\n                        Get instant feedback instead of waiting for application\n                        responses to gauge your resume&apos;s effectiveness.\n                      "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[27510,27685],"text":"\n                        Get instant feedback instead of waiting for application\n                        responses to gauge your resume&lsquo;s effectiveness.\n                      "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[27510,27685],"text":"\n                        Get instant feedback instead of waiting for application\n                        responses to gauge your resume&#39;s effectiveness.\n                      "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[27510,27685],"text":"\n                        Get instant feedback instead of waiting for application\n                        responses to gauge your resume&rsquo;s effectiveness.\n                      "},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":8,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useCallback, useMemo } from \"react\";\nimport {\n  Upload,\n  Loader2,\n  X,\n  AlertTriangle,\n  Heart,\n  FileText,\n  ArrowLeft,\n  Lightbulb,\n} from \"lucide-react\";\nimport { Link, useLocation } from \"react-router-dom\";\nimport { useSEO } from \"@/lib/seo\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport AuthOverlay from \"@/components/AuthOverlay\";\nimport SentimentScoreDisplay from \"@/components/tools/SentimentScoreDisplay\";\nimport SentimentRecommendations from \"@/components/tools/SentimentRecommendations\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\nimport { sentimentService } from \"@/lib/services/sentiment-service\";\nimport { resumeService } from \"@/lib/services/resume-service\";\nimport { useQuery } from \"@tanstack/react-query\";\n\nexport default function SentimentAnalysis() {\n  const location = useLocation();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { isAuthenticated, user } = useAuth();\n\n  // SEO for sentiment analysis page\n  useSEO(location.pathname);\n\n  // State for file upload\n  const [isDragging, setIsDragging] = useState(false);\n  const [file, setFile] = useState<File | null>(null);\n  const [isAnalyzing, setIsAnalyzing] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [showAuthOverlay, setShowAuthOverlay] = useState(false);\n  const [sentimentScore, setSentimentScore] = useState<number | null>(null);\n\n  // State for existing resume selection\n  const [selectedResumeId, setSelectedResumeId] = useState<string>(\"\");\n\n  // Fetch user's resumes if authenticated\n  const { data: resumes = [] } = useQuery({\n    queryKey: [\"resumes\"],\n    queryFn: () => resumeService.getUserResumes(),\n    enabled: isAuthenticated,\n  });\n\n  const allowedTypes = useMemo(\n    () => [\n      \"application/pdf\",\n      \"application/msword\",\n      \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\",\n      \"text/plain\",\n    ],\n    [],\n  );\n\n  const handleDragOver = useCallback((e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragging(true);\n  }, []);\n\n  const handleDragLeave = useCallback((e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragging(false);\n  }, []);\n\n  const handleDrop = useCallback(\n    (e: React.DragEvent) => {\n      e.preventDefault();\n      setIsDragging(false);\n      setError(null);\n\n      const droppedFile = e.dataTransfer.files[0];\n      if (droppedFile && allowedTypes.includes(droppedFile.type)) {\n        setFile(droppedFile);\n      } else {\n        setError(\"Please upload a PDF, Word document, or text file.\");\n      }\n    },\n    [allowedTypes],\n  );\n\n  const handleFileSelect = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const selectedFile = e.target.files?.[0];\n    setError(null);\n\n    if (selectedFile && allowedTypes.includes(selectedFile.type)) {\n      setFile(selectedFile);\n    } else {\n      setError(\"Please upload a PDF, Word document, or text file.\");\n    }\n  };\n\n  const handleFileAnalysis = async () => {\n    if (!file) return;\n\n    // Check authentication before proceeding\n    if (!isAuthenticated) {\n      setShowAuthOverlay(true);\n      return;\n    }\n\n    setIsAnalyzing(true);\n    setError(null);\n    setSentimentScore(null);\n\n    try {\n      const score = await sentimentService.analyzeFileSentiment(file);\n      setSentimentScore(score);\n    } catch (err) {\n      console.error(\"Sentiment analysis failed:\", err);\n      setError(\"Failed to analyze sentiment. Please try again.\");\n    } finally {\n      setIsAnalyzing(false);\n    }\n  };\n\n  const handleResumeAnalysis = async () => {\n    if (!selectedResumeId) return;\n\n    // Check authentication before proceeding\n    if (!isAuthenticated) {\n      setShowAuthOverlay(true);\n      return;\n    }\n\n    setIsAnalyzing(true);\n    setError(null);\n    setSentimentScore(null);\n\n    try {\n      const score =\n        await sentimentService.analyzeResumeSentiment(selectedResumeId);\n      setSentimentScore(score);\n    } catch (err) {\n      console.error(\"Resume sentiment analysis failed:\", err);\n      setError(\"Failed to analyze resume sentiment. Please try again.\");\n    } finally {\n      setIsAnalyzing(false);\n    }\n  };\n\n  const removeFile = () => {\n    setFile(null);\n    setError(null);\n    setSentimentScore(null);\n  };\n\n  const resetAnalysis = () => {\n    setFile(null);\n    setSelectedResumeId(\"\");\n    setError(null);\n    setSentimentScore(null);\n  };\n\n  const getFileIcon = (file: File) => {\n    if (file.type.includes(\"pdf\")) return \"≡ƒôä\";\n    if (file.type.includes(\"word\")) return \"≡ƒô¥\";\n    if (file.type.includes(\"text\")) return \"≡ƒôä\";\n    return \"≡ƒôä\";\n  };\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className={`pt-16 p-6 ${showAuthOverlay ? \"relative\" : \"\"}`}>\n          {showAuthOverlay && (\n            <AuthOverlay\n              contentType=\"resume\"\n              title=\"Sentiment Analysis Tool\"\n              message=\"Sign in to access our AI-powered sentiment analysis tool and discover how positive your resume sounds to employers.\"\n            />\n          )}\n          <div className=\"max-w-6xl mx-auto space-y-8\">\n            {/* Header */}\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-4\">\n                <div className=\"w-12 h-12 bg-brand-purple/10 rounded-lg flex items-center justify-center\">\n                  <Heart className=\"h-6 w-6 text-brand-purple\" />\n                </div>\n                <div>\n                  <h1 className=\"text-3xl font-bold\">\n                    Resume Sentiment Analysis\n                  </h1>\n                  <p className=\"text-muted-foreground\">\n                    Discover how positive and engaging your resume sounds to\n                    employers\n                  </p>\n                </div>\n              </div>\n              <Link to=\"/tools\">\n                <Button variant=\"outline\">\n                  <ArrowLeft className=\"w-4 h-4 mr-2\" />\n                  Back to Tools\n                </Button>\n              </Link>\n            </div>\n\n            {/* Main Content */}\n            <div className=\"grid lg:grid-cols-2 gap-8\">\n              {/* Left Column - Analysis Tool */}\n              <div className=\"space-y-6\">\n                <Card>\n                  <CardHeader>\n                    <CardTitle className=\"flex items-center gap-2\">\n                      <Upload className=\"h-5 w-5\" />\n                      Analyze Resume Sentiment\n                    </CardTitle>\n                  </CardHeader>\n                  <CardContent>\n                    <Tabs\n                      defaultValue={isAuthenticated ? \"existing\" : \"upload\"}\n                      className=\"w-full\"\n                    >\n                      <TabsList className=\"grid w-full grid-cols-2\">\n                        <TabsTrigger value=\"upload\">Upload File</TabsTrigger>\n                        <TabsTrigger\n                          value=\"existing\"\n                          disabled={!isAuthenticated}\n                        >\n                          My Resumes {!isAuthenticated && \"(Login Required)\"}\n                        </TabsTrigger>\n                      </TabsList>\n\n                      <TabsContent value=\"upload\" className=\"space-y-4\">\n                        {!file ? (\n                          <div\n                            className={`border-2 border-dashed rounded-lg p-8 text-center transition-colors ${\n                              isDragging\n                                ? \"border-primary bg-primary/5\"\n                                : \"border-border hover:border-primary/50\"\n                            }`}\n                            onDragOver={handleDragOver}\n                            onDragLeave={handleDragLeave}\n                            onDrop={handleDrop}\n                          >\n                            <Upload className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                            <p className=\"text-lg font-medium mb-2\">\n                              Drop your resume here, or click to browse\n                            </p>\n                            <p className=\"text-sm text-muted-foreground mb-4\">\n                              Supports PDF, Word (.doc, .docx), and text files\n                            </p>\n                            <Input\n                              type=\"file\"\n                              accept=\".pdf,.doc,.docx,.txt\"\n                              onChange={handleFileSelect}\n                              className=\"hidden\"\n                              id=\"file-upload\"\n                            />\n                            <Button variant=\"outline\" asChild>\n                              <label\n                                htmlFor=\"file-upload\"\n                                className=\"cursor-pointer\"\n                              >\n                                Choose File\n                              </label>\n                            </Button>\n                          </div>\n                        ) : (\n                          <div className=\"space-y-4\">\n                            <div className=\"border rounded-lg p-4 bg-muted/30\">\n                              <div className=\"flex items-center justify-between\">\n                                <div className=\"flex items-center gap-3\">\n                                  <span className=\"text-2xl\">\n                                    {getFileIcon(file)}\n                                  </span>\n                                  <div>\n                                    <p className=\"font-medium\">{file.name}</p>\n                                    <p className=\"text-sm text-muted-foreground\">\n                                      {(file.size / 1024 / 1024).toFixed(2)} MB\n                                    </p>\n                                  </div>\n                                </div>\n                                <Button\n                                  variant=\"ghost\"\n                                  size=\"sm\"\n                                  onClick={removeFile}\n                                >\n                                  <X className=\"h-4 w-4\" />\n                                </Button>\n                              </div>\n                            </div>\n                            <Button\n                              onClick={handleFileAnalysis}\n                              disabled={isAnalyzing}\n                              className=\"w-full\"\n                            >\n                              {isAnalyzing ? (\n                                <>\n                                  <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n                                  Analyzing...\n                                </>\n                              ) : (\n                                <>\n                                  <Heart className=\"mr-2 h-4 w-4\" />\n                                  Analyze Sentiment\n                                </>\n                              )}\n                            </Button>\n                          </div>\n                        )}\n                      </TabsContent>\n\n                      <TabsContent value=\"existing\" className=\"space-y-4\">\n                        {isAuthenticated ? (\n                          <div className=\"space-y-4\">\n                            <div>\n                              <Label htmlFor=\"resume-select\">\n                                Select Resume\n                              </Label>\n                              <Select\n                                value={selectedResumeId}\n                                onValueChange={setSelectedResumeId}\n                              >\n                                <SelectTrigger>\n                                  <SelectValue placeholder=\"Choose a resume to analyze\" />\n                                </SelectTrigger>\n                                <SelectContent>\n                                  {resumes.map((resume) => (\n                                    <SelectItem\n                                      key={resume.id}\n                                      value={resume.id || \"\"}\n                                    >\n                                      <div className=\"flex items-center gap-2\">\n                                        <FileText className=\"h-4 w-4\" />\n                                        {resume.name || \"Untitled Resume\"}\n                                      </div>\n                                    </SelectItem>\n                                  ))}\n                                </SelectContent>\n                              </Select>\n                            </div>\n                            <Button\n                              onClick={handleResumeAnalysis}\n                              disabled={!selectedResumeId || isAnalyzing}\n                              className=\"w-full\"\n                            >\n                              {isAnalyzing ? (\n                                <>\n                                  <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n                                  Analyzing...\n                                </>\n                              ) : (\n                                <>\n                                  <Heart className=\"mr-2 h-4 w-4\" />\n                                  Analyze Sentiment\n                                </>\n                              )}\n                            </Button>\n                          </div>\n                        ) : (\n                          <div className=\"text-center py-8\">\n                            <p className=\"text-muted-foreground mb-4\">\n                              Please log in to analyze your existing resumes\n                            </p>\n                            <Link to=\"/login\">\n                              <Button>Log In</Button>\n                            </Link>\n                          </div>\n                        )}\n                      </TabsContent>\n                    </Tabs>\n\n                    {/* Error Display */}\n                    {error && (\n                      <Alert variant=\"destructive\" className=\"mt-4\">\n                        <AlertTriangle className=\"h-4 w-4\" />\n                        <AlertDescription>{error}</AlertDescription>\n                      </Alert>\n                    )}\n                  </CardContent>\n                </Card>\n              </div>\n\n              {/* Right Column - Results */}\n              <div className=\"space-y-6\">\n                {sentimentScore !== null ? (\n                  <>\n                    <SentimentScoreDisplay score={sentimentScore} />\n                    <SentimentRecommendations score={sentimentScore} />\n                    <div className=\"flex gap-3\">\n                      <Button\n                        onClick={resetAnalysis}\n                        variant=\"outline\"\n                        className=\"flex-1\"\n                      >\n                        Analyze Another\n                      </Button>\n                      {isAuthenticated && (\n                        <Link to=\"/resumes\" className=\"flex-1\">\n                          <Button className=\"w-full\">View My Resumes</Button>\n                        </Link>\n                      )}\n                    </div>\n                  </>\n                ) : (\n                  <Card>\n                    <CardContent className=\"p-8 text-center\">\n                      <Heart className=\"h-16 w-16 mx-auto text-muted-foreground mb-4\" />\n                      <h3 className=\"text-lg font-semibold mb-2\">\n                        Ready to Analyze\n                      </h3>\n                      <p className=\"text-muted-foreground\">\n                        Upload a resume file or select from your existing\n                        resumes to get started.\n                      </p>\n                    </CardContent>\n                  </Card>\n                )}\n              </div>\n            </div>\n\n            {/* SEO Content Section */}\n            <div className=\"max-w-4xl mx-auto space-y-12 mt-16\">\n              {/* What is Resume Sentiment Analysis */}\n              <section className=\"space-y-6\">\n                <h2 className=\"text-3xl font-bold text-center\">\n                  What is Resume Sentiment Analysis?\n                </h2>\n                <div className=\"prose prose-lg max-w-none text-muted-foreground\">\n                  <p className=\"text-center text-xl leading-relaxed\">\n                    Resume sentiment analysis uses advanced AI to evaluate the\n                    emotional tone and positivity of your resume content,\n                    helping you understand how your resume might be perceived by\n                    hiring managers and recruiters.\n                  </p>\n                </div>\n\n                <div className=\"grid md:grid-cols-3 gap-6 mt-8\">\n                  <Card className=\"text-center\">\n                    <CardContent className=\"p-6\">\n                      <div className=\"w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4\">\n                        <Heart className=\"h-6 w-6 text-blue-600\" />\n                      </div>\n                      <h3 className=\"font-semibold mb-2\">\n                        AI-Powered Analysis\n                      </h3>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Our machine learning model analyzes your resume's\n                        language patterns to determine overall sentiment\n                      </p>\n                    </CardContent>\n                  </Card>\n\n                  <Card className=\"text-center\">\n                    <CardContent className=\"p-6\">\n                      <div className=\"w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mx-auto mb-4\">\n                        <FileText className=\"h-6 w-6 text-green-600\" />\n                      </div>\n                      <h3 className=\"font-semibold mb-2\">Instant Results</h3>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Get immediate feedback on your resume's tone with a\n                        detailed sentiment score from 0-100\n                      </p>\n                    </CardContent>\n                  </Card>\n\n                  <Card className=\"text-center\">\n                    <CardContent className=\"p-6\">\n                      <div className=\"w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mx-auto mb-4\">\n                        <Lightbulb className=\"h-6 w-6 text-purple-600\" />\n                      </div>\n                      <h3 className=\"font-semibold mb-2\">\n                        Actionable Insights\n                      </h3>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Receive personalized recommendations to improve your\n                        resume's appeal to employers\n                      </p>\n                    </CardContent>\n                  </Card>\n                </div>\n              </section>\n\n              {/* Why Resume Sentiment Matters */}\n              <section className=\"space-y-6\">\n                <h2 className=\"text-3xl font-bold text-center\">\n                  Why Resume Sentiment Matters\n                </h2>\n                <div className=\"grid md:grid-cols-2 gap-8\">\n                  <div className=\"space-y-4\">\n                    <h3 className=\"text-xl font-semibold\">\n                      First Impressions Count\n                    </h3>\n                    <p className=\"text-muted-foreground\">\n                      Recruiters spend an average of 6-7 seconds scanning a\n                      resume. The emotional tone of your content can make the\n                      difference between moving forward or being passed over. A\n                      positive sentiment creates an immediate favorable\n                      impression.\n                    </p>\n\n                    <h3 className=\"text-xl font-semibold\">\n                      Stand Out from Competition\n                    </h3>\n                    <p className=\"text-muted-foreground\">\n                      With hundreds of applications for each position, resumes\n                      with positive sentiment are more likely to capture\n                      attention and create memorable impressions that lead to\n                      interview invitations.\n                    </p>\n                  </div>\n\n                  <div className=\"space-y-4\">\n                    <h3 className=\"text-xl font-semibold\">\n                      Psychological Impact\n                    </h3>\n                    <p className=\"text-muted-foreground\">\n                      Positive language triggers favorable psychological\n                      responses in readers. Hiring managers are more likely to\n                      associate positive sentiment with confident, capable\n                      candidates who will contribute positively to their\n                      organization.\n                    </p>\n\n                    <h3 className=\"text-xl font-semibold\">ATS Optimization</h3>\n                    <p className=\"text-muted-foreground\">\n                      Modern Applicant Tracking Systems increasingly use\n                      sentiment analysis as a ranking factor. Resumes with\n                      positive sentiment scores may receive higher rankings in\n                      automated screening processes.\n                    </p>\n                  </div>\n                </div>\n              </section>\n\n              {/* How It Works */}\n              <section className=\"space-y-6\">\n                <h2 className=\"text-3xl font-bold text-center\">\n                  How Our Sentiment Analysis Works\n                </h2>\n                <div className=\"grid md:grid-cols-4 gap-6\">\n                  <div className=\"text-center\">\n                    <div className=\"w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4\">\n                      <span className=\"text-2xl font-bold text-primary\">1</span>\n                    </div>\n                    <h3 className=\"font-semibold mb-2\">Upload Resume</h3>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Upload your resume in PDF, Word, or text format\n                    </p>\n                  </div>\n\n                  <div className=\"text-center\">\n                    <div className=\"w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4\">\n                      <span className=\"text-2xl font-bold text-primary\">2</span>\n                    </div>\n                    <h3 className=\"font-semibold mb-2\">AI Processing</h3>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Our ML model analyzes language patterns and emotional\n                      indicators\n                    </p>\n                  </div>\n\n                  <div className=\"text-center\">\n                    <div className=\"w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4\">\n                      <span className=\"text-2xl font-bold text-primary\">3</span>\n                    </div>\n                    <h3 className=\"font-semibold mb-2\">Score Generation</h3>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Receive a detailed sentiment score from 0-100 with\n                      interpretation\n                    </p>\n                  </div>\n\n                  <div className=\"text-center\">\n                    <div className=\"w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4\">\n                      <span className=\"text-2xl font-bold text-primary\">4</span>\n                    </div>\n                    <h3 className=\"font-semibold mb-2\">Get Recommendations</h3>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Receive personalized tips to improve your resume's\n                      sentiment\n                    </p>\n                  </div>\n                </div>\n              </section>\n\n              {/* Benefits Section */}\n              <section className=\"space-y-6\">\n                <h2 className=\"text-3xl font-bold text-center\">\n                  Benefits of Resume Sentiment Analysis\n                </h2>\n                <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                  <Card>\n                    <CardContent className=\"p-6\">\n                      <h3 className=\"font-semibold mb-3 text-green-600\">\n                        Increase Interview Chances\n                      </h3>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Resumes with positive sentiment are 40% more likely to\n                        receive interview invitations according to recruitment\n                        studies.\n                      </p>\n                    </CardContent>\n                  </Card>\n\n                  <Card>\n                    <CardContent className=\"p-6\">\n                      <h3 className=\"font-semibold mb-3 text-blue-600\">\n                        Improve ATS Rankings\n                      </h3>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Modern ATS systems factor sentiment into ranking\n                        algorithms, giving positive resumes higher visibility.\n                      </p>\n                    </CardContent>\n                  </Card>\n\n                  <Card>\n                    <CardContent className=\"p-6\">\n                      <h3 className=\"font-semibold mb-3 text-purple-600\">\n                        Build Confidence\n                      </h3>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Understanding your resume's sentiment helps you approach\n                        job applications with greater confidence and clarity.\n                      </p>\n                    </CardContent>\n                  </Card>\n\n                  <Card>\n                    <CardContent className=\"p-6\">\n                      <h3 className=\"font-semibold mb-3 text-orange-600\">\n                        Save Time\n                      </h3>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Get instant feedback instead of waiting for application\n                        responses to gauge your resume's effectiveness.\n                      </p>\n                    </CardContent>\n                  </Card>\n\n                  <Card>\n                    <CardContent className=\"p-6\">\n                      <h3 className=\"font-semibold mb-3 text-red-600\">\n                        Competitive Advantage\n                      </h3>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Stand out from other candidates by ensuring your resume\n                        creates the most positive first impression possible.\n                      </p>\n                    </CardContent>\n                  </Card>\n\n                  <Card>\n                    <CardContent className=\"p-6\">\n                      <h3 className=\"font-semibold mb-3 text-teal-600\">\n                        Data-Driven Insights\n                      </h3>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Make resume improvements based on objective AI analysis\n                        rather than guesswork or subjective opinions.\n                      </p>\n                    </CardContent>\n                  </Card>\n                </div>\n              </section>\n\n              {/* FAQ Section */}\n              <section className=\"space-y-6\">\n                <h2 className=\"text-3xl font-bold text-center\">\n                  Frequently Asked Questions\n                </h2>\n                <div className=\"space-y-4\">\n                  <Card>\n                    <CardContent className=\"p-6\">\n                      <h3 className=\"font-semibold mb-2\">\n                        What is a good sentiment score for a resume?\n                      </h3>\n                      <p className=\"text-muted-foreground\">\n                        A sentiment score above 60 is considered positive and\n                        will create a favorable impression. Scores between 31-60\n                        are neutral and have room for improvement, while scores\n                        below 30 indicate negative sentiment that should be\n                        addressed immediately.\n                      </p>\n                    </CardContent>\n                  </Card>\n\n                  <Card>\n                    <CardContent className=\"p-6\">\n                      <h3 className=\"font-semibold mb-2\">\n                        How accurate is the sentiment analysis?\n                      </h3>\n                      <p className=\"text-muted-foreground\">\n                        Our AI model has been trained on thousands of resumes\n                        and achieves over 85% accuracy in sentiment\n                        classification. The analysis considers context,\n                        industry-specific language, and professional terminology\n                        for precise results.\n                      </p>\n                    </CardContent>\n                  </Card>\n\n                  <Card>\n                    <CardContent className=\"p-6\">\n                      <h3 className=\"font-semibold mb-2\">\n                        Can I analyze multiple resumes?\n                      </h3>\n                      <p className=\"text-muted-foreground\">\n                        Yes! Registered users can analyze all their saved\n                        resumes and compare sentiment scores to identify their\n                        strongest applications. You can also upload new files\n                        for analysis at any time.\n                      </p>\n                    </CardContent>\n                  </Card>\n\n                  <Card>\n                    <CardContent className=\"p-6\">\n                      <h3 className=\"font-semibold mb-2\">\n                        What file formats are supported?\n                      </h3>\n                      <p className=\"text-muted-foreground\">\n                        We support PDF, Microsoft Word (.doc, .docx), and plain\n                        text (.txt) files. Most modern resume formats are\n                        compatible with our text extraction and analysis system.\n                      </p>\n                    </CardContent>\n                  </Card>\n\n                  <Card>\n                    <CardContent className=\"p-6\">\n                      <h3 className=\"font-semibold mb-2\">\n                        Is my resume data secure?\n                      </h3>\n                      <p className=\"text-muted-foreground\">\n                        Absolutely. We use enterprise-grade encryption and never\n                        store your resume content permanently. Analysis is\n                        performed in real-time and data is immediately discarded\n                        after processing, ensuring complete privacy and\n                        security.\n                      </p>\n                    </CardContent>\n                  </Card>\n                </div>\n              </section>\n\n              {/* Call to Action */}\n              <section className=\"text-center space-y-6 bg-gradient-to-r from-brand-purple/10 to-brand-blue/10 p-8 rounded-2xl\">\n                <h2 className=\"text-3xl font-bold\">\n                  Ready to Optimize Your Resume?\n                </h2>\n                <p className=\"text-xl text-muted-foreground max-w-2xl mx-auto\">\n                  Join thousands of job seekers who have improved their\n                  interview chances with our AI-powered sentiment analysis.\n                </p>\n                <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n                  <Button\n                    size=\"lg\"\n                    onClick={() =>\n                      window.scrollTo({ top: 0, behavior: \"smooth\" })\n                    }\n                  >\n                    <Heart className=\"mr-2 h-5 w-5\" />\n                    Analyze My Resume Now\n                  </Button>\n                  <Link to=\"/signup\">\n                    <Button size=\"lg\" variant=\"outline\">\n                      Create Free Account\n                    </Button>\n                  </Link>\n                </div>\n              </section>\n            </div>\n          </div>\n        </div>\n        <Footer />\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\tools\\SummarizeResume.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'user' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":35,"column":28,"nodeType":null,"messageId":"unusedVar","endLine":35,"endColumn":32},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":116,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":116,"endColumn":20,"suggestions":[{"fix":{"range":[3566,3610],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":169,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":169,"endColumn":20,"suggestions":[{"fix":{"range":[4979,5028],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":207,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":207,"endColumn":20,"suggestions":[{"fix":{"range":[5944,5995],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":312,"column":27,"nodeType":"JSXOpeningElement","endLine":312,"endColumn":77},{"ruleId":"jsx-a11y/label-has-associated-control","severi