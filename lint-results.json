lue) =>\n                    handleFilterChange(\n                      \"datePosted\",\n                      value === \"all\" ? undefined : value,\n                    )\n                  }\n                >\n                  <SelectTrigger className=\"h-8 text-xs\">\n                    <SelectValue />\n                  </SelectTrigger>\n                  <SelectContent>\n                    <SelectItem value=\"all\">Any Time</SelectItem>\n                    <SelectItem value=\"24h\">Last 24 hours</SelectItem>\n                    <SelectItem value=\"3d\">Last 3 days</SelectItem>\n                    <SelectItem value=\"week\">Last week</SelectItem>\n                    <SelectItem value=\"month\">Last month</SelectItem>\n                  </SelectContent>\n                </Select>\n              </div>\n\n              {/* Media Filter */}\n              <div className=\"space-y-2\">\n                <label className=\"text-xs font-medium text-muted-foreground flex items-center gap-1\">\n                  <FileText className=\"w-3 h-3\" />\n                  Media Content\n                </label>\n                <Select\n                  value={filters.hasMedia?.toString() || \"all\"}\n                  onValueChange={(value) =>\n                    handleFilterChange(\n                      \"hasMedia\",\n                      value === \"all\" ? undefined : value === \"true\",\n                    )\n                  }\n                >\n                  <SelectTrigger className=\"h-8 text-xs\">\n                    <SelectValue />\n                  </SelectTrigger>\n                  <SelectContent>\n                    <SelectItem value=\"all\">All Content</SelectItem>\n                    <SelectItem value=\"true\">With Videos/Images</SelectItem>\n                    <SelectItem value=\"false\">Text Only</SelectItem>\n                  </SelectContent>\n                </Select>\n              </div>\n            </div>\n          </CardContent>\n        </Card>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\ShareModal.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":36,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":36,"endColumn":20,"suggestions":[{"fix":{"range":[858,898],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Dialog,\n  DialogContent,\n  DialogDescription,\n  DialogHeader,\n  DialogTitle,\n} from \"@/components/ui/dialog\";\nimport { Input } from \"@/components/ui/input\";\nimport { Copy } from \"lucide-react\";\n\ninterface ShareModalProps {\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n  shareUrl: string;\n  title?: string;\n  message?: string;\n}\n\nexport default function ShareModal({\n  open,\n  onOpenChange,\n  shareUrl,\n  title = \"Share Options\",\n  message = \"Please share by using an option below.\",\n}: ShareModalProps) {\n  const [copied, setCopied] = useState(false);\n\n  const copyToClipboard = async () => {\n    try {\n      await navigator.clipboard.writeText(shareUrl);\n      setCopied(true);\n      setTimeout(() => setCopied(false), 1500);\n    } catch (e) {\n      console.error(\"Failed to copy link\", e);\n    }\n  };\n\n  const encodedUrl = encodeURIComponent(shareUrl);\n  const defaultText = encodeURIComponent(\n    \"Check out my profile on MyVideoResume!\",\n  );\n\n  const links = [\n    {\n      label: \"Share on Twitter\",\n      href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${defaultText}`,\n    },\n    {\n      label: \"Share on Facebook\",\n      href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,\n    },\n    {\n      label: \"Share on LinkedIn\",\n      href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,\n    },\n    {\n      label: \"Share by Email\",\n      href: `mailto:?subject=${encodeURIComponent(\"MyVideoResume Profile\")}&body=${defaultText}%20${encodedUrl}`,\n    },\n    {\n      label: \"Share on WhatsApp\",\n      href: `https://wa.me/?text=${defaultText}%20${encodedUrl}`,\n    },\n    {\n      label: \"Share on Telegram\",\n      href: `https://t.me/share/url?url=${encodedUrl}&text=${defaultText}`,\n    },\n    {\n      label: \"Share on Reddit\",\n      href: `https://www.reddit.com/submit?url=${encodedUrl}&title=${defaultText}`,\n    },\n  ];\n\n  return (\n    <Dialog open={open} onOpenChange={onOpenChange}>\n      <DialogContent className=\"sm:max-w-lg\">\n        <DialogHeader>\n          <DialogTitle>{title}</DialogTitle>\n          <DialogDescription>{message}</DialogDescription>\n        </DialogHeader>\n\n        <div className=\"flex gap-2\">\n          <Input value={shareUrl} readOnly className=\"flex-1\" />\n          <Button variant=\"outline\" onClick={copyToClipboard} title=\"Copy link\">\n            <Copy className=\"h-4 w-4 mr-1\" />\n            {copied ? \"Copied\" : \"Copy\"}\n          </Button>\n        </div>\n\n        <div className=\"grid sm:grid-cols-2 gap-2 mt-2\">\n          {links.map((item) => (\n            <Button key={item.label} variant=\"outline\" asChild>\n              <a href={item.href} target=\"_blank\" rel=\"noopener noreferrer\">\n                {item.label}\n              </a>\n            </Button>\n          ))}\n        </div>\n      </DialogContent>\n    </Dialog>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\ShoppingCart.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo