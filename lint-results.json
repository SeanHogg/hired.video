uleId":"no-console","severity":1,"message":"Unexpected console statement.","line":155,"column":9,"nodeType":"MemberExpression","messageId":"unexpected","endLine":155,"endColumn":20,"suggestions":[{"fix":{"range":[4807,4849],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":157,"column":9,"nodeType":"MemberExpression","messageId":"unexpected","endLine":157,"endColumn":22,"suggestions":[{"fix":{"range":[4882,4940],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":166,"column":9,"nodeType":"MemberExpression","messageId":"unexpected","endLine":166,"endColumn":20,"suggestions":[{"fix":{"range":[5173,5213],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":168,"column":9,"nodeType":"MemberExpression","messageId":"unexpected","endLine":168,"endColumn":22,"suggestions":[{"fix":{"range":[5246,5304],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":179,"column":9,"nodeType":"MemberExpression","messageId":"unexpected","endLine":179,"endColumn":20,"suggestions":[{"fix":{"range":[5576,5620],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":181,"column":9,"nodeType":"MemberExpression","messageId":"unexpected","endLine":181,"endColumn":22,"suggestions":[{"fix":{"range":[5653,5713],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":16,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import * as signalR from \"@microsoft/signalr\";\n\nexport interface Notification {\n  id: string;\n  title: string;\n  message: string;\n  type: \"info\" | \"success\" | \"warning\" | \"error\" | \"job_application\";\n  data?: any;\n  timestamp: string;\n  isRead: boolean;\n}\n\nexport interface UserStatusUpdate {\n  userId: string;\n  userName: string;\n  status: \"online\" | \"away\" | \"busy\" | \"offline\";\n  timestamp: string;\n}\n\nexport type NotificationHandler = (notification: Notification) => void;\nexport type UserStatusHandler = (statusUpdate: UserStatusUpdate) => void;\nexport type ConnectionStateHandler = (\n  state: signalR.HubConnectionState,\n) => void;\n\nclass SignalRService {\n  private connection: signalR.HubConnection | null = null;\n  private notificationHandlers: NotificationHandler[] = [];\n  private userStatusHandlers: UserStatusHandler[] = [];\n  private connectionStateHandlers: ConnectionStateHandler[] = [];\n\n  constructor() {\n    this.initializeConnection();\n  }\n\n  private initializeConnection(): void {\n    const apiBaseUrl = import.meta.env.VITE_API_URL || \"http://localhost:5000\";\n\n    this.connection = new signalR.HubConnectionBuilder()\n      .withUrl(`${apiBaseUrl}/api/hubs/notifications`, {\n        accessTokenFactory: () => {\n          // Get the auth token from localStorage\n          return localStorage.getItem(\"authToken\") || \"\";\n        },\n        withCredentials: true,\n      })\n      .withAutomaticReconnect({\n        nextRetryDelayInMilliseconds: (retryContext) => {\n          // Exponential backoff: 0, 2, 10, 30 seconds, then 30 seconds\n          if (retryContext.previousRetryCount === 0) return 0;\n          if (retryContext.previousRetryCount === 1) return 2000;\n          if (retryContext.previousRetryCount === 2) return 10000;\n          return 30000;\n        },\n      })\n      .configureLogging(signalR.LogLevel.Information)\n      .build();\n\n    this.setupEventHandlers();\n  }\n\n  private setupEventHandlers(): void {\n    if (!this.connection) return;\n\n    // Handle incoming notifications\n    this.connection.on(\"ReceiveNotification\", (notification: Notification) => {\n      console.log(\"Received notification:\", notification);\n      this.notificationHandlers.forEach((handler) => handler(notification));\n    });\n\n    // Handle user status changes\n    this.connection.on(\n      \"UserStatusChanged\",\n      (statusUpdate: UserStatusUpdate) => {\n        console.log(\"User status changed:\", statusUpdate);\n        this.userStatusHandlers.forEach((handler) => handler(statusUpdate));\n      },\n    );\n\n    // Handle broadcast messages\n    this.connection.on(\"BroadcastMessage\", (data: any) => {\n      console.log(\"Broadcast message:\", data);\n      const notification: Notification = {\n        id: `broadcast_${Date.now()}`,\n        title: \"System Announcement\",\n        message: data.message,\n        type: \"info\",\n        data: data,\n        timestamp: data.timestamp,\n        isRead: false,\n      };\n      this.notificationHandlers.forEach((handler) => handler(notification));\n    });\n\n    // Handle connection state changes\n    this.connection.onreconnecting(() => {\n      console.log(\"SignalR reconnecting...\");\n      this.connectionStateHandlers.forEach((handler) =>\n        handler(signalR.HubConnectionState.Reconnecting),\n      );\n    });\n\n    this.connection.onreconnected(() => {\n      console.log(\"SignalR reconnected\");\n      this.connectionStateHandlers.forEach((handler) =>\n        handler(signalR.HubConnectionState.Connected),\n      );\n    });\n\n    this.connection.onclose(() => {\n      console.log(\"SignalR connection closed\");\n      this.connectionStateHandlers.forEach((handler) =>\n        handler(signalR.HubConnectionState.Disconnected),\n      );\n    });\n  }\n\n  async start(): Promise<void> {\n    if (!this.connection) {\n      this.initializeConnection();\n    }\n\n    if (this.connection?.state === signalR.HubConnectionState.Disconnected) {\n      try {\n        await this.connection.start();\n        console.log(\"SignalR connection started\");\n        this.connectionStateHandlers.forEach((handler) =>\n          handler(signalR.HubConnectionState.Connected),\n        );\n      } catch (error) {\n        console.error(\"Error starting SignalR connection:\", error);\n        throw error;\n      }\n    }\n  }\n\n  async stop(): Promise<void> {\n    if (\n      this.connection &&\n      this.connection.state !== signalR.HubConnectionState.Disconnected\n    ) {\n      try {\n        await this.connection.stop();\n        console.log(\"SignalR connection stopped\");\n      } catch (error) {\n        console.error(\"Error stopping SignalR connection:\", error);\n      }\n    }\n  }\n\n  async joinGroup(groupName: string): Promise<void> {\n    if (this.connection?.state === signalR.HubConnectionState.Connected) {\n      try {\n        await this.connection.invoke(\"JoinGroup\", groupName);\n        console.log(`Joined group: ${groupName}`);\n      } catch (error) {\n        console.error(`Error joining group ${groupName}:`, error);\n      }\n    }\n  }\n\n  async leaveGroup(groupName: string): Promise<void> {\n    if (this.connection?.state === signalR.HubConnectionState.Connected) {\n      try {\n        await this.connection.invoke(\"LeaveGroup\", groupName);\n        console.log(`Left group: ${groupName}`);\n      } catch (error) {\n        console.error(`Error leaving group ${groupName}:`, error);\n      }\n    }\n  }\n\n  async updateStatus(\n    status: \"online\" | \"away\" | \"busy\" | \"offline\",\n  ): Promise<void> {\n    if (this.connection?.state === signalR.HubConnectionState.Connected) {\n      try {\n        await this.connection.invoke(\"UpdateStatus\", status);\n        console.log(`Status updated to: ${status}`);\n      } catch (error) {\n        console.error(`Error updating status to ${status}:`, error);\n      }\n    }\n  }\n\n  // Event handler registration methods\n  onNotification(handler: NotificationHandler): () => void {\n    this.notificationHandlers.push(handler);\n    return () => {\n      const index = this.notificationHandlers.indexOf(handler);\n      if (index > -1) {\n        this.notificationHandlers.splice(index, 1);\n      }\n    };\n  }\n\n  onUserStatusChange(handler: UserStatusHandler): () => void {\n    this.userStatusHandlers.push(handler);\n    return () => {\n      const index = this.userStatusHandlers.indexOf(handler);\n      if (index > -1) {\n        this.userStatusHandlers.splice(index, 1);\n      }\n    };\n  }\n\n  onConnectionStateChange(handler: ConnectionStateHandler): () => void {\n    this.connectionStateHandlers.push(handler);\n    return () => {\n      const index = this.connectionStateHandlers.indexOf(handler);\n      if (index > -1) {\n        this.connectionStateHandlers.splice(index, 1);\n      }\n    };\n  }\n\n  get connectionState(): signalR.HubConnectionState {\n    return this.connection?.state || signalR.HubConnectionState.Disconnected;\n  }\n\n  get isConnected(): boolean {\n    return this.connection?.state === signalR.HubConnectionState.Connected;\n  }\n}\n\n// Export a singleton instance\nexport const signalRService = new SignalRService();\nexport default signalRService;\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\services\\task-service.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'TaskListResponse' is defined but never used. Allowed unused vars must match /^_/u.","line":12,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":12,"endColumn":19},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'UserProfile' is defined but never used. Allowed unused vars must match /^_/u.","line":20,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":20,"endColumn":21},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":71,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":71,"endColumn":20,"suggestions":[{"fix":{"range":[1923,1970],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":86,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":86,"endColumn":20,"suggestions":[{"fix":{"range":[2294,2350],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":115,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":115,"endColumn":20,"suggestions":[{"fix":{"range":[3153,3200],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":146,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":146,"endColumn":20,"suggestions":[{"fix":{"range":[4074,4135],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":158,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":158,"endColumn":20,"suggestions":[{"fix":{"range":[4389,4446],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":185,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":185,"endColumn":20,"suggestions":[{"fix":{"range":[5165,5230],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":199,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":199,"endColumn":20,"suggestions":[{"fix":{"range":[5620,5678],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":300,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":300,"endColumn":20,"suggestions":[{"fix":{"range":[8977,9036],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":342,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":342,"endColumn":20,"suggestions":[{"fix":{"range":[10083,10142],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":9,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Task Service - Handles all task-related API operations\n * Integrates with the backend TaskController and ProductivityService\n */\n\nimport { apiClient } from \"@/lib/api-client\";\nimport {\n  TaskDTO,\n  CreateTaskRequest,\n  UpdateTaskRequest,\n  TaskAssignmentRequest,\n  TaskListResponse,\n  TaskFilters,\n  TaskSortOptions,\n  UserCompanyRoleAssociation,\n  TaskType,\n  ProductivityItemStatus,\n  MyVideoResumeRoles,\n} from \"@/types/task\";\nimport { UserProfile } from \"./user-service\";\n\nexport class TaskService {\n  private readonly baseUrl = \"/api/task\";\n\n  /**\n   * Get all tasks for the current user\n   */\n  async getTasks(\n    filters?: TaskFilters,\n    sort?: TaskSortOptions,\n  ): Promise<TaskDTO[]> {\n    try {\n      const params = new URLSearchParams();\n\n      if (filters) {\n        if (filters.status?.length) {\n          filters.status.forEach((status) =>\n            params.append(\"status\", status.toString()),\n          );\n        }\n        if (filters.taskType?.length) {\n          filters.taskType.forEach((type) =>\n            params.append(\"taskType\", type.toString()),\n          );\n        }\n        if (filters.assignedToUserId) {\n          params.append(\"assignedToUserId\", filters.assignedToUserId);\n        }\n        if (filters.createdByUserId) {\n          params.append(\"createdByUserId\", filters.createdByUserId);\n        }\n        if (filters.startDate) {\n          params.append(\"startDate\", filters.startDate);\n        }\n        if (filters.endDate) {\n          params.append(\"endDate\", filters.endDate);\n        }\n      }\n\n      if (sort) {\n        params.append(\"sortField\", sort.field);\n        params.append(\"sortDirection\", sort.direction);\n      }\n\n      const queryString = params.toString();\n      const url = queryString ? `${this.baseUrl}?${queryString}` : this.baseUrl;\n\n      const response = await apiClient.get<TaskDTO[]>(url);\n      return response.data;\n    } catch (error) {\n      console.error(\"Failed to fetch tasks:\", error);\n      throw new Error(\"Failed to fetch tasks\");\n    }\n  }\n\n  /**\n   * Get a specific task by ID\n   */\n  async getTaskById(taskId: string): Promise<TaskDTO> {\n    try {\n      const response = await apiClient.get<TaskDTO>(\n        `${this.baseUrl}/${taskId}`,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(`Failed to fetch task ${taskId}:`, error);\n      throw new Error(`Failed to fetch task ${taskId}`);\n    }\n  }\n\n  /**\n   * Create a new task\n   */\n  async createTask(request: CreateTaskRequest): Promise<TaskDTO> {\n    try {\n      // Convert to backend DTO format\n      const taskDto: Partial<TaskDTO> = {\n        text: request.text,\n        description: request.description,\n        start: request.start,\n        end: request.end,\n        taskType: request.taskType,\n        subTaskType: request.subTaskType,\n        actionToTake: request.actionToTake,\n        status: request.status || ProductivityItemStatus.ToDo,\n        assignedToUserId: request.assignedToUserId,\n      };\n\n      const response = await apiClient.post<TaskDTO>(\n        `${this.baseUrl}/save`,\n        taskDto,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(\"Failed to create task:\", error);\n      throw new Error(\"Failed to create task\");\n    }\n  }\n\n  /**\n   * Update an existing task\n   */\n  async updateTask(request: UpdateTaskRequest): Promise<TaskDTO> {\n    try {\n      // Convert to backend DTO format\n      const taskDto: Partial<TaskDTO> = {\n        id: request.id,\n        text: request.text,\n        description: request.description,\n        start: request.start,\n        end: request.end,\n        taskType: request.taskType,\n        subTaskType: request.subTaskType,\n        actionToTake: request.actionToTake,\n        status: request.status || ProductivityItemStatus.ToDo,\n        assignedToUserId: request.assignedToUserId,\n        updateDateTime: new Date().toISOString(),\n      };\n\n      const response = await apiClient.post<TaskDTO>(\n        `${this.baseUrl}/save`,\n        taskDto,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(`Failed to update task ${request.id}:`, error);\n      throw new Error(`Failed to update task ${request.id}`);\n    }\n  }\n\n  /**\n   * Delete a task\n   */\n  async deleteTask(taskId: string): Promise<void> {\n    try {\n      await apiClient.delete(`${this.baseUrl}/${taskId}`);\n    } catch (error) {\n      console.error(`Failed to delete task ${taskId}:`, error);\n      throw new Error(`Failed to delete task ${taskId}`);\n    }\n  }\n\n  /**\n   * Assign a task to a user\n   */\n  async assignTask(request: TaskAssignmentRequest): Promise<TaskDTO> {\n    try {\n      const task = await this.getTaskById(request.taskId);\n\n      const updateRequest: UpdateTaskRequest = {\n        id: task.id,\n        text: task.text,\n        description: task.description,\n        start: task.start,\n        end: task.end,\n        taskType: task.taskType,\n        subTaskType: task.subTaskType,\n        actionToTake: task.actionToTake,\n        status: task.status,\n        assignedToUserId: request.assignedToUserId,\n      };\n\n      return await this.updateTask(updateRequest);\n    } catch (error) {\n      console.error(`Failed to assign task ${request.taskId}:`, error);\n      throw new Error(`Failed to assign task ${request.taskId}`);\n    }\n  }\n\n  /**\n   * Get users that can be assigned tasks (account members)\n   */\n  async getAssignableUsers(): Promise<UserCompanyRoleAssociation[]> {\n    try {\n      const response =\n        await apiClient.get<UserCompanyRoleAssociation[]>(\"/api/account/users\");\n      return response.data;\n    } catch (error) {\n      console.error(\"Failed to fetch assignable users:\", error);\n      throw new Error(\"Failed to fetch assignable users\");\n    }\n  }\n\n  /**\n   * Create role-specific onboarding tasks\n   */\n  async createOnboardingTasks(roles: MyVideoResumeRoles[]): Promise<TaskDTO[]> {\n    try {\n      const tasks: CreateTaskRequest[] = [];\n      const now = new Date();\n      const tomorrow = new Date(now.getTime() + 24 * 60 * 60 * 1000);\n\n      // Common onboarding tasks\n      tasks.push({\n        text: \"Complete your profile\",\n        description: \"Add your personal information, skills, and preferences\",\n        start: now.toISOString(),\n        end: tomorrow.toISOString(),\n        taskType: TaskType.OnboardingProfile,\n        status: ProductivityItemStatus.ToDo,\n      });\n\n      // Role-specific tasks\n      if (roles.includes(MyVideoResumeRoles.JobSeeker)) {\n        tasks.push(\n          {\n            text: \"Polish your resume\",\n            description: \"Upload or build your resume using our resume builder\",\n            start: now.toISOString(),\n            end: tomorrow.toISOString(),\n            taskType: TaskType.Resume,\n            status: ProductivityItemStatus.ToDo,\n          },\n          {\n            text: \"Prepare for interviews\",\n            description: \"Review common questions and prepare your stories\",\n            start: now.toISOString(),\n            end: tomorrow.toISOString(),\n            taskType: TaskType.Interview,\n            status: ProductivityItemStatus.ToDo,\n          },\n        );\n      }\n\n      if (roles.includes(MyVideoResumeRoles.Recruiter)) {\n        tasks.push(\n          {\n            text: \"Set your recruiter preferences\",\n            description:\n              \"Define industries, roles, and locations you recruit for\",\n            start: now.toISOString(),\n            end: tomorrow.toISOString(),\n            taskType: TaskType.RecruiterPreferences,\n            status: ProductivityItemStatus.ToDo,\n          },\n          {\n            text: \"Add your first candidate pipeline\",\n            description: \"Create a Kanban board for an open role\",\n            start: now.toISOString(),\n            end: tomorrow.toISOString(),\n            taskType: TaskType.Recruiter,\n            status: ProductivityItemStatus.ToDo,\n          },\n        );\n      }\n\n      if (\n        roles.includes(MyVideoResumeRoles.Employer) ||\n        roles.includes(MyVideoResumeRoles.EmployerManager)\n      ) {\n        tasks.push(\n          {\n            text: \"Complete company profile\",\n            description: \"Add company information, culture, and benefits\",\n            start: now.toISOString(),\n            end: tomorrow.toISOString(),\n            taskType: TaskType.Company,\n            status: ProductivityItemStatus.ToDo,\n          },\n          {\n            text: \"Post your first job\",\n            description: \"Create and publish your first job posting\",\n            start: now.toISOString(),\n            end: tomorrow.toISOString(),\n            taskType: TaskType.Job,\n            status: ProductivityItemStatus.ToDo,\n          },\n        );\n      }\n\n      // Create all tasks\n      const createdTasks: TaskDTO[] = [];\n      for (const taskRequest of tasks) {\n        const createdTask = await this.createTask(taskRequest);\n        createdTasks.push(createdTask);\n      }\n\n      return createdTasks;\n    } catch (error) {\n      console.error(\"Failed to create onboarding tasks:\", error);\n      throw new Error(\"Failed to create onboarding tasks\");\n    }\n  }\n\n  /**\n   * Get tasks assigned to the current user\n   */\n  async getMyTasks(): Promise<TaskDTO[]> {\n    return this.getTasks();\n  }\n\n  /**\n   * Get tasks created by the current user\n   */\n  async getCreatedTasks(): Promise<TaskDTO[]> {\n    // The backend API filters by current user automatically\n    return this.getTasks();\n  }\n\n  /**\n   * Mark a task as completed\n   */\n  async completeTask(taskId: string): Promise<TaskDTO> {\n    try {\n      const task = await this.getTaskById(taskId);\n\n      const updateRequest: UpdateTaskRequest = {\n        id: task.id,\n        text: task.text,\n        description: task.description,\n        start: task.start,\n        end: task.end,\n        taskType: task.taskType,\n        subTaskType: task.subTaskType,\n        actionToTake: task.actionToTake,\n        status: ProductivityItemStatus.Completed,\n        assignedToUserId: task.assignedToUserId,\n      };\n\n      return await this.updateTask(updateRequest);\n    } catch (error) {\n      console.error(`Failed to complete task ${taskId}:`, error);\n      throw new Error(`Failed to complete task ${taskId}`);\n    }\n  }\n}\n\n// Export singleton instance\nexport const taskService = new TaskService();\n","usedDeprecatedRules":[]},{