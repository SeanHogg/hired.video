.resumes.map(resume => ({\n        ...resume,\n        isMaster: resume.id === resumeId ? true : false,\n      }));\n\n      const updatedMasterGroups = prevState.masterGroups.map(group => ({\n        ...group,\n        masterResume: {\n          ...group.masterResume,\n          isMaster: group.masterResume.id === resumeId ? true : false,\n        },\n        variations: group.variations.map(variation => ({\n          ...variation,\n          isMaster: variation.id === resumeId ? true : false,\n        })),\n      }));\n\n      return {\n        resumes: updatedResumes,\n        masterGroups: updatedMasterGroups,\n      };\n    });\n  }, []);\n\n  const setActiveOptimistic = useCallback((resumeId: string) => {\n    setState(prevState => {\n      // Store original state for potential revert\n      setOriginalState(prevState);\n\n      // Only one active master at a time; variations inherit from master\n      const updatedResumes = prevState.resumes.map(resume => ({\n        ...resume,\n        isActive: resume.id === resumeId ? true : false,\n      }));\n\n      const updatedMasterGroups = prevState.masterGroups.map(group => {\n        const isTargetMaster = group.masterResume?.id === resumeId;\n        return {\n          ...group,\n          masterResume: group.masterResume ? {\n            ...group.masterResume,\n            isActive: isTargetMaster,\n          } : group.masterResume,\n          variations: group.variations.map(variation => ({\n            ...variation,\n            isActive: isTargetMaster ? true : false,\n          })),\n        };\n      });\n\n      return {\n        resumes: updatedResumes,\n        masterGroups: updatedMasterGroups,\n      };\n    });\n  }, []);\n\n  const setPrivacyOptimistic = useCallback((resumeId: string, privacy: \"public\" | \"recruiter_only\" | \"connections\" | \"private\" | \"draft\") => {\n    setState((prevState): OptimisticState => {\n      // Store original state for potential revert\n      setOriginalState(prevState);\n\n      // Enforce exclusivity for public, recruiter_only, and connections across all resumes\n      const updatedResumes: ResumeWithOwnership[] = prevState.resumes.map(resume => {\n        if (resume.id === resumeId) {\n          return { ...resume, privacy } as ResumeWithOwnership;\n        }\n        if (privacy === \"public\" && resume.privacy === \"public\") {\n          return { ...resume, privacy: \"private\" } as ResumeWithOwnership;\n        }\n        if (privacy === \"recruiter_only\" && resume.privacy === \"recruiter_only\") {\n          return { ...resume, privacy: \"private\" } as ResumeWithOwnership;\n        }\n        if (privacy === \"connections\" && resume.privacy === \"connections\") {\n          return { ...resume, privacy: \"private\" } as ResumeWithOwnership;\n        }\n        return resume;\n      });\n\n      const updatedMasterGroups: MasterResumeGroup[] = prevState.masterGroups.map(group => {\n        const isTargetMaster = group.masterResume?.id === resumeId;\n        return {\n          ...group,\n          masterResume: group.masterResume ? {\n            ...group.masterResume,\n            privacy: isTargetMaster ? privacy : (group.masterResume.privacy as any),\n          } : group.masterResume,\n          variations: group.variations.map(variation => {\n            if (variation.id === resumeId) {\n              return { ...variation, privacy } as any;\n            }\n            // Demote others with same privacy when exclusivity applies\n            if (privacy === \"public\" && variation.privacy === \"public\") {\n              return { ...variation, privacy: \"private\" } as any;\n            }\n            if (privacy === \"recruiter_only\" && variation.privacy === \"recruiter_only\") {\n              return { ...variation, privacy: \"private\" } as any;\n            }\n            if (privacy === \"connections\" && variation.privacy === \"connections\") {\n              return { ...variation, privacy: \"private\" } as any;\n            }\n            return variation;\n          }),\n        } as MasterResumeGroup;\n      });\n\n      return {\n        resumes: updatedResumes,\n        masterGroups: updatedMasterGroups,\n      } as OptimisticState;\n    });\n  }, []);\n\n  const revertOptimistic = useCallback(() => {\n    setState(originalState);\n  }, [originalState]);\n\n  const updateState = useCallback((newState: OptimisticState) => {\n    setState(newState);\n    setOriginalState(newState);\n  }, []);\n\n  return [\n    state,\n    {\n      setMasterOptimistic,\n      setActiveOptimistic,\n      setPrivacyOptimistic,\n      revertOptimistic,\n      updateState,\n    },\n  ];\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\hooks\\usePasswordRequirements.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":63,"column":64,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":63,"endColumn":67,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1881,1884],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1881,1884],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect, useCallback } from \"react\";\nimport { useAuth } from \"@/lib/auth\";\n\ninterface PasswordRequirements {\n  requiresPasswordChange: boolean;\n  isTemporaryPassword: boolean;\n  passwordSetDate?: string;\n  passwordExpiryDate?: string;\n  daysUntilExpiry: number;\n  reason?: string;\n  canSkip: boolean;\n}\n\ninterface UsePasswordRequirementsReturn {\n  requirements: PasswordRequirements | null;\n  isLoading: boolean;\n  error: string | null;\n  checkRequirements: () => Promise<void>;\n  showModal: boolean;\n  setShowModal: (show: boolean) => void;\n  handlePasswordChanged: () => void;\n}\n\nexport const usePasswordRequirements = (): UsePasswordRequirementsReturn => {\n  const { user, apiCall } = useAuth();\n  const [requirements, setRequirements] = useState<PasswordRequirements | null>(\n    null,\n  );\n  const [isLoading, setIsLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [showModal, setShowModal] = useState(false);\n\n  const checkRequirements = useCallback(async () => {\n    if (!user) {\n      setRequirements(null);\n      return;\n    }\n\n    setIsLoading(true);\n    setError(null);\n\n    try {\n      const response = await apiCall(\"/api/PasswordManagement/requirements\");\n\n      if (response.success) {\n        const reqs = response.data as PasswordRequirements;\n        setRequirements(reqs);\n\n        // Show modal if password change is required\n        if (reqs.requiresPasswordChange) {\n          setShowModal(true);\n        }\n      } else {\n        setError(\n          response.error?.message || \"Failed to check password requirements\",\n        );\n      }\n    } catch (error: unknown) {\n      // Handle the specific case where the API returns PASSWORD_CHANGE_REQUIRED\n      const errorObj = error as {\n        message?: string;\n        response?: {\n          error?: { code?: string; message?: string; details?: any };\n        };\n      };\n      if (\n        errorObj.message === \"PASSWORD_CHANGE_REQUIRED\" ||\n        (errorObj.response &&\n          errorObj.response.error?.code === \"PASSWORD_CHANGE_REQUIRED\")\n      ) {\n        const errorDetails = errorObj.response?.error?.details;\n        if (errorDetails) {\n          const reqs: PasswordRequirements = {\n            requiresPasswordChange: errorDetails.requiresPasswordChange || true,\n            isTemporaryPassword: errorDetails.isTemporaryPassword || false,\n            passwordSetDate: errorDetails.passwordSetDate,\n            passwordExpiryDate: errorDetails.passwordExpiryDate,\n            daysUntilExpiry: errorDetails.daysUntilExpiry || 0,\n            reason:\n              errorObj.response?.error?.message || \"Password change required\",\n            canSkip: errorDetails.canSkip || false,\n          };\n\n          setRequirements(reqs);\n          setShowModal(true);\n        }\n      } else {\n        setError(\n          errorObj.message ||\n            \"An error occurred while checking password requirements\",\n        );\n      }\n    } finally {\n      setIsLoading(false);\n    }\n  }, [user, apiCall]);\n\n  const handlePasswordChanged = useCallback(() => {\n    setShowModal(false);\n    setRequirements(null);\n\n    // Optionally refresh the page or redirect\n    window.location.reload();\n  }, []);\n\n  // Check requirements when user changes or component mounts\n  useEffect(() => {\n    if (user) {\n      checkRequirements();\n    }\n  }, [user, checkRequirements]);\n\n  // Set up an interval to periodically check requirements (every 5 minutes)\n  useEffect(() => {\n    if (!user) return;\n\n    const interval = setInterval(\n      () => {\n        checkRequirements();\n      },\n      5 * 60 * 1000,\n    ); // 5 minutes\n\n    return () => clearInterval(interval);\n  }, [user, checkRequirements]);\n\n  return {\n    requirements,\n    isLoading,\n    error,\n    checkRequirements,\n    showModal,\n    setShowModal,\n    handlePasswordChanged,\n  };\n};\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\__tests__\\resume-service.promote-delete.test.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":21,"column":39,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":21,"endColumn":42,"suggestion