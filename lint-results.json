e escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":670,"column":58,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[22046,22063],"text":"Bachelor&apos;s Degree"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[22046,22063],"text":"Bachelor&lsquo;s Degree"},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[22046,22063],"text":"Bachelor&#39;s Degree"},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[22046,22063],"text":"Bachelor&rsquo;s Degree"},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":671,"column":54,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[22124,22139],"text":"Master&apos;s Degree"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[22124,22139],"text":"Master&lsquo;s Degree"},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[22124,22139],"text":"Master&#39;s Degree"},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[22124,22139],"text":"Master&rsquo;s Degree"},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":679,"column":17,"nodeType":"JSXOpeningElement","endLine":679,"endColumn":102},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":707,"column":17,"nodeType":"JSXOpeningElement","endLine":707,"endColumn":102}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":20,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  Search,\n  Filter,\n  ChevronDown,\n  SlidersHorizontal,\n  MapPin,\n  Briefcase,\n  GraduationCap,\n  Calendar,\n  Users,\n  Building2,\n  FileText,\n} from \"lucide-react\";\nimport { useState } from \"react\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent } from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\n\nexport type SearchContext = \"people\" | \"companies\" | \"resumes\" | \"jobs\" | \"all\";\n\nexport interface SearchFilters {\n  // Common filters\n  search?: string;\n  location?: string;\n\n  // People filters\n  role?: string;\n  skills?: string;\n  openToWork?: boolean;\n  experienceLevel?: string;\n\n  // Company filters\n  industry?: string;\n  size?: string;\n\n  // Resume filters\n  privacy?: string;\n  isMaster?: boolean;\n\n  // Job filters\n  employmentType?: string;\n  remote?: boolean;\n  salaryMin?: number;\n  salaryMax?: number;\n\n  // Advanced filters\n  searchRadius?: string;\n  education?: string;\n  datePosted?: string;\n  hasMedia?: boolean;\n}\n\nexport interface SearchBarProps {\n  context: SearchContext;\n  placeholder?: string;\n  value?: string;\n  filters?: SearchFilters;\n  showAdvanced?: boolean;\n  className?: string;\n  onSearch?: (_query: string) => void;\n  onFilterChange?: (_filters: SearchFilters) => void;\n  onClearFilters?: () => void;\n}\n\nconst contextConfig = {\n  people: {\n    placeholder: \"Search professionals by name, role, or skills...\",\n    icon: Users,\n    filterSections: [\n      \"role\",\n      \"location\",\n      \"skills\",\n      \"availability\",\n      \"experience\",\n    ],\n  },\n  companies: {\n    placeholder: \"Search companies, industries, or locations...\",\n    icon: Building2,\n    filterSections: [\"industry\", \"size\", \"location\"],\n  },\n  resumes: {\n    placeholder: \"Search resumes by name, title, or skills...\",\n    icon: FileText,\n    filterSections: [\"privacy\", \"type\", \"experience\", \"skills\"],\n  },\n  jobs: {\n    placeholder: \"Search jobs, companies, or skills...\",\n    icon: Briefcase,\n    filterSections: [\n      \"location\",\n      \"employmentType\",\n      \"experience\",\n      \"remote\",\n      \"salary\",\n    ],\n  },\n  all: {\n    placeholder: \"Search videos, professions, companies...\",\n    icon: Search,\n    filterSections: [\"location\", \"experience\", \"education\", \"datePosted\", \"media\"],\n  },\n};\n\nexport default function SearchBar({\n  context,\n  placeholder,\n  value = \"\",\n  filters = {},\n  showAdvanced = false,\n  className = \"\",\n  onSearch,\n  onFilterChange,\n  onClearFilters,\n}: SearchBarProps) {\n  const [searchQuery, setSearchQuery] = useState(value);\n  const [showFilters, setShowFilters] = useState(false);\n  const [showAdvancedFilters, setShowAdvancedFilters] = useState(showAdvanced);\n\n  const config = contextConfig[context];\n  const IconComponent = config.icon;\n\n  const handleSearchChange = (query: string) => {\n    setSearchQuery(query);\n    onSearch?.(query);\n  };\n\n  const handleFilterChange = (\n    key: string,\n    value: string | number | boolean | undefined,\n  ) => {\n    const newFilters = { ...filters, [key]: value };\n    onFilterChange?.(newFilters);\n  };\n\n  const clearAllFilters = () => {\n    setSearchQuery(\"\");\n    setShowFilters(false);\n    setShowAdvancedFilters(false);\n    onClearFilters?.();\n  };\n\n  const getActiveFilterCount = () => {\n    return Object.values(filters).filter(\n      (value) => value !== undefined && value !== \"\" && value !== null,\n    ).length;\n  };\n\n  const renderFilterSection = (section: string) => {\n    switch (section) {\n      case \"role\":\n        return (\n          <div>\n            <label className=\"text-sm font-medium mb-2 block\">Role</label>\n            <Select\n              value={filters.role || \"all\"}\n              onValueChange={(value) =>\n                handleFilterChange(\"role\", value === \"all\" ? undefined : value)\n              }\n            >\n              <SelectTrigger>\n                <SelectValue placeholder=\"All roles\" />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"all\">All roles</SelectItem>\n                <SelectItem value=\"job_seeker\">Job Seekers</SelectItem>\n                <SelectItem value=\"recruiter\">Recruiters</SelectItem>\n                <SelectItem value=\"employer\">Employers</SelectItem>\n              </SelectContent>\n            </Select>\n          </div>\n        );\n\n      case \"industry\":\n        return (\n          <div>\n            <label className=\"text-sm font-medium mb-2 block\">Industry</label>\n            <Select\n              value={filters.industry || \"all\"}\n              onValueChange={(value) =>\n                handleFilterChange(\n                  \"industry\",\n                  value === \"all\" ? undefined : value,\n                )\n              }\n            >\n              <SelectTrigger>\n                <SelectValue placeholder=\"All industries\" />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"all\">All industries</SelectItem>\n                <SelectItem value=\"Technology\">Technology</SelectItem>\n                <SelectItem value=\"Marketing Technology\">\n                  Marketing Technology\n                </SelectItem>\n                <SelectItem value=\"Cloud Infrastructure\">\n                  Cloud Infrastructure\n                </SelectItem>\n                <SelectItem value=\"Web Development\">Web Development</SelectItem>\n                <SelectItem value=\"Venture Capital\">Venture Capital</SelectItem>\n              </SelectContent>\n            </Select>\n          </div>\n        );\n\n      case \"size\":\n        return (\n          <div>\n            <label className=\"text-sm font-medium mb-2 block\">\n              Company Size\n            </label>\n            <Select\n              value={filters.size || \"all\"}\n              onValueChange={(value) =>\n                handleFilterChange(\"size\", value === \"all\" ? undefined : value)\n              }\n            >\n              <SelectTrigger>\n                <SelectValue placeholder=\"All sizes\" />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"all\">All sizes</SelectItem>\n                <SelectItem value=\"1-10\">1-10 employees</SelectItem>\n                <SelectItem value=\"10-50\">10-50 employees</SelectItem>\n                <SelectItem value=\"50-200\">50-200 employees</SelectItem>\n                <SelectItem value=\"200-500\">200-500 employees</SelectItem>\n                <SelectItem value=\"500+\">500+ employees</SelectItem>\n              </SelectContent>\n            </Select>\n          </div>\n        );\n\n      case \"location\":\n        return (\n          <div>\n            <label className=\"text-sm font-medium mb-2 block\">Location</label>\n            <Input\n              placeholder=\"City, State\"\n              value={filters.location || \"\"}\n              onChange={(e) => handleFilterChange(\"location\", e.target.value)}\n            />\n          </div>\n        );\n\n      case \"skills\":\n        return (\n          <div>\n            <label className=\"text-sm font-medium mb-2 block\">Skills</label>\n            <Input\n              placeholder=\"e.g. React, Python\"\n              value={filters.skills || \"\"}\n              onChange={(e) => handleFilterChange(\"skills\", e.target.value)}\n            />\n          </div>\n        );\n\n      case \"availability\":\n        return (\n          <div>\n            <label className=\"text-sm font-medium mb-2 block\">\n              Availability\n            </label>\n            <Select\n              value={filters.openToWork?.toString() || \"all\"}\n              onValueChange={(value) =>\n                handleFilterChange(\n                  \"openToWork\",\n                  value === \"all\" ? undefined : value === \"true\",\n                )\n              }\n            >\n              <SelectTrigger>\n                <SelectValue placeholder=\"All professionals\" />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"all\">All professionals</SelectItem>\n                <SelectItem value=\"true\">Open to work</SelectItem>\n                <SelectItem value=\"false\">Not looking</SelectItem>\n              </SelectContent>\n            </Select>\n          </div>\n        );\n\n      case \"experience\":\n        return (\n          <div>\n            <label className=\"text-sm font-medium mb-2 block flex items-center gap-1\">\n              <Briefcase className=\"w-3 h-3\" />\n              Experience Level\n            </label>\n            <Select\n              value={filters.experienceLevel || \"all\"}\n              onValueChange={(value) =>\n                handleFilterChange(\n                  \"experienceLevel\",\n                  value === \"all\" ? undefined : value,\n                )\n              }\n            >\n              <SelectTrigger>\n                <SelectValue placeholder=\"All levels\" />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"all\">All levels</SelectItem>\n                <SelectItem value=\"entry\">Entry Level</SelectItem>\n                <SelectItem value=\"mid\">Mid Level</SelectItem>\n                <SelectItem value=\"senior\">Senior Level</SelectItem>\n                <SelectItem value=\"executive\">Executive</SelectItem>\n              </SelectContent>\n            </Select>\n          </div>\n        );\n\n      case \"privacy\":\n        return (\n          <div>\n            <label className=\"text-sm font-medium mb-2 block\">Privacy</label>\n            <Select\n              value={filters.privacy || \"all\"}\n              onValueChange={(value) =>\n                handleFilterChange(\n                  \"privacy\",\n                  value === \"all\" ? undefined : value,\n                )\n              }\n            >\n              <SelectTrigger>\n                <SelectValue placeholder=\"All privacy levels\" />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"all\">All privacy levels</SelectItem>\n                <SelectItem value=\"private\">Private</SelectItem>\n                <SelectItem value=\"recruiter_only\">Recruiter Only</SelectItem>\n                <SelectItem value=\"public\">Public</SelectItem>\n              </SelectContent>\n            </Select>\n          </div>\n        );\n\n      case \"type\":\n        return (\n          <div>\n            <label className=\"text-sm font-medium mb-2 block\">Type</label>\n            <Select\n              value={\n                filters.isMaster === undefined\n                  ? \"all\"\n                  : filters.isMaster\n                    ? \"master\"\n                    : \"variation\"\n              }\n              onValueChange={(value) =>\n                handleFilterChange(\n                  \"isMaster\",\n                  value === \"all\" ? undefined : value === \"master\",\n                )\n              }\n            >\n              <SelectTrigger>\n                <SelectValue placeholder=\"All types\" />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"all\">All types</SelectItem>\n                <SelectItem value=\"master\">Master</SelectItem>\n                <SelectItem value=\"variation\">Variation</SelectItem>\n              </SelectContent>\n            </Select>\n          </div>\n        );\n\n      case \"employmentType\":\n        return (\n          <div>\n            <label className=\"text-sm font-medium mb-2 block\">\n              Employment Type\n            </label>\n            <Select\n              value={filters.employmentType || \"all\"}\n              onValueChange={(value) =>\n                handleFilterChange(\n                  \"employmentType\",\n                  value === \"all\" ? undefined : value,\n                )\n              }\n            >\n              <SelectTrigger>\n                <SelectValue placeholder=\"All types\" />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"all\">All types</SelectItem>\n                <SelectItem value=\"full-time\">Full-time</SelectItem>\n                <SelectItem value=\"part-time\">Part-time</SelectItem>\n                <SelectItem value=\"contract\">Contract</SelectItem>\n                <SelectItem value=\"internship\">Internship</SelectItem>\n              </SelectContent>\n            </Select>\n          </div>\n        );\n\n      case \"remote\":\n        return (\n          <div>\n            <label className=\"text-sm font-medium mb-2 block\">Remote</label>\n            <Select\n              value={filters.remote?.toString() || \"all\"}\n              onValueChange={(value) =>\n                handleFilterChange(\n                  \"remote\",\n                  value === \"all\" ? undefined : value === \"true\",\n                )\n              }\n            >\n              <SelectTrigger>\n                <SelectValue placeholder=\"All locations\" />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"all\">All locations</SelectItem>\n                <SelectItem value=\"true\">Remote only</SelectItem>\n                <SelectItem value=\"false\">On-site only</SelectItem>\n              </SelectContent>\n            </Select>\n          </div>\n        );\n\n      case \"salary\":\n        return (\n          <div className=\"col-span-2\">\n            <label className=\"text-sm font-medium mb-2 block\">\n              Salary Range\n            </label>\n            <div className=\"flex gap-2\">\n              <Input\n                type=\"number\"\n                placeholder=\"Min salary\"\n                value={filters.salaryMin || \"\"}\n                onChange={(e) =>\n                  handleFilterChange(\n                    \"salaryMin\",\n                    e.target.value ? parseInt(e.target.value) : undefined,\n                  )\n                }\n              />\n              <Input\n                type=\"number\"\n                placeholder=\"Max salary\"\n                value={filters.salaryMax || \"\"}\n                onChange={(e) =>\n                  handleFilterChange(\n                    \"salaryMax\",\n                    e.target.value ? parseInt(e.target.value) : undefined,\n                  )\n                }\n              />\n            </div>\n          </div>\n        );\n\n      case \"media\":\n        return (\n          <div>\n            <label className=\"text-sm font-medium mb-2 block\">Media</label>\n            <Select\n              value={filters.hasMedia?.toString() || \"all\"}\n              onValueChange={(value) =>\n                handleFilterChange(\n                  \"hasMedia\",\n                  value === \"all\" ? undefined : value === \"true\",\n                )\n              }\n            >\n              <SelectTrigger>\n                <SelectValue placeholder=\"All content\" />\n              </SelectTrigger>\n              <SelectContent>\n                <SelectItem value=\"all\">All content</SelectItem>\n                <SelectItem value=\"true\">With videos/images</SelectItem>\n                <SelectItem value=\"false\">Text only</SelectItem>\n              </SelectContent>\n            </Select>\n          </div>\n        );\n\n      default:\n        return null;\n    }\n  };\n\n  return (\n    <div className={`space-y-4 ${className}`}>\n      {/* Main Search Bar */}\n      <div className=\"flex flex-col md:flex-row gap-4 items-center justify-between\">\n        <div className=\"relative flex-1 max-w-md\">\n          <Search className=\"absolute left-3 top-1/2 transform -translate-y-1/2 text-muted-foreground h-4 w-4\" />\n          <Input\n            placeholder={placeholder || config.placeholder}\n            value={searchQuery}\n            onChange={(e) => handleSearchChange(e.target.value)}\n            className=\"pl-10\"\n          />\n        </div>\n\n        {/* Quick Filter Buttons */}\n        <div className=\"flex gap-2\">\n          {context !== \"all\" && (\n            <Button\n              variant=\"outline\"\n              size=\"sm\"\n              onClick={() => setShowFilters(!showFilters)}\n              className=\"gap-2\"\n            >\n              <Filter className=\"w-4 h-4\" />\n              Filters\n              {getActiveFilterCount() > 0 && (\n                <span className=\"bg-primary text-primary-foreground rounded-full px-1.5 py-0.5 text-xs min-w-[1.25rem] h-5 flex items-center justify-center\">\n                  {getActiveFilterCount()}\n                </span>\n              )}\n            </Button>\n          )}\n\n          {context === \"all\" && (\n            <Button\n              variant=\"outline\"\n              size=\"sm\"\n              onClick={() => setShowAdvancedFilters(!showAdvancedFilters)}\n              className=\"gap-2\"\n            >\n              <SlidersHorizontal className=\"w-4 h-4\" />\n              Advanced\n              <ChevronDown\n                className={`w-3 h-3 transition-transform ${showAdvancedFilters ? \"rotate-180\" : \"\"}`}\n              />\n            </Button>\n          )}\n        </div>\n      </div>\n\n      {/* Basic Filters Panel */}\n      {showFilters && context !== \"all\" && (\n        <Card>\n          <CardContent className=\"p-4\">\n            <div className=\"flex items-center justify-between mb-4\">\n              <h3 className=\"text-sm font-semibold text-foreground flex items-center gap-2\">\n                <IconComponent className=\"w-4 h-4\" />\n                {(context || \"all\").charAt(0).toUpperCase() +\n                  (context || \"all\").slice(1)}{\" \"}\n                Filters\n              </h3>\n              <Button\n                variant=\"ghost\"\n                size=\"sm\"\n                onClick={clearAllFilters}\n                className=\"text-xs\"\n              >\n                Clear All\n              </Button>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n              {config.filterSections.map((section) => (\n                <div key={section}>{renderFilterSection(section)}</div>\n              ))}\n            </div>\n          </CardContent>\n        </Card>\n      )}\n\n      {/* Advanced Filters Panel (for homepage) */}\n      {showAdvancedFilters && context === \"all\" && (\n        <Card>\n          <CardContent className=\"p-4\">\n            <div className=\"flex items-center justify-between mb-4\">\n              <h3 className=\"text-sm font-semibold text-foreground\">\n                Advanced Filters\n              </h3>\n              <Button\n                variant=\"ghost\"\n                size=\"sm\"\n                onClick={clearAllFilters}\n                className=\"text-xs\"\n              >\n                Clear All\n              </Button>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n              {/* Search Radius */}\n              <div className=\"space-y-2\">\n                <label className=\"text-xs font-medium text-muted-foreground flex items-center gap-1\">\n                  <MapPin className=\"w-3 h-3\" />\n                  Search Radius\n                </label>\n                <Select\n                  value={filters.searchRadius || \"25\"}\n                  onValueChange={(value) =>\n                    handleFilterChange(\"searchRadius\", value)\n                  }\n                >\n                  <SelectTrigger className=\"h-8 text-xs\">\n                    <SelectValue />\n                  </SelectTrigger>\n                  <SelectContent>\n                    <SelectItem value=\"5\">5 miles</SelectItem>\n                    <SelectItem value=\"10\">10 miles</SelectItem>\n                    <SelectItem value=\"25\">25 miles</SelectItem>\n                    <SelectItem value=\"50\">50 miles</SelectItem>\n                    <SelectItem value=\"100\">100 miles</SelectItem>\n                    <SelectItem value=\"remote\">Remote</SelectItem>\n                  </SelectContent>\n                </Select>\n              </div>\n\n              {/* Experience Level */}\n              <div className=\"space-y-2\">\n                <label className=\"text-xs font-medium text-muted-foreground flex items-center gap-1\">\n                  <Briefcase className=\"w-3 h-3\" />\n                  Experience Level\n                </label>\n                <Select\n                  value={filters.experienceLevel || \"all\"}\n                  onValueChange={(value) =>\n                    handleFilterChange(\n                      \"experienceLevel\",\n                      value === \"all\" ? undefined : value,\n                    )\n                  }\n                >\n                  <SelectTrigger className=\"h-8 text-xs\">\n                    <SelectValue />\n                  </SelectTrigger>\n                  <SelectContent>\n                    <SelectItem value=\"all\">All Levels</SelectItem>\n                    <SelectItem value=\"entry\">Entry Level</SelectItem>\n                    <SelectItem value=\"mid\">Mid Level</SelectItem>\