notifications, email: checked });\n                          try {\n                            await settingsService.updateNotificationSettings({ email: checked });\n                          } catch (e) {\n                            console.error(\"Failed to save notifications (email)\", e);\n                          }\n                        }}\n                      />\n                    </div>\n                    <Separator />\n                    <div className=\"flex items-center justify-between\">\n                      <div className=\"space-y-1\">\n                        <Label className=\"text-sm font-medium\">\n                          Push Notifications\n                        </Label>\n                        <p className=\"text-sm text-muted-foreground\">\n                          Receive browser push notifications\n                        </p>\n                      </div>\n                      <Switch\n                        checked={notifications.push}\n                        onCheckedChange={async (checked) => {\n                          setNotifications({ ...notifications, push: checked });\n                          try {\n                            await settingsService.updateNotificationSettings({ push: checked });\n                          } catch (e) {\n                            console.error(\"Failed to save notifications (push)\", e);\n                          }\n                        }}\n                      />\n                    </div>\n                    <Separator />\n                    <div className=\"flex items-center justify-between\">\n                      <div className=\"space-y-1\">\n                        <Label className=\"text-sm font-medium\">\n                          Marketing Communications\n                        </Label>\n                        <p className=\"text-sm text-muted-foreground\">\n                          Receive updates about new features and tips\n                        </p>\n                      </div>\n                      <Switch\n                        checked={notifications.marketing}\n                        onCheckedChange={async (checked) => {\n                          setNotifications({ ...notifications, marketing: checked });\n                          try {\n                            await settingsService.updateNotificationSettings({ marketing: checked });\n                          } catch (e) {\n                            console.error(\"Failed to save notifications (marketing)\", e);\n                          }\n                        }}\n                      />\n                    </div>\n                    <Separator />\n                    <div className=\"flex items-center justify-between\">\n                      <div className=\"space-y-1\">\n                        <Label className=\"text-sm font-medium\">\n                          Weekly Summary\n                        </Label>\n                        <p className=\"text-sm text-muted-foreground\">\n                          Get a weekly summary of your activity\n                        </p>\n                      </div>\n                      <Switch\n                        checked={notifications.weekly}\n                        onCheckedChange={async (checked) => {\n                          setNotifications({ ...notifications, weekly: checked });\n                          try {\n                            await settingsService.updateNotificationSettings({ weekly: checked });\n                          } catch (e) {\n                            console.error(\"Failed to save notifications (weekly)\", e);\n                          }\n                        }}\n                      />\n                    </div>\n                  </CardContent>\n                </Card>\n              </TabsContent>\n\n              {/* Privacy Tab */}\n              <TabsContent value=\"privacy\" className=\"space-y-6\">\n                <Card>\n                  <CardHeader>\n                    <CardTitle>Privacy Settings</CardTitle>\n                    <CardDescription>\n                      Control who can see your information and how it's used.\n                    </CardDescription>\n                  </CardHeader>\n                  <CardContent className=\"space-y-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <div className=\"space-y-1\">\n                        <Label className=\"text-sm font-medium\">\n                          Public Profile\n                        </Label>\n                        <p className=\"text-sm text-muted-foreground\">\n                          Make your profile visible to other users\n                        </p>\n                      </div>\n                      <Switch\n                        checked={privacy.profileVisible}\n                        disabled={savingPrivacy}\n                        onCheckedChange={(checked) => savePrivacyPatch({ profileVisible: checked })}\n                      />\n                    </div>\n                    <Separator />\n                    <div className=\"flex items-center justify-between\">\n                      <div className=\"space-y-1\">\n                        <Label className=\"text-sm font-medium\">\n                          Show Email Address\n                        </Label>\n                        <p className=\"text-sm text-muted-foreground\">\n                          Display email on your public profile\n                        </p>\n                      </div>\n                      <Switch\n                        checked={privacy.showEmail}\n                        disabled={savingPrivacy}\n                        onCheckedChange={async (checked) => {\n                          setPrivacy({ ...privacy, showEmail: checked });\n                          try {\n                            await settingsService.updatePrivacySettings({ showEmail: checked });\n                          } catch (e) {\n                            console.error(\"Failed to save privacy (show email)\", e);\n                          }\n                        }}\n                      />\n                    </div>\n                    <Separator />\n                    <div className=\"flex items-center justify-between\">\n                      <div className=\"space-y-1\">\n                        <Label className=\"text-sm font-medium\">\n                          Show Phone Number\n                        </Label>\n                        <p className=\"text-sm text-muted-foreground\">\n                          Display phone number on your public profile\n                        </p>\n                      </div>\n                      <Switch\n                        checked={privacy.showPhone}\n                        disabled={savingPrivacy}\n                        onCheckedChange={async (checked) => {\n                          setPrivacy({ ...privacy, showPhone: checked });\n                          try {\n                            await settingsService.updatePrivacySettings({ showPhone: checked });\n                          } catch (e) {\n                            console.error(\"Failed to save privacy (show phone)\", e);\n                          }\n                        }}\n                      />\n                    </div>\n                    <Separator />\n                    <div className=\"flex items-center justify-between\">\n                      <div className=\"space-y-1\">\n                        <Label className=\"text-sm font-medium\">\n                          Search Engine Indexing\n                        </Label>\n                        <p className=\"text-sm text-muted-foreground\">\n                          Allow search engines to index your profile\n                        </p>\n                      </div>\n                      <div className=\"flex items-center gap-3\">\n                        <Switch\n                          checked={privacy.indexable}\n                          disabled={savingPrivacy}\n                          onCheckedChange={(checked) => savePrivacyPatch({ indexable: checked })}\n                        />\n                      </div>\n                    </div>\n                  </CardContent>\n                </Card>\n              </TabsContent>\n\n              {/* Appearance Tab */}\n              <TabsContent value=\"appearance\" className=\"space-y-6\">\n                <Card>\n                  <CardHeader>\n                    <CardTitle>Appearance Settings</CardTitle>\n                    <CardDescription>\n                      Customize the look and feel of your experience.\n                    </CardDescription>\n                  </CardHeader>\n                  <CardContent className=\"space-y-4\">\n                    <div className=\"space-y-2\">\n                      <Label>Theme</Label>\n                      <Select value={appearance.theme} onValueChange={async (value) => {\n                        setAppearance({ ...appearance, theme: value as AccountSettings[\"theme\"] });\n                        try {\n                          await settingsService.updateAccountSettings({ theme: value as AccountSettings[\"theme\"] });\n                        } catch (e) {\n                          console.error(\"Failed to save appearance (theme)\", e);\n                        }\n                      }}>\n                        <SelectTrigger>\n                          <SelectValue />\n                        </SelectTrigger>\n                        <SelectContent>\n                          <SelectItem value=\"light\">Light</SelectItem>\n                          <SelectItem value=\"dark\">Dark</SelectItem>\n                          <SelectItem value=\"system\">System</SelectItem>\n                        </SelectContent>\n                      </Select>\n                    </div>\n                    <div className=\"space-y-2\">\n                      <Label>Language</Label>\n                      <Select value={appearance.language} onValueChange={async (value) => {\n                        setAppearance({ ...appearance, language: value });\n                        try {\n                          await settingsService.updateAccountSettings({ language: value });\n                        } catch (e) {\n                          console.error(\"Failed to save appearance (language)\", e);\n                        }\n                      }}>\n                        <SelectTrigger>\n                          <SelectValue />\n                        </SelectTrigger>\n                        <SelectContent>\n                          <SelectItem value=\"en\">English</SelectItem>\n                          <SelectItem value=\"es\">Spanish</SelectItem>\n                          <SelectItem value=\"fr\">French</SelectItem>\n                          <SelectItem value=\"de\">German</SelectItem>\n                        </SelectContent>\n                      </Select>\n                    </div>\n                    <div className=\"space-y-2\">\n                      <Label>Timezone</Label>\n                      <Select value={appearance.timezone} onValueChange={async (value) => {\n                        setAppearance({ ...appearance, timezone: value });\n                        try {\n                          await settingsService.updateAccountSettings({ timezone: value });\n                        } catch (e) {\n                          console.error(\"Failed to save appearance (timezone)\", e);\n                        }\n                      }}>\n                        <SelectTrigger>\n                          <SelectValue />\n                        </SelectTrigger>\n                        <SelectContent>\n                          <SelectItem value=\"UTC-8\">\n                            Pacific Time (UTC-8)\n                          </SelectItem>\n                          <SelectItem value=\"UTC-7\">\n                            Mountain Time (UTC-7)\n                          </SelectItem>\n                          <SelectItem value=\"UTC-6\">\n                            Central Time (UTC-6)\n                          </SelectItem>\n                          <SelectItem value=\"UTC-5\">\n                            Eastern Time (UTC-5)\n                          </SelectItem>\n                          <SelectItem value=\"utc+0\">GMT (UTC+0)</SelectItem>\n                        </SelectContent>\n                      </Select>\n                    </div>\n                  </CardContent>\n                </Card>\n              </TabsContent>\n\n              {/* Account Tab */}\n              <TabsContent value=\"account\" className=\"space-y-6\">\n                <Card>\n                  <CardHeader>\n                    <CardTitle>Account Management</CardTitle>\n                    <CardDescription>\n                      Manage your subscription, data, and account settings.\n                    </CardDescription>\n                  </CardHeader>\n                  <CardContent className=\"space-y-6\">\n                    {/* Email Verification Section */}\n                    <div className=\"rounded-md border p-4\">\n                      <div className=\"flex items-center justify-between\">\n                        <div>\n                          <h4 className=\"text-sm font-medium mb-1\">Email Verification</h4>\n                          <p className=\"text-sm text-muted-foreground\">\n                            {verification?.email}\n                          </p>\n                        </div>\n                        <Badge variant={verification && (verification.emailConfirmed || verification.isEmailVerified) ? \"default\" : \"destructive\"}>\n                          {verification && (verification.emailConfirmed || verification.isEmailVerified) ? \"Verified Γ£à\" : \"Not Verified Γ¥î\"}\n                        </Badge>\n                      </div>\n                      {!verification || !(verification.emailConfirmed || verification.isEmailVerified) ? (\n                        <div className=\"mt-3 flex items-center gap-2\">\n                          <Button\n                            size=\"sm\"\n                            onClick={async () => {\n                              const ok = await resendEmailVerification();\n                              if (ok) setResendCooldown(60);\n                            }}\n                            disabled={resendCooldown > 0}\n                          >\n                            {resendCooldown > 0 ? `Resend in ${resendCooldown}s` : \"Resend Verification Email\"}\n                          </Button>\n                          <Link to=\"/verify-email\" className=\"text-primary underline text-sm\">Go to verification page</Link>\n                        </div>\n                      ) : null}\n                    </div>\n                    <div>\n                      <h4 className=\"text-sm font-medium mb-2\">Data Export</h4>\n                      <p className=\"text-sm text-muted-foreground mb-4\">\n                        Download a copy of your data including profile, resumes,\n                        and activity.\n                      </p>\n                      <Button variant=\"outline\" className=\"gap-2\">\n                        <Download className=\"h-4 w-4\" />\n                        Download Data\n                      </Button>\n                    </div>\n                    <Separator />\n                    <div>\n                      <h4 className=\"text-sm font-medium mb-2\">Password</h4>\n                      <p className=\"text-sm text-muted-foreground mb-4\">\n                        Change your password to keep your account secure.\n                      </p>\n                      <Button variant=\"outline\" className=\"gap-2\">\n                        <RefreshCw className=\"h-4 w-4\" />\n                        Change Password\n                      </Button>\n                    </div>\n                    <Separator />\n                    <div>\n                      <h4 className=\"text-sm font-medium mb-2 text-destructive\">\n                        Delete Account\n                      </h4>\n                      <p className=\"text-sm text-muted-foreground mb-4\">\n                        Permanently delete your account and all associated data.\n                        This action cannot be undone.\n                      </p>\n                      <Button\n                        variant=\"destructive\"\n                        className=\"gap-2\"\n                        onClick={() => setDeleteDialogOpen(true)}\n                      >\n                        <Trash2 className=\"h-4 w-4\" />\n                        Delete Account\n                      </Button>\n                    </div>\n                  </CardContent>\n                </Card>\n              </TabsContent>\n            </Tabs>\n          </div>\n        </div>\n        <Footer />\n      </div>\n\n      {/* Delete Account Dialog */}\n      <DeleteAccountDialog\n        open={deleteDialogOpen}\n        onOpenChange={setDeleteDialogOpen}\n      />\n    </div>\n);\n}\n\nexport default function Settings() {\n  return (\n    <PasswordRequirementsProvider>\n      <SettingsContent />\n    </PasswordRequirementsProvider>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\Signup.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'err' is defined but never used.","line":124,"column":14,"nodeType":null,"messageId":"unusedVar","endLine":124,"endColumn":17}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  Eye,\n  EyeOff,\n  User,\n  Mail,\n  Lock,\n  Users,\n  Briefcase,\n  Building2,\n} from \"lucide-react\";\nimport { useState, useEffect } from \"react\";\nimport { Link, useNavigate, useLocation } from \"react-router-dom\";\nimport { useSEO } from \"@/lib/seo\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { ToggleGroup, ToggleGroupItem } from \"@/components/ui/toggle-group\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth, type UserRole, USER_ROLES } from \"@/lib/auth\";\n\nexport default function Signup() {\n  const location = useLocation();\n  const [firstName, setFirstName] = useState(\"\");\n  const [lastName, setLastName] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [confirmPassword, setConfirmPassword] = useState(\"\");\n  const [role, setRole] = useState<UserRole>(USER_ROLES.JOB_SEEKER);\n  const [showPassword, setShowPassword] = useState(false);\n  const [showConfirmPassword, setShowConfirmPassword] = useState(false);\n  const [isLoading, setIsLoading] = useState(false);\n  const [error, setError] = useState(\"\");\n\n  const [referralCode, setReferralCode] = useState(\"\");\n\n  // Handle URL parameters for role pre-selection\n  useEffect(() => {\n    const searchParams = new URLSearchParams(location.search);\n    const roleParam = searchParams.get(\"role\");\n    if (roleParam === \"recruiter\") {\n      setRole(USER_ROLES.RECRUITER);\n    } else if (roleParam === \"employer\") {\n      setRole(USER_ROLES.EMPLOYER);\n    }\n  }, [location.search]);\n\n  // Capture referral code from URL (?ref=CODE) and persist; fallback to stored value\n  useEffect(() => {\n    const searchParams = new URLSearchParams(location.search);\n    const code = searchParams.get(\"ref\");\n    if (code) {\n      setReferralCode(code);\n      try {\n        sessionStorage.setItem(\"ref\", code);\n      } catch {\n        // no-op\n      }\n    } else {\n      try {\n        const stored = sessionStorage.getItem(\"ref\");\n        if (stored) {\n          setReferralCode(stored);\n        }\n      } catch {\n        // no-op\n      }\n    }\n  }, [location.search]);\n\n  // SEO for signup page\n  useSEO(location.pathname);\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n\n  const { signup } = useAuth();\n  const navigate = useNavigate();\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsLoading(true);\n    setError(\"\");\n\n    // Validation\n    if (password !== confirmPassword) {\n      setError(\"Passwords do not match\");\n      setIsLoading(false);\n      return;\n    }\n\n    if (password.length < 6) {\n      setError(\"Password must be at least 6 characters long\");\n      setIsLoading(false);\n      return;\n    }\n\n    try {\n      const success = await signup(email, password, firstName, lastName, role, referralCode || undefined);\n      if (success) {\n        // Redirect to success page with email confirmation instructions\n        navigate(\n          `/signup-success?email=${encodeURIComponent(email)}&firstName=${encodeURIComponent(firstName)}`,\n        );\n      } else {\n        setError(\n          \"Account with this email already exists. Please sign in instead.\",\n        );\n      }\n    } catch (err) {\n      setError(\"An error occurred. Please try again.\");\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-background via-brand-purple/5 to-brand-blue/5\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16 min-h-screen flex items-center justify-center p-4\">\n          <div className=\"w-full max-w-md\">\n            <Card>\n              <CardHeader className=\"text-center\">\n                <CardTitle className=\"text-2xl\">Create your account</CardTitle>\n                <CardDescription>\n                  Join MyVideoResume and start building your career\n                </CardDescription>\n              </CardHeader>\n              <CardContent className=\"space-y-6\">\n                {error && (\n                  <Alert variant=\"destructive\">\n                    <AlertDescription>{error}</AlertDescription>\n                  </Alert>\n                )}\n\n                <form onSubmit={handleSubmit} className=\"space-y-4\">\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                    <div className=\"space-y-2\">\n                      <Label htmlFor=\"firstName\">First Name</Label>\n                      <div className=\"relative\">\n                        <User className=\"absolute left-3 top-3 h-4 w-4 text-muted-foreground\" />\n                        <Input\n                          id=\"firstName\"\n                          type=\"text\"\n                          placeholder=\"Enter your first name\"\n                          value={firstName}\n                          onChange={(e) => setFirstName(e.target.value)}\n                          className=\"pl-10\"\n                          required\n                        />\n                      </div>\n                    </div>\n                    <div className=\"space-y-2\">\n                      <Label htmlFor=\"lastName\">Last Name</Label>\n                      <div className=\"relative\">\n                        <User className=\"absolute left-3 top-3 h-4 w-4 text-muted-foreground\" />\n                        <Input\n                          id=\"lastName\"\n                          type=\"text\"\n                          placeholder=\"Enter your last name\"\n                          value={lastName}\n                          onChange={(e) => setLastName(e.target.value)}\n                          className=\"pl-10\"\n                          required\n                        />\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-2\">\n                    <Label htmlFor=\"email\">Email</Label>\n                    <div className=\"relative\">\n                      <Mail className=\"absolute left-3 top-3 h-4 w-4 text-muted-foreground\" />\n                      <Input\n                        id=\"email\"\n                        type=\"email\"\n                        placeholder=\"Enter your email\"\n                        value={email}\n                        onChange={(e) => setEmail(e.target.value)}\n                        className=\"pl-10\"\n                        required\n                      />\n                    </div>\n                  </div>\n\n                  {/* Persona selection */}\n                  <div className=\"space-y-2\">\n                    <Label>Registering as</Label>\n                    <div className=\"p-[2px] rounded-full bg-gradient-to-r from-brand-purple to-brand-blue inline-block\">\n                      <div className=\"bg-background rounded-full p-1\">\n                        <ToggleGroup\n                          type=\"single\"\n                          value={role}\n                          onValueChange={(v) => v && setRole(v as UserRole)}\n                        >\n                          <ToggleGroupItem\n                            value={USER_ROLES.JOB_SEEKER}\n                            className=\"rounded-full px-4 py-2 data-[state=on]:bg-gradient-to-r data-[state=on]:from-brand-purple data-[state=on]:to-brand-blue data-[state=on]:text-white\"\n                          >\n                            <Users className=\"h-4 w-4 mr-2\" /> Job Seeker\n                          </ToggleGroupItem>\n                          <ToggleGroupItem\n                            value={USER_ROLES.RECRUITER}\n                            className=\"rounded-full px-4 py-2 data-[state=on]:bg-gradient-to-r data-[state=on]:from-brand-purple data-[state=on]:to-brand-blue data-[state=on]:text-white\"\n\n                          >\n                            <Briefcase className=\"h-4 w-4 mr-2\" /> Recruiter\n                          </ToggleGroupItem>\n                          <ToggleGroupItem\n                            value={USER_ROLES.EMPLOYER}\n                            className=\"rounded-full px-4 py-2 data-[state=on]:bg-gradient-to-r data-[state=on]:from-brand-purple data-[state=on]:to-brand-blue data-[state=on]:text-white\"\n                          >\n                            <Building2 className=\"h-4 w-4 mr-2\" /> Employer\n                          </ToggleGroupItem>\n                        </ToggleGroup>\n                      </div>\n                    </div>\n                  </div>\n\n\t                  <div className=\"text-sm text-muted-foreground\">\n\t                    Interested in becoming an affiliate?{\" \"}\n\t                    <Link to=\"/affiliate-program\" className=\"text-primary hover:underline\">\n\t                      Sign up on the affiliate page\n\t                    </Link>.\n\t                  </div>\n\n\n                  {/* Referral code */}\n                  <div className=\"space-y-2\">\n                    <Label htmlFor=\"referralCode\">Referral Code (optional)</Label>\n                    <Input\n                      id=\"referralCode\"\n                      type=\"text\"\n\n\n                      placeholder=\"Have a referral code? Enter it here\"\n                      value={referralCode}\n                      onChange={(e) => setReferralCode(e.target.value)}\n                    />\n                  </div>\n\n\n                  <div className=\"space-y-2\">\n                    <Label htmlFor=\"password\">Password</Label>\n                    <div className=\"relative\">\n                      <Lock className=\"absolute left-3 top-3 h-4 w-4 text-muted-foreground\" />\n                      <Input\n                        id=\"password\"\n\n\n                        type={showPassword ? \"text\" : \"password\"}\n                        placeholder=\"Create a password\"\n                        value={password}\n                        onChange={(e) => setPassword(e.target.value)}\n                        className=\"pl-10 pr-10\"\n                        required\n                      />\n                      <Button\n                        type=\"button\"\n                        variant=\"ghost\"\n                        size=\"icon\"\n                        className=\"absolute right-0 top-0 h-full px-3 py-2 hover:bg-transparent\"\n                        onClick={() => setShowPassword(!showPassword)}\n                      >\n                        {showPassword ? (\n                          <EyeOff className=\"h-4 w-4 text-muted-foreground\" />\n                        ) : (\n                          <Eye className=\"h-4 w-4 text-muted-foreground\" />\n                        )}\n                      </Button>\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-2\">\n                    <Label htmlFor=\"confirmPassword\">Confirm Password</Label>\n                    <div className=\"relative\">\n                      <Lock className=\"absolute left-3 top-3 h-4 w-4 text-muted-foreground\" />\n                      <Input\n                        id=\"confirmPassword\"\n                        type={showConfirmPassword ? \"text\" : \"password\"}\n                        placeholder=\"Confirm your password\"\n                        value={confirmPassword}\n                        onChange={(e) => setConfirmPassword(e.target.value)}\n                        className=\"pl-10 pr-10\"\n                        required\n                      />\n                      <Button\n                        type=\"button\"\n                        variant=\"ghost\"\n                        size=\"icon\"\n                        className=\"absolute right-0 top-0 h-full px-3 py-2 hover:bg-transparent\"\n                        onClick={() =>\n                          setShowConfirmPassword(!showConfirmPassword)\n                        }\n                      >\n                        {showConfirmPassword ? (\n                          <EyeOff className=\"h-4 w-4 text-muted-foreground\" />\n                        ) : (\n                          <Eye className=\"h-4 w-4 text-muted-foreground\" />\n                        )}\n                      </Button>\n                    </div>\n                  </div>\n\n                  <Button\n                    type=\"submit\"\n                    className=\"w-full bg-gradient-to-r from-brand-purple to-brand-blue hover:opacity-90\"\n                    disabled={isLoading}\n                  >\n                    {isLoading ? \"Creating account...\" : \"Create Account\"}\n                  </Button>\n                </form>\n\n                <div className=\"text-center\">\n                  <p className=\"text-sm text-muted-foreground\">\n                    Already have an account?{\" \"}\n                    <Link\n                      to=\"/login\"\n                      className=\"text-primary hover:underline font-medium\"\n                    >\n                      Sign in\n                    </Link>\n                  </p>\n                </div>\n\n                <div className=\"text-xs text-center text-muted-foreground\">\n                  By creating an account, you agree to our{\" \"}\n                  <Link to=\"/terms\" className=\"text-primary hover:underline\">\n                    Terms of Service\n                  </Link>{\" \"}\n                  and{\" \"}\n                  <Link to=\"/privacy\" className=\"text-primary hover:underline\">\n                    Privacy Policy\n                  </Link>\n                </div>\n              </CardContent>\n            </Card>\n          </div>\n        </div>\n        <Footer />\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\SignupSuccess.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":67,"column":23,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[2472,2528],"text":"\n                    We&apos;ve sent a confirmation email to "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[2472,2528],"text":"\n                    We&lsquo;ve sent a confirmation email to "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[2472,2528],"text":"\n                    We&#39;ve sent a confirmation email to "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[2472,2528],"text":"\n                    We&rsquo;ve sent a confirmation email to "},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":90,"column":