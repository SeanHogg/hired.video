Never","fix":{"range":[48002,48005],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":1179,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":1179,"endColumn":43,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[48517,48520],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[48517,48520],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":1185,"column":46,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":1185,"endColumn":49,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[48839,48842],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[48839,48842],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":1186,"column":45,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":1186,"endColumn":48,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[48913,48916],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[48913,48916],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":1187,"column":54,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":1187,"endColumn":57,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[48993,48996],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[48993,48996],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":1187,"column":124,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":1187,"endColumn":127,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[49063,49066],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[49063,49066],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":1187,"column":190,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":1187,"endColumn":193,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[49129,49132],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[49129,49132],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":39,"fatalErrorCount":0,"warningCount":11,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  MapPin,\n  Globe,\n  Mail,\n  Phone,\n  Edit,\n  Share,\n  Bookmark,\n  BookmarkCheck,\n  Users,\n  Eye,\n  Calendar,\n  Building2,\n  MessageCircle,\n  UserPlus,\n  ExternalLink,\n  ArrowLeft,\n  Briefcase,\n  GraduationCap,\n  Award,\n  CheckCircle,\n  Clock,\n  Star,\n  Linkedin,\n  Github,\n  X,\n  Send,\n  Loader2,\n  FileText,\n} from \"lucide-react\";\nimport { useState, useEffect } from \"react\";\nimport { useParams, useNavigate, Link , useLocation } from \"react-router-dom\";\nimport AuthOverlay from \"@/components/AuthOverlay\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport {\n  Dialog,\n  DialogContent,\n  DialogDescription,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from \"@/components/ui/dialog\";\nimport { Separator } from \"@/components/ui/separator\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { userService, type UserProfile } from \"@/lib/services/user-service\";\nimport { resumeService } from \"@/lib/services/resume-service\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\nimport { getRoleDisplayLabel } from \"@/lib/role-utils\";\nimport { useSEO, generateStructuredData } from \"@/lib/seo\";\nimport { dashboardService } from \"@/lib/services/dashboard-service\";\n\nimport ResumeCard from \"@/components/ResumeCard\";\n\nexport default function PeopleDetail() {\n  const { id } = useParams<{ id: string }>();\n  const navigate = useNavigate();\n  const { user, isAuthenticated } = useAuth();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const location = useLocation();\n\n  const [expandedSections, setExpandedSections] = useState<{\n    [key: string]: boolean;\n  }>({\n    about: true,\n    experience: true,\n    education: false,\n    skills: true,\n    projects: false,\n  });\n  const [connectionMessage, setConnectionMessage] = useState(\"\");\n  const [showConnectionDialog, setShowConnectionDialog] = useState(false);\n\n  // API state management\n  const [userProfile, setUserProfile] = useState<UserProfile | null>(null);\n  const [isLoading, setIsLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  // Load user profile from API\n  useEffect(() => {\n    const loadUserProfile = async () => {\n      if (!id) {\n        setError(\"User ID is required\");\n        setIsLoading(false);\n        return;\n      }\n\n      try {\n        setIsLoading(true);\n        setError(null);\n\n        // Try to determine if the ID is a UUID or a slug\n        const isUUID =\n          /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(\n            id,\n          );\n\n        let profile: UserProfile;\n        if (isUUID) {\n          // Use getUserById for UUIDs\n          profile = await userService.getUserById(id);\n        } else {\n          // Try getUserBySlug for non-UUID strings, fallback to getUserById\n          try {\n            profile = await userService.getUserBySlug(id);\n          } catch (slugError) {\n            // If slug lookup fails, try as ID (API might accept both)\n            profile = await userService.getUserById(id);\n          }\n        }\n\n        setUserProfile(profile);\n      } catch (err) {\n        console.error(\"Failed to load user profile:\", err);\n        setError(\n          err instanceof Error ? err.message : \"Failed to load user profile\",\n        );\n      } finally {\n        setIsLoading(false);\n      }\n    };\n\n    loadUserProfile();\n  }, [id]);\n\n  // For backward compatibility with existing code, create a person object\n  // that matches the expected structure from mock data\n  const person = userProfile\n    ? {\n        id: userProfile.id,\n        slug:\n          userProfile.slug ||\n          `${userProfile.firstName || ''}-${userProfile.lastName || ''}`\n            .toLowerCase()\n            .replace(/\\s+/g, \"-\"),\n        role: userProfile.role, // Add role property for proper role display\n        data: {\n          firstName: userProfile.firstName,\n          lastName: userProfile.lastName,\n          avatar: userProfile.profilePicture,\n          headline: `${getRoleDisplayLabel(userProfile.role)} | ${userProfile.location || \"Remote\"}`,\n          summary:\n            userProfile.bio ||\n            `${userProfile.firstName || ''} ${userProfile.lastName || ''} is a ${getRoleDisplayLabel(userProfile.role)} professional.`.trim(),\n          location: {\n            city: userProfile.location?.split(\",\")[0]?.trim() || \"\",\n            state: userProfile.location?.split(\",\")[1]?.trim() || \"\",\n            country: \"USA\",\n            remote: true,\n          },\n          contact: {\n            email: userProfile.email,\n            website: userProfile.website,\n            linkedin: userProfile.linkedIn,\n            github: userProfile.github,\n          },\n          experience: [], // TODO: Add experience data when available from API\n          education: [], // TODO: Add education data when available from API\n          skills:\n            userProfile.skills?.map((skill) => ({\n              name: skill,\n              level: \"Intermediate\" as const,\n              endorsed: false,\n            })) || [],\n          projects: [], // TODO: Add projects data when available from API\n          openToWork: userProfile.openToWork || false,\n          openToOpportunities: [\"full-time\"],\n        },\n        createdAt: userProfile.createdAt,\n        updatedAt: userProfile.updatedAt,\n      }\n    : null;\n\n  // For now, use mock data for tracking and connections until API is available\n  const isTracked = false; // TODO: Implement with real API\n  const [connectionStatus] = useState<\n    \"none\" | \"pending_received\" | \"pending_sent\" | \"connected\"\n  >(\"none\"); // TODO: Implement with real API\n  const isOwnProfile = user && userProfile && userProfile.id === user.id;\n\n  // Check if person has a public Master resume and fetch it\n  const [hasPublicMasterResume, setHasPublicMasterResume] = useState(false);\n  const [publicMasterResume, setPublicMasterResume] = useState<import(\"@/lib/services/user-service\").ResumeSummary | null>(null);\n\n  useEffect(() => {\n    let isMounted = true;\n    const load = async () => {\n      if (!userProfile?.id) {\n        setHasPublicMasterResume(false);\n        setPublicMasterResume(null);\n        return;\n      }\n      try {\n        // Use the user service to get their public resumes\n        const userResumes = await userService.getUserResumes(userProfile.id);\n        if (!isMounted) return;\n\n        // Find the Master resume from the user's public resumes\n        const masterResume = userResumes.find((r) => r.isMaster === true);\n\n        if (masterResume) {\n          setPublicMasterResume(masterResume);\n          setHasPublicMasterResume(true);\n        } else {\n          setHasPublicMasterResume(false);\n          setPublicMasterResume(null);\n        }\n      } catch (error) {\n        console.error('Error fetching user resumes:', error);\n        if (isMounted) {\n          setHasPublicMasterResume(false);\n          setPublicMasterResume(null);\n        }\n      }\n    };\n    load();\n    return () => {\n      isMounted = false;\n    };\n  }, [userProfile?.id]);\n\n  // SEO: update title/description and structured data at top-level (hooks must not be called inside callbacks)\n  const fullName = userProfile ? `${userProfile.firstName || ''} ${userProfile.lastName || ''}`.trim() : '';\n  const seoTitle = userProfile\n    ? `${fullName} | ${getRoleDisplayLabel(userProfile.role)} | MyVideoResu.me`\n    : undefined;\n  const seoDescription = userProfile\n    ? userProfile.bio || `${fullName} is a ${getRoleDisplayLabel(userProfile.role)}.`\n    : undefined;\n  const structuredData = userProfile\n    ? generateStructuredData.person({\n        name: fullName,\n        title: getRoleDisplayLabel(userProfile.role),\n        bio: userProfile.bio,\n        avatar: userProfile.profilePicture,\n        id: userProfile.id,\n      })\n    : undefined;\n  useSEO(location.pathname, {\n    title: seoTitle,\n    description: seoDescription,\n    ogTitle: seoTitle,\n    ogDescription: seoDescription,\n    structuredData,\n  });\n\n  // Track profile view when profile loads\n  useEffect(() => {\n    if (!userProfile?.id) return;\n\n    // Record profile view for analytics\n    const recordView = async () => {\n      try {\n        await dashboardService.recordProfileView({\n          profileUserId: userProfile.id,\n          viewType: \"profile\",\n        });\n      } catch (error) {\n        // Don't throw - view tracking is not critical\n        console.warn(\"Failed to record profile view:\", error);\n      }\n    };\n\n    recordView();\n  }, [userProfile?.id]);\n\n  const toggleSection = (section: string) => {\n    setExpandedSections((prev) => ({\n      ...prev,\n      [section]: !prev[section],\n    }));\n  };\n\n  const handleTrackPerson = () => {\n    if (!isAuthenticated || !userProfile) {\n      return;\n    }\n    // TODO: Implement with real API\n    console.log(\"Track person:\", userProfile.id);\n  };\n\n  const handleSendConnectionRequest = async () => {\n    if (!isAuthenticated || !userProfile) {\n      return;\n    }\n\n    try {\n      await userService.sendConnectionRequest({\n        toUserId: userProfile.id,\n        message: connectionMessage,\n      });\n      setShowConnectionDialog(false);\n      setConnectionMessage(\"\");\n      // TODO: Update connection status in state\n    } catch (error) {\n      console.error(\"Failed to send connection request:\", error);\n    }\n  };\n\n  const handleAcceptConnection = async () => {\n    if (!isAuthenticated || !userProfile) {\n      return;\n    }\n    // TODO: Implement with real API\n    console.log(\"Accept connection from:\", userProfile.id);\n  };\n\n  const handleRejectConnection = async () => {\n    if (!isAuthenticated || !userProfile) {\n      return;\n    }\n    // TODO: Implement with real API\n    console.log(\"Reject connection from:\", userProfile.id);\n  };\n\n  const handleMessage = () => {\n    // Navigate to messaging or open message modal\n    console.log(\"Message person:\", userProfile?.id);\n  };\n\n  // Loading state\n  if (isLoading) {\n    return (\n      <div className=\"min-h-screen bg-background\">\n        <Sidebar\n          isOpen={sidebarOpen}\n          onClose={closeSidebar}\n          collapsed={sidebarCollapsed}\n        />\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n          <Navigation\n            onMenuClick={openSidebar}\n            onSidebarToggle={toggleSidebar}\n            sidebarCollapsed={sidebarCollapsed}\n          />\n          <div className=\"pt-16 p-6\">\n            <div className=\"max-w-4xl mx-auto text-center\">\n              <Loader2 className=\"h-8 w-8 animate-spin mx-auto mb-4\" />\n              <h1 className=\"text-2xl font-bold mb-4\">Loading Profile...</h1>\n              <p className=\"text-muted-foreground\">\n                Please wait while we fetch the user profile.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  // Error state\n  if (error || !person) {\n    return (\n      <div className=\"min-h-screen bg-background\">\n        <Sidebar\n          isOpen={sidebarOpen}\n          onClose={closeSidebar}\n          collapsed={sidebarCollapsed}\n        />\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n          <Navigation\n            onMenuClick={openSidebar}\n            onSidebarToggle={toggleSidebar}\n            sidebarCollapsed={sidebarCollapsed}\n          />\n          <div className=\"pt-16 p-6\">\n            <div className=\"max-w-4xl mx-auto text-center\">\n              <Alert className=\"mb-6\">\n                <AlertDescription>\n                  {error ||\n                    \"The profile you're looking for doesn't exist or has been\"}\n                </AlertDescription>\n              </Alert>\n              <h1 className=\"text-2xl font-bold mb-4\">Profile Not Found</h1>\n              <p className=\"text-muted-foreground mb-6\">\n                The profile you're looking for doesn't exist or has been\n                removed.\n              </p>\n              <Button asChild>\n                <Link to=\"/people\">\n                  <ArrowLeft className=\"h-4 w-4 mr-2\" />\n                  Back to People\n                </Link>\n              </Button>\n            </div>\n          </div>\n          <Footer />\n        </div>\n      </div>\n    );\n  }\n\n  const getStatusColor = (status: string) => {\n    switch (status) {\n      case \"active\":\n        return \"bg-green-100 text-green-800\";\n      case \"looking\":\n        return \"bg-blue-100 text-blue-800\";\n      case \"busy\":\n        return \"bg-yellow-100 text-yellow-800\";\n      case \"inactive\":\n        return \"bg-gray-100 text-gray-800\";\n      default:\n        return \"bg-gray-100 text-gray-800\";\n    }\n  };\n\n  const currentPosition = person.data.experience.find((exp) => exp.isCurrent);\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className={`pt-16 ${!isAuthenticated ? \"relative\" : \"\"}`}>\n          {!isAuthenticated && (\n            <AuthOverlay\n              contentType=\"person\"\n              title={\n                person?.data.firstName && person?.data.lastName\n                  ? `${person.data.firstName} ${person.data.lastName}`\n                  : person?.data.firstName || person?.data.lastName || \"User Profile\"\n              }\n            />\n          )}\n          <div className=\"max-w-6xl mx-auto p-6\">\n            {/* Back Button */}\n            <div className=\"mb-6\">\n              <Button variant=\"outline\" onClick={() => navigate(\"/people\")}>\n                <ArrowLeft className=\"h-4 w-4 mr-2\" />\n                Back to People\n              </Button>\n            </div>\n\n            {/* Profile Header */}\n            <div className=\"mb-8\">\n              <Card>\n                <CardHeader className=\"pb-6\">\n                  <div className=\"flex flex-col lg:flex-row gap-6\">\n                    {/* Profile Avatar */}\n                    <div className=\"flex-shrink-0\">\n                      <Avatar className=\"w-32 h-32\">\n                        <AvatarImage\n                          src={person.data.avatar}\n                          alt={`${person.data.firstName} ${person.data.lastName}`}\n                        />\n                        <AvatarFallback className=\"text-4xl\">\n                          {person.data.firstName.charAt(0)}\n                          {person.data.lastName.charAt(0)}\n                        </AvatarFallback>\n                      </Avatar>\n                    </div>\n\n                    {/* Profile Info */}\n                    <div className=\"flex-1\">\n                      <div className=\"flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-4\">\n                        <div>\n                          <div className=\"flex items-center gap-2 mb-2\">\n                            <h1 className=\"text-3xl font-bold\">\n                              {person.data.firstName && person.data.lastName\n                                ? `${person.data.firstName} ${person.data.lastName}`\n                                : person.data.firstName || person.data.lastName || \"User\"}\n                            </h1>\n                            {(person as any).isVerified && (\n                              <CheckCircle className=\"h-6 w-6 text-blue-600\" />\n                            )}\n                            {(person as any).isPremium && (\n                              <Star className=\"h-6 w-6 text-yellow-500\" />\n                            )}\n                          </div>\n                          <CardDescription className=\"text-xl mb-3\">\n                            {person.data.headline}\n                          </CardDescription>\n                          <div className=\"flex items-center gap-4 text-sm text-muted-foreground mb-2\">\n                            <div className=\"flex items-center gap-1\">\n                              <Building2 className=\"h-4 w-4\" />\n                              <span>\n                                {getRoleDisplayLabel(person?.role || \"JobSeeker\")}\n                              </span>\n                            </div>\n                            <div className=\"flex items-center gap-1\">\n                              <MapPin className=\"h-4 w-4\" />\n                              <span>\n                                {person.data.location.remote\n                                  ? \"Remote\"\n                                  : `${person.data.location.city}, ${person.data.location.state}`}\n                              </span>\n                            </div>\n                          </div>\n                          {currentPosition && (\n                            <div className=\"flex items-center gap-2 text-sm\">\n                              <Briefcase className=\"h-4 w-4 text-muted-foreground\" />\n                              <span>\n                                {currentPosition.title} at{\" \"}\n                                {currentPosition.company}\n                              </span>\n                            </div>\n                          )}\n                        </div>\n\n                        <div className=\"flex items-center gap-2\">\n                          <Badge\n                            className={getStatusColor(\n                              (person as any).status || \"active\",\n                            )}\n                          >\n                            {(person as any).status || \"active\"}\n                          </Badge>\n                          {person.data.openToWork && (\n                            <Badge\n                              variant=\"outline\"\n                              className=\"bg-green-50 text-green-700\"\n                            >\n                              Open to Work\n                            </Badge>\n                          )}\n                        </div>\n                      </div>\n\n                      {/* Action Buttons */}\n                      {!isOwnProfile && user && (\n                        <div className=\"flex items-center gap-3 mb-4\">\n                          {connectionStatus === \"pending_received\" ? (\n                            <div className=\"flex gap-2\">\n                              <Button onClick={handleAcceptConnection}>\n                                <CheckCircle className=\"h-4 w-4 mr-2\" />\n                                Accept Connection\n                              </Button>\n                              <Button\n                                variant=\"outline\"\n                                onClick={handleRejectConnection}\n                              >\n                                <X className=\"h-4 w-4 mr-2\" />\n                                Decline\n                              </Button>\n                            </div>\n                          ) : connectionStatus === \"pending_sent\" ? (\n                            <Button variant=\"outline\" disabled>\n                              <Clock className=\"h-4 w-4 mr-2\" />\n                              Connection Pending\n                            </Button>\n                          ) : connectionStatus === \"connected\" ? (\n                            <Button onClick={handleMessage}>\n                              <MessageCircle className=\"h-4 w-4 mr-2\" />\n                              Message\n                            </Button>\n                          ) : (\n                            <Dialog\n                              open={showConnectionDialog}\n                              onOpenChange={setShowConnectionDialog}\n                            >\n                              <DialogTrigger asChild>\n                                <Button>\n                                  <UserPlus className=\"h-4 w-4 mr-2\" />\n                                  Connect\n                                </Button>\n                              </DialogTrigger>\n                              <DialogContent>\n                                <DialogHeader>\n                                  <DialogTitle>\n                                    Send Connection Request\n                                  </DialogTitle>\n                                  <DialogDescription>\n                                    Add a personal message to your connection\n                                    request to {person.data.firstName}.\n                                  </DialogDescription>\n                                </DialogHeader>\n                                <div className=\"space-y-4\">\n                                  <Textarea\n                                    placeholder=\"I'd love to connect and expand my professional network...\"\n                                    value={connectionMessage}\n                                    onChange={(e) =>\n                                      setConnectionMessage(e.target.value)\n                                    }\n                                    rows={3}\n                                  />\n                                  <div className=\"flex justify-end gap-2\">\n                                    <Button\n                                      variant=\"outline\"\n                                      onClick={() =>\n                                        setShowConnectionDialog(false)\n                                      }\n                                    >\n                                      Cancel\n                                    </Button>\n                                    <Button\n                                      onClick={handleSendConnectionRequest}\n                                    >\n                                      <Send className=\"h-4 w-4 mr-2\" />\n                                      Send Request\n                                    </Button>\n                                  </div>\n                                </div>\n                              </DialogContent>\n                            </Dialog>\n                          )}\n\n                          <Button variant=\"outline\" onClick={handleTrackPerson}>\n                            {isTracked ? (\n                              <>\n                                <BookmarkCheck className=\"h-4 w-4 mr-2\" />\n                                Following\n                              </>\n                            ) : (\n                              <>\n                                <Bookmark className=\"h-4 w-4 mr-2\" />\n                                Follow\n                              </>\n                            )}\n                          </Button>\n\n                          <Button variant=\"outline\" size=\"icon\">\n                            <Share className=\"h-4 w-4\" />\n                          </Button>\n                        </div>\n                      )}\n\n                      {/* Own Profile Edit Button */}\n                      {isOwnProfile && (\n                        <div className=\"mb-4\">\n                          <Button asChild>\n                            <Link to=\"/profile\">\n                              <Edit className=\"h-4 w-4 mr-2\" />\n                              Edit Profile\n                            </Link>\n                          </Button>\n                        </div>\n                      )}\n\n                      {/* Stats */}\n                      <div className=\"grid grid-cols-3 gap-4 text-center\">\n                        <div>\n                          <div className=\"text-2xl font-bold text-primary\">\n                            {(person as any).connectionCount || 0}\n                          </div>\n                          <div className=\"text-sm text-muted-foreground\">\n                            Connections\n                          </div>\n                        </div>\n                        <div>\n                          <div className=\"text-2xl font-bold text-primary\">\n                            {(person as any).followerCount || 0}\n                          </div>\n                          <div className=\"text-sm text-muted-foreground\">\n                            Followers\n                          </div>\n                        </div>\n                        <div>\n                          <div className=\"text-2xl font-bold text-primary\">\n                            {(person as any).profileViews || 0}\n                          </div>\n                          <div className=\"text-sm text-muted-foreground\">\n                            Profile Views\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </CardHeader>\n              </Card>\n            </div>\n\n            <div className=\"grid lg:grid-cols-3 gap-6\">\n              {/* Main Content */}\n              <div className=\"lg:col-span-2 space-y-6\">\n                {/* About Section */}\n                <Card>\n                  <CardHeader>\n                    <CardTitle>About</CardTitle>\n                  </CardHeader>\n                  <CardContent>\n                    <p className=\"whitespace-pre-line leading-relaxed\">\n                      {person.data.summary}\n                    </p>\n                  </CardContent>\n                </Card>\n\n                {/* Professional Details - Show Master resume if available */}\n                {hasPublicMasterResume ? (\n                  <>\n                    {/* Experience Section */}\n                    <Card>\n                      <CardHeader>\n                        <CardTitle className=\"flex items-center gap-2\">\n                          <Briefcase className=\"h-5 w-5\" />\n                          Experience\n                        </CardTitle>\n                      </CardHeader>\n                      <CardContent>\n                        <div className=\"space-y-6\">\n                          {/* Master Resume Card */}\n                          {publicMasterResume && (\n                            <div className=\"mb-6\">\n                              <div className=\"flex items-center gap-2 mb-3\">\n                                <FileText className=\"h-4 w-4 text-primary\" />\n                                <h3 className=\"font-medium text-sm\">Master Resume</h3>\n                              </div>\n                              <div className=\"max-w-md\">\n                                <ResumeCard\n                                  id={publicMasterResume.id}\n                                  slug={publicMasterResume.slug}\n                                  name={publicMasterResume.name || \"Master Resume\"}\n                                  title={undefined}\n                                  summary={publicMasterResume.description || \"Professional master resume\"}\n                                  createdAt={publicMasterResume.createdAt || new Date().toISOString()}\n                                  views={publicMasterResume.views || 0}\n                                  privacy=\"public\"\n                                  isMaster={true}\n                                  isActive={publicMasterResume.isActive || false}\n                                  ownership=\"tracked\"\n                                  onView={() => {\n                                    const resumeId = publicMasterResume.id;\n                                    const resumeSlug = publicMasterResume.slug;\n                                    // Use slug if available, otherwise use ID\n                                    const identifier = resumeSlug || resumeId;\n                                    window.open(`/resumes/${identifier}`, '_blank');\n                                  }}\n                                />\n                              </div>\n                            </div>\n                          )}\n\n                          {person.data.experience.map((exp, index) => (\n                            <div key={index} className=\"flex gap-4\">\n                              <div className=\"flex-shrink-0\">\n                                <div className=\"w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center\">\n                                  <Building2 className=\"h-6 w-6 text-primary\" />\n                                </div>\n                              </div>\n                              <div className=\"flex-1\">\n                                <div className=\"flex items-start justify-between mb-2\">\n                                  <div>\n                                    <h3 className=\"font-semibold text-lg\">\n                                      {exp.title}\n                                    </h3>\n                                    <p className=\"text-muted-foreground\">\n                                      {exp.company}\n                                    </p>\n                                    {exp.location && (\n                                      <p className=\"text-sm text-muted-foreground\">\n                                        {exp.location}\n                                      </p>\n                                    )}\n                                  </div>\n                                  {exp.isCurrent && (\n                                    <Badge\n                                      variant=\"outline\"\n                                      className=\"bg-green-50 text-green-700\"\n                                    >\n                                      Current\n                                    </Badge>\n                                  )}\n                                </div>\n                                <p className=\"text-sm text-muted-foreground mb-2\">\n                                  {exp.startDate} - {exp.endDate || \"Present\"}\n                                </p>\n                                {exp.description && (\n                                  <p className=\"text-sm mb-3\">\n                                    {exp.description}\n                                  </p>\n                                )}\n                                {exp.skills && exp.skills.length > 0 && (\n                                  <div className=\"flex flex-wrap gap-1\">\n                                    {exp.skills.map((skill, skillIndex) => (\n                                      <Badge\n                                        key={skillIndex}\n                                        variant=\"secondary\"\n                                        className=\"text-xs\"\n                                      >\n                                        {skill}\n                                      </Badge>\n                                    ))}\n                                  </div>\n                                )}\n                              </div>\n                            </div>\n                          ))}\n                        </div>\n                      </CardContent>\n                    </Card>\n\n                    {/* Education Section */}\n                    {person.data.education.length > 0 && (\n                      <Card>\n                        <CardHeader>\n                          <CardTitle className=\"flex items-center gap-2\">\n                            <GraduationCap className=\"h-5 w-5\" />\n                            Education\n                          </CardTitle>\n                        </CardHeader>\n                        <CardContent>\n                          <div className=\"space-y-4\">\n                            {person.data.education.map((edu, index) => (\n                              <div key={index} className=\"flex gap-4\">\n                                <div className=\"flex-shrink-0\">\n                                  <div className=\"w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center\">\n                                    <GraduationCap className=\"h-6 w-6 text-blue-600\" />\n                                  </div>\n                                </div>\n                                <div>\n                                  <h3 className=\"font-semibold\">\n                                    {edu.degree} in {edu.field}\n                                  </h3>\n                                  <p className=\"text-muted-foreground\">\n                                    {edu.institution}\n                                  </p>\n                                  <p className=\"text-sm text-muted-foreground\">\n                                    {edu.startDate} - {edu.endDate || \"Present\"}\n                                  </p>\n                                  {edu.gpa && (\n                                    <p className=\"text-sm text-muted-foreground\">\n                                      GPA: {edu.gpa}\n                                    </p>\n                                  )}\n                                  {edu.description && (\n                                    <p className=\"text-sm mt-2\">\n                                      {edu.description}\n                                    </p>\n                                  )}\n                                </div>\n                              </div>\n                            ))}\n                          </div>\n                        </CardContent>\n                      </Card>\n                    )}\n\n                    {/* Skills Section */}\n                    {person.data.skills.length > 0 && (\n                      <Card>\n                        <CardHeader>\n                          <CardTitle className=\"flex items-center gap-2\">\n                            <Award className=\"h-5 w-5\" />\n                            Skills & Expertise\n                          </CardTitle>\n                        </CardHeader>\n                        <CardContent>\n                          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                            {person.data.skills.map((skill, index) => (\n                              <div\n                                key={index}\n                                className=\"flex items-center justify-between p-3 bg-gray-50 rounded-lg\"\n                              >\n                                <div>\n                                  <div className=\"font-medium\">\n                                    {skill.name}\n                                  </div>\n                                  <div className=\"text-sm text-muted-foreground\">\n                                    {skill.level}\n                                    {(skill as any).yearsOfExperience &&\n                                      ` ΓÇó ${(skill as any).yearsOfExperience} years`}\n                                  </div>\n                                </div>\n                                {(skill as any).endorsements && (\n                                  <Badge variant=\"outline\" className=\"text-xs\">\n                                    {(skill as any).endorsements} endorsements\n                                  </Badge>\n                                )}\n                              </div>\n                            ))}\n                          </div>\n                        </CardContent>\n                      </Card>\n                    )}\n\n                    {/* Projects Section */}\n                    {person.data.projects.length > 0 && (\n                      <Card>\n                        <CardHeader>\n                          <CardTitle>Projects</CardTitle>\n                        </CardHeader>\n                        <CardContent>\n                          <div className=\"space-y-4\">\n                            {person.data.projects.map((project, index) => (\n                              <div\n                                key={index}\n                                className=\"border rounded-lg p-4\"\n                              >\n                                <div className=\"flex items-start justify-between mb-2\">\n                                  <h3 className=\"font-semibold\">\n                                    {project.name}\n                                  </h3>\n                                  {project.url && (\n                                    <Button variant=\"outline\" size=\"sm\" asChild>\n                                      <a\n                                        href={project.url}\n                                        target=\"_blank\"\n                                        rel=\"noopener noreferrer\"\n                                      >\n                                        <ExternalLink className=\"h-3 w-3\" />\n                                      </a>\n                                    </Button>\n                                  )}\n                                </div>\n                                <p className=\"text-sm text-muted-foreground mb-2\">\n                                  {project.startDate} -{\" \"}\n                                  {project.endDate || \"Present\"}\n                                  {project.role && ` ΓÇó ${project.role}`}\n                                </p>\n                                <p className=\"text-sm mb-3\">\n                                  {project.description}\n                                </p>\n                                <div className=\"flex flex-wrap gap-1\">\n                                  {project.technologies.map(\n                                    (tech, techIndex) => (\n                                      <Badge\n                                        key={techIndex}\n                                        variant=\"secondary\"\n                                        className=\"text-xs\"\n                                      >\n                                        {tech}\n                                      </Badge>\n                                    ),\n                                  )}\n                                </div>\n                              </div>\n                            ))}\n                          </div>\n                        </CardContent>\n                      </Card>\n                    )}\n                  </>\n                ) : (\n                  /* No Public Master Resume Message */\n                  <Card>\n                    <CardContent className=\"text-center py-8\">\n                      <div className=\"flex justify-center mb-4\">\n                        <div className=\"p-3 bg-muted rounded-full\">\n                          <Briefcase className=\"h-6 w-6 text-muted-foreground\" />\n                        </div>\n                      </div>\n                      <h3 className=\"font-semibold text-lg mb-2\">\n                        Professional Details Private\n                      </h3>\n                      <p className=\"text-muted-foreground text-sm max-w-md mx-auto\">\n                        This user hasn't made their master resume public yet.\n                        You can still connect with them and see their basic profile information.\n                      </p>\n                    </CardContent>\n                  </Card>\n                )}\n              </div>\n\n              {/* Sidebar */}\n              <div className=\"space-y-6\">\n                {/* Contact Information */}\n                <Card>\n                  <CardHeader>\n                    <CardTitle>Contact Information</CardTitle>\n                  </CardHeader>\n                  <CardContent className=\"space-y-3\">\n                    <div className=\"flex items-center gap-3\">\n                      <Mail className=\"h-4 w-4 text-muted-foreground\" />\n                      <a\n                        href={`mailto:${person.data.contact.email}`}\n                        className=\"text-sm text-primary hover:underline\"\n                      >\n                        {person.data.contact.email}\n                      </a>\n                    </div>\n\n                    {(person.data.contact as any).phone && (\n                      <div className=\"flex items-center gap-3\">\n                        <Phone className=\"h-4 w-4 text-muted-foreground\" />\n                        <span className=\"text-sm\">\n                          {(person.data.contact as any).phone}\n                        </span>\n                      </div>\n                    )}\n\n                    {person.data.contact.website && (\n                      <div className=\"flex items-center gap-3\">\n                        <Globe className=\"h-4 w-4 text-muted-foreground\" />\n                        <a\n                          href={person.data.contact.website}\n                          target=\"_blank\"\n                          rel=\"noopener noreferrer\"\n                          className=\"text-sm text-primary hover:underline\"\n                        >\n                          {person.data.contact.website.replace(\n                            /^https?:\\/\\//,\n                            \"\",\n                          )}\n                        </a>\n                      </div>\n                    )}\n\n                    {person.data.contact.linkedin && (\n                      <div className=\"flex items-center gap-3\">\n                        <Linkedin className=\"h-4 w-4 text-muted-foreground\" />\n                        <a\n                          href={person.data.contact.linkedin}\n                          target=\"_blank\"\n                          rel=\"noopener noreferrer\"\n                          className=\"text-sm text-primary hover:underline\"\n                        >\n                          LinkedIn\n                        </a>\n                      </div>\n                    )}\n\n                    {person.data.contact.github && (\n                      <div className=\"flex items-center gap-3\">\n                        <Github className=\"h-4 w-4 text-muted-foreground\" />\n                        <a\n                          href={person.data.contact.github}\n                          target=\"_blank\"\n                          rel=\"noopener noreferrer\"\n                          className=\"text-sm text-primary hover:underline\"\n                        >\n                          GitHub\n                        </a>\n                      </div>\n                    )}\n                  </CardContent>\n                </Card>\n\n                {/* Additional Info */}\n                <Card>\n                  <CardHeader>\n                    <CardTitle>Additional Information</CardTitle>\n                  </CardHeader>\n                  <CardContent className=\"space-y-3\">\n                    {(person.data as any).languages &&\n                      (person.data as any).languages.length > 0 && (\n                        <div>\n                          <h4 className=\"font-medium text-sm mb-2\">\n                            Languages\n                          </h4>\n                          <div className=\"flex flex-wrap gap-1\">\n                            {(person.data as any).languages.map(\n                              (language: any, index: number) => (\n                                <Badge\n                                  key={index}\n                                  variant=\"outline\"\n                                  className=\"text-xs\"\n                                >\n                                  {language}\n                                </Badge>\n                              ),\n                            )}\n                          </div>\n                        </div>\n                      )}\n\n                    {(person.data as any).interests &&\n                      (person.data as any).interests.length > 0 && (\n                        <div>\n                          <h4 className=\"font-medium text-sm mb-2\">\n                            Interests\n                          </h4>\n                          <div className=\"flex flex-wrap gap-1\">\n                            {(person.data as any).interests.map(\n                              (interest: any, index: number) => (\n                                <Badge\n                                  key={index}\n                                  variant=\"outline\"\n                                  className=\"text-xs\"\n                                >\n                                  {interest}\n                                </Badge>\n                              ),\n                            )}\n                          </div>\n                        </div>\n                      )}\n\n                    <Separator />\n\n                    <div className=\"space-y-2 text-sm\">\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-muted-foreground\">\n                          Member since\n                        </span>\n                        <span>\n                          {person.createdAt &&\n                          !isNaN(new Date(person.createdAt).getTime())\n                            ? new Date(person.createdAt).toLocaleDateString()\n                            : \"Unknown\"}\n                        </span>\n                      </div>\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-muted-foreground\">\n                          Last active\n                        </span>\n                        <span>\n                          {(() => {\n                            const lastActive =\n                              (person as any).lastActiveAt || person.updatedAt;\n                            return lastActive &&\n                              !isNaN(new Date(lastActive).getTime())\n                              ? new Date(lastActive).toLocaleDateString()\n                              : \"Unknown\";\n                          })()}\n                        </span>\n                      </div>\n                    </div>\n                  </CardContent>\n                </Card>\n\n                {/* Opportunity Preferences (if open to work) */}\n                {person.data.openToWork && (\n                  <Card>\n                    <CardHeader>\n                      <CardTitle className=\"text-green-700\">\n                        Open to Opportunities\n                      </CardTitle>\n                    </CardHeader>\n                    <CardContent className=\"space-y-3\">\n                      {person.data.openToOpportunities.length > 0 && (\n                        <div>\n                          <h4 className=\"font-medium text-sm mb-2\">\n                            Opportunity Types\n                          </h4>\n                          <div className=\"flex flex-wrap gap-1\">\n                            {person.data.openToOpportunities.map(\n                              (type, index) => (\n                                <Badge\n                                  key={index}\n                                  variant=\"outline\"\n                                  className=\"text-xs capitalize\"\n                                >\n                                  {type.replace(\"-\", \" \")}\n                                </Badge>\n                              ),\n                            )}\n                          </div>\n                        </div>\n                      )}\n\n                      {(person.data as any).preferredRoles &&\n                        (person.data as any).preferredRoles.length > 0 && (\n                          <div>\n                            <h4 className=\"font-medium text-sm mb-2\">\n                              Preferred Roles\n                            </h4>\n                            <div className=\"space-y-1\">\n                              {(person.data as any).preferredRoles.map(\n                                (role: any, index: number) => (\n                                  <div\n                                    key={index}\n                                    className=\"text-xs text-muted-foreground\"\n                                  >\n                                    ΓÇó {role}\n                                  </div>\n                                ),\n                              )}\n                            </div>\n                          </div>\n                        )}\n\n                      {(person.data as any).salaryExpectation && (\n                        <div>\n                          <h4 className=\"font-medium text-sm mb-2\">\n                            Salary Expectation\n                          </h4>\n                          <p className=\"text-xs text-muted-foreground\">\n                            {(person.data as any).salaryExpectation.min &&\n                            (person.data as any).salaryExpectation.max\n                              ? `$${((person.data as any).salaryExpectation.min / 1000).toFixed(0)}k - $${((person.data as any).salaryExpectation.max / 1000).toFixed(0)}k ${(person.data as any).salaryExpectation.currency}`\n                              : \"Negotiable\"}\n                          </p>\n                        </div>\n                      )}\n                    </CardContent>\n                  </Card>\n                )}\n              </div>\n            </div>\n          </div>\n          <Footer />\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\PersonaSelection.tsx","messages":[{"ruleId":"no-duplicate-imports","severity":1,"message":"'@/lib/auth' import is duplicated.","line":16,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":16,"endColumn":50},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":161,"column":47,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[5798,5878],"text":"\n                            Perfect choice! We&apos;ll customize your experience for"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[5798,5878],"text":"\n                            Perfect choice! We&lsquo;ll customize your experience for"},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[5798,5878],"text":"\n                            Perfect choice! We&#39;ll customize your experience for"},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[5798,5878],"text":"\n                            Perfect choice! We&rsquo;ll customize your experience for"},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":200,"column":20,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[7130,7225],"text":"\n                Don&apos;t worry, you can change this later in your account settings\n              "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[7130,7225],"text":"\n                Don&lsquo;t worry, you can change this later in your account settings\n              "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[7130,7225],"text":"\n                Don&#39;t worry, you can change this later in your account settings\n              "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[7130,7225],"text":"\n                Don&rsquo;t worry, you can change this later in your account settings\n              "},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Users, Briefcase, Building2, ArrowRight, Check } from \"lucide-react\";\nimport { useState } from \"react\";\nimport { useNavigate } from \"react-router-dom\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport type { UserRole } from \"@/lib/auth\";\nimport { useAuth, USER_ROLES } from \"@/lib/auth\";\n\nconst personas = [\n  {\n    id: USER_ROLES.JOB_SEEKER,\n    title: \"Job Seeker\",\n    description: \"Looking for your next career opportunity\",\n    icon: Users,\n    features: [\n      \"Create video resumes\",\n      \"Track application progress\",\n      \"Get matched with jobs\",\n      \"Resume analytics\",\n      \"Interview preparation\",\n    ],\n    color: \"bg-green-50 border-green-200 hover:border-green-300\",\n    iconColor: \"text-green-600\",\n  },\n  {\n    id: USER_ROLES.RECRUITER,\n    title: \"Recruiter\",\n    description: \"Finding the perfect candidates for your roles\",\n    icon: Briefcase,\n    features: [\n      \"Browse candidate profiles\",\n      \"Advanced search filters\",\n      \"Candidate pipeline management\",\n      \"Interview scheduling\",\n      \"Placement tracking\",\n    ],\n    color: \"bg-blue-50 border-blue-200 hover:border-blue-300\",\n    iconColor: \"text-blue-600\",\n  },\n  {\n    id: USER_ROLES.EMPLOYER,\n    title: \"Employer\",\n    description: \"Managing your company's hiring operations\",\n    icon: Building2,\n    features: [\n      \"Team hiring analytics\",\n      \"Multi-recruiter management\",\n      \"Department-wise insights\",\n      \"Hiring cost optimization\",\n      \"Enterprise integrations\",\n    ],\n    color: \"bg-purple-50 border-purple-200 hover:border-purple-300\",\n    iconColor: \"text-purple-600\",\n  },\n];\n\nexport default function PersonaSelection() {\n  const [selectedPersona, setSelectedPersona] = useState<UserRole | null>(null);\n  const [isLoading, setIsLoading] = useState(false);\n  const [sidebarOpen, setSidebarOpen] = useState(false);\n  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);\n\n  const { updateUserRole, user } = useAuth();\n  const navigate = useNavigate();\n\n  const handleContinue = async () => {\n    if (!selectedPersona) return;\n\n    setIsLoading(true);\n    updateUserRole(selectedPersona);\n\n    // Simulate a small delay for better UX\n    await new Promise((resolve) => setTimeout(resolve, 500));\n\n    navigate(\"/onboarding\");\n  };\n\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-background via-brand-purple/5 to-brand-blue/5\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={() => setSidebarOpen(false)}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={() => setSidebarOpen(true)}\n          onSidebarToggle={() => setSidebarCollapsed(!sidebarCollapsed)}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16 min-h-screen p-6\">\n          <div className=\"max-w-4xl mx-auto\">\n            {/* Header */}\n            <div className=\"text-center mb-12\">\n              <h1 className=\"text-4xl font-bold mb-4\">\n                Welcome to MyVideoResume{user?.name ? `, ${user.name}` : \"\"}!\n              </h1>\n              <p className=\"text-xl text-muted-foreground mb-6\">\n                Tell us about yourself so we can personalize your experience\n              </p>\n              <Badge variant=\"secondary\" className=\"text-sm\">\n                Step 1 of 2\n              </Badge>\n            </div>\n\n            {/* Persona Cards */}\n            <div className=\"grid md:grid-cols-3 gap-6 mb-8\">\n              {personas.map((persona) => {\n                const Icon = persona.icon;\n                const isSelected = selectedPersona === persona.id;\n\n                return (\n                  <Card\n                    key={persona.id}\n                    className={`cursor-pointer transition-all duration-200 ${persona.color} ${\n                      isSelected\n                        ? \"ring-2 ring-primary shadow-lg scale-105\"\n                        : \"hover:shadow-md\"\n                    }`}\n                    onClick={() => setSelectedPersona(persona.id)}\n                  >\n                    <CardHeader className=\"text-center pb-4\">\n                      <div className=\"flex justify-center mb-4\">\n                        <div\n                          className={`p-4 rounded-full bg-white shadow-sm ${isSelected ? \"ring-2 ring-primary\" : \"\"}`}\n                        >\n                          <Icon className={`h-8 w-8 ${persona.iconColor}`} />\n                        </div>\n                      </div>\n                      <CardTitle className=\"text-xl\">{persona.title}</CardTitle>\n                      <CardDescription className=\"text-sm\">\n                        {persona.description}\n                      </CardDescription>\n                    </CardHeader>\n                    <CardContent>\n                      <ul className=\"space-y-2\">\n                        {persona.features.map((feature, index) => (\n                          <li\n                            key={index}\n                            className=\"flex items-start gap-2 text-sm\"\n                          >\n                            <Check className=\"h-4 w-4 text-green-600 mt-0.5 flex-shrink-0\" />\n                            <span>{feature}</span>\n                          </li>\n                        ))}\n                      </ul>\n\n                      {isSelected && (\n                        <div className=\"mt-4 p-3 bg-primary/10 rounded-lg\">\n                          <p className=\"text-sm font-medium text-primary\">\n                            Perfect choice! We'll customize your experience for{\" \"}\n                            {persona.title.toLowerCase()}s.\n                          </p>\n                        </div>\n                      )}\n                    </CardContent>\n                  </Card>\n                );\n              })}\n            </div>\n\n            {/* Continue Button */}\n            <div className=\"text-center\">\n              <Button\n                onClick={handleContinue}\n                disabled={!selectedPersona || isLoading}\n                size=\"lg\"\n                className=\"bg-gradient-to-r from-brand-purple to-brand-blue hover:opacity-90 px-8\"\n              >\n                {isLoading ? (\n                  \"Setting up your account...\"\n                ) : (\n                  <>\n                    Continue to Onboarding\n                    <ArrowRight className=\"ml-2 h-5 w-5\" />\n                  </>\n                )}\n              </Button>\n\n              {!selectedPersona && (\n                <p className=\"text-sm text-muted-foreground mt-2\">\n                  Please select a persona to continue\n                </p>\n              )}\n            </div>\n\n            {/* Help Text */}\n            <div className=\"mt-8 text-center\">\n              <p className=\"text-sm text-muted-foreground\">\n                Don't worry, you can change this later in your account settings\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\PlaceholderPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\Pricing.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Zap' is defined but never used. Allowed unused vars must match /^_/u.","line":9,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":9,"endColumn":6},{"ruleId":"no-duplicate-imports","severity":1,"message":"'@/lib/auth' import is duplicated.","line":59,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":59,"endColumn":50},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'_' is defined but never used.","line":230,"column":16,"nodeType":null,"messageId":"unusedVar","endLine":230,"endColumn":17},{"ruleId":"no-empty","severity":2,"message":"Empty block statement.","line":230,"column":19,"nodeType":"BlockStatement","messageId":"unexpected","endLine":230,"endColumn":21,"suggestions":[{"messageId":"suggestComment","data":{"type":"block"},"fix":{"range":[6228,6228],"text":" /* empty */ "},"desc":"Add comment inside empty block statement."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":371,"column":63,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[12282,12298],"text":"What&apos;s included:"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[12282,12298],"text":"What&lsquo;s included:"},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[12282,12298],"text":"What&#39;s included:"},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[12282,12298],"text":"What&rsquo;s included:"},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  Check,\n  Star,\n  Users,\n  Building2,\n  MessageCircle,\n  Play,\n  ArrowRight,\n  Zap,\n  Shield,\n  Heart,\n  Briefcase,\n  FileText,\n  BarChart3,\n  Clock,\n  Target,\n  Brain,\n  Video,\n  CheckSquare,\n  Send,\n  Calendar,\n  Bell,\n  Globe,\n  TrendingUp,\n  Handshake,\n  ShoppingCart,\n  Plus,\n  Minus,\n} from \"lucide-react\";\nimport { PREMIUM_MONTHLY_PRICE as basePrice } from \"@shared/pricing\";\n\nimport { useEffect, useState } from \"react\";\nimport { Link, useLocation } from \"react-router-dom\";\nimport { useSEO } from \"@/lib/seo\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Label } from \"@/components/ui/label\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { ToggleGroup, ToggleGroupItem } from \"@/components/ui/toggle-group\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport type { UserRole } from \"@/lib/auth\";\nimport { useAuth, USER_ROLES } from \"@/lib/auth\";\nimport { useCart } from \"@/lib/cart-context\";\n\nexport default function Pricing() {\n  const location = useLocation();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n\n  // SEO for pricing page\n  useSEO(location.pathname);\n  const { isAuthenticated } = useAuth();\n  const { addItem, openCart } = useCart();\n\n  // Pricing state\n  const [isAnnual, setIsAnnual] = useState(false);\n  // Persona state\n  const [persona, setPersona] = useState<UserRole>(USER_ROLES.JOB_SEEKER);\n\n  const personaCopy: Partial<Record<\n    UserRole,\n    {\n      label: string;\n      freeDescription: string;\n      premiumDescription: string;\n      freeFeatures: string[];\n      premiumFeatures: string[];\n      unitLabel: string; // e.g., per seat / month\n      userCountLabel: string; // label for the user count selector\n    }\n  >> = {\n    [USER_ROLES.JOB_SEEKER]: {\n      label: \"Job Seeker\",\n      freeDescription:\n        \"Get started with tools to build and share your video resume.\",\n      premiumDescription:\n        \"Unlock advanced branding, analytics, and AI to land roles faster.\",\n      freeFeatures: [\n        \"Create video resumes\",\n        \"Basic resume analytics\",\n        \"AI assistance (10/mo)\",\n        \"Apply to jobs\",\n        \"Profile hosting\",\n        \"Community access\",\n      ],\n      premiumFeatures: [\n        \"Advanced video templates\",\n        \"Unlimited AI assistance\",\n        \"Interview practice & feedback\",\n        \"Resume optimization\",\n        \"Priority job matching\",\n        \"Salary insights\",\n      ],\n      unitLabel: \"per month\",\n      userCountLabel: \"\",\n    },\n    [USER_ROLES.RECRUITER]: {\n      label: \"Recruiter\",\n      freeDescription:\n        \"Essential ATS and CRM to start sourcing and tracking candidates.\",\n      premiumDescription:\n        \"Scale your recruiting with automation, outreach, and analytics.\",\n      freeFeatures: [\n        \"Applicant Tracking System (ATS)\",\n        \"Unlimited job postings\",\n        \"Recruiting CRM\",\n        \"Basic interview scheduling\",\n        \"Up to 2 team members\",\n        \"AI assistance (10/mo)\",\n      ],\n      premiumFeatures: [\n        \"Exclusive job boards + bidding\",\n        \"Advanced pipeline & automation\",\n\n        \"Smart outreach campaigns\",\n\n        \"AI message personalization\",\n        \"Performance dashboards\",\n        \"Unlimited seats\",\n      ],\n      unitLabel: \"per seat / month\",\n      userCountLabel: \"Seats\",\n    },\n    [USER_ROLES.EMPLOYER]: {\n      label: \"Employer\",\n      freeDescription:\n        \"Core HR tools to start hiring and organizing candidates.\",\n      premiumDescription:\n        \"All-in-one HR suite with engagement and advanced analytics.\",\n      freeFeatures: [\n        \"ATS + Job postings\",\n        \"Recruiting & Sales CRM\",\n        \"1 admin user\",\n        \"Up to 2 employees\",\n        \"Basic scheduling\",\n        \"AI assistance (10/mo)\",\n      ],\n      premiumFeatures: [\n        \"Employee community (Engage/Inform/Inspire)\",\n        \"Hiring & Onboarding (Offers)\",\n        \"Performance management\",\n        \"Calendar & notifications\",\n        \"Advanced analytics & API\",\n        \"Unlimited users\",\n      ],\n      unitLabel: \"per user / month\",\n      userCountLabel: \"Users\",\n    },\n\n\n    [USER_ROLES.AFFILIATE]: {\n      label: \"Affiliate\",\n      freeDescription: \"Earn 25% commission from referred subscribers.\",\n      premiumDescription: \"Affiliates earn commissions; no paid plan required.\",\n      freeFeatures: [\n        \"Unique referral link\",\n        \"Dashboard with referrals & payouts\",\n        \"$25 minimum payout threshold\",\n      ],\n      premiumFeatures: [\n        \"Priority support\",\n        \"Advanced tracking (coming soon)\",\n        \"Payout history export\",\n      ],\n      unitLabel: \"\",\n      userCountLabel: \"\",\n    },\n\n    [USER_ROLES.ADMIN]: {\n      label: \"Admin\",\n      freeDescription: \"Administrative access to manage the platform.\",\n      premiumDescription:\n        \"Full administrative control with advanced management features.\",\n      freeFeatures: [\n        \"User management\",\n        \"Basic analytics\",\n        \"System configuration\",\n        \"Support access\",\n      ],\n      premiumFeatures: [\n        \"Advanced user management\",\n        \"Full system analytics\",\n        \"API access\",\n        \"Priority support\",\n        \"Custom integrations\",\n      ],\n      unitLabel: \"per admin / month\",\n      userCountLabel: \"Admins\",\n    },\n\n\n  };\n\n  const [selectedUsers, setSelectedUsers] = useState(1);\n  // Default persona from logged-in user if available\n  useEffect(() => {\n    const stored = localStorage.getItem(\"user\");\n    if (stored) {\n      try {\n        const u = JSON.parse(stored);\n        if (\n          u?.role === USER_ROLES.JOB_SEEKER ||\n          u?.role === USER_ROLES.RECRUITER ||\n          u?.role === USER_ROLES.EMPLOYER\n        ) {\n          setPersona(u.role as UserRole);\n        }\n      } catch (_) {}\n    }\n  }, []);\n\n  const calculatePrice = (users: number, annual: boolean) => {\n    const monthlyTotal = basePrice * users;\n    if (annual) {\n      return monthlyTotal * 12 * 0.8; // 20% discount for annual\n    }\n    return monthlyTotal;\n  };\n\n  const handleAddToCart = () => {\n    addItem({\n      id: `premium-${selectedUsers}-${isAnnual ? \"annual\" : \"monthly\"}`,\n      name: \"Premium Plan\",\n      price: calculatePrice(selectedUsers, isAnnual),\n      billingCycle: isAnnual ? \"annual\" : \"monthly\",\n      users: selectedUsers,\n    });\n    openCart();\n  };\n\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-background via-brand-purple/5 to-brand-blue/5\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16\">\n          <div className=\"max-w-6xl mx-auto px-4 py-16\">\n            {/* Hero Section */}\n            <div className=\"text-center mb-16\">\n              <h1 className=\"text-5xl font-bold mb-6\">\n                Simple, Transparent Pricing\n              </h1>\n              <p className=\"text-xl text-muted-foreground mb-8 max-w-3xl mx-auto\">\n                All-in-one HR platform with employment-focused social media,\n                referral network, ATS, Recruitment CRM, crowdsourcing, and\n                recruitment marketing ΓÇö build a true talent pipeline with our\n                flexible pricing plans.\n              </p>\n              <div className=\"flex items-center justify-center gap-4 mb-8\">\n                <Badge variant=\"outline\" className=\"flex items-center gap-2\">\n                  <Shield className=\"h-4 w-4\" />\n                  No hidden fees\n                </Badge>\n                <Badge variant=\"outline\" className=\"flex items-center gap-2\">\n                  <Clock className=\"h-4 w-4\" />\n                  Cancel anytime\n                </Badge>\n              </div>\n            </div>\n\n            {/* Billing Toggle */}\n            <div className=\"flex items-center justify-center gap-4 mb-8\">\n              <Label\n                htmlFor=\"billing-toggle\"\n                className={!isAnnual ? \"font-semibold\" : \"\"}\n              >\n                Monthly\n              </Label>\n              <Switch\n                id=\"billing-toggle\"\n                checked={isAnnual}\n                onCheckedChange={setIsAnnual}\n              />\n              <Label\n                htmlFor=\"billing-toggle\"\n                className={isAnnual ? \"font-semibold\" : \"\"}\n              >\n                Annual\n                <Badge variant=\"secondary\" className=\"ml-2\">\n                  Save 20%\n                </Badge>\n              </Label>\n            </div>\n\n            {/* Personas Segmented Control - New Row with Center Alignment */}\n            <div className=\"w-full flex justify-center mb-10\">\n              <div className=\"text-center\">\n                <div className=\"flex items-center justify-center mb-2\">\n                  <div className=\"p-[2px] rounded-full bg-gradient-to-r from-brand-purple to-brand-blue\">\n                    <div className=\"bg-background rounded-full p-1\">\n                      <ToggleGroup\n                        type=\"single\"\n                        value={persona}\n                        onValueChange={(v) => v && setPersona(v as UserRole)}\n                        className=\"gap-1\"\n                      >\n                        <ToggleGroupItem\n                          value={USER_ROLES.JOB_SEEKER}\n                          className=\"rounded-full px-4 py-2 data-[state=on]:bg-gradient-to-r data-[state=on]:from-brand-purple data-[state=on]:to-brand-blue data-[state=on]:text-white\"\n                        >\n                          <Users className=\"h-4 w-4 mr-2\" /> Job Seeker\n                        </ToggleGroupItem>\n                        <ToggleGroupItem\n                          value={USER_ROLES.RECRUITER}\n                          className=\"rounded-full px-4 py-2 data-[state=on]:bg-gradient-to-r data-[state=on]:from-brand-purple data-[state=on]:to-brand-blue data-[state=on]:text-white\"\n                        >\n                          <Briefcase className=\"h-4 w-4 mr-2\" /> Recruiter\n                        </ToggleGroupItem>\n                        <ToggleGroupItem\n                          value={USER_ROLES.EMPLOYER}\n                          className=\"rounded-full px-4 py-2 data-[state=on]:bg-gradient-to-r data-[state=on]:from-brand-purple data-[state=on]:to-brand-blue data-[state=on]:text-white\"\n                        >\n                          <Building2 className=\"h-4 w-4 mr-2\" /> Employer\n                        </ToggleGroupItem>\n                      </ToggleGroup>\n                    </div>\n                  </div>\n                </div>\n                <p className=\"text-sm text-muted-foreground\">\n                  Plans tailored for {personaCopy[persona].label}\n                </p>\n              </div>\n            </div>\n\n            {/* Pricing Cards */}\n            <div className=\"grid md:grid-cols-2 gap-8 mb-16 max-w-4xl mx-auto\">\n              {/* Free Plan */}\n              <Card className=\"relative border-2 border-border hover:border-primary/20 transition-colors\">\n                <CardHeader className=\"text-center pb-8\">\n                  <CardTitle className=\"text-2xl\">Free</CardTitle>\n                  <div className=\"mt-4\">\n                    <span className=\"text-5xl font-bold\">$0.00</span>\n                  </div>\n                  <CardDescription className=\"text-lg mt-4\">\n                    {personaCopy[persona].freeDescription}\n                  </CardDescription>\n                </CardHeader>\n                <CardContent className=\"space-y-6\">\n                  <div className=\"space-y-4\">\n                    <h4 className=\"font-semibold text-lg\">What's included:</h4>\n                    <div className=\"space-y-3\">\n                      {personaCopy[persona].freeFeatures.map((feat) => (\n                        <div key={feat} className=\"flex items-center gap-3\">\n                          <div className=\"w-5 h-5 bg-green-100 rounded-full flex items-center justify-center flex-shrink-0\">\n                            <Check className=\"h-3 w-3 text-green-600\" />\n                          </div>\n                          <span className=\"text-sm\">{feat}</span>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n\n                  <div className=\"pt-4\">\n                    {!isAuthenticated ? (\n                      <Link to=\"/signup\" className=\"block\">\n                        <Button className=\"w-full\" variant=\"outline\" size=\"lg\">\n                          Get Started\n                        </Button>\n                      </Link>\n                    ) : (\n        