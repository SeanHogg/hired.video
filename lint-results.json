"source":"import React, { useState, useEffect } from \"react\";\nimport { useSearchParams, useNavigate } from \"react-router-dom\";\nimport {\n  CheckCircle,\n  Building2,\n  Users,\n  Mail,\n  AlertCircle,\n  Loader2,\n} from \"lucide-react\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { useAuth } from \"@/lib/auth\";\nimport { accountService } from \"@/lib/services/account-service\";\nimport {\n  InvitationDetailsResponse,\n  AcceptInvitationResponse,\n} from \"@/types/account\";\nimport { getRoleDisplayLabel } from \"@/lib/role-utils\";\nimport { toast } from \"@/hooks/use-toast\";\n\nexport default function AcceptInvitation() {\n  const [searchParams] = useSearchParams();\n  const navigate = useNavigate();\n  const { user, isAuthenticated } = useAuth();\n\n  const [invitationDetails, setInvitationDetails] =\n    useState<InvitationDetailsResponse | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [accepting, setAccepting] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  const invitationId = searchParams.get(\"id\");\n\n  useEffect(() => {\n    if (!invitationId) {\n      setError(\"Invalid invitation link\");\n      setLoading(false);\n      return;\n    }\n\n    loadInvitationDetails();\n  }, [invitationId]);\n\n  const loadInvitationDetails = async () => {\n    if (!invitationId) return;\n\n    try {\n      setLoading(true);\n      const details = await accountService.getInvitationDetails(invitationId);\n      setInvitationDetails(details);\n      setError(null);\n    } catch (err) {\n      console.error(\"Error loading invitation details:\", err);\n      setError(\n        \"Failed to load invitation details. The invitation may be invalid or expired.\",\n      );\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleAcceptInvitation = async () => {\n    if (!invitationId) return;\n\n    try {\n      setAccepting(true);\n      const result = await accountService.acceptInvitation(invitationId);\n\n      if (result.success) {\n        toast({\n          title: \"Invitation Accepted!\",\n          description: `Welcome to ${result.companyName}!`,\n        });\n\n        // Redirect based on the response\n        if (result.redirectUrl) {\n          navigate(result.redirectUrl);\n        } else {\n          navigate(\"/dashboard\");\n        }\n      } else {\n        // Handle cases where user needs to register or login\n        if (result.requiredRegistration && result.redirectUrl) {\n          navigate(result.redirectUrl);\n        } else if (result.redirectUrl) {\n          navigate(result.redirectUrl);\n        } else {\n          setError(result.message || \"Failed to accept invitation\");\n        }\n      }\n    } catch (err) {\n      console.error(\"Error accepting invitation:\", err);\n      setError(\"Failed to accept invitation. Please try again.\");\n    } finally {\n      setAccepting(false);\n    }\n  };\n\n  const handleDecline = () => {\n    navigate(\"/\");\n  };\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-gray-50 flex items-center justify-center p-4\">\n        <Card className=\"w-full max-w-md\">\n          <CardContent className=\"flex items-center justify-center p-8\">\n            <div className=\"text-center\">\n              <Loader2 className=\"h-8 w-8 animate-spin mx-auto mb-4 text-blue-600\" />\n              <p className=\"text-gray-600\">Loading invitation details...</p>\n            </div>\n          </CardContent>\n        </Card>\n      </div>\n    );\n  }\n\n  if (error || !invitationDetails) {\n    return (\n      <div className=\"min-h-screen bg-gray-50 flex items-center justify-center p-4\">\n        <Card className=\"w-full max-w-md\">\n          <CardHeader className=\"text-center\">\n            <div className=\"mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-red-100\">\n              <AlertCircle className=\"h-6 w-6 text-red-600\" />\n            </div>\n            <CardTitle className=\"text-xl\">Invalid Invitation</CardTitle>\n            <CardDescription>\n              {error || \"This invitation link is not valid or has expired.\"}\n            </CardDescription>\n          </CardHeader>\n          <CardContent>\n            <Button onClick={() => navigate(\"/\")} className=\"w-full\">\n              Go to Home\n            </Button>\n          </CardContent>\n        </Card>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-gray-50 flex items-center justify-center p-4\">\n      <Card className=\"w-full max-w-2xl\">\n        <CardHeader className=\"text-center\">\n          <div className=\"mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100\">\n            {invitationDetails.companyLogoUrl ? (\n              <img\n                src={invitationDetails.companyLogoUrl}\n                alt={`${invitationDetails.companyName} logo`}\n                className=\"h-12 w-12 rounded-full object-cover\"\n              />\n            ) : (\n              <Building2 className=\"h-8 w-8 text-blue-600\" />\n            )}\n          </div>\n          <CardTitle className=\"text-2xl\">You're Invited!</CardTitle>\n          <CardDescription>\n            {invitationDetails.inviterName} has invited you to join{\" \"}\n            <strong>{invitationDetails.companyName}</strong> on MyVideoResu.ME\n          </CardDescription>\n        </CardHeader>\n\n        <CardContent className=\"space-y-6\">\n          {/* Company Information */}\n          <div className=\"bg-gray-50 rounded-lg p-4\">\n            <h3 className=\"font-semibold text-lg mb-2 flex items-center gap-2\">\n              <Building2 className=\"h-5 w-5\" />\n              {invitationDetails.companyName}\n            </h3>\n            {invitationDetails.companyDescription && (\n              <p className=\"text-gray-600 mb-3\">\n                {invitationDetails.companyDescription}\n              </p>\n            )}\n            <div className=\"flex items-center gap-4 text-sm text-gray-500\">\n              <span className=\"flex items-center gap-1\">\n                <Mail className=\"h-4 w-4\" />\n                Invited: {invitationDetails.invitedEmail}\n              </span>\n              <span className=\"flex items-center gap-1\">\n                <Users className=\"h-4 w-4\" />\n                From: {invitationDetails.inviterName}\n              </span>\n            </div>\n          </div>\n\n          {/* Roles */}\n          <div>\n            <h4 className=\"font-medium mb-3\">\n              You'll be assigned these roles:\n            </h4>\n            <div className=\"flex flex-wrap gap-2\">\n              {invitationDetails.rolesToAssign.map((role) => (\n                <Badge key={role} variant=\"secondary\">\n                  {getRoleDisplayLabel(role)}\n                </Badge>\n              ))}\n            </div>\n          </div>\n\n          {/* Personal Message */}\n          {invitationDetails.personalMessage && (\n            <div className=\"bg-blue-50 border-l-4 border-blue-400 p-4\">\n              <p className=\"text-blue-800 italic\">\n                \"{invitationDetails.personalMessage}\"\n              </p>\n            </div>\n          )}\n\n          {/* Authentication Status */}\n          {!isAuthenticated && (\n            <Alert>\n              <AlertCircle className=\"h-4 w-4\" />\n              <AlertDescription>\n                {invitationDetails.userExists\n                  ? \"Please log in to accept this invitation.\"\n                  : \"You'll need to create an account to accept this invitation.\"}\n              </AlertDescription>\n            </Alert>\n          )}\n\n          {isAuthenticated &&\n            user?.email !== invitationDetails.invitedEmail && (\n              <Alert>\n                <AlertCircle className=\"h-4 w-4\" />\n                <AlertDescription>\n                  This invitation is for {invitationDetails.invitedEmail}, but\n                  you're logged in as {user?.email}. Please log in with the\n                  correct account.\n                </AlertDescription>\n              </Alert>\n            )}\n\n          {/* Action Buttons */}\n          <div className=\"flex gap-3 pt-4\">\n            <Button\n              onClick={handleAcceptInvitation}\n              disabled={accepting}\n              className=\"flex-1\"\n            >\n              {accepting ? (\n                <>\n                  <Loader2 className=\"h-4 w-4 animate-spin mr-2\" />\n                  Accepting...\n                </>\n              ) : (\n                <>\n                  <CheckCircle className=\"h-4 w-4 mr-2\" />\n                  Accept Invitation\n                </>\n              )}\n            </Button>\n            <Button\n              variant=\"outline\"\n              onClick={handleDecline}\n              disabled={accepting}\n              className=\"flex-1\"\n            >\n              Decline\n            </Button>\n          </div>\n\n          <p className=\"text-xs text-gray-500 text-center\">\n            Invited on{\" \"}\n            {new Date(invitationDetails.invitedAt).toLocaleDateString()}\n          </p>\n        </CardContent>\n      </Card>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\AccountManagement.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Settings' is defined but never used. Allowed unused vars must match /^_/u.","line":7,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":7,"endColumn":11},{"ruleId":"@typescr