 never used. Allowed unused vars must match /^_/u.","line":39,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":39,"endColumn":19},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'DropdownMenuTrigger' is defined but never used. Allowed unused vars must match /^_/u.","line":40,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":40,"endColumn":22},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'getInviteStatusDisplayName' is defined but never used. Allowed unused vars must match /^_/u.","line":50,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":50,"endColumn":29},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'getInviteStatusColor' is defined but never used. Allowed unused vars must match /^_/u.","line":51,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":51,"endColumn":23},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'canEditRoles' is defined but never used. Allowed unused vars must match /^_/u.","line":53,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":53,"endColumn":15},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'getRoleDisplayLabel' is defined but never used. Allowed unused vars must match /^_/u.","line":55,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":55,"endColumn":29},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadAccountUsers'. Either include it or remove the dependency array.","line":104,"column":6,"nodeType":"ArrayExpression","endLine":104,"endColumn":36,"suggestions":[{"desc":"Update the dependencies array to be: [isAuthenticated, authLoading, loadAccountUsers]","fix":{"range":[3440,3470],"text":"[isAuthenticated, authLoading, loadAccountUsers]"}}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":138,"column":47,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":138,"endColumn":50,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4415,4418],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4415,4418],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":158,"column":45,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":158,"endColumn":48,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4961,4964],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4961,4964],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'handleResendInvitation' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":201,"column":9,"nodeType":null,"messageId":"unusedVar","endLine":201,"endColumn":31},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'handleRemoveUser' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":220,"column":9,"nodeType":null,"messageId":"unusedVar","endLine":220,"endColumn":25},{"ruleId":"no-alert","severity":1,"message":"Unexpected confirm.","line":222,"column":8,"nodeType":"CallExpression","messageId":"unexpected","endLine":222,"endColumn":78},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'getStatusIcon' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":245,"column":9,"nodeType":null,"messageId":"unusedVar","endLine":245,"endColumn":22}],"suppressedMessages":[],"errorCount":20,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport { PasswordRequirementsProvider } from \"@/components/auth/PasswordRequirementsProvider\";\nimport {\n  Users,\n  UserPlus,\n  Settings,\n  Shield,\n  Mail,\n  MoreVertical,\n  Crown,\n  AlertCircle,\n  CheckCircle,\n  Clock,\n  XCircle,\n  ArrowRight,\n  Sparkles,\n  BarChart3,\n  Zap,\n  Target,\n  Network,\n} from \"lucide-react\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\";\nimport { Badge } from \"@/components/ui/badge\";\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { useAuth, USER_ROLES } from \"@/lib/auth\";\n\nimport { accountService } from \"@/lib/services/account-service\";\nimport {\n  AccountUser,\n  InviteStatus,\n  getInviteStatusDisplayName,\n  getInviteStatusColor,\n  canManageUsers,\n  canEditRoles,\n} from \"@/types/account\";\nimport { getRoleDisplayLabel } from \"@/lib/role-utils\";\nimport { InviteUserModal } from \"@/components/account/InviteUserModal\";\nimport { BulkInviteModal } from \"@/components/account/BulkInviteModal\";\nimport { InvitationManagement } from \"@/components/account/InvitationManagement\";\nimport { InvitationAnalytics } from \"@/components/account/InvitationAnalytics\";\nimport { EditRolesModal } from \"@/components/account/EditRolesModal\";\nimport { AccountAnalytics } from \"@/components/account/AccountAnalytics\";\nimport { AccountManagementSkeleton } from \"@/components/account/AccountManagementSkeleton\";\nimport { BillingManagement } from \"@/components/billing/BillingManagement\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\n\nfunction AccountManagementContent() {\n  const [users, setUsers] = useState<AccountUser[]>([]);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [selectedUser, setSelectedUser] = useState<AccountUser | null>(null);\n  const [inviteModalOpen, setInviteModalOpen] = useState(false);\n  const [bulkInviteModalOpen, setBulkInviteModalOpen] = useState(false);\n  const [editRolesModalOpen, setEditRolesModalOpen] = useState(false);\n\n  // Tab-specific loading states\n  const [tabLoading, setTabLoading] = useState<Record<string, boolean>>({\n    billing: false,\n    users: false,\n    invitations: false,\n    analytics: false,\n  });\n\n  const { toast } = useToast();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { user, isAuthenticated, isLoading: authLoading } = useAuth();\n\n  // Check if user is a job seeker (should see personal account page instead of team management)\n  const isJobSeeker = user?.role === USER_ROLES.JOB_SEEKER;\n  const [activeTab, setActiveTab] = useState(\"billing\");\n\n  // Mock current user roles for demo - in real app this would come from auth context\n  const currentUserRoles = [\"Admin\"];\n\n  useEffect(() => {\n    if (isAuthenticated && !authLoading) {\n      loadAccountUsers();\n    }\n  }, [isAuthenticated, authLoading]);\n\n  const handleTabChange = (value: string) => {\n    setActiveTab(value);\n\n    // Set loading state for the new tab briefly to show transition\n    setTabLoading((prev) => ({ ...prev, [value]: true }));\n\n    // Clear loading state after a brief delay to allow content to render\n    setTimeout(() => {\n      setTabLoading((prev) => ({ ...prev, [value]: false }));\n    }, 300);\n  };\n\n  const loadAccountUsers = async () => {\n    try {\n      setLoading(true);\n      setError(null);\n      const accountUsers = await accountService.getAccountUsers();\n      setUsers(accountUsers);\n    } catch (err) {\n      const errorMessage =\n        err instanceof Error ? err.message : \"Failed to load account users\";\n      setError(errorMessage);\n      toast({\n        title: \"Error\",\n        description: errorMessage,\n        variant: \"destructive\",\n      });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleInviteUser = async (inviteData: any) => {\n    try {\n      await accountService.inviteUser(inviteData);\n      toast({\n        title: \"Success\",\n        description: \"User invitation sent successfully\",\n      });\n      setInviteModalOpen(false);\n      loadAccountUsers(); // Refresh the list\n    } catch (err) {\n      const errorMessage =\n        err instanceof Error ? err.message : \"Failed to invite user\";\n      toast({\n        title: \"Error\",\n        description: errorMessage,\n        variant: \"destructive\",\n      });\n    }\n  };\n\n  const handleBulkInvite = async (bulkData: any) => {\n    try {\n      const result = await accountService.bulkInviteUsers(bulkData);\n      toast({\n        title: \"Bulk Invitation Complete\",\n        description: `${result.successCount} successful, ${result.failureCount} failed out of ${result.totalProcessed} total`,\n      });\n      setBulkInviteModalOpen(false);\n      loadAccountUsers(); // Refresh the list\n      return result;\n    } catch (err) {\n      const errorMessage =\n        err instanceof Error ? err.message : \"Failed to send bulk invitations\";\n      toast({\n        title: \"Error\",\n        description: errorMessage,\n        variant: \"destructive\",\n      });\n      throw err;\n    }\n  };\n\n  const handleUpdateRoles = async (userId: string, roles: string[]) => {\n    try {\n      await accountService.updateUserRoles({ userId, roles });\n      toast({\n        title: \"Success\",\n        description: \"User roles updated successfully\",\n      });\n      setEditRolesModalOpen(false);\n      setSelectedUser(null);\n      loadAccountUsers(); // Refresh the list\n    } catch (err) {\n      const errorMessage =\n        err instanceof Error ? err.message : \"Failed to update user roles\";\n      toast({\n        title: \"Error\",\n        description: errorMessage,\n        variant: \"destructive\",\n      });\n    }\n  };\n\n  const handleResendInvitation = async (userId: string) => {\n    try {\n      await accountService.resendInvitation(userId);\n      toast({\n        title: \"Success\",\n        description: \"Invitation resent successfully\",\n      });\n      loadAccountUsers(); // Refresh the list\n    } catch (err) {\n      const errorMessage =\n        err instanceof Error ? err.message : \"Failed to resend invitation\";\n      toast({\n        title: \"Error\",\n        description: errorMessage,\n        variant: \"destructive\",\n      });\n    }\n  };\n\n  const handleRemoveUser = async (userId: string) => {\n    if (\n      !confirm(\"Are you sure you want to remove this user from the account?\")\n    ) {\n      return;\n    }\n\n    try {\n      await accountService.removeUser(userId);\n      toast({\n        title: \"Success\",\n        description: \"User removed successfully\",\n      });\n      loadAccountUsers(); // Refresh the list\n    } catch (err) {\n      const errorMessage =\n        err instanceof Error ? err.message : \"Failed to remove user\";\n      toast({\n        title: \"Error\",\n        description: errorMessage,\n        variant: \"destructive\",\n      });\n    }\n  };\n\n  const getStatusIcon = (status: InviteStatus) => {\n    switch (status) {\n      case InviteStatus.Owner:\n        return <Crown className=\"h-4 w-4\" />;\n      case InviteStatus.Accepted:\n        return <CheckCircle className=\"h-4 w-4\" />;\n      case InviteStatus.Invited:\n        return <Clock className=\"h-4 w-4\" />;\n      case InviteStatus.Rejected:\n        return <XCircle className=\"h-4 w-4\" />;\n      case InviteStatus.Expired:\n        return <AlertCircle className=\"h-4 w-4\" />;\n      default:\n        return <Clock className=\"h-4 w-4\" />;\n    }\n  };\n\n  const handleExportAnalytics = (format: \"csv\" | \"pdf\") => {\n    // In a real app, this would generate and download the export\n    toast({\n      title: \"Export started\",\n      description: `Analytics export in ${format.toUpperCase()} format will be ready shortly.`,\n    });\n  };\n\n  const canManage = canManageUsers(currentUserRoles);\n\n  // If auth is loading, show loading state\n  if (authLoading) {\n    return (\n      <div className=\"min-h-screen bg-background\">\n        <Sidebar\n          isOpen={sidebarOpen}\n          onClose={closeSidebar}\n          collapsed={sidebarCollapsed}\n        />\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n          <Navigation\n            onMenuClick={openSidebar}\n            onSidebarToggle={toggleSidebar}\n            sidebarCollapsed={sidebarCollapsed}\n          />\n\n          <div className=\"pt-16\">\n            <div className=\"container mx-auto py-8\">\n              <AccountManagementSkeleton />\n            </div>\n          </div>\n\n          <Footer />\n        </div>\n      </div>\n    );\n  }\n\n  // Job seekers can now access account management for billing purposes\n\n  // If user is not authenticated, show marketing page\n  if (!isAuthenticated || !user) {\n    return (\n      <div className=\"min-h-screen bg-gradient-to-br from-background via-brand-purple/5 to-brand-blue/5\">\n        <Sidebar\n          isOpen={sidebarOpen}\n          onClose={closeSidebar}\n          collapsed={sidebarCollapsed}\n        />\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n          <Navigation\n            onMenuClick={openSidebar}\n            onSidebarToggle={toggleSidebar}\n            sidebarCollapsed={sidebarCollapsed}\n          />\n\n          <div className=\"pt-16\">\n            <div className=\"max-w-6xl mx-auto px-4 py-16\">\n              {/* Hero Section */}\n              <div className=\"text-center mb-16\">\n                <div className=\"inline-flex items-center space-x-2 mb-6\">\n                  <div className=\"relative\">\n                    <Users className=\"h-12 w-12 text-primary\" />\n                    <Sparkles className=\"h-6 w-6 text-brand-blue absolute -top-1 -right-1\" />\n                  </div>\n                  <span className=\"text-4xl font-bold bg-gradient-to-r from-brand-purple to-brand-blue bg-clip-text text-transparent\">\n                    Account Management\n                  </span>\n                </div>\n                <h1 className=\"text-5xl font-bold mb-6\">\n                  Manage Your Team and Organization\n                </h1>\n                <p className=\"text-xl text-muted-foreground mb-8 max-w-3xl mx-auto\">\n                  Streamline your company operations with powerful account\n                  management tools. Invite team members, assign roles, track\n                  analytics, and manage permissions all from one centralized\n                  dashboard.\n                </p>\n                <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n                  <Link to=\"/signup\">\n                    <Button\n                      size=\"lg\"\n                      className=\"bg-gradient-to-r from-brand-purple to-brand-blue hover:opacity-90 text-lg px-8\"\n                    >\n                      Start Managing Today\n                      <ArrowRight className=\"ml-2 h-5 w-5\" />\n                    </Button>\n                  </Link>\n                  <Link to=\"/login\">\n                    <Button\n                      size=\"lg\"\n                      variant=\"outline\"\n                      className=\"text-lg px-8\"\n                    >\n                      Sign In\n                    </Button>\n                  </Link>\n                </div>\n              </div>\n\n              {/* Features Grid */}\n              <div className=\"grid md:grid-cols-3 gap-8 mb-16\">\n                <Card className=\"border-brand-purple/20 hover:border-brand-purple/40 transition-colors\">\n                  <CardHeader>\n                    <UserPlus className=\"h-10 w-10 text-brand-purple mb-4\" />\n                    <CardTitle>Team Management</CardTitle>\n                    <CardDescription>\n                      Invite team members, assign roles, and manage permissions\n                      with granular access controls for your organization.\n                    </CardDescription>\n                  </CardHeader>\n                </Card>\n\n                <Card className=\"border-brand-blue/20 hover:border-brand-blue/40 transition-colors\">\n                  <CardHeader>\n                    <BarChart3 className=\"h-10 w-10 text-brand-blue mb-4\" />\n                    <CardTitle>Analytics Dashboard</CardTitle>\n                    <CardDescription>\n                      Track team performance, user engagement, and\n                      organizational metrics with comprehensive analytics and\n                      reporting.\n                    </CardDescription>\n                  </CardHeader>\n                </Card>\n\n                <Card className=\"border-brand-purple/20 hover:border-brand-purple/40 transition-colors\">\n                  <CardHeader>\n                    <Shield className=\"h-10 w-10 text-brand-purple mb-4\" />\n                    <CardTitle>Security & Compliance</CardTitle>\n                    <CardDescription>\n                      Enterprise-grade security with role-based access control,\n                      audit logs, and compliance features for your peace of\n                      mind.\n                    </CardDescription>\n                  </CardHeader>\n                </Card>\n              </div>\n\n              {/* Benefits Section */}\n              <div className=\"bg-white/50 rounded-2xl p-8 mb-16\">\n                <h2 className=\"text-3xl font-bold text-center mb-12\">\n                  Why Choose Our Account Management?\n                </h2>\n                <div className=\"grid md:grid-cols-2 gap-8\">\n                  <div className=\"flex items-start space-x-4\">\n                    <div className=\"bg-brand-purple/10 p-3 rounded-lg\">\n                      <Zap className=\"h-6 w-6 text-brand-purple\" />\n                    </div>\n                    <div>\n                      <h3 className=\"font-semibold mb-2\">\n                        Streamlined Operations\n                      </h3>\n                      <p className=\"text-muted-foreground\">\n                        Centralize all your team management tasks in one\n                        intuitive dashboard for maximum efficiency.\n                      </p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-start space-x-4\">\n                    <div className=\"bg-brand-blue/10 p-3 rounded-lg\">\n                      <Target className=\"h-6 w-6 text-brand-blue\" />\n                    </div>\n                    <div>\n                      <h3 className=\"font-semibold mb-2\">Role-Based Access</h3>\n                      <p className=\"text-muted-foreground\">\n                        Assign specific roles and permissions to ensure team\n                        members have access to exactly what they need.\n                      </p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-start space-x-4\">\n                    <div className=\"bg-brand-purple/10 p-3 rounded-lg\">\n                      <Network className=\"h-6 w-6 text-brand-purple\" />\n                    </div>\n                    <div>\n                      <h3 className=\"font-semibold mb-2\">Scalable Growth</h3>\n                      <p className=\"text-muted-foreground\">\n                        Built to grow with your organization, from small teams\n                        to enterprise-level operations.\n                      </p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-start space-x-4\">\n                    <div className=\"bg-brand-blue/10 p-3 rounded-lg\">\n                      <BarChart3 className=\"h-6 w-6 text-brand-blue\" />\n                    </div>\n                    <div>\n                      <h3 className=\"font-semibold mb-2\">Real-Time Insights</h3>\n                      <p className=\"text-muted-foreground\">\n                        Get actionable insights with real-time analytics and\n                        comprehensive reporting tools.\n                      </p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              {/* CTA Section */}\n              <div className=\"text-center\">\n                <h2 className=\"text-3xl font-bold mb-6\">\n                  Ready to Transform Your Team Management?\n                </h2>\n                <p className=\"text-xl text-muted-foreground mb-8 max-w-2xl mx-auto\">\n                  Join thousands of organizations already using our platform to\n                  streamline their operations and boost productivity.\n                </p>\n                <Link to=\"/signup\">\n                  <Button\n                    size=\"lg\"\n                    className=\"bg-gradient-to-r from-brand-purple to-brand-blue hover:opacity-90 text-lg px-8\"\n                  >\n                    Get Started Free\n                    <ArrowRight className=\"ml-2 h-5 w-5\" />\n                  </Button>\n                </Link>\n              </div>\n            </div>\n          </div>\n\n          <Footer />\n        </div>\n      </div>\n    );\n  }\n\n  // Show skeleton while initial data is loading, but keep page structure visible\n  const showInitialSkeleton = loading && users.length === 0;\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16\">\n          <div className=\"container mx-auto py-8 space-y-6\">\n            {/* Header */}\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <h1 className=\"text-3xl font-bold text-gray-900\">\n                  Account Management\n                </h1>\n                <p className=\"text-gray-600 mt-2\">\n                  {isJobSeeker \n                    ? \"Manage your billing, subscription, and account settings\"\n                    : \"Manage your team members, billing, invitations, and account analytics\"\n                  }\n                </p>\n              </div>\n              {canManage && activeTab === \"users\" && (\n                <Button\n                  onClick={() => setInviteModalOpen(true)}\n                  className=\"flex items-center gap-2\"\n                >\n                  <UserPlus className=\"h-4 w-4\" />\n                  Invite User\n                </Button>\n              )}\n            </div>\n\n            {/* Tabs */}\n            <Tabs value={activeTab} onValueChange={handleTabChange}>\n              <TabsList>\n                <TabsTrigger value=\"billing\">Billing & Subscription</TabsTrigger>\n                {!isJobSeeker && (\n                  <>\n                    <TabsTrigger value=\"users\">Team Members</TabsTrigger>\n                    <TabsTrigger value=\"invitations\">\n                      Invitation Analytics\n                    </TabsTrigger>\n                    <TabsTrigger value=\"analytics\">Analytics</TabsTrigger>\n                  </>\n                )}\n              </TabsList>\n\n              <TabsContent value=\"billing\" className=\"space-y-6\">\n                {activeTab === \"billing\" && <BillingManagement />}\n              </TabsContent>\n\n              <TabsContent value=\"users\" className=\"space-y-6\">\n                {showInitialSkeleton ? (\n                  <AccountManagementSkeleton showTabs={false} />\n                ) : (\n                  <>\n                    {/* Error State */}\n                    {error && (\n                      <Card className=\"border-red-200 bg-red-50\">\n                        <CardContent className=\"pt-6\">\n                          <div className=\"flex items-center gap-2 text-red-600\">\n                            <AlertCircle className=\"h-5 w-5\" />\n                            <span>{error}</span>\n                          </div>\n                        </CardContent>\n                      </Card>\n                    )}\n\n                    {/* Invitation Management */}\n                    <InvitationManagement\n                      users={users}\n                      onRefresh={loadAccountUsers}\n                      onInviteUser={() => setInviteModalOpen(true)}\n                      onBulkInvite={() => setBulkInviteModalOpen(true)}\n                    />\n                  </>\n                )}\n              </TabsContent>\n\n              <TabsContent value=\"invitations\" className=\"space-y-6\">\n                {tabLoading.invitations ? (\n                  <AccountManagementSkeleton showTabs={false} />\n                ) : (\n                  <InvitationAnalytics />\n                )}\n              </TabsContent>\n\n              <TabsContent value=\"analytics\">\n                {tabLoading.analytics ? (\n                  <AccountManagementSkeleton showTabs={false} />\n                ) : (\n                  <AccountAnalytics\n                    loading={loading}\n                    onExport={handleExportAnalytics}\n                    onLoadAnalytics={accountService.getAccountAnalytics}\n                  />\n                )}\n              </TabsContent>\n            </Tabs>\n\n            {/* Modals */}\n            <InviteUserModal\n              open={inviteModalOpen}\n              onOpenChange={setInviteModalOpen}\n              onInvite={handleInviteUser}\n              currentUserRoles={currentUserRoles}\n            />\n\n            <BulkInviteModal\n              open={bulkInviteModalOpen}\n              onOpenChange={setBulkInviteModalOpen}\n              onBulkInvite={handleBulkInvite}\n              currentUserRoles={currentUserRoles}\n            />\n\n            {selectedUser && (\n              <EditRolesModal\n                open={editRolesModalOpen}\n                onOpenChange={setEditRolesModalOpen}\n                user={selectedUser}\n                onUpdateRoles={handleUpdateRoles}\n                currentUserRoles={currentUserRoles}\n              />\n            )}\n          </div>\n        </div>\n\n        <Footer />\n      </div>\n    </div>\n  );\n}\n\nexport default function AccountManagement() {\n  return (\n    <PasswordRequirementsProvider>\n      <AccountManagementContent />\n    </PasswordRequirementsProvider>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\AffiliateDashboard.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":44,"column":9,"nodeType":"Member