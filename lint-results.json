      "},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Edit, ArrowLeft, Building2 } from \"lucide-react\";\nimport { useParams, Link } from \"react-router-dom\";\nimport { useState, useEffect } from \"react\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { companyService } from \"@/lib/services/company-service\";\nimport type { CompanyProfile } from \"@/lib/services/company-service\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\n\nexport default function CompanyEditPage() {\n  const { id } = useParams<{ id: string }>();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { user } = useAuth();\n\n  const [company, setCompany] = useState<CompanyProfile | null>(null);\n  const [isLoading, setIsLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  // Fetch company data\n  useEffect(() => {\n    const fetchCompany = async () => {\n      if (!id) return;\n\n      try {\n        setIsLoading(true);\n        setError(null);\n        const companyData = await companyService.getCompanyProfileById(id);\n        setCompany(companyData);\n      } catch (err) {\n        console.error(\"Failed to fetch company:\", err);\n        setError(\"Failed to load company. Please try again.\");\n      } finally {\n        setIsLoading(false);\n      }\n    };\n\n    fetchCompany();\n  }, [id]);\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16 p-6\">\n          <div className=\"max-w-4xl mx-auto\">\n            {/* Back Button */}\n            <div className=\"mb-6\">\n              <Button asChild variant=\"outline\">\n                <Link to={company ? `/companies/${company.id}` : \"/companies\"}>\n                  <ArrowLeft className=\"h-4 w-4 mr-2\" />\n                  {company ? \"Back to Company\" : \"Back to Companies\"}\n                </Link>\n              </Button>\n            </div>\n\n            {/* Header */}\n            <div className=\"mb-8\">\n              <h1 className=\"text-3xl font-bold mb-2\">\n                {company\n                  ? `Edit: ${company.data.name}`\n                  : \"Edit Company Profile\"}\n              </h1>\n              <p className=\"text-muted-foreground\">\n                Update your company information, culture, benefits, and team\n                details\n              </p>\n            </div>\n\n            <Card>\n              <CardContent className=\"p-8 text-center\">\n                <Edit className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                <h3 className=\"text-lg font-semibold mb-2\">\n                  Company Editor Coming Soon\n                </h3>\n                <p className=\"text-muted-foreground mb-6\">\n                  We're building a comprehensive company profile editor with\n                  real-time preview, team collaboration, and advanced\n                  customization options.\n                </p>\n                <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n                  <Button asChild>\n                    <Link\n                      to={company ? `/companies/${company.id}` : \"/companies\"}\n                    >\n                      {company ? \"View Company\" : \"View Companies\"}\n                    </Link>\n                  </Button>\n                  <Button variant=\"outline\">Request Early Access</Button>\n                </div>\n              </CardContent>\n            </Card>\n\n            {/* Current Company Info Preview */}\n            {company && (\n              <div className=\"mt-8\">\n                <h2 className=\"text-xl font-semibold mb-4\">\n                  Current Company Information\n                </h2>\n                <Card>\n                  <CardHeader>\n                    <div className=\"flex items-center gap-3\">\n                      <div className=\"w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center\">\n                        <Building2 className=\"h-6 w-6 text-primary\" />\n                      </div>\n                      <div>\n                        <CardTitle>{company.data.name}</CardTitle>\n                        <CardDescription>\n                          {company.data.tagline}\n                        </CardDescription>\n                      </div>\n                    </div>\n                  </CardHeader>\n                  <CardContent>\n                    <div className=\"grid md:grid-cols-2 gap-4 text-sm\">\n                      <div>\n                        <span className=\"text-muted-foreground\">Industry:</span>\n                        <span className=\"ml-2 font-medium\">\n                          {company.data.industry}\n                        </span>\n                      </div>\n                      <div>\n                        <span className=\"text-muted-foreground\">Size:</span>\n                        <span className=\"ml-2 font-medium\">\n                          {company.data.size} employees\n                        </span>\n                      </div>\n                   