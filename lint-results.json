\n                  your password\n                "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[5632,5759],"text":"\n                  Enter your email address and we&lsquo;ll send you a link to reset\n                  your password\n                "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[5632,5759],"text":"\n                  Enter your email address and we&#39;ll send you a link to reset\n                  your password\n                "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[5632,5759],"text":"\n                  Enter your email address and we&rsquo;ll send you a link to reset\n                  your password\n                "},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":221,"column":26,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[7709,7754],"text":"\n                      Don&apos;t have an account?"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[7709,7754],"text":"\n                      Don&lsquo;t have an account?"},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[7709,7754],"text":"\n                      Don&#39;t have an account?"},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[7709,7754],"text":"\n                      Don&rsquo;t have an account?"},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { ArrowLeft, Mail, CheckCircle, AlertCircle } from \"lucide-react\";\nimport { useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { apiClient } from \"@/lib/api-client\";\n\nexport default function ForgotPassword() {\n  const [email, setEmail] = useState(\"\");\n  const [loading, setLoading] = useState(false);\n  const [success, setSuccess] = useState(false);\n  const [error, setError] = useState(\"\");\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!email.trim()) {\n      setError(\"Please enter your email address\");\n      return;\n    }\n\n    if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n      setError(\"Please enter a valid email address\");\n      return;\n    }\n\n    setLoading(true);\n    setError(\"\");\n\n    try {\n      // Use the API endpoint for password reset\n      const { data } = await apiClient.requestRaw<{ message: string }>(\n        \"/api/account/reset-password\",\n        {\n          method: \"POST\",\n          body: { email },\n        },\n      );\n\n      setSuccess(true);\n    } catch (err) {\n      setError(\"Failed to send password reset email. Please try again.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  if (success) {\n    return (\n      <div className=\"min-h-screen bg-background\">\n        <Sidebar\n          isOpen={sidebarOpen}\n          onClose={closeSidebar}\n          collapsed={sidebarCollapsed}\n        />\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n          <Navigation\n            onMenuClick={openSidebar}\n            onSidebarToggle={toggleSidebar}\n            sidebarCollapsed={sidebarCollapsed}\n          />\n\n          <div className=\"pt-16\">\n            <div className=\"flex items-center justify-center min-h-[calc(100vh-200px)] px-4\">\n              <Card className=\"w-full max-w-md\">\n                <CardHeader className=\"text-center\">\n                  <div className=\"mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-green-100\">\n                    <CheckCircle className=\"h-6 w-6 text-green-600\" />\n                  </div>\n                  <CardTitle className=\"text-2xl\">Check Your Email</CardTitle>\n                  <CardDescription>\n                    We've sent password reset instructions to your email address\n                  </CardDescription>\n                </CardHeader>\n                <CardContent className=\"space-y-4\">\n                  <div className=\"rounded-lg bg-green-50 p-4\">\n                    <div className=\"flex items-start\">\n                      <Mail className=\"h-5 w-5 text-green-600 mt-0.5 mr-3\" />\n                      <div>\n                        <p className=\"text-sm font-medium text-green-800\">\n                          Email sent to {email}\n                        </p>\n                        <p className=\"text-sm text-green-700 mt-1\">\n                          Click the link in the email to reset your password.\n                          The link will expire in 24 hours.\n                        </p>\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-3\">\n                    <p className=\"text-sm text-gray-600 text-center\">\n                      Didn't receive the email? Check your spam folder or try\n                      again.\n                    </p>\n\n                    <Button\n                      variant=\"outline\"\n                      className=\"w-full\"\n                      onClick={() => {\n                        setSuccess(false);\n                        setEmail(\"\");\n                      }}\n                    >\n                      Try Different Email\n                    </Button>\n\n                    <div className=\"text-center\">\n                      <Link\n                        to=\"/login\"\n                        className=\"text-sm text-blue-600 hover:text-blue-500 inline-flex items-center\"\n                      >\n                        <ArrowLeft className=\"h-4 w-4 mr-1\" />\n                        Back to Sign In\n                      </Link>\n                    </div>\n                  </div>\n                </CardContent>\n              </Card>\n            </div>\n          </div>\n\n          <Footer />\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16\">\n          <div className=\"flex items-center justify-center min-h-[calc(100vh-200px)] px-4\">\n            <Card className=\"w-full max-w-md\">\n              <CardHeader className=\"text-center\">\n                <CardTitle className=\"text-2xl\">Reset Your Password</CardTitle>\n                <CardDescription>\n                  Enter your email address and we'll send you a link to reset\n                  your password\n                </CardDescription>\n              </CardHeader>\n              <CardContent>\n                <form onSubmit={handleSubmit} className=\"space-y-4\">\n                  {error && (\n                    <Alert variant=\"destructive\">\n                      <AlertCircle className=\"h-4 w-4\" />\n                      <AlertDescription>{error}</AlertDescription>\n                    </Alert>\n                  )}\n\n                  <div className=\"space-y-2\">\n                    <Label htmlFor=\"email\">Email Address</Label>\n                    <Input\n                      id=\"email\"\n                      type=\"email\"\n                      placeholder=\"Enter your email address\"\n                      value={email}\n                      onChange={(e) => setEmail(e.target.value)}\n                      disabled={loading}\n                      required\n                    />\n                  </div>\n\n                  <Button type=\"submit\" className=\"w-full\" disabled={loading}>\n                    {loading ? (\n                      <div className=\"flex items-center\">\n                        <div className=\"animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2\" />\n                        Sending Reset Link...\n                      </div>\n                    ) : (\n                      <>\n                        <Mail className=\"h-4 w-4 mr-2\" />\n                        Send Reset Link\n                      </>\n                    )}\n                  </Button>\n\n                  <div className=\"text-center space-y-2\">\n                    <p className=\"text-sm text-gray-600\">\n                      Remember your password?{\" \"}\n                      <Link\n                        to=\"/login\"\n                        className=\"text-blue-600 hover:text-blue-500 font-medium\"\n                      >\n                        Sign In\n                      </Link>\n                    </p>\n\n                    <p className=\"text-sm text-gray-600\">\n                      Don't have an account?{\" \"}\n                      <Link\n                        to=\"/signup\"\n                        className=\"text-blue-600 hover:text-blue-500 font-medium\"\n                      >\n                        Create Account\n                      </Link>\n                    </p>\n                  </div>\n                </form>\n              </CardContent>\n            </Card>\n          </div>\n        </div>\n\n        <Footer />\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\Help.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Shield' is defined but never used. Allowed unused vars must match /^_/u.","line":10,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":10,"endColumn":9},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'CreditCard' is defined but never used. Allowed unused vars must match /^_/u.","line":11,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":11,"endColumn":13},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Badge' is defined but never used. Allowed unused vars must match /^_/u.","line":27,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":27,"endColumn":15},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'user' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":54,"column":11,"nodeType":null,"messageId":"unusedVar","endLine":54,"endColumn":15},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'isAuthenticated' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":54,"column":17,"nodeType":null,"messageId":"unusedVar","endLine":54,"endColumn":32}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  HelpCircle,\n  Search,\n  MessageCircle,\n  Mail,\n  Phone,\n  Video,\n  Users,\n  Briefcase,\n  Shield,\n  CreditCard,\n  Zap,\n  BookOpen,\n  ExternalLink,\n  ArrowRight,\n} from \"lucide-react\";\nimport { useState } from \"react\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport {\n  Accordion,\n  AccordionContent,\n  AccordionItem,\n  AccordionTrigger,\n} from \"@/components/ui/accordion\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { useLocation } from \"react-router-dom\";\nimport { useSEO } from \"@/lib/seo\";\n\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\n\nexport default function Help() {\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const location = useLocation();\n  useSEO(location.pathname);\n  const { user, isAuthenticated } = useAuth();\n  const [searchQuery, setSearchQuery] = useState(\"\");\n\n  const faqs = [\n    {\n      category: \"Getting Started\",\n      questions: [\n        {\n          question: \"How do I create my first video resume?\",\n          answer:\n            \"To create your video resume, go to the Resumes section and click 'Create Video Resume'. You can either upload your own video or use our AI-powered video generation tool to create one from your existing resume.\",\n        },\n        {\n          question: \"What file formats are supported for uploads?\",\n          answer:\n            \"We support common video formats (MP4, MOV, AVI) for video uploads and PDF, DOC, DOCX for text resumes. Maximum file size is 100MB for videos and 10MB for documents.\",\n        },\n        {\n          question: \"How do I set up my profile?\",\n          answer:\n            \"After signing up, you'll be guided through our onboarding process. Complete your profile by adding your personal information, work experience, skills, and upload your resume or create a video resume.\",\n        },\n      ],\n    },\n    {\n      category: \"Account & Settings\",\n      questions: [\n        {\n          question: \"How do I change my password?\",\n          answer:\n            \"Go to Settings > Account and click 'Change Password'. You'll need to enter your current password and choose a new one.\",\n        },\n        {\n          question: \"Can I change my persona type after registration?\",\n          answer:\n            \"Yes, you can update your role (Job Seeker, Recruiter, Employer) in your Profile settings. Note that this will change your dashboard and available features.\",\n        },\n        {\n          question: \"How do I delete my account?\",\n          answer:\n            \"Account deletion can be done from Settings > Account > Delete Account. This action is permanent and cannot be undone.\",\n        },\n      ],\n    },\n    {\n      category: \"Video Resumes\",\n      questions: [\n        {\n          question: \"What makes a good video resume?\",\n          answer:\n            \"A good video resume should be 1-3 minutes long, professionally presented, highlight your key skills and experience, and include a clear call to action. Use good lighting and audio quality.\",\n        },\n        {\n          question: \"Can I edit my video resume after uploading?\",\n          answer:\n            \"Yes, you can edit the title, description, and tags of your video resume. To change the video content itself, you'll need to upload a new version.\",\n        },\n        {\n          question: \"How do I make my video resume private?\",\n          answer:\n            \"In your video resume settings, you can change the visibility to 'Private', 'Unlisted', or 'Public'. Private videos are only visible to you.\",\n        },\n      ],\n    },\n    {\n      category: \"Job Search\",\n      questions: [\n        {\n          question: \"How does job matching work?\",\n          answer:\n            \"Our AI analyzes your profile, skills, and preferences to match you with relevant job opportunities. You can refine matches by updating your preferences in Settings.\",\n        },\n        {\n          question: \"Can I track my job applications?\",\n          answer:\n            \"Yes, the Jobs section includes an application tracker where you can monitor the status of all your applications and set follow-up reminders.\",\n        },\n        {\n          question: \"How do I get notified about new job matches?\",\n          answer:\n            \"Enable job notifications in Settings > Notifications. You can choose to receive alerts via email or push notifications.\",\n        },\n      ],\n    },\n    {\n      category: \"For Recruiters\",\n      questions: [\n        {\n          question: \"How do I post a job opening?\",\n          answer:\n            \"Go to the Jobs section and click 'Post New Job'. Fill in the job details, requirements, and company information. Your posting will be visible to matching candidates.\",\n        },\n        {\n          question: \"Can I search for candidates by specific criteria?\",\n          answer:\n            \"Yes, use the People section to search and filter candidates by skills, experience level, location, and other criteria. You can save searches for future use.\",\n        },\n        {\n          question: \"How do I manage my candidate pipeline?\",\n          answer:\n            \"The Dashboard provides a pipeline view where you can track candidates through different stages of your hiring process, from initial contact to hiring.\",\n        },\n      ],\n    },\n  ];\n\n  const contactOptions = [\n    {\n      icon: MessageCircle,\n      title: \"Live Chat\",\n      description: \"Chat with our support team\",\n      action: \"Start Chat\",\n      available: \"Mon-Fri, 9AM-6PM PST\",\n    },\n    {\n      icon: Mail,\n      title: \"Email Support\",\n      description: \"Send us an email\",\n      action: \"Send Email\",\n      available: \"help@myvideoresume.me\",\n    },\n    {\n      icon: Phone,\n      title: \"Phone Support\",\n      description: \"Call our support line\",\n      action: \"Call Now\",\n      available: \"+1 (555) 123-4567\",\n    },\n  ];\n\n  const resources = [\n    {\n      icon: BookOpen,\n      title: \"Getting Started Guide\",\n      description:\n        \"Complete guide to setting up your profile and creating your first video resume\",\n      link: \"/guides/getting-started\",\n    },\n    {\n      icon: Video,\n      title: \"Video Resume Best Practices\",\n      description:\n        \"Tips and tricks for creating compelling video resumes that get results\",\n      link: \"/guides/video-best-practices\",\n    },\n    {\n      icon: Users,\n      title: \"Networking Tips\",\n      description:\n        \"How to build professional connections and leverage your network\",\n      link: \"/guides/networking\",\n    },\n    {\n      icon: Briefcase,\n      title: \"Job Search Strategies\",\n      description: \"Proven strategies for finding and landing your dream job\",\n      link: \"/guides/job-search\",\n    },\n  ];\n\n  const filteredFaqs = faqs\n    .map((category) => ({\n      ...category,\n      questions: category.questions.filter(\n        (q) =>\n          searchQuery === \"\" ||\n          q.question.toLowerCase().includes(searchQuery.toLowerCase()) ||\n          q.answer.toLowerCase().includes(searchQuery.toLowerCase()),\n      ),\n    }))\n    .filter((category) => category.questions.length > 0);\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16 p-6\">\n          <div className=\"max-w-6xl mx-auto space-y-8\">\n            {/* Header */}\n            <div className=\"text-center\">\n              <div className=\"inline-flex items-center space-x-2 mb-4\">\n                <HelpCircle className=\"h-8 w-8 text-primary\" />\n                <span className=\"text-2xl font-bold bg-gradient-to-r from-brand-purple to-brand-blue bg-clip-text text-transparent\">\n                  Help & Support\n                </span>\n              </div>\n              <h1 className=\"text-4xl font-bold mb-4\">How can we help you?</h1>\n              <p className=\"text-xl text-muted-foreground max-w-2xl mx-auto\">\n                Find answers to common questions, browse our guides, or get in\n                touch with our support team.\n              </p>\n            </div>\n\n            {/* Search */}\n            <div className=\"max-w-2xl mx-auto\">\n              <div className=\"relative\">\n                <Search className=\"absolute left-3 top-1/2 transform -translate-y-1/2 text-muted-foreground h-5 w-5\" />\n                <Input\n                  placeholder=\"Search for help topics, features, or questions...\"\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  className=\"pl-10 h-12 text-lg\"\n                />\n              </div>\n            </div>\n\n            {/* Main Content */}\n            <Tabs defaultValue=\"faq\" className=\"space-y-6\">\n              <TabsList className=\"grid w-full grid-cols-3 max-w-md mx-auto\">\n                <Tab