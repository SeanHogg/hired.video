oking for doesn&apos;t exist or has been removed.\r\n              "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[10391,10486],"text":"\r\n                The job you're looking for doesn&lsquo;t exist or has been removed.\r\n              "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[10391,10486],"text":"\r\n                The job you're looking for doesn&#39;t exist or has been removed.\r\n              "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[10391,10486],"text":"\r\n                The job you're looking for doesn&rsquo;t exist or has been removed.\r\n              "},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":681,"column":37,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":681,"endColumn":40,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[25751,25754],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[25751,25754],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":687,"column":43,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":687,"endColumn":46,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[26106,26109],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[26106,26109],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":10,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\r\n  MapPin,\r\n  DollarSign,\r\n  Clock,\r\n  Building2,\r\n  Globe,\r\n  Mail,\r\n  Play,\r\n  Edit,\r\n  Share,\r\n  Bookmark,\r\n  BookmarkCheck,\r\n  Users,\r\n  Eye,\r\n  Calendar,\r\n  ChevronDown,\r\n  ChevronUp,\r\n  ExternalLink,\r\n  Briefcase,\r\n  GraduationCap,\r\n  Award,\r\n  CheckCircle,\r\n  ArrowLeft,\r\n} from \"lucide-react\";\r\nimport { useState, useEffect } from \"react\";\r\nimport { useParams, useNavigate, Link , useLocation } from \"react-router-dom\";\r\nimport AuthOverlay from \"@/components/AuthOverlay\";\r\nimport Footer from \"@/components/Footer\";\r\nimport Navigation from \"@/components/Navigation\";\r\nimport Sidebar from \"@/components/Sidebar\";\r\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport {\r\n  Card,\r\n  CardContent,\r\n  CardDescription,\r\n  CardHeader,\r\n  CardTitle,\r\n} from \"@/components/ui/card\";\r\nimport { Separator } from \"@/components/ui/separator\";\r\nimport { jobService } from \"@/lib/services/job-service\";\r\nimport { useSidebar } from \"@/hooks/use-sidebar\";\r\nimport { useAuth } from \"@/lib/auth\";\r\nimport { useJobPermissions } from \"@/hooks/use-job-permissions\";\r\nimport { useSEO, generateStructuredData } from \"@/lib/seo\";\r\n\r\ntype UIJobRequirement = { skill: string; level: string; required: boolean };\r\ntype UIJobBenefit = { type: string; description: string };\r\ntype UIJobCompany = {\r\n  name: string;\r\n  logo?: string;\r\n  description?: string;\r\n  industry?: string;\r\n  size?: string;\r\n  website?: string;\r\n};\r\ntype UIJobLocation = { city?: string; state?: string; remote: boolean };\r\ntype UIJobData = {\r\n  title: string;\r\n  description: string;\r\n  company: UIJobCompany;\r\n  location: UIJobLocation;\r\n  videoUrl?: string;\r\n  contactEmail?: string;\r\n  applicationDeadline?: string;\r\n  responsibilities: string[];\r\n  requirements: UIJobRequirement[];\r\n  qualifications: string[];\r\n  benefits: UIJobBenefit[];\r\n  employmentType?: string;\r\n  experienceLevel?: string;\r\n  salaryMin?: number;\r\n  salaryMax?: number;\r\n};\r\ntype UIJob = {\r\n  id: string;\r\n  status: \"active\" | \"paused\" | \"closed\" | \"draft\";\r\n  createdAt: string;\r\n  updatedAt?: string;\r\n  expiresAt?: string;\r\n  views: number;\r\n  applications: number;\r\n  userId?: string;\r\n  data: UIJobData;\r\n};\r\n\r\nfunction mapApiJobToUI(apiJob: any): UIJob {\r\n  // If server returns envelope { success, data }, unwrap\r\n  const j = apiJob?.data && apiJob.success !== undefined ? apiJob.data : apiJob;\r\n  // Some jobs store serialized JSON in jobSerialized\r\n  let parsed: any = {};\r\n  try {\r\n    if (\r\n      typeof j.jobSerialized === \"string\" &&\r\n      j.jobSerialized.trim().length > 0\r\n    ) {\r\n      parsed = JSON.parse(j.jobSerialized);\r\n    }\r\n  } catch {\r\n    parsed = {};\r\n  }\r\n  return {\r\n    id: (j.id || j.Id || \"\").toString(),\r\n    status: ((j.status || j.Status) as UIJob[\"status\"]) || \"active\",\r\n    createdAt:\r\n      j.createdAt ||\r\n      j.creationDateTime ||\r\n      j.postedDate ||\r\n      new Date().toISOString(),\r\n    updatedAt:\r\n      j.updatedAt ||\r\n      j.updateDateTime ||\r\n      j.creationDateTime ||\r\n      new Date().toISOString(),\r\n    expiresAt: j.expiryDate || j.expirationDate,\r\n    views: j.viewCount ?? 0,\r\n    applications: j.applicationCount ?? 0,\r\n    userId: j.createdBy || j.userId,\r\n    data: {\r\n      title: j.title || parsed.title || \"\",\r\n      description: j.description || parsed.description || \"\",\r\n      company: {\r\n        name:\r\n          j.company?.name || j.company || parsed.company || \"Unknown Company\",\r\n        logo: j.companyLogo || j.company?.logoUrl || \"\",\r\n        website: j.companyWebsite,\r\n        description: j.companyDescription,\r\n        industry:\r\n          (Array.isArray(j.industry) ? j.industry[0] : j.industry) || undefined,\r\n        size: j.size,\r\n      },\r\n      location: {\r\n        remote: j.isRemote ?? false,\r\n        city: j.city || j.address?.city || undefined,\r\n        state: j.state || j.address?.stateProvince || undefined,\r\n      },\r\n      responsibilities: Array.isArray(j.responsibilities)\r\n        ? j.responsibilities\r\n        : Array.isArray(parsed.responsibilities)\r\n          ? parsed.responsibilities\r\n          : [],\r\n      requirements: Array.isArray(j.requirements)\r\n        ? j.requirements.map((r: string) => ({\r\n            skill: r,\r\n            level: \"Intermediate\",\r\n            required: true,\r\n          }))\r\n        : [],\r\n      qualifications: Array.isArray(j.qualifications) ? j.qualifications : [],\r\n      benefits: Array.isArray(j.benefits)\r\n        ? j.benefits.map((b: any) => ({\r\n            type: b.type || \"Benefit\",\r\n            description: b.description || \"\",\r\n          }))\r\n        : [],\r\n      employmentType:\r\n        (Array.isArray(j.employmentType)\r\n          ? j.employmentType[0]\r\n          : j.employmentType) || undefined,\r\n      experienceLevel: j.experienceLevel,\r\n      salaryMin: j.salaryMin,\r\n      salaryMax: j.salaryMax,\r\n      videoUrl: j.videoUrl,\r\n      contactEmail: j.contactEmail,\r\n      applicationDeadline: j.applicationDeadline,\r\n    },\r\n  };\r\n}\r\n\r\nexport default function JobDetail() {\r\n  const { id: slug } = useParams<{ id: string }>();\r\n  const navigate = useNavigate();\r\n  const { user, isAuthenticated } = useAuth();\r\n  const {\r\n    sidebarOpen,\r\n    sidebarCollapsed,\r\n    openSidebar,\r\n    closeSidebar,\r\n    toggleSidebar,\r\n  } = useSidebar();\r\n  const location = useLocation();\r\n\r\n  const [expandedSections, setExpandedSections] = useState<{\r\n    [key: string]: boolean;\r\n  }>({\r\n    responsibilities: true,\r\n    requirements: true,\r\n    qualifications: false,\r\n    benefits: false,\r\n  });\r\n\r\n  const [job, setJob] = useState<UIJob | null>(null);\r\n  const [loading, setLoading] = useState<boolean>(false);\r\n  const [error, setError] = useState<string | null>(null);\r\n  const [isTracked, setIsTracked] = useState<boolean>(false);\r\n\r\n  useEffect(() => {\r\n    let isMounted = true;\r\n    const run = async () => {\r\n      if (!slug) return;\r\n      try {\r\n        setLoading(true);\r\n        setError(null);\r\n\r\n        // Determine if the route param is a UUID or a slug\r\n        const isUUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(slug);\r\n\r\n        let apiJob: any;\r\n        if (isUUID) {\r\n          // Load by ID for UUIDs\r\n          apiJob = await jobService.getJobById(slug);\r\n        } else {\r\n          // Try slug first, then fallback to ID just in case\r\n          try {\r\n            apiJob = await jobService.getJobBySlug(slug);\r\n          } catch (slugErr) {\r\n            apiJob = await jobService.getJobById(slug);\r\n          }\r\n        }\r\n\r\n        if (!isMounted) return;\r\n        setJob(mapApiJobToUI(apiJob));\r\n      } catch (e) {\r\n        if (!isMounted) return;\r\n        setError(\"Failed to load job\");\r\n        setJob(null);\r\n      } finally {\r\n        if (isMounted) setLoading(false);\r\n      }\r\n    };\r\n    run();\r\n    return () => {\r\n      isMounted = false;\r\n    };\r\n  }, [slug]);\r\n\r\n  // SEO: compute and apply at top-level to respect Rules of Hooks\r\n  const jobSeoTitle = job\r\n    ? `${job.data.title} at ${job.data.company.name} | MyVideoResu.me`\r\n    : undefined;\r\n  const jobSeoDescription = job\r\n    ? `${job.data.title} at ${job.data.company.name}${job.data.location?.remote ? \" (Remote)\" : job.data.location?.city ? ` in ${job.data.location.city}, ${job.data.location.state}` : \"\"}. ${job.data.description?.slice(0, 150)}`\r\n    : undefined;\r\n  const jobStructuredData = job\r\n    ? generateStructuredData.jobPosting({\r\n        title: job.data.title,\r\n        description: job.data.description,\r\n        postedDate: job.createdAt,\r\n        employmentType: job.data.employmentType,\r\n        companyName: job.data.company.name,\r\n        location: job.data.location.remote\r\n          ? \"Remote\"\r\n          : `${job.data.location.city || \"\"}, ${job.data.location.state || \"\"}`,\r\n        salaryRange:\r\n          job.data.salaryMin && job.data.salaryMax\r\n            ? `${(job.data.salaryMin / 1000).toFixed(0)}k-${(job.data.salaryMax / 1000).toFixed(0)}k`\r\n            : undefined,\r\n      })\r\n    : undefined;\r\n\r\n  useSEO(location.pathname, {\r\n    title: jobSeoTitle,\r\n    description: jobSeoDescription,\r\n    ogTitle: jobSeoTitle,\r\n    ogDescription: jobSeoDescription,\r\n    structuredData: jobStructuredData,\r\n  });\r\n\r\n  const isOwner = user && job && job.userId === user.id;\r\n  const permissions = useJobPermissions(job);\r\n\r\n  const toggleSection = (section: string) => {\r\n    setExpandedSections((prev) => ({\r\n      ...prev,\r\n      [section]: !prev[section],\r\n    }));\r\n  };\r\n\r\n  const handleTrackJob = () => {\r\n    if (!isAuthenticated) return;\r\n    setIsTracked((prev) => !prev);\r\n  };\r\n\r\n  if (loading) {\r\n    return (\r\n      <div className=\"min-h-screen bg-background\">\r\n        <Sidebar\r\n          isOpen={sidebarOpen}\r\n          onClose={closeSidebar}\r\n          collapsed={sidebarCollapsed}\r\n        />\r\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\r\n          <Navigation\r\n            onMenuClick={openSidebar}\r\n            onSidebarToggle={toggleSidebar}\r\n            sidebarCollapsed={sidebarCollapsed}\r\n          />\r\n          <div className=\"pt-16 p-6\">\r\n            <div className=\"max-w-4xl mx-auto\">\r\n              <Card>\r\n                <CardHeader>\r\n                  <h1 className=\"text-2xl font-bold\">Loading job...</h1>\r\n                  <CardDescription>Please wait</CardDescription>\r\n                </CardHeader>\r\n                <CardContent>\r\n                  <div className=\"h-40 bg-muted animate-pulse rounded\" />\r\n                </CardContent>\r\n              </Card>\r\n            </div>\r\n          </div>\r\n          <Footer />\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  if (!job) {\r\n    return (\r\n      <div className=\"min-h-screen bg-background\">\r\n        <Sidebar\r\n          isOpen={sidebarOpen}\r\n          onClose={closeSidebar}\r\n          collapsed={sidebarCollapsed}\r\n        />\r\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\r\n          <Navigation\r\n            onMenuClick={openSidebar}\r\n            onSidebarToggle={toggleSidebar}\r\n            sidebarCollapsed={sidebarCollapsed}\r\n          />\r\n          <div className=\"pt-16 p-6\">\r\n            <div className=\"max-w-4xl mx-auto text-center\">\r\n              <h1 className=\"text-2xl font-bold mb-4\">Job Not Found</h1>\r\n              <p className=\"text-muted-foreground mb-6\">\r\n                The job you're looking for doesn't exist or has been removed.\r\n              </p>\r\n              <Button asChild>\r\n                <Link to=\"/jobs\">\r\n                  <ArrowLeft className=\"h-4 w-4 mr-2\" />\r\n                  Back to Jobs\r\n                </Link>\r\n              </Button>\r\n            </div>\r\n          </div>\r\n          <Footer />\r\n        </div>\r\n      </div>\r\n    );\r\n  }\r\n\r\n  const getStatusColor = (status: string) => {\r\n    switch (status) {\r\n      case \"active\":\r\n        return \"bg-green-100 text-green-800\";\r\n      case \"paused\":\r\n        return \"bg-yellow-100 text-yellow-800\";\r\n      case \"closed\":\r\n        return \"bg-gray-100 text-gray-800\";\r\n      case \"draft\":\r\n        return \"bg-orange-100 text-orange-800\";\r\n      default:\r\n        return \"bg-gray-100 text-gray-800\";\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div className=\"min-h-screen bg-background\">\r\n      <Sidebar\r\n        isOpen={sidebarOpen}\r\n        onClose={closeSidebar}\r\n        collapsed={sidebarCollapsed}\r\n      />\r\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\r\n        <Navigation\r\n          onMenuClick={openSidebar}\r\n          onSidebarToggle={toggleSidebar}\r\n          sidebarCollapsed={sidebarCollapsed}\r\n        />\r\n\r\n        <div className={`pt-16 ${!isAuthenticated ? \"relative\" : \"\"}`}>\r\n          {!isAuthenticated && (\r\n            <AuthOverlay contentType=\"job\" title={job?.data.title} />\r\n          )}\r\n          <div className=\"max-w-6xl mx-auto p-6\">\r\n            {/* Back Button */}\r\n            <div className=\"mb-6\">\r\n              <Button variant=\"outline\" onClick={() => navigate(\"/jobs\")}>\r\n                <ArrowLeft className=\"h-4 w-4 mr-2\" />\r\n                Back to Jobs\r\n              </Button>\r\n            </div>\r\n\r\n            {/* Job Header */}\r\n            <div className=\"mb-8\">\r\n              <Card>\r\n                <CardHeader className=\"pb-6\">\r\n                  <div className=\"flex flex-col lg:flex-row gap-6\">\r\n                    {/* Company Logo */}\r\n                    <div className=\"flex-shrink-0\">\r\n                      <Avatar className=\"w-24 h-24\">\r\n                        <AvatarImage\r\n                          src={job.data.company.logo}\r\n                          alt={job.data.company.name}\r\n                        />\r\n                        <AvatarFallback className=\"text-2xl\">\r\n                          {job.data.company.name.substring(0, 2).toUpperCase()}\r\n                        </AvatarFallback>\r\n                      </Avatar>\r\n                    </div>\r\n\r\n                    {/* Job Info */}\r\n                    <div className=\"flex-1\">\r\n                      <div className=\"flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-4\">\r\n                        <div>\r\n                          <div className=\"flex items-center gap-2 mb-2\">\r\n                            <h1 className=\"text-2xl font-bold\">\r\n                              {job.data.title}\r\n                            </h1>\r\n                            <Badge className={getStatusColor(job.status)}>\r\n                              {job.status}\r\n                            </Badge>\r\n                          </div>\r\n                          <CardDescription className=\"flex items-center gap-2 text-lg\">\r\n                            <Building2 className=\"h-5 w-5\" />\r\n                            {job.data.company.name}\r\n                          </CardDescription>\r\n                        </div>\r\n\r\n                        <div className=\"flex items-center gap-2\">\r\n                          {permissions.canEdit ? (\r\n                            <Button asChild>\r\n                              <Link to={`/jobs/edit/${job.id}`}>\r\n                                <Edit className=\"h-4 w-4 mr-2\" />\r\n                                Edit Job\r\n                              </Link>\r\n                            </Button>\r\n                          ) : (\r\n                            <>\r\n                              <Button\r\n                                variant=\"outline\"\r\n                                onClick={handleTrackJob}\r\n                              >\r\n                                {isTracked ? (\r\n                                  <>\r\n                                    <BookmarkCheck className=\"h-4 w-4 mr-2\" />\r\n                                    Tracked\r\n                                  </>\r\n                                ) : (\r\n                                  <>\r\n                                    <Bookmark className=\"h-4 w-4 mr-2\" />\r\n                                    Track\r\n                                  </>\r\n                                )}\r\n                              </Button>\r\n                              <Button\r\n                                onClick={() => (isAuthenticated ? null : null)}\r\n                                disabled={!isAuthenticated}\r\n                              >\r\n                                Apply Now\r\n                                <ExternalLink className=\"h-4 w-4 ml-2\" />\r\n                              </Button>\r\n                            </>\r\n                          )}\r\n                          <Button variant=\"outline\" size=\"icon\">\r\n                            <Share className=\"h-4 w-4\" />\r\n                          </Button>\r\n                        </div>\r\n                      </div>\r\n\r\n                      {/* Quick Info */}\r\n                      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm\">\r\n                        <div className=\"flex items-center gap-2\">\r\n                          <MapPin className=\"h-4 w-4 text-muted-foreground\" />\r\n                          <span>\r\n                            {job.data.location.remote\r\n                              ? \"Remote\"\r\n                              : `${job.data.location.city}, ${job.data.location.state}`}\r\n                          </span>\r\n                        </div>\r\n                        {job.data.salaryMin && job.data.salaryMax && (\r\n                          <div className=\"flex items-center gap-2\">\r\n                            <DollarSign className=\"h-4 w-4 text-muted-foreground\" />\r\n                            <span>\r\n                              ${(job.data.salaryMin / 1000).toFixed(0)}k - $\r\n                              {(job.data.salaryMax / 1000).toFixed(0)}k\r\n                            </span>\r\n                          </div>\r\n                        )}\r\n                        <div className=\"flex items-center gap-2\">\r\n                          <Clock className=\"h-4 w-4 text-muted-foreground\" />\r\n                          <span className=\"capitalize\">\r\n                            {job.data.employmentType}\r\n                          </span>\r\n                        </div>\r\n                        <div className=\"flex items-center gap-2\">\r\n                          <Briefcase className=\"h-4 w-4 text-muted-foreground\" />\r\n                          <span className=\"capitalize\">\r\n                            {job.data.experienceLevel} level\r\n                          </span>\r\n                        </div>\r\n                      </div>\r\n\r\n                      {/* Stats */}\r\n                      <div className=\"flex items-center gap-6 mt-4 pt-4 border-t\">\r\n                        <div className=\"flex items-center gap-2 text-sm text-muted-foreground\">\r\n                          <Eye className=\"h-4 w-4\" />\r\n                          {job.views} views\r\n                        </div>\r\n                        <div className=\"flex items-center gap-2 text-sm text-muted-foreground\">\r\n                          <Users className=\"h-4 w-4\" />\r\n                          {job.applications} applications\r\n                        </div>\r\n                        <div className=\"flex items-center gap-2 text-sm text-muted-foreground\">\r\n                          <Calendar className=\"h-4 w-4\" />\r\n                          Posted{\" \"}\r\n                          {job.createdAt &&\r\n                          !isNaN(new Date(job.createdAt).getTime())\r\n                            ? new Date(job.createdAt).toLocaleDateString()\r\n                            : \"Unknown date\"}\r\n                        </div>\r\n                        {job.expiresAt && (\r\n                          <div className=\"flex items-center gap-2 text-sm text-muted-foreground\">\r\n                            <Calendar className=\"h-4 w-4\" />\r\n                            Expires{\" \"}\r\n                            {!isNaN(new Date(job.expiresAt).getTime())\r\n                              ? new Date(job.expiresAt).toLocaleDateString()\r\n                              : \"Unknown date\"}\r\n                          </div>\r\n                        )}\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </CardHeader>\r\n              </Card>\r\n            </div>\r\n\r\n            <div className=\"grid lg:grid-cols-3 gap-6\">\r\n              {/* Main Content */}\r\n              <div className=\"lg:col-span-2 space-y-6\">\r\n                {/* Video Section */}\r\n                {job.data.videoUrl && (\r\n                  <Card>\r\n                    <CardHeader>\r\n                      <CardTitle className=\"flex items-center gap-2\">\r\n                        <Play className=\"h-5 w-5\" />\r\n                        Job Overview Video\r\n                      </CardTitle>\r\n                    </CardHeader>\r\n                    <CardContent>\r\n                      <div className=\"aspect-video bg-gray-100 rounded-lg flex items-center justify-center\">\r\n                        <div className=\"text-center\">\r\n                          <Play className=\"h-12 w-12 mx-auto text-muted-foreground mb-2\" />\r\n                          <p className=\"text-muted-foreground\">\r\n                            Video preview not available\r\n                          </p>\r\n                          <Button variant=\"outline\" className=\"mt-4\">\r\n                            Watch on External Player\r\n                            <ExternalLink className=\"h-4 w-4 ml-2\" />\r\n                          </Button>\r\n                        </div>\r\n                      </div>\r\n                    </CardContent>\r\n                  </Card>\r\n                )}\r\n\r\n                {/* Job Description */}\r\n                <Card>\r\n                  <CardHeader>\r\n                    <CardTitle>About This Role</CardTitle>\r\n                  </CardHeader>\r\n                  <CardContent>\r\n                    <p className=\"whitespace-pre-line\">\r\n                      {job.data.description}\r\n                    </p>\r\n                  </CardContent>\r\n                </Card>\r\n\r\n                {/* Responsibilities */}\r\n                <Card>\r\n                  <CardHeader\r\n                    className=\"cursor-pointer\"\r\n                    onClick={() => toggleSection(\"responsibilities\")}\r\n                  >\r\n                    <CardTitle className=\"flex items-center justify-between\">\r\n                      Key Responsibilities\r\n                      {expandedSections.responsibilities ? (\r\n                        <ChevronUp className=\"h-5 w-5\" />\r\n                      ) : (\r\n                        <ChevronDown className=\"h-5 w-5\" />\r\n                      )}\r\n                    </CardTitle>\r\n                  </CardHeader>\r\n                  {expandedSections.responsibilities && (\r\n                    <CardContent>\r\n                      <ul className=\"space-y-2\">\r\n                        {job.data.responsibilities.map(\r\n                          (responsibility, index) => (\r\n                            <li key={index} className=\"flex items-start gap-2\">\r\n                              <CheckCircle className=\"h-4 w-4 text-green-600 mt-1 flex-shrink-0\" />\r\n                              <span>{responsibility}</span>\r\n                            </li>\r\n                          ),\r\n                        )}\r\n                      </ul>\r\n                    </CardContent>\r\n                  )}\r\n                </Card>\r\n\r\n                {/* Requirements */}\r\n                <Card>\r\n                  <CardHeader\r\n                    className=\"cursor-pointer\"\r\n                    onClick={() => toggleSection(\"requirements\")}\r\n                  >\r\n                    <CardTitle className=\"flex items-center justify-between\">\r\n                      Required Skills\r\n                      {expandedSections.requirements ? (\r\n                        <ChevronUp className=\"h-5 w-5\" />\r\n                      ) : (\r\n                        <ChevronDown className=\"h-5 w-5\" />\r\n                      )}\r\n                    </CardTitle>\r\n                  </CardHeader>\r\n                  {expandedSections.requirements && (\r\n                    <CardContent>\r\n                      <div className=\"space-y-3\">\r\n                        {job.data.requirements.map((req, index) => (\r\n                          <div\r\n                            key={index}\r\n                            className=\"flex items-center justify-between p-3 bg-gray-50 rounded-lg\"\r\n                          >\r\n                            <div className=\"flex items-center gap-3\">\r\n                              <Badge\r\n                                variant={req.required ? \"default\" : \"outline\"}\r\n                              >\r\n                                {req.skill}\r\n                              </Badge>\r\n                              <span className=\"text-sm text-muted-foreground\">\r\n                                {req.level}\r\n                              </span>\r\n                            </div>\r\n                            <span className=\"text-xs text-muted-foreground\">\r\n                              {req.required ? \"Required\" : \"Nice to have\"}\r\n                            </span>\r\n                          </div>\r\n                        ))}\r\n                      </div>\r\n                    </CardContent>\r\n                  )}\r\n                </Card>\r\n\r\n                {/* Qualifications */}\r\n                <Card>\r\n                  <CardHeader\r\n                    className=\"cursor-pointer\"\r\n                    onClick={() => toggleSection(\"qualifications\")}\r\n                  >\r\n                    <CardTitle className=\"flex items-center justify-between\">\r\n                      <div className=\"flex items-center gap-2\">\r\n                        <GraduationCap className=\"h-5 w-5\" />\r\n                        Qualifications\r\n                      </div>\r\n                      {expandedSections.qualifications ? (\r\n                        <ChevronUp className=\"h-5 w-5\" />\r\n                      ) : (\r\n                        <ChevronDown className=\"h-5 w-5\" />\r\n                      )}\r\n                    </CardTitle>\r\n                  </CardHeader>\r\n                  {expandedSections.qualifications && (\r\n                    <CardContent>\r\n                      <ul className=\"space-y-2\">\r\n                        {job.data.qualifications.map((qualification, index) => (\r\n                          <li key={index} className=\"flex items-start gap-2\">\r\n                            <CheckCircle className=\"h-4 w-4 text-blue-600 mt-1 flex-shrink-0\" />\r\n                            <span>{qualification}</span>\r\n                          </li>\r\n                        ))}\r\n                      </ul>\r\n                      {(job.data as any).education && (\r\n                        <div className=\"mt-4 p-3 bg-blue-50 rounded-lg\">\r\n                          <p className=\"text-sm font-medium text-blue-900 mb-1\">\r\n                            Education\r\n                          </p>\r\n                          <p className=\"text-sm text-blue-700\">\r\n                            {(job.data as any).education}\r\n                          </p>\r\n                        </div>\r\n                      )}\r\n                    </CardContent>\r\n                  )}\r\n                </Card>\r\n\r\n                {/* Benefits */}\r\n                <Card>\r\n                  <CardHeader\r\n                    className=\"cursor-pointer\"\r\n                    onClick={() => toggleSection(\"benefits\")}\r\n                  >\r\n                    <CardTitle className=\"flex items-center justify-between\">\r\n                      <div className=\"flex items-center gap-2\">\r\n                        <Award className=\"h-5 w-5\" />\r\n                        Benefits & Perks\r\n                      </div>\r\n                      {expandedSections.benefits ? (\r\n                        <ChevronUp className=\"h-5 w-5\" />\r\n                      ) : (\r\n                        <ChevronDown className=\"h-5 w-5\" />\r\n                      )}\r\n                    </CardTitle>\r\n                  </CardHeader>\r\n                  {expandedSections.benefits && (\r\n                    <CardContent>\r\n                      <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\r\n                        {job.data.benefits.map((benefit, index) => (\r\n                          <div key={index} className=\"p-3 border rounded-lg\">\r\n                            <h4 className=\"font-medium text-sm mb-1\">\r\n                              {benefit.type}\r\n                            </h4>\r\n                            <p className=\"text-sm text-muted-foreground\">\r\n                              {benefit.description}\r\n                            </p>\r\n                          </div>\r\n                        ))}\r\n                      </div>\r\n                    </CardContent>\r\n                  )}\r\n                </Card>\r\n              </div>\r\n\r\n              {/* Sidebar */}\r\n              <div className=\"space-y-6\">\r\n                {/* Company Info */}\r\n                <Card>\r\n                  <CardHeader>\r\n                    <CardTitle className=\"flex items-center gap-2\">\r\n                      <Building2 className=\"h-5 w-5\" />\r\n                      About {job.data.company.name}\r\n                    </CardTitle>\r\n                  </CardHeader>\r\n                  <CardContent className=\"space-y-4\">\r\n                    <div>\r\n                      <Avatar className=\"w-16 h-16 mb-3\">\r\n                        <AvatarImage\r\n                          src={job.data.company.logo}\r\n                          alt={job.data.company.name}\r\n                        />\r\n                        <AvatarFallback className=\"text-lg\">\r\n                          {job.data.company.name.substring(0, 2).toUpperCase()}\r\n                        </AvatarFallback>\r\n                      </Avatar>\r\n                      <h3 className=\"font-semibold mb-2\">\r\n                        {job.data.company.name}\r\n                      </h3>\r\n                      {job.data.company.description && (\r\n                        <p className=\"text-sm text-muted-foreground mb-3\">\r\n                          {job.data.company.description}\r\n                        </p>\r\n                      )}\r\n                    </div>\r\n\r\n                    <Separator />\r\n\r\n                    <div className=\"space-y-2 text-sm\">\r\n                      {job.data.company.industry && (\r\n                        <div className=\"flex justify-between\">\r\n                          <span className=\"text-muted-foreground\">\r\n                            Industry\r\n                          </span>\r\n                          <span>{job.data.company.industry}</span>\r\n                        </div>\r\n                      )}\r\n                      {job.data.company.size && (\r\n                        <div className=\"flex justify-between\">\r\n                          <span className=\"text-muted-foreground\">\r\n                            Company size\r\n                          </span>\r\n                          <span>{job.data.company.size} employees</span>\r\n                        </div>\r\n                      )}\r\n                      {job.data.company.website && (\r\n                        <div className=\"flex justify-between\">\r\n                          <span className=\"text-muted-foreground\">Website</span>\r\n                          <a\r\n                            href={job.data.company.website}\r\n                            target=\"_blank\"\r\n                            rel=\"noopener noreferrer\"\r\n                            className=\"text-primary hover:underline flex items-center gap-1\"\r\n                          >\r\n                            <Globe className=\"h-3 w-3\" />\r\n                            Visit\r\n                          </a>\r\n                        </div>\r\n                      )}\r\n                    </div>\r\n                  </CardContent>\r\n                </Card>\r\n\r\n                {/* Apply Section */}\r\n                {!permissions.canEdit && (\r\n                  <Card>\r\n                    <CardHeader>\r\n                      <CardTitle>Ready to Apply?</CardTitle>\r\n                    </CardHeader>\r\n                    <CardContent className=\"space-y-4\">\r\n                      <Button\r\n                        className=\"w-full\"\r\n                        size=\"lg\"\r\n                        onClick={() => (isAuthenticated ? null : null)}\r\n                        disabled={!isAuthenticated}\r\n                      >\r\n                        Apply Now\r\n                        <ExternalLink className=\"h-4 w-4 ml-2\" />\r\n                      </Button>\r\n\r\n                      {job.data.contactEmail && (\r\n                        <div className=\"text-center\">\r\n                          <p className=\"text-sm text-muted-foreground mb-2\">\r\n                            Or contact directly\r\n                          </p>\r\n                          <Button\r\n                            variant=\"outline\"\r\n                            size=\"sm\"\r\n                            className=\"w-full\"\r\n                          >\r\n                            <Mail className=\"h-4 w-4 mr-2\" />\r\n                            {job.data.contactEmail}\r\n                          </Button>\r\n                        </div>\r\n                      )}\r\n\r\n                      <div className=\"text-xs text-muted-foreground text-center space-y-1\">\r\n                        <p>By applying, you agree to our terms of service.</p>\r\n                        {job.data.applicationDeadline && (\r\n                          <p className=\"text-red-600\">\r\n                            Application deadline:{\" \"}\r\n                            {new Date(\r\n                              job.data.applicationDeadline,\r\n                            ).toLocaleDateString()}\r\n                          </p>\r\n                        )}\r\n                      </div>\r\n                    </CardContent>\r\n                  </Card>\r\n                )}\r\n\r\n                {/* Job Stats */}\r\n                <Card>\r\n                  <CardHeader>\r\n                    <CardTitle>Job Statistics</CardTitle>\r\n                  </CardHeader>\r\n                  <CardContent className=\"space-y-3\">\r\n                    <div className=\"flex justify-between text-sm\">\r\n                      <span className=\"text-muted-foreground\">Views</span>\r\n                      <span className=\"font-medium\">{job.views}</span>\r\n                    </div>\r\n                    <div className=\"flex justify-between text-sm\">\r\n                      <span className=\"text-muted-foreground\">\r\n                        Applications\r\n                      </span>\r\n                      <span className=\"font-medium\">{job.applications}</span>\r\n                    </div>\r\n                    <div className=\"flex justify-between text-sm\">\r\n                      <span className=\"text-muted-foreground\">Posted</span>\r\n                      <span className=\"font-medium\">\r\n                        {job.createdAt &&\r\n                        !isNaN(new Date(job.createdAt).getTime())\r\n                          ? new Date(job.createdAt).toLocaleDateString()\r\n                          : \"Unknown date\"}\r\n                      </span>\r\n                    </div>\r\n                    {job.expiresAt && (\r\n                      <div className=\"flex justify-between text-sm\">\r\n                        <span className=\"text-muted-foreground\">Expires</span>\r\n                        <span className=\"font-medium\">\r\n                          {!isNaN(new Date(job.expiresAt).getTime())\r\n                            ? new Date(job.expiresAt).toLocaleDateString()\r\n                            : \"Unknown date\"}\r\n                        </span>\r\n                      </div>\r\n                    )}\r\n                  </CardContent>\r\n                </Card>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <Footer />\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\JobEditPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Edit' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":1,"endColumn":14},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'CardDescription' is defined but never used. Allowed unused vars must match /^_/u.","line":11,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":11,"en