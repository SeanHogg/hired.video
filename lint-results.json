berExpression","messageId":"unexpected","endLine":660,"endColumn":20,"suggestions":[{"fix":{"range":[19003,19063],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":9,"fatalErrorCount":0,"warningCount":11,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Dashboard Service\n * Handles user dashboard data and analytics with real API integration\n */\n\nimport { z } from \"zod\";\nimport { apiClient } from \"../api-client\";\nimport {\n  createRolePermissions,\n  DASHBOARD_TYPES,\n  type DashboardType,\n} from \"../role-utils\";\nimport {\n  searchService,\n  type SearchResponse,\n  type SearchFilters,\n} from \"./search-service\";\n\n// ============================================================================\n// SCHEMAS\n// ============================================================================\n\n// Dashboard metric schema\nexport const DashboardMetricSchema = z.object({\n  title: z.string(),\n  value: z.string(),\n  change: z.string().optional(),\n  changeType: z.enum([\"up\", \"down\", \"neutral\"]).optional(),\n  icon: z.string().optional(),\n  description: z.string().optional(),\n  trend: z.string().optional(),\n  metadata: z.record(z.string(), z.any()).optional(),\n});\n\n// Activity item schema\nexport const ActivityItemSchema = z.object({\n  id: z.string(),\n  type: z.string(),\n  content: z.string(),\n  time: z.string(),\n  timestamp: z.string().transform((val) => new Date(val)),\n  icon: z.string().optional(),\n  url: z.string().optional(),\n  metadata: z.record(z.string(), z.any()).optional(),\n});\n\n// Onboarding task schema\nexport const OnboardingTaskSchema = z.object({\n  id: z.string(),\n  title: z.string(),\n  description: z.string().optional(),\n  completed: z.boolean(),\n  url: z.string().optional(),\n  priority: z.number().default(1),\n});\n\n// Base dashboard schema\nexport const BaseDashboardSchema = z.object({\n  title: z.string(),\n  description: z.string(),\n  metrics: z.array(DashboardMetricSchema),\n  recentActivity: z.array(ActivityItemSchema),\n  onboardingTasks: z.array(OnboardingTaskSchema),\n  lastUpdated: z.string().transform((val) => new Date(val)),\n});\n\n// Profile stats schema\nexport const ProfileStatsSchema = z.object({\n  totalViews: z.number(),\n  viewsThisWeek: z.number(),\n  viewsThisMonth: z.number(),\n  viewsChangePercentage: z.number(),\n  recentViewers: z.array(\n    z.object({\n      userId: z.string().optional(),\n      name: z.string(),\n      company: z.string().optional(),\n      role: z.string().optional(),\n      viewedAt: z.string().transform((val) => new Date(val)),\n    }),\n  ),\n});\n\n// Application stats schema\nexport const ApplicationStatsSchema = z.object({\n  totalApplications: z.number(),\n  pendingApplications: z.number(),\n  interviewRequests: z.number(),\n  rejectedApplications: z.number(),\n  successRate: z.number(),\n  recentApplications: z.array(\n    z.object({\n      applicationId: z.string(),\n      jobTitle: z.string(),\n      company: z.string(),\n      status: z.string(),\n      appliedAt: z.string().transform((val) => new Date(val)),\n      updatedAt: z\n        .string()\n        .transform((val) => new Date(val))\n        .optional(),\n    }),\n  ),\n});\n\n// Job seeker dashboard schema\nexport const JobSeekerDashboardSchema = BaseDashboardSchema.extend({\n  profileStats: ProfileStatsSchema,\n  applicationStats: ApplicationStatsSchema,\n  jobMatches: z.array(\n    z.object({\n      jobId: z.string(),\n      title: z.string(),\n      company: z.string(),\n      location: z.string(),\n      matchScore: z.number(),\n      postedDate: z.string().transform((val) => new Date(val)),\n      salary: z.string().optional(),\n    }),\n  ),\n  upcomingInterviews: z.array(\n    z.object({\n      id: z.string(),\n      jobTitle: z.string(),\n      company: z.string(),\n      scheduledTime: z.string().transform((val) => new Date(val)),\n      type: z.string(),\n      status: z.string(),\n      notes: z.string().optional(),\n    }),\n  ),\n  messageStats: z.object({\n    unreadCount: z.number(),\n    totalConversations: z.number(),\n    recentMessages: z.array(\n      z.object({\n        conversationId: z.string(),\n        senderName: z.string(),\n        preview: z.string(),\n        sentAt: z.string().transform((val) => new Date(val)),\n        isRead: z.boolean(),\n      }),\n    ),\n  }),\n});\n\n// Employer dashboard specific schemas\nexport const TeamMetricsSchema = z.object({\n  totalTeamMembers: z.number(),\n  activeRecruiters: z.number(),\n  openPositions: z.number(),\n  teamPerformanceScore: z.number(),\n});\n\nexport const BudgetStatsSchema = z.object({\n  totalBudget: z.number(),\n  spentAmount: z.number(),\n  remainingBudget: z.number(),\n  costPerHire: z.number(),\n});\n\nexport const CompanyStatsSchema = z.object({\n  totalEmployees: z.number(),\n  newHires: z.number(),\n  hiringVelocity: z.number(),\n  employeeRetentionRate: z.number(),\n});\n\nexport const CandidateStatsSchema = z.object({\n  totalCandidates: z.number(),\n  newCandidates: z.number(),\n  qualifiedCandidates: z.number(),\n  interviewedCandidates: z.number(),\n});\n\nexport const JobPostingStatsSchema = z.object({\n  activeJobs: z.number(),\n  totalApplications: z.number(),\n  filledPositions: z.number(),\n  averageTimeToFill: z.number(),\n});\n\nexport const RecruitmentMetricsSchema = z.object({\n  placementsMade: z.number(),\n  placementRate: z.number(),\n  averageTimeToHire: z.number(),\n  costPerHire: z.number(),\n});\n\nexport const MessageStatsSchema = z.object({\n  unreadCount: z.number(),\n  totalConversations: z.number(),\n  recentMessages: z.array(z.any()),\n});\n\n// Employer dashboard schema\nexport const EmployerDashboardSchema = BaseDashboardSchema.extend({\n  teamMetrics: TeamMetricsSchema,\n  budgetStats: BudgetStatsSchema,\n  recruiterPerformance: z.array(z.any()),\n  companyStats: CompanyStatsSchema,\n  candidateStats: CandidateStatsSchema,\n  jobPostingStats: JobPostingStatsSchema,\n  recruitmentMetrics: RecruitmentMetricsSchema,\n  newCandidates: z.array(z.any()),\n  scheduledInterviews: z.array(z.any()),\n  messageStats: MessageStatsSchema,\n});\n\n// Legacy dashboard stats schema (for backward compatibility)\nexport const DashboardStatsSchema = z.object({\n  totalJobs: z.number(),\n  totalCompanies: z.number(),\n  totalUsers: z.number(),\n  totalResumes: z.number(),\n  totalViews: z.number(),\n  recentJobs: z.number(),\n  recentCompanies: z.number(),\n  recentUsers: z.number(),\n  recentResumes: z.number(),\n});\n\nexport const HomepageContentSchema = z.object({\n  jobs: z.array(\n    z.object({\n      id: z.string(),\n      title: z.string(),\n      company: z.string(),\n      location: z.string(),\n      employmentType: z.string(),\n      postedDate: z.string(),\n      views: z.number().optional(),\n    }),\n  ),\n  companies: z.array(\n    z.object({\n      id: z.string(),\n      name: z.string(),\n      description: z.string(),\n      industry: z.string(),\n      location: z.string(),\n      logo: z.string().optional(),\n      views: z.number().optional(),\n    }),\n  ),\n  users: z.array(\n    z.object({\n      id: z.string(),\n      firstName: z.string(),\n      lastName: z.string(),\n      headline: z.string(),\n      location: z.string(),\n      avatar: z.string().optional(),\n      views: z.number().optional(),\n    }),\n  ),\n  resumes: z.array(\n    z.object({\n      id: z.string(),\n      title: z.string().optional(),\n      name: z.string().optional(),\n      summary: z.string().optional(),\n      description: z.string().optional(),\n      skills: z.array(z.string()).optional(),\n      location: z.string().optional(),\n      views: z.number().optional(),\n      userId: z.string().optional(),\n      templateName: z.string().optional(),\n      isPublic: z.boolean().optional(),\n      createdAt: z.string().optional(),\n    }),\n  ),\n});\n\n// ============================================================================\n// TYPES\n// ============================================================================\n\nexport type DashboardStats = z.infer<typeof DashboardStatsSchema>;\nexport type HomepageContent = z.infer<typeof HomepageContentSchema>;\n\n// New dashboard types\nexport type DashboardMetric = z.infer<typeof DashboardMetricSchema>;\nexport type ActivityItem = z.infer<typeof ActivityItemSchema>;\nexport type OnboardingTask = z.infer<typeof OnboardingTaskSchema>;\nexport type BaseDashboard = z.infer<typeof BaseDashboardSchema>;\nexport type ProfileStats = z.infer<typeof ProfileStatsSchema>;\nexport type ApplicationStats = z.infer<typeof ApplicationStatsSchema>;\nexport type JobSeekerDashboard = z.infer<typeof JobSeekerDashboardSchema>;\nexport type EmployerDashboard = z.infer<typeof EmployerDashboardSchema>;\n\n// Dashboard service response wrapper\nexport interface DashboardResponse<T> {\n  success: boolean;\n  data?: T;\n  error?: string;\n  message?: string;\n}\n\n// Profile view recording request\nexport interface RecordProfileViewRequest {\n  profileUserId: string;\n  viewType?: string;\n  itemId?: string;\n  viewDurationSeconds?: number;\n}\n\n// Activity recording request\nexport interface RecordActivityRequest {\n  activityType: string;\n  description: string;\n  entityType?: string;\n  entityId?: string;\n  activityData?: any;\n  priority?: number;\n}\n\n// User engagement recording request\nexport interface RecordEngagementRequest {\n  sessionDurationMinutes: number;\n  pageViews: number;\n  actionCount: number;\n  featuresUsed?: string[];\n}\n\nexport interface HomepageFilters {\n  search?: string;\n  category?: \"all\" | \"jobs\" | \"companies\" | \"people\" | \"resumes\";\n  location?: string;\n  limit?: number;\n}\n\n// ============================================================================\n// SERVICE\n// ============================================================================\n\nexport class DashboardService {\n  /**\n   * Get homepage content with filtering using unified search\n   */\n  async getHomepageContent(\n    filters: HomepageFilters = {},\n  ): Promise<HomepageContent> {\n    const limit = filters.limit || 4;\n\n    try {\n      // Use unified search service\n      const searchResponse = await searchService.searchPublicContent({\n        search: filters.search,\n        category: filters.category === \"all\" ? undefined : filters.category,\n        location: filters.location,\n        page: 1,\n        limit: limit * 4, // Get more items to distribute across categories\n      });\n\n      // Group items by type\n      const jobs = searchResponse.items.filter((item) => item.type === \"job\");\n      const companies = searchResponse.items.filter(\n        (item) => item.type === \"company\",\n      );\n      const users = searchResponse.items.filter(\n        (item) => item.type === \"people\",\n      );\n      const resumes = searchResponse.items.filter(\n        (item) => item.type === \"resume\",\n      );\n\n      return {\n        jobs: jobs.slice(0, limit).map((job) => ({\n          id: job.id,\n          title: job.title,\n          company: job.company || \"Unknown Company\",\n          location: job.location || \"Unknown Location\",\n          employmentType: job.employmentType || \"Full-time\",\n          postedDate:\n            job.postedDate || job.createdAt || new Date().toISOString(),\n          views: job.views || 0,\n        })),\n        companies: companies.slice(0, limit).map((company) => ({\n          id: company.id,\n          name: company.name || company.title,\n          description:\n            company.description ||\n            company.summary ||\n            \"No description available\",\n          industry: company.industry || \"Technology\",\n          location: company.location || \"Unknown location\",\n          logo: company.logo,\n          views: company.views || 0,\n        })),\n        users: users.slice(0, limit).map((user) => ({\n          id: user.id,\n          firstName: user.name?.split(\" \")[0] || \"Unknown\",\n          lastName: user.name?.split(\" \").slice(1).join(\" \") || \"\",\n          headline: user.headline || user.summary || \"Professional\",\n          location: user.location || \"Unknown location\",\n          avatar: user.avatar,\n          views: user.views || 0,\n        })),\n        resumes: resumes.slice(0, limit).map((resume) => ({\n          id: resume.id,\n          title: resume.title || resume.name || \"Untitled Resume\",\n          name: resume.name || resume.title || \"Untitled Resume\",\n          summary:\n            resume.summary || resume.description || \"No summary available\",\n          description:\n            resume.description || resume.summary || \"No description available\",\n          skills: resume.skills || [],\n          location: resume.location || \"Unknown location\",\n          views: resume.views || 0,\n          userId: resume.id, // TODO: Get actual owner ID\n          templateName: resume.templateName,\n          isPublic: resume.isPublic,\n          createdAt: resume.createdAt,\n        })),\n      };\n    } catch (error) {\n      console.error(\"Failed to get homepage content:\", error);\n      throw error;\n    }\n  }\n\n  /**\n   * Search across all content types using unified search\n   */\n  async searchContent(\n    query: string,\n    category = \"all\",\n    limit = 20,\n  ): Promise<SearchResponse> {\n    return searchService.searchPublicContent({\n      page: 1,\n      search: query,\n      category: category as \"all\" | \"jobs\" | \"resumes\" | \"people\" | \"companies\",\n      limit,\n    });\n  }\n\n  /**\n   * Get dashboard data for the current user based on their role\n   */\n  async getDashboard(): Promise<DashboardResponse<BaseDashboard>> {\n    try {\n      const response = (await apiClient.get(\"/api/userdashboard\")) as {\n        data: any;\n      };\n      const dashboard = BaseDashboardSchema.parse(response.data);\n\n      return { success: true, data: dashboard };\n    } catch (error) {\n      console.error(\"Error creating default dashboard:\", error);\n      return {\n        success: false,\n        error:\n          error instanceof Error\n            ? error.message\n            : \"Failed to fetch dashboard data\",\n      };\n    }\n  }\n\n  /**\n   * Get dashboard data based on user role - centralized role logic\n   */\n  async getDashboardForRole(\n    userRole: string | number | undefined | null,\n  ): Promise<DashboardResponse<any>> {\n    const rolePermissions = createRolePermissions(userRole);\n    const dashboardType = rolePermissions.dashboardType;\n\n    try {\n      switch (dashboardType) {\n        case DASHBOARD_TYPES.JOB_SEEKER:\n          return await this.getJobSeekerDashboard();\n        case DASHBOARD_TYPES.RECRUITER:\n          return await this.getRecruiterDashboard();\n        case DASHBOARD_TYPES.EMPLOYER:\n          return await this.getEmployerDashboard();\n        case DASHBOARD_TYPES.ADMIN:\n          return await this.getAdminDashboard();\n        case DASHBOARD_TYPES.DEFAULT:\n        default:\n          return await this.getDashboard();\n      }\n    } catch (error) {\n      console.error(\"Error fetching role-based dashboard:\", error);\n      return {\n        success: false,\n        error:\n          error instanceof Error\n            ? error.message\n            : \"Failed to fetch dashboard data\",\n      };\n    }\n  }\n\n  /**\n   * Get job seeker specific dashboard data\n   */\n  async getJobSeekerDashboard(): Promise<\n    DashboardResponse<JobSeekerDashboard>\n  > {\n    try {\n      const response = (await apiClient.get(\n        \"/api/userdashboard/jobseeker\",\n      )) as { data: any };\n      const dashboard = JobSeekerDashboardSchema.parse(response.data);\n\n      return { success: true, data: dashboard };\n    } catch (error) {\n      console.error(\"Error creating job seeker dashboard:\", error);\n      return {\n        success: false,\n        error:\n          error instanceof Error\n            ? error.message\n            : \"Failed to fetch job seeker dashboard data\",\n      };\n    }\n  }\n\n  /**\n   * Get recruiter specific dashboard data\n   */\n  async getRecruiterDashboard(): Promise<DashboardResponse<BaseDashboard>> {\n    try {\n      const response = (await apiClient.get(\n        \"/api/userdashboard/recruiter\",\n      )) as { data: any };\n      const dashboard = BaseDashboardSchema.parse(response.data);\n\n      return { success: true, data: dashboard };\n    } catch (error) {\n      console.error(\"Error creating recruiter dashboard:\", error);\n      return {\n        success: false,\n        error:\n          error instanceof Error\n            ? error.message\n            : \"Failed to fetch recruiter dashboard data\",\n      };\n    }\n  }\n\n  /**\n   * Get employer specific dashboard data\n   */\n  async getEmployerDashboard(): Promise<DashboardResponse<EmployerDashboard>> {\n    try {\n      const response = (await apiClient.get(\"/api/userdashboard/employer\")) as {\n        data: any;\n      };\n      const dashboard = EmployerDashboardSchema.parse(response.data);\n\n      return { success: true, data: dashboard };\n    } catch (error) {\n      console.error(\"Error creating employer dashboard:\", error);\n      return {\n        success: false,\n        error:\n          error instanceof Error\n            ? error.message\n            : \"Failed to fetch employer dashboard data\",\n      };\n    }\n  }\n\n  /**\n   * Get admin specific dashboard data\n   */\n  async getAdminDashboard(): Promise<DashboardResponse<BaseDashboard>> {\n    try {\n      const response = (await apiClient.get(\"/api/userdashboard/admin\")) as {\n        data: any;\n      };\n      const dashboard = BaseDashboardSchema.parse(response.data);\n\n      return { success: true, data: dashboard };\n    } catch (error) {\n      console.error(\"Error creating admin dashboard:\", error);\n      return {\n        success: false,\n        error:\n          error instanceof Error\n            ? error.message\n            : \"Failed to fetch admin dashboard data\",\n      };\n    }\n  }\n\n  /**\n   * Record a profile view for analytics\n   */\n  async recordProfileView(\n    request: RecordProfileViewRequest,\n  ): Promise<DashboardResponse<void>> {\n    try {\n      await apiClient.post(\"/api/userdashboard/profile-view\", request);\n      return { success: true };\n    } catch (error) {\n      console.error(\"Error recording profile view:\", error);\n      return {\n        success: false,\n        error:\n          error instanceof Error\n            ? error.message\n            : \"Failed to record profile view\",\n      };\n    }\n  }\n\n  /**\n   * Record user activity for analytics\n   */\n  async recordActivity(\n    request: RecordActivityRequest,\n  ): Promise<DashboardResponse<void>> {\n    try {\n      await apiClient.post(\"/api/userdashboard/activity\", request);\n      return { success: true };\n    } catch (error) {\n      console.error(\"Error recording activity:\", error);\n      return {\n        success: false,\n        error:\n          error instanceof Error ? error.message : \"Failed to record activity\",\n      };\n    }\n  }\n\n  /**\n   * Record user engagement session\n   */\n  async recordEngagement(\n    request: RecordEngagementRequest,\n  ): Promise<DashboardResponse<void>> {\n    try {\n      await apiClient.post(\"/api/userdashboard/engagement\", request);\n      return { success: true };\n    } catch (error) {\n      console.error(\"Error recording engagement:\", error);\n      return {\n        success: false,\n        error:\n          error instanceof Error\n            ? error.message\n            : \"Failed to record engagement\",\n      };\n    }\n  }\n\n  /**\n   * Refresh dashboard metrics for the current user\n   */\n  async refreshDashboardMetrics(): Promise<DashboardResponse<void>> {\n    try {\n      await apiClient.post(\"/api/userdashboard/refresh\");\n      return { success: true };\n    } catch (error) {\n      console.error(\"Error refreshing dashboard metrics:\", error);\n      return {\n        success: false,\n        error:\n          error instanceof Error\n            ? error.message\n            : \"Failed to refresh dashboard metrics\",\n      };\n    }\n  }\n}\n\n// ============================================================================\n// DEFAULT INSTANCE\n// ============================================================================\n\nexport const dashboardService = new DashboardService();\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\services\\feature-flag-service.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'ApiSuccessResponse' is defined but never used. Allowed unused vars must match /^_/u.","line":8,"column":15,"nodeType":null,"messageId":"unusedVar","endLine":8,"endColumn":33},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":81,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":81,"endColumn":19,"suggestions":[{"fix":{"range":[2536,2600],"text":""},"messageId":"removeConsole","data":{"propertyName":"warn"},"desc":"Remove the console.warn()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":101,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":101,"endColumn":19,"suggestions":[{"fix":{"range":[3110,3164],"text":""},"messageId":"removeConsole","data":{"propertyName":"warn"},"desc":"Remove the console.warn()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":128,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":128,"endColumn":19,"suggestions":[{"fix":{"range":[3819,3875],"text":""},"messageId":"removeConsole","data":{"propertyName":"warn"},"desc":"Remove the console.warn()."}]},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'flagKeys'. Either include it or remove the dependency array.","line":249,"column":6,"nodeType":"ArrayExpression","endLine":249,"endColumn":26,"suggestions":[{"desc":"Update the dependencies array to be: [flagKeys]","fix":{"range":[6632,6652],"text":"[flagKeys]"}}]},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a complex expression in the dependency array. Extract it to a separate variable so it can be statically checked.","line":249,"column":7,"nodeType":"CallExpression","endLine":249,"endColumn":25}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Feature Flag Service\n * Handles feature flag management and evaluation\n */\n\nimport { z } from \"zod\";\nimport { apiClient } from \"../api-client\";\nimport type { ApiSuccessResponse } from \"@shared/api\";\n\n// ============================================================================\n// REACT HOOK FOR FEATURE FLAGS\n// ============================================================================\n\nimport { useState, useEffect } from \"react\";\n\n// ============================================================================\n// SCHEMAS\n// ============================================================================\n\nexport const FeatureFlagSchema = z.object({\n  key: z.string(),\n  name: z.string(),\n  description: z.string().optional(),\n  enabled: z.boolean(),\n  rolloutPercentage: z.number().optional(),\n  conditions: z.record(z.string(), z.any()).optional(),\n  createdAt: z.string(),\n  updatedAt: z.string(),\n});\n\nexport const FeatureFlagsResponseSchema = z.object({\n  flags: z.array(FeatureFlagSchema),\n  userFlags: z.record(z.string(), z.boolean()),\n});\n\n// ============================================================================\n// TYPES\n// ============================================================================\n\nexport type FeatureFlag = z.infer<typeof FeatureFlagSchema>;\nexport type FeatureFlagsResponse = z.infer<typeof FeatureFlagsResponseSchema>;\n\n// ============================================================================\n// FEATURE FLAG SERVICE CLASS\n// ============================================================================\n\nexport class FeatureFlagService {\n  private flagsCache: Map<string, boolean> = new Map();\n  private cacheExpiry = 0;\n  private readonly CACHE_TTL = 5 * 60 * 1000; // 5 minutes\n\n  /**\n   * Get all feature flags for current user\n   */\n  async getFeatureFlags(): Promise<FeatureFlagsResponse> {\n    const response = await apiClient.get<FeatureFlagsResponse>(\n      \"/FeatureFlag\",\n      FeatureFlagsResponseSchema,\n    );\n\n    // Update cache\n    this.updateCache(response.data.userFlags);\n\n    return response.data;\n  }\n\n  /**\n   * Check if a feature flag is enabled for current user\n   */\n  async isEnabled(flagKey: string): Promise<boolean> {\n    // Check cache first\n    if (this.isCacheValid() && this.flagsCache.has(flagKey)) {\n      return this.flagsCache.get(flagKey) || false;\n    }\n\n    try {\n      // Fetch fresh flags if cache is invalid\n      const flags = await this.getFeatureFlags();\n      return flags.userFlags[flagKey] || false;\n    } catch (error) {\n      console.warn(`Failed to fetch feature flag ${flagKey}:`, error);\n      // Return cached value if available, otherwise false\n      return this.flagsCache.get(flagKey) || false;\n    }\n  }\n\n  /**\n   * Check multiple feature flags at once\n   */\n  async areEnabled(flagKeys: string[]): Promise<Record<string, boolean>> {\n    try {\n      const flags = await this.getFeatureFlags();\n      const result: Record<string, boolean> = {};\n\n      flagKeys.forEach((key) => {\n        result[key] = flags.userFlags[key] || false;\n      });\n\n      return result;\n    } catch (error) {\n      console.warn(\"Failed to fetch feature flags:\", error);\n      // Return cached values or false\n      const result: Record<string, boolean> = {};\n      flagKeys.forEach((key) => {\n        result[key] = this.flagsCache.get(key) || false;\n      });\n      return result;\n    }\n  }\n\n  /**\n   * Get cached flag value (synchronous)\n   */\n  getCachedFlag(flagKey: string): boolean | null {\n    if (this.isCacheValid() && this.flagsCache.has(flagKey)) {\n      return this.flagsCache.get(flagKey) || false;\n    }\n    return null;\n  }\n\n  /**\n   * Preload feature flags (useful for app initialization)\n   */\n  async preloadFlags(): Promise<void> {\n    try {\n      await this.getFeatureFlags();\n    } catch (error) {\n      console.warn(\"Failed to preload feature flags:\", error);\n    }\n  }\n\n  /**\n   * Clear feature flags cache\n   */\n  clearCache(): void {\n    this.flagsCache.clear();\n    this.cacheExpiry = 0;\n  }\n\n  /**\n   * Update cache with new flag values\n   */\n  private updateCache(userFlags: Record<string, boolean>): void {\n    this.flagsCache.clear();\n    Object.entries(userFlags).forEach(([key, value]) => {\n      this.flagsCache.set(key, value);\n    });\n    this.cacheExpiry = Date.now() + this.CACHE_TTL;\n  }\n\n  /**\n   * Check if cache is still valid\n   */\n  private isCacheValid(): boolean {\n    return Date.now() < this.cacheExpiry;\n  }\n}\n\n/**\n * React hook for using feature flags\n */\nexport function useFeatureFlag(flagKey: string): {\n  isEnabled: boolean;\n  isLoading: boolean;\n  error: Error | null;\n} {\n  const [isEnabled, setIsEnabled] = useState<boolean>(false);\n  const [isLoading, setIsLoading] = useState<boolean>(true);\n  const [error, setError] = useState<Error | null>(null);\n\n  useEffect(() => {\n    let mounted = true;\n\n    const checkFlag = async () => {\n      try {\n        setIsLoading(true);\n        setError(null);\n\n        // Check cache first\n        const cachedValue = featureFlagService.getCachedFlag(flagKey);\n        if (cachedValue !== null) {\n          setIsEnabled(cachedValue);\n          setIsLoading(false);\n          return;\n        }\n\n        // Fetch from API\n        const enabled = await featureFlagService.isEnabled(flagKey);\n        if (mounted) {\n          setIsEnabled(enabled);\n          setIsLoading(false);\n        }\n      } catch (err) {\n        if (mounted) {\n          setError(err instanceof Error ? err : new Error(\"Unknown error\"));\n          setIsLoading(false);\n        }\n      }\n    };\n\n    checkFlag();\n\n    return () => {\n      mounted = false;\n    };\n  }, [flagKey]);\n\n  return { isEnabled, isLoading, error };\n}\n\n/**\n * React hook for using multiple feature flags\n */\nexport function useFeatureFlags(flagKeys: string[]): {\n  flags: Record<string, boolean>;\n  isLoading: boolean;\n  error: Error | null;\n} {\n  const [flags, setFlags] = useState<Record<string, boolean>>({});\n  const [isLoading, setIsLoading] = useState<boolean>(true);\n  const [error, setError] = useState<Error | null>(null);\n\n  useEffect(() => {\n    let mounted = true;\n\n    const checkFlags = async () => {\n      try {\n        setIsLoading(true);\n        setError(null);\n\n        const flagValues = await featureFlagService.areEnabled(flagKeys);\n        if (mounted) {\n          setFlags(flagValues);\n          setIsLoading(false);\n        }\n      } catch (err) {\n        if (mounted) {\n          setError(err instanceof Error ? err : new Error(\"Unknown error\"));\n          setIsLoading(false);\n        }\n      }\n    };\n\n    checkFlags();\n\n    return () => {\n      mounted = false;\n    };\n  }, [flagKeys.join(\",\")]);\n\n  return { flags, isLoading, error };\n}\n\n// ============================================================================\n// DEFAULT INSTANCE\n// ============================================================================\n\nexport const featureFlagService = new FeatureFlagService();\nexport default featureFlagService;\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\services\\job-service.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'ApiSuccessResponse' is defined but never used. Allowed unused vars must match /^_/u.","line":8,"column":15,"nodeType":null,"messageId":"unusedVar","endLine":8,"endColumn":33},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":201,"column":41,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":201,"endColumn":44,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6322,6325],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6322,6325],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":203,"column":42,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":203,"endColumn":45,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6449,6452],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6449,6452],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":218,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":218,"endColumn":43,"suggestions":[{"messageId"