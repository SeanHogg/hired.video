g generic type parameters that you don't need to know the type of."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":212,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":212,"endColumn":20,"suggestions":[{"fix":{"range":[5555,5613],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":230,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":230,"endColumn":20,"suggestions":[{"fix":{"range":[6001,6057],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":242,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":242,"endColumn":20,"suggestions":[{"fix":{"range":[6306,6358],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":254,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":254,"endColumn":20,"suggestions":[{"fix":{"range":[6607,6659],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":262,"column":43,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":262,"endColumn":46,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6774,6777],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6774,6777],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":267,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":267,"endColumn":20,"suggestions":[{"fix":{"range":[6928,6989],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":281,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":281,"endColumn":20,"suggestions":[{"fix":{"range":[7385,7433],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":12,"fatalErrorCount":0,"warningCount":17,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// Account & Organization Management Service\n// Handles API calls for user invitations, role management, and account switching\n\nimport {\n  AccountUser,\n  InviteUserRequest,\n  InviteUserResponse,\n  UpdateUserRolesRequest,\n  AccountSwitchContext,\n  AccountOption,\n  BulkInviteUsersRequest,\n  BulkInviteUsersResponse,\n  InvitationDetailsResponse,\n  AcceptInvitationResponse,\n} from \"@/types/account\";\nimport { apiClient } from \"@/lib/api-client\";\n\nclass AccountService {\n  // Requests go through apiClient; no per-service base URL or headers needed\n\n  /**\n   * Get all users associated with the current account\n   * Returns a flattened list of account users with user profile data\n   */\n  async getAccountUsers(): Promise<AccountUser[]> {\n    try {\n      const response = await apiClient.get<AccountUser[]>(\"/api/account/users\");\n      return response.data || [];\n    } catch (error) {\n      console.error(\"Error fetching account users:\", error);\n      throw error;\n    }\n  }\n\n  /**\n   * Invite a new user to the account\n   */\n  async inviteUser(request: InviteUserRequest): Promise<InviteUserResponse> {\n    try {\n      const response = await apiClient.post<InviteUserResponse>(\n        \"/api/account/invite\",\n        request,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(\"Error inviting user:\", error);\n      throw error;\n    }\n  }\n\n  /**\n   * Update user roles within the account\n   */\n  async updateUserRoles(request: UpdateUserRolesRequest): Promise<void> {\n    try {\n      await apiClient.put(\"/api/account/roles\", request);\n    } catch (error) {\n      console.error(\"Error updating user roles:\", error);\n      throw error;\n    }\n  }\n\n  /**\n   * Remove a user from the account\n   */\n  async removeUser(userId: string): Promise<void> {\n    try {\n      await apiClient.delete(`/api/account/users/${userId}`);\n    } catch (error) {\n      console.error(\"Error removing user:\", error);\n      throw error;\n    }\n  }\n\n  /**\n   * Get available accounts for the current user (for account switching)\n   */\n  async getAvailableAccounts(): Promise<AccountOption[]> {\n    try {\n      const response = await apiClient.get<any[]>(\"/api/account/available\");\n      const accounts = response.data || [];\n\n      return accounts.map((account: any) => ({\n        id: account.id,\n        name: account.name,\n        role: account.role,\n        logoUrl: account.logoUrl ?? undefined,\n        isOwner: account.role === \"Admin\",\n        isAdmin: account.role === \"Admin\" || account.role === \"Employer\",\n      }));\n    } catch (error) {\n      console.error(\"Error fetching available accounts:\", error);\n      return [];\n    }\n  }\n\n  /**\n   * Switch to a different account context\n   */\n  async switchAccount(accountId: string): Promise<any> {\n    try {\n      const response = await apiClient.post<any>(\"/api/account/switch\", {\n        accountId,\n      });\n\n      localStorage.setItem(\"currentAccountId\", accountId);\n      return response.data;\n    } catch (error) {\n      console.error(\"Error switching account:\", error);\n      throw error;\n    }\n  }\n\n  /**\n   * Get current account context\n   */\n  getCurrentAccountContext(): AccountSwitchContext {\n    const currentAccountId = localStorage.getItem(\"currentAccountId\");\n    // This will be populated by getAvailableAccounts()\n    return {\n      currentAccountId: currentAccountId || undefined,\n      availableAccounts: [],\n    };\n  }\n\n  /**\n   * Get invitation details\n   */\n  async getInvitationDetails(\n    invitationId: string,\n  ): Promise<InvitationDetailsResponse> {\n    try {\n      const response = await apiClient.get<InvitationDetailsResponse>(\n        `/api/account/invitation/${invitationId}`,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(\"Error fetching invitation details:\", error);\n      throw error;\n    }\n  }\n\n  /**\n   * Accept an invitation to join an account\n   */\n  async acceptInvitation(\n    invitationId: string,\n  ): Promise<AcceptInvitationResponse> {\n    try {\n      const response = await apiClient.post<AcceptInvitationResponse>(\n        `/api/account/accept-invitation/${invitationId}`,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(\"Error accepting invitation:\", error);\n      throw error;\n    }\n  }\n\n  /**\n   * Get pending invitations for the current user\n   */\n  async getPendingInvitations(): Promise<AccountUser[]> {\n    try {\n      const response = await apiClient.get<AccountUser[]>(\n        \"/api/account/invitations/pending\",\n      );\n      return response.data || [];\n    } catch (error) {\n      console.error(\"Error fetching pending invitations:\", error);\n      return [];\n    }\n  }\n\n  /**\n   * Get account settings\n   */\n  async getAccountSettings(): Promise<any> {\n    try {\n      const response = await apiClient.get<any>(\"/api/account/settings\");\n      return response.data;\n    } catch (error) {\n      console.error(\"Error fetching account settings:\", error);\n      throw error;\n    }\n  }\n\n  /**\n   * Update account settings\n   */\n  async updateAccountSettings(settings: any): Promise<any> {\n    try {\n      const response = await apiClient.post<any>(\n        \"/api/account/settings\",\n        settings,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(\"Error updating account settings:\", error);\n      throw error;\n    }\n  }\n\n  /**\n   * Get account analytics\n   */\n  async getAccountAnalytics(): Promise<any> {\n    try {\n      const response = await apiClient.get<any>(\"/api/account/analytics\");\n      return response.data;\n    } catch (error) {\n      console.error(\"Error fetching account analytics:\", error);\n      throw error;\n    }\n  }\n\n  /**\n   * Send bulk invitations to multiple users\n   */\n  async bulkInviteUsers(\n    request: BulkInviteUsersRequest,\n  ): Promise<BulkInviteUsersResponse> {\n    try {\n      const response = await apiClient.post<BulkInviteUsersResponse>(\n        \"/api/account/bulk-invite\",\n        request,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(\"Error sending bulk invitations:\", error);\n      throw error;\n    }\n  }\n\n  /**\n   * Resend an invitation\n   */\n  async resendInvitation(invitationId: string): Promise<void> {\n    try {\n      await apiClient.post(`/api/account/invitation/${invitationId}/resend`);\n    } catch (error) {\n      console.error(\"Error resending invitation:\", error);\n      throw error;\n    }\n  }\n\n  /**\n   * Cancel an invitation\n   */\n  async cancelInvitation(invitationId: string): Promise<void> {\n    try {\n      await apiClient.post(`/api/account/invitation/${invitationId}/cancel`);\n    } catch (error) {\n      console.error(\"Error canceling invitation:\", error);\n      throw error;\n    }\n  }\n\n  /**\n   * Get invitation analytics\n   */\n  async getInvitationAnalytics(): Promise<any> {\n    try {\n      const response = await apiClient.get(\"/api/account/invitation-analytics\");\n      return response.data;\n    } catch (error) {\n      console.error(\"Error fetching invitation analytics:\", error);\n      throw error;\n    }\n  }\n\n  /**\n   * Delete the current user's account\n   * Note: The backend automatically signs out the user, so no separate logout call is needed\n   */\n  async deleteAccount(): Promise<void> {\n    try {\n      await apiClient.post(\"/api/account/deleteaccount\");\n      // Backend automatically signs out the user, so we don't need to call logout\n    } catch (error) {\n      console.error(\"Error deleting account:\", error);\n      throw error;\n    }\n  }\n}\n\n// Export singleton instance\nexport const accountService = new AccountService();\nexport default accountService;\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\services\\affiliate-service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\services\\ai-service.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":32,"column":13,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":32,"endColumn":16,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[818,821],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[818,821],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * AI Service for handling backend AI API calls\n * Provides a clean interface for AI chat functionality\n */\n\nimport { logger } from \"@/lib/logger\";\nimport { apiClient } from \"@/lib/api-client\";\nimport { billingService } from \"@/lib/services/billing-service\";\nimport { FREE_AI_MONTHLY_LIMIT } from \"@shared/pricing\";\n\n// ============================================================================\n// TYPES\n// ============================================================================\n\nexport interface ChatMessage {\n  role: \"user\" | \"assistant\" | \"system\";\n  content: string;\n}\n\nexport interface ChatResponse {\n  message: string;\n  usage?: {\n    promptTokens: number;\n    completionTokens: number;\n    totalTokens: number;\n  };\n}\n\nexport interface AIServiceError {\n  code: string;\n  message: string;\n  details?: any;\n}\n\nexport interface BackendChatResponse {\n  message: string;\n  usage?: {\n    promptTokens: number;\n    completionTokens: number;\n    totalTokens: number;\n  };\n}\n\n// ============================================================================\n// AI SERVICE CLASS\n// ============================================================================\n\nclass AIService {\n  /**\n   * Send a chat completion request to backend API\n   */\n  async sendChatMessage(\n    messages: ChatMessage[],\n    options?: {\n      model?: string;\n      maxTokens?: number;\n      temperature?: number;\n    },\n  ): Promise<ChatResponse> {\n    try {\n      logger.info(\"Sending AI chat request to backend\");\n\n      // Extract user message and history\n      const userMessage = messages[messages.length - 1]?.content || \"\";\n      const history = messages\n        .slice(0, -1)\n        .filter((msg) => msg.role !== \"system\");\n\n      // Enforce AI monthly usage limits client-side for immediate UX feedback\n      const usage = await billingService.getMonthlyAIUsage();\n      if (!usage.isUnlimited) {\n        const limit = usage.limit ?? FREE_AI_MONTHLY_LIMIT;\n        const remaining = usage.remaining ?? Math.max(0, limit - (usage.used ?? 0));\n        if (remaining <= 0) {\n          const limitError: AIServiceError = {\n            code: \"AI_USAGE_LIMIT_REACHED\",\n            message: `You've used all ${limit} free AI requests for this month. Upgrade to Premium for unlimited AI.`,\n          };\n          // Throw structured error; caller can display an upgrade prompt\n          throw limitError as unknown as Error;\n        }\n      }\n\n      const requestData = {\n        message: userMessage,\n        history: history.length > 0 ? history : undefined,\n        maxTokens: options?.maxTokens,\n        temperature: options?.temperature,\n      };\n\n      const response = await apiClient.post<BackendChatResponse>(\n        \"/api/chat/message\",\n        requestData,\n      );\n\n      if (!response.data) {\n        throw new Error(\"Invalid response from backend AI API\");\n      }\n\n      logger.info(\"AI chat response received from backend\", {\n        messageLength: response.data.message?.length || 0,\n        usage: response.data.usage,\n      });\n\n      return {\n        message: response.data.message,\n        usage: response.data.usage,\n      };\n    } catch (error: unknown) {\n      logger.error(\"AI service error\", { error });\n\n      // If this is an explicit usage limit error, propagate it to the UI (no mock fallback)\n      const maybe = error as Partial<AIServiceError> | undefined;\n      if (maybe && maybe.code === \"AI_USAGE_LIMIT_REACHED\") {\n        throw error as Error;\n      }\n\n      // Fallback to mock response on other errors (e.g., network/AI provider issues)\n      logger.warn(\"Falling back to mock response due to AI service error\");\n      return this.getMockResponse(messages[messages.length - 1]?.content || \"\");\n    }\n  }\n\n  /**\n   * Get a mock response for development/fallback\n   */\n  private getMockResponse(userInput: string): ChatResponse {\n    const input = userInput.toLowerCase();\n\n    let mockMessage = \"\";\n\n    if (input.includes(\"resume\") || input.includes(\"cv\")) {\n      mockMessage =\n        \"≡ƒÄ» I can help optimize your resume! Our AI analyzes your resume for ATS compatibility, suggests keyword improvements, and provides personalized recommendations. Would you like me to:\\n\\nΓÇó Scan your current resume for improvements\\nΓÇó Suggest industry-specific keywords\\nΓÇó Create a video resume script\\nΓÇó Compare against job descriptions\";\n    } else if (\n      input.includes(\"job\") ||\n      input.includes(\"career\") ||\n      input.includes(\"position\")\n    ) {\n      mockMessage =\n        \"≡ƒÆ╝ Great! I can help you find the perfect job opportunities. Our platform uses AI to match you with positions based on:\\n\\nΓÇó Skills and experience alignment\\nΓÇó Salary expectations\\nΓÇó Company culture fit\\nΓÇó Growth potential\\n\\nWould you like me to start analyzing available positions for you?\";\n    } else if (\n      input.includes(\"recruit\") ||\n      input.includes(\"hire\") ||\n      input.includes(\"talent\")\n    ) {\n      mockMessage =\n        \"≡ƒÄ» Excellent! As a recruiter, I can help you:\\n\\nΓÇó Source passive candidates with AI matching\\nΓÇó Create compelling job descriptions\\nΓÇó Automate outreach campaigns\\nΓÇó Track hiring metrics and ROI\\nΓÇó Build talent pipelines\\n\\nWhich recruiting challenge would you like to tackle first?\";\n    } else if (\n      input.includes(\"analytics\") ||\n      input.includes(\"data\") ||\n      input.includes(\"metrics\")\n    ) {\n      mockMessage =\n        \"≡ƒôè I can provide insights on your HR analytics! Our platform tracks:\\n\\nΓÇó Time-to-hire metrics\\nΓÇó Candidate quality scores\\nΓÇó Conversion rates\\nΓÇó Cost-per-hire analysis\\nΓÇó Employee retention data\\n\\nWhat specific metrics would you like to explore?\";\n    } else if (\n      input.includes(\"help\") ||\n      input.includes(\"how\") ||\n      input.includes(\"what\")\n    ) {\n      mockMessage =\n        \"≡ƒÆí I'm here to help with all aspects of HR and talent management! I can assist with:\\n\\n≡ƒÄ» **For Job Seekers:**\\nΓÇó Resume optimization\\nΓÇó Job matching\\nΓÇó Interview preparation\\nΓÇó Career guidance\\n\\n≡ƒæÑ **For Recruiters:**\\nΓÇó Candidate sourcing\\nΓÇó Outreach automation\\nΓÇó Pipeline management\\nΓÇó Performance analytics\\n\\nWhat would you like to explore?\";\n    } else {\n      mockMessage =\n        \"≡ƒñû That's an interesting question! I'm constantly learning about HR and talent management. Based on what you've shared, I'd recommend exploring our:\\n\\nΓÇó AI-powered resume tools\\nΓÇó Smart job matching system\\nΓÇó Recruitment automation features\\nΓÇó Analytics dashboard\\n\\nIs there a specific area you'd like to dive deeper into?\";\n    }\n\n    return {\n      message: mockMessage,\n      usage: {\n        promptTokens: userInput.length / 4, // Rough estimate\n        completionTokens: mockMessage.length / 4,\n        totalTokens: (userInput.length + mockMessage.length) / 4,\n      },\n    };\n  }\n\n  /**\n   * Create a system message for HR context\n   */\n  createSystemMessage(): ChatMessage {\n    return {\n      role: \"system\",\n      content: `You are an AI HR Assistant for MyVideoResume, a platform that helps job seekers and recruiters connect through video resumes and AI-powered matching.\n\nYour role is to help users with:\n- Resume optimization and ATS compatibility\n- Job search strategies and career guidance\n- Recruitment best practices and candidate sourcing\n- HR analytics and performance metrics\n- Video resume creation and optimization\n- Interview preparation and tips\n\nAlways be helpful, professional, and focused on HR and talent management topics. Provide actionable advice and suggest relevant platform features when appropriate.\n\nKeep responses concise but informative, using bullet points and emojis to improve readability.`,\n    };\n  }\n\n  /**\n   * Create a chat conversation with system context\n   */\n  async sendHRChatMessage(\n    userMessage: string,\n    conversationHistory: ChatMessage[] = [],\n  ): Promise<ChatResponse> {\n    const systemMessage = this.createSystemMessage();\n    const userChatMessage: ChatMessage = {\n      role: \"user\",\n      content: userMessage,\n    };\n\n    const messages: ChatMessage[] = [\n      systemMessage,\n      ...conversationHistory,\n      userChatMessage,\n    ];\n\n    return this.sendChatMessage(messages);\n  }\n}\n\n// ============================================================================\n// SINGLETON INSTANCE\n// ============================================================================\n\nexport const aiService = new AIService();\n\n// ============================================================================\n// CONVENIENCE FUNCTIONS\n// ============================================================================\n\n/**\n * Send a simple HR-focused chat message\n */\nexport async function sendHRMessage(\n  message: string,\n  history: ChatMessage[] = [],\n): Promise<ChatResponse> {\n  return aiService.sendHRChatMessage(message, history);\n}\n\n/**\n * Check if AI service is properly configured (always true since backend handles it)\n */\nexport function isAIServiceConfigured(): boolean {\n  try {\n    logger.info(\n      \"AI service configuration check - backend handles AI configuration\",\n    );\n    return true; // Backend handles AI configuration\n  } catch (error) {\n    logger.error(\"Error checking AI service configuration\", error);\n    return false;\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\services\\auth-service.ts","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":207,"column":5,"nodeType":"MemberExpression","messageId":"unexpected","endLine":207,"endColumn":16,"suggestions":[{"fix":{"range":[7020,7077],"text":""},"messag