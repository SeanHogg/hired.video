ove the console.error()."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":23,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Communication Service - Handles all communication-related API operations\n * Integrates with messaging, email templates, campaigns, and tracking\n */\n\nimport { apiClient } from \"@/lib/api-client\";\nimport {\n  ConversationDTO,\n  MessageDTO,\n  EmailTemplateDTO,\n  EmailCampaignDTO,\n  CommunicationTrackingDTO,\n  ExternalContactDTO,\n  CreateConversationRequest,\n  SendMessageRequest,\n  CreateEmailTemplateRequest,\n  UpdateEmailTemplateRequest,\n  CreateEmailCampaignRequest,\n  CreateCommunicationTrackingRequest,\n  CreateFollowUpRequest,\n  CreateExternalContactRequest,\n  UpdateExternalContactRequest,\n  ConversationFilters,\n  MessageFilters,\n  EmailTemplateFilters,\n  CommunicationTrackingFilters,\n  ConversationListItem,\n  MessageListItem,\n  CommunicationStats,\n  ConversationType,\n} from \"@/types/communication\";\n\nexport class CommunicationService {\n  private readonly baseUrl = \"/api/communication\";\n\n  // ===== CONVERSATIONS & MESSAGING =====\n\n  /**\n   * Get all conversations for the current user\n   */\n  async getConversations(\n    filters?: ConversationFilters,\n  ): Promise<ConversationListItem[]> {\n    try {\n      const params = new URLSearchParams();\n\n      if (filters) {\n        if (filters.type?.length) {\n          filters.type.forEach((type) =>\n            params.append(\"type\", type.toString()),\n          );\n        }\n        if (filters.isArchived !== undefined) {\n          params.append(\"isArchived\", filters.isArchived.toString());\n        }\n        if (filters.participantUserId) {\n          params.append(\"participantUserId\", filters.participantUserId);\n        }\n        if (filters.companyId) {\n          params.append(\"companyId\", filters.companyId);\n        }\n      }\n\n      const queryString = params.toString();\n      const url = queryString\n        ? `${this.baseUrl}/conversations?${queryString}`\n        : `${this.baseUrl}/conversations`;\n\n      const response = await apiClient.get<ConversationDTO[]>(url);\n\n      // Transform to UI format\n      return response.data.map((conv) => ({\n        id: conv.id,\n        title: conv.title || this.generateConversationTitle(conv),\n        type: conv.type,\n        participantCount: conv.participants.length,\n        lastMessage:\n          conv.messages.length > 0\n            ? {\n                content: conv.messages[conv.messages.length - 1].content,\n                senderName:\n                  conv.messages[conv.messages.length - 1].sender?.firstName +\n                    \" \" +\n                    conv.messages[conv.messages.length - 1].sender?.lastName ||\n                  \"Unknown\",\n                timestamp:\n                  conv.messages[conv.messages.length - 1].creationDateTime ||\n                  \"\",\n              }\n            : undefined,\n        unreadCount: this.calculateUnreadCount(),\n        isArchived: conv.isArchived,\n        isMuted: conv.isMuted,\n      }));\n    } catch (error) {\n      console.error(\"Failed to fetch conversations:\", error);\n      throw new Error(\"Failed to fetch conversations\");\n    }\n  }\n\n  /**\n   * Get a specific conversation with messages\n   */\n  async getConversation(conversationId: string): Promise<ConversationDTO> {\n    try {\n      const response = await apiClient.get<ConversationDTO>(\n        `${this.baseUrl}/conversations/${conversationId}`,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(`Failed to fetch conversation ${conversationId}:`, error);\n      throw new Error(`Failed to fetch conversation ${conversationId}`);\n    }\n  }\n\n  /**\n   * Create a new conversation\n   */\n  async createConversation(\n    request: CreateConversationRequest,\n  ): Promise<ConversationDTO> {\n    try {\n      const response = await apiClient.post<ConversationDTO>(\n        `${this.baseUrl}/conversations`,\n        request,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(\"Failed to create conversation:\", error);\n      throw new Error(\"Failed to create conversation\");\n    }\n  }\n\n  /**\n   * Send a message in a conversation\n   */\n  async sendMessage(request: SendMessageRequest): Promise<MessageDTO> {\n    try {\n      const response = await apiClient.post<MessageDTO>(\n        `${this.baseUrl}/messages`,\n        request,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(\"Failed to send message:\", error);\n      throw new Error(\"Failed to send message\");\n    }\n  }\n\n  /**\n   * Get messages for a conversation\n   */\n  async getMessages(\n    conversationId: string,\n    filters?: MessageFilters,\n  ): Promise<MessageListItem[]> {\n    try {\n      const params = new URLSearchParams();\n      params.append(\"conversationId\", conversationId);\n\n      if (filters) {\n        if (filters.senderId) {\n          params.append(\"senderId\", filters.senderId);\n        }\n        if (filters.messageType?.length) {\n          filters.messageType.forEach((type) =>\n            params.append(\"messageType\", type.toString()),\n          );\n        }\n        if (filters.dateFrom) {\n          params.append(\"dateFrom\", filters.dateFrom);\n        }\n        if (filters.dateTo) {\n          params.append(\"dateTo\", filters.dateTo);\n        }\n      }\n\n      const response = await apiClient.get<MessageDTO[]>(\n        `${this.baseUrl}/messages?${params.toString()}`,\n      );\n\n      // Transform to UI format\n      return response.data.map((msg) => ({\n        id: msg.id,\n        content: msg.content,\n        senderName:\n          msg.sender?.firstName + \" \" + msg.sender?.lastName || \"Unknown\",\n        senderAvatar: msg.sender?.profilePicture,\n        timestamp: msg.creationDateTime || \"\",\n        isOwn: false, // Will be set by the UI based on current user\n        messageType: msg.messageType,\n        attachmentUrl: msg.attachmentUrl,\n        attachmentName: msg.attachmentName,\n        isEdited: msg.isEdited,\n        replyTo: msg.replyToMessage\n          ? {\n              content: msg.replyToMessage.content,\n              senderName:\n                msg.replyToMessage.sender?.firstName +\n                  \" \" +\n                  msg.replyToMessage.sender?.lastName || \"Unknown\",\n            }\n          : undefined,\n      }));\n    } catch (error) {\n      console.error(\"Failed to fetch messages:\", error);\n      throw new Error(\"Failed to fetch messages\");\n    }\n  }\n\n  /**\n   * Mark messages as read\n   */\n  async markMessagesAsRead(messageIds: string[]): Promise<void> {\n    try {\n      await apiClient.post(`${this.baseUrl}/messages/mark-read`, {\n        messageIds,\n      });\n    } catch (error) {\n      console.error(\"Failed to mark messages as read:\", error);\n      throw new Error(\"Failed to mark messages as read\");\n    }\n  }\n\n  // ===== EMAIL TEMPLATES =====\n\n  /**\n   * Get email templates\n   */\n  async getEmailTemplates(\n    filters?: EmailTemplateFilters,\n  ): Promise<EmailTemplateDTO[]> {\n    try {\n      const params = new URLSearchParams();\n\n      if (filters) {\n        if (filters.category?.length) {\n          filters.category.forEach((cat) =>\n            params.append(\"category\", cat.toString()),\n          );\n        }\n        if (filters.targetRole?.length) {\n          filters.targetRole.forEach((role) =>\n            params.append(\"targetRole\", role.toString()),\n          );\n        }\n        if (filters.isSystemTemplate !== undefined) {\n          params.append(\n            \"isSystemTemplate\",\n            filters.isSystemTemplate.toString(),\n          );\n        }\n        if (filters.isActive !== undefined) {\n          params.append(\"isActive\", filters.isActive.toString());\n        }\n        if (filters.createdByUserId) {\n          params.append(\"createdByUserId\", filters.createdByUserId);\n        }\n      }\n\n      const queryString = params.toString();\n      const url = queryString\n        ? `${this.baseUrl}/email-templates?${queryString}`\n        : `${this.baseUrl}/email-templates`;\n\n      const response = await apiClient.get<EmailTemplateDTO[]>(url);\n      return response.data;\n    } catch (error) {\n      console.error(\"Failed to fetch email templates:\", error);\n      throw new Error(\"Failed to fetch email templates\");\n    }\n  }\n\n  /**\n   * Get a specific email template\n   */\n  async getEmailTemplate(templateId: string): Promise<EmailTemplateDTO> {\n    try {\n      const response = await apiClient.get<EmailTemplateDTO>(\n        `${this.baseUrl}/email-templates/${templateId}`,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(`Failed to fetch email template ${templateId}:`, error);\n      throw new Error(`Failed to fetch email template ${templateId}`);\n    }\n  }\n\n  /**\n   * Create a new email template\n   */\n  async createEmailTemplate(\n    request: CreateEmailTemplateRequest,\n  ): Promise<EmailTemplateDTO> {\n    try {\n      const response = await apiClient.post<EmailTemplateDTO>(\n        `${this.baseUrl}/email-templates`,\n        request,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(\"Failed to create email template:\", error);\n      // Re-throw the original error to preserve API error messages\n      throw error;\n    }\n  }\n\n  /**\n   * Update an email template\n   */\n  async updateEmailTemplate(\n    request: UpdateEmailTemplateRequest,\n  ): Promise<EmailTemplateDTO> {\n    try {\n      const response = await apiClient.put<EmailTemplateDTO>(\n        `${this.baseUrl}/email-templates/${request.id}`,\n        request,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(`Failed to update email template ${request.id}:`, error);\n      // Re-throw the original error to preserve API error messages\n      throw error;\n    }\n  }\n\n  /**\n   * Delete an email template\n   */\n  async deleteEmailTemplate(templateId: string): Promise<void> {\n    try {\n      await apiClient.delete(`${this.baseUrl}/email-templates/${templateId}`);\n    } catch (error) {\n      console.error(`Failed to delete email template ${templateId}:`, error);\n      // Re-throw the original error to preserve API error messages\n      throw error;\n    }\n  }\n\n  // ===== EMAIL CAMPAIGNS =====\n\n  /**\n   * Get email campaigns\n   */\n  async getEmailCampaigns(): Promise<EmailCampaignDTO[]> {\n    try {\n      const response = await apiClient.get<EmailCampaignDTO[]>(\n        `${this.baseUrl}/email-campaigns`,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(\"Failed to fetch email campaigns:\", error);\n      throw new Error(\"Failed to fetch email campaigns\");\n    }\n  }\n\n  /**\n   * Create a new email campaign\n   */\n  async createEmailCampaign(\n    request: CreateEmailCampaignRequest,\n  ): Promise<EmailCampaignDTO> {\n    try {\n      const response = await apiClient.post<EmailCampaignDTO>(\n        `${this.baseUrl}/email-campaigns`,\n        request,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(\"Failed to create email campaign:\", error);\n      throw new Error(\"Failed to create email campaign\");\n    }\n  }\n\n  /**\n   * Send an email campaign\n   */\n  async sendEmailCampaign(campaignId: string): Promise<void> {\n    try {\n      await apiClient.post(\n        `${this.baseUrl}/email-campaigns/${campaignId}/send`,\n      );\n    } catch (error) {\n      console.error(`Failed to send email campaign ${campaignId}:`, error);\n      throw new Error(`Failed to send email campaign ${campaignId}`);\n    }\n  }\n\n  // ===== COMMUNICATION TRACKING =====\n\n  /**\n   * Get communication tracking records\n   */\n  async getCommunicationTracking(\n    filters?: CommunicationTrackingFilters,\n  ): Promise<CommunicationTrackingDTO[]> {\n    try {\n      const params = new URLSearchParams();\n\n      if (filters) {\n        if (filters.type?.length) {\n          filters.type.forEach((type) =>\n            params.append(\"type\", type.toString()),\n          );\n        }\n        if (filters.channel?.length) {\n          filters.channel.forEach((channel) =>\n            params.append(\"channel\", channel.toString()),\n          );\n        }\n        if (filters.status?.length) {\n          filters.status.forEach((status) =>\n            params.append(\"status\", status.toString()),\n          );\n        }\n        if (filters.priority?.length) {\n          filters.priority.forEach((priority) =>\n            params.append(\"priority\", priority.toString()),\n          );\n        }\n        if (filters.requiresFollowUp !== undefined) {\n          params.append(\n            \"requiresFollowUp\",\n            filters.requiresFollowUp.toString(),\n          );\n        }\n        if (filters.dateFrom) {\n          params.append(\"dateFrom\", filters.dateFrom);\n        }\n        if (filters.dateTo) {\n          params.append(\"dateTo\", filters.dateTo);\n        }\n        if (filters.tags?.length) {\n          filters.tags.forEach((tag) => params.append(\"tags\", tag));\n        }\n      }\n\n      const queryString = params.toString();\n      const url = queryString\n        ? `${this.baseUrl}/tracking?${queryString}`\n        : `${this.baseUrl}/tracking`;\n\n      const response = await apiClient.get<CommunicationTrackingDTO[]>(url);\n      return response.data;\n    } catch (error) {\n      console.error(\"Failed to fetch communication tracking:\", error);\n      throw new Error(\"Failed to fetch communication tracking\");\n    }\n  }\n\n  /**\n   * Create a communication tracking record\n   */\n  async createCommunicationTracking(\n    request: CreateCommunicationTrackingRequest,\n  ): Promise<CommunicationTrackingDTO> {\n    try {\n      const response = await apiClient.post<CommunicationTrackingDTO>(\n        `${this.baseUrl}/tracking`,\n        request,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(\"Failed to create communication tracking:\", error);\n      throw new Error(\"Failed to create communication tracking\");\n    }\n  }\n\n  /**\n   * Create a follow-up for a communication\n   */\n  async createFollowUp(request: CreateFollowUpRequest): Promise<void> {\n    try {\n      await apiClient.post(`${this.baseUrl}/follow-ups`, request);\n    } catch (error) {\n      console.error(\"Failed to create follow-up:\", error);\n      throw new Error(\"Failed to create follow-up\");\n    }\n  }\n\n  // ===== EXTERNAL CONTACTS =====\n\n  /**\n   * Get external contacts\n   */\n  async getExternalContacts(): Promise<ExternalContactDTO[]> {\n    try {\n      const response = await apiClient.get<ExternalContactDTO[]>(\n        `${this.baseUrl}/external-contacts`,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(\"Failed to fetch external contacts:\", error);\n      throw new Error(\"Failed to fetch external contacts\");\n    }\n  }\n\n  /**\n   * Create an external contact\n   */\n  async createExternalContact(\n    request: CreateExternalContactRequest,\n  ): Promise<ExternalContactDTO> {\n    try {\n      const response = await apiClient.post<ExternalContactDTO>(\n        `${this.baseUrl}/external-contacts`,\n        request,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(\"Failed to create external contact:\", error);\n      // Re-throw the original error to preserve API error messages\n      throw error;\n    }\n  }\n\n  /**\n   * Update an external contact\n   */\n  async updateExternalContact(\n    request: UpdateExternalContactRequest,\n  ): Promise<ExternalContactDTO> {\n    try {\n      const response = await apiClient.put<ExternalContactDTO>(\n        `${this.baseUrl}/external-contacts/${request.id}`,\n        request,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(`Failed to update external contact ${request.id}:`, error);\n      // Re-throw the original error to preserve API error messages\n      throw error;\n    }\n  }\n\n  /**\n   * Delete an external contact\n   */\n  async deleteExternalContact(contactId: string): Promise<void> {\n    try {\n      await apiClient.delete(`${this.baseUrl}/external-contacts/${contactId}`);\n    } catch (error) {\n      console.error(`Failed to delete external contact ${contactId}:`, error);\n      // Re-throw the original error to preserve API error messages\n      throw error;\n    }\n  }\n\n  // ===== ANALYTICS & STATS =====\n\n  /**\n   * Get communication statistics\n   */\n  async getCommunicationStats(): Promise<CommunicationStats> {\n    try {\n      const response = await apiClient.get<CommunicationStats>(\n        `${this.baseUrl}/stats`,\n      );\n      return response.data;\n    } catch (error) {\n      console.error(\"Failed to fetch communication stats:\", error);\n      throw new Error(\"Failed to fetch communication stats\");\n    }\n  }\n\n  // ===== GROUP COMMUNICATION (Employer/Recruiter) =====\n\n  /**\n   * Get team members for group communication (employer/recruiter accounts)\n   */\n  async getTeamMembers(): Promise<\n    {\n      id: string;\n      userProfile?: {\n        id: string;\n        firstName: string;\n        lastName: string;\n        role?: string;\n      };\n    }[]\n  > {\n    try {\n      const response = await apiClient.get<\n        {\n          id: string;\n          userProfile?: {\n            id: string;\n            firstName: string;\n            lastName: string;\n            role?: string;\n          };\n        }[]\n      >(\"/api/account/users\");\n      return response.data;\n    } catch (error) {\n      console.error(\"Failed to fetch team members:\", error);\n      throw new Error(\"Failed to fetch team members\");\n    }\n  }\n\n  /**\n   * Create a group conversation with team members\n   */\n  async createGroupConversation(\n    title: string,\n    memberUserIds: string[],\n    initialMessage?: string,\n  ): Promise<ConversationDTO> {\n    const request: CreateConversationRequest = {\n      title,\n      type: ConversationType.Group,\n      participantUserIds: memberUserIds,\n      initialMessage,\n    };\n\n    return this.createConversation(request);\n  }\n\n  /**\n   * Send a broadcast message to multiple team members\n   */\n  async sendBroadcastMessage(\n    title: string,\n    content: string,\n    recipientUserIds: string[],\n  ): Promise<ConversationDTO> {\n    const request: CreateConversationRequest = {\n      title,\n      type: ConversationType.Broadcast,\n      participantUserIds: recipientUserIds,\n      initialMessage: content,\n    };\n\n    return this.createConversation(request);\n  }\n\n  // ===== HELPER METHODS =====\n\n  private generateConversationTitle(conversation: ConversationDTO): string {\n    if (conversation.type === ConversationType.Direct) {\n      const otherParticipant = conversation.participants.find(\n        (p) => p.userId !== conversation.createdByUserId,\n      );\n      return otherParticipant?.user\n        ? `${otherParticipant.user.firstName} ${otherParticipant.user.lastName}`\n        : \"Direct Message\";\n    }\n    return conversation.type === ConversationType.Group\n      ? \"Group Chat\"\n      : \"Broadcast\";\n  }\n\n  private calculateUnreadCount(): number {\n    // This would need to be calculated based on the current user's last read timestamp\n    // For now, return 0 as a placeholder\n    return 0;\n  }\n}\n\n// Export singleton instance\nexport const communicationService = new CommunicationService();\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\services\\company-service.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":256,"column":58,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":256,"endColumn":61,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[8438,8441],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[8438,8441],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":291,"column":67,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":291,"endColumn":70,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9383,9386],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9383,9386],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":297,"column":42,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":297,"endColumn":45,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9543,9546],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9543,9546],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'error' is defined but never used.","line":343,"column":14,"nodeType":null,"messageId":"unusedVar","endLine":343,"endColumn":19}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Company Service\n * Handles company-related API operations\n */\n\nimport { z } from \"zod\";\nimport { apiClient } from \"../api-client\";\nimport { nullableString, nullableNumber, nullableBoolean } from \"@shared/api\";\nimport { isValidCompanyName } from \"../utils/company-validation\";\n\n// ============================================================================\n// SCHEMAS\n// ============================================================================\n\n// Helpers to normalize enum values from backend (string or number)\nconst mapCompanyStatus = (val: unknown): string => {\n  if (typeof val === \"string\") return val.toLowerCase();\n  if (typeof val === \"number\") {\n    const map = [\"draft\", \"onboarding\", \"active\", \"paused\", \"inactive\"];\n    return map[val] ?? \"draft\";\n  }\n  return \"draft\";\n};\n\nconst mapCompanyVisibility = (val: unknown): string => {\n  if (typeof val === \"string\") return val.toLowerCase();\n  if (typeof val === \"number\") {\n    const map = [\"public\", \"private\", \"draft\"];\n    return map[val] ?? \"private\";\n  }\n  return \"private\";\n};\n\n// Metadata item returned by GET /api/Companies/public\nexport const CompanyMetadataSchema = z.object({\n  id: nullableString(),\n  slug: nullableString(),\n  name: nullableString(),\n  logo: nullableString(),\n  tagline: nullableString(),\n  description: nullableString(),\n  website: nullableString(),\n  industry: nullableString(),\n  size: nullableString(),\n  location: nullableString(),\n  status: z.union([z.string(), z.number()]).nullable().transform((val) =>\n    val === null ? undefined : mapCompanyStatus(val),\n  ).optional(),\n  visibility: z.union([z.string(), z.number()]).nullable().transform((val) =>\n    val === null ? undefined : mapCompanyVisibility(val),\n  ).optional(),\n  createdAt: nullableString(),\n  updatedAt: nullableString(),\n  views: nullableNumber(),\n  followers: nullableNumber(),\n  jobCount: nullableNumber(),\n  activeJobCount: nullableNumber(),\n  userId: nullableString(),\n  onboardingProgress: nullableNumber(),\n});\n\n// Full Company Profile (GET /api/Companies/{id})\nconst CompanyLocationSchema = z\n  .object({\n    address: nullableString(),\n    city: nullableString(),\n    state: nullableString(),\n    country: nullableString(),\n    postalCode: nullableString(),\n    timezone: nullableString(),\n    remote: z.boolean().optional(),\n  })\n  .optional()\n  .default({});\n\nconst CompanyContactSchema = z.object({\n  email: nullableString(),\n  phone: nullableString(),\n  website: nullableString(),\n  linkedin: nullableString(),\n  twitter: nullableString(),\n  facebook: nullableString(),\n});\n\nconst CompanyFinancialsSchema = z\n  .object({\n    fundingStage: nullableString(),\n    fundingAmount: nullableNumber(),\n    totalFunding: nullableNumber(),\n    currency: nullableString(),\n    valuation: nullableNumber(),\n    revenue: nullableNumber(),\n    profitability: nullableString(),\n    investors: z.array(z.string()).optional().default([]),\n  })\n  .optional();\n\nconst CompanyBenefitsSchema = z.object({\n  healthInsurance: nullableBoolean(),\n  dentalInsurance: nullableBoolean(),\n  visionInsurance: nullableBoolean(),\n  retirement401k: nullableBoolean(),\n  retirementPlan: nullableBoolean(),\n  stockOptions: nullableBoolean(),\n  paidTimeOff: nullableBoolean(),\n  parentalLeave: nullableBoolean(),\n  flexibleSchedule: nullableBoolean(),\n  remoteWork: nullableBoolean(),\n  learningBudget: nullableBoolean(),\n  professionalDevelopment: nullableBoolean(),\n  gymMembership: nullableBoolean(),\n  freeFood: nullableBoolean(),\n  commuteBenefits: nullableBoolean(),\n  other: z.array(z.string()).optional().default([]),\n});\n\nconst CompanyDataSchema = z.object({\n  name: z.string().nullable().transform((v) => v ?? \"Unnamed Company\").optional().default(\"Unnamed Company\"),\n  logo: nullableString(),\n  website: nullableString(),\n  tagline: nullableString(),\n  description: z.string().nullable().transform((v) => v ?? \"\").optional().default(\"\"),\n  industry: z.string().nullable().transform((v) => v ?? \"Not specified\").optional().default(\"Not specified\"),\n  size: z.string().nullable().transform((v) => v ?? \"Not specified\").optional().default(\"Not specified\"),\n  founded: nullableNumber(),\n  headquarters: CompanyLocationSchema.default({}),\n  locations: z.array(CompanyLocationSchema).optional().default([]),\n  contact: CompanyContactSchema.default({}),\n  financials: CompanyFinancialsSchema,\n  benefits: CompanyBenefitsSchema.default({\n    healthInsurance: false,\n    dentalInsurance: false,\n    visionInsurance: false,\n    retirement401k: false,\n    retirementPlan: false,\n    stockOptions: false,\n    paidTimeOff: false,\n    parentalLeave: false,\n    flexibleSchedule: false,\n    remoteWork: false,\n    learningBudget: false,\n    professionalDevelopment: false,\n    gymMembership: false,\n    freeFood: false,\n    commuteBenefits: false,\n    other: [],\n  }),\n  culture: z.array(z.string()).optional().default([]),\n  technologies: z.array(z.string()).optional().default([]),\n  techStack: z.array(z.string()).optional(),\n  perks: z.array(z.string()).optional().default([]),\n  mission: nullableString(),\n  vision: nullableString(),\n  values: z.array(z.string()).optional().default([]),\n});\n\nexport const CompanyProfileSchema = z.object({\n  id: z.string(),\n  slug: z.string(),\n  data: CompanyDataSchema,\n  status: z.union([z.string(), z.number()]).transform(mapCompanyStatus),\n  visibility: z\n    .union([z.string(), z.number()])\n    .transform(mapCompanyVisibility),\n  onboardingTasks: z\n    .array(\n      z.object({\n        id: z.string(),\n        title: z.string(),\n        description: z.string(),\n        completed: z.boolean(),\n        required: z.boolean(),\n        order: z.number(),\n      }),\n    )\n    .optional()\n    .default([]),\n  createdAt: nullableString(),\n  updatedAt: nullableString(),\n  views: z.number().optional().default(0),\n  followers: z.number().optional().default(0),\n  jobCount: z.number().optional().default(0),\n  activeJobCount: z.number().optional().default(0),\n  userId: nullableString(),\n  teamMembers: z.array(z.string()).optional().default([]),\n  canEdit: z.boolean().optional(),\n  isOwner: z.boolean().optional(),\n  isFollowing: z.boolean().optional(),\n  isAuthenticated: z.boolean().optional(),\n});\n\nexport const CompanyFiltersSchema = z.object({\n  search: z.string().optional(),\n  industry: z.string().optional(),\n  size: z.string().optional(),\n  location: z.string().optional(),\n  page: z.number().optional(),\n  limit: z.number().optional(),\n});\n\nexport const PaginatedCompaniesSchema = z.object({\n  items: z.array(CompanyMetadataSchema).nullable(),\n  total: z.number().nullable(),\n  page: z.number().nullable(),\n  limit: z.number().nullable(),\n  totalPages: z.number().nullable().optional(),\n  hasNextPage: z.boolean().nullable().optional(),\n  hasPreviousPage: z.boolean().nullable().optional(),\n});\n\n// ============================================================================\n// TYPES\n// ============================================================================\n\nexport type CompanyMetadata = z.infer<typeof CompanyMetadataSchema>;\nexport type CompanyProfile = z.infer<typeof CompanyProfileSchema>;\nexport type CompanyFilters = z.infer<typeof CompanyFiltersSchema>;\nexport type PaginatedCompanies = z.infer<typeof PaginatedCompaniesSchema>;\n\n// ============================================================================\n// COMPANY SERVICE CLASS\n// ============================================================================\n\nexport class CompanyService {\n\n\n  /**\n   * Get all public companies with optional filters\n   */\n  async getPublicCompanies(\n    filters?: CompanyFilters,\n  ): Promise<PaginatedCompanies> {\n    const params = new URLSearchParams();\n\n    if (filters) {\n      Object.entries(filters).forEach(([key, value]) => {\n        if (value !== undefined && value !== null) {\n          if (Array.isArray(value)) {\n            value.forEach((v) => params.append(key, v.toString()));\n          } else {\n            params.append(key, value.toString());\n          }\n        }\n      });\n    }\n\n    const endpoint = `/api/Companies/public${params.toString() ? `?${params.toString()}` : \"\"}`;\n    const response = await apiClient.get<PaginatedCompanies>(\n      endpoint,\n      PaginatedCompaniesSchema,\n    );\n\n    // Filter out companies with invalid names and demo companies\n    if (response.data.items) {\n      response.data.items = response.data.items.filter(company => \n        isValidCompanyName(company.name) && !(company as any).isDemo\n      );\n      // Update the total count to reflect filtered results\n      response.data.total = response.data.items.length;\n    }\n\n    return response.data;\n  }\n\n  /**\n   * Get specific company by ID (full profile)\n   */\n  async getCompanyProfileById(id: string): Promise<CompanyProfile> {\n    const response = await apiClient.get<CompanyProfile>(\n      `/api/Companies/${id}`,\n      CompanyProfileSchema,\n    );\n    return response.data;\n  }\n\n  /**\n   * Get specific company by ID (legacy metadata-only)\n   * Note: Many pages use full profile; prefer getCompanyProfileById for details pages\n   */\n  async getCompanyById(id: string): Promise<CompanyMetadata> {\n    const response = await apiClient.get<CompanyMetadata>(\n      `/api/Companies/${id}`,\n      CompanyMetadataSchema,\n    );\n    return response.data;\n  }\n\n  /**\n   * Get jobs for a specific company\n   */\n  async getCompanyJobs(id: string, page = 1, limit = 20): Promise<any[]> {\n    const params = new URLSearchParams({\n      page: page.toString(),\n      limit: limit.toString(),\n    });\n\n    const response = await apiClient.get<any[]>(\n      `/api/Companies/${id}/jobs?${params.toString()}`,\n      z.array(z.any()), // We'll use the Job schema from job-service when available\n    );\n\n    return response.data;\n  }\n\n  /**\n   * Follow a company\n   */\n  async followCompany(id: string): Promise<void> {\n    await apiClient.post(`/api/Companies/${id}/follow`);\n  }\n\n  /**\n   * Unfollow a company\n   */\n  async unfollowCompany(id: string): Promise<void> {\n    await apiClient.delete(`/api/Companies/${id}/follow`);\n  }\n\n  /**\n   * Get companies followed by current user\n   */\n  async getFollowedCompanies(): Promise<CompanyMetadata[]> {\n    const response = await apiClient.get<CompanyMetadata[]>(\n      \"/api/Companies/me/followed\",\n      z.array(CompanyMetadataSchema),\n    );\n\n    return response.data;\n  }\n\n\n\n  /**\n   * Check if current user follows a company\n   */\n  async isFollowingCompany(id: string): Promise<boolean> {\n    try {\n      const response = await apiClient.get<{ isFollowing: boolean }>(\n        `/api/Companies/${id}/following-status`,\n        z.object({ isFollowing: z.boolean() }),\n      );\n      return response.data.isFollowing;\n    } catch (error) {\n      return false;\n    }\n  }\n\n  /**\n   * Search companies with filters\n   */\n  async searchCompanies(filters: CompanyFilters): Promise<PaginatedCompanies> {\n    return this.getPublicCompanies(filters);\n  }\n\n  /**\n   * Get company statistics\n   */\n  async getCompanyStats(id: string): Promise<{\n    jobsCount: number;\n    followersCount: number;\n    activeJobsCount: number;\n  }> {\n    const response = await apiClient.get<{\n      jobsCount: number;\n      followersCount: number;\n      activeJobsCount: number;\n    }>(\n      `/api/Companies/${id}/stats`,\n      z.object({\n        jobsCount: z.number(),\n        followersCount: z.number(),\n        activeJobsCount: z.number(),\n      }),\n    );\n    return response.data;\n  }\n\n  /**\n   * Get trending/popular companies\n   */\n  async getTrendingCompanies(limit = 10): Promise<CompanyMetadata[]> {\n    const response = await apiClient.get<CompanyMetadata[]>(\n      `/api/Companies/trending?limit=${limit}`,\n      z.array(CompanyMetadataSchema),\n    );\n\n    return response.data;\n  }\n\n  /**\n   * Get companies by industry\n   */\n  async getCompaniesByIndustry(\n    industry: string,\n    page = 1,\n    limit = 20,\n  ): Promise<PaginatedCompanies> {\n    return this.getPublicCompanies({\n      industry,\n      page,\n      limit,\n    });\n  }\n\n  /**\n   * Get companies by location\n   */\n  async getCompaniesByLocation(\n    location: string,\n    page = 1,\n    limit = 20,\n  ): Promise<PaginatedCompanies> {\n    return this.getPublicCompanies({\n      location,\n      page,\n      limit,\n    });\n  }\n\n  /**\n   * Get company by slug (for SEO-friendly URLs) - returns metadata\n   */\n  async getCompanyBySlug(slug: string): Promise<CompanyMetadata> {\n    const response = await apiClient.get<CompanyMetadata>(\n      `/api/Companies/slug/${slug}`,\n      CompanyMetadataSchema,\n    );\n\n    return response.data;\n  }\n}\n\n// ============================================================================\n// DEFAULT INSTANCE\n// ============================================================================\n\nexport const companyService = new CompanyService();\nexport default companyService;\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\services\\dashboard-service.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'DashboardType' is defined but never used. Allowed unused vars must match /^_/u.","line":11,"column":8,"nodeType":null,"messageId":"unusedVar","endLine":11,"endColumn":21},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'SearchFilters' is defined but never used. Allowed 