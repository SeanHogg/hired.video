sage":"Unexpected console statement.","line":152,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":152,"endColumn":20,"suggestions":[{"fix":{"range":[4517,4563],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":253,"column":31,"nodeType":"MemberExpression","messageId":"unexpected","endLine":253,"endColumn":44,"suggestions":[{"fix":{"range":[8091,8134],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has missing dependencies: 'isAuthenticated' and 'refreshUser'. Either include them or remove the dependency array.","line":84,"column":6,"nodeType":"ArrayExpression","endLine":84,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [isAuthenticated, refreshUser]","fix":{"range":[2228,2230],"text":"[isAuthenticated, refreshUser]"}}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":8,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  User,\n  Mail,\n  Phone,\n  MapPin,\n  Calendar,\n  Edit,\n  Save,\n  Camera,\n  Eye,\n  Star,\n  TrendingUp,\n  Clock,\n  Settings,\n  Building2,\n  Briefcase,\n  FileText,\n  Download,\n  Share,\n  ExternalLink,\n} from \"lucide-react\";\nimport { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport Footer from \"@/components/Footer\";\nimport { uploadAvatar } from \"@/lib/services/upload-service\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport ShareModal from \"@/components/ShareModal\";\nimport { Avatar, AvatarImage, AvatarFallback } from \"@/components/ui/avatar\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\n\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { PasswordRequirementsProvider } from \"@/components/auth/PasswordRequirementsProvider\";\nimport { useAuth } from \"@/lib/auth\";\nimport {\n  roleToSelectValue,\n  formatRoleForDisplay,\n  getAvailableRoles,\n  createRolePermissions,\n} from \"@/lib/role-utils\";\n\nfunction ProfileContent() {\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const [isEditing, setIsEditing] = useState(false);\n  const [saving, setSaving] = useState(false);\n  const [shareOpen, setShareOpen] = useState(false);\n  const { user, isAuthenticated, refreshUser, logout } = useAuth();\n\n  // Ensure we have fresh user data only on /profile\n  useEffect(() => {\n    if (isAuthenticated) {\n      refreshUser().catch((e) => {\n        console.warn(\"Profile: refreshUser failed\", e);\n        // API client handles 401 errors automatically with logout + redirect\n        // If we get here, the error was already processed\n      });\n    }\n    // run once on mount\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  // Form state for editing\n  const [formData, setFormData] = useState({\n    firstName: user?.firstName || \"\",\n    lastName: user?.lastName || \"\",\n    email: user?.email || \"\",\n    phone: \"\",\n    role: roleToSelectValue(user?.role),\n    location: user?.location || \"\",\n    bio: `Passionate ${formatRoleForDisplay(user?.role)} focused on building meaningful connections and driving career growth through innovative technology.`,\n    company: \"\",\n    title: \"\",\n    website: user?.website || \"\",\n  });\n\n  const joinedText = (() => {\n    const iso = (user as any)?.createdAt as string | undefined;\n    if (!iso) return \"Joined today\";\n    const d = new Date(iso);\n    if (isNaN(d.getTime())) return \"Joined\";\n    return `Joined ${d.toLocaleString(undefined, { month: \"long\", year: \"numeric\" })}`;\n  })();\n\n  // Keep form in sync when user context updates\n  useEffect(() => {\n    if (!user) return;\n    console.info(\"Profile: syncing form from user context\", user);\n    setFormData({\n      firstName: user.firstName || \"\",\n      lastName: user.lastName || \"\",\n      email: user.email || \"\",\n      phone: user.phone || \"\",\n      role: roleToSelectValue(user.role),\n      location: user.location || \"\",\n      bio: `Passionate ${formatRoleForDisplay(user.role)} focused on building meaningful connections and driving career growth through innovative technology.`,\n      company: \"\",\n      title: \"\",\n      website: user.website || \"\",\n    });\n  }, [user]);\n\n  const handleInputChange = (field: string, value: string) => {\n    setFormData((prev) => ({ ...prev, [field]: value }));\n  };\n\n  const { updateProfile } = useAuth();\n\n  const handleSave = async () => {\n    try {\n      setSaving(true);\n      await updateProfile({\n        firstName: formData.firstName,\n        lastName: formData.lastName,\n        bio: formData.bio,\n        location: formData.location,\n        website: formData.website,\n        phone: formData.phone,\n        currentCompany: formData.company,\n        currentRole: formData.title,\n      });\n      // Immediately switch to read-only on successful update\n      setIsEditing(false);\n      // Refresh in background; don't block UI transition\n      refreshUser().catch((e) =>\n        console.warn(\"refreshUser failed after save\", e),\n      );\n    } catch (err) {\n      console.error(\"Failed to save profile:\", err);\n    } finally {\n      setSaving(false);\n    }\n  };\n\n  const handleCancel = () => {\n    // Reset form data to original values\n    setFormData({\n      firstName: user?.firstName || \"\",\n      lastName: user?.lastName || \"\",\n      email: user?.email || \"\",\n      phone: \"\",\n      role: roleToSelectValue(user?.role),\n      location: user?.location || \"\",\n      bio: `Passionate ${formatRoleForDisplay(user?.role)} focused on building meaningful connections and driving career growth through innovative technology.`,\n      company: \"\",\n      title: \"\",\n      website: user?.website || \"\",\n    });\n    setIsEditing(false);\n  };\n\n  // If user is not authenticated, redirect to login\n  if (!isAuthenticated || !user) {\n    return (\n      <div className=\"min-h-screen bg-background\">\n        <Sidebar\n          isOpen={sidebarOpen}\n          onClose={closeSidebar}\n          collapsed={sidebarCollapsed}\n        />\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n          <Navigation\n            onMenuClick={openSidebar}\n            onSidebarToggle={toggleSidebar}\n            sidebarCollapsed={sidebarCollapsed}\n          />\n\n          <div className=\"pt-16 p-6\">\n            <div className=\"max-w-4xl mx-auto text-center py-16\">\n              <User className=\"h-16 w-16 text-muted-foreground mx-auto mb-4\" />\n              <h1 className=\"text-2xl font-bold mb-4\">Sign In Required</h1>\n              <p className=\"text-muted-foreground mb-6\">\n                Please sign in to view and edit your profile.\n              </p>\n              <Button asChild>\n                <Link to=\"/login\">Sign In</Link>\n              </Button>\n            </div>\n          </div>\n          <Footer />\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16 p-6\">\n          <div className=\"max-w-4xl mx-auto space-y-6\">\n            {/* Profile Header */}\n            <Card>\n              <CardContent className=\"p-6\">\n                <div className=\"flex items-start gap-6\">\n                  <div className=\"relative\">\n                    <Avatar className=\"w-24 h-24\">\n                      <AvatarImage src={user.avatar} />\n                      <AvatarFallback className=\"text-2xl\">\n                        {(formData.firstName[0] || \"\") +\n                          (formData.lastName[0] || \"\")}\n                      </AvatarFallback>\n                    </Avatar>\n                    {isEditing && (\n                      <>\n                        <input\n                          id=\"avatarInput\"\n                          type=\"file\"\n                          accept=\"image/*\"\n                          className=\"hidden\"\n                          onChange={async (e) => {\n                            const file = e.target.files?.[0];\n                            if (!file) return;\n                            try {\n                              setSaving(true);\n                              await uploadAvatar(file);\n                              // Optimistically update UI\n                              await refreshUser();\n                            } catch (err) {\n                              console.error(\"Avatar upload failed\", err);\n                            } finally {\n                              setSaving(false);\n                              // Clear input so same file can be re-selected\n                              e.currentTarget.value = \"\";\n                            }\n                          }}\n                        />\n                        <Button\n                          size=\"icon\"\n                          className=\"absolute -bottom-2 -right-2 w-8 h-8 rounded-full\"\n                          onClick={() =>\n                            document.getElementById(\"avatarInput\")?.click()\n                          }\n                          disabled={saving}\n                        >\n                          <Camera className=\"h-4 w-4\" />\n                        </Button>\n                      </>\n                    )}\n                  </div>\n\n                  <div className=\"flex-1\">\n                    <div className=\"flex items-center justify-between mb-2\">\n                      <h1 className=\"text-2xl font-bold\">\n                        {isEditing\n                          ? `${formData.firstName} ${formData.lastName}`\n                          : user.name}\n                      </h1>\n                      <div className=\"flex items-center gap-2\">\n                        {isEditing ? (\n                          <>\n                            <Button variant=\"outline\" onClick={handleCancel}>\n                              Cancel\n                            </Button>\n                            <Button\n                              onClick={handleSave}\n                              disabled={saving}\n                              className=\"flex items-center gap-2\"\n                            >\n                              <Save className=\"h-4 w-4\" />\n                              {saving ? \"Saving...\" : \"Save Changes\"}\n                            </Button>\n                          </>\n                        ) : (\n                          <Button\n                            variant=\"outline\"\n                            onClick={() => setIsEditing(true)}\n                            className=\"flex items-center gap-2\"\n                          >\n                            <Edit className=\"h-4 w-4\" />\n                            Edit Profile\n                          </Button>\n                        )}\n                      </div>\n                    </div>\n\n                    <div className=\"flex items-center gap-2 mb-3\">\n                      <Badge variant=\"outline\">\n                        {formatRoleForDisplay(formData.role)}\n                      </Badge>\n                      {user?.subscription && user.subscription !== \"free\" && (\n                        <Badge variant=\"secondary\" className=\"capitalize\">\n                          {user.subscription} Member\n                        </Badge>\n                      )}\n                    </div>\n\n                    {!isEditing ? (\n                      <div className=\"space-y-2 text-sm text-muted-foreground\">\n                        <div className=\"flex items-center gap-2\">\n                          <Mail className=\"h-4 w-4\" />\n                          {formData.email}\n                        </div>\n                        {formData.phone && (\n                          <div className=\"flex items-center gap-2\">\n                            <Phone className=\"h-4 w-4\" />\n                            {formData.phone}\n                          </div>\n                        )}\n                        <div className=\"flex items-center gap-2\">\n                          <MapPin className=\"h-4 w-4\" />\n                          {formData.location}\n                        </div>\n                        <div className=\"flex items-center gap-2\">\n                          <Calendar className=\"h-4 w-4\" />\n                          {joinedText}\n                        </div>\n                      </div>\n                    ) : null}\n                  </div>\n                </div>\n\n                {isEditing ? (\n                  <div className=\"mt-6 space-y-6\">\n                    {/* Personal Information */}\n                    <div>\n                      <h3 className=\"text-lg font-medium mb-4\">\n                        Personal Information\n                      </h3>\n                      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                        <div className=\"space-y-2\">\n                          <Label htmlFor=\"firstName\">First Name</Label>\n                          <Input\n                            id=\"firstName\"\n                            value={formData.firstName}\n                            onChange={(e) =>\n                              handleInputChange(\"firstName\", e.target.value)\n                            }\n                          />\n                        </div>\n                        <div className=\"space-y-2\">\n                          <Label htmlFor=\"lastName\">Last Name</Label>\n                          <Input\n                            id=\"lastName\"\n                            value={formData.lastName}\n                            onChange={(e) =>\n                              handleInputChange(\"lastName\", e.target.value)\n                            }\n                          />\n                        </div>\n                      </div>\n                    </div>\n\n                    {/* Contact Information */}\n                    <div>\n                      <h3 className=\"text-lg font-medium mb-4\">\n                        Contact Information\n                      </h3>\n                      <div className=\"space-y-4\">\n                        <div className=\"space-y-2\">\n                          <Label htmlFor=\"email\">Email Address</Label>\n                          <Input\n                            id=\"email\"\n                            type=\"email\"\n                            value={formData.email}\n                            onChange={(e) =>\n                              handleInputChange(\"email\", e.target.value)\n                            }\n                          />\n                        </div>\n                        <div className=\"space-y-2\">\n                          <Label htmlFor=\"phone\">Phone Number</Label>\n                          <Input\n                            id=\"phone\"\n                            type=\"tel\"\n                            placeholder=\"+1 (555) 123-4567\"\n                            value={formData.phone}\n                            onChange={(e) =>\n                              handleInputChange(\"phone\", e.target.value)\n                            }\n                          />\n                        </div>\n                        <div className=\"space-y-2\">\n                          <Label htmlFor=\"location\">Location</Label>\n                          <Input\n                            id=\"location\"\n                            placeholder=\"City, State, Country\"\n                            value={formData.location}\n                            onChange={(e) =>\n                              handleInputChange(\"location\", e.target.value)\n                            }\n                          />\n                        </div>\n                      </div>\n                    </div>\n\n                    {/* Professional Information */}\n                    <div>\n                      <h3 className=\"text-lg font-medium mb-4\">\n                        Professional Information\n                      </h3>\n                      <div className=\"space-y-4\">\n                        <div className=\"space-y-2\">\n                          <Label htmlFor=\"role\">Professional Role</Label>\n                          <Select\n                            value={formData.role}\n                            onValueChange={(value) =>\n                              handleInputChange(\"role\", value)\n                            }\n                          >\n                            <SelectTrigger>\n                              <SelectValue />\n                            </SelectTrigger>\n                            <SelectContent>\n                              {getAvailableRoles().map((roleOption) => (\n                                <SelectItem\n                                  key={roleOption.value}\n                                  value={roleOption.value}\n                                >\n                                  {roleOption.label}\n                                </SelectItem>\n                              ))}\n                            </SelectContent>\n                          </Select>\n                        </div>\n                        <div className=\"space-y-2\">\n                          <Label htmlFor=\"title\">Job Title</Label>\n                          <Input\n                            id=\"title\"\n                            placeholder=\"e.g. Senior Software Engineer\"\n                            value={formData.title}\n                            onChange={(e) =>\n                              handleInputChange(\"title\", e.target.value)\n                            }\n                          />\n                        </div>\n                        <div className=\"space-y-2\">\n                          <Label htmlFor=\"company\">Company</Label>\n                          <Input\n                            id=\"company\"\n                            placeholder=\"e.g. Tech Corp\"\n                            value={formData.company}\n                            onChange={(e) =>\n                              handleInputChange(\"company\", e.target.value)\n                            }\n                          />\n                        </div>\n                        <div className=\"space-y-2\">\n                          <Label htmlFor=\"website\">Website</Label>\n                          <Input\n                            id=\"website\"\n                            type=\"url\"\n                            placeholder=\"https://yourwebsite.com\"\n                            value={formData.website}\n                            onChange={(e) =>\n                              handleInputChange(\"website\", e.target.value)\n                            }\n                          />\n                        </div>\n                      </div>\n                    </div>\n\n                    {/* Bio */}\n                    <div>\n                      <h3 className=\"text-lg font-medium mb-4\">Bio</h3>\n                      <div className=\"space-y-2\">\n                        <Label htmlFor=\"bio\">About You</Label>\n                        <Textarea\n                          id=\"bio\"\n                          placeholder=\"Tell us about yourself, your experience, and what you're looking for...\"\n                          rows={4}\n                          value={formData.bio}\n                          onChange={(e) =>\n                            handleInputChange(\"bio\", e.target.value)\n                          }\n                        />\n                      </div>\n                    </div>\n                  </div>\n                ) : (\n                  <div className=\"mt-6\">\n                    <h3 className=\"text-lg font-medium mb-3\">About</h3>\n                    <p className=\"text-muted-foreground leading-relaxed\">\n                      {formData.bio}\n                    </p>\n                  </div>\n                )}\n              </CardContent>\n            </Card>\n\n            {/* Quick Actions */}\n            <Card>\n              <CardHeader>\n                <CardTitle>Quick Actions</CardTitle>\n                <CardDescription>\n                  Manage your profile and career activities\n                </CardDescription>\n              </CardHeader>\n              <CardContent>\n                <div className=\"grid md:grid-cols-2 lg:grid-cols-4 gap-4\">\n                  {/* Role-based quick actions */}\n                  {(() => {\n                    const rolePermissions = createRolePermissions(user?.role);\n                    if (rolePermissions.isJobSeeker) {\n                      return (\n                        <>\n                          <Button\n                            variant=\"outline\"\n                            className=\"h-auto p-4 flex flex-col gap-2\"\n                            asChild\n                          >\n                            <Link to=\"/resumes\">\n                              <FileText className=\"h-6 w-6\" />\n                              <span className=\"font-medium\">Update Resume</span>\n                              <span className=\"text-xs text-muted-foreground\">\n                                Upload or edit your resume\n                              </span>\n                            </Link>\n                          </Button>\n\n                          <Button\n                            variant=\"outline\"\n                            className=\"h-auto p-4 flex flex-col gap-2\"\n                            asChild\n                          >\n                            <Link to=\"/jobs\">\n                              <Briefcase className=\"h-6 w-6\" />\n                              <span className=\"font-medium\">\n                                Job Applications\n                              </span>\n                              <span className=\"text-xs text-muted-foreground\">\n                                Track your applications\n                              </span>\n                            </Link>\n                          </Button>\n\n                          <Button\n                            variant=\"outline\"\n                            className=\"h-auto p-4 flex flex-col gap-2\"\n                            asChild\n                          >\n                            <Link to=\"/settings\">\n                              <Settings className=\"h-6 w-6\" />\n                              <span className=\"font-medium\">\n                                Account Settings\n                              </span>\n                              <span className=\"text-xs text-muted-foreground\">\n                                Privacy & preferences\n                              </span>\n                            </Link>\n                          </Button>\n\n                          <Button\n                            variant=\"outline\"\n                            className=\"h-auto p-4 flex flex-col gap-2\"\n                            onClick={() => setShareOpen(true)}\n                          >\n                            <Share className=\"h-6 w-6\" />\n                            <span className=\"font-medium\">Share Profile</span>\n                            <span className=\"text-xs text-muted-foreground\">\n                              Get your profile link\n                            </span>\n                          </Button>\n                        </>\n                      );\n                    }\n\n                    // recruiter/employer\n                    return (\n                      <>\n                        <Button\n                          variant=\"outline\"\n                          className=\"h-auto p-4 flex flex-col gap-2\"\n                          asChild\n                        >\n                          <Link to=\"/jobs/create\">\n                            <Briefcase className=\"h-6 w-6\" />\n                            <span className=\"font-medium\">Post a Job</span>\n                            <span className=\"text-xs text-muted-foreground\">\n                              Create a new job listing\n                            </span>\n                          </Link>\n                        </Button>\n\n                        <Button\n                          variant=\"outline\"\n                          className=\"h-auto p-4 flex flex-col gap-2\"\n                          asChild\n                        >\n                          <Link to=\"/people\">\n                            <Eye className=\"h-6 w-6\" />\n                            <span className=\"font-medium\">\n                              Browse Candidates\n                            </span>\n                            <span className=\"text-xs text-muted-foreground\">\n                              Search profiles & resumes\n                            </span>\n                          </Link>\n                        </Button>\n\n                        <Button\n                          variant=\"outline\"\n                          className=\"h-auto p-4 flex flex-col gap-2\"\n                          asChild\n                        >\n                          <Link to=\"/settings\">\n                            <Settings className=\"h-6 w-6\" />\n                            <span className=\"font-medium\">\n                              Account Settings\n                            </span>\n                            <span className=\"text-xs text-muted-foreground\">\n                              Team & preferences\n                            </span>\n                          </Link>\n                        </Button>\n\n                        <Button\n                          variant=\"outline\"\n                          className=\"h-auto p-4 flex flex-col gap-2\"\n                        >\n                          <Share className=\"h-6 w-6\" />\n                          <span className=\"font-medium\">Share Company</span>\n                          <span className=\"text-xs text-muted-foreground\">\n                            Invite or share your page\n                          </span>\n                        </Button>\n                      </>\n                    );\n                  })()}\n                </div>\n              </CardContent>\n            </Card>\n\n            <ShareModal\n              open={shareOpen}\n              onOpenChange={setShareOpen}\n              shareUrl={`${window.location.origin}/people/${user?.slug || user?.id}`}\n              title=\"Share Options\"\n              message=\"Please share by using an option below.\"\n            />\n          </div>\n        </div>\n        <Footer />\n      </div>\n    </div>\n  );\n}\n\nexport default function Profile() {\n  return (\n    <PasswordRequirementsProvider>\n      <ProfileContent />\n    </PasswordRequirementsProvider>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\ResetPassword.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Footer' is defined but never used. Allowed unused vars must match /^_/u.","line":18,"column":8,"nodeType":null,"messageId":"unusedVar","endLine":18,"endColumn":14},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'data' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":104,"column":15,"nodeType":null,"messageId":"unusedVar","endLine":104,"endColumn":19},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'err' is defined but never used.","line":132,"column":14,"nodeType":null,"messageId":"unusedVar","endLine":132,"endColumn":17}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\nimport { useSearchParams, Link, useNavigate } from \"react-router-dom\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { ArrowLeft, Eye, EyeOff, CheckCircle, AlertCircle } from \"lucide-react\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport Sidebar from \"@/components/Sidebar\";\nimport Navigation from \"@/components/Navigation\";\nimport Footer from \"@/components/Footer\";\nimport { apiClient } from \"@/lib/api-client\";\n\nexport default function ResetPassword() {\n  const [searchParams] = useSearchParams();\n  const navigate = useNavigate();\n  const [password, setPassword] = useState(\"\");\n  const [confirmPassword, setConfirmPassword] = useState(\"\");\n  const [showPassword, setShowPassword] = useState(false);\n  const [showConfirmPassword, setShowConfirmPassword] = useState(false);\n  const [loading, setLoading] = useState(false);\n  const [success, setSuccess] = useState(false);\n  const [error, setError] = useState(\"\");\n  const [validationErrors, setValidationErrors] = useState<string[]>([]);\n\n  const userId = searchParams.get(\"userId\");\n  const token = searchParams.get(\"token\");\n\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n\n  useEffect(() => {\n    if (!userId || !token) {\n      setError(\n        \"Invalid or missing reset link. Please request a new password reset.\",\n      );\n    }\n  }, [userId, token]);\n\n  const validatePassword = (password: string): string[] => {\n    const errors: string[] = [];\n\n    if (password.length < 8) {\n      errors.push(\"Password must be at least 8 characters long\");\n    }\n    if (!/[A-Z]/.test(password)) {\n      errors.push(\"Password must contain at least one uppercase letter\");\n    }\n    if (!/[a-z]/.test(password)) {\n      errors.push(\"Password must contain at least one lowercase letter\");\n    }\n    if (!/\\d/.test(password)) {\n      errors.push(\"Password must contain at least one number\");\n    }\n    if (!/[!@#$%^&*(),.?\":{}|<>]/.test(password)) {\n      errors.push(\"Password must contain at least one special character\");\n    }\n\n    return errors;\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!userId || !token) {\n      setError(\"Invalid reset link. Please request a new password reset.\");\n      return;\n    }\n\n    if (!password.trim()) {\n      setError(\"Please enter a new password\");\n      return;\n    }\n\n    if (password !== confirmPassword) {\n      setError(\"Passwords do not match\");\n      return;\n    }\n\n    const passwordErrors = validatePassword(password);\n    if (passwordErrors.length > 0) {\n      setValidationErrors(passwordErrors);\n      setError(\"Please fix the password requirements below\");\n      return;\n    }\n\n    setLoading(true);\n    setError(\"\");\n    setValidationErrors([]);\n\n    try {\n      const { data } = await apiClient.requestRaw<{ message?: string }>(\n        \"/api/account/confirm-password-reset\",\n        {\n          method: \"POST\",\n          body: {\n            userId,\n            token,\n            newPassword: password,\n          },\n        },\n      );\n\n      const ok = true;\n\n      if (ok) {\n        setSuccess(true);\n        setTimeout(() => {\n          navigate(\n            \"/login?message=Password reset successful. Please sign in with your new password.\",\n          );\n        }, 3000);\n      } else {\n        try {\n          setError(\"Failed to reset password. Please try again.\");\n        } catch {\n          setError(\"Failed to reset password. Please try again.\");\n        }\n      }\n    } catch (err) {\n      setError(\"Network error. Please check your connection and try again.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  if (!userId || !token) {\n    return (\n      <div className=\"min-h-screen bg-gradient-to-br from-blue-50 via-white to-purple-50\">\n        <Sidebar\n          isOpen={sidebarOpen}\n          onClose={closeSidebar}\n          collapsed={sidebarCollapsed}\n        />\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n          <Navigation\n            onMenuClick={openSidebar}\n            onSidebarToggle={toggleSidebar}\n            sidebarCollapsed={sidebarCollapsed}\n          />\n\n          <div className=\"pt-16 min-h-screen flex items-center justify-center p-4\">\n            <div className=\"w-full max-w-md\">\n              <Card>\n                <CardHeader className=\"text-center\">\n                  <CardTitle className=\"text-2xl font-bold text-red-600\">\n                    Invalid Reset Link\n                  </CardTitle>\n                  <CardDescription>\n                    This password reset link is invalid or has expired.\n                  </CardDescription>\n                </CardHeader>\n                <CardContent className=\"space-y-4\">\n                  <Alert>\n                    <AlertCircle className=\"h-4 w-4\" />\n                    <AlertDescription>\n                      Please request a new password reset link to continue.\n                    </AlertDescription>\n                  </Alert>\n\n                  <div className=\"space-y-3\">\n                    <Button asChild className=\"w-full\">\n                      <Link to=\"/forgot-password\">Request New Reset Link</Link>\n                    </Button>\n\n                    <div className=\"text-center\">\n                      <Link\n                        to=\"/login\"\n                        className=\"text-sm text-blue-600 hover:text-blue-500 inline-flex items-center\"\n                      >\n                        <ArrowLeft className=\"h-4 w-4 mr-1\" />\n                        Back to Sign In\n                      </Link>\n                    </div>\n                  </div>\n                </CardContent>\n              </Card>\n            </div>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  if (success) {\n    return (\n      <div className=\"min-h-screen bg-gradient-to-br from-blue-50 via-white to-purple-50\">\n        <Sidebar\n          isOpen={sidebarOpen}\n          onClose={closeSidebar}\n          collapsed={sidebarCollapsed}\n        />\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n          <Navigation\n            onMenuClick={openSidebar}\n            onSidebarToggle={toggleSidebar}\n            sidebarCollapsed={sidebarCollapsed}\n          />\n\n          <div className=\"pt-16 min-h-screen flex items-center justify-center p-4\">\n            <div className=\"w-full max-w-md\">\n              <Card>\n                <CardHeader className=\"text-center\">\n                  <div className=\"mx-auto w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mb-4\">\n                    <CheckCircle className=\"h-6 w-6 text-green-600\" />\n                  </div>\n                  <CardTitle className=\"text-2xl font-bold text-green-600\">\n                    Password Reset Successful!\n                  </CardTitle>\n                  <CardDescription>\n                    Your password has been successfully updated.\n                  </CardDescription>\n                </CardHeader>\n                <CardContent className=\"space-y-4\">\n                  <Alert>\n                    <CheckCircle className=\"h-4 w-4\" />\n                    <AlertDescription>\n                      You will be redirected to the sign-in page in a few\n                      seconds.\n                    </AlertDescription>\n                  </Alert>\n\n                  <Button asChild className=\"w-full\">\n                    <Link to=\"/login\">Sign In Now</Link>\n                  </Button>\n                </CardContent>\n              </Card>\n            </div>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-blue-50 via-white to-purple-50\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16 min-h-screen flex items-center justify-center p-4\">\n          <div className=\"w-full max-w-md\">\n            <Card>\n              <CardHeader className=\"text-center\">\n                <CardTitle className=\"text-2xl font-bold\">\n                  Reset Your Password\n                </CardTitle>\n                <CardDescription>Enter your new password below</CardDescription>\n              </CardHeader>\n              <CardContent>\n                <form onSubmit={handleSubmit} className=\"space-y-4\">\n                  {error && (\n                    <Alert variant=\"destructive\">\n                      <AlertCircle className=\"h-4 w-4\" />\n                      <AlertDescription>{error}</AlertDescription>\n                    </Alert>\n                  )}\n\n                  <div className=\"space-y-2\">\n                    <Label htmlFor=\"password\">New Password</Label>\n                    <div className=\"relative\">\n                      <Input\n                        id=\"password\"\n                        type={showPassword ? \"text\" : \"password\"}\n                        placeholder=\"Enter your new password\"\n                        value={password}\n                        onChange={(e) => setPassword(e.target.value)}\n                        disabled={loading}\n                        required\n                      />\n                      <Button\n                        type=\"button\"\n                        variant=\"ghost\"\n                        size=\"icon\"\n                        className=\"absolute right-0 top-0 h-full px-3 py-2 hover:bg-transparent\"\n                        onClick={() => setShowPassword(!showPassword)}\n                        disabled={loading}\n                      >\n                        {showPassword ? (\n                          <EyeOff className=\"h-4 w-4\" />\n                        ) : (\n                          <Eye className=\"h-4 w-4\" />\n                        )}\n                      </Button>\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-2\">\n                    <Label htmlFor=\"confirmPassword\">\n                      Confirm New Password\n                    </Label>\n                    <div className=\"relative\">\n                      <Input\n                        id=\"confirmPassword\"\n                        type={showConfirmPassword ? \"text\" : \"password\"}\n                        placeholder=\"Confirm your new password\"\n                        value={confirmPassword}\n                        onChange={(e) => setConfirmPassword(e.target.value)}\n                        disabled={loading}\n                        required\n                      />\n                      <Button\n                        type=\"button\"\n                        variant=\"ghost\"\n                        size=\"icon\"\n                        className=\"absolute right-0 top-0 h-full px-3 py-2 hover:bg-transparent\"\n                        onClick={() =>\n                          setShowConfirmPassword(!showConfirmPassword)\n                        }\n                        disabled={loading}\n                      >\n                        {showConfirmPassword ? (\n                          <EyeOff className=\"h-4 w-4\" />\n                        ) : (\n                          <Eye className=\"h-4 w-4\" />\n                        )}\n                      </Button>\n                    </div>\n                  </div>\n\n                  {validationErrors.length > 0 && (\n                    <Alert variant=\"destructive\">\n                      <AlertCircle className=\"h-4 w-4\" />\n                      <AlertDescription>\n                        <ul className=\"list-disc list-inside space-y-1\">\n                          {validationErrors.map((error, index) => (\n                            <li key={index}>{error}</li>\n                          ))}\n                        </ul>\n                      </AlertDescription>\n                    </Alert>\n                  )}\n\n                  <Button type=\"submit\" className=\"w-full\" disabled={loading}>\n                    {loading ? (\n                      <div className=\"flex items-center\">\n                        <div className=\"animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2\" />\n                        Resetting Password...\n                      </div>\n                    ) : (\n                      \"Reset Password\"\n                    )}\n                  </Button>\n\n                  <div className=\"text-center\">\n                    <Link\n                      to=\"/login\"\n                      className=\"text-sm text-blue-600 hover:text-blue-500 inline-flex items-center\"\n                    >\n                      <ArrowLeft className=\"h-4 w-4 mr-1\" />\n                      Back to Sign In\n                    </Link>\n                  </div>\n                </form>\n              </CardContent>\n            </Card>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\ResumeCreatePage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'resumeId' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":28,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":28,"endColumn":18},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":54,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":54,"endColumn":18,"suggestions":[{"fix":{"range":[1928,1988],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":59,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":59,"endColumn":20,"suggestions":[{"fix":{"range":[2089,2138],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { ArrowLeft } from \"lucide-react\";\nimport { useState, useEffect } from \"react\";\nimport { useParams, useNavigate, useLocation } from \"react-router-dom\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport ResumeBuilder from \"@/components/ResumeBuilder\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Button } from \"@/components/ui/button\";\nimport { resumeService } from \"@/lib/services/resume-service\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\nimport { generateResumeId } from \"@/lib/utils\";\nimport type { CreateResumeRequest, ResumeData } from \"@/types/resume\";\n\nexport default function ResumeCreatePage() {\n  const { id } = useParams<{ id: string }>();\n  const navigate = useNavigate();\n  const location = useLocation();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { isAuthenticated, user } = useAuth();\n\n  const [resumeId] = useState(id || generateResumeId());\n  const [initialData, setInitialData] = useState<\n    Partial<ResumeData> | undefined\n  >();\n\n  useEffect(() => {\n    // Check if we have uploaded data from the upload page\n    if (location.state?.uploadedData) {\n      setInitialData(location.state.uploadedData);\n    }\n  }, [location.state]);\n\n  const handleCreateResume = async (request: CreateResumeRequest) => {\n    try {\n      // Convert CreateResumeRequest to the format expected by the service\n      const resumeRequest = {\n        name: request.name || \"New Resume\",\n        data: request.data,\n        privacy: \"private\", // Default privacy setting\n        isMaster: true, // New resumes are master resumes by default\n        isActive: true, // New resumes are active by default\n      };\n\n      // Save the resume to the backend\n      const savedResume = await resumeService.createResume(resumeRequest);\n\n      console.log(\"Resume created successfully:\", savedResume.id);\n\n      // Navigate to the resumes list page\n      navigate(\"/resumes\");\n    } catch (error) {\n      console.error(\"Failed to create resume:\", error);\n      // TODO: Show error message to user\n    }\n  };\n\n  const handleCancel = () => {\n    navigate(\"/resumes\");\n  };\n\n  if (!isAuthenticated || !user) {\n    navigate(\"/login\");\n    return null;\n  }\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16 p-6\">\n          <div className=\"max-w-4xl mx-auto space-y-6\">\n            {/* Header */}\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <h1 className=\"text-3xl font-bold\">Create Resume</h1>\n                <p className=\"text-muted-foreground\">\n                  {initialData\n                    ? \"Review and edit your uploaded resume\"\n                    : \"Build your resume from scratch\"}\n                </p>\n              </div>\n              <Button variant=\"outline\" onClick={handleCancel}>\n                <ArrowLeft className=\"w-4 h-4 mr-2\" />\n                Back to Resumes\n              </Button>\n            </div>\n\n            {/* Builder Component */}\n            <ResumeBuilder\n              onSave={handleCreateResume}\n              onCancel={handleCancel}\n              initialData={initialData}\n            />\n          </div>\n        </div>\n        <Footer />\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\ResumeDetail.tsx","messages":[{"ruleId":"no-duplicate-imports","severity":1,"message":"'@/types/resume' import is duplicated.","line":51,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":51,"endColumn":43},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":64,"column":29,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":64,"endColumn":32,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1628,1631],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1628,1631],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"jsx-a11y/click-events-have-key-events","severity":1,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":106,"column":7,"nodeType":"JSXOpeningElement","endLine":109,"endColumn":8},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'selectedMediaId' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":173,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":173,"endColumn":25},{"ruleId":"no-empty","severity":2,"message":"Empty block statement.","line":211,"column":13,"nodeType":"BlockStatement","messageId":"unexpected","endLine":211,"endColumn":15,"suggestions":[{"messageId":"suggestComment","data":{"type":"block"},"fix":{"range":[6668,6668],"text":" /* empty */ "},"desc":"Add comment inside empty block statement."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":226,"column":9,"nodeType":"MemberExpression","messageId":"unexpected","endLine":226,"endColumn":22,"suggestions":[{"fix":{"range":[7003,7101],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":232,"column":11,"nodeType":"MemberExpression","messageId":"unexpected","endLine":232,"endColumn":24,"suggestions":[{"fix":{"range":[7338,7413],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":272,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":272,"endColumn":20,"suggestions":[{"fix":{"range":[8485,8534],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":356,"column":31,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[11047,11143],"text":"\n                The resume you&apos;re looking for doesn't exist or has been removed.\n              "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[11047,11143],"text":"\n                The resume you&lsquo;re looking for doesn't exist or has been removed.\n              "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[11047,11143],"text":"\n                The resume you&#39;re looking for doesn't exist or has been removed.\n              "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[11047,11143],"text":"\n                The resume you&rsquo;re looking for doesn't exist or has been removed.\n              "},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":356,"column":52,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[11047,11143],"text":"\n                The resume you're looking for doesn&apos;t exist or has been removed.\n              "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[11047,11143],"text":"\n                The resume you're looking for doesn&lsquo;t exist or has been removed.\n              "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[11047,11143],"text":"\n                The resume you're looking for doesn&#39;t exist or has been removed.\n              "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[11047,11143],"text":"\n                The resume you're looking for doesn&rsquo;t exist or has been removed.\n              "},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  ArrowLeft,\n  Edit,\n\n  Calendar,\n  Mail,\n  Phone,\n  ExternalLink,\n  Building,\n  GraduationCap,\n  Heart,\n  Award,\n  Share2,\n  Download,\n  ChevronLeft,\n  ChevronRight,\n  Target,\n  Globe,\n  Users,\n  Lock,\n  Star,\n  BookOpen,\n  Languages,\n  Lightbulb,\n  UserCheck,\n  FolderOpen,\n  Trophy,\n  MoreHorizontal,\n} from \"lucide-react\";\nimport { useState, useEffect, useMemo } from \"react\";\nimport { useParams, useNavigate, useLocation } from \"react-router-dom\";\nimport AuthOverlay from \"@/components/AuthOverlay\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent } from \"@/components/ui/card\";\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\";\n\nimport { resumeService } from \"@/lib/services/resume-service\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\nimport type { Resume , ResumeSectionMeta } from \"@/types/resume\";\nimport { MetaType } from \"@/types/resume\";\nimport ResumeTimelines from \"@/components/ResumeTimelines\";\nimport { MetaBadge } from \"@/components/MetaBadge\";\nimport MetadataModal from \"@/components/MetadataModal\";\n\n\ninterface TimelineItemProps {\n  title: string;\n  subtitle: string;\n  startDate: string;\n  endDate: string;\n  description?: string;\n  highlights?: string[];\n  icon: React.ComponentType<any>;\n  isLast?: boolean;\n}\n\nfunction TimelineItem({\n  title,\n  subtitle,\n  startDate,\n  endDate,\n  description,\n  highlights,\n  icon: Icon,\n  isLast = false,\n}: TimelineItemProps) {\n  const [expanded, setExpanded] = useState(false);\n\n\n  const formatDate = (dateString: string) => {\n    if (dateString === \"Present\") return \"Present\";\n    if (!dateString) return \"No date\";\n    const dateObj = new Date(dateString);\n    if (isNaN(dateObj.getTime())) return \"Invalid date\";\n    return dateObj.toLocaleDateString(\"en-US\", {\n      year: \"numeric\",\n      month: \"short\",\n    });\n  };\n\n  const formattedStart = formatDate(startDate);\n  const formattedEnd = formatDate(endDate);\n  const showDateRange = !(formattedStart === \"No date\" && formattedEnd === \"No date\");\n  const dateText = formattedStart === \"No date\" && formattedEnd !== \"No date\"\n    ? formattedEnd\n    : `${formattedStart} - ${formattedEnd}`;\n\n\n  return (\n    <div className=\"relative\">\n      {!isLast && (\n        <div className=\"absolute left-6 top-12 w-0.5 h-full bg-gradient-to-b from-primary to-primary/20\" />\n      )}\n\n      <div\n        className=\"flex items-start gap-4 p-4 rounded-lg hover:bg-muted/30 transition-colors cursor-pointer\"\n        onClick={() => setExpanded(!expanded)}\n      >\n        <div className=\"flex-shrink-0 w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center relative z-10\">\n          <Icon className=\"w-6 h-6 text-primary\" />\n        </div>\n\n        <div className=\"flex-1 min-w-0\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex-1\">\n              <h3 className=\"font-semibold text-lg leading-tight\">{title}</h3>\n              <p className=\"text-primary font-medium\">{subtitle}</p>\n            </div>\n            <div className=\"text-right\">\n              {showDateRange && (\n                <div className=\"flex items-center gap-2 text-sm text-muted-foreground\">\n                  <Calendar className=\"w-4 h-4\" />\n                  <span>{dateText}</span>\n                </div>\n              )}\n              <ChevronRight\n                className={`w-4 h-4 text-muted-foreground transition-transform ${expanded ? \"rotate-90\" : \"\"}`}\n              />\n            </div>\n          </div>\n\n          {description && (\n            <p className=\"text-muted-foreground mt-2\">{description}</p>\n          )}\n\n          {expanded && highlights && highlights.length > 0 && (\n            <div className=\"mt-4 space-y-2\">\n              <h4 className=\"font-medium text-sm text-muted-foreground uppercase tracking-wide\">\n                Key Achievements\n              </h4>\n              <ul className=\"space-y-2\">\n                {highlights.map((highlight, index) => (\n                  <li key={index} className=\"flex items-start gap-2 text-sm\">\n                    <div className=\"w-1.5 h-1.5 bg-primary rounded-full mt-2 flex-shrink-0\" />\n                    <span>{highlight}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n}\n\nexport default function ResumeDetail() {\n  const { id } = useParams<{ id: string }>();\n  const navigate = useNavigate();\n  const location = useLocation();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { isAuthenticated, user } = useAuth();\n\n  const [resume, setResume] = useState<Resume | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [selectedMediaId, setSelectedMediaId] = useState<string | null>(null);\n\n  // Metadata modal state\n  const [metadataModal, setMetadataModal] = useState<{\n    open: boolean;\n    initialMetadata: ResumeSectionMeta[];\n  }>({\n    open: false,\n    initialMetadata: [],\n  });\n\n  const videoMetaItems = useMemo<ResumeSectionMeta[]>(() => {\n    if (!resume?.metaData || resume.metaData.length === 0) return [];\n    const videoTypes = new Set([MetaType.YouTube, MetaType.VideoMP4, MetaType.VideoWebM]);\n    return resume.metaData.filter((m) => videoTypes.has(m.metaType));\n  }, [resume]);\n\n  const [videoIndex, setVideoIndex] = useState<number>(0);\n  useEffect(() => {\n    if (videoIndex >= videoMetaItems.length) setVideoIndex(0);\n  }, [videoMetaItems.length, videoIndex]);\n\n  const currentVideoMeta = videoMetaItems.length > 0 ? videoMetaItems[videoIndex] : null;\n\n  const youTubeEmbed = (url: string): string => {\n    try {\n      const u = new URL(url);\n      if (u.hostname.includes(\"youtu.be\")) {\n        const id = u.pathname.split(\"/\").filter(Boolean)[0];\n        if (id) return `https://www.youtube.com/embed/${id}`;\n      }\n      if (u.hostname.includes(\"youtube.com\")) {\n        const v = u.searchParams.get(\"v\");\n        if (v) return `https://www.youtube.com/embed/${v}`;\n        const parts = u.pathname.split(\"/\").filter(Boolean);\n        const embedIdx = parts.indexOf(\"embed\");\n        if (embedIdx >= 0 && parts[embedIdx + 1]) return `https://www.youtube.com/embed/${parts[embedIdx + 1]}`;\n      }\n    } catch {}\n    return url;\n  };\n\n\n  useEffect(() => {\n    const loadResume = async () => {\n      if (!id) return;\n\n      setLoading(true);\n      try {\n        // Primary: standard endpoint (respects privacy/auth)\n        const foundResume = await resumeService.getResumeById(id);\n        setResume(foundResume);\n      } catch (error) {\n        console.error(\"Failed to load resume via /api/Resume/{id}, attempting embedded endpoint:\", error);\n        try {\n          // Fallback: embedded endpoint allows public viewing by slug or GUID\n          const embedded = await resumeService.getResumeForEmbed(id);\n          setResume(embedded);\n        } catch (embeddedErr) {\n          console.error(\"Failed to load resume via embedded endpoint:\", embeddedErr);\n        }\n      } finally {\n        setLoading(false);\n      }\n    };\n\n    loadResume();\n  }, [id]);\n\n  // Handle URL fragments to open specific media content\n  useEffect(() => {\n    if (location.hash && resume?.metaData) {\n      const mediaId = location.hash.substring(1); // Remove the # symbol\n      const mediaItem = resume.metaData.find(m => m.referenceId === mediaId || m.id === mediaId);\n      if (mediaItem) {\n        setSelectedMediaId(mediaItem.id);\n      }\n    }\n  }, [location.hash, resume?.metaData]);\n\n  const isOwner = user?.id === resume?.userId;\n\n  const handleAddMedia = () => {\n    if (!resume) return;\n    setMetadataModal({\n      open: true,\n      initialMetadata: resume.metaData || [],\n    });\n  };\n\n  const handleSaveMetadata = async (metadata: ResumeSectionMeta[]) => {\n    if (!resume?.id) return;\n\n    try {\n      await resumeService.updateResumeMetadata(resume.id, metadata);\n      // Refresh the resume data\n      const updatedResume = await resumeService.getResumeById(resume.id);\n      setResume(updatedResume);\n    } catch (error) {\n      console.error(\"Failed to save metadata:\", error);\n      throw error; // Re-throw to prevent modal from closing\n    }\n  };\n\n  const getPrivacyIcon = (privacy: string) => {\n    switch (privacy) {\n      case \"public\":\n        return <Globe className=\"w-4 h-4\" />;\n      case \"recruiter_only\":\n        return <Users className=\"w-4 h-4\" />;\n      case \"connections\":\n        return <Users className=\"w-4 h-4\" />;\n      case \"private\":\n        return <Lock className=\"w-4 h-4\" />;\n      default:\n        return <Lock className=\"w-4 h-4\" />;\n    }\n  };\n\n  const getPrivacyText = (privacy: string) => {\n    switch (privacy) {\n      case \"public\":\n        return \"Public\";\n      case \"recruiter_only\":\n        return \"Recruiter Only\";\n      case \"connections\":\n        return \"Connections\";\n      case \"private\":\n        return \"Private\";\n      default:\n        return \"Private\";\n    }\n  };\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-background\">\n        <Sidebar\n          isOpen={sidebarOpen}\n          onClose={closeSidebar}\n          collapsed={sidebarCollapsed}\n        />\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n          <Navigation\n            onMenuClick={openSidebar}\n            onSidebarToggle={toggleSidebar}\n            sidebarCollapsed={sidebarCollapsed}\n          />\n          <div className=\"pt-16 p-6\">\n            <div className=\"max-w-4xl mx-auto\">\n              <div className=\"animate-pulse space-y-6\">\n                <div className=\"h-8 bg-muted rounded w-1/3\" />\n                <div className=\"h-64 bg-muted rounded\" />\n                <div className=\"space-y-4\">\n                  <div className=\"h-4 bg-muted rounded w-3/4\" />\n                  <div className=\"h-4 bg-muted rounded w-1/2\" />\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  if (!resume) {\n    return (\n      <div className=\"min-h-screen bg-background\">\n        <Sidebar\n          isOpen={sidebarOpen}\n          onClose={closeSidebar}\n          collapsed={sidebarCollapsed}\n        />\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n          <Navigation\n            onMenuClick={openSidebar}\n            onSidebarToggle={toggleSidebar}\n            sidebarCollapsed={sidebarCollapsed}\n          />\n          <div className=\"pt-16 p-6\">\n            <div className=\"max-w-4xl mx-auto text-center\">\n              <h1 className=\"text-2xl font-bold mb-4\">Resume Not Found</h1>\n              <p className=\"text-muted-foreground mb-6\">\n                The resume you're looking for doesn't exist or has been removed.\n              </p>\n              <Button onClick={() => navigate(\"/resumes\")}>\n                <ArrowLeft className=\"w-4 h-4 mr-2\" />\n                Back to Resumes\n              </Button>\n            </div>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  // Remove the editing view since we now have a separate edit page\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className={`pt-16 ${!isAuthenticated ? \"relative\" : \"\"}`}>\n          {!isAuthenticated && (\n            <AuthOverlay\n              contentType=\"resume\"\n              title={resume?.data?.Basics?.Name || resume?.name || \"Resume\"}\n            />\n          )}\n          {/* Header with Video */}\n          <div className=\"relative bg-gradient-to-br from-primary via-primary/90 to-primary/80 text-primary-foreground\">\n            <div className=\"absolute inset-0 bg-[url('/placeholder.svg')] bg-cover bg-center opacity-10\" />\n            <div className=\"relative max-w-6xl mx-auto px-6 py-12\">\n              {/* Navigation */}\n              <div className=\"flex items-center justify-between mb-8\">\n                <Button\n                  variant=\"ghost\"\n                  onClick={() => navigate(\"/resumes\")}\n                  className=\"text-primary-foreground hover:bg-primary-foreground/10\"\n                >\n                  <ArrowLeft className=\"w-4 h-4 mr-2\" />\n                  Back to Resumes\n                </Button>\n\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"flex items-center gap-2\">\n                    {resume.isActive && (\n                      <Badge\n                        variant=\"secondary\"\n                        className=\"bg-green-100 text-green-800\"\n                      >\n                        <Target className=\"w-3 h-3 mr-1\" />\n                        Active\n                      </Badge>\n                    )}\n                    {resume.isMaster && (\n                      <Badge\n                        variant=\"secondary\"\n                        className=\"bg-yellow-100 text-yellow-800\"\n                      >\n                        <Star className=\"w-3 h-3 mr-1\" />\n                        Master\n                      </Badge>\n                    )}\n                    <Badge\n                      variant=\"secondary\"\n                      className=\"bg-white/20 text-primary-foreground\"\n                    >\n                      {getPrivacyIcon(resume.privacy)}\n                      <span className=\"ml-1\">\n                        {getPrivacyText(resume.privacy)}\n                      </span>\n                    </Badge>\n                  </div>\n\n                  <DropdownMenu>\n                    <DropdownMenuTrigger asChild>\n                      <Button\n                        variant=\"secondary\"\n                        size=\"sm\"\n                        className=\"bg-white/20 hover:bg-white/30 text-primary-foreground border-white/30\"\n                      >\n                        <MoreHorizontal className=\"w-4 h-4\" />\n                      </Button>\n                    </DropdownMenuTrigger>\n                    <DropdownMenuContent align=\"end\">\n                      {isOwner && (\n                        <>\n                          <DropdownMenuItem onClick={() => navigate(`/resumes/edit/${resume.id}`)}>\n                            <Edit className=\"w-4 h-4 mr-2\" />\n                            Edit Resume\n                          </DropdownMenuItem>\n                          <DropdownMenuItem onClick={handleAddMedia}>\n                            <Share2 className=\"w-4 h-4 mr-2\" />\n                            Add Media\n                          </DropdownMenuItem>\n                        </>\n                      )}\n                      <DropdownMenuItem>\n                        <Share2 className=\"w-4 h-4 mr-2\" />\n                        Share\n                      </DropdownMenuItem>\n                    </DropdownMenuContent>\n                  </DropdownMenu>\n                </div>\n              </div>\n\n              {/* Video Resume Header */}\n              <div className=\"grid md:grid-cols-2 gap-8 items-center\">\n                <div className=\"space-y-6\">\n                  <div className=\"flex items-center gap-4\">\n                    <Avatar className=\"w-20 h-20 border-4 border-white/30\">\n                      <AvatarImage\n                        src={resume?.data?.Basics?.Image || \"\"}\n                      />\n                      <AvatarFallback className=\"text-2xl bg-white/20\">\n                        {resume?.data?.Basics?.Name\n                          ?.split(\" \")\n                          .map((n: string) => n[0])\n                          .join(\"\") || \"??\"}\n                      </AvatarFallback>\n                    </Avatar>\n                    <div>\n                      <h1 className=\"text-4xl font-bold\">\n                        {resume?.data?.Basics?.Name || resume?.name || \"Untitled Resume\"}\n                      </h1>\n                      <p className=\"text-xl opacity-90\">\n                        {resume?.data?.Basics?.Label || \"\"}\n                      </p>\n                    </div>\n                  </div>\n\n                  <div className=\"flex flex-wrap gap-3\">\n                    {resume?.data?.Basics?.Email && (\n                      <Button\n                        variant=\"secondary\"\n                        size=\"sm\"\n                        onClick={() =>\n                          window.open(\n                            `mailto:${resume.data.Basics.Email}`,\n                          )\n                        }\n                        className=\"bg-white/20 hover:bg-white/30 text-primary-foreground border-white/30\"\n                      >\n                        <Mail className=\"w-4 h-4 mr-2\" />\n                        Email\n                      </Button>\n                    )}\n                    {resume?.data?.Basics?.Phone && (\n                      <Button\n                        variant=\"secondary\"\n                        size=\"sm\"\n                        onClick={() =>\n                          window.open(\n                            `tel:${resume.data.Basics.Phone}`,\n                          )\n                        }\n                        className=\"bg-white/20 hover:bg-white/30 text-primary-foreground border-white/30\"\n                      >\n                        <Phone className=\"w-4 h-4 mr-2\" />\n                        Call\n                      </Button>\n                    )}\n                    {resume?.data?.Basics?.Url && (\n                      <Button\n                        variant=\"secondary\"\n                        size=\"sm\"\n                        onClick={() =>\n                          window.open(\n                            resume.data.Basics.Url,\n                            \"_blank\",\n                          )\n                        }\n                        className=\"bg-white/20 hover:bg-white/30 text-primary-foreground border-white/30\"\n                      >\n                        <ExternalLink className=\"w-4 h-4 mr-2\" />\n                        Portfolio\n                      </Button>\n                    )}\n                    <Button\n                      variant=\"secondary\"\n                      size=\"sm\"\n                      className=\"bg-white/20 hover:bg-white/30 text-primary-foreground border-white/30\"\n                    >\n                      <Download className=\"w-4 h-4 mr-2\" />\n                      Download PDF\n                    </Button>\n                  </div>\n\n                  <p className=\"text-lg leading-relaxed opacity-95\">\n                    {resume?.data?.Basics?.Summary || \"\"}\n                  </p>\n\n                      {resume.metaData && resume.data?.Basics?.Id && (\n                        <div className=\"mt-4 flex flex-wrap gap-2\">\n                          {resume.metaData\n                            .filter((m) => m.referenceId === resume.data.Basics.Id)\n                            .map((m) => (\n                              <MetaBadge key={m.id} meta={m} />\n                            ))}\n                        </div>\n                      )}\n\n                </div>\n\n                {/* Featured Video (from metadata) */}\n                {currentVideoMeta && (\n                  <div className=\"relative\">\n                    <Card className=\"bg-white/10 border-white/30 backdrop-blur-sm\">\n                      <CardContent className=\"p-6\">\n                        <div className=\"aspect-video bg-black rounded-lg relative overflow-hidden\">\n                          {/* Prev control */}\n                          {videoMetaItems.length > 1 && (\n                            <button\n                              type=\"button\"\n                              aria-label=\"Previous video\"\n                              className=\"absolute left-2 top-1/2 -translate-y-1/2 z-10 bg-black/40 hover:bg-black/60 text-white rounded-full p-2\"\n                              onClick={() => setVideoIndex((prev) => (prev - 1 + videoMetaItems.length) % videoMetaItems.length)}\n                            >\n                              <ChevronLeft className=\"w-5 h-5\" />\n                            </button>\n                          )}\n\n                          {/* Next control */}\n                          {videoMetaItems.length > 1 && (\n                            <button\n                              type=\"button\"\n                              aria-label=\"Next video\"\n                              className=\"absolute right-2 top-1/2 -translate-y-1/2 z-10 bg-black/40 hover:bg-black/60 text-white rounded-full p-2\"\n                              onClick={() => setVideoIndex((prev) => (prev + 1) % videoMetaItems.length)}\n                            >\n                              <ChevronRight className=\"w-5 h-5\" />\n                            </button>\n                          )}\n\n                          {currentVideoMeta.metaType === MetaType.YouTube ? (\n                            <iframe\n                              className=\"absolute inset-0 w-full h-full\"\n                              src={youTubeEmbed(currentVideoMeta.url)}\n                              title={currentVideoMeta.name || \"Video Resume\"}\n                              allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n                              allowFullScreen\n                            />\n                          ) : (\n                            <video className=\"absolute inset-0 w-full h-full\" controls>\n                              <source\n                                src={currentVideoMeta.url}\n                                type={\n                                  currentVideoMeta.metaType === MetaType.VideoWebM\n                                    ? \"video/webm\"\n                                    : \"video/mp4\"\n                                }\n                              />\n                              Your browser does not support the video tag.\n                            </video>\n                          )}\n                        </div>\n\n                        {/* Footer controls */}\n                        <div className=\"mt-4 flex flex-col items-center gap-2\">\n                          <div className=\"text-xs opacity-80\">\n                            Video {videoIndex + 1} / {videoMetaItems.length}\n                          </div>\n                          {videoMetaItems.length > 1 && (\n                            <div className=\"flex flex-wrap gap-2 justify-center\">\n                              {videoMetaItems.map((m, idx) => (\n                                <button\n                                  key={m.id || `${m.referenceId}-${idx}`}\n                                  type=\"button\"\n                                  className={`px-2 py-1 rounded text-xs border ${idx === videoIndex ? \"bg-primary text-primary-foreground border-primary\" : \"bg-secondary/30 text-foreground border-border\"}`}\n                                  onClick={() => setVideoIndex(idx)}\n                                >\n                                  {m.name || `Video ${idx + 1}`}\n                                </button>\n                              ))}\n                            </div>\n                          )}\n                        </div>\n                      </CardContent>\n                    </Card>\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n\n          {/* Content */}\n          <div className=\"max-w-6xl mx-auto px-6 py-12 space-y-12\">\n            {/* Resume Timeline */}\n            <ResumeTimelines resumeData={resume.data} />\n\n            {/* Work Experience Timeline */}\n            {resume?.data?.Work &&\n              resume.data.Work.length > 0 && (\n                <section>\n                  <div className=\"flex items-center gap-3 mb-8\">\n                    <div className=\"w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center\">\n                      <Building className=\"w-5 h-5 text-primary\" />\n                    </div>\n                    <h2 className=\"text-3xl font-bold\">Work Experience</h2>\n                  </div>\n\n                  <Card>\n                    <CardContent className=\"p-6\">\n                      <div className=\"space-y-4\">\n                        {resume.data.Work\n                          .sort((a, b) => {\n                            const aIsCurrent = !a.EndDate || a.EndDate === \"\" || a.EndDate === \"Present\";\n                            const bIsCurrent = !b.EndDate || b.EndDate === \"\" || b.EndDate === \"Present\";\n\n                            if (aIsCurrent && !bIsCurrent) return -1;\n                            if (!aIsCurrent && bIsCurrent) return 1;\n\n                            // If both not current, sort by end date desc when valid\n                            if (!aIsCurrent && !bIsCurrent) {\n                              const aEnd = new Date(a.EndDate || \"\");\n                              const bEnd = new Date(b.EndDate || \"\");\n                              if (!isNaN(aEnd.getTime()) && !isNaN(bEnd.getTime())) {\n                                return bEnd.getTime() - aEnd.getTime();\n                              }\n                            }\n\n                            // Otherwise sort by start date desc when valid\n                            const aStart = new Date(a.StartDate || \"\");\n                            const bStart = new Date(b.StartDate || \"\");\n                            if (!isNaN(aStart.getTime()) && !isNaN(bStart.getTime())) {\n                              return bStart.getTime() - aStart.getTime();\n                            }\n                            return 0;\n                          })\n                          .map((work, index) => (\n                            <div key={index} className=\"pb-2\">\n                              <TimelineItem\n                                title={work.Position || \"\"}\n                                subtitle={work.Name || \"\"}\n                                startDate={work.StartDate || \"\"}\n                                endDate={work.EndDate || \"Present\"}\n                                description={work.Summary || \"\"}\n                                highlights={work.Highlights}\n                                icon={Building}\n                                isLast={index === resume.data.Work.length - 1}\n                              />\n                              {resume.metaData && work.Id && (\n                                <div className=\"mt-2 ml-16 flex flex-wrap gap-2\">\n                                  {resume.metaData\n                                    .filter((m) => m.referenceId === work.Id)\n                                    .map((m) => (\n                                      <MetaBadge key={m.id} meta={m} />\n                                    ))}\n                                </div>\n                              )}\n                            </div>\n                          ))}\n                      </div>\n                    </CardContent>\n                  </Card>\n                </section>\n              )}\n\n            {/* Education Timeline */}\n            {resume?.data?.Education &&\n              resume.data.Education.length > 0 && (\n                <>\n                <section>\n                  <div className=\"flex items-center gap-3 mb-8\">\n                    <div className=\"w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center\">\n                      <GraduationCap className=\"w-5 h-5 text-primary\" />\n                    </div>\n                    <h2 className=\"text-3xl font-bold\">Education</h2>\n                  </div>\n\n                  <Card>\n                    <CardContent className=\"p-6\">\n                      <div className=\"space-y-4\">\n                        {resume.data.Education\n                          .sort(\n                            (a, b) =>\n                              new Date(b.StartDate || \"\").getTime() -\n                              new Date(a.StartDate || \"\").getTime(),\n                          )\n                          .map((edu, index) => (\n                            <div key={index}>\n                              <TimelineItem\n                                title={`${edu.StudyType || \"\"} in ${edu.Area || \"\"}`}\n                                subtitle={edu.Institution || \"\"}\n                                startDate={edu.StartDate || \"\"}\n                                endDate={edu.EndDate || \"\"}\n                                description={\n                                  edu.Score ? `GPA: ${edu.Score}` : undefined\n                                }\n                                icon={GraduationCap}\n                                isLast={index === resume.data.Education.length - 1}\n                              />\n                              {resume.metaData && edu.Id && (\n                                <div className=\"mt-2 ml-16 flex flex-wrap gap-2\">\n                                  {resume.metaData\n                                    .filter((m) => m.referenceId === edu.Id)\n                                    .map((m) => (\n                                      <MetaBadge key={m.id} meta={m} />\n                                    ))}\n                                </div>\n                              )}\n                            </div>\n                          ))}\n                      </div>\n                    </CardContent>\n                  </Card>\n                </section>\n\n\t                      {/* Metadata for Education entries */}\n\t                      {resume.metaData && (\n\t                        <div className=\"mt-2\">\n\t                          {resume.data.Education.map((edu, eidx) => (\n\t                            edu.Id ? (\n\t                              <div key={eidx} className=\"mt-2\">\n\t                                <div className=\"flex flex-wrap gap-2\">\n\t                                  {resume.metaData\n\t                                    .filter((m) => m.referenceId === edu.Id)\n\t                                    .map((m) => (\n\t                                      <MetaBadge key={m.id} meta={m} />\n\t                                    ))}\n\t                                </div>\n\t                              </div>\n\t                            ) : null\n\t                          ))}\n\t                        </div>\n\t                      )}\n\n                </>\n              )}\n\n            {/* Volunteer Experience Timeline */}\n            {resume?.data?.Volunteer &&\n              resume.data.Volunteer.length > 0 && (\n                <section>\n                  <div className=\"flex items-center gap-3 mb-8\">\n                    <div className=\"w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center\">\n                      <Heart className=\"w-5 h-5 text-primary\" />\n                    </div>\n                    <h2 className=\"text-3xl font-bold\">Volunteer Experience</h2>\n                  </div>\n\n                  <Card>\n                    <CardContent className=\"p-6\">\n                      <div className=\"space-y-4\">\n                        {resume.data.Volunteer\n                          .sort(\n                            (a, b) =>\n                              new Date(b.StartDate || \"\").getTime() -\n                              new Date(a.StartDate || \"\").getTime(),\n                          )\n                          .map((volunteer, index) => (\n                            <div key={index}>\n                              <TimelineItem\n                                title={volunteer.Position || \"\"}\n                                subtitle={volunteer.Organization || \"\"}\n                                startDate={volunteer.StartDate || \"\"}\n                                endDate={volunteer.EndDate || \"Present\"}\n                                description={volunteer.Summary || \"\"}\n                                highlights={volunteer.Highlights || undefined}\n                                icon={Heart}\n                                isLast={index === resume.data.Volunteer.length - 1}\n                              />\n                              {resume.metaData && volunteer.Id && (\n                                <div className=\"mt-2 ml-16 flex flex-wrap gap-2\">\n                                  {resume.metaData\n                                    .filter((m) => m.referenceId === volunteer.Id)\n                                    .map((m) => (\n                                      <MetaBadge key={m.id} meta={m} />\n                                    ))}\n                                </div>\n                              )}\n                            </div>\n                          ))}\n                      </div>\n                    </CardContent>\n                  </Card>\n                </section>\n              )}\n\n            {/* Skills */}\n            {resume?.data?.Skills && resume.data.Skills.length > 0 && (\n              <section>\n                <div className=\"flex items-center gap-3 mb-8\">\n                  <div className=\"w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center\">\n                    <Star className=\"w-5 h-5 text-primary\" />\n                  </div>\n                  <h2 className=\"text-3xl font-bold\">Skills</h2>\n                </div>\n\n                <Card>\n                  <CardContent className=\"p-6\">\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n                      {resume.data.Skills.map((skill, index) => (\n                        <div key={index} className=\"p-4 border rounded-lg\">\n                          <h3 className=\"font-semibold text-lg mb-2\">\n                            {skill.Name}\n                          </h3>\n                          {skill.Level && (\n                            <p className=\"text-sm text-muted-foreground mb-2\">\n                              Level: {skill.Level}\n                            </p>\n                          )}\n                          {skill.Keywords && skill.Keywords.length > 0 && (\n                            <div className=\"flex flex-wrap gap-1\">\n                              {skill.Keywords.map((keyword, keywordIndex) => (\n                                <span\n                                  key={keywordIndex}\n                                  className=\"px-2 py-1 bg-secondary text-secondary-foreground text-xs rounded\"\n                                >\n                                  {keyword}\n\n\t                {/* Metadata for Volunteer entries */}\n\t                {resume.metaData && (\n\t                  <div className=\"mt-2\">\n\t                    {resume.data.Volunteer.map((vol, vidx) => (\n\t                      vol.Id ? (\n\t                        <div key={vidx} className=\"mt-2\">\n\t                          <div className=\"flex flex-wrap gap-2\">\n\t                            {resume.metaData\n\t                              .filter((m) => m.referenceId === vol.Id)\n\t                              .map((m) => (\n\t                                <MetaBadge key={m.id} meta={m} />\n\t                              ))}\n\t                          </div>\n\t                        </div>\n\t                      ) : null\n\t                    ))}\n\t                  </div>\n\t                )}\n\n                                </span>\n                              ))}\n                            </div>\n                          )}\n                        </div>\n                      ))}\n                    </div>\n                  </CardContent>\n                </Card>\n              </section>\n            )}\n\n            {/* Languages */}\n            {resume?.data?.Languages && resume.data.Languages.length > 0 && (\n              <section>\n                <div className=\"flex items-center gap-3 mb-8\">\n                  <div className=\"w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center\">\n                    <Languages className=\"w-5 h-5 text-primary\" />\n                  </div>\n                  <h2 className=\"text-3xl font-bold\">Languages</h2>\n                </div>\n\n\n\t                {/* Metadata for Skills */}\n\t                {resume.metaData && (\n\t                  <div className=\"mt-2\">\n\t                    {resume.data.Skills.map((skill, sidx) => (\n\t                      skill.Id ? (\n\t                        <div key={sidx} className=\"mt-2\">\n\t                          <div className=\"flex flex-wrap gap-2\">\n\t                            {resume.metaData\n\t                              .filter((m) => m.referenceId === skill.Id)\n\t                              .map((m) => (\n\t                                <MetaBadge key={m.id} meta={m} />\n\t                              ))}\n\t                          </div>\n\t                        </div>\n\t                      ) : null\n\t                    ))}\n\t                  </div>\n\t                )}\n\n                <Card>\n                  <CardContent className=\"p-6\">\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n                      {resume.data.Languages.map((language, index) => (\n                        <div key={index} className=\"p-4 border rounded-lg\">\n                          <h3 className=\"font-semibold text-lg\">\n                            {language.Language}\n                          </h3>\n                          {language.Fluency && (\n                            <p className=\"text-sm text-muted-foreground\">\n                              {language.Fluency}\n                            </p>\n                          )}\n                        </div>\n\n                      ))}\n                    </div>\n                  </CardContent>\n                </Card>\n              </section>\n            )}\n\n            {/* Projects */}\n            {resume?.data?.Projects && resume.data.Projects.length > 0 && (\n              <section>\n                <div className=\"flex items-center gap-3 mb-8\">\n                  <div className=\"w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center\">\n                    <FolderOpen className=\"w-5 h-5 text-primary\" />\n                  </div>\n                  <h2 className=\"text-3xl font-bold\">Projects</h2>\n                </div>\n\n                <Card>\n                  <CardContent className=\"p-6\">\n                    <div className=\"space-y-6\">\n                      {resume.data.Projects.map((project, index) => (\n                        <div key={index} className=\"border-b pb-6 last:border-b-0 last:pb-0\">\n                          <div className=\"flex justify-between items-start mb-2\">\n                            <h3 className=\"font-semibold text-lg\">\n                              {project.Name}\n                            </h3>\n                            {project.Url && (\n                              <a\n                                href={project.Url}\n                                target=\"_blank\"\n                                rel=\"noopener noreferrer\"\n                                className=\"text-primary hover:underline flex items-center gap-1\"\n                              >\n                                <ExternalLink className=\"w-4 h-4\" />\n                              </a>\n                            )}\n                          </div>\n\n                          {(project.StartDate || project.EndDate) && (\n                            <p className=\"text-sm text-muted-foreground mb-2\">\n                              {project.StartDate} - {project.EndDate || \"Present\"}\n                            </p>\n                          )}\n\n                          {project.Entity && (\n                            <p className=\"text-sm text-muted-foreground mb-2\">\n                              {project.Entity}\n                            </p>\n                          )}\n\n                          {project.Description && (\n                            <p className=\"text-sm mb-3\">{project.Description}</p>\n                          )}\n\n                          {project.Highlights && project.Highlights.length > 0 && (\n                            <ul className=\"list-disc list-inside text-sm mb-3 space-y-1\">\n                              {project.Highlights.map((highlight, highlightIndex) => (\n                                <li key={highlightIndex}>{highlight}</li>\n                              ))}\n                            </ul>\n                          )}\n\n\t                          {resume.metaData && project.Id && (\n\t                            <div className=\"mt-2 flex flex-wrap gap-2\">\n\t                              {resume.metaData\n\t                                .filter((m) => m.referenceId === project.Id)\n\t                                .map((m) => (\n\t                                  <MetaBadge key={m.id} meta={m} />\n\t                                ))}\n\t                            </div>\n\t                          )}\n\n\n                          {project.Keywords && project.Keywords.length > 0 && (\n                            <div className=\"flex flex-wrap gap-1\">\n                              {project.Keywords.map((keyword, keywordIndex) => (\n                                <span\n                                  key={keywordIndex}\n                                  className=\"px-2 py-1 bg-secondary text-secondary-foreground text-xs rounded\"\n                                >\n                                  {keyword}\n                                </span>\n                              ))}\n                            </div>\n                          )}\n                        </div>\n                      ))}\n                    </div>\n                  </CardContent>\n                </Card>\n              </section>\n            )}\n\n            {/* Awards */}\n            {resume?.data?.Awards && resume.data.Awards.length > 0 && (\n              <section>\n                <div className=\"flex items-center gap-3 mb-8\">\n                  <div className=\"w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center\">\n                    <Trophy className=\"w-5 h-5 text-primary\" />\n                  </div>\n                  <h2 className=\"text-3xl font-bold\">Awards</h2>\n                </div>\n\n                <Card>\n                  <CardContent className=\"p-6\">\n                    <div className=\"space-y-4\">\n                      {resume.data.Awards.map((award, index) => (\n                        <div key={index} className=\"border-b pb-4 last:border-b-0 last:pb-0\">\n                          <h3 className=\"font-semibold text-lg\">{award.Title}</h3>\n                          <div className=\"flex items-center gap-4 text-sm text-muted-foreground mb-2\">\n                            {award.Awarder && <span>{award.Awarder}</span>}\n                            {award.Date && (\n                              <span className=\"flex items-center gap-1\">\n                                <Calendar className=\"w-4 h-4\" />\n                                {award.Date}\n                              </span>\n                            )}\n                          </div>\n                          {award.Summary && (\n                            <p className=\"text-sm\">{award.Summary}</p>\n                          )}\n                        </div>\n                      ))}\n                    </div>\n                  </CardContent>\n                </Card>\n              </section>\n            )}\n\n            {/* Certificates */}\n            {resume?.data?.Certificates && resume.data.Certificates.length > 0 && (\n              <section>\n                <div className=\"flex items-center gap-3 mb-8\">\n                  <div className=\"w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center\">\n                    <Award className=\"w-5 h-5 text-primary\" />\n                  </div>\n                  <h2 className=\"text-3xl font-bold\">Certificates</h2>\n                </div>\n\n                <Card>\n                  <CardContent className=\"p-6\">\n                    <div className=\"space-y-4\">\n                      {resume.data.Certificates.map((certificate, index) => (\n                        <div key={index} className=\"border-b pb-4 last:border-b-0 last:pb-0\">\n                          <div className=\"flex justify-between items-start mb-2\">\n                            <h3 className=\"font-semibold text-lg\">{certificate.Name}</h3>\n                            {certificate.Url && (\n                              <a\n                                href={certificate.Url}\n                                target=\"_blank\"\n                                rel=\"noopener noreferrer\"\n                                className=\"text-primary hover:underline flex items-center gap-1\"\n                              >\n                                <ExternalLink className=\"w-4 h-4\" />\n                              </a>\n                            )}\n                          </div>\n                          <div className=\"flex items-center gap-4 text-sm text-muted-foreground\">\n                            {certificate.Issuer && <span>{certificate.Issuer}</span>}\n                            {certificate.Date && (\n                              <span className=\"flex items-center gap-1\">\n                                <Calendar className=\"w-4 h-4\" />\n                                {certificate.Date}\n                              </span>\n                            )}\n                          </div>\n                        </div>\n                      ))}\n                    </div>\n                  </CardContent>\n                </Card>\n              </section>\n            )}\n\n            {/* Publications */}\n            {resume?.data?.Publications && resume.data.Publications.length > 0 && (\n              <section>\n                <div className=\"flex items-center gap-3 mb-8\">\n    