meText] = useState(\"\");\n  const [selectedResumeId, setSelectedResumeId] = useState(\"\");\n  const [summary, setSummary] = useState<string | null>(null);\n  const [isAnalyzing, setIsAnalyzing] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [showAuthOverlay, setShowAuthOverlay] = useState(false);\n\n  // Fetch user's resumes if authenticated\n  const { data: resumes } = useQuery({\n    queryKey: [\"resumes\"],\n    queryFn: () => resumeService.getUserResumes(),\n    enabled: isAuthenticated,\n  });\n\n  const handleFileChange = (event: React.ChangeEvent<HTMLInputElement>) => {\n    const selectedFile = event.target.files?.[0];\n    if (selectedFile) {\n      // Validate file type\n      const allowedTypes = [\n        \"application/pdf\",\n        \"application/msword\",\n        \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\",\n        \"text/plain\",\n      ];\n\n      if (!allowedTypes.includes(selectedFile.type)) {\n        setError(\"Please upload a PDF, Word document, or text file.\");\n        return;\n      }\n\n      // Validate file size (10MB limit)\n      if (selectedFile.size > 10 * 1024 * 1024) {\n        setError(\"File size must be less than 10MB.\");\n        return;\n      }\n\n      setFile(selectedFile);\n      setError(null);\n      setSummary(null);\n    }\n  };\n\n  const handleTextSummarization = async () => {\n    if (!resumeText.trim()) {\n      setError(\"Please enter resume text to summarize.\");\n      return;\n    }\n\n    // Check authentication before proceeding\n    if (!isAuthenticated) {\n      setShowAuthOverlay(true);\n      return;\n    }\n\n    setIsAnalyzing(true);\n    setError(null);\n    setSummary(null);\n\n    try {\n      // Call the summarization API\n      const response = await fetch(\"/prompt/summarize\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n        },\n        body: JSON.stringify(resumeText),\n      });\n\n      if (!response.ok) {\n        throw new Error(\"Failed to summarize resume\");\n      }\n\n      const result = await response.json();\n      setSummary(result.result || result);\n    } catch (err) {\n      console.error(\"Summarization failed:\", err);\n      setError(\"Failed to summarize resume. Please try again.\");\n    } finally {\n      setIsAnalyzing(false);\n    }\n  };\n\n  const handleFileSummarization = async () => {\n    if (!file) return;\n\n    // Check authentication before proceeding\n    if (!isAuthenticated) {\n      setShowAuthOverlay(true);\n      return;\n    }\n\n    setIsAnalyzing(true);\n    setError(null);\n    setSummary(null);\n\n    try {\n      const formData = new FormData();\n      formData.append(\"file\", file);\n\n      // First parse the file to text, then summarize\n      const parseResponse = await fetch(\"/api/resume/parse\", {\n        method: \"POST\",\n        body: formData,\n      });\n\n      if (!parseResponse.ok) {\n        throw new Error(\"Failed to parse resume file\");\n      }\n\n      const parseResult = await parseResponse.json();\n      const resumeContent = parseResult.result || parseResult;\n\n      // Now summarize the parsed content\n      const summaryResponse = await fetch(\"/prompt/summarize\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n        },\n        body: JSON.stringify(resumeContent),\n      });\n\n      if (!summaryResponse.ok) {\n        throw new Error(\"Failed to summarize resume\");\n      }\n\n      const summaryResult = await summaryResponse.json();\n      setSummary(summaryResult.result || summaryResult);\n    } catch (err) {\n      console.error(\"File summarization failed:\", err);\n      setError(\"Failed to summarize resume file. Please try again.\");\n    } finally {\n      setIsAnalyzing(false);\n    }\n  };\n\n  const handleResumeSummarization = async () => {\n    if (!selectedResumeId) return;\n\n    // Check authentication before proceeding\n    if (!isAuthenticated) {\n      setShowAuthOverlay(true);\n      return;\n    }\n\n    setIsAnalyzing(true);\n    setError(null);\n    setSummary(null);\n\n    try {\n      const resume = await resumeService.getResumeById(selectedResumeId);\n\n      const response = await fetch(\"/prompt/summarize\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n        },\n        body: JSON.stringify(resume.data || {}),\n      });\n\n      if (!response.ok) {\n        throw new Error(\"Failed to summarize resume\");\n      }\n\n      const result = await response.json();\n      setSummary(result.result || result);\n    } catch (err) {\n      console.error(\"Resume summarization failed:\", err);\n      setError(\"Failed to summarize resume. Please try again.\");\n    } finally {\n      setIsAnalyzing(false);\n    }\n  };\n\n  const removeFile = () => {\n    setFile(null);\n    setError(null);\n    setSummary(null);\n  };\n\n  const resetAnalysis = () => {\n    setFile(null);\n    setResumeText(\"\");\n    setSelectedResumeId(\"\");\n    setError(null);\n    setSummary(null);\n  };\n\n  const getFileIcon = (file: File) => {\n    if (file.type.includes(\"pdf\")) return \"≡ƒôä\";\n    if (file.type.includes(\"word\")) return \"≡ƒô¥\";\n    if (file.type.includes(\"text\")) return \"≡ƒôä\";\n    return \"≡ƒôä\";\n  };\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className={`pt-16 ${showAuthOverlay ? \"relative\" : \"\"}`}>\n          {showAuthOverlay && (\n            <AuthOverlay\n              contentType=\"resume\"\n              title=\"Resume Summarization Tool\"\n              message=\"Sign in to access our AI-powered resume summarization tool and get instant professional summaries.\"\n            />\n          )}\n\n          <div className=\"max-w-6xl mx-auto p-6\">\n            {/* Header */}\n            <div className=\"mb-8\">\n              <div className=\"flex items-center gap-4 mb-4\">\n                <Link to=\"/tools\">\n                  <Button variant=\"outline\" size=\"sm\">\n                    <ArrowLeft className=\"h-4 w-4 mr-2\" />\n                    Back to Tools\n                  </Button>\n                </Link>\n              </div>\n\n              <div className=\"flex items-center gap-3 mb-4\">\n                <div className=\"w-12 h-12 bg-brand-green/10 rounded-lg flex items-center justify-center\">\n                  <Sparkles className=\"h-6 w-6 text-brand-green\" />\n                </div>\n                <div>\n                  <h1 className=\"text-3xl font-bold\">Resume Summarization</h1>\n                  <p className=\"text-muted-foreground\">\n                    Get AI-powered professional summaries of your resume\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            {/* Main Content */}\n            <div className=\"grid lg:grid-cols-2 gap-8\">\n              {/* Left Column - Summarization Tool */}\n              <div className=\"space-y-6\">\n                <Card>\n                  <CardHeader>\n                    <CardTitle className=\"flex items-center gap-2\">\n                      <Upload className=\"h-5 w-5\" />\n                      Summarize Resume\n                    </CardTitle>\n                  </CardHeader>\n                  <CardContent>\n                    <Tabs\n                      defaultValue={isAuthenticated ? \"existing\" : \"text\"}\n                      className=\"w-full\"\n                    >\n                      <TabsList className=\"grid w-full grid-cols-3\">\n                        <TabsTrigger value=\"text\">Paste Text</TabsTrigger>\n                        <TabsTrigger value=\"upload\">Upload File</TabsTrigger>\n                        <TabsTrigger\n                          value=\"existing\"\n                          disabled={!isAuthenticated}\n                        >\n                          My Resumes {!isAuthenticated && \"(Login Required)\"}\n                        </TabsTrigger>\n                      </TabsList>\n\n                      <TabsContent value=\"text\" className=\"space-y-4\">\n                        <div>\n                          <label className=\"text-sm font-medium mb-2 block\">\n                            Resume Text\n                          </label>\n                          <Textarea\n                            placeholder=\"Paste your resume text here...\"\n                            value={resumeText}\n                            onChange={(e) => setResumeText(e.target.value)}\n                            className=\"min-h-[200px]\"\n                          />\n                        </div>\n                        <Button\n                          onClick={handleTextSummarization}\n                          disabled={isAnalyzing || !resumeText.trim()}\n                          className=\"w-full\"\n                        >\n                          {isAnalyzing ? (\n                            <>\n                              <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" />\n                              Summarizing...\n                            </>\n                          ) : (\n                            <>\n                              <Sparkles className=\"h-4 w-4 mr-2\" />\n                              Summarize Resume\n                            </>\n                          )}\n                        </Button>\n                      </TabsContent>\n\n                      <TabsContent value=\"upload\" className=\"space-y-4\">\n                        <div>\n                          <label className=\"text-sm font-medium mb-2 block\">\n                            Upload Resume File\n                          </label>\n                          <div className=\"border-2 border-dashed border-border rounded-lg p-6 text-center\">\n                            <input\n                              type=\"file\"\n                              onChange={handleFileChange}\n                              accept=\".pdf,.doc,.docx,.txt\"\n                              className=\"hidden\"\n                              id=\"resume-upload\"\n                            />\n                            <label\n                              htmlFor=\"resume-upload\"\n                              className=\"cursor-pointer\"\n                            >\n                              <Upload className=\"h-8 w-8 mx-auto text-muted-foreground mb-2\" />\n                              <p className=\"text-sm text-muted-foreground\">\n                                Click to upload or drag and drop\n                              </p>\n                              <p className=\"text-xs text-muted-foreground mt-1\">\n                                PDF, Word, or Text files (max 10MB)\n                              </p>\n                            </label>\n                          </div>\n                        </div>\n\n                        {file && (\n                          <div className=\"flex items-center justify-between p-3 bg-muted rounded-lg\">\n                            <div className=\"flex items-center gap-2\">\n                              <span className=\"text-lg\">\n                                {getFileIcon(file)}\n                              </span>\n                              <span className=\"text-sm font-medium\">\n                                {file.name}\n                              </span>\n                            </div>\n                            <Button\n                              variant=\"ghost\"\n                              size=\"sm\"\n                              onClick={removeFile}\n                            >\n                              Remove\n                            </Button>\n                          </div>\n                        )}\n\n                        <Button\n                          onClick={handleFileSummarization}\n                          disabled={isAnalyzing || !file}\n                          className=\"w-full\"\n                        >\n                          {isAnalyzing ? (\n                            <>\n                              <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" />\n                              Summarizing...\n                            </>\n                          ) : (\n                            <>\n                              <Sparkles className=\"h-4 w-4 mr-2\" />\n                              Summarize Resume\n                            </>\n                          )}\n                        </Button>\n                      </TabsContent>\n\n                      <TabsContent value=\"existing\" className=\"space-y-4\">\n                        <div>\n                          <label className=\"text-sm font-medium mb-2 block\">\n                            Select Resume\n                          </label>\n                          <Select\n                            value={selectedResumeId}\n                            onValueChange={setSelectedResumeId}\n                          >\n                            <SelectTrigger>\n                              <SelectValue placeholder=\"Choose a resume to summarize\" />\n                            </SelectTrigger>\n                            <SelectContent>\n                              {resumes?.map((resume) => (\n                                <SelectItem\n                                  key={resume.id}\n                                  value={resume.id || \"\"}\n                                >\n                                  {resume.name || \"Untitled Resume\"}\n                                </SelectItem>\n                              ))}\n                            </SelectContent>\n                          </Select>\n                        </div>\n\n                        <Button\n                          onClick={handleResumeSummarization}\n                          disabled={isAnalyzing || !selectedResumeId}\n                          className=\"w-full\"\n                        >\n                          {isAnalyzing ? (\n                            <>\n                              <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" />\n                              Summarizing...\n                            </>\n                          ) : (\n                            <>\n                              <Sparkles className=\"h-4 w-4 mr-2\" />\n                              Summarize Resume\n                            </>\n                          )}\n                        </Button>\n                      </TabsContent>\n                    </Tabs>\n\n                    {error && (\n                      <Alert className=\"mt-4\">\n                        <AlertDescription>{error}</AlertDescription>\n                      </Alert>\n                    )}\n                  </CardContent>\n                </Card>\n              </div>\n\n              {/* Right Column - Results */}\n              <div className=\"space-y-6\">\n                {summary && (\n                  <Card>\n                    <CardHeader>\n                      <CardTitle className=\"flex items-center gap-2\">\n                        <FileText className=\"h-5 w-5\" />\n                        Resume Summary\n                      </CardTitle>\n                    </CardHeader>\n                    <CardContent>\n                      <div className=\"prose prose-sm max-w-none\">\n                        <div className=\"whitespace-pre-wrap text-sm leading-relaxed\">\n                          {summary}\n                        </div>\n                      </div>\n\n                      <div className=\"flex gap-2 mt-6\">\n                        <Button variant=\"outline\" onClick={resetAnalysis}>\n                          Summarize Another\n                        </Button>\n                        <Button\n                          onClick={() => navigator.clipboard.writeText(summary)}\n                          variant=\"outline\"\n                        >\n                          Copy Summary\n                        </Button>\n                      </div>\n                    </CardContent>\n                  </Card>\n                )}\n\n                {!summary && !isAnalyzing && (\n                  <Card>\n                    <CardContent className=\"p-8 text-center\">\n                      <Sparkles className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                      <h3 className=\"font-semibold mb-2\">Ready to Summarize</h3>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Upload a resume file, paste text, or select from your\n                        saved resumes to get started.\n                      </p>\n                    </CardContent>\n                  </Card>\n                )}\n              </div>\n            </div>\n          </div>\n          <Footer />\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\tools\\ValueProposition.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'isAuthenticated' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":58,"column":11,"nodeType":null,"messageId":"unusedVar","endLine":58,"endColumn":26},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'companyData' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":67,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":67,"endColumn":21},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":115,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":115,"endColumn":20,"suggestions":[{"fix":{"range":[3522,3581],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\nimport {\n  ArrowLeft,\n  ArrowRight,\n  FileText,\n  CheckCircle2,\n  Loader2,\n  Building2,\n} from \"lucide-react\";\nimport { Link, useLocation } from \"react-router-dom\";\nimport { useSEO } from \"@/lib/seo\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent } from \"@/components/ui/card\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport JobInputStep from \"@/components/tools/JobInputStep\";\nimport ResumeSelectionStep from \"@/components/tools/ResumeSelectionStep\";\nimport ValuePropositionResultsStep from \"@/components/tools/ValuePropositionResultsStep\";\nimport CompanyInfoStep from \"@/components/tools/CompanyInfoStep\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\nimport {\n  valuePropositionService,\n  type ValuePropositionResponse,\n} from \"@/lib/services/value-proposition-service\";\n\ntype WizardStep = \"job\" | \"resume\" | \"company\" | \"results\";\n\ninterface JobData {\n  jobId?: string;\n  jobContent?: string;\n  source: \"url\" | \"paste\" | \"file\" | \"existing\";\n}\n\ninterface ResumeData {\n  resumeId?: string;\n  resumeContent?: string;\n  source: \"existing\" | \"paste\" | \"file\";\n}\n\ninterface CompanyData {\n  name?: string;\n  mission?: string;\n  values?: string;\n}\n\nexport default function ValueProposition() {\n  const location = useLocation();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { isAuthenticated } = useAuth();\n\n  // SEO for value proposition page\n  useSEO(location.pathname);\n\n  // Wizard state\n  const [currentStep, setCurrentStep] = useState<WizardStep>(\"job\");\n  const [jobData, setJobData] = useState<JobData | null>(null);\n  const [resumeData, setResumeData] = useState<ResumeData | null>(null);\n  const [companyData, setCompanyData] = useState<CompanyData | null>(null);\n  const [valuePropositionResult, setValuePropositionResult] =\n    useState<ValuePropositionResponse | null>(null);\n\n  // Loading and error states\n  const [isGenerating, setIsGenerating] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  // Step navigation\n  const steps = [\n    { id: \"job\", title: \"Job Details\", icon: FileText },\n    { id: \"resume\", title: \"Resume\", icon: FileText },\n    { id: \"company\", title: \"Company Info\", icon: Building2 },\n    { id: \"results\", title: \"Value Proposition\", icon: CheckCircle2 },\n  ];\n\n  const currentStepIndex = steps.findIndex((step) => step.id === currentStep);\n\n  const handleJobSelected = (data: JobData) => {\n    setJobData(data);\n    setCurrentStep(\"resume\");\n    setError(null);\n  };\n\n  const handleResumeSelected = (data: ResumeData) => {\n    setResumeData(data);\n    setCurrentStep(\"company\");\n    setError(null);\n  };\n\n  const handleCompanyInfoSubmitted = async (data: CompanyData) => {\n    setCompanyData(data);\n    setError(null);\n    setIsGenerating(true);\n\n    try {\n      // Call the value proposition service with the collected data\n      const result = await valuePropositionService.generateByContent({\n        jobContent: jobData?.jobContent,\n        resumeContent: resumeData?.resumeContent,\n        companyName: data.name,\n        companyMission: data.mission,\n        companyValues: data.values,\n      });\n\n      setValuePropositionResult(result);\n      setCurrentStep(\"results\");\n    } catch (err) {\n      console.error(\"Value proposition generation failed:\", err);\n      setError(\"Failed to generate value proposition. Please try again.\");\n    } finally {\n      setIsGenerating(false);\n    }\n  };\n\n  const handleStartOver = () => {\n    setCurrentStep(\"job\");\n    setJobData(null);\n    setResumeData(null);\n    setCompanyData(null);\n    setValuePropositionResult(null);\n    setError(null);\n  };\n\n  const handleBack = () => {\n    if (currentStep === \"resume\") setCurrentStep(\"job\");\n    else if (currentStep === \"company\") setCurrentStep(\"resume\");\n    else if (currentStep === \"results\") setCurrentStep(\"company\");\n    setError(null);\n  };\n\n  return (\n    <>\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div\n        className={`min-h-screen bg-background ${sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}`}\n      >\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16 p-6\">\n          <div className=\"max-w-4xl mx-auto\">\n            {/* Header */}\n            <div className=\"mb-8\">\n              <div className=\"flex items-center gap-4 mb-4\">\n                <Link to=\"/tools\">\n                  <Button variant=\"ghost\" size=\"sm\">\n                    <ArrowLeft className=\"h-4 w-4 mr-2\" />\n                    Back to Tools\n                  </Button>\n                </Link>\n              </div>\n\n              <div className=\"flex items-center gap-3 mb-4\">\n                <div className=\"w-12 h-12 bg-gradient-to-r from-purple-100 to-blue-100 rounded-lg flex items-center justify-center\">\n                  <FileText className=\"h-6 w-6 text-purple-600\" />\n                </div>\n                <div>\n                  <h1 className=\"text-3xl font-bold\">\n                    Value Proposition Generator\n                  </h1>\n                  <p className=\"text-muted-foreground\">\n                    Create compelling value proposition letters that highlight\n                    your unique value\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            {/* Progress Steps */}\n            <div className=\"mb-8\">\n              <div className=\"flex items-center justify-between\">\n                {steps.map((step, index) => {\n                  const StepIcon = step.icon;\n                  const isActive = currentStep === step.id;\n                  const isCompleted = index < currentStepIndex;\n                  const isAccessible = index <= currentStepIndex;\n\n                  return (\n                    <div key={step.id} className=\"flex items-center\">\n                      <div\n                        className={`flex items-center gap-2 px-4 py-2 rounded-lg transition-colors ${\n                          isActive\n                            ? \"bg-primary text-primary-foreground\"\n                            : isCompleted\n                              ? \"bg-green-100 text-green-700\"\n                              : isAccessible\n                                ? \"bg-muted text-muted-foreground\"\n                                : \"bg-muted/50 text-muted-foreground/50\"\n                        }`}\n                      >\n                        <StepIcon className=\"h-4 w-4\" />\n                        <span className=\"text-sm font-medium\">\n                          {step.title}\n                        </span>\n                        {isCompleted && <CheckCircle2 className=\"h-4 w-4\" />}\n                        {isActive && isGenerating && (\n                          <Loader2 className=\"h-4 w-4 animate-spin\" />\n                        )}\n                      </div>\n                      {index < steps.length - 1 && (\n                        <ArrowRight className=\"h-4 w-4 mx-2 text-muted-foreground\" />\n                      )}\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n\n            {/* Error Alert */}\n            {error && (\n              <Alert variant=\"destructive\" className=\"mb-6\">\n                <AlertDescription>{error}</AlertDescription>\n              </Alert>\n            )}\n\n            {/* Step Content */}\n            <Card>\n              <CardContent className=\"p-6\">\n                {currentStep === \"job\" && (\n                  <JobInputStep\n                    onJobSelected={handleJobSelected}\n                    isLoading={isGenerating}\n                    error={error}\n                  />\n                )}\n\n                {currentStep === \"resume\" && (\n                  <div className=\"space-y-6\">\n                    <div className=\"flex items-center justify-between\">\n                      <h2 className=\"text-xl font-semibold\">\n                        Select Your Resume\n                      </h2>\n                      <Button variant=\"outline\" onClick={handleBack}>\n                        <ArrowLeft className=\"h-4 w-4 mr-2\" />\n                        Back\n                      </Button>\n                    </div>\n                    <ResumeSelectionStep\n                      onResumeSelected={handleResumeSelected}\n                      isLoading={isGenerating}\n                      error={error}\n                    />\n                  </div>\n                )}\n\n                {currentStep =