";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport Footer from \"@/components/Footer\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useSEO } from \"@/lib/seo\";\n// Lazy-load the heavy jobs control to avoid blocking LCP\nconst CompanyCareersControl = React.lazy(() =>\n  import(\"@/components/careers/CompanyCareersControl\").then((m) => ({\n    default: m.CompanyCareersControl,\n  }))\n);\n// Lightweight skeleton for jobs section\nfunction JobsSkeleton() {\n  return (\n    <div className=\"space-y-4 mb-12\" aria-busy=\"true\" aria-live=\"polite\">\n      <div className=\"h-8 bg-muted/60 rounded\" />\n      <div className=\"h-24 bg-muted/50 rounded\" />\n      <div className=\"h-24 bg-muted/50 rounded\" />\n      <div className=\"h-24 bg-muted/50 rounded\" />\n    </div>\n  );\n}\n\nfunction DeferredJobs() {\n  const [show, setShow] = React.useState(false);\n  useEffect(() => {\n    const run = () => setShow(true);\n    // Defer until idle or next tick to avoid blocking LCP\n    if (typeof (window as any).requestIdleCallback === \"function\") {\n      (window as any).requestIdleCallback(run);\n    } else {\n      setTimeout(run, 1);\n    }\n  }, []);\n\n  if (!show) return <JobsSkeleton />;\n  return (\n    <Suspense fallback={<JobsSkeleton />}>\n      <CompanyCareersControl\n        companyId=\"myvideoresume-company\"\n        showCompanyHeader={false}\n        showFilters={true}\n        showSearch={true}\n        viewMode=\"table\"\n        className=\"mb-12\"\n      />\n    </Suspense>\n  );\n}\n\nexport default function Careers() {\n  const location = useLocation();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n\n  // SEO for careers page\n  useSEO(location.pathname);\n\n  useEffect(() => {\n    document.title = \"Careers - Join Our Team | MyVideoResu.me\";\n\n    // Set meta description\n    const metaDescription = document.querySelector('meta[name=\"description\"]');\n    if (metaDescription) {\n      metaDescription.setAttribute(\n        \"content\",\n        \"Join MyVideoResu.me and help revolutionize how people showcase their talents. Explore our open positions and become part of our innovative team.\",\n      );\n    }\n\n    // Add additional SEO meta tags\n    const addMetaTag = (name: string, content: string, property = false) => {\n      const attribute = property ? \"property\" : \"name\";\n      let meta = document.querySelector(`meta[${attribute}=\"${name}\"]`);\n      if (!meta) {\n        meta = document.createElement(\"meta\");\n        meta.setAttribute(attribute, name);\n        document.head.appendChild(meta);\n      }\n      meta.setAttribute(\"content\", content);\n    };\n\n    // Open Graph tags\n    addMetaTag(\"og:title\", \"Careers - Join Our Team | MyVideoResu.me\", true);\n    addMetaTag(\n      \"og:description\",\n      \"Join MyVideoResu.me and help revolutionize how people showcase their talents. Explore our open positions and become part of our innovative team.\",\n      true,\n    );\n    addMetaTag(\"og:url\", \"https://myvideoresu.me/careers\", true);\n    addMetaTag(\"og:type\", \"website\", true);\n    addMetaTag(\"og:image\", \"https://myvideoresu.me/og-careers.jpg\", true);\n\n    // Twitter Card tags\n    addMetaTag(\"twitter:card\", \"summary_large_image\");\n    addMetaTag(\"twitter:title\", \"Careers - Join Our Team | MyVideoResu.me\");\n    addMetaTag(\n      \"twitter:description\",\n      \"Join MyVideoResu.me and help revolutionize how people showcase their talents. Explore our open positions.\",\n    );\n    addMetaTag(\"twitter:image\", \"https://myvideoresu.me/og-careers.jpg\");\n\n    // Additional SEO tags\n    addMetaTag(\n      \"keywords\",\n      \"careers, jobs, MyVideoResu.me, software engineer, product designer, devops, remote work, tech jobs\",\n    );\n    addMetaTag(\"robots\", \"index, follow\");\n    // Canonical is handled by useSEO/prerender; do not add invalid meta name=\"canonical\"\n\n    // Add structured data for Organization and FAQ\n    const structuredData = [\n      {\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"Organization\",\n        name: \"MyVideoResu.me\",\n        url: \"https://myvideoresu.me\",\n        logo: \"https://myvideoresu.me/favicon.svg\",\n        description:\n          \"Revolutionary video resume platform helping job seekers showcase their talents\",\n        foundingDate: \"2024\",\n        numberOfEmployees: \"50+\",\n        industry: \"Technology\",\n        address: {\n          \"@type\": \"PostalAddress\",\n          addressCountry: \"US\",\n        },\n        sameAs: [\n          \"https://linkedin.com/company/myvideoresume\",\n          \"https://twitter.com/myvideoresume\",\n        ],\n        jobPosting: {\n          \"@type\": \"JobPosting\",\n          hiringOrganization: {\n            \"@type\": \"Organization\",\n            name: \"MyVideoResu.me\",\n          },\n          jobLocation: {\n            \"@type\": \"Place\",\n            address: {\n              \"@type\": \"PostalAddress\",\n              addressCountry: \"US\",\n            },\n          },\n          employmentType: \"FULL_TIME\",\n          workHours: \"Flexible\",\n          benefits: \"Health insurance, equity, unlimited PTO, remote work\",\n        },\n      },\n      {\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"FAQPage\",\n        mainEntity: [\n          {\n            \"@type\": \"Question\",\n            name: \"Is MyVideoResu.me fully remote?\",\n            acceptedAnswer: {\n              \"@type\": \"Answer\",\n              text: \"Yes! We're a remote-first company with team members across 15+ countries. We al