nge":[11581,11584],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":9,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Performance monitoring and optimization utilities\n */\n\nimport { config, getPerformanceConfig } from \"./config\";\nimport { logger } from \"./logger\";\n\n// ============================================================================\n// TYPES AND INTERFACES\n// ============================================================================\n\nexport interface PerformanceMetric {\n  name: string;\n  value: number;\n  unit: \"ms\" | \"bytes\" | \"count\";\n  timestamp: number;\n  context?: Record<string, unknown>;\n}\n\nexport interface WebVitalsMetric {\n  name: \"CLS\" | \"FID\" | \"FCP\" | \"LCP\" | \"TTFB\";\n  value: number;\n  delta: number;\n  id: string;\n  navigationType: string;\n}\n\nexport interface ResourceTiming {\n  name: string;\n  duration: number;\n  transferSize: number;\n  encodedBodySize: number;\n  decodedBodySize: number;\n  startTime: number;\n  responseEnd: number;\n}\n\n// ============================================================================\n// PERFORMANCE MONITOR CLASS\n// ============================================================================\n\nclass PerformanceMonitor {\n  private metrics: PerformanceMetric[] = [];\n  private observers: PerformanceObserver[] = [];\n  private config = getPerformanceConfig();\n\n  constructor() {\n    if (this.config.enabled && typeof window !== \"undefined\") {\n      this.initializeObservers();\n      this.trackWebVitals();\n    }\n  }\n\n  // ============================================================================\n  // INITIALIZATION\n  // ============================================================================\n\n  private initializeObservers(): void {\n    // Navigation timing observer\n    if (\"PerformanceObserver\" in window) {\n      try {\n        const navigationObserver = new PerformanceObserver((list) => {\n          for (const entry of list.getEntries()) {\n            this.handleNavigationEntry(entry as PerformanceNavigationTiming);\n          }\n        });\n        navigationObserver.observe({ entryTypes: [\"navigation\"] });\n        this.observers.push(navigationObserver);\n      } catch (error) {\n        logger.warn(\"Failed to initialize navigation observer\", { error });\n      }\n\n      // Resource timing observer\n      try {\n        const resourceObserver = new PerformanceObserver((list) => {\n          for (const entry of list.getEntries()) {\n            this.handleResourceEntry(entry as PerformanceResourceTiming);\n          }\n        });\n        resourceObserver.observe({ entryTypes: [\"resource\"] });\n        this.observers.push(resourceObserver);\n      } catch (error) {\n        logger.warn(\"Failed to initialize resource observer\", { error });\n      }\n\n      // Long task observer\n      try {\n        const longTaskObserver = new PerformanceObserver((list) => {\n          for (const entry of list.getEntries()) {\n            this.handleLongTaskEntry(entry);\n          }\n        });\n        longTaskObserver.observe({ entryTypes: [\"longtask\"] });\n        this.observers.push(longTaskObserver);\n      } catch (error) {\n        logger.warn(\"Failed to initialize long task observer\", { error });\n      }\n    }\n  }\n\n  private trackWebVitals(): void {\n    // Import web-vitals dynamically to avoid bundle size impact\n    import(\"web-vitals\")\n      .then((webVitals) => {\n        if (webVitals.onCLS) webVitals.onCLS(this.handleWebVital.bind(this));\n        if (webVitals.onINP) webVitals.onINP(this.handleWebVital.bind(this));\n        if (webVitals.onFCP) webVitals.onFCP(this.handleWebVital.bind(this));\n        if (webVitals.onLCP) webVitals.onLCP(this.handleWebVital.bind(this));\n        if (webVitals.onTTFB) webVitals.onTTFB(this.handleWebVital.bind(this));\n      })\n      .catch((error) => {\n        logger.warn(\"Failed to load web-vitals library\", { error });\n      });\n  }\n\n  // ============================================================================\n  // EVENT HANDLERS\n  // ============================================================================\n\n  private handleNavigationEntry(entry: PerformanceNavigationTiming): void {\n    const metrics: PerformanceMetric[] = [\n      {\n        name: \"navigation.domContentLoaded\",\n        value:\n          entry.domContentLoadedEventEnd - entry.domContentLoadedEventStart,\n        unit: \"ms\",\n        timestamp: Date.now(),\n      },\n      {\n        name: \"navigation.loadComplete\",\n        value: entry.loadEventEnd - entry.loadEventStart,\n        unit: \"ms\",\n        timestamp: Date.now(),\n      },\n      {\n        name: \"navigation.domInteractive\",\n        value: entry.domInteractive - entry.fetchStart,\n        unit: \"ms\",\n        timestamp: Date.now(),\n      },\n      {\n        name: \"navigation.domComplete\",\n        value: entry.domComplete - entry.fetchStart,\n        unit: \"ms\",\n        timestamp: Date.now(),\n      },\n    ];\n\n    metrics.forEach((metric) => this.recordMetric(metric));\n  }\n\n  private handleResourceEntry(entry: PerformanceResourceTiming): void {\n    // Only track significant resources\n    if (entry.transferSize > 10000 || entry.duration > 100) {\n      const resourceTiming: ResourceTiming = {\n        name: entry.name,\n        duration: entry.duration,\n        transferSize: entry.transferSize,\n        encodedBodySize: entry.encodedBodySize,\n        decodedBodySize: entry.decodedBodySize,\n        startTime: entry.startTime,\n        responseEnd: entry.responseEnd,\n      };\n\n      this.recordMetric({\n        name: \"resource.load\",\n        value: entry.duration,\n        unit: \"ms\",\n        timestamp: Date.now(),\n        context: resourceTiming as unknown as Record<string, unknown>,\n      });\n    }\n  }\n\n  private handleLongTaskEntry(entry: PerformanceEntry): void {\n    this.recordMetric({\n      name: \"longtask.duration\",\n      value: entry.duration,\n      unit: \"ms\",\n      timestamp: Date.now(),\n      context: {\n        startTime: entry.startTime,\n        name: entry.name,\n      },\n    });\n\n    // Log warning for very long tasks\n    if (entry.duration > 100) {\n      logger.warn(\"Long task detected\", {\n        duration: entry.duration,\n        startTime: entry.startTime,\n      });\n    }\n  }\n\n  private handleWebVital(metric: WebVitalsMetric): void {\n    this.recordMetric({\n      name: `webvital.${metric.name.toLowerCase()}`,\n      value: metric.value,\n      unit: \"ms\",\n      timestamp: Date.now(),\n      context: {\n        delta: metric.delta,\n        id: metric.id,\n        navigationType: metric.navigationType,\n      },\n    });\n\n    // Log poor web vitals\n    const thresholds = {\n      CLS: 0.1,\n      FID: 100,\n      FCP: 1800,\n      LCP: 2500,\n      TTFB: 800,\n    };\n\n    if (metric.value > thresholds[metric.name]) {\n      logger.warn(`Poor ${metric.name} detected`, {\n        value: metric.value,\n        threshold: thresholds[metric.name],\n      });\n    }\n  }\n\n  // ============================================================================\n  // METRIC RECORDING\n  // ============================================================================\n\n  recordMetric(metric: PerformanceMetric): void {\n    if (!this.shouldSample()) {\n      return;\n    }\n\n    this.metrics.push(metric);\n\n    // Log performance metrics\n    logger.debug(\n      \"Performance metric recorded\",\n      metric as unknown as Record<string, unknown>,\n    );\n\n    // Keep only recent metrics to prevent memory leaks\n    if (this.metrics.length > 1000) {\n      this.metrics = this.metrics.slice(-500);\n    }\n\n    // Send to external monitoring service if configured\n    this.sendToMonitoringService(metric);\n  }\n\n  private shouldSample(): boolean {\n    return Math.random() < this.config.sampleRate;\n  }\n\n  private sendToMonitoringService(metric: PerformanceMetric): void {\n    // TODO: Integrate with external monitoring service\n    // Example: DataDog, New Relic, etc.\n\n    // For now, just log to console in development\n    if (config.NODE_ENV === \"development\") {\n      console.debug(\"Performance metric:\", metric);\n    }\n  }\n\n  // ============================================================================\n  // MANUAL TIMING\n  // ============================================================================\n\n  startTiming(name: string): () => void {\n    const startTime = performance.now();\n\n    return () => {\n      const duration = performance.now() - startTime;\n      this.recordMetric({\n        name: `timing.${name}`,\n        value: duration,\n        unit: \"ms\",\n        timestamp: Date.now(),\n      });\n    };\n  }\n\n  measureFunction<T extends (...args: any[]) => any>(name: string, fn: T): T {\n    return ((...args: Parameters<T>) => {\n      const endTiming = this.startTiming(name);\n      try {\n        const result = fn(...args);\n\n        // Handle async functions\n        if (result instanceof Promise) {\n          return result.finally(endTiming);\n        }\n\n        endTiming();\n        return result;\n      } catch (error) {\n        endTiming();\n        throw error;\n      }\n    }) as T;\n  }\n\n  measureAsyncFunction<T extends (...args: any[]) => Promise<any>>(\n    name: string,\n    fn: T,\n  ): T {\n    return (async (...args: Parameters<T>) => {\n      const endTiming = this.startTiming(name);\n      try {\n        const result = await fn(...args);\n        endTiming();\n        return result;\n      } catch (error) {\n        endTiming();\n        throw error;\n      }\n    }) as T;\n  }\n\n  // ============================================================================\n  // MEMORY MONITORING\n  // ============================================================================\n\n  recordMemoryUsage(): void {\n    if (\"memory\" in performance) {\n      const memory = (performance as any).memory;\n\n      this.recordMetric({\n        name: \"memory.used\",\n        value: memory.usedJSHeapSize,\n        unit: \"bytes\",\n        timestamp: Date.now(),\n        context: {\n          total: memory.totalJSHeapSize,\n          limit: memory.jsHeapSizeLimit,\n        },\n      });\n    }\n  }\n\n  // ============================================================================\n  // REPORTING\n  // ============================================================================\n\n  getMetrics(): PerformanceMetric[] {\n    return [...this.metrics];\n  }\n\n  getMetricsByName(name: string): PerformanceMetric[] {\n    return this.metrics.filter((metric) => metric.name === name);\n  }\n\n  getAverageMetric(name: string): number | null {\n    const metrics = this.getMetricsByName(name);\n    if (metrics.length === 0) return null;\n\n    const sum = metrics.reduce((acc, metric) => acc + metric.value, 0);\n    return sum / metrics.length;\n  }\n\n  clearMetrics(): void {\n    this.metrics = [];\n  }\n\n  // ============================================================================\n  // CLEANUP\n  // ============================================================================\n\n  destroy(): void {\n    this.observers.forEach((observer) => observer.disconnect());\n    this.observers = [];\n    this.clearMetrics();\n  }\n}\n\n// ============================================================================\n// SINGLETON INSTANCE\n// ============================================================================\n\nexport const performanceMonitor = new PerformanceMonitor();\n\n// ============================================================================\n// UTILITY FUNCTIONS\n// ============================================================================\n\n/**\n * Measure the performance of a function\n */\nexport function measure<T extends (...args: any[]) => any>(\n  name: string,\n  fn: T,\n): T {\n  return performanceMonitor.measureFunction(name, fn);\n}\n\n/**\n * Measure the performance of an async function\n */\nexport function measureAsync<T extends (...args: any[]) => Promise<any>>(\n  name: string,\n  fn: T,\n): T {\n  return performanceMonitor.measureAsyncFunction(name, fn);\n}\n\n/**\n * Start a manual timing measurement\n */\nexport function startTiming(name: string): () => void {\n  return performanceMonitor.startTiming(name);\n}\n\n/**\n * Record memory usage\n */\nexport function recordMemoryUsage(): void {\n  performanceMonitor.recordMemoryUsage();\n}\n\n/**\n * Get performance metrics\n */\nexport function getPerformanceMetrics(): PerformanceMetric[] {\n  return performanceMonitor.getMetrics();\n}\n\nexport default performanceMonitor;\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\privacy.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\role-utils.ts","messages":[{"ruleId":"no-case-declarations","severity":2,"message":"Unexpected lexical declaration in case block.","line":108,"column":7,"nodeType":"VariableDeclaration","messageId":"unexpected","endLine":108,"endColumn":47,"suggestions":[{"messageId":"addBrackets","fix":{"range":[3527,3833],"text":"{ const upperRole = roleStr.toUpperCase();\n      if (Object.values(USER_ROLES).includes(roleStr as UserRole)) {\n        return roleStr as UserRole;\n      }\n      if (Object.values(USER_ROLES).includes(upperRole as UserRole)) {\n        return upperRole as UserRole;\n      }\n      return USER_ROLES.JOB_SEEKER; }"},"desc":"Add {} brackets around the case block."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Centralized Role Utilities\n *\n * This module provides a single source of truth for all role-related functionality\n * across the frontend application. It handles conversion between backend enum values\n * and frontend string representations, provides consistent role display labels,\n * and centralizes role-based permission logic.\n */\n\nimport { USER_ROLES, type UserRole } from \"@shared/user-roles\";\n\n// Backend enum values from MyVideoResumeRoles\nexport const BACKEND_ROLE_VALUES = {\n  JOB_SEEKER: 30,\n  RECRUITER: 40,\n  EMPLOYER: 20,\n  AFFILIATE: 50,\n  ADMIN: 0,\n  SUPER_ADMIN: -1,\n} as const;\n\n// Role display labels - single source of truth\nexport const ROLE_DISPLAY_LABELS = {\n  [USER_ROLES.JOB_SEEKER]: \"Job Seeker\",\n  [USER_ROLES.RECRUITER]: \"Recruiter\",\n  [USER_ROLES.EMPLOYER]: \"Employer\",\n  [USER_ROLES.AFFILIATE]: \"Affiliate\",\n  [USER_ROLES.ADMIN]: \"Administrator\",\n  [USER_ROLES.SUPER_ADMIN]: \"Super Administrator\",\n} as const;\n\n// Role descriptions for dropdowns and forms\nexport const ROLE_DESCRIPTIONS = {\n  [USER_ROLES.JOB_SEEKER]: \"Looking for job opportunities\",\n  [USER_ROLES.RECRUITER]: \"Recruiting talent for companies\",\n  [USER_ROLES.EMPLOYER]: \"Managing company and hiring\",\n  [USER_ROLES.AFFILIATE]: \"Partner or affiliate marketer\",\n  [USER_ROLES.ADMIN]: \"System administration\",\n  [USER_ROLES.SUPER_ADMIN]: \"Full system control and product management\",\n} as const;\n\n// Dashboard type constants - single source of truth\nexport const DASHBOARD_TYPES = {\n  JOB_SEEKER: \"jobseeker\",\n  RECRUITER: \"recruiter\",\n  EMPLOYER: \"employer\",\n  ADMIN: \"admin\",\n  SUPER_ADMIN: \"admin\", // SuperAdmin uses admin dashboard\n  DEFAULT: \"default\",\n} as const;\n\nexport type DashboardType =\n  (typeof DASHBOARD_TYPES)[keyof typeof DASHBOARD_TYPES];\n\n/**\n * Converts any role value (numeric, string, or mixed) to the standard UserRole format\n * Handles backend enum integers, various string formats, and edge cases\n */\nexport function normalizeRole(\n  role: string | number | undefined | null,\n): UserRole {\n  if (!role && role !== 0) return USER_ROLES.JOB_SEEKER;\n\n  // Handle numeric role values from MyVideoResumeRoles enum\n  if (typeof role === \"number\" || !isNaN(Number(role))) {\n    const numericRole = Number(role);\n    switch (numericRole) {\n      case BACKEND_ROLE_VALUES.JOB_SEEKER: // 30\n        return USER_ROLES.JOB_SEEKER;\n      case BACKEND_ROLE_VALUES.RECRUITER: // 40\n        return USER_ROLES.RECRUITER;\n      case BACKEND_ROLE_VALUES.EMPLOYER: // 20\n        return USER_ROLES.EMPLOYER;\n      case BACKEND_ROLE_VALUES.AFFILIATE: // 50\n        return USER_ROLES.AFFILIATE;\n      case BACKEND_ROLE_VALUES.ADMIN: // 0\n        return USER_ROLES.ADMIN;\n      case BACKEND_ROLE_VALUES.SUPER_ADMIN: // -1\n        return USER_ROLES.SUPER_ADMIN;\n      default:\n        return USER_ROLES.JOB_SEEKER;\n    }\n  }\n\n  // Handle string role values (case-insensitive)\n  const roleStr = String(role).toLowerCase().trim();\n  switch (roleStr) {\n    case \"jobseeker\":\n    case \"job_seeker\":\n    case \"job seeker\":\n      return USER_ROLES.JOB_SEEKER;\n    case \"recruiter\":\n      return USER_ROLES.RECRUITER;\n    case \"employer\":\n    case \"business\": // Legacy role, maps to Employer\n      return USER_ROLES.EMPLOYER;\n    case \"affiliate\":\n      return USER_ROLES.AFFILIATE;\n    case \"admin\":\n    case \"administrator\":\n      return USER_ROLES.ADMIN;\n    case \"superadmin\":\n    case \"super_admin\":\n    case \"super admin\":\n      return USER_ROLES.SUPER_ADMIN;\n    default:\n      // Try exact match with USER_ROLES values\n      const upperRole = roleStr.toUpperCase();\n      if (Object.values(USER_ROLES).includes(roleStr as UserRole)) {\n        return roleStr as UserRole;\n      }\n      if (Object.values(USER_ROLES).includes(upperRole as UserRole)) {\n        return upperRole as UserRole;\n      }\n      return USER_ROLES.JOB_SEEKER;\n  }\n}\n\n/**\n * Gets the display label for a role\n * Handles any role format and returns consistent display text\n */\nexport function getRoleDisplayLabel(\n  role: string | number | undefined | null,\n): string {\n  const normalizedRole = normalizeRole(role);\n  return (\n    ROLE_DISPLAY_LABELS[normalizedRole] ||\n    ROLE_DISPLAY_LABELS[USER_ROLES.JOB_SEEKER]\n  );\n}\n\n/**\n * Gets the description for a role\n */\nexport function getRoleDescription(\n  role: string | number | undefined | null,\n): string {\n  const normalizedRole = normalizeRole(role);\n  return (\n    ROLE_DESCRIPTIONS[normalizedRole] ||\n    ROLE_DESCRIPTIONS[USER_ROLES.JOB_SEEKER]\n  );\n}\n\n/**\n * Converts a role to the format expected by form selects\n * Always returns a valid USER_ROLES constant\n */\nexport function roleToSelectValue(\n  role: string | number | undefined | null,\n): UserRole {\n  return normalizeRole(role);\n}\n\n/**\n * Formats role for display in UI components (badges, labels, etc.)\n * Handles underscores and capitalization\n */\nexport function formatRoleForDisplay(\n  role: string | number | undefined | null,\n): string {\n  const label = getRoleDisplayLabel(role);\n  return label;\n}\n\n/**\n * Role-based permission checks\n */\nexport class RolePermissions {\n  private role: UserRole;\n\n  constructor(role: string | number | undefined | null) {\n    this.role = normalizeRole(role);\n  }\n\n  // Basic role checks\n  get isJobSeeker(): boolean {\n    return this.role === USER_ROLES.JOB_SEEKER;\n  }\n\n  get isRecruiter(): boolean {\n    return this.role === USER_ROLES.RECRUITER;\n  }\n\n  get isEmployer(): boolean {\n    return this.role === USER_ROLES.EMPLOYER;\n  }\n\n  get isAdmin(): boolean {\n    return this.role === USER_ROLES.ADMIN;\n  }\n\n  get isSuperAdmin(): boolean {\n    return this.role === USER_ROLES.SUPER_ADMIN;\n  }\n\n  // Permission checks\n  get canManageJobs(): boolean {\n    return this.isRecruiter || this.isEmployer || this.isAdmin || this.isSuperAdmin;\n  }\n\n  get canViewResumes(): boolean {\n    return this.isRecruiter || this.isEmployer || this.isAdmin || this.isSuperAdmin;\n  }\n\n  get canCreateResume(): boolean {\n    return this.isJobSeeker;\n  }\n\n  get canManageAccount(): boolean {\n    return this.isEmployer || this.isAdmin || this.isSuperAdmin;\n  }\n\n  get canManageTeam(): boolean {\n    return this.isEmployer || this.isAdmin || this.isSuperAdmin;\n  }\n\n  get canAccessAnalytics(): boolean {\n    return this.isRecruiter || this.isEmployer || this.isAdmin || this.isSuperAdmin;\n  }\n\n  get canPostJobs(): boolean {\n    return this.isRecruiter || this.isEmployer || this.isAdmin || this.isSuperAdmin;\n  }\n\n  get canEditJobs(): boolean {\n    return this.isRecruiter || this.isEmployer || this.isAdmin || this.isSuperAdmin;\n  }\n\n  get canDeleteJobs(): boolean {\n    return this.isEmployer || this.isAdmin || this.isSuperAdmin; // More restrictive\n  }\n\n  // Dashboard access\n  get dashboardType(): DashboardType {\n    if (this.isSuperAdmin || this.isAdmin) return DASHBOARD_TYPES.ADMIN;\n    if (this.isEmployer) return DASHBOARD_TYPES.EMPLOYER;\n    if (this.isRecruiter) return DASHBOARD_TYPES.RECRUITER;\n    if (this.isJobSeeker) return DASHBOARD_TYPES.JOB_SEEKER;\n    return DASHBOARD_TYPES.DEFAULT;\n  }\n}\n\n/**\n * Convenience function to create RolePermissions instance\n */\nexport function createRolePermissions(\n  role: string | number | undefined | null,\n): RolePermissions {\n  return new RolePermissions(role);\n}\n\n/**\n * Quick permission checks without creating class instance\n */\nexport const roleUtils = {\n  isJobSeeker: (role: string | number | undefined | null): boolean =>\n    normalizeRole(role) === USER_ROLES.JOB_SEEKER,\n\n  isRecruiter: (role: string | number | undefined | null): boolean =>\n    normalizeRole(role) === USER_ROLES.RECRUITER,\n\n  isEmployer: (role: string | number | undefined | null): boolean => {\n    const normalized = normalizeRole(role);\n    return normalized === USER_ROLES.EMPLOYER;\n  },\n\n  isAdmin: (role: string | number | undefined | null): boolean =>\n    normalizeRole(role) === USER_ROLES.ADMIN,\n\n  isSuperAdmin: (role: string | number | undefined | null): boolean =>\n    normalizeRole(role) === USER_ROLES.SUPER_ADMIN,\n\n  canManageJobs: (role: string | number | undefined | null): boolean => {\n    const permissions = new RolePermissions(role);\n    return permissions.canManageJobs;\n  },\n\n  canViewResumes: (role: string | number | undefined | null): boolean => {\n    const permissions = new RolePermissions(role);\n    return permissions.canViewResumes;\n  },\n\n  getDashboardType: (\n    role: string | number | undefined | null,\n  ): DashboardType => {\n    const permissions = new RolePermissions(role);\n    return permissions.dashboardType;\n  },\n};\n\n/**\n * Role validation\n */\nexport function isValidRole(role: string | number | undefined | null): boolean {\n  if (!role && role !== 0) return false;\n\n  try {\n    const normalized = normalizeRole(role);\n    return Object.values(USER_ROLES).includes(normalized);\n  } catch {\n    return false;\n  }\n}\n\n/**\n * Get all available roles for dropdowns/selects\n */\nexport function getAvailableRoles(): Array<{\n  value: UserRole;\n  label: string;\n  description: string;\n}> {\n  return [\n    {\n      value: USER_ROLES.JOB_SEEKER,\n      label: ROLE_DISPLAY_LABELS[USER_ROLES.JOB_SEEKER],\n      description: ROLE_DESCRIPTIONS[USER_ROLES.JOB_SEEKER],\n    },\n    {\n      value: USER_ROLES.RECRUITER,\n      label: ROLE_DISPLAY_LABELS[USER_ROLES.RECRUITER],\n      description: ROLE_DESCRIPTIONS[USER_ROLES.RECRUITER],\n    },\n    {\n      value: USER_ROLES.EMPLOYER,\n      label: ROLE_DISPLAY_LABELS[USER_ROLES.EMPLOYER],\n      description: ROLE_DESCRIPTIONS[USER_ROLES.EMPLOYER],\n    },\n  ];\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\runtime-config.ts","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":50,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":50,"endColumn":18,"suggestions":[{"fix":{"range":[1149,1208],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":55,"column":5,"nodeType":"MemberExpression","messageId":"unexpected","endLine":55,"endColumn":16,"suggestions":[{"fix":{"range":[1327,1381],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":135,"column":5,"nodeType":"MemberExpression","messageId":"unexpected","endLine":135,"endColumn":18,"suggestions":[{"fix":{"range":[3800,3842],"text":""},"messageId":"removeConsole","data":{"propertyName":"group"},"desc":"Remove the console.group()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":136,"column":5,"nodeType":"MemberExpression","messageId":"unexpected","endLine":136,"endColumn":16,"suggestions":[{"fix":{"range":[3848,3885],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":137,"column":5,"nodeType":"MemberExpression","messageId":"unexpected","endLine":137,"endColumn":16,"suggestions":[{"fix":{"range":[3891,3952],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":138,"column":5,"nodeType":"MemberExpression","messageId":"unexpected","endLine":138,"endColumn":16,"suggest