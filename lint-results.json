"}],"suppressions":[{"kind":"directive","justification":""}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":401,"column":3,"nodeType":"MemberExpression","messageId":"unexpected","endLine":401,"endColumn":14,"suggestions":[{"fix":{"range":[9445,9503],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Dynamic Action Generator\n *\n * Generates context-aware actions for cards based on user permissions,\n * item ownership, and business rules.\n */\n\nimport {\n  Eye,\n  Edit,\n  Trash2,\n  Settings,\n  UserPlus,\n  FileText,\n  MessageCircle,\n  Bookmark,\n  BookmarkX,\n  Share2,\n  Download,\n  Copy,\n  Play,\n  Pause,\n  BarChart3,\n  Users,\n  Building2,\n  Calendar,\n} from \"lucide-react\";\n\nimport type {\n  UserContext,\n  ItemOwnership,\n  NormalizedCardData,\n  NormalizedJobData,\n  CardInteractions,\n} from \"@/types/normalized-cards\";\n\nimport { canPerformAction } from \"@/lib/user-context\";\n\n// Enhanced CardAction interface with more properties\nexport interface DynamicCardAction {\n  id: string;\n  label: string;\n  variant?:\n    | \"default\"\n    | \"destructive\"\n    | \"outline\"\n    | \"secondary\"\n    | \"ghost\"\n    | \"link\";\n  size?: \"default\" | \"sm\" | \"lg\" | \"icon\";\n  icon?: React.ComponentType<{ className?: string }>;\n   \n  onClick: (event: React.MouseEvent) => void;\n  disabled?: boolean;\n  loading?: boolean;\n  tooltip?: string;\n  requiresConfirmation?: boolean;\n  priority?: number; // For action ordering\n}\n\n/**\n * Generate dynamic actions for job cards\n */\nexport function generateJobActions(\n  job: NormalizedCardData,\n  userContext: UserContext,\n  itemOwnership: ItemOwnership,\n  interactions: CardInteractions,\n): DynamicCardAction[] {\n  const actions: DynamicCardAction[] = [];\n\n  // View action - always available\n  actions.push({\n    id: \"view\",\n    label: \"View\",\n    variant: \"outline\",\n    icon: Eye,\n    onClick: () => interactions.onView?.(job),\n    priority: 1,\n  });\n\n  // Owner actions\n  if (canPerformAction(\"edit\", itemOwnership, userContext)) {\n    actions.push({\n      id: \"edit\",\n      label: \"Edit\",\n      icon: Edit,\n      onClick: () => interactions.onEdit?.(job.id),\n      priority: 2,\n    });\n\n    actions.push({\n      id: \"analytics\",\n      label: \"Analytics\",\n      icon: BarChart3,\n      onClick: () => handleJobAnalytics(job.id),\n      priority: 5,\n    });\n\n    // Job-specific owner actions (only for job cards)\n    if (job.type === \"job\") {\n      const jobData = job as NormalizedJobData;\n      if (jobData.status === \"active\") {\n        actions.push({\n          id: \"pause\",\n          label: \"Pause\",\n          icon: Pause,\n          onClick: () => handleJobStatusChange(job.id, \"paused\"),\n          priority: 3,\n        });\n      } else if (jobData.status === \"paused\") {\n        actions.push({\n          id: \"activate\",\n          label: \"Activate\",\n          icon: Play,\n          onClick: () => handleJobStatusChange(job.id, \"active\"),\n          priority: 3,\n        });\n      }\n    }\n\n    actions.push({\n      id: \"clone\",\n      label: \"Clone\",\n      icon: Copy,\n      onClick: () => handleJobClone(job.id),\n      priority: 4,\n    });\n  }\n\n  // Account owner actions\n  if (canPerformAction(\"assign\", itemOwnership, userContext)) {\n    actions.push({\n      id: \"assign\",\n      label: \"Assign Recruiter\",\n      icon: UserPlus,\n      onClick: () => interactions.onAssign?.(job.id),\n      priority: 3,\n    });\n\n    actions.push({\n      id: \"manage\",\n      label: \"Manage\",\n      icon: Settings,\n      onClick: () => interactions.onManage?.(job.id),\n      priority: 4,\n    });\n  }\n\n  // Recruiter actions\n  if (canPerformAction(\"review\", itemOwnership, userContext)) {\n    actions.push({\n      id: \"review\",\n      label: \"Review Applications\",\n      icon: FileText,\n      onClick: () => interactions.onReview?.(job.id),\n      priority: 2,\n    });\n\n    actions.push({\n      id: \"contact\",\n      label: \"Contact Candidates\",\n      icon: MessageCircle,\n      onClick: () => interactions.onContact?.(job.id),\n      priority: 3,\n    });\n  }\n\n  // Tracking actions\n  if (canPerformAction(\"track\", itemOwnership, userContext)) {\n    actions.push({\n      id: \"track\",\n      label: \"Track\",\n      icon: Bookmark,\n      onClick: () => interactions.onTrack?.(job.id),\n      priority: 6,\n    });\n  } else if (canPerformAction(\"untrack\", itemOwnership, userContext)) {\n    actions.push({\n      id: \"untrack\",\n      label: \"Untrack\",\n      icon: BookmarkX,\n      onClick: () => interactions.onUntrack?.(job.id),\n      priority: 6,\n    });\n  }\n\n  // Delete action - always last\n  if (canPerformAction(\"delete\", itemOwnership, userContext)) {\n    actions.push({\n      id: \"delete\",\n      label: \"Delete\",\n      variant: \"destructive\",\n      icon: Trash2,\n      onClick: () => interactions.onDelete?.(job.id),\n      requiresConfirmation: true,\n      priority: 10,\n    });\n  }\n\n  return actions.sort((a, b) => (a.priority || 0) - (b.priority || 0));\n}\n\n/**\n * Generate dynamic actions for company cards\n */\nexport function generateCompanyActions(\n  company: NormalizedCardData,\n  userContext: UserContext,\n  itemOwnership: ItemOwnership,\n  interactions: CardInteractions,\n): DynamicCardAction[] {\n  const actions: DynamicCardAction[] = [];\n\n  // View action - always available\n  actions.push({\n    id: \"view\",\n    label: \"View\",\n    variant: \"outline\",\n    icon: Eye,\n    onClick: () => interactions.onView?.(company),\n    priority: 1,\n  });\n\n  // Owner actions\n  if (canPerformAction(\"edit\", itemOwnership, userContext)) {\n    actions.push({\n      id: \"edit\",\n      label: \"Edit Profile\",\n      icon: Edit,\n      onClick: () => interactions.onEdit?.(company.id),\n      priority: 2,\n    });\n\n    actions.push({\n      id: \"team\",\n      label: \"Manage Team\",\n      icon: Users,\n      onClick: () => handleTeamManagement(company.id),\n      priority: 3,\n    });\n\n    actions.push({\n      id: \"jobs\",\n      label: \"Post Job\",\n      icon: FileText,\n      onClick: () => handleJobPosting(company.id),\n      priority: 4,\n    });\n  }\n\n  // Contact actions for recruiters\n  if (canPerformAction(\"contact\", itemOwnership, userContext)) {\n    actions.push({\n      id: \"contact\",\n      label: \"Contact\",\n      icon: MessageCircle,\n      onClick: () => interactions.onContact?.(company.id),\n      priority: 3,\n    });\n  }\n\n  // Tracking actions\n  if (canPerformAction(\"track\", itemOwnership, userContext)) {\n    actions.push({\n      id: \"follow\",\n      label: \"Follow\",\n      icon: Bookmark,\n      onClick: () => interactions.onTrack?.(company.id),\n      priority: 5,\n    });\n  } else if (canPerformAction(\"untrack\", itemOwnership, userContext)) {\n    actions.push({\n      id: \"unfollow\",\n      label: \"Unfollow\",\n      icon: BookmarkX,\n      onClick: () => interactions.onUntrack?.(company.id),\n      priority: 5,\n    });\n  }\n\n  return actions.sort((a, b) => (a.priority || 0) - (b.priority || 0));\n}\n\n/**\n * Generate dynamic actions for resume cards\n */\nexport function generateResumeActions(\n  resume: NormalizedCardData,\n  userContext: UserContext,\n  itemOwnership: ItemOwnership,\n  interactions: CardInteractions,\n): DynamicCardAction[] {\n  const actions: DynamicCardAction[] = [];\n\n  // View action - always available for public resumes\n  actions.push({\n    id: \"view\",\n    label: \"View\",\n    variant: \"outline\",\n    icon: Eye,\n    onClick: () => interactions.onView?.(resume),\n    priority: 1,\n  });\n\n  // Owner actions\n  if (canPerformAction(\"edit\", itemOwnership, userContext)) {\n    actions.push({\n      id: \"edit\",\n      label: \"Edit\",\n      icon: Edit,\n      onClick: () => interactions.onEdit?.(resume.id),\n      priority: 2,\n    });\n\n    actions.push({\n      id: \"download\",\n      label: \"Download\",\n      icon: Download,\n      onClick: () => handleResumeDownload(resume.id),\n      priority: 3,\n    });\n\n    actions.push({\n      id: \"share\",\n      label: \"Share\",\n      icon: Share2,\n      onClick: () => handleResumeShare(resume.id),\n      priority: 4,\n    });\n  }\n\n  // Recruiter actions\n  if (canPerformAction(\"review\", itemOwnership, userContext)) {\n    actions.push({\n      id: \"download\",\n      label: \"Download\",\n      icon: Download,\n      onClick: () => handleResumeDownload(resume.id),\n      priority: 2,\n    });\n\n    actions.push({\n      id: \"contact\",\n      label: \"Contact\",\n      icon: MessageCircle,\n      onClick: () => interactions.onContact?.(resume.id),\n      priority: 3,\n    });\n\n    actions.push({\n      id: \"schedule\",\n      label: \"Schedule Interview\",\n      icon: Calendar,\n      onClick: () => handleScheduleInterview(resume.id),\n      priority: 4,\n    });\n  }\n\n  return actions.sort((a, b) => (a.priority || 0) - (b.priority || 0));\n}\n\n// Action handlers (these would be implemented based on your business logic)\nfunction handleJobAnalytics(jobId: string) {\n  // eslint-disable-next-line no-console\n  console.log(\"Opening analytics for job:\", jobId);\n}\n\nfunction handleJobStatusChange(jobId: string, status: string) {\n  // eslint-disable-next-line no-console\n  console.log(\"Changing job status:\", jobId, status);\n}\n\nfunction handleJobClone(jobId: string) {\n  // eslint-disable-next-line no-console\n  console.log(\"Cloning job:\", jobId);\n}\n\nfunction handleTeamManagement(companyId: string) {\n  // eslint-disable-next-line no-console\n  console.log(\"Managing team for company:\", companyId);\n}\n\nfunction handleJobPosting(companyId: string) {\n  // eslint-disable-next-line no-console\n  console.log(\"Posting job for company:\", companyId);\n}\n\nfunction handleResumeDownload(resumeId: string) {\n  // eslint-disable-next-line no-console\n  console.log(\"Downloading resume:\", resumeId);\n}\n\nfunction handleResumeShare(resumeId: string) {\n  // eslint-disable-next-line no-console\n  console.log(\"Sharing resume:\", resumeId);\n}\n\nfunction handleScheduleInterview(resumeId: string) {\n  // eslint-disable-next-line no-console\n  console.log(\"Scheduling interview for resume:\", resumeId);\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\error-tracking.ts","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":9,"column":5,"nodeType":"MemberExpression","messageId":"unexpected","endLine":9,"endColumn":16,"suggestions":[{"fix":{"range":[285,346],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":52,"column":3,"nodeType":"MemberExpression","messageId":"unexpected","endLine":52,"endColumn":14,"suggestions":[{"fix":{"range":[1436,1521],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":56,"column":68,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":56,"endColumn":71,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1635,1638],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1635,1638],"text":"never"},"desc":"Use `never` instead, this is useful when inst