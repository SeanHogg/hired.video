d","endLine":707,"endColumn":40,"suggestions":[{"fix":{"range":[30161,30218],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":728,"column":27,"nodeType":"MemberExpression","messageId":"unexpected","endLine":728,"endColumn":40,"suggestions":[{"fix":{"range":[31259,31316],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'getVerificationStatus'. Either include it or remove the dependency array.","line":137,"column":6,"nodeType":"ArrayExpression","endLine":137,"endColumn":23,"suggestions":[{"desc":"Update the dependencies array to be: [getVerificationStatus, isAuthenticated]","fix":{"range":[4324,4341],"text":"[getVerificationStatus, isAuthenticated]"}}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":1,"fatalErrorCount":0,"warningCount":16,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  Settings as SettingsIcon,\n  User,\n  Bell,\n  Shield,\n  Palette,\n  CreditCard,\n  Download,\n  Trash2,\n  RefreshCw,\n  ArrowRight,\n  Sparkles,\n  Lock,\n  Zap,\n  Target,\n  Sliders,\n} from \"lucide-react\";\nimport { PasswordRequirementsProvider } from \"@/components/auth/PasswordRequirementsProvider\";\nimport { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Label } from \"@/components/ui/label\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { Separator } from \"@/components/ui/separator\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\nimport { getRoleDisplayLabel } from \"@/lib/role-utils\";\nimport { DeleteAccountDialog } from \"@/components/account/DeleteAccountDialog\";\nimport { settingsService, type PrivacySettings, type AccountSettings } from \"@/lib/services/settings-service\";\nimport { useToast } from \"@/components/ui/use-toast\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\n\nfunction SettingsContent() {\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { user, isAuthenticated, resendEmailVerification, getVerificationStatus } = useAuth();\n  const { toast } = useToast();\n  const [notifications, setNotifications] = useState({\n    email: true,\n    push: true,\n    marketing: false,\n    weekly: true,\n  });\n  const [privacy, setPrivacy] = useState<PrivacySettings>({\n    profileVisible: true,\n    showEmail: false,\n    showPhone: false,\n    indexable: true,\n    allowMessages: true,\n    showActivity: true,\n  });\n  const [appearance, setAppearance] = useState<AccountSettings>({\n    theme: \"system\",\n    language: \"en\",\n    timezone: \"UTC\",\n    dateFormat: \"MM/dd/yyyy\",\n  });\n  const [savingPrivacy, setSavingPrivacy] = useState(false);\n  const [deleteDialogOpen, setDeleteDialogOpen] = useState(false);\n  const [verification, setVerification] = useState<{ email?: string; emailConfirmed: boolean; isEmailVerified: boolean; sentAt?: string; sendCount?: number } | null>(null);\n  const [resendCooldown, setResendCooldown] = useState<number>(0);\n\n  useEffect(() => {\n    if (!isAuthenticated) return;\n    // Load verification status for banner\n    getVerificationStatus().then(setVerification).catch(() => setVerification(null));\n\n    // Load privacy settings from API\n    settingsService\n      .getPrivacySettings()\n      .then((p) => {\n        setPrivacy((prev) => ({\n          ...prev,\n          profileVisible: p.profileVisible,\n          indexable: p.indexable,\n          allowMessages: p.allowMessages ?? prev.allowMessages,\n          showActivity: p.showActivity ?? prev.showActivity,\n          showEmail: p.showEmail ?? prev.showEmail,\n          showPhone: p.showPhone ?? prev.showPhone,\n        }));\n      })\n      .catch((err) => {\n        console.error(\"Failed to load privacy settings\", err);\n      });\n\n    // Load notification settings from API\n    settingsService\n      .getNotificationSettings()\n      .then((n) => setNotifications({\n        email: n.email,\n        push: n.push,\n        marketing: n.marketing,\n        weekly: n.weekly,\n      }))\n      .catch((err) => {\n        console.error(\"Failed to load notification settings\", err);\n      });\n\n    // Load account (appearance) settings from API\n    settingsService\n      .getAccountSettings()\n      .then((a) => setAppearance((prev) => ({\n        ...prev,\n        theme: a.theme ?? prev.theme,\n        language: a.language ?? prev.language,\n        timezone: a.timezone ?? prev.timezone,\n        dateFormat: a.dateFormat ?? prev.dateFormat,\n      })))\n      .catch((err) => {\n        console.error(\"Failed to load account settings\", err);\n      });\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [isAuthenticated]);\n\n\n\n  const savePrivacyPatch = async (patch: Partial<PrivacySettings>) => {\n    try {\n      setSavingPrivacy(true);\n      // Merge patch into local state first for responsive UI\n      const merged: PrivacySettings = { ...privacy, ...patch };\n      setPrivacy(merged);\n\n      // Persist only the fields supported by backend\n      const updated = await settingsService.updatePrivacySettings({\n        profileVisible: merged.profileVisible,\n        indexable: merged.indexable,\n        allowMessages: merged.allowMessages,\n        showActivity: merged.showActivity,\n      });\n\n      // Reflect backend-confirmed values; keep other local-only flags\n      setPrivacy((prev) => ({ ...prev, ...updated }));\n    } catch (error) {\n      console.error(\"Failed to save privacy settings\", error);\n      toast({ title: \"Failed to save privacy settings\", variant: \"destructive\" });\n    } finally {\n      setSavingPrivacy(false);\n    }\n  };\n\n  // If user is not authenticated, show marketing page\n  if (!isAuthenticated || !user) {\n    return (\n      <div className=\"min-h-screen bg-gradient-to-br from-background via-brand-purple/5 to-brand-blue/5\">\n        <Sidebar\n          isOpen={sidebarOpen}\n          onClose={closeSidebar}\n          collapsed={sidebarCollapsed}\n        />\n        <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n          <Navigation\n            onMenuClick={openSidebar}\n            onSidebarToggle={toggleSidebar}\n            sidebarCollapsed={sidebarCollapsed}\n          />\n\n          <div className=\"pt-16\">\n            <div className=\"max-w-6xl mx-auto px-4 py-16\">\n              {/* Hero Section */}\n              <div className=\"text-center mb-16\">\n                <div className=\"inline-flex items-center space-x-2 mb-6\">\n                  <div className=\"relative\">\n                    <SettingsIcon className=\"h-12 w-12 text-primary\" />\n                    <Sparkles className=\"h-6 w-6 text-brand-blue absolute -top-1 -right-1\" />\n                  </div>\n                  <span className=\"text-4xl font-bold bg-gradient-to-r from-brand-purple to-brand-blue bg-clip-text text-transparent\">\n                    Smart Settings\n                  </span>\n                </div>