\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\__tests__\\resume-service.test.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":54,"column":39,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":54,"endColumn":42,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1624,1627],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1624,1627],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, it, expect, vi, beforeEach } from 'vitest';\nimport { resumeService, type ResumeWithOwnership, type MasterResumeGroup } from '@/lib/services/resume-service';\nimport * as apiClientModule from '@/lib/api-client';\n\n// Minimal helper to build MasterResumeGroup\nconst mkGroup = (id: string, opts?: Partial<MasterResumeGroup['masterResume']>) => ({\n  masterResume: {\n    id,\n    userId: 'u1',\n    name: `Master ${id}`,\n    slug: `master-${id}`,\n    description: null,\n    isPrimaryDefault: false,\n    sentimentScore: 0,\n    isWatched: false,\n    privacy_ShowResume: 10,\n    privacy_ShowContactDetails: 10,\n    industry: 0,\n    employmentType: [],\n    paySchedule: 0,\n    minimumSalary: 0,\n    resumeType: 0,\n    resumeSerialized: JSON.stringify({ Basics: { Summary: `Summary ${id}` }, basics: { summary: `Summary ${id}` } }),\n    createdAt: new Date().toISOString(),\n    updatedAt: new Date().toISOString(),\n    views: 1,\n    isMaster: true,\n    isActive: false,\n    parentId: null,\n    creationDateTime: new Date().toISOString(),\n    updateDateTime: new Date().toISOString(),\n    metaResume: { basics: { name: `Name ${id}`, label: `Label ${id}` } },\n    ...opts,\n  },\n  variations: [],\n});\n\nvi.mock('@/lib/api-client', async () => {\n  const actual = await vi.importActual<typeof apiClientModule>('@@/lib/api-client');\n  return {\n    ...actual,\n    apiClient: {\n      get: vi.fn(),\n      post: vi.fn(),\n      put: vi.fn(),\n      delete: vi.fn(),\n      request: vi.fn(),\n      getRaw: vi.fn(),\n      requestRaw: vi.fn(),\n    },\n  } as unknown as typeof apiClientModule;\n});\n\nconst apiClient = (apiClientModule as any).apiClient as {\n  get: ReturnType<typeof vi.fn>;\n  post: ReturnType<typeof vi.fn>;\n};\n\ndescribe('resumeService.getResumesForDisplay', () => {\n  beforeEach(() => {\n    vi.clearAllMocks();\n  });\n\n  it('returns owned/withOwnership when available', async () => {\n    const owned: ResumeWithOwnership[] = [\n      {\n        id: 'r1', slug: 'r1', name: 'R1', privacy: 'private', isMaster: true, isActive: false, parentId: undefined,\n        createdAt: new Date().toISOString(), updatedAt: new Date().toISOString(), views: 0, summary: 'S', title: 'T', userId: 'u1', ownership: 'owned',\n      },\n    ];\n\n    // withOwnership endpoint\n    apiClient.get.mockResolvedValueOnce({ data: owned });\n    // masterGroups endpoint (unused because owned exists)\n    apiClient.get.mockResolvedValueOnce({ data: [mkGroup('m1')] });\n\n    const result = await resumeService.getResumesForDisplay();\n    expect(result).toEqual(owned);\n  });\n\n  it('falls back to flattening master groups when withOwnership is empty', async () => {\n    // withOwnership empty\n    apiClient.get.mockResolvedValueOnce({ data: [] });\n    // masterGroups\n    apiClient.get.mockResolvedValueOnce({ data: [mkGroup('m1')] });\n\n    const result = await resumeService.getResumesForDisplay();\n    expect(result).toHaveLength(1);\n    expect(result[0]).toMatchObject({ id: 'm1', ownership: 'owned', summary: expect.stringContaining('Summary') });\n  });\n});\n\ndescribe('resumeService.setResumePrivacy', () => {\n  beforeEach(() => vi.clearAllMocks());\n\n  it('POSTs to backend and returns true', async () => {\n    apiClient.post.mockResolvedValueOnce({ data: true });\n    const ok = await resumeService.setResumePrivacy('r1', 'public');\n    expect(ok).toBe(true);\n    expect(apiClient.post).toHaveBeenCalledWith('/api/Resume/r1/setPrivacy', { privacy: 'public' }, expect.anything());\n  });\n});\n\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\ai-context.tsx","messages":[{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":61,"column":17,"nodeType":"Identifier","messageId":"namedExport","endLine":61,"endColumn":22}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { createContext, useContext, useState } from \"react\";\n\n// Generic payload that pages/components can pass to the AI side panel\nexport interface AIContextTarget {\n  type: \"form-field\" | \"section\" | \"none\";\n  formId?: string; // page/form identifier, e.g. \"jobs.create\"\n  field?: string; // when type === \"form-field\", the field key to populate\n}\n\nexport interface AIContextPayload<TMeta = unknown> {\n  // Where this request originates from, e.g. \"jobs.create\"\n  source: string;\n  // The specific task the AI should perform, e.g. \"generate_job_description\"\n  task: string;\n  // Optional human-friendly hint for UI display\n  hint?: string;\n  // Where results should be applied\n  target?: AIContextTarget;\n  // Arbitrary metadata (strongly typed by caller via generic) such as form values\n  meta?: TMeta;\n}\n\ninterface AIContextType {\n  isAIChatOpen: boolean;\n  currentContext?: AIContextPayload;\n  openAIChat: () => void;\n  // Open and set context in one call (preferred)\n  openAIWithContext: <TMeta = unknown>(payload: AIContextPayload<TMeta>) => void;\n  closeAIChat: () => void;\n  toggleAIChat: () => void;\n}\n\nconst AIContext = createContext<AIContextType | undefined>(undefined);\n\nexport function AIProvider({ children }: { children: React.ReactNode }) {\n  const [isAIChatOpen, setIsAIChatOpen] = useState(false);\n  const [currentContext, setCurrentContext] = useState<AIContextPayload | undefined>(\n    undefined,\n  );\n\n  const openAIChat = () => setIsAIChatOpen(true);\n  const closeAIChat = () => setIsAIChatOpen(false);\n  const toggleAIChat = () => setIsAIChatOpen(!isAIChatOpen);\n  const openAIWithContext = <TMeta,>(payload: AIContextPayload<TMeta>) => {\n    setCurrentContext(payload as AIContextPayload);\n    setIsAIChatOpen(true);\n  };\n\n  const value: AIContextType = {\n    isAIChatOpen,\n    currentContext,\n    openAIChat,\n    openAIWithContext,\n    closeAIChat,\n    toggleAIChat,\n  };\n\n  return <AIContext.Provider value={value}>{children}</AIContext.Provider>;\n}\n\nexport function useAI() {\n  const context = useContext(AIContext);\n  if (context === undefined) {\n    throw new Error(\"useAI must be used within an AIProvider\");\n  }\n  return context;\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\api-client.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'ApiResponse' is defined but never used. Allowed unused vars must match /^_/u.","line":7,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":7,"endColumn":14},{"ruleId":"no-duplicate-imports","severity":1,"message":"'@shared/api' import is duplicated.","line":11,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":17,"endColumn":22},{"ruleId":"no-duplicate-imports","severity":1,"message":"'./errors' import is duplicated.","line":19,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine"