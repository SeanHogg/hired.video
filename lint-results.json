nusedVar","endLine":111,"endColumn":21},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":112,"column":11,"nodeType":"MemberExpression","messageId":"unexpected","endLine":112,"endColumn":22,"suggestions":[{"fix":{"range":[3817,3883],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":116,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":116,"endColumn":20,"suggestions":[{"fix":{"range":[3928,3977],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'handleShare' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":123,"column":9,"nodeType":null,"messageId":"unusedVar","endLine":123,"endColumn":20},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'getShareUrl' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":127,"column":9,"nodeType":null,"messageId":"unusedVar","endLine":127,"endColumn":20}],"suppressedMessages":[],"errorCount":12,"fatalErrorCount":0,"warningCount":9,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { useParams } from \"react-router-dom\";\nimport { Share2, ExternalLink } from \"lucide-react\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent } from \"@/components/ui/card\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Separator } from \"@/components/ui/separator\";\nimport ShareModal from \"@/components/ShareModal\";\nimport { userService } from \"@/lib/services/user-service\";\nimport { resumeService } from \"@/lib/services/resume-service\";\nimport type { UserProfile } from \"@/lib/services/user-service\";\nimport type { Resume } from \"@/types/resume\";\nimport ResumeViewer from \"@/components/ResumeViewer\";\n\nexport default function EmbeddedResume() {\n  const { identifier } = useParams<{ identifier: string }>();\n  const [user, setUser] = useState<UserProfile | null>(null);\n  const [resume, setResume] = useState<Resume | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const [shareModalOpen, setShareModalOpen] = useState(false);\n\n  useEffect(() => {\n    if (!identifier) {\n      setError(\"No identifier provided\");\n      setLoading(false);\n      return;\n    }\n\n    loadResumeData();\n  }, [identifier]);\n\n  const loadResumeData = async () => {\n    try {\n      setLoading(true);\n      setError(null);\n\n      // Check if identifier looks like a UUID (resume ID)\n      const isUUID =\n        /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(\n          identifier,\n        );\n\n      let userData: UserProfile | null = null;\n      let resumeData: Resume | null = null;\n\n      // First attempt: use the embed endpoint which bypasses auth/privacy\n      try {\n        resumeData = await resumeService.getResumeForEmbed(identifier);\n      } catch (err) {\n        console.log(\"Embedded endpoint failed, will try fallback logic\", err);\n      }\n\n      if (!resumeData && isUUID) {\n        try {\n          resumeData = await resumeService.getResumeById(identifier);\n          if (resumeData) {\n            try {\n              userData = await userService.getUserById(resumeData.userId);\n            } catch (err) {\n              console.log(\n                \"Failed to get user from resume userId, will use resume data only\",\n              );\n            }\n          }\n        } catch (err) {\n          console.log(\"Failed to get resume by ID:\", err);\n        }\n      } else if (!resumeData) {\n        // If not a UUID and embed endpoint failed, try to derive via user slug\n        try {\n          userData = await userService.getUserBySlug(identifier);\n          if (userData) {\n            try {\n              const userResumes = await resumeService.getUserResumes();\n              const defaultResume =\n                userResumes.find(\n                  (r) => (r as any).isDefault || r.isPrimaryDefault,\n                ) || userResumes[0];\n              if (defaultResume) {\n                resumeData = await resumeService.getResumeById(\n                  defaultResume.id,\n                );\n              }\n            } catch (err) {\n              console.log(\n                \"Failed to get user resumes, will create from profile\",\n              );\n            }\n          }\n        } catch (err) {\n          console.log(\"Failed to get user by slug:\", err);\n        }\n      }\n\n      if (!resumeData) {\n        setError(\"Resume not found\");\n        setLoading(false);\n        return;\n      }\n\n      setResume(resumeData);\n\n      // If we have user data, use it; otherwise try to get it from resume\n      if (userData) {\n        setUser(userData);\n      } else if (resumeData.userId) {\n        try {\n          userData = await userService.getUserById(resumeData.userId);\n          setUser(userData);\n        } catch (err) {\n          console.log(\"Could not get user data, will use resume data only\");\n        }\n      }\n    } catch (err) {\n      console.error(\"Error loading resume data:\", err);\n      setError(\"Failed to load resume data\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleShare = () => {\n    setShareModalOpen(true);\n  };\n\n  const getShareUrl = () => {\n    return window.location.href;\n  };\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-background flex items-center justify-center\">\n        <div className=\"text-center\">\n          <div className=\"animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto mb-4\" />\n          <p className=\"text-muted-foreground\">Loading resume...</p>\n        </div>\n      </div>\n    );\n  }\n\n  if (error || !resume) {\n    return (\n      <div className=\"min-h-screen bg-background flex items-center justify-center\">\n        <div className=\"text-center\">\n          <h1 className=\"text-2xl font-bold mb-4\">Resume Not Found</h1>\n          <p className=\"text-muted-foreground mb-6\">\n            {error || \"The requested resume could not be found.\"}\n          </p>\n          <Button asChild>\n            <a\n              href=\"https://myvideoresu.me\"\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n            >\n              Create Your Own Resume\n            </a>\n          </Button>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      {/* Resume Content (uses consolidated ResumeViewer) */}\n      <div className=\"max-w-6xl mx-auto px-4 py-8\">\n        {resume ? (\n          <ResumeViewer resume={resume} onUpdate={() => {}} canEdit={false} />\n        ) : (\n          <Card>\n            <CardContent className=\"p-6 text-center\">\n              <p className=\"text-muted-foreground\">No resume data available</p>\n            </CardContent>\n          </Card>\n        )}\n      </div>\n\n      {/* Footer */}\n      <footer className=\"border-t bg-white/50 backdrop-blur-sm mt-16\">\n        <div className=\"max-w-4xl mx-auto px-4 py-6\">\n          <div className=\"flex items-center justify-center space-x-2 text-sm text-muted-foreground\">\n            <span>Powered by</span>\n            <a\n              href=\"https://myvideoresu.me\"\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"font-semibold text-primary hover:underline flex items-center space-x-1\"\n            >\n              <span>MyVideoResu.ME</span>\n              <ExternalLink className=\"w-3 h-3\" />\n            </a>\n          </div>\n        </div>\n      </footer>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\Features.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\ForRecruiters.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\ForgotPassword.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'data' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":52,"column":15,"nodeType":null,"messageId":"unusedVar","endLine":52,"endColumn":19},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'err' is defined but never used.","line":61,"column":14,"nodeType":null,"messageId":"unusedVar","endLine":61,"endColumn":17},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":92,"column":23,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[2824,2924],"text":"\n                    We&apos;ve sent password reset instructions to your email address\n                  "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[2824,2924],"text":"\n                    We&lsquo;ve sent password reset instructions to your email address\n                  "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[2824,2924],"text":"\n                    We&#39;ve sent password 