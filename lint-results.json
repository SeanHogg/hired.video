\"text-3xl font-bold mb-2\">\n                Create Company Profile\n              </h1>\n              <p className=\"text-muted-foreground\">\n                Set up your company profile to attract top talent and showcase\n                your culture\n              </p>\n            </div>\n\n            <Card>\n              <CardContent className=\"p-8 text-center\">\n                <Building2 className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                <h3 className=\"text-lg font-semibold mb-2\">\n                  Company Builder Coming Soon\n                </h3>\n                <p className=\"text-muted-foreground mb-6\">\n                  We're building a comprehensive company profile builder with\n                  guided setup, culture showcase, and team management features.\n                </p>\n                <div className=\"flex flex-col sm:flex-row gap-4 justify-center\">\n                  <Button variant=\"outline\">Request Early Access</Button>\n                  <Button asChild>\n                    <Link to=\"/companies\">View Existing Companies</Link>\n                  </Button>\n                </div>\n              </CardContent>\n            </Card>\n\n            {/* Features Preview */}\n            <div className=\"mt-8 grid md:grid-cols-2 gap-6\">\n              <Card>\n                <CardHeader>\n                  <CardTitle className=\"text-lg\">Guided Setup</CardTitle>\n                  <CardDescription>\n                    Step-by-step onboarding to create a compelling company\n                    profile\n                  </CardDescription>\n                </CardHeader>\n                <CardContent>\n                  <ul className=\"text-sm space-y-1 text-muted-foreground\">\n                    <li>ΓÇó Company information and branding</li>\n                    <li>ΓÇó Culture and values showcase</li>\n                    <li>ΓÇó Benefits and perks listing</li>\n                    <li>ΓÇó Team member management</li>\n                  </ul>\n                </CardContent>\n              </Card>\n\n              <Card>\n                <CardHeader>\n                  <CardTitle className=\"text-lg\">Instant Visibility</CardTitle>\n                  <CardDescription>\n                    Get discovered by job seekers as soon as you complete setup\n                  </CardDescription>\n                </CardHeader>\n                <CardContent>\n                  <ul className=\"text-sm space-y-1 text-muted-foreground\">\n                    <li>ΓÇó Automatic job board integration</li>\n                    <li>ΓÇó Talent pipeline building</li>\n                    <li>ΓÇó Analytics and insights</li>\n                    <li>ΓÇó Follower engagement tools</li>\n                  </ul>\n                </CardContent>\n              </Card>\n            </div>\n          </div>\n        </div>\n        <Footer />\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\CompanyDetail.tsx","messages":[{"ruleId":"no-duplicate-imports","severity":1,"message":"'@/lib/services/company-service' import is duplicated.","line":45,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":45,"endColumn":70},{"ruleId":"react-hooks/rules-of-hooks","severity":2,"message":"React Hook \"useSEO\" cannot be called inside a callback. React Hooks must be called in a React function component or a custom React Hook function.","line":99,"column":5,"nodeType":"Identifier","endLine":99,"endColumn":11},{"ruleId":"@typescript-eslint/prefer-optional-chain","severity":1,"message":"Prefer using an optional chain expression instead, as it's more concise and easier to read.","line":109,"column":18,"nodeType":null,"messageId":"preferOptionalChain","endLine":109,"endColumn":77,"suggestions":[{"fix":{"range":[3052,3111],"text":"company.data.headquarters?.city"},"messageId":"optionalChainSuggest","