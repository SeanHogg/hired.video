ggestions":[{"messageId":"suggestUnknown","fix":{"range":[2693,2696],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2693,2696],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":79,"column":9,"nodeType":"MemberExpression","messageId":"unexpected","endLine":79,"endColumn":20,"suggestions":[{"fix":{"range":[2727,2790],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":85,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":85,"endColumn":18,"suggestions":[{"fix":{"range":[2939,3002],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":88,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":88,"endColumn":20,"suggestions":[{"fix":{"range":[3093,3153],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'err' is defined but never used.","line":109,"column":14,"nodeType":null,"messageId":"unusedVar","endLine":109,"endColumn":17},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":206,"column":25,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[7420,7477],"text":"\n                      We&apos;ve sent a verification code to "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[7420,7477],"text":"\n                      We&lsquo;ve sent a verification code to "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[7420,7477],"text":"\n                      We&#39;ve sent a verification code to "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[7420,7477],"text":"\n                      We&rsquo;ve sent a verification code to "},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":247,"column":24,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[9211,9254],"text":"\n                    Don&apos;t have an account?"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[9211,9254],"text":"\n                    Don&lsquo;t have an account?"},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[9211,9254],"text":"\n                    Don&#39;t have an account?"},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[9211,9254],"text":"\n                    Don&rsquo;t have an account?"},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":10,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Video, Sparkles, Eye, EyeOff } from \"lucide-react\";\nimport { useState } from \"react\";\nimport { Link, useNavigate, useLocation } from \"react-router-dom\";\nimport { useSEO } from \"@/lib/seo\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\n\nexport default function Login() {\n  const location = useLocation();\n  const searchParams = new URLSearchParams(location.search);\n  const redirectParam = searchParams.get(\"redirect\") || \"/dashboard\";\n  const [email, setEmail] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [showPassword, setShowPassword] = useState(false);\n  const [isLoading, setIsLoading] = useState(false);\n  const [error, setError] = useState(\"\");\n\n  const [twoFactor, setTwoFactor] = useState<\n    | { requiresTwoFactor: true; email: string; expiresAt: string }\n    | null\n  >(null);\n  const [code, setCode] = useState(\"\");\n  const [isVerifying, setIsVerifying] = useState(false);\n\n  // SEO for login page\n  useSEO(location.pathname);\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n\n  const { login, verifyTwoFactor, resendTwoFactorCode } = useAuth();\n  const navigate = useNavigate();\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    console.log(\"Login.handleSubmit: Form submitted\");\n    setIsLoading(true);\n    setError(\"\");\n\n    try {\n      console.log(\"Login.handleSubmit: Calling login with\", { email });\n      const result = await login(email, password);\n      console.log(\"Login.handleSubmit: Login result:\", result);\n\n      if (result === true) {\n        console.log(\n          \"Login.handleSubmit: Login successful, navigating to dashboard\",\n        );\n        navigate(redirectParam);\n        return;\n      }\n\n      if (typeof result === \"object\" && result && (result as any).requiresEmailVerification) {\n        console.log(\"Login.handleSubmit: Email verification required, redirecting to verify page\", result);\n        const params = new URLSearchParams({ email, redirect: redirectParam });\n        navigate(`/verify-email?${params.toString()}`);\n        return;\n      }\n\n      if (typeof result === \"object\" && result && (result as any).requiresTwoFactor) {\n        console.log(\"Login.handleSubmit: Two-factor required\", result);\n        setTwoFactor(result as { requiresTwoFactor: true; email: string; expiresAt: string });\n        setError(\"\");\n        return;\n      }\n\n      console.log(\"Login.handleSubmit: Login failed, setting error\");\n      setError(\"Invalid email or password. Please try again.\");\n    } catch (err) {\n      console.error(\"Login.handleSubmit: Exception caught:\", err);\n      setError(\"An error occurred. Please try again.\");\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n\n\n  const handleVerifySubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!twoFactor) return;\n    setIsVerifying(true);\n    setError(\"\");\n    try {\n      const ok = await verifyTwoFactor(code.trim());\n      if (ok) {\n        navigate(redirectParam);\n      } else {\n        setError(\"Invalid or expired verification code. Please try again.\");\n      }\n    } catch (err) {\n      setError(\"Verification failed. Please try again.\");\n    } finally {\n      setIsVerifying(false);\n    }\n  };\n\n  const handleResend = async () => {\n    setError(\"\");\n    const sent = await resendTwoFactorCode();\n    if (!sent) {\n      setError(\"Failed to resend code. Please wait a moment and try again.\");\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-background via-brand-purple/5 to-brand-blue/5\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16 min-h-screen flex items-center justify-center p-4\">\n          <div className=\"w-full max-w-md\">\n            <Card>\n              <CardHeader className=\"text-center\">\n                <CardTitle className=\"text-2xl\">Welcome back</CardTitle>\n                <CardDescription>\n                  Sign in to your MyVideoResume account\n                </CardDescription>\n              </CardHeader>\n              <CardContent className=\"space-y-6\">\n                {error && (\n                  <Alert variant=\"destructive\">\n                    <AlertDescription>{error}</AlertDescription>\n                  </Alert>\n                )}\n\n                {!twoFactor ? (\n                  <form onSubmit={handleSubmit} className=\"space-y-4\">\n                    <div className=\"space-y-2\">\n                      <Label htmlFor=\"email\">Email</Label>\n                      <Input\n                        id=\"email\"\n                        type=\"email\"\n                        placeholder=\"Enter your email\"\n                        value={email}\n                        onChange={(e) => setEmail(e.target.value)}\n                        required\n                      />\n                    </div>\n\n                    <div className=\"space-y-2\">\n                      <Label htmlFor=\"password\">Password</Label>\n                      <div className=\"relative\">\n                        <Input\n                          id=\"password\"\n                          type={showPassword ? \"text\" : \"password\"}\n                          placeholder=\"Enter your password\"\n                          value={password}\n                          onChange={(e) => setPassword(e.target.value)}\n                          required\n                        />\n                        <Button\n                          type=\"button\"\n                          variant=\"ghost\"\n                          size=\"icon\"\n                          className=\"absolute right-0 top-0 h-full px-3 py-2 hover:bg-transparent\"\n                          onClick={() => setShowPassword(!showPassword)}\n                        >\n                          {showPassword ? (\n                            <EyeOff className=\"h-4 w-4 text-muted-foreground\" />\n                          ) : (\n                            <Eye className=\"h-4 w-4 text-muted-foreground\" />\n                          )}\n                        </Button>\n                      </div>\n                    </div>\n\n                    <Button\n                      type=\"submit\"\n                      className=\"w-full bg-gradient-to-r from-brand-purple to-brand-blue hover:opacity-90\"\n                      disabled={isLoading}\n                    >\n                      {isLoading ? \"Signing in...\" : \"Sign in\"}\n                    </Button>\n                  </form>\n                ) : (\n                  <form onSubmit={handleVerifySubmit} className=\"space-y-4\">\n                    <div className=\"text-sm text-muted-foreground\">\n                      We've sent a verification code to {twoFactor.email}. Enter it below to finish signing in.\n                    </div>\n                    <div className=\"space-y-2\">\n                      <Label htmlFor=\"code\">Verification Code</Label>\n                      <Input\n                        id=\"code\"\n                        inputMode=\"numeric\"\n                        autoComplete=\"one-time-code\"\n                        placeholder=\"Enter the 6-digit code\"\n                        value={code}\n                        onChange={(e) => setCode(e.target.value)}\n                        required\n                      />\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <Button type=\"submit\" disabled={isVerifying} className=\"flex-1\">\n                        {isVerifying ? \"Verifying...\" : \"Verify\"}\n                      </Button>\n                      <Button type=\"button\" variant=\"outline\" onClick={handleResend}>\n                        Resend code\n                      </Button>\n                      <Button type=\"button\" variant=\"ghost\" onClick={() => setTwoFactor(null)}>\n                        Back\n                      </Button>\n                    </div>\n                  </form>\n                )}\n\n                {/* Demo accounts removed */}\n\n                <div className=\"text-center space-y-2\">\n                  <p className=\"text-sm text-muted-foreground\">\n                    <Link\n                      to=\"/forgot-password\"\n                      className=\"text-primary hover:underline font-medium\"\n                    >\n                      Forgot your password?\n                    </Link>\n                  </p>\n\n                  <p className=\"text-sm text-muted-foreground\">\n                    Don't have an account?{\" \"}\n                    <Link\n                      to=\"/signup\"\n                      className=\"text-primary hover:underline font-medium\"\n                    >\n                      Sign up\n                    </Link>\n                  </p>\n                </div>\n              </CardContent>\n            </Card>\n          </div>\n        </div>\n        <Footer />\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\NotFound.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":19,"column":5,"nodeType":"MemberExpression","messageId":"unexpected","endLine":19,"endColumn":18,"suggestions":[{"fix":{"range":[599,710],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport { useSEO } from \"@/lib/seo\";\n\nconst NotFound = () => {\n  const location = useLocation();\n\n  // SEO: mark as noindex and set canonical to homepage to avoid indexation of 404 paths\n  useSEO(location.pathname, {\n    title: \"404 Not Found - MyVideoResu.me\",\n    description: \"This page could not be found.\",\n    robots: \"noindex, nofollow\",\n    canonical: \"https://myvideoresu.me/\",\n    ogTitle: \"404 Not Found - MyVideoResu.me\",\n    ogDescription: \"This page could not be found.\",\n  });\n\n  useEffect(() => {\n    console.error(\n      \"404 Error: User attempted to access non-existent route:\",\n      location.pathname,\n    );\n  }, [location.pathname]);\n\n  return (\n    <div className=\"min-h-screen flex items-center justify-center bg-gray-100\">\n      <div className=\"text-center\">\n        <h1 className=\"text-4xl font-bold mb-4\">404</h1>\n        <p className=\"text-xl text-gray-600 mb-4\">Oops! Page not found</p>\n        <a href=\"/\" className=\"text-blue-500 hover:text-blue-700 underline\">\n          Return to Home\n        </a>\n      </div>\n    </div>\n  );\n};\n\nexport default NotFound;\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\Onboarding.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Circle' is defined but never used. Allowed unused vars must match /^_/u.","line":3,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":3,"endColumn":9},{"ruleId":"@typescript-eslint/no-unused-vars"