tput</div>\n                          </div>\n                        </div>\n                        <div className=\"space-y-2\">\n                          <div className=\"flex items-center gap-2 text-sm\">\n                            <CheckCircle2 className=\"h-4 w-4 text-green-600\" />\n                            PDF/Word parsing\n                          </div>\n                          <div className=\"flex items-center gap-2 text-sm\">\n                            <CheckCircle2 className=\"h-4 w-4 text-green-600\" />\n                            Structured JSON output\n                          </div>\n                          <div className=\"flex items-center gap-2 text-sm\">\n                            <CheckCircle2 className=\"h-4 w-4 text-green-600\" />\n                            Data extraction\n                          </div>\n                        </div>\n                        <Button className=\"w-full mt-4\" variant=\"outline\">\n                          Convert Document\n                        </Button>\n                      </div>\n                    </CardContent>\n                  </Card>\n                </Link>\n\n                {/* Best Resume Generator - Chrome Extension */}\n                <a\n                  href=\"https://myvideoresu.me/insights/how-to-use-job-seeker-chrome-plugin-extension\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                >\n                  <Card className=\"hover:shadow-lg transition-shadow cursor-pointer group\">\n                    <CardHeader>\n                      <div className=\"flex items-center justify-between\">\n                        <div className=\"flex items-center gap-3\">\n                          <div className=\"w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center\">\n                            <Chrome className=\"h-6 w-6 text-blue-600 group-hover:scale-110 transition-transform\" />\n                          </div>\n                          <div>\n                            <CardTitle className=\"text-xl\">\n                              Best Resume Generator\n                            </CardTitle>\n                            <CardDescription>\n                              Chrome extension for job-specific resumes\n                            </CardDescription>\n                          </div>\n                        </div>\n                        <Badge\n                          variant=\"secondary\"\n                          className=\"bg-blue-100 text-blue-800\"\n                        >\n                          Chrome Extension\n                        </Badge>\n                      </div>\n                    </CardHeader>\n                    <CardContent>\n                      <div className=\"space-y-3\">\n                        <div className=\"grid grid-cols-2 gap-4 text-sm\">\n                          <div className=\"text-center\">\n                            <div className=\"text-2xl font-bold text-blue-600\">\n                              1-Click\n                            </div>\n                            <div className=\"text-muted-foreground\">\n                              Generation\n                            </div>\n                          </div>\n                          <div className=\"text-center\">\n                            <div className=\"text-2xl font-bold text-blue-600\">\n                              Job\n                            </div>\n                            <div className=\"text-muted-foreground\">\n                              Specific\n                            </div>\n                          </div>\n                        </div>\n                        <div className=\"space-y-2\">\n                          <div className=\"flex items-center gap-2 text-sm\">\n                            <CheckCircle2 className=\"h-4 w-4 text-green-600\" />\n                            Job-specific optimization\n                          </div>\n                          <div className=\"flex items-center gap-2 text-sm\">\n                            <CheckCircle2 className=\"h-4 w-4 text-green-600\" />\n                            Browser integration\n                          </div>\n                          <div className=\"flex items-center gap-2 text-sm\">\n                            <CheckCircle2 className=\"h-4 w-4 text-green-600\" />\n                            Instant generation\n                          </div>\n                        </div>\n                        <Button className=\"w-full mt-4\" variant=\"outline\">\n                          Install Extension\n                        </Button>\n                      </div>\n                    </CardContent>\n                  </Card>\n                </a>\n              </div>\n            </div>\n          </div>\n        </div>\n        <Footer />\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\VerifyEmail.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'e' is defined but never used.","line":44,"column":14,"nodeType":null,"messageId":"unusedVar","endLine":44,"endColumn":15}],"suppressedMessages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'checkAndRedirectIfVerified'. Either include it or remove the dependency array.","line":58,"column":6,"nodeType":"ArrayExpression","endLine":58,"endColumn":23,"suggestions":[{"desc":"Update the dependencies array to be: [checkAndRedirectIfVerified, isAuthenticated]","fix":{"range":[2127,2144],"text":"[checkAndRedirectIfVerified, isAuthenticated]"}}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useEffect, useMemo, useState } from \"react\";\nimport { useLocation, useNavigate } from \"react-router-dom\";\nimport { useAuth } from \"@/lib/auth\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardHeader, CardTitle, CardContent, CardFooter } from \"@/components/ui/card\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Loader2, Mail, LogOut } from \"lucide-react\";\n\nfunction useQuery() {\n  const { search } = useLocation();\n  return useMemo(() => new URLSearchParams(search), [search]);\n}\n\nexport default function VerifyEmail(): JSX.Element {\n  const navigate = useNavigate();\n  const query = useQuery();\n  const redirect = query.get(\"redirect\") || \"/dashboard\";\n  const hintedEmail = query.get(\"email\") || undefined;\n\n  const { user, isAuthenticated, resendEmailVerification, getVerificationStatus, logout } = useAuth();\n\n  const [email, setEmail] = useState<string | undefined>(hintedEmail);\n  const [statusLoading, setStatusLoading] = useState<boolean>(false);\n  const [resendLoading, setResendLoading] = useState<boolean>(false);\n  const [message, setMessage] = useState<string | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [cooldown, setCooldown] = useState<number>(0);\n\n  // Sync email from authenticated user if present\n  useEffect(() => {\n    if (user?.email) setEmail(user.email);\n  }, [user?.email]);\n\n  // If the user becomes verified, send them forward\n  const checkAndRedirectIfVerified = async () => {\n    try {\n      setStatusLoading(true);\n      const status = await getVerificationStatus();\n      if (status.isEmailVerified || status.emailConfirmed) {\n        navigate(redirect, { replace: true });\n        return true;\n      }\n      return false;\n    } catch (e) {\n      // If not authenticated, keep them on page with guidance\n      return false;\n    } finally {\n      setStatusLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    // Proactively check status for authenticated users\n    if (isAuthenticated) {\n      checkAndRedirectIfVerified();\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [isAuthenticated]);\n\n  // Cooldown timer\n  useEffect(() => {\n    if (cooldown <= 0) return;\n    const id = setInterval(() => setCooldown((c) => Math.max(0, c - 1)), 1000);\n    return () => clearInterval(id);\n  }, [cooldown]);\n\n  const handleResend = async () => {\n    setError(null);\n    setMessage(null);\n    setResendLoading(true);\n    const ok = await resendEmailVerification();\n    setResendLoading(false);\n    if (ok) {\n      setMessage(\"Verification email sent. Please check your inbox.\");\n      setCooldown(60); // 1 per minute rate limit UX\n    } else {\n      setError(\"Please wait before requesting another verification email.\");\n    }\n  };\n\n  const handleLogout = async () => {\n    await logout();\n    navigate(\"/login\", { replace: true });\n  };\n\n  return (\n    <div className=\"container mx-auto max-w-xl py-10\">\n      <Card>\n        <CardHeader>\n          <CardTitle>Verify your email to continue</CardTitle>\n        </CardHeader>\n        <CardContent className=\"space-y-4\">\n          <p className=\"text-sm text-muted-foreground\">\n            For your security and to prevent fake profiles, you must verify your email address before accessing your account.\n          </p>\n          {email && (\n            <Alert>\n              <Mail className=\"h-4 w-4\" />\n              <AlertDescription>\n                We sent a verification link to <strong>{email}</strong>. Check your inbox (and spam folder).\n              </AlertDescription>\n            </Alert>\n          )}\n\n          <p className=\"text-sm text-muted-foreground\">\n            Need to update your email? You can change it in your account settings after signing in.\n          </p>\n\n          {!isAuthenticated && (\n            <Alert>\n              <AlertDescription>\n                You are not currently signed in. Please sign in with your account to resend the verification email.\n              </AlertDescription>\n            </Alert>\n          )}\n\n          {message && (\n            <Alert>\n              <AlertDescription>{message}</AlertDescription>\n            </Alert>\n          )}\n          {error && (\n            <Alert variant=\"destructive\">\n              <AlertDescription>{error}</AlertDescription>\n            </Alert>\n          )}\n        </CardContent>\n        <CardFooter className=\"flex gap-2\">\n          <Button\n            onClick={handleResend}\n            disabled={!isAuthenticated || resendLoading || cooldown > 0}\n          >\n            {resendLoading ? (\n              <>\n                <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" /> Sending\n              </>\n            ) : cooldown > 0 ? (\n              <>Resend in {cooldown}s</>\n            ) : (\n              <>Resend Verification Email</>\n            )}\n          </Button>\n          <Button variant=\"secondary\" onClick={() => checkAndRedirectIfVerified()} disabled={statusLoading}>\n            {statusLoading ? <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" /> : null}\n            I already verified\n          </Button>\n          <div className=\"grow\" />\n          <Button variant=\"ghost\" onClick={handleLogout}>\n            <LogOut className=\"h-4 w-4 mr-2\" /> Logout\n          </Button>\n        </CardFooter>\n      </Card>\n    </div>\n  );\n}\n\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\admin\\AdminDashboard.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":99,"column":22,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[2706,2790],"text":"\n              You don&apos;t have permission to access the admin dashboard.\n            "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[2706,2790],"text":"\n              You don&lsquo;t have permission to access the admin dashboard.\n            "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[2706,2790],"text":"\n              You don&#39;t have permission to access the admin dashboard.\n            "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[2706,2790],"text":"\n              You don&rsquo;t have permission to access the admin dashboard.\n            "},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":265,"column":26,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[9531,9617],"text":"\n                      You&apos;ve used 85% of your monthly AI credits\n                    "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[9531,9617],"text":"\n                      You&lsquo;ve used 85% of your monthly AI credits\n                    "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[9531,9617],"text":"\n                      You&#39;ve used 85% of your monthly AI credits\n                    "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[9531,9617],"text":"\n                      You&rsquo;ve used 85% of your monthly AI credits\n                    "},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":319,"column":47,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[11283,11371],"text":"\n                      Update your organization&apos;s basic information\n                    "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[11283,11371],"text":"\n                      Update your organization&lsquo;s basic information\n                    "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[11283,11371],"text":"\n                      Update your organization&#39;s basic information\n                    "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[11283,11371],"text":"\n                      Update your organization&rsquo;s basic information\n                    "},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Button } from \"@/components/ui/button\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { Badge } from \"@/components/ui/badge\";\nimport {\n  Users,\n  CreditCard,\n  BarChart3,\n  Settings,\n  Shield,\n  TrendingUp,\n  UserPlus,\n  DollarSign,\n  Calendar,\n  AlertCircle,\n} from \"lucide-react\";\n\nimport { BillingManagement } from \"@/components/billing/BillingManagement\";\nimport { BillingAnalytics } from \"@/components/billing/BillingAnalytics\";\nimport { usePermissions } from \"@/hooks/use-permissions\";\nimport { useAuth } from \"@/lib/auth\";\n\ninterface QuickStat {\n  title: string;\n  value: string;\n  change: string;\n  trend: \"up\" | \"down\" | \"neutral\";\n  icon: React.ReactNode;\n}\n\nexport default function AdminDashboard() {\n  const [activeTab, setActiveTab] = useState(\"overview\");\n  const { user } = useAuth();\n  const { isAdmin } = usePermissions();\n  const isOwner = isAdmin; // For now, treat admin as owner\n\n  const quickStats: QuickStat[] = [\n    {\n      title: \"Team Members\",\n      value: \"12\",\n      change: \"+2 this month\",\n      trend: \"up\",\n      icon: <Users className=\"h-5 w-5\" />,\n    },\n    {\n      title: \"Monthly Revenue\",\n      value: \"$2,450\",\n      change: \"+15% from last month\",\n      trend: \"up\",\n      icon: <DollarSign className=\"h-5 w-5\" />,\n    },\n    {\n      title: \"Active Jobs\",\n      value: \"34\",\n      change: \"+8 this week\",\n      trend: \"up\",\n      icon: <BarChart3 className=\"h-5 w-5\" />,\n    },\n    {\n      title: \"Subscription\",\n      value: \"Employer Plan\",\n      change: \"Renews in 15 days\",\n      trend: \"neutral\",\n      icon: <CreditCard className=\"h-5 w-5\" />,\n    },\n  ];\n\n  const getTrendColor = (trend: string) => {\n    switch (trend) {\n      case \"up\":\n        return \"text-green-600\";\n      case \"down\":\n        return \"text-red-600\";\n      default:\n        return \"text-muted-foreground\";\n    }\n  };\n\n  const getTrendIcon = (trend: string) => {\n    switch (trend) {\n      case \"up\":\n        return <TrendingUp className=\"h-4 w-4\" />;\n      case \"down\":\n        return <TrendingUp className=\"h-4 w-4 rotate-180\" />;\n      default:\n        return <Calendar className=\"h-4 w-4\" />;\n    }\n  };\n\n  if (!isAdmin) {\n    return (\n      <div className=\"flex items-center justify-center min-h-[400px]\">\n        <Card className=\"w-full max-w-md\">\n          <CardContent className=\"pt-6 text-center\">\n            <Shield className=\"h-12 w-12 mx-auto mb-4 text-muted-foreground\" />\n            <h2 className=\"text-xl font-semibold mb-2\">Access Restricted</h2>\n            <p className=\"text-muted-foreground\">\n              You don't have permission to access the admin dashboard.\n            </p>\n          </CardContent>\n        </Card>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h1 className=\"text-3xl font-bold\">Admin Dashboard</h1>\n          <p className=\"text-muted-foreground mt-1\">\n            Manage your team, billing, and organization settings\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <Badge variant={isOwner ? \"default\" : \"secondary\"}>\n            {isOwner ? \"Account Owner\" : \"Admin\"}\n          </Badge>\n          <span className=\"text-sm text-muted-foreground\">\n            Welcome back, {user?.firstName || \"Admin\"}\n          </span>\n        </div>\n      </div>\n\n      <Tabs value={activeTab} onValueChange={setActiveTab}>\n        <TabsList className=\"grid w-full grid-cols-5\">\n          <TabsTrigger value=\"overview\">Overview</TabsTrigger>\n\n          {isAdmin && <TabsTrigger value=\"team\">Team</TabsTrigger>}\n          {isAdmin && <TabsTrigger value=\"billing\">Billing</TabsTrigger>}\n          {isAdmin && <TabsTrigger value=\"analytics\">Analytics</TabsTrigger>}\n\n          <TabsTrigger value=\"settings\">Settings</TabsTrigger>\n        </TabsList>\n\n        <TabsContent value=\"overview\" className=\"space-y-6\">\n          {/* Quick Stats */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n            {quickStats.map((stat, index) => (\n              <Card key={index}>\n                <CardContent className=\"pt-6\">\n                  <div className=\"flex items-center justify-between\">\n                    <div>\n                      <p className=\"text-sm font-medium text-muted-foreground\">\n                        {stat.title}\n                      </p>\n                      <p className=\"text-2xl font-bold\">{stat.value}</p>\n                    </div>\n                    <div className=\"p-2 bg-primary/10 rounded-lg\">\n                      {stat.icon}\n                    </div>\n                  </div>\n                  <div\n                    className={`flex items-center mt-2 ${getTrendColor(stat.trend)}`}\n                  >\n                    {getTrendIcon(stat.trend)}\n                    <span className=\"text-sm ml-1\">{stat.change}</span>\n                  </div>\n                </CardContent>\n              </Card>\n            ))}\n          </div>\n\n          {/* Quick Actions */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n            {isAdmin && (\n              <Card className=\"cursor-pointer hover:shadow-md transition-shadow\">\n                <CardContent className=\"pt-6\">\n                  <div className=\"flex items-center gap-4\">\n                    <div className=\"p-3 bg-blue-100 rounded-lg\">\n                      <UserPlus className=\"h-6 w-6 text-blue-600\" />\n                    </div>\n                    <div>\n                      <h3 className=\"font-semibold\">Invite Team Member</h3>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Add new users to your organization\n                      </p>\n                    </div>\n                  </div>\n                </CardContent>\n              </Card>\n            )}\n\n            {isAdmin && (\n              <Card className=\"cursor-pointer hover:shadow-md transition-shadow\">\n                <CardContent className=\"pt-6\">\n                  <div className=\"flex items-center gap-4\">\n                    <div className=\"p-3 bg-green-100 rounded-lg\">\n                      <CreditCard className=\"h-6 w-6 text-green-600\" />\n                    </div>\n                    <div>\n                      <h3 className=\"font-semibold\">Manage Billing</h3>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Update payment methods and plans\n                      </p>\n                    </div>\n                  </div>\n                </CardContent>\n              </Card>\n            )}\n\n            <Card className=\"cursor-pointer hover:shadow-md transition-shadow\">\n              <CardContent className=\"pt-6\">\n                <div className=\"flex items-center gap-4\">\n                  <div className=\"p-3 bg-purple-100 rounded-lg\">\n                    <Settings className=\"h-6 w-6 text-purple-600\" />\n                  </div>\n                  <div>\n                    <h3 className=\"font-semibold\">Organization Settings</h3>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Configure company preferences\n                    </p>\n                  </div>\n                </div>\n              </CardContent>\n            </Card>\n          </div>\n\n          {/* Recent Activity */}\n          <Card>\n            <CardHeader>\n              <CardTitle>Recent Activity</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <div className=\"space-y-4\">\n                <div className=\"flex items-center gap-4 p-3 bg-muted/50 rounded-lg\">\n                  <div className=\"p-2 bg-blue-100 rounded-full\">\n                    <UserPlus className=\"h-4 w-4 text-blue-600\" />\n                  </div>\n                  <div className=\"flex-1\">\n                    <p className=\"font-medium\">New team member invited</p>\n                    <p className=\"text-sm text-muted-foreground\">\n                      sarah.johnson@company.com was invited as a Recruiter\n                    </p>\n                  </div>\n                  <span className=\"text-sm text-muted-foreground\">\n                    2 hours ago\n                  </span>\n                </div>\n\n                <div className=\"flex items-center gap-4 p-3 bg-muted/50 rounded-lg\">\n                  <div className=\"p-2 bg-green-100 rounded-full\">\n                    <CreditCard className=\"h-4 w-4 text-green-600\" />\n                  </div>\n                  <div className=\"flex-1\">\n                    <p className=\"font-medium\">Payment successful</p>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Monthly subscription payment of $99.00 processed\n                    </p>\n                  </div>\n                  <span className=\"text-sm text-muted-foreground\">\n                    1 day ago\n                  </span>\n                </div>\n\n                <div className=\"flex items-center gap-4 p-3 bg-muted/50 rounded-lg\">\n                  <div className=\"p-2 bg-yellow-100 rounded-full\">\n                    <AlertCircle className=\"h-4 w-4 text-yellow-600\" />\n                  </div>\n                  <div className=\"flex-1\">\n                    <p className=\"font-medium\">Usage limit warning</p>\n                    <p className=\"text-sm text-muted-foreground\">\n                      You've used 85% of your monthly AI credits\n                    </p>\n                  </div>\n                  <span className=\"text-sm text-muted-foreground\">\n                    3 days ago\n                  </span>\n                </div>\n              </div>\n            </CardContent>\n          </Card>\n        </TabsContent>\n\n        {isAdmin && (\n          <TabsContent value=\"team\">\n            <Card>\n              <CardHeader>\n                <CardTitle>Team Management</CardTitle>\n              </CardHeader>\n              <CardContent>\n                <p className=\"text-muted-foreground mb-4\">\n                  Team management features have been moved to the dedicated\n                  Account Management page.\n                </p>\n                <Button asChild>\n                  <a href=\"/account\">Go to Account Management</a>\n                </Button>\n              </CardContent>\n            </Card>\n          </TabsContent>\n        )}\n\n        {isAdmin && (\n          <TabsContent value=\"billing\">\n            <BillingManagement />\n          </TabsContent>\n        )}\n\n        {isAdmin && (\n          <TabsContent value=\"analytics\">\n            <BillingAnalytics />\n          </TabsContent>\n        )}\n\n        <TabsContent value=\"settings\" className=\"space-y-4\">\n          <Card>\n            <CardHeader>\n              <CardTitle>Organization Settings</CardTitle>\n            </CardHeader>\n            <CardContent>\n              <div className=\"space-y-4\">\n                <div className=\"flex items-center justify-between p-4 border rounded-lg\">\n                  <div>\n                    <h3 className=\"font-semibold\">Company Profile</h3>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Update your organization's basic information\n                    </p>\n                  </div>\n                  <Button variant=\"outline\">Edit</Button>\n                </div>\n\n                <div className=\"flex items-center justify-between p-4 border rounded-lg\">\n                  <div>\n                    <h3 className=\"font-semibold\">Security Settings</h3>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Manage authentication and security policies\n                    </p>\n                  </div>\n                  <Button variant=\"outline\">Configure</Button>\n                </div>\n\n                <div className=\"flex items-center justify-between p-4 border rounded-lg\">\n                  <div>\n                    <h3 className=\"font-semibold\">Integrations</h3>\n                    <p className=\"text-sm text-muted-foreground\">\n                      Connect with third-party services and APIs\n                    </p>\n                  </div>\n                  <Button variant=\"outline\">Manage</Button>\n                </div>\n\n                {isOwner && (\n                  <div className=\"flex items-center justify-between p-4 border rounded-lg border-red-200\">\n                    <div>\n                      <h3 className=\"font-semibold text-red-600\">\n                        Danger Zone\n                      </h3>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Irreversible actions that affect your entire\n                        organization\n                      </p>\n                    </div>\n                    <Button variant=\"destructive\" size=\"sm\">\n                      Delete Organization\n                    </Button>\n                  </div>\n                )}\n              </div>\n            </CardContent>\n          </Card>\n        </TabsContent>\n      </Tabs>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\admin\\ProductDashboard.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":209,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":209,"endColumn":20,"suggestions":[{"fix":{"range":[5804,5841],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Users,\n  Briefcase,\n  Building2,\n  FileText,\n  UserCheck,\n  TrendingUp,\n  TrendingDown,\n  Download,\n  RefreshCw,\n  Activity,\n  DollarSign,\n  BarChart3,\n  PieChart,\n} from \"lucide-react\";\nimport { useAuth } from \"@/lib/auth\";\nimport { createRolePermissions, getRoleDisplayLabel } from \"@/lib/role-utils\";\nimport { apiClient } from \"@/lib/api-client\";\n\nimport {\n  LineChart,\n  Line,\n  XAxis,\n  YAxis,\n  CartesianGrid,\n  Tooltip,\n  Legend,\n  ResponsiveContainer,\n  PieChart as RechartsPieChart,\n  Pie,\n  Cell,\n} from \"recharts\";\n\ninterface ProductDashboardData {\n  userMetrics: {\n    totalUsers: number;\n    activeUsers: number;\n    newUsersLast30Days: number;\n    usersByRole: Record<string, number>;\n    usersByStatus: Record<string, number>;\n  };\n  jobMetrics: {\n    totalJobs: number;\n    activeJobs: number;\n    newJobsLast30Days: number;\n    jobsByStatus: Record<string, number>;\n    jobsByOrigin: Record<string, number>;\n  };\n  profileMetrics: {\n    totalProfiles: number;\n    publicProfiles: number;\n    newProfilesLast30Days: number;\n    profilesByStatus: Record<string, number>;\n    profilesByPrivacy: Record<string, number>;\n  };\n  companyMetrics: {\n    totalCompanies: number;\n    activeCompanies: number;\n    newCompaniesLast30Days: number;\n    companiesByStatus: Record<string, number>;\n    companiesBySize: Record<string, number>;\n  };\n  resumeMetrics: {\n    totalResumes: number;\n    publicResumes: number;\n    newResumesLast30Days: number;\n    resumesByType: Record<string, number>;\n    resumesByStatus: Record<string, number>;\n  };\n  saasMetrics: {\n    monthlyRecurringRevenue: number;\n    annualRecurringRevenue: number;\n    averageRevenuePerUser: number;\n    customerLifetimeValue: number;\n    customerAcquisitionCost: number;\n    churnRate: number;\n    growthRate: number;\n    conversionRate: number;\n    totalSubscriptions: number;\n    activeSubscriptions: number;\n    subscriptionsByTier: Record<string, number>;\n    revenueByTier: Record<string, number>;\n  };\n  userGrowthLast90Days: Array<{ date: string; count: number }>;\n  jobGrowthLast90Days: Array<{ date: string; count: number }>;\n  profileGrowthLast90Days: Array<{ date: string; count: number }>;\n  companyGrowthLast90Days: Array<{ date: string; count: number }>;\n  resumeGrowthLast90Days: Array<{ date: string; count: number }>;\n}\n\ninterface MetricCardProps {\n  title: string;\n  value: string | number;\n  change?: string;\n  trend?: \"up\" | \"down\" | \"neutral\";\n  icon: React.ReactNode;\n  description?: string;\n}\n\nconst MetricCard: React.FC<MetricCardProps> = ({\n  title,\n  value,\n  change,\n  trend,\n  icon,\n  description,\n}) => {\n  const getTrendIcon = () => {\n    if (trend === \"up\")\n      return <TrendingUp className=\"h-4 w-4 text-green-500\" />;\n    if (trend === \"down\")\n      return <TrendingDown className=\"h-4 w-4 text-red-500\" />;\n    return null;\n  };\n\n  const getTrendColor = () => {\n    if (trend === \"up\") return \"text-green-600\";\n    if (trend === \"down\") return \"text-red-600\";\n    return \"text-muted-foreground\";\n  };\n\n  return (\n    <Card>\n      <CardHeader className=\"flex flex-row items-center justify-between space-y-0 pb-2\">\n        <CardTitle className=\"text-sm font-medium\">{title}</CardTitle>\n        {icon}\n      </CardHeader>\n      <CardContent>\n        <div className=\"text-2xl font-bold\">\n          {typeof value === \"number\" ? value.toLocaleString() : value}\n        </div>\n        {change && (\n          <div className={`flex items-center text-xs ${getTrendColor()}`}>\n            {getTrendIcon()}\n            <span className=\"ml-1\">{change}</span>\n          </div>\n        )}\n        {description && (\n          <p className=\"text-xs text-muted-foreground mt-1\">{description}</p>\n        )}\n      </CardContent>\n    </Card>\n  );\n};\n\nexport default function ProductDashboard() {\n  const [activeTab, setActiveTab] = useState(\"overview\");\n  const [dashboardData, setDashboardData] =\n    useState<ProductDashboardData | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n  const { user } = useAuth();\n\n  // Check if user has admin permissions\n  const rolePermissions = createRolePermissions(user?.role);\n  const isAdmin = rolePermissions.isSuperAdmin; // Only SuperAdmin users can access product dashboard\n\n  useEffect(() => {\n    if (isAdmin) {\n      loadDashboardData();\n    }\n  }, [isAdmin]);\n\n  const loadDashboardData = async () => {\n    try {\n      setLoading(true);\n      const response = await apiClient.get<ProductDashboardData>(\"/ProductDashboard\");\n      setDashboardData(response.data);\n    } catch (err) {\n      setError(err instanceof Error ? err.message : \"An error occurred\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const exportData = async (format: \"csv\") => {\n    try {\n      const response = await fetch(`/api/ProductDashboard/export/${format}`, {\n        headers: {\n          Authorization: `Bearer ${localStorage.getItem(\"auth_token\")}`,\n        },\n      });\n\n      if (!response.ok) {\n        throw new Error(\"Failed to export data\");\n      }\n\n      const blob = await response.blob();\n      const url = window.URL.createObjectURL(blob);\n      const a = document.createElement(\"a\");\n      a.style.display = \"none\";\n      a.href = url;\n      a.download = `product-dashboard-${new Date().toISOString().split(\"T\")[0]}.${format}`;\n      document.body.appendChild(a);\n      a.click();\n      window.URL.revokeObjectURL(url);\n    } catch (err) {\n      console.error(\"Export failed:\", err);\n    }\n  };\n\n  if (!isAdmin) {\n    return (\n      <div className=\"flex items-center justify-center min-h-[400px]\">\n        <Card className=\"w-full max-w-md\">\n          <CardContent className=\"pt-6 text-center\">\n            <Activity className=\"h-12 w-12 mx-auto mb-4 text-muted-foreground\" />\n            <h2 className=\"text-xl font-semibold mb-2\">Access Restricted</h2>\n            <p className=\"text-muted-foreground\">\n              You need SuperAdmin privileges to access the Product Dashboard.\n            </p>\n          </CardContent>\n        </Card>\n      </div>\n    );\n  }\n\n  if (loading) {\n    return (\n      <div className=\"flex items-center justify-center min-h-[400px]\">\n        <div className=\"flex items-center space-x-2\">\n          <RefreshCw className=\"h-6 w-6 animate-spin\" />\n          <span>Loading dashboard data...</span>\n        </div>\n      </div>\n    );\n  }\n\n  if (error) {\n    return (\n      <div className=\"flex items-center justify-center min-h-[400px]\">\n        <Card className=\"w-full max-w-md\">\n          <CardContent className=\"pt-6 text-center\">\n            <h2 className=\"text-xl font-semibold mb-2 text-red-600\">Error</h2>\n            <p className=\"text-muted-foreground mb-4\">{error}</p>\n            <Button onClick={loadDashboardData}>\n              <RefreshCw className=\"h-4 w-4 mr-2\" />\n              Retry\n            </Button>\n          </CardContent>\n        </Card>\n      </div>\n    );\n  }\n\n  if (!dashboardData) {\n    return null;\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h1 className=\"text-3xl font-bold\">Product Dashboard</h1>\n          <p className=\"text-muted-foreground mt-1\">\n            System-wide analytics and metrics for platform administration\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <Badge variant=\"default\" className=\"bg-purple-600\">\n            Super Admin\n          </Badge>\n          <Button variant=\"outline\" onClick={() => exportData(\"csv\")}>\n            <Download className=\"h-4 w-4 mr-2\" />\n            Export CSV\n          </Button>\n          <Button variant=\"outline\" onClick={loadDashboardData}>\n            <RefreshCw className=\"h-4 w-4 mr-2\" />\n            Refresh\n          </Button>\n        </div>\n      </div>\n\n      <Tabs value={activeTab} onValueChange={setActiveTab}>\n        <TabsList className=\"grid w-full grid-cols-6\">\n          <TabsTrigger value=\"overview\">Overview</TabsTrigger>\n          <TabsTrigger value=\"users\">Users</TabsTrigger>\n          <TabsTrigger value=\"jobs\">Jobs</TabsTrigger>\n          <TabsTrigger value=\"companies\">Companies</TabsTrigger>\n          <TabsTrigger value=\"resumes\">Resumes</TabsTrigger>\n          <TabsTrigger value=\"saas\">SaaS Metrics</TabsTrigger>\n        </TabsList>\n\n        <TabsContent value=\"overview\">\n          <div className=\"grid gap-4 md:grid-cols-2 lg:grid-cols-4\">\n            <MetricCard\n              title=\"Total Users\"\n              value={dashboardData.userMetrics.totalUsers}\n              change={`+${dashboardData.userMetrics.newUsersLast30Days} this month`}\n              trend=\"up\"\n              icon={<Users className=\"h-4 w-4\" />}\n              description=\"All registered users\"\n            />\n            <MetricCard\n              title=\"Active Jobs\"\n              value={dashboardData.jobMetrics.activeJobs}\n              change={`+${dashboardData.jobMetrics.newJobsLast30Days} this month`}\n              trend=\"up\"\n              icon={<Briefcase className=\"h-4 w-4\" />}\n              description=\"Currently open positions\"\n            />\n            <MetricCard\n              title=\"Companies\"\n              value={dashboardData.companyMetrics.totalCompanies}\n              change={`+${dashboardData.companyMetrics.newCompaniesLast30Days} this month`}\n              trend=\"up\"\n              icon={<Building2 className=\"h-4 w-4\" />}\n              description=\"Registered companies\"\n            />\n            <MetricCard\n              title=\"Resumes\"\n              value={dashboardData.resumeMetrics.totalResumes}\n              change={`+${dashboardData.resumeMetrics.newResumesLast30Days} this month`}\n              trend=\"up\"\n              icon={<FileText className=\"h-4 w-4\" />}\n              description=\"Total resumes created\"\n            />\n          </div>\n\n          <div className=\"grid gap-4 md:grid-cols-2 mt-6\">\n            <Card>\n              <CardHeader>\n                <CardTitle>User Growth (Last 90 Days)</CardTitle>\n                <CardDescription>Daily user registrations</CardDescription>\n              </CardHeader>\n              <CardContent>\n                <ResponsiveContainer width=\"100%\" height={300}>\n                  <LineChart data={dashboardData.userGrowthLast90Days}>\n                    <CartesianGrid strokeDasharray=\"3 3\" />\n                    <XAxis dataKey=\"date\" />\n                    <YAxis />\n                    <Tooltip />\n                    <Legend />\n                    <Line\n                      type=\"monotone\"\n                      dataKey=\"count\"\n                      stroke=\"#8884d8\"\n                      strokeWidth={2}\n                    />\n                  </LineChart>\n                </ResponsiveContainer>\n              </CardContent>\n            </Card>\n\n            <Card>\n              <CardHeader>\n                <CardTitle>Job Growth (Last 90 Days)</CardTitle>\n                <CardDescription>Daily job postings</CardDescription>\n              </CardHeader>\n              <CardContent>\n                <ResponsiveContainer width=\"100%\" height={300}>\n                  <LineChart data={dashboardData.jobGrowthLast90Days}>\n                    <CartesianGrid strokeDasharray=\"3 3\" />\n                    <XAxis dataKey=\"date\" />\n                    <YAxis />\n                    <Tooltip />\n                    <Legend />\n                    <Line\n                      type=\"monotone\"\n                      dataKey=\"count\"\n                      stroke=\"#82ca9d\"\n                      strokeWidth={2}\n                    />\n                  </LineChart>\n                </ResponsiveContainer>\n              </CardContent>\n            </Card>\n          </div>\n        </TabsContent>\n\n        <TabsContent value=\"users\">\n          <div className=\"grid gap-4 md:grid-cols-3\">\n            <MetricCard\n              title=\"Total Users\"\n              value={dashboardData.userMetrics.totalUsers}\n              icon={<Users className=\"h-4 w-4\" />}\n              description=\"All registered users\"\n            />\n            <MetricCard\n              title=\"Active Users\"\n              value={dashboardData.userMetrics.activeUsers}\n              icon={<UserCheck className=\"h-4 w-4\" />}\n              description=\"Users active in last 30 days\"\n            />\n            <MetricCard\n              title=\"New Users\"\n              value={dashboardData.userMetrics.newUsersLast30Days}\n              icon={<TrendingUp className=\"h-4 w-4\" />}\n              description=\"Registered in last 30 days\"\n            />\n          </div>\n\n          <div className=\"grid gap-4 md:grid-cols-2 mt-6\">\n            <Card>\n              <CardHeader>\n                <CardTitle>Account Types Distribution</CardTitle>\n                <CardDescription>\n                  Distribution of paid and free accounts by role\n                </CardDescription>\n              </CardHeader>\n              <CardContent>\n                <div className=\"h-80\">\n                  <ResponsiveContainer width=\"100%\" height=\"100%\">\n                    <RechartsPieChart>\n                      <Pie\n                        data={Object.entries(\n                          dashboardData.userMetrics.usersByRole,\n                        ).map(([role, count]) => ({\n                          name: getRoleDisplayLabel(role),\n                          value: count,\n                          isPaid: role === \"employer\" || role === \"recruiter\", // Assume employer and recruiter are paid\n                        }))}\n                        cx=\"50%\"\n                        cy=\"50%\"\n                        labelLine={false}\n                        label={({ name, value, percent }) =>\n                          `${name}: ${value} (${(percent * 100).toFixed(0)}%)`\n                        }\n                        outerRadius={80}\n                        fill=\"#8884d8\"\n                        dataKey=\"value\"\n                      >\n                        {Object.entries(\n                          dashboardData.userMetrics.usersByRole,\n                        ).map((entry, index) => {\n                          const colors = [\n                            \"#0088FE\",\n                            \"#00C49F\",\n                            \"#FFBB28\",\n                            \"#FF8042\",\n                            \"#8884D8\",\n                          ];\n                          return (\n                            <Cell\n                              key={`cell-${index}`}\n                              fill={colors[index % colors.length]}\n                            />\n                          );\n                        })}\n                      </Pie>\n                      <Tooltip\n                        formatter={(value, name) => [value, name]}\n                        labelFormatter={(label) => `Account Type: ${label}`}\n                      />\n                      <Legend />\n                    </RechartsPieChart>\n                  </ResponsiveContainer>\n                </div>\n                <div className=\"mt-4 space-y-2\">\n                  <div className=\"text-sm font-medium\">\n                    Account Status Summary:\n                  </div>\n                  {Object.entries(dashboardData.userMetrics.usersByRole).map(\n                    ([role, count]) => {\n                      const isPaid =\n                        role === \"employer\" || role === \"recruiter\";\n                      return (\n                        <div\n                          key={role}\n                          className=\"flex justify-between items-center text-sm\"\n                        >\n                          <span className=\"flex items-center gap-2\">\n                            <div\n                              className={`w-3 h-3 rounded-full ${isPaid ? \"bg-green-500\" : \"bg-gray-400\"}`}\n                            />\n                            {getRoleDisplayLabel(role)}\n                            <span\n                              className={`px-2 py-1 rounded-full text-xs ${isPaid ? \"bg-green-100 text-green-800\" : \"bg-gray-100 text-gray-600\"}`}\n                            >\n                              {isPaid ? \"Paid\" : \"Free\"}\n                            </span>\n                          </span>\n                          <span className=\"font-medium\">{count}</span>\n                        </div>\n                      );\n                    },\n                  )}\n                </div>\n              </CardContent>\n            </Card>\n\n            <Card>\n              <CardHeader>\n                <CardTitle>User Growth Trend</CardTitle>\n                <CardDescription>\n                  90-day user registration trend\n                </CardDescription>\n              </CardHeader>\n              <CardContent>\n                <ResponsiveContainer width=\"100%\" height={300}>\n                  <LineChart data={dashboardData.userGrowthLast90Days}>\n                    <CartesianGrid strokeDasharray=\"3 3\" />\n                    <XAxis dataKey=\"date\" />\n                    <YAxis />\n                    <Tooltip />\n                    <Legend />\n                    <Line\n                      type=\"monotone\"\n                      dataKey=\"count\"\n                      stroke=\"#8884d8\"\n                      strokeWidth={2}\n                    />\n                  </LineChart>\n                </ResponsiveContainer>\n              </CardContent>\n            </Card>\n          </div>\n        </TabsContent>\n\n        <TabsContent value=\"jobs\">\n          <div className=\"grid gap-4 md:grid-cols-3\">\n            <MetricCard\n              title=\"Total Jobs\"\n              value={dashboardData.jobMetrics.totalJobs}\n              icon={<Briefcase className=\"h-4 w-4\" />}\n              description=\"All job postings\"\n            />\n            <MetricCard\n              title=\"Active Jobs\"\n              value={dashboardData.jobMetrics.activeJobs}\n              icon={<Activity className=\"h-4 w-4\" />}\n              description=\"Currently open positions\"\n            />\n            <MetricCard\n              title=\"New Jobs\"\n              value={dashboardData.jobMetrics.newJobsLast30Days}\n              icon={<TrendingUp className=\"h-4 w-4\" />}\n              description=\"Posted in last 30 days\"\n            />\n          </div>\n\n          <div className=\"grid gap-4 md:grid-cols-2 mt-6\">\n            <Card>\n              <CardHeader>\n                <CardTitle>Jobs by Status</CardTitle>\n                <CardDescription>\n                  Current job status distribution\n                </CardDescription>\n              </CardHeader>\n              <CardContent>\n                <div className=\"space-y-2\">\n                  {Object.entries(dashboardData.jobMetrics.jobsByStatus).map(\n                    ([status, count]) => (\n                      <div\n                        key={status}\n                        className=\"flex justify-between items-center\"\n                      >\n                        <span className=\"text-sm font-medium\">{status}</span>\n                        <Badge variant=\"secondary\">{count}</Badge>\n                      </div>\n                    ),\n                  )}\n                </div>\n              </CardContent>\n            </Card>\n\n            <Card>\n              <CardHeader>\n                <CardTitle>Job Growth Trend</CardTitle>\n                <CardDescription>90-day job posting trend</CardDescription>\n              </CardHeader>\n              <CardContent>\n                <ResponsiveContainer width=\"100%\" height={300}>\n                  <LineChart data={dashboardData.jobGrowthLast90Days}>\n                    <CartesianGrid strokeDasharray=\"3 3\" />\n                    <XAxis dataKey=\"date\" />\n                    <YAxis />\n                    <Tooltip />\n                    <Legend />\n                    <Line\n                      type=\"monotone\"\n                      dataKey=\"count\"\n                      stroke=\"#82ca9d\"\n                      strokeWidth={2}\n                    />\n                  </LineChart>\n                </ResponsiveContainer>\n              </CardContent>\n            </Card>\n          </div>\n        </TabsContent>\n\n        <TabsContent value=\"companies\">\n          <div className=\"grid gap-4 md:grid-cols-3\">\n            <MetricCard\n              title=\"Total Companies\"\n              value={dashboardData.companyMetrics.totalCompanies}\n              icon={<Building2 className=\"h-4 w-4\" />}\n              description=\"All registered companies\"\n            />\n            <MetricCard\n              title=\"Active Companies\"\n              value={dashboardData.companyMetrics.activeCompanies}\n              icon={<Activity className=\"h-4 w-4\" />}\n              description=\"Currently active companies\"\n            />\n            <MetricCard\n              title=\"New Companies\"\n              value={dashboardData.companyMetrics.newCompaniesLast30Days}\n              icon={<TrendingUp className=\"h-4 w-4\" />}\n              description=\"Registered in last 30 days\"\n            />\n          </div>\n\n          <div className=\"grid gap-4 md:grid-cols-2 mt-6\">\n            <Card>\n              <CardHeader>\n                <CardTitle>Companies by Size</CardTitle>\n                <CardDescription>Company size distribution</CardDescription>\n              </CardHeader>\n              <CardContent>\n                <div className=\"space-y-2\">\n                  {Object.entries(\n                    dashboardData.companyMetrics.companiesBySize,\n                  ).map(([size, count]) => (\n                    <div\n                      key={size}\n                      className=\"flex justify-between items-center\"\n                    >\n                      <span className=\"text-sm font-medium\">{size}</span>\n                      <Badge variant=\"secondary\">{count}</Badge>\n                    </div>\n                  ))}\n                </div>\n              </CardContent>\n            </Card>\n\n            <Card>\n              <CardHeader>\n                <CardTitle>Company Growth Trend</CardTitle>\n                <CardDescription>\n                  90-day company registration trend\n                </CardDescription>\n              </CardHeader>\n              <CardContent>\n                <ResponsiveContainer width=\"100%\" height={300}>\n                  <LineChart data={dashboardData.companyGrowthLast90Days}>\n                    <CartesianGrid strokeDasharray=\"3 3\" />\n                    <XAxis dataKey=\"date\" />\n                    <YAxis />\n                    <Tooltip />\n                    <Legend />\n                    <Line\n                      type=\"monotone\"\n                      dataKey=\"count\"\n                      stroke=\"#ffc658\"\n                      strokeWidth={2}\n                    />\n                  </LineChart>\n                </ResponsiveContainer>\n              </CardContent>\n            </Card>\n          </div>\n        </TabsContent>\n\n        <TabsContent value=\"resumes\">\n          <div className=\"grid gap-4 md:grid-cols-3\">\n            <MetricCard\n              title=\"Total Resumes\"\n              value={dashboardData.resumeMetrics.totalResumes}\n              icon={<FileText className=\"h-4 w-4\" />}\n              description=\"All created resumes\"\n            />\n            <MetricCard\n              title=\"Public Resumes\"\n              value={dashboardData.resumeMetrics.publicResumes}\n              icon={<Activity className=\"h-4 w-4\" />}\n              description=\"Publicly visible resumes\"\n            />\n            <MetricCard\n              title=\"New Resumes\"\n              value={dashboardData.resumeMetrics.newResumesLast30Days}\n              icon={<TrendingUp className=\"h-4 w-4\" />}\n              description=\"Created in last 30 days\"\n            />\n          </div>\n\n          <div className=\"grid gap-4 md:grid-cols-2 mt-6\">\n            <Card>\n              <CardHeader>\n                <CardTitle>Resumes by Type</CardTitle>\n                <CardDescription>Resume format distribution</CardDescription>\n              </CardHeader>\n              <CardContent>\n                <div className=\"space-y-2\">\n                  {Object.entries(\n                    dashboardData.resumeMetrics.resumesByType,\n                  ).map(([type, count]) => (\n                    <div\n                      key={type}\n                      className=\"flex justify-between items-center\"\n                    >\n                      <span className=\"text-sm font-medium\">{type}</span>\n                      <Badge variant=\"secondary\">{count}</Badge>\n                    </div>\n                  ))}\n                </div>\n              </CardContent>\n            </Card>\n\n            <Card>\n              <CardHeader>\n                <CardTitle>Resume Growth Trend</CardTitle>\n                <CardDescription>90-day resume creation trend</CardDescription>\n              </CardHeader>\n              <CardContent>\n                <ResponsiveContainer width=\"100%\" height={300}>\n                  <LineChart data={dashboardData.resumeGrowthLast90Days}>\n                    <CartesianGrid strokeDasharray=\"3 3\" />\n                    <XAxis dataKey=\"date\" />\n                    <YAxis />\n                    <Tooltip />\n                    <Legend />\n                    <Line\n                      type=\"monotone\"\n                      dataKey=\"count\"\n                      stroke=\"#ff7300\"\n                      strokeWidth={2}\n                    />\n                  </LineChart>\n                </ResponsiveContainer>\n              </CardContent>\n            </Card>\n          </div>\n        </TabsContent>\n\n        <TabsContent value=\"saas\">\n          <div className=\"grid gap-4 md:grid-cols-2 lg:grid-cols-4\">\n            <MetricCard\n              title=\"MRR\"\n              value={`$${dashboardData.saasMetrics.monthlyRecurringRevenue.toLocaleString()}`}\n              change={`${dashboardData.saasMetrics.growthRate > 0 ? \"+\" : \"\"}${dashboardData.saasMetrics.growthRate.toFixed(1)}%`}\n              trend={dashboardData.saasMetrics.growthRate > 0 ? \"up\" : \"down\"}\n              icon={<DollarSign className=\"h-4 w-4\" />}\n              description=\"Monthly Recurring Revenue\"\n            />\n            <MetricCard\n              title=\"ARR\"\n              value={`$${dashboardData.saasMetrics.annualRecurringRevenue.toLocaleString()}`}\n              icon={<BarChart3 className=\"h-4 w-4\" />}\n              description=\"Annual Recurring Revenue\"\n            />\n            <MetricCard\n              title=\"ARPU\"\n              value={`$${dashboardData.saasMetrics.averageRevenuePerUser.toFixed(2)}`}\n              icon={<Users className=\"h-4 w-4\" />}\n              description=\"Average Revenue Per User\"\n            />\n            <MetricCard\n              title=\"Churn Rate\"\n              value={`${dashboardData.saasMetrics.churnRate.toFixed(1)}%`}\n              trend={dashboardData.saasMetrics.churnRate < 5 ? \"up\" : \"down\"}\n              icon={<TrendingDown className=\"h-4 w-4\" />}\n              description=\"Monthly churn rate\"\n            />\n          </div>\n\n          <div className=\"grid gap-4 md:grid-cols-2 lg:grid-cols-4 mt-4\">\n            <MetricCard\n              title=\"LTV\"\n              value={`$${dashboardData.saasMetrics.customerLifetimeValue.toLocaleString()}`}\n              icon={<Activity className=\"h-4 w-4\" />}\n              description=\"Customer Lifetime Value\"\n            />\n            <MetricCard\n              title=\"CAC\"\n              value={`$${dashboardData.saasMetrics.customerAcquisitionCost.toFixed(2)}`}\n              icon={<TrendingUp className=\"h-4 w-4\" />}\n              description=\"Customer Acquisition Cost\"\n            />\n            <MetricCard\n              title=\"Conversion Rate\"\n              value={`${dashboardData.saasMetrics.conversionRate.toFixed(1)}%`}\n              icon={<PieChart className=\"h-4 w-4\" />}\n              description=\"Trial to paid conversion\"\n            />\n            <MetricCard\n              title=\"Active Subscriptions\"\n              value={dashboardData.saasMetrics.activeSubscriptions}\n              icon={<UserCheck className=\"h-4 w-4\" />}\n              description=\"Currently active subscriptions\"\n            />\n          </div>\n\n          <div className=\"grid gap-4 md:grid-cols-2 mt-6\">\n            <Card>\n              <CardHeader>\n                <CardTitle>Revenue by Tier</CardTitle>\n                <CardDescription>\n                  Monthly revenue breakdown by subscription tier\n                </CardDescription>\n              </CardHeader>\n              <CardContent>\n                <div className=\"space-y-2\">\n                  {Object.entries(dashboardData.saasMetrics.revenueByTier).map(\n                    ([tier, revenue]) => (\n                      <div\n                        key={tier}\n                        className=\"flex justify-between items-center\"\n                      >\n                        <span className=\"text-sm font-medium\">{tier}</span>\n                        <Badge variant=\"secondary\">\n                          ${revenue.toLocaleString()}\n                        </Badge>\n                      </div>\n                    ),\n                  )}\n                </div>\n              </CardContent>\n            </Card>\n\n            <Card>\n              <CardHeader>\n                <CardTitle>Revenue Distribution by Account Type</CardTitle>\n                <CardDescription>\n                  Financial breakdown of paid accounts\n                </CardDescription>\n              </CardHeader>\n              <CardContent>\n                <div className=\"h-80\">\n                  <ResponsiveContainer width=\"100%\" height=\"100%\">\n                    <RechartsPieChart>\n                      <Pie\n                        data={Object.entries(\n                          dashboardData.saasMetrics.revenueByTier,\n                        ).map(([tier, revenue]) => ({\n                          name: tier\n                            .replace(\"_\", \" \")\n                            .replace(/\\b\\w/g, (l) => l.toUpperCase()),\n                          value: revenue,\n                          subscriptions:\n                            dashboardData.saasMetrics.subscriptionsByTier[\n                              tier\n                            ] || 0,\n                        }))}\n                        cx=\"50%\"\n                        cy=\"50%\"\n                        labelLine={false}\n                        label={({ name, value, percent }) =>\n                          `${name}: $${value.toLocaleString()} (${(percent * 100).toFixed(1)}%)`\n                        }\n                        outerRadius={80}\n                        fill=\"#8884d8\"\n                        dataKey=\"value\"\n                      >\n                        {Object.entries(\n                          dashboardData.saasMetrics.revenueByTier,\n                        ).map((entry, index) => {\n                          const colors = [\n                            \"#00C49F\",\n                            \"#0088FE\",\n                            \"#FFBB28\",\n                            \"#FF8042\",\n                            \"#8884D8\",\n                          ];\n                          return (\n                            <Cell\n                              key={`cell-${index}`}\n                              fill={colors[index % colors.length]}\n                            />\n                          );\n                        })}\n                      </Pie>\n                      <Tooltip\n                        formatter={(value, name, props) => [\n                          `$${value.toLocaleString()}`,\n                          `${name} (${props.payload.subscriptions} accounts)`,\n                        ]}\n                        labelFormatter={(label) => `Revenue from ${label}`}\n                      />\n                      <Legend />\n                    </RechartsPieChart>\n                  </ResponsiveContainer>\n                </div>\n                <div className=\"mt-4 space-y-2\">\n                  <div className=\"text-sm font-medium\">Subscription Tiers:</div>\n                  {Object.entries(\n                    dashboardData.saasMetrics.subscriptionsByTier,\n                  ).map(([tier, count]) => {\n                    const revenue =\n                      dashboardData.saasMetrics.revenueByTier[tier] || 0;\n                    const avgRevenue = count > 0 ? revenue / count : 0;\n                    return (\n                      <div\n                        key={tier}\n                        className=\"flex justify-between items-center text-sm\"\n                      >\n                        <span className=\"flex items-center gap-2\">\n                          <div className=\"w-3 h-3 rounded-full bg-blue-500\" />\n                          {tier\n                            .replace(\"_\", \" \")\n                            .replace(/\\b\\w/g, (l) => l.toUpperCase())}\n                        </span>\n                        <div className=\"text-right\">\n                          <div className=\"font-medium\">{count} accounts</div>\n                          <div className=\"text-xs text-muted-foreground\">\n                            ${revenue.toLocaleString()} total ($\n                            {avgRevenue.toFixed(0)}/avg)\n                          </div>\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              </CardContent>\n            </Card>\n          </div>\n        </TabsContent>\n      </Tabs>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\tools\\AIResumeScorer.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'user' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":66,"column":28,"nodeType":null,"messageId":"unusedVar","endLine":66,"endColumn":32},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":237,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":237,"endColumn":20,"suggestions":[{"fix":{"range":[7754,7794],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":262,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":262,"endColumn":20,"suggestions":[{"fix":{"range":[8289,8327],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":303,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":303,"endColumn":20,"suggestions":[{"fix":{"range":[9318,9361],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":328,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":328,"endColumn":20,"suggestions":[{"fix":{"range":[9976,10021],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":496,"column":27,"nodeType":"JSXOpeningElement","endLine":496,"endColumn":77},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":527,"column":27,"nodeType":"JSXOpeningElement","endLine":527,"endColumn":77},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":594,"column":27,"nodeType":"JSXOpeningElement","endLine":594,"endColumn":77},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":887,"column":66,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[34309,34325],"text":"What you&apos;ll get:"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[34309,34325],"text":"What you&lsquo;ll get:"},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[34309,34325],"text":"What you&#39;ll get:"},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[34309,34325],"text":"What you&rsquo;ll get:"},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":8,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\nimport {\n  ArrowLeft,\n  Brain,\n  Loader2,\n  Upload,\n  Star,\n  CheckCircle2,\n  AlertTriangle,\n  TrendingUp,\n} from \"lucide-react\";\nimport { Link, useLocation } from \"react-router-dom\";\nimport { useSEO } from \"@/lib/seo\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Progress } from \"@/components/ui/progress\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport AuthOverlay from \"@/components/AuthOverlay\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\nimport { resumeService } from \"@/lib/services/resume-service\";\nimport { useQuery } from \"@tanstack/react-query\";\n\ninterface ResumeScore {\n  overallScore: number;\n  atsCompatibility: number;\n  contentQuality: number;\n  keywordScore: number;\n  formatScore: number;\n  impactScore: number;\n  grade: string;\n  strengths: string[];\n  weaknesses: string[];\n  recommendations: ScoreRecommendation[];\n}\n\ninterface ScoreRecommendation {\n  category: \"critical\" | \"important\" | \"minor\";\n  title: string;\n  description: string;\n  impact: number;\n}\n\nexport default function AIResumeScorer() {\n  const location = useLocation();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { isAuthenticated, user } = useAuth();\n\n  // SEO for AI resume scorer page\n  useSEO(location.pathname);\n\n  const [file, setFile] = useState<File | null>(null);\n  const [resumeText, setResumeText] = useState(\"\");\n  const [selectedResumeId, setSelectedResumeId] = useState(\"\");\n  const [scoreResult, setScoreResult] = useState<ResumeScore | null>(null);\n  const [isScoring, setIsScoring] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [showAuthOverlay, setShowAuthOverlay] = useState(false);\n\n  // Fetch user's resumes if authenticated\n  const { data: resumes } = useQuery({\n    queryKey: [\"resumes\"],\n    queryFn: () => resumeService.getUserResumes(),\n    enabled: isAuthenticated,\n  });\n\n  const handleFileChange = (event: React.ChangeEvent<HTMLInputElement>) => {\n    const selectedFile = event.target.files?.[0];\n    if (selectedFile) {\n      // Validate file type\n      const allowedTypes = [\n        \"application/pdf\",\n        \"application/msword\",\n        \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\",\n        \"text/plain\",\n      ];\n\n      if (!allowedTypes.includes(selectedFile.type)) {\n        setError(\"Please upload a PDF, Word document, or text file.\");\n        return;\n      }\n\n      // Validate file size (10MB limit)\n      if (selectedFile.size > 10 * 1024 * 1024) {\n        setError(\"File size must be less than 10MB.\");\n        return;\n      }\n\n      setFile(selectedFile);\n      setError(null);\n      setScoreResult(null);\n    }\n  };\n\n  const scoreResume = async (content: string) => {\n    const prompt = `You are an expert resume scorer and ATS specialist. Analyze the following resume and provide a comprehensive score.\n\nResume Content: ${content}\n\nPlease analyze and score the resume on:\n1. Overall Score (0-100)\n2. ATS Compatibility (0-100) - How well it passes ATS systems\n3. Content Quality (0-100) - Writing quality, clarity, relevance\n4. Keyword Score (0-100) - Industry keywords and relevance\n5. Format Score (0-100) - Structure, readability, organization\n6. Impact Score (0-100) - Quantified achievements and results\n\nAlso provide:\n- Letter grade (A+, A, B+, B, C+, C, D, F)\n- Top 3 strengths\n- Top 3 weaknesses\n- Specific recommendations for improvement\n\nReturn the response in JSON format with the following structure:\n{\n  \"overallScore\": number,\n  \"atsCompatibility\": number,\n  \"contentQuality\": number,\n  \"keywordScore\": number,\n  \"formatScore\": number,\n  \"impactScore\": number,\n  \"grade\": \"letter grade\",\n  \"strengths\": [\"strength1\", \"strength2\", \"strength3\"],\n  \"weaknesses\": [\"weakness1\", \"weakness2\", \"weakness3\"],\n  \"recommendations\": [\n    {\n      \"category\": \"critical|important|minor\",\n      \"title\": \"recommendation title\",\n      \"description\": \"detailed description\",\n      \"impact\": number (1-10)\n    }\n  ]\n}`;\n\n    try {\n      const response = await fetch(\"/prompt/summarize\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n        },\n        body: JSON.stringify(prompt),\n      });\n\n      if (!response.ok) {\n        throw new Error(\"Failed to score resume\");\n      }\n\n      const result = await response.json();\n\n      // Try to parse as JSON, fallback to mock data if parsing fails\n      try {\n        const parsedResult = JSON.parse(result.result || result);\n        return parsedResult;\n      } catch {\n        // Return mock scoring result\n        const mockScore = {\n          overallScore: Math.floor(Math.random() * 25) + 70, // 70-95\n          atsCompatibility: Math.floor(Math.random() * 20) + 75, // 75-95\n          contentQuality: Math.floor(Math.random() * 30) + 65, // 65-95\n          keywordScore: Math.floor(Math.random() * 35) + 60, // 60-95\n          formatScore: Math.floor(Math.random() * 25) + 70, // 70-95\n          impactScore: Math.floor(Math.random() * 40) + 55, // 55-95\n          grade: \"B+\",\n          strengths: [\n            \"Clear professional experience section\",\n            \"Good use of action verbs\",\n            \"Relevant technical skills listed\",\n          ],\n          weaknesses: [\n            \"Lacks quantified achievements\",\n            \"Missing industry keywords\",\n            \"Could improve formatting consistency\",\n          ],\n          recommendations: [\n            {\n              category: \"critical\",\n              title: \"Add quantified achievements\",\n              description:\n                \"Include specific numbers, percentages, and metrics to demonstrate your impact and results.\",\n              impact: 8,\n            },\n            {\n              category: \"important\",\n              title: \"Optimize for ATS keywords\",\n              description:\n                \"Research and include industry-specific keywords that ATS systems look for in your field.\",\n              impact: 7,\n            },\n            {\n              category: \"important\",\n              title: \"Improve section formatting\",\n              description:\n                \"Use consistent formatting, bullet points, and spacing throughout your resume.\",\n              impact: 6,\n            },\n            {\n              category: \"minor\",\n              title: \"Add professional summary\",\n              description:\n                \"Include a compelling 2-3 line summary at the top highlighting your key qualifications.\",\n              impact: 5,\n            },\n          ],\n        };\n\n        // Adjust grade based on overall score\n        if (mockScore.overallScore >= 90) mockScore.grade = \"A+\";\n        else if (mockScore.overallScore >= 85) mockScore.grade = \"A\";\n        else if (mockScore.overallScore >= 80) mockScore.grade = \"B+\";\n        else if (mockScore.overallScore >= 75) mockScore.grade = \"B\";\n        else if (mockScore.overallScore >= 70) mockScore.grade = \"C+\";\n        else if (mockScore.overallScore >= 65) mockScore.grade = \"C\";\n        else mockScore.grade = \"D\";\n\n        return mockScore;\n      }\n    } catch (error) {\n      console.error(\"Scoring failed:\", error);\n      throw error;\n    }\n  };\n\n  const handleTextScoring = async () => {\n    if (!resumeText.trim()) {\n      setError(\"Please enter resume text to score.\");\n      return;\n    }\n\n    // Check authentication before proceeding\n    if (!isAuthenticated) {\n      setShowAuthOverlay(true);\n      return;\n    }\n\n    setIsScoring(true);\n    setError(null);\n    setScoreResult(null);\n\n    try {\n      const result = await scoreResume(resumeText);\n      setScoreResult(result);\n    } catch (err) {\n      console.error(\"Scoring failed:\", err);\n      setError(\"Failed to score resume. Please try again.\");\n    } finally {\n      setIsScoring(false);\n    }\n  };\n\n  const handleFileScoring = async () => {\n    if (!file) return;\n\n    // Check authentication before proceeding\n    if (!isAuthenticated) {\n      setShowAuthOverlay(true);\n      return;\n    }\n\n    setIsScoring(true);\n    setError(null);\n    setScoreResult(null);\n\n    try {\n      const formData = new FormData();\n      formData.append(\"file\", file);\n\n      // First parse the file to text\n      const parseResponse = await fetch(\"/api/resume/parse\", {\n        method: \"POST\",\n        body: formData,\n      });\n\n      if (!parseResponse.ok) {\n        throw new Error(\"Failed to parse resume file\");\n      }\n\n      const parseResult = await parseResponse.json();\n      const resumeContent = parseResult.result || parseResult;\n\n      // Now score the parsed content\n      const result = await scoreResume(resumeContent);\n      setScoreResult(result);\n    } catch (err) {\n      console.error(\"File scoring failed:\", err);\n      setError(\"Failed to score resume file. Please try again.\");\n    } finally {\n      setIsScoring(false);\n    }\n  };\n\n  const handleResumeScoring = async () => {\n    if (!selectedResumeId) return;\n\n    // Check authentication before proceeding\n    if (!isAuthenticated) {\n      setShowAuthOverlay(true);\n      return;\n    }\n\n    setIsScoring(true);\n    setError(null);\n    setScoreResult(null);\n\n    try {\n      const resume = await resumeService.getResumeById(selectedResumeId);\n      const result = await scoreResume(JSON.stringify(resume.data) || \"\");\n      setScoreResult(result);\n    } catch (err) {\n      console.error(\"Resume scoring failed:\", err);\n      setError(\"Failed to score resume. Please try again.\");\n    } finally {\n      setIsScoring(false);\n    }\n  };\n\n  const removeFile = () => {\n    setFile(null);\n    setError(null);\n    setScoreResult(null);\n  };\n\n  const resetScoring = () => {\n    setFile(null);\n    setResumeText(\"\");\n    setSelectedResumeId(\"\");\n    setError(null);\n    setScoreResult(null);\n  };\n\n  const getScoreColor = (score: number) => {\n    if (score >= 85) return \"text-green-600\";\n    if (score >= 70) return \"text-yellow-600\";\n    return \"text-red-600\";\n  };\n\n  const getGradeColor = (grade: string) => {\n    if (grade.startsWith(\"A\")) return \"text-green-600 bg-green-100\";\n    if (grade.startsWith(\"B\")) return \"text-blue-600 bg-blue-100\";\n    if (grade.startsWith(\"C\")) return \"text-yellow-600 bg-yellow-100\";\n    return \"text-red-600 bg-red-100\";\n  };\n\n  const getRecommendationIcon = (category: string) => {\n    switch (category) {\n      case \"critical\":\n        return <AlertTriangle className=\"h-4 w-4 text-red-600\" />;\n      case \"important\":\n        return <TrendingUp className=\"h-4 w-4 text-yellow-600\" />;\n      default:\n        return <CheckCircle2 className=\"h-4 w-4 text-blue-600\" />;\n    }\n  };\n\n  const getRecommendationBadgeColor = (category: string) => {\n    switch (category) {\n      case \"critical\":\n        return \"bg-red-100 text-red-800\";\n      case \"important\":\n        return \"bg-yellow-100 text-yellow-800\";\n      default:\n        return \"bg-blue-100 text-blue-800\";\n    }\n  };\n\n  const getFileIcon = (file: File) => {\n    if (file.type.includes(\"pdf\")) return \"≡ƒôä\";\n    if (file.type.includes(\"word\")) return \"≡ƒô¥\";\n    if (file.type.includes(\"text\")) return \"≡ƒôä\";\n    return \"≡ƒôä\";\n  };\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className={`pt-16 ${showAuthOverlay ? \"relative\" : \"\"}`}>\n          {showAuthOverlay && (\n            <AuthOverlay\n              contentType=\"resume\"\n              title=\"AI Resume Scorer Tool\"\n              message=\"Sign in to access our AI-powered resume scoring tool and get detailed feedback on your resume's effectiveness.\"\n            />\n          )}\n\n          <div className=\"max-w-6xl mx-auto p-6\">\n            {/* Header */}\n            <div className=\"mb-8\">\n              <div className=\"flex items-center gap-4 mb-4\">\n                <Link to=\"/tools\">\n                  <Button variant=\"outline\" size=\"sm\">\n                    <ArrowLeft className=\"h-4 w-4 mr-2\" />\n                    Back to Tools\n                  </Button>\n                </Link>\n              </div>\n\n              <div className=\"flex items-center gap-3 mb-4\">\n                <div className=\"w-12 h-12 bg-brand-purple/10 rounded-lg flex items-center justify-center\">\n                  <Brain className=\"h-6 w-6 text-brand-purple\" />\n                </div>\n                <div>\n                  <h1 className=\"text-3xl font-bold\">AI Resume Scorer</h1>\n                  <p className=\"text-muted-foreground\">\n                    Get instant AI-powered feedback and scoring for your resume\n                  </p>\n                </div>\n                <Badge\n                  variant=\"secondary\"\n                  className=\"bg-yellow-100 text-yellow-800\"\n                >\n                  Hot\n                </Badge>\n              </div>\n\n              {/* Info Card */}\n              <Card className=\"bg-purple-50 border-purple-200\">\n                <CardContent className=\"p-4\">\n                  <div className=\"flex items-start gap-3\">\n                    <div className=\"w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5\">\n                      <Star className=\"h-4 w-4 text-purple-600\" />\n                    </div>\n                    <div>\n                      <h3 className=\"font-semibold text-purple-900 mb-1\">\n                        How it works\n                      </h3>\n                      <p className=\"text-sm text-purple-800\">\n                        Our AI analyzes your resume across multiple dimensions\n                        including ATS compatibility, content quality, keyword\n                        optimization, and formatting to provide a comprehensive\n                        score and actionable feedback.\n                      </p>\n                    </div>\n                  </div>\n                </CardContent>\n              </Card>\n            </div>\n\n            {/* Main Content */}\n            <div className=\"grid lg:grid-cols-2 gap-8\">\n              {/* Left Column - Scoring Tool */}\n              <div className=\"space-y-6\">\n                <Card>\n                  <CardHeader>\n                    <CardTitle className=\"flex items-center gap-2\">\n                      <Upload className=\"h-5 w-5\" />\n                      Score Your Resume\n                    </CardTitle>\n                  </CardHeader>\n                  <CardContent>\n                    <Tabs\n                      defaultValue={isAuthenticated ? \"existing\" : \"text\"}\n                      className=\"w-full\"\n                    >\n                      <TabsList className=\"grid w-full grid-cols-3\">\n                        <TabsTrigger value=\"text\">Paste Text</TabsTrigger>\n                        <TabsTrigger value=\"upload\">Upload File</TabsTrigger>\n                        <TabsTrigger\n                          value=\"existing\"\n                          disabled={!isAuthenticated}\n                        >\n                          My Resumes {!isAuthenticated && \"(Login Required)\"}\n                        </TabsTrigger>\n                      </TabsList>\n\n                      <TabsContent value=\"text\" className=\"space-y-4\">\n                        <div>\n                          <label className=\"text-sm font-medium mb-2 block\">\n                            Resume Text\n                          </label>\n                          <Textarea\n                            placeholder=\"Paste your resume text here...\"\n                            value={resumeText}\n                            onChange={(e) => setResumeText(e.target.value)}\n                            className=\"min-h-[200px]\"\n                          />\n                        </div>\n                        <Button\n                          onClick={handleTextScoring}\n                          disabled={isScoring || !resumeText.trim()}\n                          className=\"w-full\"\n                        >\n                          {isScoring ? (\n                            <>\n                              <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" />\n                              Scoring Resume...\n                            </>\n                          ) : (\n                            <>\n                              <Brain className=\"h-4 w-4 mr-2\" />\n                              Score My Resume\n                            </>\n                          )}\n                        </Button>\n                      </TabsContent>\n\n                      <TabsContent value=\"upload\" className=\"space-y-4\">\n                        <div>\n                          <label className=\"text-sm font-medium mb-2 block\">\n                            Upload Resume File\n                          </label>\n                          <div className=\"border-2 border-dashed border-border rounded-lg p-6 text-center\">\n                            <input\n                              type=\"file\"\n                              onChange={handleFileChange}\n                              accept=\".pdf,.doc,.docx,.txt\"\n                              className=\"hidden\"\n                              id=\"resume-upload\"\n                            />\n                            <label\n                              htmlFor=\"resume-upload\"\n                              className=\"cursor-pointer\"\n                            >\n                              <Upload className=\"h-8 w-8 mx-auto text-muted-foreground mb-2\" />\n                              <p className=\"text-sm text-muted-foreground\">\n                                Click to upload or drag and drop\n                              </p>\n                              <p className=\"text-xs text-muted-foreground mt-1\">\n                                PDF, Word, or Text files (max 10MB)\n                              </p>\n                            </label>\n                          </div>\n                        </div>\n\n                        {file && (\n                          <div className=\"flex items-center justify-between p-3 bg-muted rounded-lg\">\n                            <div className=\"flex items-center gap-2\">\n                              <span className=\"text-lg\">\n                                {getFileIcon(file)}\n                              </span>\n                              <span className=\"text-sm font-medium\">\n                                {file.name}\n                              </span>\n                            </div>\n                            <Button\n                              variant=\"ghost\"\n                              size=\"sm\"\n                              onClick={removeFile}\n                            >\n                              Remove\n                            </Button>\n                          </div>\n                        )}\n\n                        <Button\n                          onClick={handleFileScoring}\n                          disabled={isScoring || !file}\n                          className=\"w-full\"\n                        >\n                          {isScoring ? (\n                            <>\n                              <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" />\n                              Scoring Resume...\n                            </>\n                          ) : (\n                            <>\n                              <Brain className=\"h-4 w-4 mr-2\" />\n                              Score My Resume\n                            </>\n                          )}\n                        </Button>\n                      </TabsContent>\n\n                      <TabsContent value=\"existing\" className=\"space-y-4\">\n                        <div>\n                          <label className=\"text-sm font-medium mb-2 block\">\n                            Select Resume\n                          </label>\n                          <Select\n                            value={selectedResumeId}\n                            onValueChange={setSelectedResumeId}\n                          >\n                            <SelectTrigger>\n                              <SelectValue placeholder=\"Choose a resume to score\" />\n                            </SelectTrigger>\n                            <SelectContent>\n                              {resumes?.map((resume) => (\n                                <SelectItem\n                                  key={resume.id}\n                                  value={resume.id || \"\"}\n                                >\n                                  {resume.name || \"Untitled Resume\"}\n                                </SelectItem>\n                              ))}\n                            </SelectContent>\n                          </Select>\n                        </div>\n\n                        <Button\n                          onClick={handleResumeScoring}\n                          disabled={isScoring || !selectedResumeId}\n                          className=\"w-full\"\n                        >\n                          {isScoring ? (\n                            <>\n                              <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" />\n                              Scoring Resume...\n                            </>\n                          ) : (\n                            <>\n                              <Brain className=\"h-4 w-4 mr-2\" />\n                              Score My Resume\n                            </>\n                          )}\n                        </Button>\n                      </TabsContent>\n                    </Tabs>\n\n                    {error && (\n                      <Alert className=\"mt-4\">\n                        <AlertDescription>{error}</AlertDescription>\n                      </Alert>\n                    )}\n                  </CardContent>\n                </Card>\n              </div>\n\n              {/* Right Column - Results */}\n              <div className=\"space-y-6\">\n                {scoreResult && (\n                  <>\n                    {/* Overall Score */}\n                    <Card>\n                      <CardHeader>\n                        <CardTitle className=\"flex items-center gap-2\">\n                          <Star className=\"h-5 w-5\" />\n                          Your Resume Score\n                        </CardTitle>\n                      </CardHeader>\n                      <CardContent>\n                        <div className=\"text-center p-6 bg-gradient-to-r from-brand-purple/10 to-brand-blue/10 rounded-lg mb-4\">\n                          <div\n                            className={`text-5xl font-bold mb-2 ${getScoreColor(scoreResult.overallScore)}`}\n                          >\n                            {scoreResult.overallScore}\n                          </div>\n                          <div\n                            className={`inline-flex items-center px-3 py-1 rounded-full text-lg font-semibold ${getGradeColor(scoreResult.grade)}`}\n                          >\n                            {scoreResult.grade}\n                          </div>\n                          <p className=\"text-sm text-muted-foreground mt-2\">\n                            Overall Resume Score\n                          </p>\n                        </div>\n\n                        {/* Detailed Scores */}\n                        <div className=\"space-y-3\">\n                          <div>\n                            <div className=\"flex justify-between text-sm mb-1\">\n                              <span>ATS Compatibility</span>\n                              <span\n                                className={getScoreColor(\n                                  scoreResult.atsCompatibility,\n                                )}\n                              >\n                                {scoreResult.atsCompatibility}%\n                              </span>\n                            </div>\n                            <Progress\n                              value={scoreResult.atsCompatibility}\n                              className=\"h-2\"\n                            />\n                          </div>\n\n                          <div>\n                            <div className=\"flex justify-between text-sm mb-1\">\n                              <span>Content Quality</span>\n                              <span\n                                className={getScoreColor(\n                                  scoreResult.contentQuality,\n                                )}\n                              >\n                                {scoreResult.contentQuality}%\n                              </span>\n                            </div>\n                            <Progress\n                              value={scoreResult.contentQuality}\n                              className=\"h-2\"\n                            />\n                          </div>\n\n                          <div>\n                            <div className=\"flex justify-between text-sm mb-1\">\n                              <span>Keywords</span>\n                              <span\n                                className={getScoreColor(\n                                  scoreResult.keywordScore,\n                                )}\n                              >\n                                {scoreResult.keywordScore}%\n                              </span>\n                            </div>\n                            <Progress\n                              value={scoreResult.keywordScore}\n                              className=\"h-2\"\n                            />\n                          </div>\n\n                          <div>\n                            <div className=\"flex justify-between text-sm mb-1\">\n                              <span>Format</span>\n                              <span\n                                className={getScoreColor(\n                                  scoreResult.formatScore,\n                                )}\n                              >\n                                {scoreResult.formatScore}%\n                              </span>\n                            </div>\n                            <Progress\n                              value={scoreResult.formatScore}\n                              className=\"h-2\"\n                            />\n                          </div>\n\n                          <div>\n                            <div className=\"flex justify-between text-sm mb-1\">\n                              <span>Impact</span>\n                              <span\n                                className={getScoreColor(\n                                  scoreResult.impactScore,\n                                )}\n                              >\n                                {scoreResult.impactScore}%\n                              </span>\n                            </div>\n                            <Progress\n                              value={scoreResult.impactScore}\n                              className=\"h-2\"\n                            />\n                          </div>\n                        </div>\n                      </CardContent>\n                    </Card>\n\n                    {/* Strengths & Weaknesses */}\n                    <Card>\n                      <CardHeader>\n                        <CardTitle className=\"flex items-center gap-2\">\n                          <TrendingUp className=\"h-5 w-5\" />\n                          Analysis Summary\n                        </CardTitle>\n                      </CardHeader>\n                      <CardContent>\n                        <div className=\"space-y-4\">\n                          <div>\n                            <h4 className=\"font-semibold text-green-600 mb-2 flex items-center gap-2\">\n                              <CheckCircle2 className=\"h-4 w-4\" />\n                              Strengths\n                            </h4>\n                            <ul className=\"space-y-1\">\n                              {scoreResult.strengths.map((strength, index) => (\n                                <li\n                                  key={index}\n                                  className=\"text-sm text-muted-foreground flex items-start gap-2\"\n                                >\n                                  <span className=\"text-green-600 mt-1\">ΓÇó</span>\n                                  {strength}\n                                </li>\n                              ))}\n                            </ul>\n                          </div>\n\n                          <div>\n                            <h4 className=\"font-semibold text-red-600 mb-2 flex items-center gap-2\">\n                              <AlertTriangle className=\"h-4 w-4\" />\n                              Areas for Improvement\n                            </h4>\n                            <ul className=\"space-y-1\">\n                              {scoreResult.weaknesses.map((weakness, index) => (\n                                <li\n                                  key={index}\n                                  className=\"text-sm text-muted-foreground flex items-start gap-2\"\n                                >\n                                  <span className=\"text-red-600 mt-1\">ΓÇó</span>\n                                  {weakness}\n                                </li>\n                              ))}\n                            </ul>\n                          </div>\n                        </div>\n                      </CardContent>\n                    </Card>\n\n                    {/* Recommendations */}\n                    <Card>\n                      <CardHeader>\n                        <CardTitle className=\"flex items-center gap-2\">\n                          <CheckCircle2 className=\"h-5 w-5\" />\n                          Recommendations\n                        </CardTitle>\n                      </CardHeader>\n                      <CardContent>\n                        <div className=\"space-y-4\">\n                          {scoreResult.recommendations.map((rec, index) => (\n                            <div key={index} className=\"border rounded-lg p-4\">\n                              <div className=\"flex items-start gap-3\">\n                                {getRecommendationIcon(rec.category)}\n                                <div className=\"flex-1\">\n                                  <div className=\"flex items-center gap-2 mb-2\">\n                                    <h4 className=\"font-semibold\">\n                                      {rec.title}\n                                    </h4>\n                                    <Badge\n                                      variant=\"secondary\"\n                                      className={getRecommendationBadgeColor(\n                                        rec.category,\n                                      )}\n                                    >\n                                      {rec.category}\n                                    </Badge>\n                                    <Badge\n                                      variant=\"outline\"\n                                      className=\"text-xs\"\n                                    >\n                                      Impact: {rec.impact}/10\n                                    </Badge>\n                                  </div>\n                                  <p className=\"text-sm text-muted-foreground\">\n                                    {rec.description}\n                                  </p>\n                                </div>\n                              </div>\n                            </div>\n                          ))}\n                        </div>\n\n                        <div className=\"flex gap-2 mt-6\">\n                          <Button variant=\"outline\" onClick={resetScoring}>\n                            Score Another Resume\n                          </Button>\n                          <Button\n                            onClick={() => {\n                              const report = `Resume Score Report\\n\\nOverall Score: ${scoreResult.overallScore}% (${scoreResult.grade})\\n\\nDetailed Scores:\\n- ATS Compatibility: ${scoreResult.atsCompatibility}%\\n- Content Quality: ${scoreResult.contentQuality}%\\n- Keywords: ${scoreResult.keywordScore}%\\n- Format: ${scoreResult.formatScore}%\\n- Impact: ${scoreResult.impactScore}%\\n\\nStrengths:\\n${scoreResult.strengths.map((s) => `- ${s}`).join(\"\\n\")}\\n\\nAreas for Improvement:\\n${scoreResult.weaknesses.map((w) => `- ${w}`).join(\"\\n\")}\\n\\nGenerated by MyVideoResume AI Resume Scorer`;\n                              navigator.clipboard.writeText(report);\n                            }}\n                            variant=\"outline\"\n                          >\n                            Copy Report\n                          </Button>\n                        </div>\n                      </CardContent>\n                    </Card>\n                  </>\n                )}\n\n                {!scoreResult && !isScoring && (\n                  <Card>\n                    <CardContent className=\"p-8 text-center\">\n                      <Brain className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                      <h3 className=\"font-semibold mb-2\">Ready to Score</h3>\n                      <p className=\"text-sm text-muted-foreground mb-4\">\n                        Upload a resume file, paste text, or select from your\n                        saved resumes to get instant AI-powered scoring.\n                      </p>\n\n                      <div className=\"text-left bg-muted rounded-lg p-4 mt-4\">\n                        <h4 className=\"font-medium mb-2\">What you'll get:</h4>\n                        <ul className=\"text-sm text-muted-foreground space-y-1\">\n                          <li>ΓÇó Overall resume score and letter grade</li>\n                          <li>ΓÇó ATS compatibility analysis</li>\n                          <li>ΓÇó Content quality assessment</li>\n                          <li>ΓÇó Keyword optimization score</li>\n                          <li>ΓÇó Format and impact evaluation</li>\n                          <li>ΓÇó Personalized improvement recommendations</li>\n                        </ul>\n                      </div>\n                    </CardContent>\n                  </Card>\n                )}\n              </div>\n            </div>\n          </div>\n          <Footer />\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\tools\\JobResumeMatch.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'ArrowRight' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":4,"endColumn":13},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'isAuthenticated' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":50,"column":11,"nodeType":null,"messageId":"unusedVar","endLine":50,"endColumn":26},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'resumeData' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":58,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":58,"endColumn":20},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":112,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":112,"endColumn":20,"suggestions":[{"fix":{"range":[3082,3127],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\nimport {\n  ArrowLeft,\n  ArrowRight,\n  Target,\n  CheckCircle2,\n  Loader2,\n} from \"lucide-react\";\nimport { Link, useLocation } from \"react-router-dom\";\nimport { useSEO } from \"@/lib/seo\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent } from \"@/components/ui/card\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport JobInputStep from \"@/components/tools/JobInputStep\";\nimport ResumeSelectionStep from \"@/components/tools/ResumeSelectionStep\";\nimport MatchResultsStep from \"@/components/tools/MatchResultsStep\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\nimport {\n  matchService,\n  type JobResumeMatchResponse,\n} from \"@/lib/services/match-service\";\n\ntype WizardStep = \"job\" | \"resume\" | \"results\";\n\ninterface JobData {\n  jobId?: string;\n  jobContent?: string;\n  source: \"url\" | \"paste\" | \"file\" | \"existing\";\n}\n\ninterface ResumeData {\n  resumeId?: string;\n  resumeContent?: string;\n  source: \"existing\" | \"paste\" | \"file\";\n}\n\nexport default function JobResumeMatch() {\n  const location = useLocation();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { isAuthenticated } = useAuth();\n\n  // SEO for job resume match page\n  useSEO(location.pathname);\n\n  // Wizard state\n  const [currentStep, setCurrentStep] = useState<WizardStep>(\"job\");\n  const [jobData, setJobData] = useState<JobData | null>(null);\n  const [resumeData, setResumeData] = useState<ResumeData | null>(null);\n  const [matchResult, setMatchResult] = useState<JobResumeMatchResponse | null>(\n    null,\n  );\n\n  // Loading and error states\n  const [isAnalyzing, setIsAnalyzing] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  // Step navigation\n  const steps = [\n    {\n      id: \"job\",\n      title: \"Select Job\",\n      description: \"Choose or input job details\",\n    },\n    {\n      id: \"resume\",\n      title: \"Select Resume\",\n      description: \"Choose or input resume details\",\n    },\n    {\n      id: \"results\",\n      title: \"Match Results\",\n      description: \"View analysis and recommendations\",\n    },\n  ];\n\n  const currentStepIndex = steps.findIndex((step) => step.id === currentStep);\n\n  // Handlers\n  const handleJobSelected = (data: JobData) => {\n    setJobData(data);\n    setError(null);\n    setCurrentStep(\"resume\");\n  };\n\n  const handleResumeSelected = async (data: ResumeData) => {\n    setResumeData(data);\n    setError(null);\n    setIsAnalyzing(true);\n\n    try {\n      // Call the match service with the collected data\n      const result = await matchService.matchJobWithResume({\n        jobId: jobData?.jobId,\n        jobContent: jobData?.jobContent,\n        resumeId: data.resumeId,\n        resumeContent: data.resumeContent,\n      });\n\n      setMatchResult(result);\n      setCurrentStep(\"results\");\n    } catch (err) {\n      console.error(\"Match analysis failed:\", err);\n      setError(\"Failed to analyze job-resume match. Please try again.\");\n    } finally {\n      setIsAnalyzing(false);\n    }\n  };\n\n  const handleStartOver = () => {\n    setCurrentStep(\"job\");\n    setJobData(null);\n    setResumeData(null);\n    setMatchResult(null);\n    setError(null);\n  };\n\n  const handleBackStep = () => {\n    if (currentStep === \"resume\") {\n      setCurrentStep(\"job\");\n      setResumeData(null);\n    } else if (currentStep === \"results\") {\n      setCurrentStep(\"resume\");\n      setMatchResult(null);\n    }\n    setError(null);\n  };\n\n  const canGoBack = currentStep !== \"job\" && currentStep !== \"results\";\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16 p-6\">\n          <div className=\"max-w-4xl mx-auto space-y-8\">\n            {/* Header */}\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-4\">\n                <div className=\"w-12 h-12 bg-brand-purple/10 rounded-lg flex items-center justify-center\">\n                  <Target className=\"h-6 w-6 text-brand-purple\" />\n                </div>\n                <div>\n                  <h1 className=\"text-3xl font-bold\">\n                    Job-Resume Match Analysis\n                  </h1>\n                  <p className=\"text-muted-foreground\">\n                    Discover how well your resume matches a specific job\n                    opportunity\n                  </p>\n                </div>\n              </div>\n              <Link to=\"/tools\">\n                <Button variant=\"outline\">\n                  <ArrowLeft className=\"w-4 h-4 mr-2\" />\n                  Back to Tools\n                </Button>\n              </Link>\n            </div>\n\n            {/* Progress Steps */}\n            <Card>\n              <CardContent className=\"p-6\">\n                <div className=\"flex items-center justify-between\">\n                  {steps.map((step, index) => (\n                    <div key={step.id} className=\"flex items-center\">\n                      <div className=\"flex items-center gap-3\">\n                        <div\n                          className={`w-10 h-10 rounded-full flex items-center justify-center border-2 ${\n                            index < currentStepIndex\n                              ? \"bg-primary border-primary text-primary-foreground\"\n                              : index === currentStepIndex\n                                ? \"border-primary text-primary\"\n                                : \"border-muted-foreground text-muted-foreground\"\n                          }`}\n                        >\n                          {index < currentStepIndex ? (\n                            <CheckCircle2 className=\"h-5 w-5\" />\n                          ) : (\n                            <span className=\"text-sm font-medium\">\n                              {index + 1}\n                            </span>\n                          )}\n                        </div>\n                        <div className=\"hidden sm:block\">\n                          <div\n                            className={`font-medium ${\n                              index <= currentStepIndex\n                                ? \"text-foreground\"\n                                : \"text-muted-foreground\"\n                            }`}\n                          >\n                            {step.title}\n                          </div>\n                          <div className=\"text-sm text-muted-foreground\">\n                            {step.description}\n                          </div>\n                        </div>\n                      </div>\n                      {index < steps.length - 1 && (\n                        <div\n                          className={`w-12 h-0.5 mx-4 ${\n                            index < currentStepIndex ? \"bg-primary\" : \"bg-muted\"\n                          }`}\n                        />\n                      )}\n                    </div>\n                  ))}\n                </div>\n              </CardContent>\n            </Card>\n\n            {/* Step Content */}\n            <div className=\"space-y-6\">\n              {currentStep === \"job\" && (\n                <JobInputStep\n                  onJobSelected={handleJobSelected}\n                  isLoading={isAnalyzing}\n                  error={error}\n                />\n              )}\n\n              {currentStep === \"resume\" && (\n                <ResumeSelectionStep\n                  onResumeSelected={handleResumeSelected}\n                  isLoading={isAnalyzing}\n                  error={error}\n                />\n              )}\n\n              {currentStep === \"results\" && matchResult && (\n                <MatchResultsStep\n                  matchResult={matchResult}\n                  onStartOver={handleStartOver}\n                  isLoading={isAnalyzing}\n                />\n              )}\n\n              {/* Loading State */}\n              {isAnalyzing && (\n                <Card>\n                  <CardContent className=\"p-8 text-center\">\n                    <Loader2 className=\"h-16 w-16 mx-auto text-primary animate-spin mb-4\" />\n                    <h3 className=\"text-lg font-semibold mb-2\">\n                      Analyzing Match...\n                    </h3>\n                    <p className=\"text-muted-foreground\">\n                      Our AI is comparing your resume with the job requirements.\n                      This may take a few moments.\n                    </p>\n                  </CardContent>\n                </Card>\n              )}\n\n              {/* Navigation Buttons */}\n              {canGoBack && !isAnalyzing && (\n                <div className=\"flex justify-between\">\n                  <Button variant=\"outline\" onClick={handleBackStep}>\n                    <ArrowLeft className=\"w-4 h-4 mr-2\" />\n                    Back\n                  </Button>\n                </div>\n              )}\n\n              {/* Error Display */}\n              {error && (\n                <Alert variant=\"destructive\">\n                  <AlertDescription>{error}</AlertDescription>\n                </Alert>\n              )}\n            </div>\n          </div>\n        </div>\n        <Footer />\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\tools\\PdfToJson.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":107,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":107,"endColumn":20,"suggestions":[{"fix":{"range":[3016,3057],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":241,"column":23,"nodeType":"JSXOpeningElement","endLine":241,"endColumn":73},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":417,"column":66,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[15324,15340],"text":"What you&apos;ll get:"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[15324,15340],"text":"What you&lsquo;ll get:"},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[15324,15340],"text":"What you&#39;ll get:"},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[15324,15340],"text":"What you&rsquo;ll get:"},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\nimport {\n  ArrowLeft,\n  FileText,\n  Loader2,\n  Upload,\n  Download,\n  Code,\n} from \"lucide-react\";\nimport { Link, useLocation } from \"react-router-dom\";\nimport { useSEO } from \"@/lib/seo\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Badge } from \"@/components/ui/badge\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport AuthOverlay from \"@/components/AuthOverlay\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\n\nexport default function PdfToJson() {\n  const location = useLocation();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { isAuthenticated } = useAuth();\n\n  // SEO for PDF to JSON page\n  useSEO(location.pathname);\n\n  const [file, setFile] = useState<File | null>(null);\n  const [jsonResult, setJsonResult] = useState<string | null>(null);\n  const [isConverting, setIsConverting] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [showAuthOverlay, setShowAuthOverlay] = useState(false);\n\n  const handleFileChange = (event: React.ChangeEvent<HTMLInputElement>) => {\n    const selectedFile = event.target.files?.[0];\n    if (selectedFile) {\n      // Validate file type\n      const allowedTypes = [\n        \"application/pdf\",\n        \"application/msword\",\n        \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\",\n      ];\n\n      if (!allowedTypes.includes(selectedFile.type)) {\n        setError(\"Please upload a PDF or Word document.\");\n        return;\n      }\n\n      // Validate file size (10MB limit)\n      if (selectedFile.size > 10 * 1024 * 1024) {\n        setError(\"File size must be less than 10MB.\");\n        return;\n      }\n\n      setFile(selectedFile);\n      setError(null);\n      setJsonResult(null);\n    }\n  };\n\n  const handleConversion = async () => {\n    if (!file) return;\n\n    // Check authentication before proceeding\n    if (!isAuthenticated) {\n      setShowAuthOverlay(true);\n      return;\n    }\n\n    setIsConverting(true);\n    setError(null);\n    setJsonResult(null);\n\n    try {\n      const formData = new FormData();\n      formData.append(\"file\", file);\n\n      // Use the resume parse endpoint to convert to JSON\n      const response = await fetch(\"/api/resume/parse\", {\n        method: \"POST\",\n        body: formData,\n      });\n\n      if (!response.ok) {\n        throw new Error(\"Failed to convert document\");\n      }\n\n      const result = await response.json();\n\n      // Format the JSON result nicely\n      const formattedJson =\n        typeof result.result === \"string\"\n          ? result.result\n          : JSON.stringify(result.result, null, 2);\n\n      setJsonResult(formattedJson);\n    } catch (err) {\n      console.error(\"Conversion failed:\", err);\n      setError(\"Failed to convert document. Please try again.\");\n    } finally {\n      setIsConverting(false);\n    }\n  };\n\n  const downloadJson = () => {\n    if (!jsonResult) return;\n\n    const blob = new Blob([jsonResult], { type: \"application/json\" });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\"a\");\n    a.href = url;\n    a.download = `${file?.name?.replace(/\\.[^/.]+$/, \"\") || \"resume\"}.json`;\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    URL.revokeObjectURL(url);\n  };\n\n  const copyToClipboard = () => {\n    if (jsonResult) {\n      navigator.clipboard.writeText(jsonResult);\n    }\n  };\n\n  const removeFile = () => {\n    setFile(null);\n    setError(null);\n    setJsonResult(null);\n  };\n\n  const resetConverter = () => {\n    setFile(null);\n    setError(null);\n    setJsonResult(null);\n  };\n\n  const getFileIcon = (file: File) => {\n    if (file.type.includes(\"pdf\")) return \"≡ƒôä\";\n    if (file.type.includes(\"word\")) return \"≡ƒô¥\";\n    return \"≡ƒôä\";\n  };\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className={`pt-16 ${showAuthOverlay ? \"relative\" : \"\"}`}>\n          {showAuthOverlay && (\n            <AuthOverlay\n              contentType=\"resume\"\n              title=\"Document Converter Tool\"\n              message=\"Sign in to access our document conversion tool and convert your PDF/Word resumes to structured JSON format.\"\n            />\n          )}\n\n          <div className=\"max-w-6xl mx-auto p-6\">\n            {/* Header */}\n            <div className=\"mb-8\">\n              <div className=\"flex items-center gap-4 mb-4\">\n                <Link to=\"/tools\">\n                  <Button variant=\"outline\" size=\"sm\">\n                    <ArrowLeft className=\"h-4 w-4 mr-2\" />\n                    Back to Tools\n                  </Button>\n                </Link>\n              </div>\n\n              <div className=\"flex items-center gap-3 mb-4\">\n                <div className=\"w-12 h-12 bg-brand-orange/10 rounded-lg flex items-center justify-center\">\n                  <Code className=\"h-6 w-6 text-brand-orange\" />\n                </div>\n                <div>\n                  <h1 className=\"text-3xl font-bold\">Document Converter</h1>\n                  <p className=\"text-muted-foreground\">\n                    Convert PDF and Word documents to structured JSON format\n                  </p>\n                </div>\n                <Badge\n                  variant=\"secondary\"\n                  className=\"bg-orange-100 text-orange-800\"\n                >\n                  Beta\n                </Badge>\n              </div>\n\n              {/* Info Card */}\n              <Card className=\"bg-blue-50 border-blue-200\">\n                <CardContent className=\"p-4\">\n                  <div className=\"flex items-start gap-3\">\n                    <div className=\"w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5\">\n                      <FileText className=\"h-4 w-4 text-blue-600\" />\n                    </div>\n                    <div>\n                      <h3 className=\"font-semibold text-blue-900 mb-1\">\n                        How it works\n                      </h3>\n                      <p className=\"text-sm text-blue-800\">\n                        Our AI-powered converter extracts text and structure\n                        from your documents and converts them into JSON Resume\n                        format, making them compatible with modern resume\n                        builders and ATS systems.\n                      </p>\n                    </div>\n                  </div>\n                </CardContent>\n              </Card>\n            </div>\n\n            {/* Main Content */}\n            <div className=\"grid lg:grid-cols-2 gap-8\">\n              {/* Left Column - Upload Tool */}\n              <div className=\"space-y-6\">\n                <Card>\n                  <CardHeader>\n                    <CardTitle className=\"flex items-center gap-2\">\n                      <Upload className=\"h-5 w-5\" />\n                      Upload Document\n                    </CardTitle>\n                  </CardHeader>\n                  <CardContent className=\"space-y-4\">\n                    <div>\n                      <label className=\"text-sm font-medium mb-2 block\">\n                        Select File to Convert\n                      </label>\n                      <div className=\"border-2 border-dashed border-border rounded-lg p-8 text-center\">\n                        <input\n                          type=\"file\"\n                          onChange={handleFileChange}\n                          accept=\".pdf,.doc,.docx\"\n                          className=\"hidden\"\n                          id=\"document-upload\"\n                        />\n                        <label\n                          htmlFor=\"document-upload\"\n                          className=\"cursor-pointer\"\n                        >\n                          <Upload className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                          <p className=\"text-lg font-medium mb-2\">\n                            Click to upload or drag and drop\n                          </p>\n                          <p className=\"text-sm text-muted-foreground\">\n                            PDF or Word documents (max 10MB)\n                          </p>\n                        </label>\n                      </div>\n                    </div>\n\n                    {file && (\n                      <div className=\"flex items-center justify-between p-4 bg-muted rounded-lg\">\n                        <div className=\"flex items-center gap-3\">\n                          <span className=\"text-2xl\">{getFileIcon(file)}</span>\n                          <div>\n                            <p className=\"font-medium\">{file.name}</p>\n                            <p className=\"text-sm text-muted-foreground\">\n                              {(file.size / 1024 / 1024).toFixed(2)} MB\n                            </p>\n                          </div>\n                        </div>\n                        <Button variant=\"ghost\" size=\"sm\" onClick={removeFile}>\n                          Remove\n                        </Button>\n                      </div>\n                    )}\n\n                    <Button\n                      onClick={handleConversion}\n                      disabled={isConverting || !file}\n                      className=\"w-full\"\n                      size=\"lg\"\n                    >\n                      {isConverting ? (\n                        <>\n                          <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" />\n                          Converting...\n                        </>\n                      ) : (\n                        <>\n                          <Code className=\"h-4 w-4 mr-2\" />\n                          Convert to JSON\n                        </>\n                      )}\n                    </Button>\n\n                    {error && (\n                      <Alert>\n                        <AlertDescription>{error}</AlertDescription>\n                      </Alert>\n                    )}\n                  </CardContent>\n                </Card>\n\n                {/* Supported Formats */}\n                <Card>\n                  <CardHeader>\n                    <CardTitle className=\"text-lg\">Supported Formats</CardTitle>\n                  </CardHeader>\n                  <CardContent>\n                    <div className=\"space-y-3\">\n                      <div className=\"flex items-center gap-3\">\n                        <span className=\"text-xl\">≡ƒôä</span>\n                        <div>\n                          <p className=\"font-medium\">PDF Documents</p>\n                          <p className=\"text-sm text-muted-foreground\">\n                            Standard PDF files with text content\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"flex items-center gap-3\">\n                        <span className=\"text-xl\">≡ƒô¥</span>\n                        <div>\n                          <p className=\"font-medium\">Word Documents</p>\n                          <p className=\"text-sm text-muted-foreground\">\n                            .doc and .docx files\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                  </CardContent>\n                </Card>\n              </div>\n\n              {/* Right Column - Results */}\n              <div className=\"space-y-6\">\n                {jsonResult && (\n                  <Card>\n                    <CardHeader>\n                      <div className=\"flex items-center justify-between\">\n                        <CardTitle className=\"flex items-center gap-2\">\n                          <Code className=\"h-5 w-5\" />\n                          JSON Result\n                        </CardTitle>\n                        <div className=\"flex gap-2\">\n                          <Button\n                            variant=\"outline\"\n                            size=\"sm\"\n                            onClick={copyToClipboard}\n                          >\n                            Copy\n                          </Button>\n                          <Button\n                            variant=\"outline\"\n                            size=\"sm\"\n                            onClick={downloadJson}\n                          >\n                            <Download className=\"h-4 w-4 mr-2\" />\n                            Download\n                          </Button>\n                        </div>\n                      </div>\n                    </CardHeader>\n                    <CardContent>\n                      <div className=\"bg-muted rounded-lg p-4 max-h-96 overflow-auto\">\n                        <pre className=\"text-sm whitespace-pre-wrap font-mono\">\n                          {jsonResult}\n                        </pre>\n                      </div>\n\n                      <div className=\"flex gap-2 mt-4\">\n                        <Button variant=\"outline\" onClick={resetConverter}>\n                          Convert Another\n                        </Button>\n                        <Button\n                          onClick={() => {\n                            // Create a resume from this JSON\n                            const blob = new Blob([jsonResult], {\n                              type: \"application/json\",\n                            });\n                            const file = new File([blob], \"resume.json\", {\n                              type: \"application/json\",\n                            });\n\n                            // Navigate to resume creation with this file\n                            const formData = new FormData();\n                            formData.append(\"file\", file);\n\n                            // This would typically redirect to resume builder\n                            window.location.href = \"/resumes/builder/new\";\n                          }}\n                        >\n                          Create Resume from JSON\n                        </Button>\n                      </div>\n                    </CardContent>\n                  </Card>\n                )}\n\n                {!jsonResult && !isConverting && (\n                  <Card>\n                    <CardContent className=\"p-8 text-center\">\n                      <Code className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                      <h3 className=\"font-semibold mb-2\">Ready to Convert</h3>\n                      <p className=\"text-sm text-muted-foreground mb-4\">\n                        Upload a PDF or Word document to convert it to\n                        structured JSON format.\n                      </p>\n\n                      <div className=\"text-left bg-muted rounded-lg p-4 mt-4\">\n                        <h4 className=\"font-medium mb-2\">What you'll get:</h4>\n                        <ul className=\"text-sm text-muted-foreground space-y-1\">\n                          <li>ΓÇó Structured JSON Resume format</li>\n                          <li>ΓÇó Compatible with modern resume builders</li>\n                          <li>ΓÇó ATS-friendly data structure</li>\n                          <li>ΓÇó Easy to edit and customize</li>\n                        </ul>\n                      </div>\n                    </CardContent>\n                  </Card>\n                )}\n              </div>\n            </div>\n          </div>\n          <Footer />\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\tools\\ResumeOptimizer.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":209,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":209,"endColumn":20,"suggestions":[{"fix":{"range":[6770,6815],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":234,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":234,"endColumn":20,"suggestions":[{"fix":{"range":[7338,7381],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":275,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":275,"endColumn":20,"suggestions":[{"fix":{"range":[8406,8454],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":300,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":300,"endColumn":20,"suggestions":[{"fix":{"range":[9100,9150],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'getScoreBackground' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":328,"column":9,"nodeType":null,"messageId":"unusedVar","endLine":328,"endColumn":27},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":441,"column":27,"nodeType":"JSXOpeningElement","endLine":441,"endColumn":77},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":452,"column":27,"nodeType":"JSXOpeningElement","endLine":452,"endColumn":77},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":483,"column":27,"nodeType":"JSXOpeningElement","endLine":483,"endColumn":77},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":530,"column":27,"nodeType":"JSXOpeningElement","endLine":530,"endColumn":77},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":562,"column":27,"nodeType":"JSXOpeningElement","endLine":562,"endColumn":77},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":586,"column":27,"nodeType":"JSXOpeningElement","endLine":586,"endColumn":77},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":801,"column":66,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[30822,30838],"text":"What you&apos;ll get:"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[30822,30838],"text":"What you&lsquo;ll get:"},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[30822,30838],"text":"What you&#39;ll get:"},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[30822,30838],"text":"What you&rsquo;ll get:"},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":11,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\nimport {\n  ArrowLeft,\n  Loader2,\n  Upload,\n  Zap,\n  CheckCircle2,\n  AlertTriangle,\n  TrendingUp,\n} from \"lucide-react\";\nimport { Link, useLocation } from \"react-router-dom\";\nimport { useSEO } from \"@/lib/seo\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Progress } from \"@/components/ui/progress\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport AuthOverlay from \"@/components/AuthOverlay\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\nimport { resumeService } from \"@/lib/services/resume-service\";\nimport { useQuery } from \"@tanstack/react-query\";\n\ninterface OptimizationResult {\n  overallScore: number;\n  atsScore: number;\n  keywordScore: number;\n  formatScore: number;\n  contentScore: number;\n  suggestions: OptimizationSuggestion[];\n  optimizedContent?: string;\n}\n\ninterface OptimizationSuggestion {\n  type: \"critical\" | \"important\" | \"minor\";\n  category: \"ats\" | \"keywords\" | \"format\" | \"content\";\n  title: string;\n  description: string;\n  impact: string;\n}\n\nexport default function ResumeOptimizer() {\n  const location = useLocation();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { isAuthenticated } = useAuth();\n\n  // SEO for resume optimizer page\n  useSEO(location.pathname);\n\n  const [file, setFile] = useState<File | null>(null);\n  const [resumeText, setResumeText] = useState(\"\");\n  const [selectedResumeId, setSelectedResumeId] = useState(\"\");\n  const [jobDescription, setJobDescription] = useState(\"\");\n  const [optimizationResult, setOptimizationResult] =\n    useState<OptimizationResult | null>(null);\n  const [isOptimizing, setIsOptimizing] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [showAuthOverlay, setShowAuthOverlay] = useState(false);\n\n  // Fetch user's resumes if authenticated\n  const { data: resumes } = useQuery({\n    queryKey: [\"resumes\"],\n    queryFn: () => resumeService.getUserResumes(),\n    enabled: isAuthenticated,\n  });\n\n  const handleFileChange = (event: React.ChangeEvent<HTMLInputElement>) => {\n    const selectedFile = event.target.files?.[0];\n    if (selectedFile) {\n      // Validate file type\n      const allowedTypes = [\n        \"application/pdf\",\n        \"application/msword\",\n        \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\",\n        \"text/plain\",\n      ];\n\n      if (!allowedTypes.includes(selectedFile.type)) {\n        setError(\"Please upload a PDF, Word document, or text file.\");\n        return;\n      }\n\n      // Validate file size (10MB limit)\n      if (selectedFile.size > 10 * 1024 * 1024) {\n        setError(\"File size must be less than 10MB.\");\n        return;\n      }\n\n      setFile(selectedFile);\n      setError(null);\n      setOptimizationResult(null);\n    }\n  };\n\n  const optimizeResume = async (content: string) => {\n    const prompt = `You are an expert resume optimizer and ATS specialist. Analyze the following resume and provide optimization suggestions.\n\nResume Content: ${content}\n${jobDescription ? `Job Description: ${jobDescription}` : \"\"}\n\nPlease provide a detailed analysis with:\n1. Overall optimization score (0-100)\n2. ATS compatibility score (0-100)\n3. Keyword optimization score (0-100)\n4. Format score (0-100)\n5. Content quality score (0-100)\n6. Specific suggestions for improvement\n\nReturn the response in JSON format with the following structure:\n{\n  \"overallScore\": number,\n  \"atsScore\": number,\n  \"keywordScore\": number,\n  \"formatScore\": number,\n  \"contentScore\": number,\n  \"suggestions\": [\n    {\n      \"type\": \"critical|important|minor\",\n      \"category\": \"ats|keywords|format|content\",\n      \"title\": \"suggestion title\",\n      \"description\": \"detailed description\",\n      \"impact\": \"expected impact\"\n    }\n  ]\n}`;\n\n    try {\n      const response = await fetch(\"/prompt/summarize\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n        },\n        body: JSON.stringify(prompt),\n      });\n\n      if (!response.ok) {\n        throw new Error(\"Failed to optimize resume\");\n      }\n\n      const result = await response.json();\n\n      // Try to parse as JSON, fallback to mock data if parsing fails\n      try {\n        const parsedResult = JSON.parse(result.result || result);\n        return parsedResult;\n      } catch {\n        // Return mock optimization result\n        return {\n          overallScore: Math.floor(Math.random() * 30) + 60, // 60-90\n          atsScore: Math.floor(Math.random() * 25) + 70, // 70-95\n          keywordScore: Math.floor(Math.random() * 35) + 55, // 55-90\n          formatScore: Math.floor(Math.random() * 20) + 75, // 75-95\n          contentScore: Math.floor(Math.random() * 30) + 65, // 65-95\n          suggestions: [\n            {\n              type: \"critical\",\n              category: \"ats\",\n              title: \"Add more relevant keywords\",\n              description:\n                \"Your resume lacks industry-specific keywords that ATS systems look for. Include terms from the job description.\",\n              impact: \"Could increase ATS pass rate by 25-40%\",\n            },\n            {\n              type: \"important\",\n              category: \"format\",\n              title: \"Use standard section headers\",\n              description:\n                \"Use conventional headers like 'Work Experience' instead of creative alternatives.\",\n              impact: \"Improves ATS parsing accuracy\",\n            },\n            {\n              type: \"important\",\n              category: \"content\",\n              title: \"Quantify achievements\",\n              description:\n                \"Add specific numbers, percentages, and metrics to demonstrate impact.\",\n              impact: \"Makes accomplishments more compelling\",\n            },\n            {\n              type: \"minor\",\n              category: \"keywords\",\n              title: \"Include soft skills\",\n              description:\n                \"Balance technical skills with relevant soft skills mentioned in job postings.\",\n              impact: \"Provides more comprehensive skill coverage\",\n            },\n          ],\n        };\n      }\n    } catch (error) {\n      console.error(\"Optimization failed:\", error);\n      throw error;\n    }\n  };\n\n  const handleTextOptimization = async () => {\n    if (!resumeText.trim()) {\n      setError(\"Please enter resume text to optimize.\");\n      return;\n    }\n\n    // Check authentication before proceeding\n    if (!isAuthenticated) {\n      setShowAuthOverlay(true);\n      return;\n    }\n\n    setIsOptimizing(true);\n    setError(null);\n    setOptimizationResult(null);\n\n    try {\n      const result = await optimizeResume(resumeText);\n      setOptimizationResult(result);\n    } catch (err) {\n      console.error(\"Optimization failed:\", err);\n      setError(\"Failed to optimize resume. Please try again.\");\n    } finally {\n      setIsOptimizing(false);\n    }\n  };\n\n  const handleFileOptimization = async () => {\n    if (!file) return;\n\n    // Check authentication before proceeding\n    if (!isAuthenticated) {\n      setShowAuthOverlay(true);\n      return;\n    }\n\n    setIsOptimizing(true);\n    setError(null);\n    setOptimizationResult(null);\n\n    try {\n      const formData = new FormData();\n      formData.append(\"file\", file);\n\n      // First parse the file to text\n      const parseResponse = await fetch(\"/api/resume/parse\", {\n        method: \"POST\",\n        body: formData,\n      });\n\n      if (!parseResponse.ok) {\n        throw new Error(\"Failed to parse resume file\");\n      }\n\n      const parseResult = await parseResponse.json();\n      const resumeContent = parseResult.result || parseResult;\n\n      // Now optimize the parsed content\n      const result = await optimizeResume(resumeContent);\n      setOptimizationResult(result);\n    } catch (err) {\n      console.error(\"File optimization failed:\", err);\n      setError(\"Failed to optimize resume file. Please try again.\");\n    } finally {\n      setIsOptimizing(false);\n    }\n  };\n\n  const handleResumeOptimization = async () => {\n    if (!selectedResumeId) return;\n\n    // Check authentication before proceeding\n    if (!isAuthenticated) {\n      setShowAuthOverlay(true);\n      return;\n    }\n\n    setIsOptimizing(true);\n    setError(null);\n    setOptimizationResult(null);\n\n    try {\n      const resume = await resumeService.getResumeById(selectedResumeId);\n      const result = await optimizeResume(JSON.stringify(resume.data) || \"\");\n      setOptimizationResult(result);\n    } catch (err) {\n      console.error(\"Resume optimization failed:\", err);\n      setError(\"Failed to optimize resume. Please try again.\");\n    } finally {\n      setIsOptimizing(false);\n    }\n  };\n\n  const removeFile = () => {\n    setFile(null);\n    setError(null);\n    setOptimizationResult(null);\n  };\n\n  const resetOptimization = () => {\n    setFile(null);\n    setResumeText(\"\");\n    setSelectedResumeId(\"\");\n    setJobDescription(\"\");\n    setError(null);\n    setOptimizationResult(null);\n  };\n\n  const getScoreColor = (score: number) => {\n    if (score >= 80) return \"text-green-600\";\n    if (score >= 60) return \"text-yellow-600\";\n    return \"text-red-600\";\n  };\n\n  const getScoreBackground = (score: number) => {\n    if (score >= 80) return \"bg-green-500\";\n    if (score >= 60) return \"bg-yellow-500\";\n    return \"bg-red-500\";\n  };\n\n  const getSuggestionIcon = (type: string) => {\n    switch (type) {\n      case \"critical\":\n        return <AlertTriangle className=\"h-4 w-4 text-red-600\" />;\n      case \"important\":\n        return <TrendingUp className=\"h-4 w-4 text-yellow-600\" />;\n      default:\n        return <CheckCircle2 className=\"h-4 w-4 text-blue-600\" />;\n    }\n  };\n\n  const getSuggestionBadgeColor = (type: string) => {\n    switch (type) {\n      case \"critical\":\n        return \"bg-red-100 text-red-800\";\n      case \"important\":\n        return \"bg-yellow-100 text-yellow-800\";\n      default:\n        return \"bg-blue-100 text-blue-800\";\n    }\n  };\n\n  const getFileIcon = (file: File) => {\n    if (file.type.includes(\"pdf\")) return \"≡ƒôä\";\n    if (file.type.includes(\"word\")) return \"≡ƒô¥\";\n    if (file.type.includes(\"text\")) return \"≡ƒôä\";\n    return \"≡ƒôä\";\n  };\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className={`pt-16 ${showAuthOverlay ? \"relative\" : \"\"}`}>\n          {showAuthOverlay && (\n            <AuthOverlay\n              contentType=\"resume\"\n              title=\"Resume Optimizer Tool\"\n              message=\"Sign in to access our AI-powered resume optimization tool and get detailed ATS compatibility analysis.\"\n            />\n          )}\n\n          <div className=\"max-w-6xl mx-auto p-6\">\n            {/* Header */}\n            <div className=\"mb-8\">\n              <div className=\"flex items-center gap-4 mb-4\">\n                <Link to=\"/tools\">\n                  <Button variant=\"outline\" size=\"sm\">\n                    <ArrowLeft className=\"h-4 w-4 mr-2\" />\n                    Back to Tools\n                  </Button>\n                </Link>\n              </div>\n\n              <div className=\"flex items-center gap-3 mb-4\">\n                <div className=\"w-12 h-12 bg-brand-blue/10 rounded-lg flex items-center justify-center\">\n                  <Zap className=\"h-6 w-6 text-brand-blue\" />\n                </div>\n                <div>\n                  <h1 className=\"text-3xl font-bold\">Resume Optimizer</h1>\n                  <p className=\"text-muted-foreground\">\n                    Optimize your resume for ATS systems and improve your job\n                    search success\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            {/* Main Content */}\n            <div className=\"grid lg:grid-cols-2 gap-8\">\n              {/* Left Column - Optimization Tool */}\n              <div className=\"space-y-6\">\n                <Card>\n                  <CardHeader>\n                    <CardTitle className=\"flex items-center gap-2\">\n                      <Upload className=\"h-5 w-5\" />\n                      Optimize Resume\n                    </CardTitle>\n                  </CardHeader>\n                  <CardContent>\n                    <Tabs\n                      defaultValue={isAuthenticated ? \"existing\" : \"text\"}\n                      className=\"w-full\"\n                    >\n                      <TabsList className=\"grid w-full grid-cols-3\">\n                        <TabsTrigger value=\"text\">Paste Text</TabsTrigger>\n                        <TabsTrigger value=\"upload\">Upload File</TabsTrigger>\n                        <TabsTrigger\n                          value=\"existing\"\n                          disabled={!isAuthenticated}\n                        >\n                          My Resumes {!isAuthenticated && \"(Login Required)\"}\n                        </TabsTrigger>\n                      </TabsList>\n\n                      <TabsContent value=\"text\" className=\"space-y-4\">\n                        <div>\n                          <label className=\"text-sm font-medium mb-2 block\">\n                            Resume Text\n                          </label>\n                          <Textarea\n                            placeholder=\"Paste your resume text here...\"\n                            value={resumeText}\n                            onChange={(e) => setResumeText(e.target.value)}\n                            className=\"min-h-[150px]\"\n                          />\n                        </div>\n                        <div>\n                          <label className=\"text-sm font-medium mb-2 block\">\n                            Job Description (Optional)\n                          </label>\n                          <Textarea\n                            placeholder=\"Paste the job description to get targeted optimization suggestions...\"\n                            value={jobDescription}\n                            onChange={(e) => setJobDescription(e.target.value)}\n                            className=\"min-h-[100px]\"\n                          />\n                        </div>\n                        <Button\n                          onClick={handleTextOptimization}\n                          disabled={isOptimizing || !resumeText.trim()}\n                          className=\"w-full\"\n                        >\n                          {isOptimizing ? (\n                            <>\n                              <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" />\n                              Optimizing...\n                            </>\n                          ) : (\n                            <>\n                              <Zap className=\"h-4 w-4 mr-2\" />\n                              Optimize Resume\n                            </>\n                          )}\n                        </Button>\n                      </TabsContent>\n\n                      <TabsContent value=\"upload\" className=\"space-y-4\">\n                        <div>\n                          <label className=\"text-sm font-medium mb-2 block\">\n                            Upload Resume File\n                          </label>\n                          <div className=\"border-2 border-dashed border-border rounded-lg p-6 text-center\">\n                            <input\n                              type=\"file\"\n                              onChange={handleFileChange}\n                              accept=\".pdf,.doc,.docx,.txt\"\n                              className=\"hidden\"\n                              id=\"resume-upload\"\n                            />\n                            <label\n                              htmlFor=\"resume-upload\"\n                              className=\"cursor-pointer\"\n                            >\n                              <Upload className=\"h-8 w-8 mx-auto text-muted-foreground mb-2\" />\n                              <p className=\"text-sm text-muted-foreground\">\n                                Click to upload or drag and drop\n                              </p>\n                              <p className=\"text-xs text-muted-foreground mt-1\">\n                                PDF, Word, or Text files (max 10MB)\n                              </p>\n                            </label>\n                          </div>\n                        </div>\n\n                        {file && (\n                          <div className=\"flex items-center justify-between p-3 bg-muted rounded-lg\">\n                            <div className=\"flex items-center gap-2\">\n                              <span className=\"text-lg\">\n                                {getFileIcon(file)}\n                              </span>\n                              <span className=\"text-sm font-medium\">\n                                {file.name}\n                              </span>\n                            </div>\n                            <Button\n                              variant=\"ghost\"\n                              size=\"sm\"\n                              onClick={removeFile}\n                            >\n                              Remove\n                            </Button>\n                          </div>\n                        )}\n\n                        <div>\n                          <label className=\"text-sm font-medium mb-2 block\">\n                            Job Description (Optional)\n                          </label>\n                          <Textarea\n                            placeholder=\"Paste the job description to get targeted optimization suggestions...\"\n                            value={jobDescription}\n                            onChange={(e) => setJobDescription(e.target.value)}\n                            className=\"min-h-[100px]\"\n                          />\n                        </div>\n\n                        <Button\n                          onClick={handleFileOptimization}\n                          disabled={isOptimizing || !file}\n                          className=\"w-full\"\n                        >\n                          {isOptimizing ? (\n                            <>\n                              <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" />\n                              Optimizing...\n                            </>\n                          ) : (\n                            <>\n                              <Zap className=\"h-4 w-4 mr-2\" />\n                              Optimize Resume\n                            </>\n                          )}\n                        </Button>\n                      </TabsContent>\n\n                      <TabsContent value=\"existing\" className=\"space-y-4\">\n                        <div>\n                          <label className=\"text-sm font-medium mb-2 block\">\n                            Select Resume\n                          </label>\n                          <Select\n                            value={selectedResumeId}\n                            onValueChange={setSelectedResumeId}\n                          >\n                            <SelectTrigger>\n                              <SelectValue placeholder=\"Choose a resume to optimize\" />\n                            </SelectTrigger>\n                            <SelectContent>\n                              {resumes?.map((resume) => (\n                                <SelectItem\n                                  key={resume.id}\n                                  value={resume.id || \"\"}\n                                >\n                                  {resume.name || \"Untitled Resume\"}\n                                </SelectItem>\n                              ))}\n                            </SelectContent>\n                          </Select>\n                        </div>\n\n                        <div>\n                          <label className=\"text-sm font-medium mb-2 block\">\n                            Job Description (Optional)\n                          </label>\n                          <Textarea\n                            placeholder=\"Paste the job description to get targeted optimization suggestions...\"\n                            value={jobDescription}\n                            onChange={(e) => setJobDescription(e.target.value)}\n                            className=\"min-h-[100px]\"\n                          />\n                        </div>\n\n                        <Button\n                          onClick={handleResumeOptimization}\n                          disabled={isOptimizing || !selectedResumeId}\n                          className=\"w-full\"\n                        >\n                          {isOptimizing ? (\n                            <>\n                              <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" />\n                              Optimizing...\n                            </>\n                          ) : (\n                            <>\n                              <Zap className=\"h-4 w-4 mr-2\" />\n                              Optimize Resume\n                            </>\n                          )}\n                        </Button>\n                      </TabsContent>\n                    </Tabs>\n\n                    {error && (\n                      <Alert className=\"mt-4\">\n                        <AlertDescription>{error}</AlertDescription>\n                      </Alert>\n                    )}\n                  </CardContent>\n                </Card>\n              </div>\n\n              {/* Right Column - Results */}\n              <div className=\"space-y-6\">\n                {optimizationResult && (\n                  <>\n                    {/* Scores Overview */}\n                    <Card>\n                      <CardHeader>\n                        <CardTitle className=\"flex items-center gap-2\">\n                          <TrendingUp className=\"h-5 w-5\" />\n                          Optimization Scores\n                        </CardTitle>\n                      </CardHeader>\n                      <CardContent>\n                        <div className=\"space-y-4\">\n                          {/* Overall Score */}\n                          <div className=\"text-center p-4 bg-muted rounded-lg\">\n                            <div\n                              className={`text-3xl font-bold ${getScoreColor(optimizationResult.overallScore)}`}\n                            >\n                              {optimizationResult.overallScore}%\n                            </div>\n                            <p className=\"text-sm text-muted-foreground\">\n                              Overall Score\n                            </p>\n                          </div>\n\n                          {/* Individual Scores */}\n                          <div className=\"space-y-3\">\n                            <div>\n                              <div className=\"flex justify-between text-sm mb-1\">\n                                <span>ATS Compatibility</span>\n                                <span\n                                  className={getScoreColor(\n                                    optimizationResult.atsScore,\n                                  )}\n                                >\n                                  {optimizationResult.atsScore}%\n                                </span>\n                              </div>\n                              <Progress\n                                value={optimizationResult.atsScore}\n                                className=\"h-2\"\n                              />\n                            </div>\n\n                            <div>\n                              <div className=\"flex justify-between text-sm mb-1\">\n                                <span>Keywords</span>\n                                <span\n                                  className={getScoreColor(\n                                    optimizationResult.keywordScore,\n                                  )}\n                                >\n                                  {optimizationResult.keywordScore}%\n                                </span>\n                              </div>\n                              <Progress\n                                value={optimizationResult.keywordScore}\n                                className=\"h-2\"\n                              />\n                            </div>\n\n                            <div>\n                              <div className=\"flex justify-between text-sm mb-1\">\n                                <span>Format</span>\n                                <span\n                                  className={getScoreColor(\n                                    optimizationResult.formatScore,\n                                  )}\n                                >\n                                  {optimizationResult.formatScore}%\n                                </span>\n                              </div>\n                              <Progress\n                                value={optimizationResult.formatScore}\n                                className=\"h-2\"\n                              />\n                            </div>\n\n                            <div>\n                              <div className=\"flex justify-between text-sm mb-1\">\n                                <span>Content Quality</span>\n                                <span\n                                  className={getScoreColor(\n                                    optimizationResult.contentScore,\n                                  )}\n                                >\n                                  {optimizationResult.contentScore}%\n                                </span>\n                              </div>\n                              <Progress\n                                value={optimizationResult.contentScore}\n                                className=\"h-2\"\n                              />\n                            </div>\n                          </div>\n                        </div>\n                      </CardContent>\n                    </Card>\n\n                    {/* Suggestions */}\n                    <Card>\n                      <CardHeader>\n                        <CardTitle className=\"flex items-center gap-2\">\n                          <CheckCircle2 className=\"h-5 w-5\" />\n                          Optimization Suggestions\n                        </CardTitle>\n                      </CardHeader>\n                      <CardContent>\n                        <div className=\"space-y-4\">\n                          {optimizationResult.suggestions.map(\n                            (suggestion, index) => (\n                              <div\n                                key={index}\n                                className=\"border rounded-lg p-4\"\n                              >\n                                <div className=\"flex items-start gap-3\">\n                                  {getSuggestionIcon(suggestion.type)}\n                                  <div className=\"flex-1\">\n                                    <div className=\"flex items-center gap-2 mb-2\">\n                                      <h4 className=\"font-semibold\">\n                                        {suggestion.title}\n                                      </h4>\n                                      <Badge\n                                        variant=\"secondary\"\n                                        className={getSuggestionBadgeColor(\n                                          suggestion.type,\n                                        )}\n                                      >\n                                        {suggestion.type}\n                                      </Badge>\n                                    </div>\n                                    <p className=\"text-sm text-muted-foreground mb-2\">\n                                      {suggestion.description}\n                                    </p>\n                                    <p className=\"text-xs text-green-600 font-medium\">\n                                      ≡ƒÆí {suggestion.impact}\n                                    </p>\n                                  </div>\n                                </div>\n                              </div>\n                            ),\n                          )}\n                        </div>\n\n                        <div className=\"flex gap-2 mt-6\">\n                          <Button variant=\"outline\" onClick={resetOptimization}>\n                            Optimize Another\n                          </Button>\n                          <Button\n                            onClick={() => {\n                              const report = `Resume Optimization Report\\n\\nOverall Score: ${optimizationResult.overallScore}%\\nATS Score: ${optimizationResult.atsScore}%\\nKeyword Score: ${optimizationResult.keywordScore}%\\nFormat Score: ${optimizationResult.formatScore}%\\nContent Score: ${optimizationResult.contentScore}%\\n\\nSuggestions:\\n${optimizationResult.suggestions.map((s) => `- ${s.title}: ${s.description}`).join(\"\\n\")}`;\n                              navigator.clipboard.writeText(report);\n                            }}\n                            variant=\"outline\"\n                          >\n                            Copy Report\n                          </Button>\n                        </div>\n                      </CardContent>\n                    </Card>\n                  </>\n                )}\n\n                {!optimizationResult && !isOptimizing && (\n                  <Card>\n                    <CardContent className=\"p-8 text-center\">\n                      <Zap className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                      <h3 className=\"font-semibold mb-2\">Ready to Optimize</h3>\n                      <p className=\"text-sm text-muted-foreground mb-4\">\n                        Upload a resume file, paste text, or select from your\n                        saved resumes to get optimization suggestions.\n                      </p>\n\n                      <div className=\"text-left bg-muted rounded-lg p-4 mt-4\">\n                        <h4 className=\"font-medium mb-2\">What you'll get:</h4>\n                        <ul className=\"text-sm text-muted-foreground space-y-1\">\n                          <li>ΓÇó ATS compatibility analysis</li>\n                          <li>ΓÇó Keyword optimization suggestions</li>\n                          <li>ΓÇó Format improvement recommendations</li>\n                          <li>ΓÇó Content quality assessment</li>\n                          <li>ΓÇó Actionable improvement tips</li>\n                        </ul>\n                      </div>\n                    </CardContent>\n                  </Card>\n                )}\n              </div>\n            </div>\n          </div>\n          <Footer />\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\tools\\SalaryCalculator.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'GraduationCap' is defined but never used. Allowed unused vars must match /^_/u.","line":10,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":10,"endColumn":16},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":234,"column":9,"nodeType":"MemberExpression","messageId":"unexpected","endLine":234,"endColumn":22,"suggestions":[{"fix":{"range":[7761,7819],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":235,"column":9,"nodeType":"MemberExpression","messageId":"unexpected","endLine":235,"endColumn":20,"suggestions":[{"fix":{"range":[7828,7874],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":243,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":243,"endColumn":20,"suggestions":[{"fix":{"range":[8053,8102],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":360,"column":23,"nodeType":"JSXOpeningElement","endLine":360,"endColumn":73},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":371,"column":23,"nodeType":"JSXOpeningElement","endLine":371,"endColumn":73},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":400,"column":23,"nodeType":"JSXOpeningElement","endLine":400,"endColumn":73},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":418,"column":23,"nodeType":"JSXOpeningElement","endLine":418,"endColumn":73},{"ruleId":"jsx-a11y/label-has-associated-control","severity":1,"message":"A form label must be associated with a control.","line":436,"column":23,"nodeType":"JSXOpeningElement","endLine":436,"endColumn":73},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":667,"column":66,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[26001,26017],"text":"What you&apos;ll get:"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[26001,26017],"text":"What you&lsquo;ll get:"},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[26001,26017],"text":"What you&#39;ll get:"},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[26001,26017],"text":"What you&rsquo;ll get:"},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":9,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\nimport {\n  ArrowLeft,\n  Calculator,\n  Loader2,\n  DollarSign,\n  TrendingUp,\n  MapPin,\n  Briefcase,\n  GraduationCap,\n} from \"lucide-react\";\nimport { Link, useLocation } from \"react-router-dom\";\nimport { useSEO } from \"@/lib/seo\";\nimport { Alert, AlertDescription } from \"@/components/ui/alert\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Input } from \"@/components/ui/input\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Slider } from \"@/components/ui/slider\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport AuthOverlay from \"@/components/AuthOverlay\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\nimport { aiService } from \"@/lib/services/ai-service\";\n\ninterface SalaryData {\n  baseSalary: number;\n  lowRange: number;\n  highRange: number;\n  marketAverage: number;\n  percentile25: number;\n  percentile75: number;\n  totalCompensation: number;\n  locationAdjustment: number;\n  experienceAdjustment: number;\n  industryComparison: {\n    industry: string;\n    averageSalary: number;\n    difference: number;\n  }[];\n}\n\nexport default function SalaryCalculator() {\n  const location = useLocation();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n  const { isAuthenticated } = useAuth();\n\n  // SEO for salary calculator page\n  useSEO(location.pathname);\n\n  const [jobTitle, setJobTitle] = useState(\"\");\n  const [location_, setLocation] = useState(\"\");\n  const [experience, setExperience] = useState([3]);\n  const [education, setEducation] = useState(\"\");\n  const [industry, setIndustry] = useState(\"\");\n  const [company, setCompany] = useState(\"\");\n  const [salaryData, setSalaryData] = useState<SalaryData | null>(null);\n  const [isCalculating, setIsCalculating] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [showAuthOverlay, setShowAuthOverlay] = useState(false);\n\n  const industries = [\n    \"Technology\",\n    \"Healthcare\",\n    \"Finance\",\n    \"Education\",\n    \"Manufacturing\",\n    \"Retail\",\n    \"Consulting\",\n    \"Government\",\n    \"Non-profit\",\n    \"Media & Entertainment\",\n    \"Real Estate\",\n    \"Transportation\",\n    \"Energy\",\n    \"Telecommunications\",\n    \"Other\",\n  ];\n\n  const educationLevels = [\n    \"High School\",\n    \"Associate Degree\",\n    \"Bachelor's Degree\",\n    \"Master's Degree\",\n    \"PhD/Doctorate\",\n    \"Professional Certification\",\n  ];\n\n  const calculateSalary = async () => {\n    if (!jobTitle.trim() || !location_.trim()) {\n      setError(\"Please enter both job title and location.\");\n      return;\n    }\n\n    // Check authentication before proceeding\n    if (!isAuthenticated) {\n      setShowAuthOverlay(true);\n      return;\n    }\n\n    setIsCalculating(true);\n    setError(null);\n    setSalaryData(null);\n\n    try {\n      // Create AI prompt for salary analysis\n      const prompt = `You are a professional salary analyst with access to current market data. Analyze the following job details and provide a comprehensive salary breakdown in JSON format.\n\nJob Details:\n- Job Title: ${jobTitle}\n- Location: ${location_}\n- Years of Experience: ${experience[0]}\n- Education Level: ${education || \"Not specified\"}\n- Industry: ${industry || \"Not specified\"}\n- Company: ${company || \"Not specified\"}\n\nPlease provide a detailed salary analysis in the following JSON format (return ONLY valid JSON, no additional text):\n\n{\n  \"baseSalary\": [estimated base salary as number],\n  \"lowRange\": [25th percentile salary as number],\n  \"highRange\": [75th percentile salary as number],\n  \"marketAverage\": [market average salary as number],\n  \"percentile25\": [25th percentile as number],\n  \"percentile75\": [75th percentile as number],\n  \"totalCompensation\": [total comp including benefits as number],\n  \"locationAdjustment\": [percentage adjustment for location as number, can be negative],\n  \"experienceAdjustment\": [percentage adjustment for experience as number],\n  \"industryComparison\": [\n    {\"industry\": \"Technology\", \"averageSalary\": [number], \"difference\": [percentage difference as number]},\n    {\"industry\": \"Finance\", \"averageSalary\": [number], \"difference\": [percentage difference as number]},\n    {\"industry\": \"Healthcare\", \"averageSalary\": [number], \"difference\": [percentage difference as number]},\n    {\"industry\": \"Education\", \"averageSalary\": [number], \"difference\": [percentage difference as number]}\n  ]\n}\n\nBase your analysis on current 2024 market data, considering cost of living adjustments, industry standards, and experience premiums. Ensure all numbers are realistic and based on actual market conditions.`;\n\n      // Call AI service\n      const response = await aiService.sendChatMessage(\n        [\n          {\n            role: \"user\",\n            content: prompt,\n          },\n        ],\n        {\n          model: \"meta-llama/llama-3.1-8b-instruct:free\",\n          maxTokens: 1000,\n          temperature: 0.3, // Lower temperature for more consistent numerical outputs\n        },\n      );\n\n      // Parse AI response\n      let aiSalaryData: SalaryData;\n      try {\n        // Extract JSON from response (in case AI adds extra text)\n        const jsonMatch = response.message.match(/\\{[\\s\\S]*\\}/);\n        const jsonString = jsonMatch ? jsonMatch[0] : response.message;\n        aiSalaryData = JSON.parse(jsonString);\n\n        // Validate and sanitize the data\n        if (\n          !aiSalaryData.baseSalary ||\n          typeof aiSalaryData.baseSalary !== \"number\"\n        ) {\n          throw new Error(\"Invalid salary data from AI\");\n        }\n\n        // Ensure all required fields exist with reasonable defaults\n        aiSalaryData = {\n          baseSalary: Math.round(aiSalaryData.baseSalary),\n          lowRange: Math.round(\n            aiSalaryData.lowRange || aiSalaryData.baseSalary * 0.8,\n          ),\n          highRange: Math.round(\n            aiSalaryData.highRange || aiSalaryData.baseSalary * 1.3,\n          ),\n          marketAverage: Math.round(\n            aiSalaryData.marketAverage || aiSalaryData.baseSalary * 1.05,\n          ),\n          percentile25: Math.round(\n            aiSalaryData.percentile25 || aiSalaryData.baseSalary * 0.85,\n          ),\n          percentile75: Math.round(\n            aiSalaryData.percentile75 || aiSalaryData.baseSalary * 1.2,\n          ),\n          totalCompensation: Math.round(\n            aiSalaryData.totalCompensation || aiSalaryData.baseSalary * 1.25,\n          ),\n          locationAdjustment: Math.round(aiSalaryData.locationAdjustment || 0),\n          experienceAdjustment: Math.round(\n            aiSalaryData.experienceAdjustment || experience[0] * 5,\n          ),\n          industryComparison: aiSalaryData.industryComparison || [\n            {\n              industry: \"Technology\",\n              averageSalary: Math.round(aiSalaryData.baseSalary * 1.1),\n              difference: 10,\n            },\n            {\n              industry: \"Finance\",\n              averageSalary: Math.round(aiSalaryData.baseSalary * 1.05),\n              difference: 5,\n            },\n            {\n              industry: \"Healthcare\",\n              averageSalary: Math.round(aiSalaryData.baseSalary * 0.95),\n              difference: -5,\n            },\n            {\n              industry: \"Education\",\n              averageSalary: Math.round(aiSalaryData.baseSalary * 0.8),\n              difference: -20,\n            },\n          ],\n        };\n      } catch (parseError) {\n        console.error(\"Failed to parse AI response:\", parseError);\n        console.log(\"AI Response:\", response.message);\n        throw new Error(\n          \"Failed to parse salary analysis from AI. Please try again.\",\n        );\n      }\n\n      setSalaryData(aiSalaryData);\n    } catch (err) {\n      console.error(\"Salary calculation failed:\", err);\n      setError(\n        err instanceof Error\n          ? err.message\n          : \"Failed to calculate salary. Please try again.\",\n      );\n    } finally {\n      setIsCalculating(false);\n    }\n  };\n\n  const resetCalculator = () => {\n    setJobTitle(\"\");\n    setLocation(\"\");\n    setExperience([3]);\n    setEducation(\"\");\n    setIndustry(\"\");\n    setCompany(\"\");\n    setSalaryData(null);\n    setError(null);\n  };\n\n  const formatSalary = (amount: number) => {\n    return new Intl.NumberFormat(\"en-US\", {\n      style: \"currency\",\n      currency: \"USD\",\n      minimumFractionDigits: 0,\n      maximumFractionDigits: 0,\n    }).format(amount);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className={`pt-16 ${showAuthOverlay ? \"relative\" : \"\"}`}>\n          {showAuthOverlay && (\n            <AuthOverlay\n              contentType=\"resume\"\n              title=\"Salary Calculator Tool\"\n              message=\"Sign in to access our salary calculator and discover your market value with personalized compensation insights.\"\n            />\n          )}\n\n          <div className=\"max-w-6xl mx-auto p-6\">\n            {/* Header */}\n            <div className=\"mb-8\">\n              <div className=\"flex items-center gap-4 mb-4\">\n                <Link to=\"/tools\">\n                  <Button variant=\"outline\" size=\"sm\">\n                    <ArrowLeft className=\"h-4 w-4 mr-2\" />\n                    Back to Tools\n                  </Button>\n                </Link>\n              </div>\n\n              <div className=\"flex items-center gap-3 mb-4\">\n                <div className=\"w-12 h-12 bg-brand-green/10 rounded-lg flex items-center justify-center\">\n                  <Calculator className=\"h-6 w-6 text-brand-green\" />\n                </div>\n                <div>\n                  <h1 className=\"text-3xl font-bold\">\n                    AI-Powered Salary Calculator\n                  </h1>\n                  <p className=\"text-muted-foreground\">\n                    Get AI-driven salary insights based on current market data\n                    and trends\n                  </p>\n                </div>\n              </div>\n\n              {/* Info Card */}\n              <Card className=\"bg-blue-50 border-blue-200\">\n                <CardContent className=\"p-4\">\n                  <div className=\"flex items-start gap-3\">\n                    <div className=\"w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5\">\n                      <DollarSign className=\"h-4 w-4 text-blue-600\" />\n                    </div>\n                    <div>\n                      <h3 className=\"font-semibold text-blue-900 mb-1\">\n                        AI-Powered Analysis\n                      </h3>\n                      <p className=\"text-sm text-blue-800\">\n                        Our AI analyzes current market data, location\n                        cost-of-living, experience premiums, and industry\n                        standards to provide personalized salary estimates and\n                        comprehensive compensation insights.\n                      </p>\n                    </div>\n                  </div>\n                </CardContent>\n              </Card>\n            </div>\n\n            {/* Main Content */}\n            <div className=\"grid lg:grid-cols-2 gap-8\">\n              {/* Left Column - Calculator Form */}\n              <div className=\"space-y-6\">\n                <Card>\n                  <CardHeader>\n                    <CardTitle className=\"flex items-center gap-2\">\n                      <Calculator className=\"h-5 w-5\" />\n                      Calculate Your Salary\n                    </CardTitle>\n                  </CardHeader>\n                  <CardContent className=\"space-y-4\">\n                    <div>\n                      <label className=\"text-sm font-medium mb-2 block\">\n                        Job Title *\n                      </label>\n                      <Input\n                        placeholder=\"e.g., Software Engineer, Marketing Manager\"\n                        value={jobTitle}\n                        onChange={(e) => setJobTitle(e.target.value)}\n                      />\n                    </div>\n\n                    <div>\n                      <label className=\"text-sm font-medium mb-2 block\">\n                        Location *\n                      </label>\n                      <Input\n                        placeholder=\"e.g., San Francisco, CA or New York, NY\"\n                        value={location_}\n                        onChange={(e) => setLocation(e.target.value)}\n                      />\n                    </div>\n\n                    <div>\n                      <label className=\"text-sm font-medium mb-2 block\">\n                        Years of Experience: {experience[0]} years\n                      </label>\n                      <Slider\n                        value={experience}\n                        onValueChange={setExperience}\n                        max={20}\n                        min={0}\n                        step={1}\n                        className=\"w-full\"\n                      />\n                      <div className=\"flex justify-between text-xs text-muted-foreground mt-1\">\n                        <span>0 years</span>\n                        <span>20+ years</span>\n                      </div>\n                    </div>\n\n                    <div>\n                      <label className=\"text-sm font-medium mb-2 block\">\n                        Education Level\n                      </label>\n                      <Select value={education} onValueChange={setEducation}>\n                        <SelectTrigger>\n                          <SelectValue placeholder=\"Select education level\" />\n                        </SelectTrigger>\n                        <SelectContent>\n                          {educationLevels.map((level) => (\n                            <SelectItem key={level} value={level}>\n                              {level}\n                            </SelectItem>\n                          ))}\n                        </SelectContent>\n                      </Select>\n                    </div>\n\n                    <div>\n                      <label className=\"text-sm font-medium mb-2 block\">\n                        Industry\n                      </label>\n                      <Select value={industry} onValueChange={setIndustry}>\n                        <SelectTrigger>\n                          <SelectValue placeholder=\"Select industry\" />\n                        </SelectTrigger>\n                        <SelectContent>\n                          {industries.map((ind) => (\n                            <SelectItem key={ind} value={ind}>\n                              {ind}\n                            </SelectItem>\n                          ))}\n                        </SelectContent>\n                      </Select>\n                    </div>\n\n                    <div>\n                      <label className=\"text-sm font-medium mb-2 block\">\n                        Company (Optional)\n                      </label>\n                      <Input\n                        placeholder=\"e.g., Google, Microsoft, Startup\"\n                        value={company}\n                        onChange={(e) => setCompany(e.target.value)}\n                      />\n                    </div>\n\n                    <Button\n                      onClick={calculateSalary}\n                      disabled={\n                        isCalculating || !jobTitle.trim() || !location_.trim()\n                      }\n                      className=\"w-full\"\n                      size=\"lg\"\n                    >\n                      {isCalculating ? (\n                        <>\n                          <Loader2 className=\"h-4 w-4 mr-2 animate-spin\" />\n                          AI Analyzing...\n                        </>\n                      ) : (\n                        <>\n                          <Calculator className=\"h-4 w-4 mr-2\" />\n                          Get AI Salary Analysis\n                        </>\n                      )}\n                    </Button>\n\n                    {error && (\n                      <Alert>\n                        <AlertDescription>{error}</AlertDescription>\n                      </Alert>\n                    )}\n                  </CardContent>\n                </Card>\n              </div>\n\n              {/* Right Column - Results */}\n              <div className=\"space-y-6\">\n                {salaryData && (\n                  <>\n                    {/* Main Salary Display */}\n                    <Card>\n                      <CardHeader>\n                        <CardTitle className=\"flex items-center gap-2\">\n                          <DollarSign className=\"h-5 w-5\" />\n                          AI Salary Analysis\n                        </CardTitle>\n                      </CardHeader>\n                      <CardContent>\n                        <div className=\"text-center p-6 bg-gradient-to-r from-brand-green/10 to-brand-blue/10 rounded-lg mb-4\">\n                          <div className=\"text-4xl font-bold text-brand-green mb-2\">\n                            {formatSalary(salaryData.baseSalary)}\n                          </div>\n                          <p className=\"text-sm text-muted-foreground\">\n                            Estimated Annual Salary\n                          </p>\n                        </div>\n\n                        <div className=\"grid grid-cols-2 gap-4 text-sm\">\n                          <div className=\"text-center p-3 bg-muted rounded-lg\">\n                            <div className=\"font-semibold\">\n                              {formatSalary(salaryData.lowRange)}\n                            </div>\n                            <div className=\"text-muted-foreground\">\n                              Low Range\n                            </div>\n                          </div>\n                          <div className=\"text-center p-3 bg-muted rounded-lg\">\n                            <div className=\"font-semibold\">\n                              {formatSalary(salaryData.highRange)}\n                            </div>\n                            <div className=\"text-muted-foreground\">\n                              High Range\n                            </div>\n                          </div>\n                        </div>\n                      </CardContent>\n                    </Card>\n\n                    {/* Detailed Breakdown */}\n                    <Card>\n                      <CardHeader>\n                        <CardTitle className=\"flex items-center gap-2\">\n                          <TrendingUp className=\"h-5 w-5\" />\n                          Salary Breakdown\n                        </CardTitle>\n                      </CardHeader>\n                      <CardContent className=\"space-y-4\">\n                        <div className=\"flex justify-between items-center\">\n                          <span>Market Average</span>\n                          <span className=\"font-semibold\">\n                            {formatSalary(salaryData.marketAverage)}\n                          </span>\n                        </div>\n\n                        <div className=\"flex justify-between items-center\">\n                          <span>25th Percentile</span>\n                          <span className=\"font-semibold\">\n                            {formatSalary(salaryData.percentile25)}\n                          </span>\n                        </div>\n\n                        <div className=\"flex justify-between items-center\">\n                          <span>75th Percentile</span>\n                          <span className=\"font-semibold\">\n                            {formatSalary(salaryData.percentile75)}\n                          </span>\n                        </div>\n\n                        <div className=\"flex justify-between items-center border-t pt-3\">\n                          <span>Total Compensation</span>\n                          <span className=\"font-semibold text-brand-green\">\n                            {formatSalary(salaryData.totalCompensation)}\n                          </span>\n                        </div>\n\n                        <div className=\"text-xs text-muted-foreground\">\n                          * Total compensation includes estimated benefits and\n                          bonuses\n                        </div>\n                      </CardContent>\n                    </Card>\n\n                    {/* Adjustments */}\n                    <Card>\n                      <CardHeader>\n                        <CardTitle className=\"flex items-center gap-2\">\n                          <MapPin className=\"h-5 w-5\" />\n                          Salary Adjustments\n                        </CardTitle>\n                      </CardHeader>\n                      <CardContent className=\"space-y-3\">\n                        <div className=\"flex justify-between items-center\">\n                          <span className=\"flex items-center gap-2\">\n                            <MapPin className=\"h-4 w-4\" />\n                            Location Adjustment\n                          </span>\n                          <Badge\n                            variant={\n                              salaryData.locationAdjustment >= 0\n                                ? \"default\"\n                                : \"secondary\"\n                            }\n                          >\n                            {salaryData.locationAdjustment >= 0 ? \"+\" : \"\"}\n                            {salaryData.locationAdjustment}%\n                          </Badge>\n                        </div>\n\n                        <div className=\"flex justify-between items-center\">\n                          <span className=\"flex items-center gap-2\">\n                            <Briefcase className=\"h-4 w-4\" />\n                            Experience Adjustment\n                          </span>\n                          <Badge variant=\"default\">\n                            +{salaryData.experienceAdjustment}%\n                          </Badge>\n                        </div>\n                      </CardContent>\n                    </Card>\n\n                    {/* Industry Comparison */}\n                    <Card>\n                      <CardHeader>\n                        <CardTitle className=\"flex items-center gap-2\">\n                          <Briefcase className=\"h-5 w-5\" />\n                          Industry Comparison\n                        </CardTitle>\n                      </CardHeader>\n                      <CardContent className=\"space-y-3\">\n                        {salaryData.industryComparison.map((comp, index) => (\n                          <div\n                            key={index}\n                            className=\"flex justify-between items-center\"\n                          >\n                            <span>{comp.industry}</span>\n                            <div className=\"flex items-center gap-2\">\n                              <span className=\"font-semibold\">\n                                {formatSalary(comp.averageSalary)}\n                              </span>\n                              <Badge\n                                variant={\n                                  comp.difference >= 0 ? \"default\" : \"secondary\"\n                                }\n                                className={\n                                  comp.difference >= 0\n                                    ? \"bg-green-100 text-green-800\"\n                                    : \"bg-red-100 text-red-800\"\n                                }\n                              >\n                                {comp.difference >= 0 ? \"+\" : \"\"}\n                                {comp.difference}%\n                              </Badge>\n                            </div>\n                          </div>\n                        ))}\n                      </CardContent>\n                    </Card>\n\n                    <div className=\"flex gap-2\">\n                      <Button variant=\"outline\" onClick={resetCalculator}>\n                        Calculate Another\n                      </Button>\n                      <Button\n                        onClick={() => {\n                          const report = `Salary Report for ${jobTitle} in ${location_}\\n\\nEstimated Salary: ${formatSalary(salaryData.baseSalary)}\\nSalary Range: ${formatSalary(salaryData.lowRange)} - ${formatSalary(salaryData.highRange)}\\nTotal Compensation: ${formatSalary(salaryData.totalCompensation)}\\n\\nGenerated by MyVideoResume Salary Calculator`;\n                          navigator.clipboard.writeText(report);\n                        }}\n                        variant=\"outline\"\n                      >\n                        Copy Report\n                      </Button>\n                    </div>\n                  </>\n                )}\n\n                {!salaryData && !isCalculating && (\n                  <Card>\n                    <CardContent className=\"p-8 text-center\">\n                      <Calculator className=\"h-12 w-12 mx-auto text-muted-foreground mb-4\" />\n                      <h3 className=\"font-semibold mb-2\">Ready to Calculate</h3>\n                      <p className=\"text-sm text-muted-foreground mb-4\">\n                        Enter your job details to get personalized salary\n                        insights and market data.\n                      </p>\n\n                      <div className=\"text-left bg-muted rounded-lg p-4 mt-4\">\n                        <h4 className=\"font-medium mb-2\">What you'll get:</h4>\n                        <ul className=\"text-sm text-muted-foreground space-y-1\">\n                          <li>ΓÇó Estimated salary range for your role</li>\n                          <li>ΓÇó Location-based adjustments</li>\n                          <li>ΓÇó Industry comparisons</li>\n                          <li>ΓÇó Experience level impact</li>\n                          <li>ΓÇó Total compensation estimates</li>\n                        </ul>\n                      </div>\n                    </CardContent>\n                  </Card>\n                )}\n              </div>\n            </div>\n\n            {/* AI Disclaimer */}\n            {salaryData && (\n              <div className=\"mt-8\">\n                <Alert className=\"bg-amber-50 border-amber-200\">\n                  <AlertDescription className=\"text-amber-800\">\n                    <strong>AI-Generated Estimates:</strong> These salary\n                    estimates are generated by AI based on market analysis and\n                    should be used as a general guide. Actual salaries may vary\n                    based on specific company policies, negotiation, additional\n                    skills, and current market conditions. We recommend using\n                    multiple sources and conducting your own research for the\n                    most accurate salary information.\n                  </AlertDescription>\n                </Alert>\n              </div>\n            )}\n          </div>\n          <Footer />\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\tools\\SentimentAnalysis.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'user' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":48,"column":28,"nodeType":null,"messageId":"unusedVar","endLine":48,"endColumn":32},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":135,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":135,"endColumn":20,"suggestions":[{"fix":{"range":[4028,4077],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":160,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":160,"endColumn":20,"suggestions":[{"fix":{"range":[4646,4702],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":475,"column":72,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[18455,18625],"text":"\n                        Our machine learning model analyzes your resume&apos;s\n                        language patterns to determine overall sentiment\n                      "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[18455,18625],"text":"\n                        Our machine learning model analyzes your resume&lsquo;s\n                        language patterns to determine overall sentiment\n                      "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[18455,18625],"text":"\n                        Our machine learning model analyzes your resume&#39;s\n                        language patterns to determine overall sentiment\n                      "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[18455,18625],"text":"\n                        Our machine learning model analyzes your resume&rsquo;s\n                        language patterns to determine overall sentiment\n                      "},"desc":"Repl