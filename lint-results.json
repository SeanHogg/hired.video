ing] = useState(false);\n  const [resendMsg, setResendMsg] = useState<string | null>(null);\n  const email = searchParams.get(\"email\") || \"your email address\";\n  const firstName = searchParams.get(\"firstName\") || \"\";\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16\">\n          <div className=\"flex items-center justify-center min-h-[calc(100vh-200px)] px-4\">\n            <Card className=\"w-full max-w-md\">\n              <CardHeader className=\"text-center\">\n                <div className=\"mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-green-100\">\n                  <CheckCircle className=\"h-6 w-6 text-green-600\" />\n                </div>\n                <CardTitle className=\"text-2xl\">\n                  Welcome{firstName ? ` ${firstName}` : \"\"}!\n                </CardTitle>\n                <CardDescription>\n                  Your account has been created successfully\n                </CardDescription>\n              </CardHeader>\n              <CardContent className=\"space-y-4\">\n                <Alert>\n                  <Mail className=\"h-4 w-4\" />\n                  <AlertDescription>\n                    <strong>Check your email to get started!</strong>\n                    <br />\n                    We've sent a confirmation email to <strong>{email}</strong>\n                  </AlertDescription>\n                </Alert>\n\n                <div className=\"rounded-lg bg-blue-50 p-4\">\n                  <div className=\"flex items-start\">\n                    <Mail className=\"h-5 w-5 text-blue-600 mt-0.5 mr-3\" />\n                    <div>\n                      <p className=\"text-sm font-medium text-blue-800\">\n                        Next Steps:\n                      </p>\n                      <ol className=\"text-sm text-blue-700 mt-1 space-y-1 list-decimal list-inside\">\n                        <li>Check your email inbox (and spam folder)</li>\n                        <li>Click the confirmation link in the email</li>\n                        <li>Sign in to start using your account</li>\n                      </ol>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"space-y-3\">\n                  <div className=\"text-center\">\n                    <p className=\"text-sm text-gray-600 mb-3\">\n                      Didn't receive the email?\n                    </p>\n\n                    <div className=\"flex flex-col sm:flex-row gap-2\">\n                      <Button\n                        variant=\"outline\"\n                        size=\"sm\"\n                        disabled={resending}\n                        onClick={async () => {\n                          setResendMsg(null);\n                          setResending(true);\n                          try {\n                            const ok = await authService.resendEmailVerification();\n                            setResendMsg(ok ? \"Verification email sent.\" : \"Please sign in first to resend the verification email.\");\n                          } catch (e) {\n                            setResendMsg(\"Unable to resend right now. Please try again later.\");\n                          } finally {\n                            setResending(false);\n                          }\n                        }}\n                        className=\"flex-1\"\n                      >\n                        <RefreshCw className=\"h-4 w-4 mr-2\" />\n                        {resending ? \"Sending...\" : \"Resend Email\"}\n                      </Button>\n\n                      {resendMsg && (\n                        <p className=\"text-xs text-muted-foreground text-center mt-2\">\n                          {resendMsg}\n                        </p>\n                      )}\n\n\n                      <Button\n                        variant=\"outline\"\n                        size=\"sm\"\n                        asChild\n                        className=\"flex-1\"\n                      >\n                        <Link to=\"/signup\">Try Different Email</Link>\n                      </Button>\n                    </div>\n                  </div>\n\n                  <div className=\"text-center pt-4 border-t\">\n                    <p className=\"text-sm text-gray-600 mb-2\">\n                      Already confirmed your email?\n                    </p>\n                    <Button asChild className=\"w-full\">\n                      <Link to=\"/login\">Sign In to Your Account</Link>\n                    </Button>\n                  </div>\n\n                  <div className=\"text-center\">\n                    <Link\n                      to=\"/\"\n                      className=\"text-sm text-gray-600 hover:text-gray-500 inline-flex items-center\"\n                    >\n                      <ArrowLeft className=\"h-4 w-4 mr-1\" />\n                      Return to Home\n                    </Link>\n                  </div>\n                </div>\n\n                <div className=\"bg-gray-50 rounded-lg p-3\">\n                  <p className=\"text-xs text-gray-600 text-center\">\n                    <strong>Having trouble?</strong> Contact our support team\n                    for assistance. The confirmation link will expire in 24\n                    hours.\n                  </p>\n                </div>\n              </CardContent>\n            </Card>\n