},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4635,4638],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":7,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Eye, Share2, Edit, Download, Trash2, UserPlus, X, Globe, Lock, Users } from \"lucide-react\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Dialog,\n  DialogContent,\n  DialogHeader,\n  DialogTitle,\n} from \"@/components/ui/dialog\";\nimport { User, USER_ROLES } from \"@/lib/auth\";\nimport type { ResumePrivacy } from \"@/types/resume\";\nimport type { ComponentType } from \"react\";\n\ninterface ContentItem {\n  id: string;\n  ownerId?: string;\n  type: \"resume\" | \"job_description\";\n  contentType: \"video\" | \"text\";\n}\n\ntype ActionVariant = \"outline\" | \"default\" | \"destructive\";\ninterface ModalAction {\n  id: string;\n  label: string;\n  icon: ComponentType<{ className?: string }>;\n  onClick: () => void;\n  variant: ActionVariant;\n}\n\ninterface ActionsModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  item: ContentItem;\n  user: User | null;\n  onView?: () => void;\n  onShare?: () => void;\n  onEdit?: () => void;\n  onDownload?: () => void;\n  onDelete?: () => void;\n  onTrack?: () => void;\n  onChangePrivacy?: (privacy: ResumePrivacy) => void;\n  onPromoteToMaster?: () => void;\n}\n\nexport default function ActionsModal({\n  isOpen,\n  onClose,\n  item,\n  user,\n  onView,\n  onShare,\n  onEdit,\n  onDownload,\n  onDelete,\n  onTrack,\n  onChangePrivacy,\n  onPromoteToMaster,\n}: ActionsModalProps) {\n  // Early return if modal is not open or item is null\n  if (!isOpen || !item) {\n    return (\n      <Dialog open={isOpen} onOpenChange={onClose}>\n        <DialogContent className=\"sm:max-w-md\">\n          <DialogHeader>\n            <DialogTitle>Actions</DialogTitle>\n          </DialogHeader>\n        </DialogContent>\n      </Dialog>\n    );\n  }\n\n  const effectiveOwnerId = (item as any)?.ownerId ?? (item as any)?.userId;\n  const isOwner = Boolean(user && effectiveOwnerId && user.id === effectiveOwnerId);\n  const isRecruiter = user && user.role === USER_ROLES.RECRUITER;\n  const isAuthenticated = !!user;\n\n  const getAvailableActions = (): ModalAction[] => {\n    const actions: Array<{ id: string; label: string; icon: any; onClick: () => void; variant: \"outline\" | \"default\" | \"destructive\" }>= [];\n\n    // View - available to everyone\n    actions.push({\n      id: \"view\",\n      label: \"View\",\n      icon: Eye,\n      onClick: () => {\n        onView?.();\n        onClose();\n      },\n      variant: \"outline\",\n    });\n\n    // Share - available to everyone\n    actions.push({\n      id: \"share\",\n      label: \"Share\",\n      icon: Share2,\n      onClick: () => {\n        onShare?.();\n        onClose();\n      },\n      variant: \"default\",\n    });\n\n    // Owner actions\n    if (isOwner) {\n      actions.push({\n        id: \"edit\",\n        label: \"Edit\",\n        icon: Edit,\n        onClick: () => {\n          onEdit?.();\n          onClose();\n        },\n        variant: \"outline\",\n      });\n\n      actions.push({\n        id: \"download\",\n        label: \"Download\",\n        icon: Download,\n        onClick: () => {\n          onDownload?.();\n          onClose();\n        },\n        variant: \"outline\",\n      });\n\n      // Privacy options group\n      actions.push({ id: \"separator-privacy\", label: \"\", icon: () => null, onClick: () => {}, variant: \"outline\" });\n\n      actions.push({\n        id: \"privacy-public\",\n        label: \"Make Public\",\n        icon: Globe,\n        onClick: () => {\n          onChangePrivacy?.(\"public\");\n          onClose();\n        },\n        variant: \"outline\",\n      });\n      actions.push({\n        id: \"privacy-recruiter\",\n        label: \"Recruiters Only\",\n        icon: Users,\n        onClick: () => {\n          onChangePrivacy?.(\"recruiter_only\");\n          onClose();\n        },\n        variant: \"outline\",\n      });\n      actions.push({\n        id: \"privacy-connections\",\n        label: \"Connections\",\n        icon: Users,\n        onClick: () => {\n          onChangePrivacy?.(\"connections\");\n          onClose();\n        },\n        variant: \"outline\",\n      });\n      actions.push({\n        id: \"privacy-private\",\n        label: \"Make Private\",\n        icon: Lock,\n        onClick: () => {\n          onChangePrivacy?.(\"private\");\n          onClose();\n        },\n        variant: \"outline\",\n      });\n\n      // Promote/Convert to master when the resume is not a master yet (covers variants and orphans)\n      if ((item as any)?.type === \"resume\" && (((item as any)?.isMaster === false) || (item as any)?.parentId)) {\n        actions.push({\n          id: \"promote\",\n          label: \"Promote to Master\",\n          icon: UserPlus,\n          onClick: () => {\n            onPromoteToMaster?.();\n            onClose();\n          },\n          variant: \"outline\",\n        });\n      }\n\n      const deleteLabel = (item as any)?.parentId ? \"Delete Variation\" : \"Delete Resume\";\n      actions.push({\n        id: \"delete\",\n        label: deleteLabel,\n        icon: Trash2,\n        onClick: () => {\n          onDelete?.();\n          // Defer closing to ensure parent state (e.g., opening confirm dialog) applies first\n          setTimeout(() => onClose(), 0);\n        },\n        variant: \"destructive\",\n      });\n    }\n\n    // Recruiter actions (for resumes they don't own)\n    if (isRecruiter && !isOwner && item && item.type === \"resume\") {\n      actions.push({\n        id: \"download\",\n        label: \"Download Resume\",\n        icon: Download,\n        onClick: () => {\n          onDownload?.();\n          onClose();\n        },\n        variant: \"outline\",\n      });\n\n      actions.push({\n        id: \"track\",\n        label: \"Track Candidate\",\n        icon: UserPlus,\n        onClick: () => {\n          onTrack?.();\n          onClose();\n        },\n        variant: \"default\",\n      });\n    }\n\n    return actions;\n  };\n\n  const actions = getAvailableActions();\n\n  return (\n    <Dialog open={isOpen} onOpenChange={onClose}>\n      <DialogContent className=\"sm:max-w-md\">\n        <DialogHeader>\n          <div className=\"flex items-center justify-between\">\n            <DialogTitle className=\"text-xl font-bold\">Actions</DialogTitle>\n            <Button\n              variant=\"ghost\"\n              size=\"icon\"\n              onClick={onClose}\n              className=\"h-8 w-8\"\n            >\n              <X className=\"h-4 w-4\" />\n            </Button>\n          </div>\n        </DialogHeader>\n\n        <div className=\"space-y-3 pt-4\">\n          {actions.filter(a => !a.id.startsWith(\"separator\")).map((action) => (\n            <Button\n              key={action.id}\n              variant={action.variant}\n              onClick={action.onClick}\n              className=\"w-full justify-start gap-3 h-12\"\n              size=\"lg\"\n            >\n              <action.icon className=\"h-5 w-5\" />\n              {action.label}\n            </Button>\n          ))}\n        </div>\n\n        {!isAuthenticated && (\n          <div className=\"mt-6 p-4 bg-muted rounded-lg\">\n            <p className=\"text-sm text-muted-foreground text-center\">\n              <strong>Sign in</strong> to access more actions like downloading\n              and tracking candidates.\n            </p>\n          </div>\n        )}\n      </DialogContent>\n    </Dialog>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\AuthOverlay.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\CompanyCard.tsx","messages":[{"ruleId":"no-alert","severity":1,"message":"Unexpected prompt.","line":193,"column":19,"nodeType":"CallExpression","messageId":"unexpected","endLine":193,"endColumn":49}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  MapPin,\n  Users,\n  Eye,\n  Briefcase,\n  UserCheck,\n  Edit,\n  Calendar,\n  Building2,\n  TrendingUp,\n  AlertCircle,\n  Share,\n} from \"lucide-react\";\nimport { Link, useNavigate } from \"react-router-dom\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport { CardContent } from \"@/components/ui/card\";\nimport { Progress } from \"@/components/ui/progress\";\nimport BaseCard from \"@/components/ui/BaseCard\";\nimport CardHeaderWithAvatar from \"@/components/ui/CardHeaderWithAvatar\";\nimport CardActions from \"@/components/ui/CardActions\";\nimport { useAuth } from \"@/lib/auth\";\nimport { toast } from \"@/components/ui/use-toast\";\nimport type { CompanyMetadata, CompanyWithOwnership } from \"@/types/company\";\nimport type { UserContext, ItemOwnership } from \"@/types/normalized-cards\";\nimport type { DynamicCardAction } from \"@/lib/dynamic-actions\";\n\ninterface CompanyCardProps {\n  company: CompanyMetadata | CompanyWithOwnership;\n  showOwnership?: boolean;\n  actions?: DynamicCardAction[];\n  userContext?: UserContext;\n  itemOwnership?: ItemOwnership;\n   \n  onTrack?: (_companyId: string) => void;\n   \n  onUntrack?: (_companyId: string) => void;\n  onView?: () => void;\n  onActions?: () => void;\n}\n\nexport default function CompanyCard({\n  company,\n  showOwnership = false,\n  actions,\n  userContext: _userContext,  \n  itemOwnership: _itemOwnership,  \n  onTrack: _onTrack,  \n  onUntrack: _onUntrack,  \n  onView,\n  onActions,\n}: CompanyCardProps) {\n  const { user } = useAuth();\n  const navigate = useNavigate();\n\n  // Early return if company is undefined\n  if (!company) {\n    return null;\n  }\n\n  const ownership = \"ownership\" in company ? company.ownership : undefined;\n  const isOwned =\n    ownership === \"owned\" ||\n    (!ownership &&\n      (company.userId === user?.id ||\n        company.teamMembers?.includes(user?.id || \"\")));\n  const isTracked = ownership === \"tracked\";\n  const canEdit = isOwned;\n\n  const getStatusColor = (status: string) => {\n    switch (status) {\n      case \"active\":\n        return \"bg-green-100 text-green-800\";\n      case \"onboarding\":\n        return \"bg-blue-100 text-blue-800\";\n      case \"draft\":\n        return \"bg-orange-100 text-orange-800\";\n      case \"paused\":\n        return \"bg-yellow-100 text-yellow-800\";\n      case \"inactive\":\n        return \"bg-gray-100 text-gray-800\";\n      default:\n        return \"bg-gray-100 text-gray-800\";\n    }\n  };\n\n  const getVisibilityIcon = (visibility: string) => {\n    switch (visibility) {\n      case \"public\":\n        return null;\n      case \"private\":\n        return <Eye className=\"h-3 w-3\" />;\n      case \"draft\":\n        return <Edit className=\"h-3 w-3\" />;\n      default:\n        return null;\n    }\n  };\n\n  const getOnboardingStatus = () => {\n    if (company.status === \"draft\" || company.status === \"onboarding\") {\n      const progress = company.onboardingProgress || 0;\n      return {\n        show: true,\n        progress,\n        message:\n          progress === 100 ? \"Ready to publish\" : `${progress}% complete`,\n      };\n    }\n    return { show: false, progress: 0, message: \"\" };\n  };\n\n  const onboardingStatus = getOnboardingStatus();\n\n  // Prepare badges for header\n  const badges = [];\n\n  if (showOwnership && isTracked) {\n    badges.push({\n      text: \"Following\",\n      variant: \"outline\" as const,\n      className: \"text-xs bg-blue-50 text-blue-700\",\n      icon: UserCheck,\n    });\n  }\n\n  if (\n    canEdit &&\n    (company.status === \"draft\" || company.status === \"onboarding\")\n  ) {\n    badges.push({\n      text: \"Setup Required\",\n      variant: \"outline\" as const,\n      className: \"text-xs bg-orange-50 text-orange-700\",\n      icon: AlertCircle,\n    });\n  }\n\n  badges.push({\n    text: company.status,\n    variant: \"secondary\" as const,\n    className: getStatusColor(company.status),\n  });\n\n  if (getVisibilityIcon(company.visibility)) {\n    badges.push({\n      text: \"\",\n      variant: \"outline\" as const,\n      className: \"text-xs\",\n      icon: () => getVisibilityIcon(company.visibility),\n    });\n  }\n\n  // Use dynamic actions if provided and not empty, otherwise fallback to default actions\n  const cardActions =\n    actions && actions.length > 0\n      ? actions\n      : [\n        {\n          id: \"view\",\n          label: \"View\",\n          variant: \"outline\" as const,\n          icon: Eye,\n          onClick: () => {\n            if (onView) {\n              onView();\n            } else {\n              navigate(`/companies/${company.id}`);\n            }\n          },\n        },\n        {\n          id: \"share\",\n          label: \"Share\",\n          variant: \"default\" as const,\n          icon: Share,\n          onClick: () => {\n            if (onActions) {\n              onActions();\n            } else {\n              // Default share functionality - copy link to clipboard\n              const url = `${window.location.origin}/companies/${company.id}`;\n              navigator.clipboard\n                .writeText(url)\n                .then(() => {\n                  toast({\n                    title: \"Link copied!\",\n                    description: \"Company link has been copied to your clipboard.\",\n                  });\n                })\n                .catch(() => {\n                  // Fallback for older browsers\n                  prompt(\"Copy this link:\", url);\n                });\n            }\n          },\n        },\n      ];\n\n  return (\n    <BaseCard>\n      <CardHeaderWithAvatar\n        title={company.name}\n        subtitle={company.tagline}\n        avatar={{\n          src: company.logo,\n          fallback: company.name.substring(0, 2).toUpperCase(),\n          size: \"md\",\n        }}\n        badges={badges}\n        linkTo={`/companies/${company.id}`}\n      />\n\n      <CardContent>\n        <div className=\"space-y-3\">\n          {/* Company Details */}\n          <div className=\"flex items-center flex-wrap gap-4 text-xs text-muted-foreground\">\n            <div className=\"flex items-center gap-1 min-w-0\">\n              <Building2 className=\"h-3 w-3 flex-shrink-0\" />\n              <span className=\"truncate\">{company.industry}</span>\n            </div>\n            <div className=\"flex items-center gap-1 min-w-0\">\n              <Users className=\"h-3 w-3 flex-shrink-0\" />\n              <span className=\"truncate\">{company.size}</span>\n            </div>\n            <div className=\"flex items-center gap-1 min-w-0\">\n              <MapPin className=\"h-3 w-3 flex-shrink-0\" />\n              <span className=\"truncate\">{company.location}</span>\n            </div>\n          </div>\n\n          {/* Visibility (status is already shown in header) */}\n          <div className=\"flex items-center gap-1 flex-shrink-0\">\n            {getVisibilityIcon(company.visibility) && (\n              <Badge variant=\"outline\" className=\"text-xs\">\n                {getVisibilityIcon(company.visibility)}\n              </Badge>\n            )}\n          </div>\n        </div>\n\n        {/* Onboarding Progress */}\n        {onboardingStatus.show && canEdit && (\n          <div className=\"mt-3 p-3 bg-orange-50 rounded-lg\">\n            <div className=\"flex items-center justify-between mb-2\">\n              <span className=\"text-sm font-medium text-orange-900\">\n                Company Setup\n              </span>\n              <span className=\"text-xs text-orange-700\">\n                {onboardingStatus.message}\n              </span>\n            </div>\n            <Progress value={onboardingStatus.progress} className=\"h-2\" />\n          </div>\n        )}\n        <div className=\"space-y-3\">\n          {/* Job Statistics */}\n          <div className=\"grid grid-cols-2 gap-4 text-sm\">\n            <div className=\"flex items-center gap-2\">\n              <Briefcase className=\"h-4 w-4 text-muted-foreground\" />\n              <div>\n                <div className=\"font-medium\">{company.activeJobCount}</div>\n                <div className=\"text-xs text-muted-foreground\">Active Jobs</div>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <TrendingUp className=\"h-4 w-4 text-muted-foreground\" />\n              <div>\n                <div className=\"font-medium\">{company.followers}</div>\n                <div className=\"text-xs text-muted-foreground\">Followers</div>\n              </div>\n            </div>\n          </div>\n\n          {/* Company Stats */}\n          <div className=\"flex items-center justify-between text-xs text-muted-foreground pt-2 border-t\">\n            <div className=\"flex items-center gap-4\">\n              <div className=\"flex items-center gap-1\">\n                <Eye className=\"h-3 w-3\" />\n                {company.views} views\n              </div>\n              <div className=\"flex items-center gap-1\">\n                <Calendar className=\"h-3 w-3\" />\n                Founded {new Date(company.createdAt).getFullYear()}\n              </div>\n            </div>\n          </div>\n\n          {/* Quick Actions for Jobs */}\n          {company.activeJobCount > 0 && (\n            <div className=\"pt-2 border-t\">\n              <Button\n                asChild\n                variant=\"ghost\"\n                size=\"sm\"\n                className=\"w-full text-xs\"\n              >\n                <Link to={`/jobs?company=${encodeURIComponent(company.name)}`}>\n                  View {company.activeJobCount} Open Position\n                  {company.activeJobCount !== 1 ? \"s\" : \"\"}\n                </Link>\n              </Button>\n            </div>\n          )}\n        </div>\n      </CardContent>\n\n      <CardActions actions={cardActions} />\n    </BaseCard>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\Copyright.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\CreateVariationDialog.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":67,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":67,"endColumn":20,"suggestions":[{"fix":{"range":[1741,1798],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":92,"column":64,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[2377,2442],"text":"\n            Create a new variation based on your master resume &quot;"},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[2377,2442],"text":"\n            Create a new variation based on your master resume &ldquo;"},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[2377,2442],"text":"\n            Create a new variation based on your master resume &#34;"},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[2377,2442],"text":"\n            Create a new variation based on your master resume &rdquo;"},"desc":"Replace with `&rdquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":92,"column":83,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[2460,2566],"text":"&quot;.\n            This will copy all content from the master resume, which you can then customize.\n          "},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[2460,2566],"text":"&ldquo;.\n            This will copy all content from the master resume, which you can then customize.\n          "},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[2460,2566],"text":"&#34;.\n            This will copy all content from the master resume, which you can then customize.\n          "},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[2460,2566],"text":"&rdquo;.\n            This will copy all content from the master resume, which you can then customize.\n          "},"desc":"Replace with `&rdquo;`."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Dialog,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n} from \"@/components/ui/dialog\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { useToast } from \"@/hooks/use-toast\";\nimport { resumeService } from \"@/lib/services/resume-service\";\n\ninterface CreateVariationDialogProps {\n  isOpen: boolean;\n  onClose: () => void;\n  masterResumeId: string;\n  masterResumeName: string;\n  onVariationCreated: () => void;\n}\n\nexport default function CreateVariationDialog({\n  isOpen,\n  onClose,\n  masterResumeId,\n  masterResumeName,\n  onVariationCreated,\n}: CreateVariationDialogProps) {\n  const [variationName, setVariationName] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [isCreating, setIsCreating] = useState(false);\n  const { toast } = useToast();\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    \n    if (!variationName.trim()) {\n      toast({\n        title: \"Validation Error\",\n        description: \"Please enter a name for the variation.\",\n        variant: \"destructive\",\n      });\n      return;\n    }\n\n    setIsCreating(true);\n\n    try {\n      await resumeService.createResumeVariation(masterResumeId, variationName.trim());\n      \n      toast({\n        title: \"Success\",\n        description: \"Resume variation created successfully!\",\n      });\n\n      // Reset form\n      setVariationName(\"\");\n      setDescription(\"\");\n      \n      // Notify parent component\n      onVariationCreated();\n      onClose();\n    } catch (error) {\n      console.error(\"Error creating resume variation:\", error);\n      toast({\n        title: \"Error\",\n        description: \"Failed to create resume variation. Please try again.\",\n        variant: \"destructive\",\n      });\n    } finally {\n      setIsCreating(false);\n    }\n  };\n\n  const handleClose = () => {\n    if (!isCreating) {\n      setVariationName(\"\");\n      setDescription(\"\");\n      onClose();\n    }\n  };\n\n  return (\n    <Dialog open={isOpen} onOpenChange={handleClose}>\n      <DialogContent className=\"sm:max-w-[425px]\">\n        <DialogHeader>\n          <DialogTitle>Create Resume Variation</DialogTitle>\n          <DialogDescription>\n            Create a new variation based on your master resume \"{masterResumeName}\".\n            This will copy all content from the master resume, which you can then customize.\n          </DialogDescription>\n        </DialogHeader>\n        \n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"variation-name\">Variation Name *</Label>\n            <Input\n              id=\"variation-name\"\n              value={variationName}\n              onChange={(e) => setVariationName(e.target.value)}\n              placeholder=\"e.g., Software Engineer - Frontend Focus\"\n              maxLength={200}\n              disabled={isCreating}\n              required\n            />\n            <p className=\"text-xs text-muted-foreground\">\n              Give your variation a descriptive name that reflects its purpose or target role.\n            </p>\n          </div>\n\n          <div className=\"space-y-2\">\n            <Label htmlFor=\"description\">Description (Optional)</Label>\n            <Textarea\n              id=\"description\"\n              value={description}\n              onChange={(e) => setDescription(e.target.value)}\n              placeholder=\"Describe what makes this variation unique...\"\n              maxLength={1000}\n              disabled={isCreating}\n              rows={3}\n            />\n            <p className=\"text-xs text-muted-foreground\">\n              Optional description to help you remember the purpose of this variation.\n            </p>\n          </div>\n\n          <DialogFooter>\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              onClick={handleClose}\n              disabled={isCreating}\n            >\n              Cancel\n            </Button>\n            <Button type=\"submit\" disabled={isCreating || !variationName.trim()}>\n              {isCreating ? \"Creating...\" : \"Create Variation\"}\n            </Button>\n          </DialogFooter>\n        </form>\n      </DialogContent>\n    </Dialog>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\ErrorBoundary.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'shouldLog' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":64,"column":13,"nodeType":null,"messageId":"unusedVar","endLine":64,"endColumn":22},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":88,"column":5,"nodeType":"MemberExpression","messageId":"unexpected","endLine":88,"endColumn":18,"suggestions":[{"fix":{"range":[2811,3048],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":110,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":110,"endColumn":19,"suggestions":[{"fix":{"range":[3537,3613],"text":""},"messageId":"removeConsole","data":{"propertyName":"warn"},"desc":"Remove the console.warn()."}]},{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":222,"column":61,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[7282,7375],"text":"\n              This component encountered an error and couldn&apos;t render properly.\n            "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[7282,7375],"text":"\n              This component encountered an error and couldn&lsquo;t render properly.\n            "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[7282,7375],"text":"\n              This component encountered an error and couldn&#39;t render properly.\n            "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[7282,7375],"text":"\n              This component encountered an error and couldn&rsquo;t render properly.\n            "},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":250,"column":17,"nodeType":"Identifier","messageId":"namedExport","endLine":250,"endColumn":34},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":272,"column":17,"nodeType":"Identifier","messageId":"namedExport","endLine":272,"endColumn":32}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * React Error Boundary component\n * Catches JavaScript errors anywhere in the child component tree and displays fallback UI\n */\n\nimport { AlertTriangle, RefreshCw, Home } from \"lucide-react\";\nimport React, { Component, type ErrorInfo, type ReactNode } from \"react\";\nimport { Button } from \"@/components/ui/button\";\nimport { normalizeError, handleError, type AppError } from \"@/lib/errors\";\nimport { logger } from \"@/lib/logger\";\nimport { reportError } from \"@/lib/error-tracking\";\n\n// ============================================================================\n// ERROR BOUNDARY PROPS AND STATE\n// ============================================================================\n\ninterface ErrorBoundaryProps {\n  children: ReactNode;\n  fallback?: (error: AppError, retry: () => void) => ReactNode;\n  onError?: (error: AppError, errorInfo: ErrorInfo) => void;\n  level?: \"page\" | \"component\" | \"critical\";\n}\n\ninterface ErrorBoundaryState {\n  hasError: boolean;\n  error: AppError | null;\n  errorId: string | null;\n}\n\n// ============================================================================\n// ERROR BOUNDARY COMPONENT\n// ============================================================================\n\nexport class ErrorBoundary extends Component<\n  ErrorBoundaryProps,\n  ErrorBoundaryState\n> {\n  constructor(props: ErrorBoundaryProps) {\n    super(props);\n    this.state = {\n      hasError: false,\n      error: null,\n      errorId: null,\n    };\n  }\n\n  static getDerivedStateFromError(error: Error): ErrorBoundaryState {\n    const normalizedError = normalizeError(error);\n    const errorId = `error_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;\n\n    return {\n      hasError: true,\n      error: normalizedError,\n      errorId,\n    };\n  }\n\n  componentDidCatch(error: Error, errorInfo: ErrorInfo): void {\n    const normalizedError = normalizeError(error, {\n      componentStack: errorInfo.componentStack,\n      errorBoundary: this.props.level || \"component\",\n    });\n\n    const { shouldLog, shouldReport } = handleError(normalizedError);\n\n    // Always log error boundary errors regardless of status code\n    // Error boundaries catch React errors that may not have HTTP status codes\n    logger.error(\"Error Boundary caught error\", {\n      error: normalizedError.toJSON(),\n      errorInfo,\n      level: this.props.level,\n      errorBoundary: true, // Flag to indicate this came from error boundary\n    });\n\n    // Report error to external service (if configured)\n    if (shouldReport) {\n      this.reportError(normalizedError, errorInfo);\n    }\n\n    // Call custom error handler\n    if (this.props.onError) {\n      this.props.onError(normalizedError, errorInfo);\n    }\n  }\n\n  private reportError = (error: AppError, errorInfo: ErrorInfo): void => {\n    // Log to console for immediate debugging\n    console.error(\"Error Boundary: Error reported to external service\", {\n      error: error.toJSON(),\n      errorInfo,\n      userAgent: navigator.userAgent,\n      url: window.location.href,\n      timestamp: new Date().toISOString(),\n    });\n\n    // Report to Sentry/GlitchTip error tracking service\n    try {\n      reportError(error, {\n        errorBoundary: true,\n        level: this.props.level || \"component\",\n        errorInfo: {\n          componentStack: errorInfo.componentStack,\n        },\n        userAgent: navigator.userAgent,\n        url: window.location.href,\n        timestamp: new Date().toISOString(),\n      });\n    } catch (reportingError) {\n      // Silently fail if error reporting service is unavailable\n      console.warn(\"Failed to report error to external service:\", reportingError);\n    }\n  };\n\n  private handleRetry = (): void => {\n    // Actually reload the current page to retry the failed operation\n    window.location.reload();\n  };\n\n  private handleGoHome = (): void => {\n    window.location.href = \"/\";\n  };\n\n  render(): ReactNode {\n    if (this.state.hasError && this.state.error) {\n      // Use custom fallback if provided\n      if (this.props.fallback) {\n        return this.props.fallback(this.state.error, this.handleRetry);\n      }\n\n      // Default fallback UI based on error level\n      return this.renderDefaultFallback();\n    }\n\n    return this.props.children;\n  }\n\n  private renderDefaultFallback(): ReactNode {\n    const { error, errorId } = this.state;\n    const { level = \"component\" } = this.props;\n\n    if (!error) return null;\n\n    // Critical level - full page error\n    if (level === \"critical\") {\n      return (\n        <div className=\"min-h-screen flex items-center justify-center bg-gray-50 px-4\">\n          <div className=\"max-w-md w-full text-center\">\n            <div className=\"mb-6\">\n              <AlertTriangle className=\"mx-auto h-16 w-16 text-red-500\" />\n            </div>\n            <h1 className=\"text-2xl font-bold text-gray-900 mb-4\">\n              Application Error\n            </h1>\n            <p className=\"text-gray-600 mb-6\">\n              A critical error occurred. Please refresh the page or contact\n              support if the problem persists.\n            </p>\n            <div className=\"space-y-3\">\n              <Button onClick={this.handleRetry} className=\"w-full\">\n                <RefreshCw className=\"mr-2 h-4 w-4\" />\n                Retry\n              </Button>\n              <Button\n                variant=\"outline\"\n                onClick={this.handleGoHome}\n                className=\"w-full\"\n              >\n                <Home className=\"mr-2 h-4 w-4\" />\n                Go Home\n              </Button>\n            </div>\n            {errorId && (\n              <p className=\"text-xs text-gray-400 mt-4\">Error ID: {errorId}</p>\n            )}\n          </div>\n        </div>\n      );\n    }\n\n    // Page level - page error\n    if (level === \"page\") {\n      return (\n        <div className=\"flex items-center justify-center min-h-96 px-4\">\n          <div className=\"max-w-md w-full text-center\">\n            <div className=\"mb-4\">\n              <AlertTriangle className=\"mx-auto h-12 w-12 text-red-500\" />\n            </div>\n            <h2 className=\"text-xl font-semibold text-gray-900 mb-3\">\n              Page Error\n            </h2>\n            <p className=\"text-gray-600 mb-4\">\n              Something went wrong loading this page.\n            </p>\n            <div className=\"space-y-2\">\n              <Button onClick={this.handleRetry} size=\"sm\">\n                <RefreshCw className=\"mr-2 h-4 w-4\" />\n                Try Again\n              </Button>\n              <Button variant=\"outline\" onClick={this.handleGoHome} size=\"sm\">\n                <Home className=\"mr-2 h-4 w-4\" />\n                Go Home\n              </Button>\n            </div>\n            {errorId && (\n              <p className=\"text-xs text-gray-400 mt-3\">Error ID: {errorId}</p>\n            )}\n          </div>\n        </div>\n      );\n    }\n\n    // Component level - inline error\n    return (\n      <div className=\"border border-red-200 rounded-lg p-4 bg-red-50\">\n        <div className=\"flex items-start\">\n          <AlertTriangle className=\"h-5 w-5 text-red-500 mt-0.5 mr-3 flex-shrink-0\" />\n          <div className=\"flex-1\">\n            <h3 className=\"text-sm font-medium text-red-800 mb-1\">\n              Component Error\n            </h3>\n            <p className=\"text-sm text-red-700 mb-3\">\n              This component encountered an error and couldn't render properly.\n            </p>\n            <Button\n              onClick={this.handleRetry}\n              size=\"sm\"\n              variant=\"outline\"\n              className=\"text-red-700 border-red-300 hover:bg-red-100\"\n            >\n              <RefreshCw className=\"mr-1 h-3 w-3\" />\n              Retry\n            </Button>\n            {errorId && (\n              <p className=\"text-xs text-red-600 mt-2\">Error ID: {errorId}</p>\n            )}\n          </div>\n        </div>\n      </div>\n    );\n  }\n}\n\n// ============================================================================\n// HIGHER-ORDER COMPONENT\n// ============================================================================\n\n/**\n * HOC that wraps a component with an error boundary\n */\nexport function withErrorBoundary<P extends object>(\n  Component: React.ComponentType<P>,\n  errorBoundaryProps?: Omit<ErrorBoundaryProps, \"children\">,\n) {\n  const WrappedComponent = (props: P) => (\n    <ErrorBoundary {...errorBoundaryProps}>\n      <Component {...props} />\n    </ErrorBoundary>\n  );\n\n  WrappedComponent.displayName = `withErrorBoundary(${Component.displayName || Component.name})`;\n\n  return WrappedComponent;\n}\n\n// ============================================================================\n// HOOK FOR ERROR HANDLING\n// ============================================================================\n\n/**\n * Hook for handling errors in functional components\n */\nexport function useErrorHandler() {\n  const [error, setError] = React.useState<AppError | null>(null);\n\n  const handleError = React.useCallback((error: unknown) => {\n    const normalizedError = normalizeError(error);\n    setError(normalizedError);\n\n    // Log error\n    logger.error(\"useErrorHandler caught error\", {\n      error: normalizedError.toJSON(),\n    });\n  }, []);\n\n  const clearError = React.useCallback(() => {\n    setError(null);\n  }, []);\n\n  // Throw error to be caught by error boundary\n  if (error) {\n    throw error;\n  }\n\n  return { handleError, clearError };\n}\n\n// ============================================================================\n// EXPORTS\n// ============================================================================\n\nexport default ErrorBoundary;\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\FloatingAIButton.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\Footer.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\HeroCarousel.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'nextSlide'. Either include it or remove the dependency array.","line":123,"column":6,"nodeType":"ArrayExpression","endLine":123,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [nextSlide]","fix":{"range":[3306,3308],"text":"[nextSlide]"}}]},{"ruleId":"@typescript-eslint/prefer-optional-chain","severity":1,"message":"Prefer using an optional chain expression instead, as it's more concise and easier to read.","line":140,"column":9,"nodeType":null,"messageId":"preferOptionalChain","endLine":140,"endColumn":56,"suggestions":[{"fix":{"range":[3706,3753],"text":"e.dataTransfer.files?.[0]"},"messageId":"optionalChainSuggest","desc":"Change to an optional chain."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":151,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":151,"endColumn":18,"suggestions":[{"fix":{"range":[3989,4032],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":204,"column":22,"nodeType":"MemberExpression","messageId":"unexpected","endLine":204,"endColumn":33}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  Sparkles,\n  Eye,\n  Clock,\n  FileText,\n  Plus,\n  ChevronLeft,\n  ChevronRight,\n  Briefcase,\n  Users,\n  TrendingUp,\n  Building2,\n} from \"lucide-react\";\nimport { useState, useEffect } from \"react\";\nimport { useNavigate } from \"react-router-dom\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport { Card, CardContent } from \"@/components/ui/card\";\nimport { cn } from \"@/lib/utils\";\nimport { useAuth } from \"@/lib/auth\";\n\ninterface HeroCarouselProps {\n  totalViews: string;\n  totalItems: number;\n}\n\nexport default function HeroCarousel({\n  totalViews,\n  totalItems,\n}: HeroCarouselProps) {\n  const [currentSlide, setCurrentSlide] = useState(0);\n  const [dragActive, setDragActive] = useState(false);\n  const navigate = useNavigate();\n  const { isAuthenticated } = useAuth();\n\n  const slides = [\n    {\n      id: 1,\n      type: \"main\",\n      title: (\n        <>\n          The Future of{\" \"}\n          <span className=\"bg-gradient-to-r from-brand-purple to-brand-blue bg-clip-text text-transparent\">\n            Talent Management\n          </span>\n        </>\n      ),\n      description:\n        \"Employment-focused social media, referral network, ATS, Recruitment CRM, crowdsourcing, and recruitment marketing features to attract, retain, and promote talent.\",\n      badge: \"All-in-One AI HR Platform\",\n      stats: [\n        { icon: Eye, label: `${totalViews} total views` },\n        { icon: Sparkles, label: `${totalItems} items` },\n        { icon: Clock, label: \"Updated daily\" },\n      ],\n      actions: [\n        {\n          label: \"Get Started\",\n          variant: \"default\" as const,\n          size: \"lg\" as const,\n        },\n        {\n          label: \"Watch Demo\",\n          variant: \"outline\" as const,\n          size: \"lg\" as const,\n        },\n      ],\n    },\n    {\n      id: 2,\n      type: \"upload\",\n      title: \"Upload Your Resume\",\n      description: \"\",\n      badge: \"AI-Powered Resume Videos\",\n    },\n    {\n      id: 3,\n      type: \"features\",\n      title: (\n        <>\n          Complete{\" \"}\n          <span className=\"bg-gradient-to-r from-brand-purple to-brand-blue bg-clip-text text-transparent\">\n            HR Solution\n          </span>\n        </>\n      ),\n      description:\n        \"From talent acquisition to employee engagement, our comprehensive platform covers every aspect of human resources management.\",\n      badge: \"End-to-End Platform\",\n      features: [\n        { icon: Users, label: \"Talent Network\" },\n        { icon: TrendingUp, label: \"Analytics Dashboard\" },\n        { icon: Building2, label: \"Company Profiles\" },\n        { icon: Briefcase, label: \"Job Management\" },\n      ],\n      actions: [\n        {\n          label: \"Explore Features\",\n          variant: \"default\" as const,\n          size: \"lg\" as const,\n        },\n        {\n          label: \"See Pricing\",\n          variant: \"outline\" as const,\n          size: \"lg\" as const,\n        },\n      ],\n    },\n  ];\n\n  const nextSlide = () => {\n    setCurrentSlide((prev) => (prev + 1) % slides.length);\n  };\n\n  const prevSlide = () => {\n    setCurrentSlide((prev) => (prev - 1 + slides.length) % slides.length);\n  };\n\n  // Auto-advance slides\n  useEffect(() => {\n    const timer = setInterval(nextSlide, 6000);\n    return () => clearInterval(timer);\n  }, []);\n\n  const handleDrag = (e: React.DragEvent) => {\n    e.preventDefault();\n    e.stopPropagation();\n    if (e.type === \"dragenter\" || e.type === \"dragover\") {\n      setDragActive(true);\n    } else if (e.type === \"dragleave\") {\n      setDragActive(false);\n    }\n  };\n\n  const handleDrop = (e: React.DragEvent) => {\n    e.preventDefault();\n    e.stopPropagation();\n    setDragActive(false);\n\n    if (e.dataTransfer.files && e.dataTransfer.files[0]) {\n      handleFiles(e.dataTransfer.files);\n    }\n  };\n\n  const handleFiles = (files: FileList) => {\n    const file = files[0];\n    if (\n      file &&\n      (file.type === \"application/pdf\" || file.type.includes(\"word\"))\n    ) {\n      console.log(\"Resume uploaded:\", file.name);\n      // Here you would handle the file upload\n    }\n  };\n\n  // Navigation handlers for CTA buttons\n  const handleGetStarted = () => {\n    if (isAuthenticated) {\n      // If user is logged in, take them to dashboard or profile\n      navigate(\"/dashboard\");\n    } else {\n      // If not logged in, take them to signup\n      navigate(\"/signup\");\n    }\n  };\n\n  const handleWatchDemo = () => {\n    // Navigate to about page or a demo video section\n    navigate(\"/about\");\n  };\n\n  const handleExploreFeatures = () => {\n    // Navigate to pricing page which shows features\n    navigate(\"/pricing\");\n  };\n\n  const handleSeePricing = () => {\n    // Navigate to pricing page\n    navigate(\"/pricing\");\n  };\n\n  const handleGenerateAIVideo = () => {\n    if (isAuthenticated) {\n      // If user is logged in, take them to resume upload/creation\n      navigate(\"/resumes/upload\");\n    } else {\n      // If not logged in, take them to signup first\n      navigate(\"/signup\");\n    }\n  };\n\n  // Helper function to get the appropriate handler for each action\n  const getActionHandler = (label: string) => {\n    switch (label) {\n      case \"Get Started\":\n        return handleGetStarted;\n      case \"Watch Demo\":\n        return handleWatchDemo;\n      case \"Explore Features\":\n        return handleExploreFeatures;\n      case \"See Pricing\":\n        return handleSeePricing;\n      default:\n        return () => console.log(`No handler defined for: ${label}`);\n    }\n  };\n\n  const currentSlideData = slides[currentSlide];\n\n  return (\n    <section className=\"relative pt-12 pb-8 px-4 sm:px-6 lg:px-8 bg-gradient-to-r from-brand-purple/10 to-brand-blue/10 overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto relative min-h-[400px] flex items-center\">\n        {/* Navigation Arrows */}\n        <button\n          onClick={prevSlide}\n          className=\"absolute left-4 top-1/2 -translate-y-1/2 z-10 p-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-foreground hover:bg-white/20 transition-colors\"\n        >\n          <ChevronLeft className=\"w-5 h-5\" />\n        </button>\n\n        <button\n          onClick={nextSlide}\n          className=\"absolute right-4 top-1/2 -translate-y-1/2 z-10 p-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-foreground hover:bg-white/20 transition-colors\"\n        >\n          <ChevronRight className=\"w-5 h-5\" />\n        </button>\n\n        {/* Slide Content */}\n        <div className=\"text-center max-w-4xl mx-auto w-full\">\n          <Badge\n            variant=\"secondary\"\n            className=\"mb-3 px-3 py-1 text-xs font-medium bg-brand-purple-light text-brand-purple-dark\"\n          >\n            <Sparkles className=\"w-3 h-3 mr-1\" />\n            {currentSlideData.badge}\n          </Badge>\n\n          <p className=\"text-2xl sm:text-3xl lg:text-4xl font-bold text-foreground mb-3 leading-tight\">\n            {currentSlideData.title}\n          </p>\n\n          <p className=\"text-base text-muted-foreground mb-4 max-w-2xl mx-auto line-clamp-2\">\n            {currentSlideData.description}\n          </p>\n\n          {/* Slide-specific content */}\n          <div className=\"min-h-[80px] flex items-center justify-center mb-4\">\n            {currentSlideData.type === \"main\" && currentSlideData.stats && (\n              <div className=\"flex items-center justify-center gap-4 text-xs text-muted-foreground\">\n                {currentSlideData.stats.map((stat, index) => (\n                  <div key={index} className=\"flex items-center gap-1\">\n                    <stat.icon className=\"w-3 h-3\" />\n                    <span>{stat.label}</span>\n                  </div>\n                ))}\n              </div>\n            )}\n\n            {currentSlideData.type === \"upload\" && (\n              <div className=\"max-w-sm mx-auto\">\n                <Card className=\"border-dashed border-2 border-primary/30 bg-primary/5\">\n                  <CardContent className=\"pt-4\">\n                    <div\n                      className={cn(\n                        \"border-2 border-dashed rounded-lg p-4 text-center transition-colors\",\n                        dragActive\n                          ? \"border-primary bg-primary/10\"\n                          : \"border-muted-foreground/30 hover:border-primary/50\",\n                      )}\n                      onDragEnter={handleDrag}\n                      onDragLeave={handleDrag}\n                      onDragOver={handleDrag}\n                      onDrop={handleDrop}\n                    >\n                      <FileText className=\"h-8 w-8 text-muted-foreground mx-auto mb-2\" />\n                      <p className=\"text-sm font-medium mb-1\">\n                        Drop your resume here\n                      </p>\n                      <p className=\"text-xs text-muted-foreground mb-3\">\n                        PDF, DOC, or DOCX files\n                      </p>\n                      <Button\n                        size=\"sm\"\n                        variant=\"outline\"\n                        className=\"gap-1 text-xs\"\n                      >\n                        <Plus className=\"h-3 w-3\" />\n                        Browse Files\n                      </Button>\n                    </div>\n                  </CardContent>\n                </Card>\n              </div>\n            )}\n\n            {currentSlideData.type === \"features\" &&\n              currentSlideData.features && (\n                <div className=\"grid grid-cols-2 md:grid-cols-4 gap-3 max-w-xl mx-auto\">\n                  {currentSlideData.features.map((feature, index) => (\n                    <div\n                      key={index}\n                      className=\"flex flex-col items-center p-3 rounded-lg bg-white/5 backdrop-blur-sm border border-white/10\"\n                    >\n                      <feature.icon className=\"w-5 h-5 mb-1 text-brand-purple\" />\n                      <span className=\"text-xs font-medium text-center\">\n                        {feature.label}\n                      </span>\n                    </div>\n                  ))}\n                </div>\n              )}\n          </div>\n\n          {/* Action Buttons */}\n          <div className=\"min-h-[50px] flex items-center justify-center\">\n            {currentSlideData.type === \"upload\" ? (\n              <Button\n                onClick={handleGenerateAIVideo}\n                className=\"bg-gradient-to-r from-brand-purple to-brand-blue hover:opacity-90 text-sm px-6 py-2\"\n              >\n                Generate AI Video\n              </Button>\n            ) : (\n              currentSlideData.actions && (\n                <div className=\"flex flex-col sm:flex-row gap-3 justify-center\">\n                  {currentSlideData.actions.map((action, index) => (\n                    <Button\n                      key={index}\n                      size=\"sm\"\n                      variant={action.variant}\n                      className=\"text-sm px-6 py-2\"\n                      onClick={getActionHandler(action.label)}\n                    >\n                      {action.label}\n                    </Button>\n                  ))}\n                </div>\n              )\n            )}\n          </div>\n        </div>\n\n        {/* Slide Indicators */}\n        <div className=\"flex justify-center mt-6 gap-2\">\n          {slides.map((_, index) => (\n            <button\n              key={index}\n              onClick={() => setCurrentSlide(index)}\n              className={cn(\n                \"w-2 h-2 rounded-full transition-colors\",\n                index === currentSlide\n                  ? \"bg-brand-purple\"\n                  : \"bg-white/30 hover:bg-white/50\",\n              )}\n            />\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\JobCard.tsx","messages":[{"ruleId":"no-alert","severity":1,"message":"Unexpected alert.","line":154,"column":21,"nodeType":"CallExpression","messageId":"unexpected","endLine":154,"endColumn":59},{"ruleId":"no-alert","severity":1,"message":"Unexpected prompt.","line":158,"column":21,"nodeType":"CallExpression","messageId":"unexpected","endLine":158,"endColumn":51}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  MapPin,\n  DollarSign,\n  Clock,\n  Building2,\n  Eye,\n  Users,\n  UserCheck,\n  Edit,\n  Share,\n} from \"lucide-react\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { CardContent } from \"@/components/ui/card\";\nimport BaseCard from \"@/components/ui/BaseCard\";\nimport CardHeaderWithAvatar from \"@/components/ui/CardHeaderWithAvatar\";\nimport CardActions from \"@/components/ui/CardActions\";\nimport { useAuth } from \"@/lib/auth\";\nimport type { JobMetadata, JobWithOwnership } from \"@/types/job\";\nimport type { UserContext, ItemOwnership } from \"@/types/normalized-cards\";\nimport type { DynamicCardAction } from \"@/lib/dynamic-actions\";\n\ninterface JobCardProps {\n  job: JobMetadata | JobWithOwnership;\n  showOwnership?: boolean;\n  actions?: DynamicCardAction[];\n  userContext?: UserContext;\n  itemOwnership?: ItemOwnership;\n   \n  onTrack?: (_jobId: string) => void;\n   \n  onUntrack?: (_jobId: string) => void;\n  onView?: () => void;\n  onActions?: () => void;\n}\n\nexport default function JobCard({\n  job,\n  showOwnership = false,\n  actions,\n  userContext: _userContext,  \n  itemOwnership: _itemOwnership,  \n  onTrack: _onTrack,  \n  onUntrack: _onUntrack,  \n  onView,\n  onActions,\n}: JobCardProps) {\n  const { user } = useAuth();\n\n  const ownership = \"ownership\" in job ? job.ownership : undefined;\n  const isOwned =\n    ownership === \"owned\" || (!ownership && job.userId === user?.id);\n  const isTracked = ownership === \"tracked\";\n  const canEdit = isOwned;\n\n  const getStatusColor = (status: string) => {\n    switch (status) {\n      case \"active\":\n        return \"bg-green-100 text-green-800\";\n      case \"paused\":\n        return \"bg-yellow-100 text-yellow-800\";\n      case \"closed\":\n        return \"bg-gray-100 text-gray-800\";\n      case \"draft\":\n        return \"bg-orange-100 text-orange-800\";\n      default:\n        return \"bg-gray-100 text-gray-800\";\n    }\n  };\n\n  const getPrivacyIcon = (privacy: string) => {\n    switch (privacy) {\n      case \"public\":\n        return null;\n      case \"company_only\":\n        return <Building2 className=\"h-3 w-3\" />;\n      case \"recruiter_only\":\n        return <UserCheck className=\"h-3 w-3\" />;\n      case \"private\":\n        return <Eye className=\"h-3 w-3\" />;\n      default:\n        return null;\n    }\n  };\n\n  // Prepare badges for header\n  const badges = [];\n\n  if (showOwnership && isTracked) {\n    badges.push({\n      text: \"Tracked\",\n      variant: \"outline\" as const,\n      className: \"text-xs bg-blue-50 text-blue-700\",\n      icon: UserCheck,\n    });\n  }\n\n  if (canEdit && job.status === \"draft\") {\n    badges.push({\n      text: \"Draft\",\n      variant: \"outline\" as const,\n      className: \"text-xs bg-orange-50 text-orange-700\",\n      icon: Edit,\n    });\n  }\n\n  badges.push({\n    text: job.status,\n    variant: \"secondary\" as const,\n    className: getStatusColor(job.status),\n  });\n\n  if (getPrivacyIcon(job.privacy)) {\n    badges.push({\n      text: \"\",\n      variant: \"outline\" as const,\n      className: \"text-xs\",\n      icon: () => getPrivacyIcon(job.privacy),\n    });\n  }\n\n  // Use dynamic actions if provided and not empty, otherwise fallback to default actions\n  const cardActions =\n    actions && actions.length > 0\n      ? actions\n      : [\n          {\n            id: \"view\",\n            label: \"View\",\n            variant: \"outline\" as const,\n            icon: Eye,\n            onClick: () => {\n              if (onView) {\n                onView();\n              } else {\n                window.location.href = `/jobs/${job.id}`;\n              }\n            },\n          },\n          {\n            id: \"share\",\n            label: \"Share\",\n            variant: \"default\" as const,\n            icon: Share,\n            onClick: () => {\n              if (onActions) {\n                onActions();\n              } else {\n                // Default share functionality - copy link to clipboard\n                const url = `${window.location.origin}/jobs/${job.id}`;\n                navigator.clipboard\n                  .writeText(url)\n                  .then(() => {\n                    // Could show a toast notification here\n                    alert(\"Job link copied to clipboard!\");\n                  })\n                  .catch(() => {\n                    // Fallback for older browsers\n                    prompt(\"Copy this link:\", url);\n                  });\n              }\n            },\n          },\n        ];\n\n  return (\n    <BaseCard>\n      <CardHeaderWithAvatar\n        title={job.title}\n        subtitle={`${job.company}`}\n        badges={badges}\n        linkTo={`/jobs/${job.id}`}\n      />\n\n      <CardContent>\n        <div className=\"space-y-3\">\n          {/* Job Details */}\n          <div className=\"flex items-center justify-between text-sm text-muted-foreground\">\n            <div className=\"flex items-center gap-1\">\n              <MapPin className=\"h-4 w-4\" />\n              {job.location}\n            </div>\n            {job.salary && (\n              <div className=\"flex items-center gap-1\">\n                <DollarSign className=\"h-4 w-4\" />\n                {job.salary}\n              </div>\n            )}\n            <div className=\"flex items-center gap-1\">\n              <Clock className=\"h-4 w-4\" />\n              {job.employmentType}\n            </div>\n          </div>\n\n          {/* Summary */}\n          <p className=\"text-sm text-muted-foreground line-clamp-2\">\n            {job.summary}\n          </p>\n\n          {/* Experience Level */}\n          <div className=\"flex items-center gap-2\">\n            <Badge variant=\"outline\" className=\"text-xs\">\n              {job.experienceLevel}\n            </Badge>\n          </div>\n\n          {/* Stats */}\n          <div className=\"pt-2 border-t space-y-2\">\n            <div className=\"flex items-center gap-4 text-xs text-muted-foreground\">\n              <div className=\"flex items-center gap-1\">\n                <Eye className=\"h-3 w-3\" />\n                {job.views || 0} views\n              </div>\n              <div className=\"flex items-center gap-1\">\n                <Users className=\"h-3 w-3\" />\n                {job.applications || 0} applications\n              </div>\n            </div>\n            <div className=\"text-xs text-muted-foreground\">\n              Posted {new Date(job.createdAt).toLocaleDateString()}\n            </div>\n          </div>\n        </div>\n      </CardContent>\n\n      <CardActions actions={cardActions} />\n    </BaseCard>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\JobEditForm.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":202,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":202,"endColumn":20,"suggestions":[{"fix":{"range":[4781,4823],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { X, Plus, Save, Loader2 } from \"lucide-react\";\nimport { toast } from \"sonner\";\n\n// Types\ninterface JobFormData {\n  id?: string;\n  title: string;\n  description: string;\n  requirements: string[];\n  responsibilities: string[];\n  atsApplyUrl?: string;\n  salary?: number;\n  bonus?: number;\n  equity?: number;\n  employmentType: number[];\n  workSetting: number;\n  seniority?: number;\n  industry: number[];\n  hiringTarget?: number;\n  goLiveDate?: string;\n  expirationDate?: string;\n  status?: number;\n  privacy_ShowJob: number;\n}\n\ninterface JobEditFormProps {\n  job?: JobFormData;\n  onSave: (jobData: JobFormData) => Promise<void>;\n  onCancel: () => void;\n  loading?: boolean;\n}\n\n// Enums (should match backend)\nconst EmploymentType = {\n  FullTime: 0,\n  PartTime: 1,\n  Contract: 2,\n  Internship: 3,\n  Temporary: 4,\n  Freelance: 5,\n};\n\nconst WorkSetting = {\n  OnSite: 0,\n  Remote: 1,\n  Hybrid: 2,\n};\n\nconst DisplayPrivacy = {\n  ToPublic: 0,\n  ToRecruiters: 1,\n  ToConnections: 2,\n  ToSelf: 10,\n};\n\nconst JobStatus = {\n  Draft: 0,\n  Open: 1,\n  Closed: 2,\n  Paused: 3,\n};\n\nexport default function JobEditForm({\n  job,\n  onSave,\n  onCancel,\n  loading = false,\n}: JobEditFormProps) {\n  const [formData, setFormData] = useState<JobFormData>({\n    title: \"\",\n    description: \"\",\n    requirements: [],\n    responsibilities: [],\n    atsApplyUrl: \"\",\n    salary: undefined,\n    bonus: undefined,\n    equity: undefined,\n    employmentType: [EmploymentType.FullTime],\n    workSetting: WorkSetting.OnSite,\n    seniority: undefined,\n    industry: [],\n    hiringTarget: undefined,\n    goLiveDate: \"\",\n    expirationDate: \"\",\n    status: JobStatus.Draft,\n    privacy_ShowJob: DisplayPrivacy.ToPublic,\n  });\n\n  const [newRequirement, setNewRequirement] = useState(\"\");\n  const [newResponsibility, setNewResponsibility] = useState(\"\");\n\n  // Initialize form with job data\n  useEffect(() => {\n    if (job) {\n      setFormData({\n        id: job.id,\n        title: job.title || \"\",\n        description: job.description || \"\",\n        requirements: job.requirements || [],\n        responsibilities: job.responsibilities || [],\n        atsApplyUrl: job.atsApplyUrl || \"\",\n        salary: job.salary,\n        bonus: job.bonus,\n        equity: job.equity,\n        employmentType: job.employmentType || [EmploymentType.FullTime],\n        workSetting: job.workSetting ?? WorkSetting.OnSite,\n        seniority: job.seniority,\n        industry: job.industry || [],\n        hiringTarget: job.hiringTarget,\n        goLiveDate: job.goLiveDate\n          ? new Date(job.goLiveDate).toISOString().split(\"T\")[0]\n          : \"\",\n        expirationDate: job.expirationDate\n          ? new Date(job.expirationDate).toISOString().split(\"T\")[0]\n          : \"\",\n        status: job.status ?? JobStatus.Draft,\n        privacy_ShowJob: job.privacy_ShowJob ?? DisplayPrivacy.ToPublic,\n      });\n    }\n  }, [job]);\n\n  const handleInputChange = (\n    field: keyof JobFormData,\n    value: string | number,\n  ) => {\n    setFormData((prev) => ({\n      ...prev,\n      [field]: value,\n    }));\n  };\n\n  const addRequirement = () => {\n    if (newRequirement.trim()) {\n      setFormData((prev) => ({\n        ...prev,\n        requirements: [...prev.requirements, newRequirement.trim()],\n      }));\n      setNewRequirement(\"\");\n    }\n  };\n\n  const removeRequirement = (index: number) => {\n    setFormData((prev) => ({\n      ...prev,\n      requirements: prev.requirements.filter((_, i) => i !== index),\n    }));\n  };\n\n  const addResponsibility = () => {\n    if (newResponsibility.trim()) {\n      setFormData((prev) => ({\n        ...prev,\n        responsibilities: [...prev.responsibilities, newResponsibility.trim()],\n      }));\n      setNewResponsibility(\"\");\n    }\n  };\n\n  const removeResponsibility = (index: number) => {\n    setFormData((prev) => ({\n      ...prev,\n      responsibilities: prev.responsibilities.filter((_, i) => i !== index),\n    }));\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n\n    if (!formData.title.trim()) {\n      toast.error(\"Job title is required\");\n      return;\n    }\n\n    if (!formData.description.trim()) {\n      toast.error(\"Job description is required\");\n      return;\n    }\n\n    try {\n      await onSave(formData);\n    } catch (error) {\n      console.error(\"Error saving job:\", error);\n      toast.error(\"Failed to save job\");\n    }\n  };\n\n  return (\n    <form onSubmit={handleSubmit} className=\"space-y-6\">\n      {/* Basic Information */}\n      <Card>\n        <CardHeader>\n          <CardTitle>Basic Information</CardTitle>\n          <CardDescription>\n            Enter the basic details for this job posting\n          </CardDescription>\n        </CardHeader>\n        <CardContent className=\"space-y-4\">\n          <div>\n            <Label htmlFor=\"title\">Job Title *</Label>\n            <Input\n              id=\"title\"\n              value={formData.title}\n              onChange={(e) => handleInputChange(\"title\", e.target.value)}\n              placeholder=\"e.g. Senior Software Engineer\"\n              required\n            />\n          </div>\n\n          <div>\n            <Label htmlFor=\"description\">Job Description *</Label>\n            <Textarea\n              id=\"description\"\n              value={formData.description}\n              onChange={(e) => handleInputChange(\"description\", e.target.value)}\n              placeholder=\"Describe the role, company, and what makes this opportunity unique...\"\n              rows={6}\n              required\n            />\n          </div>\n\n          <div>\n            <Label htmlFor=\"atsApplyUrl\">Application URL</Label>\n            <Input\n              id=\"atsApplyUrl\"\n              type=\"url\"\n              value={formData.atsApplyUrl}\n              onChange={(e) => handleInputChange(\"atsApplyUrl\", e.target.value)}\n              placeholder=\"https://company.com/apply\"\n            />\n          </div>\n        </CardContent>\n      </Card>\n\n      {/* Requirements */}\n      <Card>\n        <CardHeader>\n          <CardTitle>Requirements</CardTitle>\n          <CardDescription>\n            List the skills, experience, and qualifications needed for this role\n          </CardDescription>\n        </CardHeader>\n        <CardContent className=\"space-y-4\">\n          <div className=\"flex gap-2\">\n            <Input\n              value={newRequirement}\n              onChange={(e) => setNewRequirement(e.target.value)}\n              placeholder=\"Add a requirement...\"\n              onKeyPress={(e) =>\n                e.key === \"Enter\" && (e.preventDefault(), addRequirement())\n              }\n            />\n            <Button type=\"button\" onClick={addRequirement} size=\"sm\">\n              <Plus className=\"h-4 w-4\" />\n            </Button>\n          </div>\n\n          <div className=\"flex flex-wrap gap-2\">\n            {formData.requirements.map((req, index) => (\n              <Badge\n                key={index}\n                variant=\"secondary\"\n                className=\"flex items-center gap-1\"\n              >\n                {req}\n                <X\n                  className=\"h-3 w-3 cursor-pointer\"\n                  onClick={() => removeRequirement(index)}\n                />\n              </Badge>\n            ))}\n          </div>\n        </CardContent>\n      </Card>\n\n      {/* Responsibilities */}\n      <Card>\n        <CardHeader>\n          <CardTitle>Responsibilities</CardTitle>\n          <CardDescription>\n            Outline the key responsibilities and duties for this position\n          </CardDescription>\n        </CardHeader>\n        <CardContent className=\"space-y-4\">\n          <div className=\"flex gap-2\">\n            <Input\n              value={newResponsibility}\n              onChange={(e) => setNewResponsibility(e.target.value)}\n              placeholder=\"Add a responsibility...\"\n              onKeyPress={(e) =>\n                e.key === \"Enter\" && (e.preventDefault(), addResponsibility())\n              }\n            />\n            <Button type=\"button\" onClick={addResponsibility} size=\"sm\">\n              <Plus className=\"h-4 w-4\" />\n            </Button>\n          </div>\n\n          <div className=\"flex flex-wrap gap-2\">\n            {formData.responsibilities.map((resp, index) => (\n              <Badge\n                key={index}\n                variant=\"secondary\"\n                className=\"flex items-center gap-1\"\n              >\n                {resp}\n                <X\n                  className=\"h-3 w-3 cursor-pointer\"\n                  onClick={() => removeResponsibility(index)}\n                />\n              </Badge>\n            ))}\n          </div>\n        </CardContent>\n      </Card>\n\n      {/* Job Details */}\n      <Card>\n        <CardHeader>\n          <CardTitle>Job Details</CardTitle>\n          <CardDescription>\n            Configure employment type, work setting, and other job specifics\n          </CardDescription>\n        </CardHeader>\n        <CardContent className=\"space-y-4\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <Label htmlFor=\"workSetting\">Work Setting</Label>\n              <Select\n                value={formData.workSetting.toString()}\n                onValueChange={(value) =>\n                  handleInputChange(\"workSetting\", parseInt(value))\n                }\n              >\n                <SelectTrigger>\n                  <SelectValue />\n                </SelectTrigger>\n                <SelectContent>\n                  <SelectItem value=\"0\">On-site</SelectItem>\n                  <SelectItem value=\"1\">Remote</SelectItem>\n                  <SelectItem value=\"2\">Hybrid</SelectItem>\n                </SelectContent>\n              </Select>\n            </div>\n\n            <div>\n              <Label htmlFor=\"status\">Status</Label>\n              <Select\n                value={formData.status?.toString() || \"0\"}\n                onValueChange={(value) =>\n                  handleInputChange(\"status\", parseInt(value))\n                }\n              >\n                <SelectTrigger>\n                  <SelectValue />\n                </SelectTrigger>\n                <SelectContent>\n                  <SelectItem value=\"0\">Draft</SelectItem>\n                  <SelectItem value=\"1\">Open</SelectItem>\n                  <SelectItem value=\"2\">Closed</SelectItem>\n                  <SelectItem value=\"3\">Paused</SelectItem>\n                </SelectContent>\n              </Select>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n            <div>\n              <Label htmlFor=\"salary\">Salary</Label>\n              <Input\n                id=\"salary\"\n                type=\"number\"\n                value={formData.salary || \"\"}\n                onChange={(e) =>\n                  handleInputChange(\n                    \"salary\",\n                    e.target.value ? parseInt(e.target.value) : undefined,\n                  )\n                }\n                placeholder=\"Annual salary\"\n              />\n            </div>\n\n            <div>\n              <Label htmlFor=\"bonus\">Bonus</Label>\n              <Input\n                id=\"bonus\"\n                type=\"number\"\n                value={formData.bonus || \"\"}\n                onChange={(e) =>\n                  handleInputChange(\n                    \"bonus\",\n                    e.target.value ? parseInt(e.target.value) : undefined,\n                  )\n                }\n                placeholder=\"Annual bonus\"\n              />\n            </div>\n\n            <div>\n              <Label htmlFor=\"equity\">Equity %</Label>\n              <Input\n                id=\"equity\"\n                type=\"number\"\n                step=\"0.01\"\n                value={formData.equity || \"\"}\n                onChange={(e) =>\n                  handleInputChange(\n                    \"equity\",\n                    e.target.value ? parseFloat(e.target.value) : undefined,\n                  )\n                }\n                placeholder=\"Equity percentage\"\n              />\n            </div>\n          </div>\n        </CardContent>\n      </Card>\n\n      {/* Form Actions */}\n      <div className=\"flex justify-end gap-4\">\n        <Button type=\"button\" variant=\"outline\" onClick={onCancel}>\n          Cancel\n        </Button>\n        <Button type=\"submit\" disabled={loading}>\n          {loading && <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />}\n          <Save className=\"mr-2 h-4 w-4\" />\n          Save Job\n        </Button>\n      </div>\n    </form>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\LegalLinks.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\LoginModal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\Markdown.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\MasterResumeGroup.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\MediaCard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\MediaModal.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":31,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":31,"endColumn":20,"suggestions":[{"fix":{"range":[1074,1125],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogDescription } from \"@/components/ui/dialog\";\nimport { MetaType, type ResumeSectionMeta } from \"@/types/resume\";\n\ninterface MediaModalProps {\n  media: ResumeSectionMeta | null;\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n}\n\nexport default function MediaModal({ media, open, onOpenChange }: MediaModalProps) {\n  if (!media) return null;\n\n  const isVideo = [MetaType.YouTube, MetaType.VideoMP4, MetaType.VideoWebM].includes(media.metaType);\n  const isImage = media.metaType === MetaType.Image;\n\n  const getYouTubeEmbedUrl = (url: string): string => {\n    try {\n      const urlObj = new URL(url);\n      let videoId = \"\";\n      \n      if (urlObj.hostname.includes(\"youtu.be\")) {\n        videoId = urlObj.pathname.split(\"/\").filter(Boolean)[0];\n      } else if (urlObj.hostname.includes(\"youtube.com\")) {\n        videoId = urlObj.searchParams.get(\"v\") || \"\";\n      }\n      \n      if (videoId) {\n        return `https://www.youtube.com/embed/${videoId}?autoplay=1`;\n      }\n    } catch (error) {\n      console.error(\"Error parsing YouTube URL:\", error);\n    }\n    return url;\n  };\n\n  return (\n    <Dialog open={open} onOpenChange={onOpenChange}>\n      <DialogContent className=\"sm:max-w-4xl max-h-[90vh] overflow-y-auto\">\n        <DialogHeader>\n          <DialogTitle>{media.name}</DialogTitle>\n          {media.description && (\n            <DialogDescription>{media.description}</DialogDescription>\n          )}\n        </DialogHeader>\n\n        <div className=\"space-y-4\">\n          {/* Media Content */}\n          {isVideo && (\n            <div className=\"aspect-video w-full\">\n              {media.metaType === MetaType.YouTube ? (\n                <iframe\n                  width=\"100%\"\n                  height=\"100%\"\n                  src={getYouTubeEmbedUrl(media.url)}\n                  title={media.name}\n                  allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n                  allowFullScreen\n                  className=\"rounded-lg\"\n                />\n              ) : (\n                <video\n                  controls\n                  autoPlay\n                  className=\"w-full h-full rounded-lg\"\n                  src={media.url}\n                >\n                  <source\n                    src={media.url}\n                    type={media.metaType === MetaType.VideoWebM ? \"video/webm\" : \"video/mp4\"}\n                  />\n                  Your browser does not support the video tag.\n                </video>\n              )}\n            </div>\n          )}\n\n          {isImage && (\n            <div className=\"w-full\">\n              <img\n                src={media.url}\n                alt={media.name}\n                className=\"w-full h-auto max-h-[60vh] object-contain rounded-lg\"\n              />\n            </div>\n          )}\n\n          {/* Fallback for other content types */}\n          {!isVideo && !isImage && (\n            <div className=\"p-8 text-center\">\n              <p className=\"text-muted-foreground mb-4\">\n                This content type is not supported for preview.\n              </p>\n              <a\n                href={media.url}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"text-primary hover:underline\"\n              >\n                Open in new tab\n              </a>\n            </div>\n          )}\n        </div>\n      </DialogContent>\n    </Dialog>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\MetaBadge.tsx","messages":[{"ruleId":"no-duplicate-imports","severity":1,"message":"'@/types/resume' import is duplicated.","line":6,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":6,"endColumn":43},{"ruleId":"no-empty","severity":2,"message":"Empty block statement.","line":95,"column":11,"nodeType":"BlockStatement","messageId":"unexpected","endLine":95,"endColumn":13,"suggestions":[{"messageId":"suggestComment","data":{"type":"block"},"fix":{"range":[3611,3611],"text":" /* empty */ "},"desc":"Add comment inside empty block statement."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\nimport { Button } from \"@/components/ui/button\";\nimport { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle } from \"@/components/ui/dialog\";\nimport { ExternalLink, Image as ImageIcon, PlayCircle } from \"lucide-react\";\nimport type { ResumeSectionMeta } from \"@/types/resume\";\nimport { MetaType } from \"@/types/resume\";\n\nexport function MetaBadge({ meta }: { meta: ResumeSectionMeta }) {\n  const [open, setOpen] = useState(false);\n\n  const icon = (() => {\n    switch (meta.metaType) {\n      case MetaType.YouTube:\n      case MetaType.VideoMP4:\n      case MetaType.VideoWebM:\n        return <PlayCircle className=\"h-4 w-4\" />;\n      case MetaType.Image:\n        return <ImageIcon className=\"h-4 w-4\" />;\n      case MetaType.Hyperlink:\n      default:\n        return <ExternalLink className=\"h-4 w-4\" />;\n    }\n  })();\n\n  const label = meta.name || (meta.metaType === MetaType.Image ? \"Image\" : meta.metaType === MetaType.YouTube || meta.metaType === MetaType.VideoMP4 || meta.metaType === MetaType.VideoWebM ? \"Video\" : \"Link\");\n\n  const isVideo = meta.metaType === MetaType.YouTube || meta.metaType === MetaType.VideoMP4 || meta.metaType === MetaType.VideoWebM;\n  const isImage = meta.metaType === MetaType.Image;\n\n  return (\n    <>\n      <Button size=\"sm\" variant=\"outline\" className=\"gap-1\" onClick={() => setOpen(true)}>\n        {icon}\n        {label}\n      </Button>\n\n      <Dialog open={open} onOpenChange={setOpen}>\n        <DialogContent className=\"sm:max-w-3xl\">\n          <DialogHeader>\n            <DialogTitle>{meta.name || label}</DialogTitle>\n            {meta.description && <DialogDescription>{meta.description}</DialogDescription>}\n          </DialogHeader>\n          {/* Content */}\n          {isVideo && (\n            <div className=\"aspect-video w-full\">\n              {meta.metaType === MetaType.YouTube ? (\n                <iframe\n                  width=\"100%\"\n                  height=\"100%\"\n                  src={toYouTubeEmbed(meta.url)}\n                  title=\"YouTube video player\"\n                  allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\n                  allowFullScreen\n                />\n              ) : (\n                <video controls className=\"w-full h-full\">\n                  <source src={meta.url} />\n                </video>\n              )}\n            </div>\n          )}\n          {isImage && (\n            <div className=\"w-full\">\n              <img src={meta.url} alt={meta.name || \"Image\"} className=\"max-h-[70vh] w-auto mx-auto\" />\n            </div>\n          )}\n          {!isVideo && !isImage && (\n            <div className=\"w-full\">\n              <a className=\"inline-flex items-center gap-2 text-primary underline\" href={meta.url} target=\"_blank\" rel=\"noreferrer noopener\">\n                <ExternalLink className=\"h-4 w-4\" />\n                Open Link\n              </a>\n            </div>\n          )}\n        </DialogContent>\n      </Dialog>\n    </>\n  );\n}\n\nfunction toYouTubeEmbed(url: string): string {\n  try {\n    const u = new URL(url);\n    if (u.hostname.includes(\"youtube.com\")) {\n      const v = u.searchParams.get(\"v\");\n      if (v) return `https://www.youtube.com/embed/${v}`;\n      const parts = u.pathname.split(\"/\");\n      const idx = parts.indexOf(\"embed\");\n      if (idx >= 0 && parts[idx + 1]) return `https://www.youtube.com/embed/${parts[idx + 1]}`;\n    }\n    if (u.hostname === \"youtu.be\") {\n      const id = u.pathname.replace(\"/\", \"\");\n      if (id) return `https://www.youtube.com/embed/${id}`;\n    }\n  } catch {}\n  return url;\n}\n\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\MetadataModal.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":62,"column":11,"nodeType":"MemberExpression","messageId":"unexpected","endLine":62,"endColumn":24,"suggestions":[{"fix":{"rang