m you. Send us a message and we&apos;ll\n                    respond as soon as possible.\n                  "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[7775,7919],"text":"\n                    We'd love to hear from you. Send us a message and we&lsquo;ll\n                    respond as soon as possible.\n                  "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[7775,7919],"text":"\n                    We'd love to hear from you. Send us a message and we&#39;ll\n                    respond as soon as possible.\n                  "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[7775,7919],"text":"\n                    We'd love to hear from you. Send us a message and we&rsquo;ll\n                    respond as soon as possible.\n                  "},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":7,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  Mail,\n  Phone,\n  MapPin,\n  MessageCircle,\n  Send,\n  Clock,\n  Users,\n  Heart,\n  ArrowRight,\n  CheckCircle2,\n} from \"lucide-react\";\nimport { useEffect, useState } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport { useSEO } from \"@/lib/seo\";\nimport Footer from \"@/components/Footer\";\nimport Navigation from \"@/components/Navigation\";\nimport Sidebar from \"@/components/Sidebar\";\nimport { Button } from \"@/components/ui/button\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\";\nimport { useSidebar } from \"@/hooks/use-sidebar\";\nimport { useAuth } from \"@/lib/auth\";\n\n// Declare HubSpot global variable\ndeclare global {\n  interface Window {\n    hbspt: any;\n  }\n}\n\nexport default function Contact() {\n  const location = useLocation();\n  const {\n    sidebarOpen,\n    sidebarCollapsed,\n    openSidebar,\n    closeSidebar,\n    toggleSidebar,\n  } = useSidebar();\n\n  // SEO for contact page\n  useSEO(location.pathname);\n  const { isAuthenticated } = useAuth();\n  const [hubspotLoaded, setHubspotLoaded] = useState(false);\n\n  // Load HubSpot form script\n  useEffect(() => {\n    // Check if HubSpot script is already loaded\n    if (window.hbspt) {\n      createForm();\n      return;\n    }\n\n    // Create and load HubSpot script\n    const script = document.createElement(\"script\");\n    script.src = \"//js-na2.hsforms.net/forms/embed/v2.js\";\n    script.charset = \"utf-8\";\n    script.type = \"text/javascript\";\n    script.onload = () => {\n      createForm();\n    };\n    document.head.appendChild(script);\n\n    return () => {\n      // Cleanup: remove script when component unmounts\n      const existingScript = document.querySelector(\n        'script[src=\"//js-na2.hsforms.net/forms/embed/v2.js\"]',\n      );\n      if (existingScript) {\n        existingScript.remove();\n      }\n    };\n  }, []);\n\n  const createForm = () => {\n    if (window.hbspt?.forms) {\n      window.hbspt.forms.create({\n        portalId: \"242403512\",\n        formId: \"59fc922d-e44c-410a-8579-76ccd3a1fe33\",\n        region: \"na2\",\n        target: \"#hubspot-form\",\n      });\n      setHubspotLoaded(true);\n    }\n  };\n\n  const contactInfo = [\n    {\n      icon: Mail,\n      title: \"Email Us\",\n      description: \"Get in touch via email\",\n      value: \"info@myvideoresu.me\",\n      action: \"mailto:info@myvideoresu.me\",\n    },\n    {\n      icon: MessageCircle,\n      title: \"Live Chat\",\n      description: \"Chat with our support team\",\n      value: \"Available 24/7\",\n      action: \"#\",\n    },\n    {\n      icon: Clock,\n      title: \"Response Time\",\n      description: \"We typically respond within\",\n      value: \"24 hours\",\n      action: null,\n    },\n  ];\n\n  const faqs = [\n    {\n      question: \"How do I create a video resume?\",\n      answer:\n        \"Simply sign up for an account, upload your existing resume, and use our AI-powered tools to create a compelling video resume that showcases your skills and personality.\",\n    },\n    {\n      question: \"Is MyVideoResu.me free to use?\",\n      answer:\n        \"We offer both free and premium plans. Our free plan includes basic video resume creation, while premium plans offer advanced features like AI optimization and priority support.\",\n    },\n    {\n      question: \"How do employers find my video resume?\",\n      answer:\n        \"Employers can discover your profile through our platform's search and matching algorithms, or you can share your video resume directly via a custom link.\",\n    },\n    {\n      question: \"What video formats are supported?\",\n      answer:\n        \"We support all major video formats including MP4, MOV, and AVI. Our platform automatically optimizes your videos for the best viewing experience across all devices.\",\n    },\n  ];\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      <Sidebar\n        isOpen={sidebarOpen}\n        onClose={closeSidebar}\n        collapsed={sidebarCollapsed}\n      />\n      <div className={sidebarCollapsed ? \"lg:ml-16\" : \"lg:ml-80\"}>\n        <Navigation\n          onMenuClick={openSidebar}\n          onSidebarToggle={toggleSidebar}\n          sidebarCollapsed={sidebarCollapsed}\n        />\n\n        <div className=\"pt-16\">\n          {/* Hero Section */}\n          <section className=\"bg-gradient-to-br from-primary/5 via-background to-secondary/5 py-20\">\n            <div className=\"max-w-6xl mx-auto px-6\">\n              <div className=\"text-center max-w-3xl mx-auto\">\n                <h1 className=\"text-4xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent\">\n                  Get in Touch\n                </h1>\n                <p className=\"text-xl text-muted-foreground mb-8\">\n                  Have questions about MyVideoResu.me? We're here to help you\n                  succeed in your career journey. Reach out to our team and\n                  we'll get back to you as soon as possible.\n                </p>\n              </div>\n            </div>\n          </section>\n\n          {/* Contact Information */}\n          <section className=\"py-16\">\n            <div className=\"max-w-6xl mx-auto px-6\">\n              <div className=\"grid md:grid-cols-3 gap-8 mb-16\">\n                {contactInfo.map((info, index) => (\n                  <Card\n                    key={index}\n                    className=\"text-center hover:shadow-lg transition-shadow\"\n                  >\n                    <CardHeader>\n                      <div className=\"mx-auto w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4\">\n                        <info.icon className=\"h-6 w-6 text-primary\" />\n                      </div>\n                      <CardTitle className=\"text-xl\">{info.title}</CardTitle>\n                      <CardDescription>{info.description}</CardDescription>\n                    </CardHeader>\n                    <CardContent>\n                      <p className=\"font-semibold text-lg mb-4\">{info.value}</p>\n                      {info.action && info.action !== \"#\" && (\n                        <Button asChild variant=\"outline\">\n                          <a href={info.action}>\n                            Contact Us\n                            <ArrowRight className=\"ml-2 h-4 w-4\" />\n                          </a>\n                        </Button>\n                      )}\n                      {info.action === \"#\" && (\n                        <Button\n                          variant=\"outline\"\n                          onClick={() => {\n                            // Scroll to contact form\n                            document\n                              .getElementById(\"contact-form\")\n                              ?.scrollIntoView({ behavior: \"smooth\" });\n                          }}\n                        >\n                          Start Chat\n                          <MessageCircle className=\"ml-2 h-4 w-4\" />\n                        </Button>\n                      )}\n                    </CardContent>\n                  </Card>\n                ))}\n              </div>\n            </div>\n          </section>\n\n          {/* Contact Form Section */}\n          <section id=\"contact-form\" className=\"py-16 bg-muted/30\">\n            <div className=\"max-w-4xl mx-auto px-6\">\n              <div className=\"text-center mb-12\">\n                <h2 className=\"text-3xl font-bold mb-4\">Send Us a Message</h2>\n                <p className=\"text-lg text-muted-foreground\">\n                  Fill out the form below and we'll get back to you within 24\n                  hours.\n                </p>\n              </div>\n\n              <Card className=\"max-w-2xl mx-auto\">\n                <CardHeader>\n                  <CardTitle className=\"text-center\">Contact Form</CardTitle>\n                  <CardDescription className=\"text-center\">\n                    We'd love to hear from you. Send us a message and we'll\n                    respond as soon as possible.\n                  </CardDescription>\n                </CardHeader>\n                <CardContent>\n                  {/* HubSpot Form Container */}\n                  <div\n                    id=\"hubspot-form\"\n                    className=\"min-h-[400px] flex items-center justify-center\"\n                  >\n                    {!hubspotLoaded && (\n                      <div className=\"text-center\">\n                        <div className=\"animate-spin rounded-full h-8 w-8 border-b-2 border-primary mx-auto mb-4\" />\n                        <p className=\"text-muted-foreground\">\n                          Loading contact form...\n                        </p>\n                      </div>\n                    )}\n                  </div>\n                </CardContent>\n              </Card>\n            </div>\n          </section>\n\n          {/* FAQ Section */}\n          <section className=\"py-16\">\n            <div className=\"max-w-4xl mx-auto px-6\">\n              <div className=\"text-center mb-12\">\n                <h2 className=\"text-3xl font-bold mb-4\">\n                  Frequently Asked Questions\n                </h2>\n                <p className=\"text-lg text-muted-foreground\">\n                  Find answers to common questions about MyVideoResu.me\n                </p>\n              </div>\n\n              <div className=\"space-y-6\">\n                {faqs.map((faq, index) => (\n                  <Card key={index}>\n                    <CardHeader>\n                      <CardTitle className=\"text-lg flex items-start gap-3\">\n                        <CheckCircle2 className=\"h-5 w-5 text-primary mt-0.5 flex-shrink-0\" />\n                        {faq.question}\n                      </CardTitle>\n                    </CardHeader>\n                    <CardContent>\n                      <p className=\"text-muted-foreground ml-8\">{faq.answer}</p>\n                    </CardContent>\n                  </Card>\n                ))}\n              </div>\n            </div>\n          </section>\n        </div>\n\n        <Footer />\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\pages\\CookiePolicy.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Eye' is defined but never used. Allowed unused vars must match /^_/u.","line":9,"column":3,"nodeType":null,"messageId":"unusedVar","endLine":9,"endColumn":6},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'X' is defined but ne