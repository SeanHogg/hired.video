\n  VERSION: string;\r\n\r\n}\r\n\r\ndeclare global {\r\n  interface Window {\r\n    APP_CONFIG?: AppConfig;\r\n  }\r\n}\r\n\r\nclass RuntimeConfig {\r\n  private config: AppConfig;\r\n\r\n  constructor() {\r\n    // Try to load from runtime config first, then fall back to build-time env vars\r\n    this.config = this.loadConfig();\r\n  }\r\n\r\n  private loadConfig(): AppConfig {\r\n    // Runtime config from /config.js (preferred for static deployments)\r\n    if (typeof window !== \"undefined\" && window.APP_CONFIG) {\r\n      console.log(\"Using runtime configuration from /config.js\");\r\n      return window.APP_CONFIG;\r\n    }\r\n\r\n    // Fallback to build-time environment variables (for development)\r\n    console.log(\"Using build-time environment variables\");\r\n    return {\r\n      API_URL: import.meta.env.VITE_API_URL || \"https://api.myvideoresu.me/api\",\r\n      ERROR_REPORTING: {\r\n        ENABLED: import.meta.env.VITE_ERROR_REPORTING_ENABLED === \"true\",\r\n        DSN: import.meta.env.VITE_ERROR_REPORTING_DSN || \"\",\r\n        ENVIRONMENT: import.meta.env.VITE_ERROR_REPORTING_ENVIRONMENT || \"development\",\r\n        SAMPLE_RATE: parseFloat(import.meta.env.VITE_ERROR_REPORTING_SAMPLE_RATE || \"0.1\"),\r\n      },\r\n      FEATURES: {\r\n        AI_CHAT: import.meta.env.VITE_FEATURE_AI_CHAT !== \"false\",\r\n        VIDEO_RESUMES: import.meta.env.VITE_FEATURE_VIDEO_RESUMES !== \"false\",\r\n        ANALYTICS: import.meta.env.VITE_FEATURE_ANALYTICS === \"true\",\r\n        NOTIFICATIONS: import.meta.env.VITE_FEATURE_NOTIFICATIONS !== \"false\",\r\n      },\r\n      PERFORMANCE: {\r\n        MONITORING: import.meta.env.VITE_PERFORMANCE_MONITORING === \"true\",\r\n        SAMPLE_RATE: parseFloat(import.meta.env.VITE_PERFORMANCE_SAMPLE_RATE || \"0.1\"),\r\n      },\r\n      LOGGING: {\r\n        LEVEL: import.meta.env.VITE_LOG_LEVEL || \"info\",\r\n        MAX_ENTRIES: parseInt(import.meta.env.VITE_LOG_MAX_ENTRIES || \"100\"),\r\n      },\r\n      VERSION: import.meta.env.VITE_APP_VERSION || \"unknown\",\r\n\r\n    };\r\n  }\r\n\r\n  // Getters for easy access\r\n  get apiUrl(): string {\r\n    return this.config.API_URL;\r\n  }\r\n\r\n  get errorReporting() {\r\n    return this.config.ERROR_REPORTING;\r\n  }\r\n\r\n  get features() {\r\n    return this.config.FEATURES;\r\n  }\r\n\r\n  get performance() {\r\n    return this.config.PERFORMANCE;\r\n  }\r\n\r\n  get logging() {\r\n    return this.config.LOGGING;\r\n  }\r\n\r\n  get version(): string {\r\n    return this.config.VERSION;\r\n  }\r\n\r\n\r\n\r\n  get isProduction(): boolean {\r\n    return this.config.ERROR_REPORTING.ENVIRONMENT === \"production\";\r\n  }\r\n\r\n  get isDevelopment(): boolean {\r\n    return this.config.ERROR_REPORTING.ENVIRONMENT === \"development\";\r\n  }\r\n\r\n  // Method to update config at runtime (useful for admin panels)\r\n  updateConfig(updates: Partial<AppConfig>): void {\r\n    this.config = { ...this.config, ...updates };\r\n    \r\n    // Also update the global config if it exists\r\n    if (typeof window !== \"undefined\" && window.APP_CONFIG) {\r\n      window.APP_CONFIG = { ...window.APP_CONFIG, ...updates };\r\n    }\r\n  }\r\n\r\n  // Get the full config object\r\n  getConfig(): AppConfig {\r\n    return { ...this.config };\r\n  }\r\n\r\n  // Debug method to log current configuration\r\n  logConfig(): void {\r\n    console.group(\"≡ƒöº Runtime Configuration\");\r\n    console.log(\"API URL:\", this.apiUrl);\r\n    console.log(\"Environment:\", this.errorReporting.ENVIRONMENT);\r\n    console.log(\"Error Reporting:\", this.errorReporting.ENABLED ? \"Enabled\" : \"Disabled\");\r\n    console.log(\"Version:\", this.version);\r\n    console.log(\"Features:\", this.features);\r\n    console.groupEnd();\r\n  }\r\n}\r\n\r\n// Create singleton instance\r\nexport const runtimeConfig = new RuntimeConfig();\r\n\r\n// Export for backward compatibility with existing code\r\nexport const isProduction = runtimeConfig.isProduction;\r\nexport const isDevelopment = runtimeConfig.isDevelopment;\r\n\r\n// Export the class for testing\r\nexport { RuntimeConfig };\r\nexport type { AppConfig };","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\seo.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":402,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":402,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[15053,15056],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[15053,15056],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":429,"column":27,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":429,"endColumn":30,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[15722,15725],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[15722,15725],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":439,"column":20,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":439,"endColumn":23,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[15968,15971],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"ran