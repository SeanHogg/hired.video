\\resume-sections\\ProjectsSection.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\resume-sections\\PublicationsSection.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\resume-sections\\ReferencesSection.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\resume-sections\\SkillsSection.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\resume-sections\\VolunteerSection.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\resume-sections\\WorkExperienceSection.tsx","messages":[{"ruleId":"@typescript-eslint/prefer-optional-chain","severity":1,"message":"Prefer using an optional chain expression instead, as it's more concise and easier to read.","line":64,"column":19,"nodeType":null,"messageId":"preferOptionalChain","endLine":64,"endColumn":50,"suggestions":[{"fix":{"range":[2390,2421],"text":"sortedWork?.length"},"messageId":"optionalChainSuggest","desc":"Change to an optional chain."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Briefcase , X } from \"lucide-react\";\nimport { Input } from \"@/components/ui/input\";\nimport { Label } from \"@/components/ui/label\";\nimport { Textarea } from \"@/components/ui/textarea\";\nimport { Button } from \"@/components/ui/button\";\nimport type { WorkExperience } from \"@/types/resume\";\nimport BaseSectionCard from \"./BaseSectionCard\";\nimport BaseSectionItem from \"./BaseSectionItem\";\n\ninterface WorkExperienceSectionProps {\n  work: WorkExperience[];\n  sortedWork?: WorkExperience[];\n  onAdd: () => void;\n  onUpdate: (index: number, field: keyof WorkExperience, value: string | string[]) => void;\n  onRemove: (index: number) => void;\n  onAddHighlight: (workIndex: number) => void;\n  onUpdateHighlight: (workIndex: number, highlightIndex: number, value: string) => void;\n  onRemoveHighlight: (workIndex: number, highlightIndex: number) => void;\n}\n\nexport default function WorkExperienceSection({\n  work,\n  sortedWork,\n  onAdd,\n  onUpdate,\n  onRemove,\n  onAddHighlight,\n  onUpdateHighlight,\n  onRemoveHighlight,\n}: WorkExperienceSectionProps) {\n  // Always compute stable, correct sort for edit panels:\n  // - Current roles first: EndDate null/empty (also handle 'present'/'current'/'now')\n  // - Then by most recent end date desc; for current roles, start date desc\n  const isCurrent = (end?: string) => {\n    const s = (end || '').trim().toLowerCase();\n    return s === '' || s === 'present' || s === 'current' || s === 'now';\n  };\n  const toTime = (val?: string): number | null => {\n    if (!val) return null;\n    const t = Date.parse(val);\n    return Number.isFinite(t) ? t : null;\n  };\n  const compareWork = (a: WorkExperience, b: WorkExperience) => {\n    const aCur = isCurrent(a.EndDate);\n    const bCur = isCurrent(b.EndDate);\n    if (aCur && !bCur) return -1;\n    if (!aCur && bCur) return 1;\n    if (aCur && bCur) {\n      const aStart = toTime(a.StartDate);\n      const bStart = toTime(b.StartDate);\n      if (aStart !== null && bStart !== null) return bStart - aStart;\n      if (aStart !== null) return -1;\n      if (bStart !== null) return 1;\n      return 0;\n    }\n    // both not current\n    const aEnd = toTime(a.EndDate) ?? toTime(a.StartDate);\n    const bEnd = toTime(b.EndDate) ?? toTime(b.StartDate);\n    if (aEnd !== null && bEnd !== null) return bEnd - aEnd;\n    if (aEnd !== null) return -1;\n    if (bEnd !== null) return 1;\n    return 0;\n  };\n  const source = (sortedWork && sortedWork.length ? sortedWork : work);\n  const displayWork = source.slice().sort(compareWork);\n  const emptyState = {\n    icon: <Briefcase className=\"h-12 w-12 mx-auto mb-4 opacity-50\" />,\n    title: \"No work experience added yet.\",\n    description: 'Click \"Add Work Experience\" to get started.',\n  };\n\n  return (\n    <BaseSectionCard\n      title=\"Work Experience\"\n      onAdd={onAdd}\n      addButtonText=\"Add Work Experience\"\n      isEmpty={work.length === 0}\n      emptyState={emptyState}\n    >\n      {displayWork.map((workItem, displayIndex) => {\n        // Find the original index in the unsorted array for proper updates\n        const originalIndex = work.findIndex(item =>\n          item.Name === workItem.Name &&\n          item.Position === workItem.Position &&\n          item.StartDate === workItem.StartDate\n        );\n\n        return (\n          <BaseSectionItem\n            key={originalIndex}\n            title={`Work Experience ${displayIndex + 1}`}\n            onRemove={() => onRemove(originalIndex)}\n          >\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              <div className=\"space-y-2\">\n                <Label>Company</Label>\n                <Input\n                  value={workItem.Name}\n                  onChange={(e) => onUpdate(originalIndex, \"Name\", e.target.value)}\n                  placeholder=\"Acme Corp\"\n                />\n              </div>\n              <div className=\"space-y-2\">\n                <Label>Position</Label>\n                <Input\n                  value={workItem.Position}\n                  onChange={(e) => onUpdate(originalIndex, \"Position\", e.target.value)}\n                  placeholder=\"Software Engineer\"\n                />\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              <div className=\"space-y-2\">\n                <Label>Start Date</Label>\n                <Input\n                  type=\"date\"\n                  value={workItem.StartDate}\n                  onChange={(e) => onUpdate(originalIndex, \"StartDate\", e.target.value)}\n                />\n              </div>\n              <div className=\"space-y-2\">\n                <Label>End Date</Label>\n                <Input\n                  type=\"date\"\n                  value={workItem.EndDate}\n                  onChange={(e) => onUpdate(originalIndex, \"EndDate\", e.target.value)}\n                />\n                <p className=\"text-xs text-muted-foreground\">Leave empty if this is your current position</p>\n              </div>\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label>Website</Label>\n              <Input\n                value={workItem.Url}\n                onChange={(e) => onUpdate(originalIndex, \"Url\", e.target.value)}\n                placeholder=\"https://acmecorp.com\"\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label>Summary</Label>\n              <Textarea\n                value={workItem.Summary}\n                onChange={(e) => onUpdate(originalIndex, \"Summary\", e.target.value)}\n                placeholder=\"Describe your role and responsibilities...\"\n                rows={3}\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <Label>Key Achievements</Label>\n                <Button\n                  type=\"button\"\n                  variant=\"outline\"\n                  size=\"sm\"\n                  onClick={() => onAddHighlight(originalIndex)}\n                >\n                  Add Achievement\n                </Button>\n              </div>\n              <div className=\"space-y-2\">\n                {workItem.Highlights.map((highlight, highlightIndex) => (\n                  <div key={highlightIndex} className=\"flex gap-2\">\n                    <Input\n                      value={highlight}\n                      onChange={(e) =>\n                        onUpdateHighlight(originalIndex, highlightIndex, e.target.value)\n                      }\n                      placeholder=\"Describe a key achievement...\"\n                    />\n                    <Button\n                      type=\"button\"\n                      variant=\"ghost\"\n                      size=\"sm\"\n                      onClick={() => onRemoveHighlight(originalIndex, highlightIndex)}\n                    >\n                      <X className=\"h-4 w-4\" />\n                    </Button>\n                  </div>\n                ))}\n              </div>\n            </div>\n          </BaseSectionItem>\n        );\n      })}\n    </BaseSectionCard>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\resume-sections\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\tools\\CompanyInfoStep.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":1,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":67,"column":63,"nodeType":"JSXText","messageId"