:2,"message":"'error' is defined but never used.","line":398,"column":14,"nodeType":null,"messageId":"unusedVar","endLine":398,"endColumn":19},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'error' is defined but never used.","line":429,"column":14,"nodeType":null,"messageId":"unusedVar","endLine":429,"endColumn":19}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * User Service\n * Handles user-related API operations including connections and profiles\n */\n\nimport { z } from \"zod\";\nimport { apiClient } from \"../api-client\";\nimport { nullableString, nullableNumber, nullableBoolean } from \"@shared/api\";\n\n// ============================================================================\n// SCHEMAS\n// ============================================================================\n\nexport const UserProfileSchema = z.object({\n  id: nullableString(),\n  email: nullableString(),\n  firstName: nullableString(),\n  lastName: nullableString(),\n  // Backend may return numeric enum for role; accept string or number\n  role: z\n    .union([z.string(), z.number()])\n    .nullable()\n    .transform((val) =>\n      val === null ? undefined : typeof val === \"number\" ? String(val) : val,\n    )\n    .optional(),\n  profilePicture: nullableString(),\n  bio: nullableString(),\n  location: nullableString(),\n  website: nullableString(),\n  linkedIn: nullableString(),\n  github: nullableString(),\n  skills: z\n    .array(z.string())\n    .nullable()\n    .transform((val) => (val === null ? undefined : val))\n    .optional(),\n  openToWork: nullableBoolean(),\n  slug: nullableString(),\n  createdAt: nullableString(),\n  updatedAt: nullableString(),\n});\n\n// Public users list item (metadata) from GET /api/Users/public\nexport const PublicUserSchema = z.object({\n  id: nullableString(),\n  slug: nullableString(),\n  fullName: nullableString(),\n  avatar: nullableString(),\n  headline: nullableString(),\n  location: nullableString(),\n  currentRole: nullableString(),\n  currentCompany: nullableString(),\n  role: z\n    .union([z.string(), z.number()])\n    .nullable()\n    .transform((val) => (val === null ? undefined : val))\n    .optional(),\n  isVerified: nullableBoolean(),\n  isPremium: nullableBoolean(),\n  openToWork: nullableBoolean(),\n  skills: z\n    .array(z.string())\n    .nullable()\n    .transform((val) => (val === null ? undefined : val))\n    .optional(),\n  profileViews: nullableNumber(),\n  createdAt: nullableString(),\n  updatedAt: nullableString(),\n});\n\n// Resume summary (normalized) returned by /api/Users/{id}/resumes\nexport const ResumeSummarySchema = z.object({\n  id: z.string(),\n  slug: z.string().optional(),\n  name: z.string().optional(),\n  description: z.string().optional(),\n  views: z.number().optional(),\n  isMaster: z.boolean().optional(),\n  isActive: z.boolean().optional(),\n  createdAt: z.string().optional(),\n});\nexport type ResumeSummary = z.infer<typeof ResumeSummarySchema>;\n\n// Accept both PascalCase and camelCase fields from the API\nconst RawResumeSchema = z.object({\n  Id: z.string().optional(),\n  id: z.string().optional(),\n  Slug: z.string().nullable().optional(),\n  slug: z.string().nullable().optional(),\n  Name: z.string().nullable().optional(),\n  name: z.string().nullable().optional(),\n  Title: z.string().nullable().optional(),\n  title: z.string().nullable().optional(),\n  Description: z.string().nullable().optional(),\n  description: z.string().nullable().optional(),\n  Views: z.number().nullable().optional(),\n  views: z.number().nullable().optional(),\n  IsMaster: z.boolean().nullable().optional(),\n  isMaster: z.boolean().nullable().optional(),\n  IsActive: z.boolean().nullable().optional(),\n  isActive: z.boolean().nullable().optional(),\n  CreationDateTimeFormatted: z.string().nullable().optional(),\n  createdAt: z.string().nullable().optional(),\n});\n\ntype RawResume = z.infer<typeof RawResumeSchema>;\n\nconst normalizeResume = (raw: RawResume): ResumeSummary => ({\n  id: String(raw.Id ?? raw.id ?? \"\"),\n  slug: raw.Slug ?? raw.slug ?? undefined,\n  name: (raw.Name ?? raw.name ?? raw.Title ?? raw.title) ?? undefined,\n  description: (raw.Description ?? raw.description) ?? undefined,\n  views: (raw.Views ?? raw.views ?? undefined) ?? undefined,\n  isMaster: (raw.IsMaster ?? raw.isMaster ?? undefined) ?? undefined,\n  isActive: (raw.IsActive ?? raw.isActive ?? undefined) ?? undefined,\n  createdAt: (raw.CreationDateTimeFormatted ?? raw.createdAt ?? undefined) ?? undefined,\n});\n\n\nexport const ConnectionSchema = z.object({\n  id: z.string(),\n  fromUserId: z.string(),\n  toUserId: z.string(),\n  status: z.enum([\"pending\", \"accepted\", \"rejected\"]),\n  message: z.string().optional(),\n  createdAt: z.string(),\n  updatedAt: z.string(),\n  fromUser: UserProfileSchema.optional(),\n  toUser: UserProfileSchema.optional(),\n});\n\nexport const UserFiltersSchema = z.object({\n  search: z.string().optional(),\n  role: z.string().optional(),\n  location: z.string().optional(),\n  skills: z.array(z.string()).optional(),\n  openToWork: z.boolean().optional(),\n  page: z.number().optional(),\n  limit: z.number().optional(),\n});\n\nexport const PaginatedUsersSchema = z.object({\n  items: z\n    .array(UserProfileSchema)\n    .nullable()\n    .transform((val) => (val === null ? undefined : val))\n    .optional(),\n  total: nullableNumber(),\n  page: nullableNumber(),\n  limit: nullableNumber(),\n  hasNext: nullableBoolean(),\n  hasPrev: nullableBoolean(),\n});\n\n// Matches API pagination shape for public users (accept both camelCase and PascalCase)\nexport const PaginatedPublicUsersSchema = z.object({\n  items: z\n    .array(PublicUserSchema)\n    .nullable()\n    .transform((val) => (val === null ? undefined : val))\n    .optional(),\n  Items: z\n    .array(PublicUserSchema)\n    .nullable()\n    .transform((val) => (val === null ? undefined : val))\n    .optional(),\n  total: nullableNumber(),\n  Total: nullableNumber(),\n  page: nullableNumber(),\n  Page: nullableNumber(),\n  limit: nullableNumber(),\n  Limit: nullableNumber(),\n  totalPages: nullableNumber(),\n  hasNextPage: nullableBoolean(),\n  hasPreviousPage: nullableBoolean(),\n  HasNextPage: nullableBoolean(),\n  HasPreviousPage: nullableBoolean(),\n});\n\nexport const SendConnectionRequestSchema = z.object({\n  toUserId: z.string(),\n  message: z.string().optional(),\n});\n\n// ============================================================================\n// TYPES\n// ============================================================================\n\nexport type UserProfile = z.infer<typeof UserProfileSchema>;\nexport type PublicUser = z.infer<typeof PublicUserSchema>;\nexport type Connection = z.infer<typeof ConnectionSchema>;\nexport type UserFilters = z.infer<typeof UserFiltersSchema>;\nexport type PaginatedUsers = z.infer<typeof PaginatedUsersSchema>;\nexport type PaginatedPublicUsers = z.infer<typeof PaginatedPublicUsersSchema>;\nexport type SendConnectionRequest = z.infer<typeof SendConnectionRequestSchema>;\n\n// ============================================================================\n// USER SERVICE CLASS\n// ============================================================================\n\nexport class UserService {\n  /**\n   * Get all public users with optional filters\n   */\n  async getPublicUsers(filters?: UserFilters): Promise<PaginatedPublicUsers> {\n    const params = new URLSearchParams();\n\n    if (filters) {\n      Object.entries(filters).forEach(([key, value]) => {\n        if (value !== undefined && value !== null) {\n          if (Array.isArray(value)) {\n            value.forEach((v) => params.append(key, v.toString()));\n          } else {\n            params.append(key, value.toString());\n          }\n        }\n      });\n    }\n\n    const endpoint = `/api/Users/public${params.toString() ? `?${params.toString()}` : \"\"}`;\n    const response = await apiClient.get<any>(\n      endpoint,\n      PaginatedPublicUsersSchema,\n    );\n\n    const dto = response.data;\n    const items = (dto.items || dto.Items || []) as unknown[];\n    const total = (dto.total ?? dto.Total ?? items.length) as number;\n    const page = (dto.page ?? dto.Page ?? 1) as number;\n    const limit = (dto.limit ?? dto.Limit ?? (items.length || (filters?.limit ?? 0))) as number;\n\n    return {\n      items: items as any,\n      total,\n      page,\n      limit,\n      totalPages: Math.ceil((total || 0) / (limit || 1)),\n      hasNextPage: page * limit < total,\n      hasPreviousPage: page > 1,\n    } as PaginatedPublicUsers;\n  }\n\n  /**\n   * Get user by ID\n   */\n  async getUserById(id: string): Promise<UserProfile> {\n    // Now using standard ApiResponse format\n    const response = await apiClient.get<any>(`/api/Users/${id}`);\n    const payload = response.data;\n\n    const dataBlock = payload?.data ?? {};\n\n    const normalized: UserProfile = {\n      id: String(payload.id ?? \"\"),\n      email: payload.email ?? undefined,\n      firstName: payload.firstName ?? dataBlock.firstName ?? undefined,\n      lastName: payload.lastName ?? dataBlock.lastName ?? undefined,\n      role:\n        typeof payload.role === \"number\"\n          ? String(payload.role)\n          : (payload.role ?? undefined),\n      profilePicture: (payload.profilePicture ?? dataBlock.avatar) || undefined,\n      bio: dataBlock.summary ?? undefined,\n      location: dataBlock.location ?? undefined,\n      website: dataBlock.website ?? undefined,\n      linkedIn: dataBlock.linkedIn ?? dataBlock.linkedin ?? undefined,\n      github: dataBlock.gitHub ?? dataBlock.github ?? undefined,\n      skills: Array.isArray(dataBlock.skills) ? dataBlock.skills : undefined,\n      openToWork: dataBlock.openToWork ?? undefined,\n      slug: payload.slug ?? undefined,\n      createdAt: payload.createdAt ?? undefined,\n      updatedAt: payload.updatedAt ?? undefined,\n    };\n\n    return normalized;\n  }\n\n  /**\n   * Get user by slug/username\n   */\n  async getUserBySlug(slug: string): Promise<UserProfile> {\n    const response = await apiClient.get<UserProfile>(\n      `/api/Users/slug/${slug}`,\n      UserProfileSchema,\n    );\n    return response.data;\n  }\n\n  /**\n   * Get current user profile\n   */\n  async getCurrentUser(): Promise<UserProfile> {\n    const response = await apiClient.get<UserProfile>(\n      \"/api/Users/me\",\n      UserProfileSchema,\n    );\n    return response.data;\n  }\n\n  /**\n   * Update current user profile\n   */\n  async updateProfile(updates: Partial<UserProfile>): Promise<UserProfile> {\n    const response = await apiClient.put<UserProfile>(\n      \"/api/Users/me\",\n      updates,\n      UserProfileSchema,\n    );\n    return response.data;\n  }\n\n  /**\n   * Search users with filters\n   */\n  async searchUsers(filters: UserFilters): Promise<PaginatedPublicUsers> {\n    return this.getPublicUsers(filters);\n  }\n\n  // ============================================================================\n  // CONNECTION MANAGEMENT\n  // ============================================================================\n\n  /**\n   * Send connection request\n   */\n  async sendConnectionRequest(\n    request: SendConnectionRequest,\n  ): Promise<Connection> {\n    const response = await apiClient.post<Connection>(\n      \"/api/Users/connections\",\n      request,\n      ConnectionSchema,\n    );\n    return response.data;\n  }\n\n  /**\n   * Get current user's connections\n   */\n  async getMyConnections(): Promise<Connection[]> {\n    const response = await apiClient.get<Connection[]>(\n      \"/api/Users/me/connections\",\n      z.array(ConnectionSchema),\n    );\n    return response.data;\n  }\n\n  /**\n   * Get pending connection requests\n   */\n  async getPendingConnectionRequests(): Promise<Connection[]> {\n    const response = await apiClient.get<Connection[]>(\n      \"/api/Users/me/connections/pending\",\n      z.array(ConnectionSchema),\n    );\n    return response.data;\n  }\n\n  /**\n   * Accept connection request\n   */\n  async acceptConnectionRequest(connectionId: string): Promise<void> {\n    await apiClient.put(`/api/Users/connections/${connectionId}/accept`);\n  }\n\n  /**\n   * Reject connection request\n   */\n  async rejectConnectionRequest(connectionId: string): Promise<void> {\n    await apiClient.delete(`/api/Users/connections/${connectionId}`);\n  }\n\n  /**\n   * Get connections for a specific user\n   */\n  async getUserConnections(userId: string): Promise<Connection[]> {\n    const response = await apiClient.get<Connection[]>(\n      `/api/Users/${userId}/connections`,\n      z.array(ConnectionSchema),\n    );\n    return response.data;\n  }\n\n  /**\n   * Check connection status between two users\n   */\n  async getConnectionStatus(\n    fromUserId: string,\n    toUserId: string,\n  ): Promise<Connection | null> {\n    try {\n      const response = await apiClient.get<Connection>(\n        `/api/Users/connections/status?fromUserId=${fromUserId}&toUserId=${toUserId}`,\n        ConnectionSchema,\n      );\n      return response.data;\n    } catch (error) {\n      // If no connection exists, return null\n      return null;\n    }\n  }\n\n  /**\n   * Get recommended connections for current user\n   */\n  async getRecommendedConnections(): Promise<UserProfile[]> {\n    const response = await apiClient.get<UserProfile[]>(\n      \"/api/Users/me/recommendations\",\n      z.array(UserProfileSchema),\n    );\n    return response.data;\n  }\n\n  // ============================================================================\n  // UTILITY METHODS\n  // ============================================================================\n\n  /**\n   * Check if current user can message another user\n   */\n  async canMessageUser(userId: string): Promise<boolean> {\n    try {\n      const response = await apiClient.get<{ canMessage: boolean }>(\n        `/api/Users/${userId}/can-message`,\n        z.object({ canMessage: z.boolean() }),\n      );\n      return response.data.canMessage;\n    } catch (error) {\n      return false;\n    }\n  }\n\n  /**\n   * Get user's public activity/stats\n   */\n  async getUserStats(userId: string): Promise<{\n    resumeCount: number;\n    connectionCount: number;\n    jobApplicationCount: number;\n  }> {\n    const response = await apiClient.get<{\n      resumeCount: number;\n      connectionCount: number;\n      jobApplicationCount: number;\n    }>(\n      `/api/Users/${userId}/stats`,\n      z.object({\n        resumeCount: z.number(),\n        connectionCount: z.number(),\n        jobApplicationCount: z.number(),\n      }),\n    );\n    return response.data;\n  }\n\n  /**\n   * Get user's resumes (public resumes for other users, all resumes for current user)\n   */\n  async getUserResumes(userId: string): Promise<ResumeSummary[]> {\n    const response = await apiClient.get<RawResume[]>(\n      `/api/Users/${userId}/resumes`,\n      z.array(RawResumeSchema),\n    );\n    return response.data.map((r) => normalizeResume(r));\n  }\n}\n\n// ============================================================================\n// DEFAULT INSTANCE\n// ============================================================================\n\nexport const userService = new UserService();\n\nexport default userService;\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\services\\value-proposition-service.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\user-context.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\utils.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\lib\\utils\\company-validation.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":43,"column":63,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":43,"endColumn":66,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1322,1325],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1322,1325],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\r\n * Company validation utilities\r\n */\r\n\r\n/**\r\n * List of invalid/placeholder company names that should be filtered out\r\n */\r\nconst INVALID_COMPANY_NAMES = [\r\n  \"unnamed company\",\r\n  \"untitled company\", \r\n  \"new company\",\r\n  \"company name\",\r\n  \"your company\",\r\n  \"test company\",\r\n  \"sample company\",\r\n  \"example company\",\r\n  \"demo company\",\r\n  \"placeholder company\"\r\n];\r\n\r\n/**\r\n * Check if a company name is valid (not empty, null, or a placeholder)\r\n * @param name - The company name to validate\r\n * @returns true if the name is valid, false otherwise\r\n */\r\nexport function isValidCompanyName(name: string | null | undefined): boolean {\r\n  if (!name) return false;\r\n  \r\n  const trimmedName = name.trim();\r\n  if (!trimmedName) return false;\r\n  \r\n  // Check against invalid names (case insensitive)\r\n  return !INVALID_COMPANY_NAMES.includes(trimmedName.toLowerCase());\r\n}\r\n\r\n/**\r\n * Filter an array of companies to only include those with valid names and exclude demo companies\r\n * @param companies - Array of companies to filter\r\n * @param nameProperty - Property name that contains the company name (default: 'name')\r\n * @param excludeDemo - Whether to exclude demo companies (default: true)\r\n * @returns Filtered array of companies with valid names\r\n */\r\nexport function filterValidCompanies<T extends Record<string, any>>(\r\n  companies: T[], \r\n  nameProperty = 'name',\r\n  excludeDemo = true\r\n): T[] {\r\n  return companies.filter(company => {\r\n    const hasValidName = isValidCompanyName(company[nameProperty]);\r\n    const isNotDemo = !excludeDemo || !company.isDemo;\r\n    return hasValidName && isNotDemo;\r\n  });\r\n}\r\n\r\n/**\r\n * Validate company data for creation/update\r\n * @param companyData - Company data to validate\r\n * @returns Object with isValid boolean and error message if invalid\r\n */\r\nexport function validateCompanyData(companyData: {\r\n  name?: string;\r\n  description?: string;\r\n  industry?: string;\r\n  size?: string;\r\n}): { isValid: boolean; error?: string } {\r\n  if (!isValidCompanyName(companyData.name)) {\r\n    return {\r\n      isValid: false,\r\n      error: \"Please provide a valid company name\"\r\n    };\r\n  }\r\n\r\n  if (!companyData.description?.trim()) {\r\n    return {\r\n      isValid: false,\r\n      error: \"Company description is required\"\r\n    };\r\n  }\r\n\r\n  if (!companyData.industry?.trim()) {\r\n    return {\r\n      isValid: false,\r\n      error: \"Company industry is required\"\r\n    };\r\n  }\r\n\r\n  if (!companyData.size?.trim()) {\r\n    return {\r\n      isValid: false,\r\n      error: \"Company size is required\"\r\n    };\r\n  }\r\n\r\n  return { isValid: true };\r\n}","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvi