e() {}\n  takeRecords() { return []; }\n} as any;\n\n// Mock ResizeObserver\nglobal.ResizeObserver = class ResizeObserver {\n  constructor() {}\n  observe() {}\n  disconnect() {}\n  unobserve() {}\n} as any;\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\AIChatPanel.tsx","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":101,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":101,"endColumn":20,"suggestions":[{"fix":{"range":[2905,2958],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]},{"ruleId":"jsx-a11y/click-events-have-key-events","severity":1,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":131,"column":7,"nodeType":"JSXOpeningElement","endLine":134,"endColumn":9}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n  X,\n  Send,\n  Brain,\n  FileText,\n  Users,\n  Briefcase,\n  BarChart3,\n} from \"lucide-react\";\nimport React, { useState, useRef, useEffect } from \"react\";\nimport { Button, Button as UiButton } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { useAI } from \"@/lib/ai-context\";\nimport {\n  sendHRMessage,\n  isAIServiceConfigured,\n  type ChatMessage,\n} from \"@/lib/services/ai-service\";\nimport { cn } from \"@/lib/utils\";\nimport Markdown from \"@/components/Markdown\";\nimport { useAuth } from \"@/lib/auth\";\nimport { Link } from \"react-router-dom\";\n\ninterface Message {\n  id: string;\n  content: string;\n  sender: \"user\" | \"ai\";\n  timestamp: Date;\n  type?: \"text\" | \"suggestion\";\n}\n\nexport default function AIChatPanel() {\n  const { isAIChatOpen, closeAIChat, currentContext } = useAI();\n  const [messages, setMessages] = useState<Message[]>([\n    {\n      id: \"welcome\",\n      content:\n        \"≡ƒæï Hi! I'm your AI HR Assistant. I can help you with recruiting, talent management, resume optimization, job matching, and more. What would you like to know?\",\n      sender: \"ai\",\n      timestamp: new Date(),\n    },\n  ]);\n  const [inputValue, setInputValue] = useState(\"\");\n  const [isTyping, setIsTyping] = useState(false);\n  const [conversationHistory, setConversationHistory] = useState<ChatMessage[]>(\n    [],\n  );\n  const scrollAreaRef = useRef<HTMLDivElement>(null);\n  const isAIConfigured = isAIServiceConfigured();\n\n  const quickSuggestions = [\n    { text: \"Optimize my resume\", icon: FileText },\n    { text: \"Find job matches\", icon: Briefcase },\n    { text: \"Recruitment tips\", icon: Users },\n    { text: \"HR analytics\", icon: BarChart3 },\n  ];\n\n  useEffect(() => {\n    if (scrollAreaRef.current) {\n      const element = scrollAreaRef.current;\n      element.scrollTop = element.scrollHeight;\n    }\n  }, [messages]);\n\n  const handleSendMessage = async (content: string) => {\n    if (!content.trim()) return;\n\n    // Add user message\n    const userMessage: Message = {\n      id: Date.now().toString(),\n      content: content.trim(),\n      sender: \"user\",\n      timestamp: new Date(),\n    };\n\n    setMessages((prev) => [...prev, userMessage]);\n    setInputValue(\"\");\n    setIsTyping(true);\n\n    try {\n      // Send message to AI service\n      const response = await sendHRMessage(content.trim(), conversationHistory);\n\n      // Update conversation history\n      const newHistory: ChatMessage[] = [\n        ...conversationHistory,\n        { role: \"user\", content: content.trim() },\n        { role: \"assistant\", content: response.message },\n      ];\n      setConversationHistory(newHistory);\n\n      // Add AI response\n      const aiMessage: Message = {\n        id: (Date.now() + 1).toString(),\n        content: response.message,\n        sender: \"ai\",\n        timestamp: new Date(),\n      };\n      setMessages((prev) => [...prev, aiMessage]);\n    } catch (error) {\n      console.error(\"Unexpected error in AI chat:\", error);\n\n      // This should rarely happen since AI service has internal fallbacks\n      // But provide a user-friendly message just in case\n      const aiMessage: Message = {\n        id: (Date.now() + 1).toString(),\n        content:\n          \"I'm experiencing a technical issue. Let me try to help you anyway! What would you like to know about resumes, job searching, or recruitment?\",\n        sender: \"ai\",\n        timestamp: new Date(),\n      };\n      setMessages((prev) => [...prev, aiMessage]);\n    } finally {\n      setIsTyping(false);\n    }\n  };\n\n  const handleQuickSuggestion = (suggestion: string) => {\n    handleSendMessage(suggestion);\n  };\n\n  const { user, isAuthenticated } = useAuth();\n  const isPro =\n    user?.subscription === \"pro\" || user?.subscription === \"enterprise\";\n\n  if (!isAIChatOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex\">\n      {/* Backdrop */}\n      <div\n        className=\"flex-1 bg-black/20 backdrop-blur-sm\"\n        onClick={closeAIChat}\n      />\n\n      {/* Panel */}\n      <div className=\"w-[60%] bg-background border-l shadow-2xl flex flex-col\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between p-4 border-b bg-gradient-to-r from-brand-purple/10 to-brand-blue/10\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 bg-gradient-to-r from-brand-purple to-brand-blue rounded-full flex items-center justify-center\">\n              <Brain className=\"h-5 w-5 text-white\" />\n            </div>\n            <div>\n              <h3 className=\"font-semibold\">AI HR Assistant</h3>\n              <p className=\"text-xs text-muted-foreground\">\n                {currentContext?.hint || \"Always here to help\"}\n              </p>\n            </div>\n          </div>\n          <Button variant=\"ghost\" size=\"icon\" onClick={closeAIChat}>\n            <X className=\"h-4 w-4\" />\n          </Button>\n        </div>\n\n        {/* Messages */}\n        <div className=\"flex-1 p-4 overflow-y-auto\" ref={scrollAreaRef}>\n          <div className=\"space-y-4\">\n            {messages.map((message) => (\n              <div\n                key={message.id}\n                className={cn(\n                  \"flex\",\n                  message.sender === \"user\" ? \"justify-end\" : \"justify-start\",\n                )}\n              >\n                <div\n                  className={cn(\n                    \"max-w-[80%] rounded-lg p-3 text-sm\",\n                    message.sender === \"user\"\n                      ? \"bg-primary text-primary-foreground\"\n                      : \"bg-muted\",\n                  )}\n                >\n                  {message.sender === \"ai\" && (\n                    <div className=\"flex items-center gap-2 mb-2\">\n                      <Brain className=\"h-3 w-3 text-primary\" />\n                      <span className=\"text-xs font-medium text-primary\">\n                        AI Assistant\n                      </span>\n                    </div>\n                  )}\n                  {message.sender === \"ai\" ? (\n                    <Markdown>{message.content}</Markdown>\n                  ) : (\n                    <div className=\"whitespace-pre-wrap\">{message.content}</div>\n                  )}\n                  <div className=\"text-xs opacity-70 mt-1\">\n                    {message.timestamp.toLocaleTimeString([], {\n                      hour: \"2-digit\",\n                      minute: \"2-digit\",\n                    })}\n                  </div>\n                </div>\n              </div>\n            ))}\n\n            {isTyping && (\n              <div className=\"flex justify-start\">\n                <div className=\"bg-muted rounded-lg p-3 text-sm\">\n                  <div className=\"flex items-center gap-2 mb-2\">\n                    <Brain className=\"h-3 w-3 text-primary\" />\n                    <span className=\"text-xs font-medium text-primary\">\n                      AI Assistant\n                    </span>\n                  </div>\n                  <div className=\"flex items-center gap-1\">\n                    <div className=\"w-2 h-2 bg-primary/60 rounded-full animate-pulse\" />\n                    <div className=\"w-2 h-2 bg-primary/60 rounded-full animate-pulse\" />\n                    <div className=\"w-2 h-2 bg-primary/60 rounded-full animate-pulse\" />\n                  </div>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Quick Suggestions */}\n        {messages.length <= 1 && (\n          <div className=\"p-4 border-t bg-muted/30\">\n            <p className=\"text-xs text-muted-foreground mb-3\">\n              Quick suggestions:\n            </p>\n            <div className=\"grid grid-cols-2 gap-2\">\n              {quickSuggestions.map((suggestion, index) => {\n                const Icon = suggestion.icon;\n                return (\n                  <Button\n                    key={index}\n                    variant=\"outline\"\n                    size=\"sm\"\n                    className=\"h-auto p-2 text-left justify-start\"\n                    onClick={() =>\n                      isPro ? handleQuickSuggestion(suggestion.text) : undefined\n                    }\n                    disabled={!isPro}\n                  >\n                    <Icon className=\"h-3 w-3 mr-2\" />\n                    <span className=\"text-xs\">{suggestion.text}</span>\n                  </Button>\n                );\n              })}\n            </div>\n          </div>\n        )}\n\n        {/* Input */}\n        <div className=\"p-4 border-t\">\n          {isPro ? (\n            <div className=\"flex gap-2\">\n              <Input\n                placeholder=\"Ask me anything about HR...\"\n                value={inputValue}\n                onChange={(e) => setInputValue(e.target.value)}\n                onKeyPress={(e) => {\n                  if (e.key === \"Enter\") {\n                    handleSendMessage(inputValue);\n                  }\n                }}\n                className=\"flex-1\"\n              />\n              <Button\n                onClick={() => handleSendMessage(inputValue)}\n                disabled={!inputValue.trim() || isTyping}\n                size=\"icon\"\n              >\n                <Send className=\"h-4 w-4\" />\n              </Button>\n            </div>\n          ) : (\n            <div className=\"flex items-center justify-between gap-2\">\n              <div className=\"text-sm text-muted-foreground\">\n                {isAuthenticated\n                  ? \"Upgrade to Pro to use the AI Assistant.\"\n                  : \"Sign in to upgrade to Pro and use the AI Assistant.\"}\n              </div>\n              <div className=\"flex gap-2\">\n                {!isAuthenticated && (\n                  <UiButton asChild variant=\"outline\" size=\"sm\">\n                    <Link to=\"/login\">Sign In</Link>\n                  </UiButton>\n                )}\n                <UiButton asChild size=\"sm\">\n                  <Link to=\"/pricing\">View Plans</Link>\n                </UiButton>\n              </div>\n            </div>\n          )}\n          <p className=\"text-xs text-muted-foreground mt-2 text-center\">\n            {isAIConfigured\n              ? \"Powered by OpenRouter AI\"\n              : \"AI service not configured - using demo responses\"}\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\myvideoresume\\App\\myvideoresume-frontend\\client\\components\\ActionsModal.tsx","messages":[{"ruleId":"@typescript